{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_places.browser_title_edit'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260827-s152d' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260827-s152d' }}">
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel admin-list-card admin-form-card">
                {% include 'site/_admin_form_head.html.twig' with {
                    title: 'admin_places.edit_title'|trans,
                    subtitle: place.nom,
                    back_href: path('app_admin_places'),
                    back_label: 'admin_places.back'|trans,
                } only %}
                <div class="admin-edit-panel-header">
                    <h2>{{ 'admin_form.fields_heading'|trans }}</h2>
                </div>

                {# ⚠️ `|lab_date` and not `|date`: `createdAt` is a machine timestamp
                   (convention A), stored UTC. The partial deliberately does not
                   format — it would have to guess the convention, and guessing
                   wrong shifts by hours in silence. #}
                {% include 'site/_admin_meta_grid.html.twig' with {items: [
                    {label: 'ID', value: '#' ~ place.id},
                    {label: 'admin_form.created_at'|trans, value: place.createdAt|lab_date('d/m/Y H:i:s')},
                ]} only %}

                {% form_theme form 'form/admin_theme.html.twig' %}
                {% include 'site/_place_form.html.twig' with {
                    form: form,
                } only %}

                {% include 'site/_admin_danger_zone.html.twig' with {
                    action: path('app_admin_place_delete', {id: place.id}),
                    token: 'delete_place_' ~ place.id,
                    heading: (place.archived ? 'adm.restore_record' : 'adm.archive_record')|trans,
                    label: (place.archived ? 'adm.restore_record' : 'adm.archive_record')|trans,
                    description: (place.archived ? 'adm.restore_record_notice' : 'adm.archive_record_notice')|trans,
                    confirm: (place.archived ? 'adm.restore_record_confirm' : 'adm.archive_record_confirm')|trans({'%name%': place.nom}),
                } only %}
            </section>
        </div>
    </main>
{% endblock %}
