                            <tr>
                                <td>{% include 'site/_cell_media.html.twig' with {
                                    initials: machine.nom, shape: 'square', alt: machine.nom,
                                } only %}</td>
                                <td>{% include 'site/_cell_title.html.twig' with {
                                    title: machine.nom,
                                    href: path('app_admin_machine_edit', {id: machine.id}),
                                    subtitle: machine.categoryLabel|default(''),
                                } only %}</td>
                                <td>{% include 'site/_cell_state.html.twig' with {
                                    label: statusKey|trans,
                                    signal: statusKey == 'machines.st_available' ? 'go' : (statusKey == 'machines.st_maintenance' ? 'caution' : 'stop'),
                                } only %}</td>
