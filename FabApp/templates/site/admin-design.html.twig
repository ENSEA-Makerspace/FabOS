                                    value: machine.lastAuthorizationTime, convention: 'machine',
                                } only %}</td>
                                <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                                    actions: [
                                        {label: 'Modifier', icon: 'edit', href: path('app_admin_machine_edit', {id: machine.id})},
                                        {label: 'Archiver', disabled: true, disabled_reason: 'L’archivage arrive en S134f — le bouton dit pourquoi il ne fait rien plutôt que de rester gris et muet.'},
                                    ],
                                } only %}</td>
                            </tr>
                        {% endfor %}
                        <tr>
                            <td>{% include 'site/_cell_media.html.twig' only %}</td>
                            <td>{% include 'site/_cell_title.html.twig' with {subtitle: 'la ligne sans nom'} only %}</td>
                            <td>{% include 'site/_cell_state.html.twig' only %}</td>
                            <td>{% include 'site/_cell_meter.html.twig' with {value: 0, max: 12, label: 'zéro n’est pas vide'} only %}</td>
                            <td>{% include 'site/_cell_date.html.twig' only %}</td>
                            <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {actions: []} only %}</td>
                        </tr>
                        <tr>
                            <td colspan="4"><em>La ligne ci-dessous montre ce qu'un gabarit voit s'il oublie de dire quelle convention d'heure s'applique.</em></td>
                            <td>{% include 'site/_cell_date.html.twig' with {value: date()} only %}</td>
                            <td class="is-actions"></td>
                        </tr>
                    {% endblock %}
                {% endembed %}

                <div class="dzf-verdict" style="margin-top: var(--spacing-lg)">
                    ⚠️ <strong><code>_cell_date</code> exige <code>convention</code> et n'a pas de
                    valeur par défaut.</strong> FabOS range deux natures de date dans le même type de
                    colonne : un <em>instant machine</em> (scan RFID, log, création), converti par
                    <code>|lab_date</code> ; et une <em>heure murale</em> saisie par une personne
                    (réservation, événement, horaire d'ouverture), stockée telle quelle et donc affichée
                    par <code>|date</code>. Se tromper est <strong>silencieux</strong> : la date s'affiche,
                    reste plausible, et est fausse du décalage du lab — ce qui, près de minuit, déplace la
                    ligne d'un jour. Ça a déjà coûté deux fois à ce projet. Sans convention, la cellule
                    affiche donc un marqueur visible au lieu d'une date : une erreur bruyante se rattrape,
                    une erreur muette non.
                </div>
            </div>

            <div class="dz-sec" id="fil-ariane">
                <h3>Le fil d'Ariane</h3>
                <p>
                    Un seul partial, <code>_breadcrumb.html.twig</code>, et depuis S139e
                    <strong>un seul endroit pour ses règles</strong> : <code>components.css</code>.
                </p>

                <div class="dzf-verdict" style="margin-bottom: var(--spacing-lg)">
                    🔴 <strong>Trouvé par l'opérateur : « le fil d'Ariane a l'air d'être du
                    texte brut ».</strong> Il l'était. Ses règles vivaient dans
                    <code>details.css</code>, que <strong>36 gabarits</strong> chargent — et
                    <code>/events/{id}</code> n'en fait pas partie : cette page n'émet que
                    <code>style.css</code> et <code>components.css</code>. Le partial sortait
                    donc <strong>sans aucune règle</strong>. C'est la <strong>troisième fois
                    dans la même session</strong> : <code>_cell_title</code> dans
                    <code>admin.css</code>, puis sa couleur laissée à l'héritage, puis ceci.
                    <strong>Règle : les règles d'un partial partagé vivent dans
                    <code>components.css</code></strong>, la feuille que
                    <code>base.html.twig</code> émet partout. Si une feuille chargée par
                    certaines pages seulement style un composant commun, ce composant n'est
                    pas commun.
                </div>

                <div class="dzf-verdict" style="margin-bottom: var(--spacing-lg)">
                    ⚠️ <strong>Et il avait deux formes.</strong> En thème sombre le fil
                    portait une <em>pilule</em> — fond, bordure, rayon, padding — que le
                    thème clair n'avait pas. Un thème change des couleurs, pas la forme d'un
                    composant. La pilule est retirée ; sombre ne redéfinit plus que la
                    couleur, et par token plutôt que par le littéral <code>#d7c9d4</code>.
                </div>

                <p class="dz-label">Le composant réel, rendu ici</p>
                <div class="dz-demo">
                    {% include 'site/_breadcrumb.html.twig' with {trail: [
                        {label: 'Accueil', url: path('app_home')},
                        {label: 'Événements', url: path('app_events')},
                        {label: 'Anniversaire Cédric'},
                    ]} only %}
                </div>
                <p class="dz-used">
                    <b>Classes :</b> <code>.breadcrumb</code>, <code>.breadcrumb-separator</code>,
                    <code>.breadcrumb-current</code>, et <code>.breadcrumb-inset</code> quand
                    l'appelant doit le décaler sous un visuel pleine largeur.
                    ⚠️ <code>flex-wrap</code> n'est pas décoratif : « Accueil / Machines /
                    Découpeuse laser Trotec / Historique » déborde un écran étroit sans lui.
                    ⚠️ Le dernier élément n'a <strong>pas</strong> d'URL — une entrée qui
                    pointe vers la page courante est un contrôle qui ne fait rien.
                </p>
            </div>

            <div class="dz-sec" id="recherche">
                <h3>La recherche : deux formes, et trois qui n'en sont pas</h3>
                <p>
                    <code>/recherche</code> portait <strong>23 règles CSS locales pour 15 classes à
                    elle</strong>. S139c a retiré ce qui existait déjà. Cette section documente le
                    reste — et surtout ce qui ne devait <em>pas</em> être documenté.
                </p>

                <div class="dzf-verdict" style="margin-bottom: var(--spacing-lg)">
                    🔴 <strong>Trois de ses cinq formes étaient des copies.</strong> La carte de
                    résultat redessinait un titre fort plus une seconde ligne discrète : c'est
                    <code>_cell_title</code>. La pastille de catégorie redessinait une pastille
                    d'état : c'est <code>_cell_state</code> en signal <code>muted</code>. Le panneau
                    par groupe redessinait un cadre : ce sont les tokens de surface de S83.
                    <strong>Les documenter aurait béni la copie</strong> — un guide de style qui
                    accueille chaque variante locale devient un catalogue de dettes. On ne met ici
                    que ce que rien de partagé n'exprime encore.
                </div>

                <div class="dzf-verdict" style="margin-bottom: var(--spacing-lg)">
                    ⚠️ <strong>Le piège de cascade que ça a révélé.</strong>
                    <code>_cell_title</code> est un partial <code>_cell_*</code>, donc utilisable sur
                    <em>n'importe quelle</em> page — mais ses règles
                    (<code>.admin-cell-user</code>, <code>.admin-cell-stack</code>) vivaient dans
                    <code>admin.css</code>, qu'une page publique ne charge jamais.
                    <code>/recherche</code> est le premier appelant public : le composant serait
                    sorti <strong>sans aucune règle</strong>. C'est mot pour mot la faute trouvée en
                    S135 avec <code>_cell_state</code> sur <code>/machines/{id}/calendrier</code>.
                    Les quatre règles sont passées dans <code>components.css</code>, que
                    <code>base.html.twig</code> émet partout. <strong>Un composant partagé dont les
                    règles vivent dans une feuille à moitié chargée n'est pas partagé.</strong>
                </div>

                <p class="dz-label">La carte de résultat, telle qu'elle est rendue aujourd'hui</p>
                <div class="dz-demo">
                    <div style="background: var(--theme-surface); border-radius: var(--border-radius); padding: var(--spacing-md); box-shadow: var(--shadow-sm);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--spacing-sm);">
                            {% include 'site/_cell_title.html.twig' with {
                                title: 'Batterie USBC 20W',
                                subtitle: 'Une batterie USBC pour alimenter vos projets sans y intégrer une batterie de manière fixe.',
                            } only %}
                            {% include 'site/_cell_state.html.twig' with {label: 'Prêts', signal: 'muted'} only %}
                        </div>
                        <p style="margin: 6px 0 0; font-size: var(--font-size-sm); color: var(--color-text-light); line-height: 1.5;">USBC · FabLab</p>
                    </div>
                </div>
                <p class="dz-used">
                    <b>Rien de neuf :</b> <code>_cell_title</code> + <code>_cell_state</code> +
                    <code>--theme-surface</code>. ⚠️ <code>_cell_title</code> est inclus
                    <strong>sans <code>href</code></strong> : toute la carte est déjà un lien, et un
                    <code>&lt;a&gt;</code> dans un <code>&lt;a&gt;</code> est invalide — le navigateur
                    le dénide en silence. La règle de liste autorise la carte entière cliquable
                    justement parce qu'un résultat n'a qu'une destination.
                </p>

                <p class="dz-label" style="margin-top: var(--spacing-lg)">La carte de conseil — la seule forme réellement nouvelle</p>
                <div class="dz-demo">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--spacing-lg);">
                        <div style="display: flex; gap: var(--spacing-md); align-items: flex-start; background: var(--theme-surface); padding: var(--spacing-md); border-radius: var(--border-radius); box-shadow: var(--shadow-sm);">
                            <div style="flex-shrink: 0; color: var(--color-primary-text);">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 40px; height: 40px;">
                                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                                </svg>
                            </div>
                            <div>
                                <h5 style="margin: 0 0 var(--spacing-xs); color: var(--color-text); font-size: var(--font-size-md);">Recherchez par nom</h5>
                                <p style="margin: 0; font-size: var(--font-size-sm); color: var(--color-text-light);">Ex : « Imprimante 3D » ou « Découpeuse Laser »</p>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="dz-used">
                    <b>Local, assumé :</b> <code>.search-tips</code>, <code>.tips-grid</code>,
                    <code>.tip-card</code>, <code>.tip-icon</code>, <code>.tip-content</code>. Une
                    icône, un titre court, une aide — de l'aide contextuelle, pas une donnée.
                    ⚠️ Les trois icônes portaient <code>stroke="#9E1B56"</code>, le hex littéral de
                    l'accent : une installation qui change de couleur gardait le magenta de FabOS.
                    Elles font <code>currentColor</code> et héritent de
                    <code>--color-primary-text</code>. <strong>Le jour où une deuxième page a besoin
                    de cette forme, elle monte dans <code>components.css</code> — elle ne se
                    recopie pas.</strong>
                </p>
            </div>
            </div>
        </main>
    </div>

<script>
(() => {
    const css = getComputedStyle(document.documentElement);
    const v = n => css.getPropertyValue(n).trim();

    // Resolve any colour (including color-mix()) to actual pixels by painting it.
    const probe = document.createElement('span');
    probe.style.display = 'none';
    document.body.appendChild(probe);
    const rgb = value => {
        probe.style.color = '';
        probe.style.color = value;
        const computed = getComputedStyle(probe).color;
        const n = (computed.match(/[\d.]+/g) || []).map(Number);
        if (n.length < 3) return [0, 0, 0];
        // ⚠️ `color-mix()` computes to `color(srgb 0.81 0.55 0.67)` — the same
        // three numbers as `rgb()` but on a 0–1 scale. Reading them as bytes made
        // the accent report 1.39:1 when it is really ~5.8, on the one page whose
        // entire job is to measure rather than assert. ("srgb" carries no digits,
        // so the values are still the first three matches either way.)
        const [r, g, b] = n.slice(0, 3);
        return computed.startsWith('color(')
            ? [r, g, b].map(x => Math.round(x * 255))
            : [r, g, b];
    };

    const lum = ([r, g, b]) => {
        const f = c => { c /= 255; return c <= .03928 ? c / 12.92 : Math.pow((c + .055) / 1.055, 2.4); };
        return .2126 * f(r) + .7152 * f(g) + .0722 * f(b);
    };
    const ratio = (a, b) => {
        const [x, y] = [lum(a), lum(b)];
        const [hi, lo] = x > y ? [x, y] : [y, x];
        return (hi + .05) / (lo + .05);
    };

    const surface = rgb(v('--theme-surface') || '#fff');
    const textRoles = [
        ['--color-primary-text', 'accent, en texte'],
        ['--color-danger', 'danger'],
        ['--color-warn', 'attention'],
        ['--color-ok', 'succès'],
        ['--color-info', 'information'],
        ['--color-text', 'texte principal'],
        ['--color-text-light', 'texte secondaire'],
        ['--color-link', 'lien'],
    ];

    document.getElementById('dz-colors').innerHTML = textRoles.map(([name, label]) => {
        const r = ratio(rgb(v(name)), surface);
        const ok = r >= 4.5;
        return `<div class="dz-card">
            <span class="dz-chip" style="color:${v(name)};background:var(--theme-surface)">${label}</span>
            <div class="dz-name">${name}</div>
            <div class="dz-ratio ${ok ? 'admin-status-ok' : 'admin-status-danger'}">${r.toFixed(2)}:1 ${ok ? '✓' : '✗ sous 4,5'}</div>
        </div>`;
    }).join('');

    document.getElementById('dz-surfaces').innerHTML =
        ['--theme-surface', '--theme-surface-elevated', '--theme-input', '--color-bg', '--color-primary']
        .map(n => `<div class="dz-card">
            <div class="dz-swatch" style="background:${v(n)}"></div>
            <div class="dz-name" style="margin-top:8px">${n}</div>
            <div class="dz-name">${v(n)}</div>
        </div>`).join('');

    document.getElementById('dz-type').innerHTML = [
        ['--font-size-display', 'var(--font-weight-black)', '42'],
        ['--font-size-4xl', 'var(--font-weight-bold)', '128'],
        ['--font-size-3xl', 'var(--font-weight-bold)', 'Titre'],
        ['--font-size-2xl', 'var(--font-weight-bold)', 'Titre de panneau'],
        ['--font-size-xl', 'var(--font-weight-semibold)', 'Sous-titre'],
        ['--font-size-base', 'var(--font-weight-normal)', 'Texte courant'],
        ['--font-size-sm', 'var(--font-weight-medium)', 'Métadonnée'],
    ].map(([size, weight, sample]) =>
        `<tr><td style="font-size:${v(size)};font-weight:${weight};line-height:1.1">${sample}</td>
             <td class="dz-name">${size}<br>${v(size)}</td></tr>`).join('');

    document.getElementById('dz-space').innerHTML =
        ['--spacing-xs', '--spacing-sm', '--spacing-md', '--spacing-lg', '--spacing-xl', '--spacing-2xl']
        .map(n => `<div style="width:${v(n)};height:${v(n)}" title="${n} = ${v(n)}"></div>`).join('');

    document.getElementById('dz-misc').innerHTML = [
        ['--border-radius', 'rayon'], ['--border-radius-sm', 'rayon petit'],
        ['--shadow-sm', 'ombre petite'], ['--shadow', 'ombre'], ['--shadow-lg', 'ombre large'],
        ['--transition-fast', 'transition rapide'], ['--transition', 'transition'],
    ].map(([n, label]) => `<div class="dz-card"><div class="dz-name">${label}</div><div class="dz-name">${n}</div><div class="dz-name">${v(n)}</div></div>`).join('');

    probe.remove();
})();

/* Les hauteurs de cette page sont MESURÉES, pas annoncées. La projection
   « à douze catégories » clone le panneau retenu, lui ajoute les tuiles
   manquantes, mesure, puis jette le clone — un chiffre qu'on peut contredire en
   redimensionnant la fenêtre. */
(() => {
    const px = (el) => Math.round(el.getBoundingClientRect().height);

    const project = (el, extraCats) => {
        const clone = el.cloneNode(true);
        Object.assign(clone.style, { position: 'absolute', visibility: 'hidden', width: el.getBoundingClientRect().width + 'px' });
        const nav = clone.querySelector('.ml-cats');
        if (nav && nav.children.length > 1) {
            for (let i = 0; i < extraCats; i++) {
                const tile = nav.children[1].cloneNode(true);
                tile.querySelector('.ml-tile-label').textContent = 'Catégorie ' + (i + 1);
                nav.appendChild(tile);
            }
        }
        el.parentNode.appendChild(clone);
        const h = px(clone);
        clone.remove();
        return h;
    };

    const paint = () => {
        const box = document.querySelector('[data-dzf-box="final"] .dzf-panel');
        if (!box) return;
        document.querySelectorAll('[data-dzf-measure]').forEach((o) => { o.textContent = px(box) + ' px'; });
        const h = document.getElementById('dzf-h-final');
        const p = document.getElementById('dzf-p-final');
        if (h) h.textContent = px(box) + ' px';
        if (p) p.textContent = project(box, 5) + ' px';
    };

    paint();
    addEventListener('resize', () => { clearTimeout(window.__dzf); window.__dzf = setTimeout(paint, 150); });

})();
</script>
{% endblock %}
