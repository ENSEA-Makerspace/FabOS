                            <td>{% include 'site/_cell_media.html.twig' only %}</td>
                            <td>{% include 'site/_cell_title.html.twig' with {subtitle: 'la ligne sans nom'} only %}</td>
                            <td>{% include 'site/_cell_state.html.twig' only %}</td>
