{% extends 'base.html.twig' %}

{% block title %}Prêts - Admin FabOS{% endblock %}

{% block stylesheets %}
    <style>
        .admin-page { min-height: 100vh; background: #f6f7fb; color: #1f2937; }
        .admin-page-header { background: #9E1B56; color: #fff; padding: 30px 24px; }
        .admin-page-header-inner { max-width: var(--max-width); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
        .admin-page-header h1 { margin: 0 0 6px; font-size: 30px; }
        .admin-page-header p { margin: 0; opacity: .9; }
        .admin-layout { max-width: var(--max-width); margin: 24px auto 48px; padding: 0 24px; display: grid; grid-template-columns: 260px 1fr; gap: 24px; }
        .admin-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: var(--shadow); overflow: hidden; }
        .admin-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; border-bottom: 1px solid #e5e7eb; }
        .admin-panel-header h2 { margin: 0; font-size: 22px; }
        .admin-table-wrap { overflow-x: auto; }
        .admin-table { width: 100%; min-width: 760px; border-collapse: collapse; }
        .admin-table th, .admin-table td { padding: 13px 16px; border-bottom: 1px solid #e5e7eb; text-align: left; vertical-align: middle; }
        .admin-table th { background: #f9fafb; color: #4b5563; font-size: 13px; }
        .admin-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; min-height: 34px; padding: 7px 11px; border-radius: 6px; border: 1px solid #d1d5db; text-decoration: none; color: #374151; background: #fff; font-weight: 700; cursor: pointer; font-size: 13px; }
        .btn-primary-admin { background: #9E1B56; border-color: #9E1B56; color: #fff; }
        .admin-flash { margin: 0 0 16px; padding: 12px 14px; border-radius: 6px; font-weight: 700; }
        .admin-flash.success { background: #dcfce7; color: #166534; }
        .admin-flash.error { background: #fee2e2; color: #991b1b; }
        .loan-status { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
        .loan-status.out { background: #dbeafe; color: #1e40af; }
        .loan-status.overdue { background: #fee2e2; color: #991b1b; }
        .loan-status.returned { background: #dcfce7; color: #166534; }
        .return-inline { display: flex; gap: 6px; align-items: center; }
        .return-inline input[type=text] { padding: 6px 9px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 13px; max-width: 150px; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .admin-page-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
<main class="admin-page">
    <header class="admin-page-header">
        <div class="admin-page-header-inner">
            <div>
                <h1>Prêts</h1>
                <p>Historique des emprunts. Enregistrez une sortie ou marquez un retour.</p>
            </div>
            <div class="admin-actions">
                <a class="btn-link" href="{{ path('app_admin_loanable_items') }}">Objets prêtables</a>
                <a class="btn-link btn-primary-admin" href="{{ path('app_admin_loan_new') }}">Nouveau prêt</a>
            </div>
        </div>
    </header>

    <div class="admin-layout">
        {% include 'site/_admin_sidebar.html.twig' %}
        <section class="admin-panel">
            <div class="admin-panel-header"><h2>Tous les prêts</h2></div>
            <div style="padding: 0 24px;">
                {% for message in app.flashes('success') %}<div class="admin-flash success">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="admin-flash error">{{ message }}</div>{% endfor %}
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>Objet</th><th>Emprunteur</th><th>Sorti le</th><th>Retour prévu</th><th>Statut</th><th>Action</th></tr></thead>
                    <tbody>
                    {% for loan in loans %}
                        {% set st = loan.effectiveStatus %}
                        <tr>
                            <td>{{ loan.item ? loan.item.name : '—' }}</td>
                            <td>{{ loan.borrowerDisplay }}</td>
                            <td>{{ loan.dateTaken|date('d/m/Y') }}</td>
                            <td>{{ loan.expectedReturnDate ? loan.expectedReturnDate|date('d/m/Y') : '—' }}</td>
                            <td>
                                <span class="loan-status {{ st }}">
                                    {{ st == 'returned' ? 'Rendu' : (st == 'overdue' ? 'En retard' : 'En cours') }}
                                </span>
                                {% if loan.actualReturnDate %}<div style="font-size:12px;color:#6b7280;margin-top:3px;">le {{ loan.actualReturnDate|date('d/m/Y') }}</div>{% endif %}
                            </td>
                            <td>
                                {% if not loan.returned %}
                                    <form class="return-inline" method="post" action="{{ path('app_admin_loan_return', {id: loan.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('return_loan_' ~ loan.id) }}">
                                        <input type="text" name="conditionReturn" placeholder="État au retour">
                                        <button class="btn-action btn-primary-admin" type="submit">Marquer rendu</button>
                                    </form>
                                {% else %}
                                    <span style="color:#6b7280;font-size:13px;">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6">Aucun prêt enregistré.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
{% endblock %}
