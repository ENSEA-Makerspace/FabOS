{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_loans.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260827-s151b' }}">
    {# S134j — `.loan-status` and its three states are gone: they were a
       fourth private copy of the state chip, with their own radius, their own
       weight and their own colour mixes, so "En retard" here and "En panne" on
       /admin/machines were two different objects saying the same kind of thing.
       `_cell_state` and a signal now. The `.admin-table` padding override was a
       verbatim copy of the shared rule.

       ⚠️ `.return-inline` stays: it is a WRITE form with a text field, not a
       cell type, and `_cell_actions` deliberately refuses to grow a `method`. #}
    <style>
        .return-inline { display: flex; gap: 6px; align-items: center; }
        .return-inline input[type=text] { padding: 6px 9px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 13px; max-width: 150px; }
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'admin_loans.action_label'|trans,
    action_route: 'app_admin_loan_new',
    panel_title: 'admin_loans.panel_title'|trans,
    list_tiles_label: 'admin_list.facet_status'|trans,
    list_client_filter: true,
    panel_note: 'admin_loans.panel_note'|trans({'count': loans|length}),
    list_count: loans|length,
    list_route: 'app_admin_loans',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: loans|length, category: 'all', active: true},
        {label: 'admin_list.out'|trans, count: loans|filter(loan => loan.effectiveStatus == 'out')|length, category: 'out'},
        {label: 'admin_list.overdue'|trans, count: loans|filter(loan => loan.effectiveStatus == 'overdue')|length, category: 'overdue'},
        {label: 'admin_list.returned'|trans, count: loans|filter(loan => loan.effectiveStatus == 'returned')|length, category: 'returned'},
    ],
} %}
    {% block content %}
            <div class="admin-table-wrap">
                {# 🔴 **Six headers over five cells, and it shipped that way** (found in
                   S141e's content review, the same fault as
                   `/staff/acces-exceptionnels`). `col_borrower` had no `<td>`: the
                   borrower became the item cell's subtitle and the header stayed, so the
                   dates sat under "Emprunteur", the state under "Échéance", the return
                   form under "Statut", and "Action" was an empty sliver.
                   ⚠️ Above the embed, never between two keys of its argument hash. #}
                {% embed 'site/_data_table.html.twig' with {
                    pin_actions: true,
                    columns: [
                        {label: 'admin_loans.col_item'|trans, class: 'is-grow'},
                        {label: 'admin_loans.col_taken'|trans, class: 'is-tight'},
                        {label: 'admin_loans.col_due'|trans, class: 'is-tight'},
                        {label: 'admin_loans.col_status'|trans, class: 'is-tight'},
                        {label: 'admin_loans.col_action'|trans, class: 'is-actions'},
                    ],
                    rows: loans,
                    empty: 'admin_loans.empty'|trans,
                } %}
                    {% block rows %}
{% for loan in loans %}
                        {% set st = loan.effectiveStatus %}
                        <tr data-admin-list-filter-row data-admin-list-filter-category="{{ st }}">
                            {# The object a loan is *of* was the only unlinked name
                               on the page — an operator reading "who has the drill"
                               had to go back to Objets prêtables and find it again. #}
                            <td>{% include 'site/_cell_title.html.twig' with {
                                title: loan.item ? loan.item.name : '',
                                href: loan.item ? path('app_loans_item', {id: loan.item.id}) : '',
                                subtitle: loan.borrowerDisplay,
                            } only %}</td>
                            <td>{% include 'site/_cell_date.html.twig' with {value: loan.dateTaken, convention: 'wall', format: 'd/m/Y'} only %}</td>
                            <td>{% include 'site/_cell_date.html.twig' with {value: loan.expectedReturnDate, convention: 'wall', format: 'd/m/Y'} only %}</td>
                            <td>{% include 'site/_cell_state.html.twig' with {
                                label: ('admin_loans.status_' ~ (st == 'returned' ? 'returned' : (st == 'overdue' ? 'overdue' : 'out')))|trans,
                                signal: st == 'returned' ? 'go' : (st == 'overdue' ? 'stop' : 'wait'),
                            } only %}{% if loan.actualReturnDate %}<span class="cell-date-meta">{{ 'admin_loans.returned_on'|trans({'%date%': loan.actualReturnDate|date('d/m/Y')}) }}</span>{% endif %}</td>
                            <td>
                                {% if not loan.returned %}
                                    <form class="return-inline" method="post" action="{{ path('app_admin_loan_return', {id: loan.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('return_loan_' ~ loan.id) }}">
                                        <input type="text" name="conditionReturn" placeholder="{{ 'admin_loans.condition_placeholder'|trans }}" aria-label="{{ 'admin_loans.condition_placeholder'|trans }}">
                                        <button class="btn-action btn-primary-admin" type="submit">{{ 'admin_loans.mark_returned'|trans }}</button>
                                    </form>
                                {% else %}
                                    {# 🔴 Was `style="color:#6b7280"` — a literal grey that stays
                                       #6b7280 in dark mode, on a dark panel. #}
                                    {% include 'site/_cell_empty.html.twig' with {reason: 'admin_loans.status_returned'} only %}
                                {% endif %}
                            </td>
                        </tr>
                    {# ⚠️ No `{% else %}` empty row here: `_data_table` renders its own
                       when `rows` is empty, and it never calls this block in that case —
                       so the hand-written one was unreachable AND hand-counted its own
                       column span — six, on a list that has five — which is exactly what
                       that component's docblock forbids. Deleted in S141e. #}
                    {% endfor %}
                    {% endblock %}
                {% endembed %}
            </div>
    {% endblock %}
{% endembed %}
{% endblock %}
