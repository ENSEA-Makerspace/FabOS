{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_loans.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s130b-one-nav' }}">
    <style>
        
        .admin-table th, .admin-table td { padding: 13px 16px; border-bottom: 1px solid var(--border-color); text-align: left; vertical-align: middle; }
        .loan-status { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
        .loan-status.out { background: color-mix(in srgb, var(--color-info) 15%, var(--theme-surface)); color: var(--color-info); }
        .loan-status.overdue { background: color-mix(in srgb, var(--color-stop, #b91c1c) 15%, var(--theme-surface)); color: var(--color-stop, #b91c1c); }
        .loan-status.returned { background: color-mix(in srgb, var(--color-ok) 15%, var(--theme-surface)); color: var(--color-ok); }
        .return-inline { display: flex; gap: 6px; align-items: center; }
        .return-inline input[type=text] { padding: 6px 9px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 13px; max-width: 150px; }
        @media (max-width: 900px) {.admin-page-header { padding: 24px 16px; }}
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'admin_loans.title'|trans,
    description: 'admin_loans.description'|trans,
    action_label: 'admin_loans.action_label'|trans,
    action_route: 'app_admin_loan_new',
    panel_title: 'admin_loans.panel_title'|trans,
    list_tools: true,
    list_client_filter: true,
    list_route: 'app_admin_loans',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: loans|length, category: 'all', active: true},
        {label: 'admin_list.out'|trans, count: loans|filter(loan => loan.effectiveStatus == 'out')|length, category: 'out'},
        {label: 'admin_list.overdue'|trans, count: loans|filter(loan => loan.effectiveStatus == 'overdue')|length, category: 'overdue'},
        {label: 'admin_list.returned'|trans, count: loans|filter(loan => loan.effectiveStatus == 'returned')|length, category: 'returned'},
    ],
} %}
    {% block content %}
            <div class="admin-table-wrap">
                {% embed 'site/_data_table.html.twig' with {
                    pin_actions: true,
                    columns: [
                        {label: 'admin_loans.col_item'|trans},
                        {label: 'admin_loans.col_borrower'|trans},
                        {label: 'admin_loans.col_taken'|trans},
                        {label: 'admin_loans.col_due'|trans},
                        {label: 'admin_loans.col_status'|trans},
                        {label: 'admin_loans.col_action'|trans},
                    ],
                    rows: loans,
                    empty: 'admin_loans.empty'|trans,
                } %}
                    {% block rows %}
{% for loan in loans %}
                        {% set st = loan.effectiveStatus %}
                        <tr data-admin-list-filter-row data-admin-list-filter-category="{{ st }}">
                            {# The object a loan is *of* was the only unlinked name
                               on the page — an operator reading "who has the drill"
                               had to go back to Objets prêtables and find it again. #}
                            <td>{% if loan.item %}<a href="{{ path('app_admin_loanable_item_edit', {id: loan.item.id}) }}">{{ loan.item.name }}</a>{% else %}—{% endif %}</td>
                            <td>{{ loan.borrowerDisplay }}</td>
                            <td>{{ loan.dateTaken|date('d/m/Y') }}</td>
                            <td>{{ loan.expectedReturnDate ? loan.expectedReturnDate|date('d/m/Y') : '—' }}</td>
                            <td>
                                <span class="loan-status {{ st }}">
                                    {{ ('admin_loans.status_' ~ (st == 'returned' ? 'returned' : (st == 'overdue' ? 'overdue' : 'out')))|trans }}
                                </span>
                                {% if loan.actualReturnDate %}<div style="font-size:12px;color:#6b7280;margin-top:3px;">{{ 'admin_loans.returned_on'|trans({'%date%': loan.actualReturnDate|date('d/m/Y')}) }}</div>{% endif %}
                            </td>
                            <td>
                                {% if not loan.returned %}
                                    <form class="return-inline" method="post" action="{{ path('app_admin_loan_return', {id: loan.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('return_loan_' ~ loan.id) }}">
                                        <input type="text" name="conditionReturn" placeholder="{{ 'admin_loans.condition_placeholder'|trans }}">
                                        <button class="btn-action btn-primary-admin" type="submit">{{ 'admin_loans.mark_returned'|trans }}</button>
                                    </form>
                                {% else %}
                                    <span style="color:#6b7280;font-size:13px;">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6">{{ 'admin_loans.empty'|trans }}</td></tr>
                    {% endfor %}
                    {% endblock %}
                {% endembed %}
            </div>
    {% endblock %}
{% endembed %}
{% endblock %}
