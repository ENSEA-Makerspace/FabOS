{% extends 'base.html.twig' %}

{% block title %}{{ package.id|default(false) ? 'usage_rights.edit'|trans : 'usage_rights.create'|trans }} · FabOS{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s148j5' }}">{% endblock %}
{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    page_title: package.id|default(false) ? 'usage_rights.edit'|trans : 'usage_rights.create'|trans,
    panel_title: 'usage_rights.package_details'|trans,
} %}
    {% block content %}
        {# ⚠️ It was the shell's `description`, the line under the heading, until
           S141 gave the band's subtitle to the count and nothing else. On a form
           there is nothing to count, so the sentence moves into the body it was
           describing rather than being deleted with the parameter. #}
        <p class="usage-hint">{{ 'usage_rights.form_description'|trans }}</p>
        {{ form_start(detailsForm, {attr: {class: 'usage-package-form'}}) }}
            {% form_theme detailsForm 'form/admin_theme.html.twig' %}
            {{ form_row(detailsForm.name) }}
            {{ form_row(detailsForm.description) }}
            {{ form_row(detailsForm.active) }}
            {{ form_row(detailsForm.full_access) }}
            {# ⚠️ **La matrice reste du balisage, et c'est délibéré (S147, J-22).**
               `_usage_rights_matrix.html.twig` est un partial PARTAGÉ — la
               prévisualisation d'un droit s'en sert ailleurs — et ses cases postent
               `features[]` à la racine, hors du nom du formulaire. L'absorber dans
               le `FormType` le casserait pour ses autres appelants pour ne gagner
               qu'une uniformité de façade. #}
            {% include 'site/_usage_rights_matrix.html.twig' with {
                capabilities: availableFeatures,
                enabled: enabledFeatures,
                selected: package.features,
                id_prefix: 'package-rights',
            } only %}
            <div class="admin-actions"><button class="btn-link btn-primary-admin" type="submit">{{ 'common.save'|trans }}</button><a class="admin-action" href="{{ path('app_admin_usage_rights') }}">{{ 'common.cancel'|trans }}</a></div>
        {{ form_end(detailsForm) }}
    {% endblock %}
    {% block panel_extra %}
        {% if package.id|default(false) %}
            {# ⚠️ **The grants editor (S134b).** The feature checkboxes above are the
               v1 model: a package grants a feature, full stop. Grants v2 adds three
               dimensions — an action, a location, a section — and until this block
               existed they were reachable only by SQL, which is not what
               "administrable" means. The two coexist while chokepoints are being
               moved one at a time; the checkboxes stop deciding anything for a
               capability the moment it is switched on `/admin/usage-rights/shadow`. #}
            <section class="usage-assignments">
                <div class="admin-panel-header"><h2>{{ 'usage_rights.grants'|trans }}</h2></div>
                <p class="settings-hint">{{ 'usage_rights.grants_help'|trans }}</p>

                {# ⚠️ **Neuf champs qui posent UNE phrase** : « ce package laisse
                   *utiliser* les *imprimantes 3D* du *lieu X*, le *jeudi* de *14 h*
                   à *18 h* ». Ils restent ensemble parce que c'est ainsi qu'un
                   opérateur y pense — et la plage y est facultative : sans elle le
                   grant est éveillé toute la semaine, ce que sont tous les grants
                   écrits avant S144b.
                   ⚠️ **Un seul champ pour la ressource, pas deux** (S144b) : le
                   genre se déduit de la valeur choisie, `machine` ou `machine:12`. #}
                {{ form_start(grantForm, {attr: {class: 'usage-assignment-form usage-grant-form'}}) }}
                    {% form_theme grantForm 'form/admin_theme.html.twig' %}
                    {{ form_row(grantForm.feature) }}
                    {# ⚠️ Manage never confers Use — a manage-only grant leaves
                       reporting open and booking closed. That is the whole
                       reason the dimension exists, so the two are never a
                       single "level" dropdown. #}
                    {{ form_row(grantForm.grant_action) }}
                    {{ form_row(grantForm.venue_id) }}
                    {{ form_row(grantForm.section) }}
                    {{ form_row(grantForm.reservable) }}
                    {{ form_row(grantForm.category_label) }}
                    {{ form_row(grantForm.day_of_week) }}
                    {{ form_row(grantForm.start_time) }}
                    {{ form_row(grantForm.end_time) }}
                    <button class="btn-link btn-primary-admin" type="submit">{{ 'usage_rights.grant_add'|trans }}</button>
                {{ form_end(grantForm) }}

                {% if grants %}
                    <div class="usage-assignment-list">
                        {% for grant in grants %}
                            <div class="usage-assignment">
                                <span>
                                    <strong>{{ availableFeatures[grant.featureKey].labelKey|default(grant.featureKey)|trans }}</strong>
                                    <small>
                                        {{ ('usage_rights.grant_' ~ grant.action)|trans }}
                                        · {{ grant.venueName ?: 'usage_rights.grant_any_venue'|trans }}
                                        {%- if grant.sectionKey %} · {{ grant.sectionKey }}{% endif %}
                                        {%- if grant.reservableId %} · {{ resourceNames[grant.reservableType ~ ':' ~ grant.reservableId]|default('#' ~ grant.reservableId) }}
                                        {%- elseif grant.reservableType %} · {{ ('usage_rights.grant_all_' ~ grant.reservableType ~ 's')|trans }}{% endif %}
                                        {%- if grant.categoryLabel %} · {{ grant.categoryLabel }}{% endif %}
                                        {# ⚠️ Said in words, because "no window" means
                                           "any time" and an empty list would read as
                                           "never". #}
                                        · {% if grant.windows is empty %}{{ 'usage_rights.window_none'|trans }}{% else %}
                                            {%- for window in grant.windows %}{{ ('usage_rights.day_' ~ window.dayOfWeek)|trans }} {{ window.label }}{% if not loop.last %}, {% endif %}{% endfor %}
                                        {%- endif %}
                                    </small>
                                </span>
                                <div class="usage-grant-controls">
                                    <form method="post" class="usage-window-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('usage_package_grants_' ~ package.id) }}">
                                        <input type="hidden" name="action" value="window_add">
                                        <input type="hidden" name="grant_id" value="{{ grant.id }}">
                                        <select name="day_of_week" aria-label="{{ 'usage_rights.grant_window'|trans }}">
                                            {% for day in 1..7 %}<option value="{{ day }}">{{ ('usage_rights.day_' ~ day)|trans }}</option>{% endfor %}
                                        </select>
                                        <input type="time" name="start_time" value="14:00" aria-label="{{ 'usage_rights.window_from'|trans }}">
                                        <input type="time" name="end_time" value="18:00" aria-label="{{ 'usage_rights.window_to'|trans }}">
                                        <button class="admin-action" type="submit">{{ 'usage_rights.window_add'|trans }}</button>
                                    </form>
                                    {% for window in grant.windows %}
                                        {# ⚠️ Removing the last window WIDENS the grant
                                           to the whole week — the one delete here that
                                           grants more than it takes, so it says which
                                           way it goes. #}
                                        <form method="post"
                                              data-controller="confirm" data-action="submit->confirm#ask"
                                              data-confirm-message-value="{{ 'usage_rights.window_delete_confirm'|trans }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('usage_package_grants_' ~ package.id) }}">
                                            <input type="hidden" name="action" value="window_delete">
                                            <input type="hidden" name="window_id" value="{{ window.id }}">
                                            <button class="admin-action" type="submit">{{ 'usage_rights.window_remove'|trans({'%window%': ('usage_rights.day_' ~ window.dayOfWeek)|trans ~ ' ' ~ window.label}) }}</button>
                                        </form>
                                    {% endfor %}
                                    {# Deleting can narrow access, so it confirms; adding
                                       only ever widens it, so it does not. #}
                                    <form method="post"
                                          data-controller="confirm" data-action="submit->confirm#ask"
                                          data-confirm-message-value="{{ 'usage_rights.grant_delete_confirm'|trans }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('usage_package_grants_' ~ package.id) }}">
                                        <input type="hidden" name="action" value="grant_delete">
                                        <input type="hidden" name="grant_id" value="{{ grant.id }}">
                                        <button class="admin-action danger" type="submit">{{ 'common.delete'|trans }}</button>
                                    </form>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="usage-empty">{{ 'usage_rights.no_grants'|trans }}</p>
                {% endif %}
            </section>

            {# ⚠️ **The one editor on this page where adding NARROWS access
               (S144c).** A package with no allowance is unlimited; the first row
               turns "as much as you like" into "ten hours a week". Its own
               section and its own token, so it never reads as another grant. #}
            <section class="usage-assignments">
                <div class="admin-panel-header"><h2>{{ 'usage_rights.allowances'|trans }}</h2></div>
                <p class="settings-hint">{{ 'usage_rights.allowances_help'|trans }}</p>

                {% if allowancesReady %}
                    {# ⚠️ **Deux champs de quantité pour une seule question, et
                       c'est l'unité qui décide lequel compte.** En heures le
                       contrôleur lit `allowance_hours` et le convertit en minutes ;
                       en séances il lit `allowance_count`. Les fusionner écrirait
                       des séances dans une colonne de minutes — un quota faux et
                       muet. #}
                    {{ form_start(allowanceForm, {attr: {class: 'usage-assignment-form usage-grant-form'}}) }}
                        {% form_theme allowanceForm 'form/admin_theme.html.twig' %}
                        {{ form_row(allowanceForm.allowance_feature) }}
                        {{ form_row(allowanceForm.allowance_reservable) }}
                        {{ form_row(allowanceForm.allowance_unit) }}
                        {{ form_row(allowanceForm.allowance_hours) }}
                        {{ form_row(allowanceForm.allowance_count) }}
                        {{ form_row(allowanceForm.allowance_period) }}
                        <button class="btn-link btn-primary-admin" type="submit">{{ 'usage_rights.allowance_add'|trans }}</button>
                    {{ form_end(allowanceForm) }}
                {% else %}
                    <p class="usage-empty">{{ 'usage_rights.allowances_migration_pending'|trans }}</p>
                {% endif %}

                {% if allowances %}
                    <div class="usage-assignment-list">
                        {% for allowance in allowances %}
                            <div class="usage-assignment">
                                <span>
                                    <strong>
                                        {%- if allowance.unit == 'minutes' -%}
                                            {{ 'usage_rights.allowance_hours_value'|trans({'%hours%': (allowance.amount / 60)|round(2)}) }}
                                        {%- else -%}
                                            {{ 'usage_rights.allowance_count_value'|trans({'count': allowance.amount}) }}
                                        {%- endif %}
                                        {{ ('usage_rights.allowance_period_' ~ allowance.period)|trans }}
                                    </strong>
                                    <small>
                                        {{ allowance.featureKey ? availableFeatures[allowance.featureKey].labelKey|default(allowance.featureKey)|trans : 'usage_rights.allowance_any_feature'|trans }}
                                        · {{ allowance.reservableType ? ('usage_rights.grant_all_' ~ allowance.reservableType ~ 's')|trans : 'usage_rights.grant_any_resource'|trans }}
                                    </small>
                                </span>
                                {# ⚠️ Deleting an allowance WIDENS access — it gives
                                   the hours back. The opposite of every other
                                   confirmation on this page, so it says which way
                                   it goes rather than just "are you sure". #}
                                <form method="post"
                                      data-controller="confirm" data-action="submit->confirm#ask"
                                      data-confirm-message-value="{{ 'usage_rights.allowance_delete_confirm'|trans }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('usage_package_allowances_' ~ package.id) }}">
                                    <input type="hidden" name="action" value="allowance_delete">
                                    <input type="hidden" name="allowance_id" value="{{ allowance.id }}">
                                    <button class="admin-action danger" type="submit">{{ 'common.delete'|trans }}</button>
                                </form>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="usage-empty">{{ 'usage_rights.no_allowances'|trans }}</p>
                {% endif %}
            </section>

            <section class="usage-assignments">
                <div class="admin-panel-header"><h2>{{ 'usage_rights.assignments'|trans }}</h2></div>
                {# 🔴 Les deux dates rendent une CHAÎNE : c'est le contrôleur qui
                   les construit dans le fuseau du LABO. Laisser le formulaire
                   hydrater un `DateTimeImmutable` le ferait dans le fuseau PHP —
                   UTC ici — et décalerait toute validité sans rien dire. #}
                {{ form_start(assignForm, {attr: {class: 'usage-assignment-form'}}) }}
                    {% form_theme assignForm 'form/admin_theme.html.twig' %}
                    {{ form_row(assignForm.user_id) }}
                    {{ form_row(assignForm.valid_from) }}
                    {{ form_row(assignForm.valid_until) }}
                    <button class="btn-link btn-primary-admin" type="submit">{{ 'usage_rights.assign'|trans }}</button>
                {{ form_end(assignForm) }}
                {# ⚠️ **A second form, not a second field (S144a).** Giving a package
                   to a group writes a different column, refuses for different
                   reasons and reaches people who do not exist yet — a member/group
                   toggle on one form would have to ignore one of its two selects
                   on every submission. #}
                {{ form_start(assignGroupForm, {attr: {class: 'usage-assignment-form'}}) }}
                    {% form_theme assignGroupForm 'form/admin_theme.html.twig' %}
                    {{ form_row(assignGroupForm.group_key) }}
                    {{ form_row(assignGroupForm.valid_from) }}
                    {{ form_row(assignGroupForm.valid_until) }}
                    <button class="btn-link btn-primary-admin" type="submit">{{ 'usage_rights.assign_group'|trans }}</button>
                {{ form_end(assignGroupForm) }}
                <p class="settings-hint">{{ 'usage_rights.assign_group_help'|trans }}</p>

                {% if assignments %}
                    <div class="usage-assignment-list">
                        {% for assignment in assignments %}
                            <div class="usage-assignment">
                                <span>
                                    <strong>{{ assignment.name }}</strong>
                                    <small>
                                        {% if assignment.kind == 'group' %}
                                            {{ 'usage_rights.assignment_group'|trans }}
                                            · {{ assignment.members is null ? 'usage_rights.group_everyone'|trans : 'usage_rights.group_members'|trans({'count': assignment.members}) }}
                                        {% else %}
                                            {{ assignment.detail }}
                                        {% endif %}
                                        · {{ assignment.validFrom ?: 'usage_rights.now'|trans }} → {{ assignment.validUntil ?: 'usage_rights.no_end'|trans }}
                                    </small>
                                </span>
                                <form method="post">
                                    <input type="hidden" name="_token" value="{{ csrf_token('usage_package_revoke_' ~ package.id) }}">
                                    <input type="hidden" name="action" value="revoke">
                                    <input type="hidden" name="assignment_id" value="{{ assignment.id }}">
                                    <button class="admin-action danger" type="submit">{{ 'usage_rights.revoke'|trans }}</button>
                                </form>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="usage-empty">{{ 'usage_rights.no_assignments'|trans }}</p>
                {% endif %}
            </section>
        {% endif %}
    {% endblock %}
{% endembed %}
{% endblock %}
