{% extends 'base.html.twig' %}

{% block title %}{{ package.id|default(false) ? 'usage_rights.edit'|trans : 'usage_rights.create'|trans }} · FabOS{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260903-design2' }}">{% endblock %}
{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    page_title: package.id|default(false) ? 'usage_rights.edit'|trans : 'usage_rights.create'|trans,
    panel_title: 'usage_rights.package_details'|trans,
} %}
    {% block content %}
        {# ⚠️ It was the shell's `description`, the line under the heading, until
           S141 gave the band's subtitle to the count and nothing else. On a form
           there is nothing to count, so the sentence moves into the body it was
           describing rather than being deleted with the parameter. #}
        <p class="usage-hint">{{ 'usage_rights.form_description'|trans }}</p>
        {{ form_start(detailsForm, {attr: {class: 'usage-package-form'}}) }}
            {% form_theme detailsForm 'form/admin_theme.html.twig' %}
            {{ form_row(detailsForm.name) }}
            {{ form_row(detailsForm.description) }}
            {{ form_row(detailsForm.active) }}
            {# 🔴 **S153 — la matrice de fonctionnalités et la case « accès
               complet » sont PARTIES d'ici.** Ce que le package autorise se
               saisit dans la carte « Ce que ce package autorise », en dessous,
               et un compilateur l'écrit dans les cinq tables. Deux surfaces
               d'écriture pour un même fait, c'est ce que la mesure a trouvé en
               base : un package portant `fullAccess = 1` ET quatorze grants,
               deux vérités dont rien ne disait laquelle l'écran croyait.
               ⚠️ Cette carte-ci n'écrit donc plus que l'identité — et renommer
               un package ne peut plus, en silence, changer ses droits. #}
            <div class="admin-actions"><button class="btn-link btn-primary-admin" type="submit">{{ 'common.save'|trans }}</button><a class="admin-action" href="{{ path('app_admin_usage_rights') }}">{{ 'common.cancel'|trans }}</a></div>
        {{ form_end(detailsForm) }}
    {% endblock %}
    {% block panel_extra %}
        {% if package.id|default(false) %}
            {# ============================================================
               LA SAISIE (S153) — quatre lignes de restriction, une d'extension.

               🔴 **Elle passe AVANT l'éditeur détaillé, et c'est le point.** La
               mesure du 2026-08-28 : les deux packages existants portent 21
               grants, et les 21 ont lieu, section, ressource et catégorie VIDES ;
               zéro fenêtre, zéro quota. Les six dimensions que l'écran faisait
               remplir n'ont jamais servi, et « tout autoriser » a coûté quatorze
               créations de grant. Ici, les sept cas réels de l'opérateur tiennent
               en zéro à deux décochages.

               🔴 **La révélation est en CSS pur (`:has()`), sans une ligne de
               JavaScript.** Un contrôleur Stimulus ferait la même chose en moins
               bien : il faudrait qu'il tourne pour que le formulaire soit
               utilisable. Ici, sans JS, tout marche déjà.
               ⚠️ **Et le CSS CACHE, il ne désactive rien** : les listes repliées
               postent leur contenu. C'est la CASE qui décide, côté serveur —
               même leçon que le préréglage de plage de S149.

               ⚠️ `specFits` vient du contrôleur. Un package que ces cinq lignes
               ne savent pas exprimer — un grant `Manage`, une section, une
               machine précise — n'ouvre pas cette carte : la rouvrir écraserait
               à la première soumission ce qu'elle n'a pas su afficher.
               ============================================================ #}
            {% if specFits and specForm %}
                <section class="usage-assignments">
                    <div class="admin-panel-header"><h2>{{ 'usage_rights.spec_heading'|trans }}</h2></div>
                    {{ form_start(specForm, {attr: {class: 'pkg-spec'}}) }}
                        {% form_theme specForm 'form/admin_theme.html.twig' %}
                        {# 🔴 **La phrase du haut MENTAIT, et elle est remplacée
                           par un résumé CALCULÉ.** `usage_rights.spec_sentence`
                           était une chaîne fixe — « donne accès à tout, tout le
                           temps, partout, sans limite » — rendue à l'identique
                           sur les quatre forfaits de la boîte, OpenLab compris,
                           qui est restreint. Elle était présentée comme la ligne
                           de conséquence de la carte ; elle n'en lisait rien.

                           ✅ Ce qui la remplace vient de `specSummary()`, calculé
                           depuis le MÊME spec décompilé qui coche les cases juste
                           en dessous : les deux ne peuvent pas diverger. Et c'est
                           `_admin_meta_grid`, la grille label → valeur du système
                           de design, au lieu d'une phrase à `|raw`. #}
                        {% if specSummary %}
                            {% include 'site/_admin_meta_grid.html.twig' with {items: specSummary} only %}
                        {% endif %}

                        <div class="pkg-axis">
                            <div class="pkg-axis-head">
                                <span class="pkg-axis-key">{{ 'usage_rights.spec_axis_what'|trans }}</span>
                                <span class="pkg-toggle">{{ form_widget(specForm.features_all) }}{{ form_label(specForm.features_all) }}</span>
                            </div>
                            <div class="pkg-detail">
                                {{ form_widget(specForm.features) }}
                                <p class="pkg-hint">{{ 'usage_rights.spec_features_hint'|trans }}</p>
                            </div>
                        </div>

                        <div class="pkg-axis">
                            <div class="pkg-axis-head">
                                <span class="pkg-axis-key">{{ 'usage_rights.spec_axis_when'|trans }}</span>
                                <span class="pkg-toggle">{{ form_widget(specForm.days_all) }}{{ form_label(specForm.days_all) }}</span>
                            </div>
                            <div class="pkg-detail">
                                {{ form_widget(specForm.days) }}
                                <p class="pkg-hint">
                                    {{ form_label(specForm.start_time) }} {{ form_widget(specForm.start_time) }}
                                    {{ form_label(specForm.end_time) }} {{ form_widget(specForm.end_time) }}
                                </p>
                                <p class="pkg-hint">{{ 'usage_rights.spec_days_hint'|trans }}</p>
                            </div>
                        </div>

                        <div class="pkg-axis">
                            <div class="pkg-axis-head">
                                <span class="pkg-axis-key">{{ 'usage_rights.spec_axis_where'|trans }}</span>
                                <span class="pkg-toggle">{{ form_widget(specForm.venues_all) }}{{ form_label(specForm.venues_all) }}</span>
                            </div>
                            <div class="pkg-detail">
                                {{ form_widget(specForm.venues) }}
                                {# La catégorie de machines est le seul « avancé » qui
                                   reste, parce que c'est le seul des quatre axes
                                   retirés que l'opérateur a nommé dans ses sept cas. #}
                                <details class="pkg-adv">
                                    <summary>{{ 'usage_rights.spec_categories_summary'|trans }}</summary>
                                    <div>
                                        <span class="pkg-toggle">{{ form_widget(specForm.categories_all) }}{{ form_label(specForm.categories_all) }}</span>
                                        <div class="pkg-detail-cat">{{ form_widget(specForm.categories) }}</div>
                                    </div>
                                </details>
                            </div>
                        </div>

                        <div class="pkg-axis">
                            <div class="pkg-axis-head">
                                <span class="pkg-axis-key">{{ 'usage_rights.spec_axis_how_much'|trans }}</span>
                                <span class="pkg-toggle">{{ form_widget(specForm.quota_unlimited) }}{{ form_label(specForm.quota_unlimited) }}</span>
                            </div>
                            <div class="pkg-detail">
                                <p class="pkg-hint">
                                    {{ form_label(specForm.quota_hours) }} {{ form_widget(specForm.quota_hours) }}
                                    {{ form_widget(specForm.quota_period) }}
                                </p>
                            </div>
                        </div>

                        {# ⚠️ **La cinquième ligne AJOUTE un pouvoir**, les quatre
                           autres en retirent : elle arrive donc DÉCOCHÉE, et elle
                           ne se révèle que si les quatre autres sont sur « aucune
                           restriction ». Ce n'est pas de la coquetterie : elle
                           s'écrit dans `USAGE_PACKAGE.fullAccess`, un seul bit,
                           qui ne sait pas dire « tout sauf le jeudi ». Le serveur
                           refuse la combinaison ; le CSS évite d'avoir à la
                           proposer. #}
                        <div class="pkg-axis pkg-axis-exempt">
                            <div class="pkg-axis-head">
                                <span class="pkg-axis-key">{{ 'usage_rights.spec_axis_hours'|trans }}</span>
                                <span class="pkg-toggle">{{ form_widget(specForm.hours_exempt) }}{{ form_label(specForm.hours_exempt) }}</span>
                            </div>
                            <p class="pkg-hint">{{ 'usage_rights.spec_hours_hint'|trans }}</p>
                        </div>

                        <div class="admin-actions"><button class="btn-link btn-primary-admin" type="submit">{{ 'common.save'|trans }}</button></div>
                    {{ form_end(specForm) }}
                </section>
            {% else %}
                <section class="usage-assignments">
                    <div class="admin-panel-header"><h2>{{ 'usage_rights.spec_heading'|trans }}</h2></div>
                    <p class="settings-hint">{{ 'usage_rights.spec_unavailable'|trans }}</p>
                </section>
            {% endif %}

            {# **CE QUE LA SAISIE A COMPILÉ** — la liste des grants du package,
               en lecture, plus le bouton qui en retire un.

               ⚠️ Les notes qui vivaient ici décrivaient l'éditeur à neuf champs de
               S134b/S144b/S149 ; il n'existe plus (voir juste en dessous), et les
               garder aurait laissé un commentaire qui décrit un écran absent. Le
               raisonnement de ces trois sessions vit dans `HISTORY.md`. #}
            {# ============================================================
               CE QUI EST ÉCRIT EN BASE — la SORTIE du compilateur, repliée.

               🔴 **« Grants v2 » était un mot de firmware dans un titre.** Et
               sous ce titre, six lignes identiques — même action, « tout lieu »,
               « à toute heure » — qui répétaient une par une ce que la carte du
               dessus dit en quatre. Ce n'est pas une seconde information : c'est
               la première, décompressée.

               🔴 **Le pli est CONDITIONNEL, et c'est tout le raisonnement.**
               Quand la carte du dessus sait exprimer le forfait (`specFits`),
               ces lignes sont dérivées : les lire est une vérification, pas une
               tâche, et les SUPPRIMER créerait la divergence que S153 a
               supprimée — la saisie les réécrirait à la sauvegarde suivante.
               Quand elle ne le sait PAS, ce bloc est la seule prise sur le
               forfait : il s'ouvre, et les suppressions reviennent avec lui.

               ⚠️ **L'issue de secours n'apparaît donc que quand on est
               coincé.** C'est la règle, dite une fois ici : un bouton qui défait
               ce qu'un autre écran vient d'écrire n'est pas une option avancée,
               c'est un piège — sauf quand il est le seul chemin.
               ============================================================ #}
            <section class="usage-assignments">
                <details class="pkg-compiled"{{ specFits ? '' : ' open' }}>
                    <summary>
                        <span class="pkg-compiled-title">{{ 'usage_rights.compiled_heading'|trans }}</span>
                        {% include 'site/_cell_state.html.twig' with {
                            label: 'usage_rights.compiled_count'|trans({'%grants%': grants|length, '%allowances%': allowances|length}),
                            signal: 'muted',
                        } only %}
                    </summary>
                    <div class="pkg-compiled-body">
                <p class="settings-hint">{{ (specFits ? 'usage_rights.compiled_help_derived' : 'usage_rights.compiled_help_escape')|trans }}</p>
                <h3 class="pkg-compiled-sub">{{ 'usage_rights.grants'|trans }}</h3>

                {# 🔴 **S153b — l'éditeur « Ajouter un grant » est PARTI, et c'est
                   l'aboutissement de la phase.** Neuf champs qui écrivaient les
                   mêmes lignes que la carte du haut : deux surfaces d'écriture pour
                   un même fait, exactement ce que la mesure du 2026-08-28 avait
                   trouvé EN BASE (un package portant `fullAccess = 1` ET quatorze
                   grants, sans que rien ne dise laquelle des deux vérités l'écran
                   croyait).

                   ⚠️ Et les deux ne cohabitaient pas : la saisie REMPLACE les grants
                   du package. Un grant tapé ici aurait disparu sans un mot à la
                   sauvegarde suivante de la carte du haut — un piège, pas une option
                   avancée.

                   ⚠️ **La liste ci-dessous reste, et sa suppression aussi.** Elle
                   montre ce que la saisie a compilé — c'est le seul endroit qui dise
                   ce qui est réellement en base — et supprimer un grant est l'issue
                   de secours qui fait re-rentrer dans la saisie un package qu'elle
                   refuse (voir `PackageSpecCompiler::decompile()`). #}

                {% if grants %}
                    <div class="usage-assignment-list">
                        {% for grant in grants %}
                            <div class="usage-assignment">
                                <span>
                                    <strong>{{ availableFeatures[grant.featureKey].labelKey|default(grant.featureKey)|trans }}</strong>
                                    <small>
                                        {{ ('usage_rights.grant_' ~ grant.action)|trans }}
                                        · {{ grant.venueName ?: 'usage_rights.grant_any_venue'|trans }}
                                        {%- if grant.sectionKey %} · {{ grant.sectionKey }}{% endif %}
                                        {%- if grant.reservableId %} · {{ resourceNames[grant.reservableType ~ ':' ~ grant.reservableId]|default('#' ~ grant.reservableId) }}
                                        {%- elseif grant.reservableType %} · {{ ('usage_rights.grant_all_' ~ grant.reservableType ~ 's')|trans }}{% endif %}
                                        {%- if grant.categoryLabel %} · {{ grant.categoryLabel }}{% endif %}
                                        {# ⚠️ Said in words, because "no window" means
                                           "any time" and an empty list would read as
                                           "never". #}
                                        · {% if grant.windows is empty %}{{ 'usage_rights.window_none'|trans }}{% else %}
                                            {%- for window in grant.windows %}{{ ('usage_rights.day_' ~ window.dayOfWeek)|trans }} {{ window.label }}{% if not loop.last %}, {% endif %}{% endfor %}
                                        {%- endif %}
                                    </small>
                                </span>
                                <div class="usage-grant-controls">
                                    {# 🔴 **S153b — le formulaire « Ajouter une plage »
                                       est parti d'ici aussi**, pour la même raison que
                                       les deux autres : la semaine d'un package se dit
                                       ligne « quand », en un seul endroit. Retirer une
                                       plage reste possible juste en dessous — c'est
                                       l'issue de secours, pas une seconde saisie. #}
                                    {% for window in grant.windows %}
                                        {# ⚠️ Removing the last window WIDENS the grant
                                           to the whole week — the one delete here that
                                           grants more than it takes, so it says which
                                           way it goes. #}
                                        <form method="post"
                                              data-controller="confirm" data-action="submit->confirm#ask"
                                              data-confirm-message-value="{{ 'usage_rights.window_delete_confirm'|trans }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('usage_package_grants_' ~ package.id) }}">
                                            <input type="hidden" name="action" value="window_delete">
                                            <input type="hidden" name="window_id" value="{{ window.id }}">
                                            <button class="admin-action" type="submit">{{ 'usage_rights.window_remove'|trans({'%window%': ('usage_rights.day_' ~ window.dayOfWeek)|trans ~ ' ' ~ window.label}) }}</button>
                                        </form>
                                    {% endfor %}
                                    {# Deleting can narrow access, so it confirms; adding
                                       only ever widens it, so it does not. #}
                                    <form method="post"
                                          data-controller="confirm" data-action="submit->confirm#ask"
                                          data-confirm-message-value="{{ 'usage_rights.grant_delete_confirm'|trans }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('usage_package_grants_' ~ package.id) }}">
                                        <input type="hidden" name="action" value="grant_delete">
                                        <input type="hidden" name="grant_id" value="{{ grant.id }}">
                                        <button class="admin-action danger" type="submit">{{ 'common.delete'|trans }}</button>
                                    </form>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="usage-empty">{{ 'usage_rights.no_grants'|trans }}</p>
                {% endif %}

                {# ⚠️ Les allocations rejoignent le même pli : elles sont la
                   sortie de la ligne « combien », exactement comme les grants
                   sont celle des quatre autres. Deux sections de premier niveau
                   pour deux moitiés d'une même chose donnaient à la page deux
                   titres de plus que ce qu'elle contient. #}
                <h3 class="pkg-compiled-sub">{{ 'usage_rights.allowances'|trans }}</h3>

                {# 🔴 **S153b — l'éditeur « Ajouter une allocation » est PARTI.**
                   Les quotas se saisissent ligne « combien » de la carte du haut, et
                   nulle part ailleurs. Le garder aurait laissé deux surfaces
                   d'écriture pour un même fait — et la pire des deux, parce que la
                   saisie REMPLACE les allocations : une ligne ajoutée ici aurait
                   disparu sans un mot à la sauvegarde suivante.
                   ⚠️ La liste et sa suppression restent : elle montre ce que la
                   saisie a compilé, et supprimer est l'issue de secours. #}
                {% if not allowancesReady %}
                    <p class="usage-empty">{{ 'usage_rights.allowances_migration_pending'|trans }}</p>
                {% endif %}

                {% if allowances %}
                    <div class="usage-assignment-list">
                        {% for allowance in allowances %}
                            <div class="usage-assignment">
                                <span>
                                    <strong>
                                        {%- if allowance.unit == 'minutes' -%}
                                            {{ 'usage_rights.allowance_hours_value'|trans({'%hours%': (allowance.amount / 60)|round(2)}) }}
                                        {%- else -%}
                                            {{ 'usage_rights.allowance_count_value'|trans({'count': allowance.amount}) }}
                                        {%- endif %}
                                        {{ ('usage_rights.allowance_period_' ~ allowance.period)|trans }}
                                    </strong>
                                    <small>
                                        {{ allowance.featureKey ? availableFeatures[allowance.featureKey].labelKey|default(allowance.featureKey)|trans : 'usage_rights.allowance_any_feature'|trans }}
                                        · {{ allowance.reservableType ? ('usage_rights.grant_all_' ~ allowance.reservableType ~ 's')|trans : 'usage_rights.grant_any_resource'|trans }}
                                    </small>
                                </span>
                                {# ⚠️ Deleting an allowance WIDENS access — it gives
                                   the hours back. The opposite of every other
                                   confirmation on this page, so it says which way
                                   it goes rather than just "are you sure". #}
                                <form method="post"
                                      data-controller="confirm" data-action="submit->confirm#ask"
                                      data-confirm-message-value="{{ 'usage_rights.allowance_delete_confirm'|trans }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('usage_package_allowances_' ~ package.id) }}">
                                    <input type="hidden" name="action" value="allowance_delete">
                                    <input type="hidden" name="allowance_id" value="{{ allowance.id }}">
                                    <button class="admin-action danger" type="submit">{{ 'common.delete'|trans }}</button>
                                </form>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="usage-empty">{{ 'usage_rights.no_allowances'|trans }}</p>
                {% endif %}
                    </div>
                </details>
            </section>

            {# ============================================================
               QUI A CE FORFAIT — en LECTURE, et l'écriture est sur le groupe.

               🔴 **Un forfait DÉFINIT des droits ; un groupe dit QUI les a.**
               Cette page portait les deux, et c'est ce qui la rendait longue :
               on venait décrire ce qu'un forfait autorise et on repartait avec
               une liste de groupes à gérer. L'attribution vit maintenant sur la
               fiche du GROUPE, à côté de ses membres — les deux moitiés d'une
               même question, « qui, et avec quoi », enfin au même endroit.

               ⚠️ **Et la contrepartie est réelle** : attribuer demande un écran
               de plus depuis ici. C'est le prix pour que « les droits de ce
               groupe » se lisent en un seul endroit au lieu d'être répartis sur
               autant de fiches de forfait qu'il en tient.

               ⚠️ **Les lignes PERSONNELLES gardent leur révocation ici**, et
               elles seules : elles n'ont pas de fiche de groupe où aller. C'est
               le chemin qu'écrira le module commerce — un achat est individuel,
               et son remboursement doit pouvoir retirer exactement ce que cette
               commande-là a donné.
               ============================================================ #}
            <section class="usage-assignments">
                <div class="admin-panel-header"><h2>{{ 'usage_rights.assignments'|trans }}</h2></div>
                <p class="settings-hint">{{ 'usage_rights.assignments_read_help'|trans }}</p>

                {% if assignments %}
                    <div class="usage-assignment-list">
                        {% for assignment in assignments %}
                            <div class="usage-assignment">
                                <span>
                                    <strong>{{ assignment.name }}</strong>
                                    <small>
                                        {% if assignment.kind == 'group' %}
                                            {{ assignment.members is null ? 'usage_rights.group_everyone'|trans : 'usage_rights.group_members'|trans({'count': assignment.members}) }}
                                        {% else %}
                                            {{ assignment.detail }}
                                            · {{ assignment.validFrom ?: 'usage_rights.now'|trans }} → {{ assignment.validUntil ?: 'usage_rights.no_end'|trans }}
                                        {% endif %}
                                    </small>
                                </span>
                                {% if assignment.kind == 'group' %}
                                    {# La sortie est un LIEN, pas un bouton : ce qu'on
                                       veut faire d'un groupe se fait sur sa fiche, où
                                       ses membres sont visibles. #}
                                    {% if assignment.groupId|default(null) %}
                                        <a class="admin-action" href="{{ path('app_admin_group_edit', {id: assignment.groupId}) }}">{{ 'usage_rights.open_group'|trans }}</a>
                                    {% endif %}
                                {% else %}
                                    <form method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('usage_package_revoke_' ~ package.id) }}">
                                        <input type="hidden" name="action" value="revoke">
                                        <input type="hidden" name="assignment_id" value="{{ assignment.id }}">
                                        <button class="admin-action danger" type="submit">{{ 'usage_rights.revoke'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    {# 🅿️ **Le chemin manquant, gardé de la revue R6** : rien ne
                       menait d'ici vers « créer le groupe qui va le porter ». Le
                       nom part en paramètre, la page des groupes ouvre son
                       formulaire déjà rempli. #}
                    <p class="usage-empty">
                        {{ 'usage_rights.no_assignments'|trans }}
                        <a class="btn-link" href="{{ path('app_admin_groups', {'nom': package.name}) }}">{{ 'usage_rights.create_group_for_package'|trans }}</a>
                    </p>
                {% endif %}
            </section>
        {% endif %}
    {% endblock %}
{% endembed %}
{% endblock %}
