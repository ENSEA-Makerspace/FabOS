{% extends 'site/base_public.html.twig' %}

{# « Mes formations » : à reprendre (la plus avancée, ses étapes et LE verbe de l'étape suivante), en cours, terminées (le badge à un clic), puis le catalogue moins ce qu'on a commencé. Données : `App\Page\MyTrainings`. #}

{% block title %}{{ 'mytr.title'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/pages.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
<main id="main-content" tabindex="-1" class="main-content">
    <section class="machine-detail-section">
        <div class="container pp-home" data-my-trainings>
            <header class="pp-resv-head">
                <h1>{{ 'mytr.title'|trans }}</h1>
                <a class="btn btn-secondary" href="{{ path('app_formations') }}">{{ 'mytr.discover_more'|trans }}</a>
            </header>

            {% if not trainings.resume and trainings.done is empty %}
                <section class="detail-card">
                    <p>{{ 'mytr.empty'|trans }}</p>
                    <a class="btn btn-primary" href="{{ path('app_formations') }}">{{ 'machine.see_trainings'|trans }}</a>
                </section>
            {% else %}
                {% if trainings.resume %}
                    {% set t = trainings.resume %}
                    <section class="detail-card pp-tr-resume" aria-labelledby="pp-tr-resume-title">
                        <p class="md-kicker">{{ 'mytr.resume'|trans }}</p>
                        <div class="pp-tr-resume-in">
                            <div>
                                <h2 id="pp-tr-resume-title" class="pp-next-title"><a href="{{ path('app_formation_detail', {id: t.formation.id}) }}">{{ t.formation.titre }}</a></h2>
                                {% set stepsOut = [] %}
                                {% for step in t.journey.steps %}
                                    {% set stepsOut = stepsOut|merge([{
                                        state: step.done ? 'done' : (step.key == t.journey.next ? 'next' : ''),
                                        label: ('fdet.step_' ~ step.key)|trans,
                                        note: (step.done ? 'mytr.step_done' : (step.key == t.journey.next ? 'mytr.step_next' : (step.blocking ? 'mytr.step_team' : 'mytr.step_later')))|trans,
                                    }]) %}
                                {% endfor %}
                                {% include 'site/_steps.html.twig' with { steps: stepsOut } only %}
                            </div>
                            <div class="pp-tr-resume-side">
                                {% if t.journey.next %}
                                    <a class="btn btn-primary" href="{{ path('app_formation_follow', {id: t.formation.id}) }}">{{ ('fdet.next_' ~ t.journey.next)|trans }}</a>
                                {% endif %}
                                {% if t.journey.badge %}
                                    <p class="pp-tr-badge">{% include 'site/_icon.html.twig' with { name: 'key' } only %} {{ 'mytr.badge'|trans }} <a href="{{ path('app_badge_detail', {id: t.journey.badge.id}) }}">{{ t.journey.badge.nom }}</a></p>
                                {% endif %}
                            </div>
                        </div>
                    </section>
                {% endif %}

                {% for group in [
                    {title: 'mytr.ongoing', rows: trainings.ongoing, done: false},
                    {title: 'mytr.done', rows: trainings.done, done: true},
                ] %}
                    {% if group.rows|length %}
                        {% set rowsOut = [] %}
                        {% for t in group.rows %}
                            {% set rowsOut = rowsOut|merge([{
                                class: 'pp-tr-row',
                                what: {text: t.formation.titre, url: path('app_formation_detail', {id: t.formation.id})},
                                notes: [
                                    group.done ? 'mytr.row_done'|trans : (t.journey.next ? ('fdet.step_' ~ t.journey.next)|trans : '—'),
                                    t.journey.quizTotal ? 'mytr.quiz_validated'|trans({'%done%': t.journey.quizValidated, '%total%': t.journey.quizTotal}) : t.journey.percent ~ ' %',
                                ],
                                verb: group.done and t.journey.badge
                                    ? {label: 'mytr.see_badge'|trans, url: path('app_badge_detail', {id: t.journey.badge.id})}
                                    : {label: t.journey.next ? ('fdet.next_' ~ t.journey.next)|trans : 'mytr.see'|trans, url: path('app_formation_follow', {id: t.formation.id})},
                            }]) %}
                        {% endfor %}
                        {% include 'site/_dated_rows.html.twig' with {
                            title: group.title|trans,
                            class: group.done ? 'is-past' : '',
                            rows: rowsOut,
                        } only %}
                    {% endif %}
                {% endfor %}
            {% endif %}

            {% if trainings.discover|length %}
                <section class="pp-tr-discover">
                    <h2>{{ 'mytr.discover_more'|trans }}</h2>
                    <div class="ml-grid">
                        {% for f in trainings.discover %}
                            {% include 'site/_catalogue_card.html.twig' with {
                                url: path('app_formation_detail', {id: f.id}),
                                title: f.titre,
                                type: f.categorie,
                                meta: f.badge ? 'state.unlocks_badge'|trans ~ ' ' ~ f.badge.nom : '',
                                note: f.duree,
                                icon_slug: f.categorie|default(''),
                                foot: 'state.todo'|trans,
                                foot_tone: 'muted',
                                action: 'mytr.start'|trans,
                            } only %}
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </div>
    </section>
</main>
{% endblock %}
