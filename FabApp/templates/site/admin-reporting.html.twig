{% extends 'base.html.twig' %}

{#
   Rapports : « À retenir » d'abord (au plus trois constats avec UN verbe — `ReportingBrief`), la période
   en tuiles 7 / 30 / 90 jours, le classement qui ouvre les fiches. Dessous, « Rapport détaillé »
   (`<details>`) garde les dates libres, le tableau jour par jour et l'export CSV de la page d'avant.
   ⚠️ Dans `.admin-panel`, `style.css` repeint tout <span> en gris : texte coloré/gras en <b>/<p>/<div>.
#}

{% block title %}{{ 'reporting.title'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals-rapports.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'reporting.overview'|trans,
    list_route: 'app_admin_reporting',
    list_route_params: {workspace: brief.workspace},
    list_query: {jours: brief.days, location: venueContext.location},
    list_tiles_label: 'reporting_brief.period'|trans,
    list_tiles: brief.periods,
    workspace_key: workspaceKey,
    venue_context: venueContext,
} %}
    {% block header_extra %}
        <a class="admin-hero-action" href="{{ path('app_admin_reporting_export', {workspace: brief.workspace, from: brief.from|date('Y-m-d'), to: brief.until|date('Y-m-d'), location: venueContext.location}) }}">{{ 'reporting.export'|trans }}</a>
    {% endblock %}
    {% block content %}
        <div class="pp-rp" data-reporting-brief>
            <p class="pp-rp-switch">
                {% for key, label in {equipment: 'reporting_brief.ws_equipment'|trans, spaces: 'reporting_brief.ws_spaces'|trans} %}
                    {% if key == brief.workspace %}<b>{{ label }}</b>{% else %}<a href="{{ path('app_admin_reporting', {workspace: key, jours: brief.days, location: venueContext.location}) }}">{{ label }}</a>{% endif %}
                {% endfor %}
                <span>{{ 'reporting_brief.range'|trans({'%from%': brief.from|date('d/m/Y'), '%to%': brief.until|date('d/m/Y')}) }}</span>
            </p>

            <section class="pp-rp-head" aria-labelledby="pp-rp-retenir">
                <h2 class="pp-rp-title" id="pp-rp-retenir">{{ 'reporting_brief.heading'|trans }}</h2>
                {% if brief.findings is not empty %}
                    <ul class="pp-rp-finds">
                        {% for f in brief.findings %}
                            <li class="pp-rp-find">
                                <div>{% include 'site/_icon.html.twig' with { name: f.icon } only %}</div>
                                <p class="pp-rp-find-text">{{ f.text }}</p>
                                <p class="pp-rp-find-hint">{{ f.hint }}</p>
                                <a class="pp-rp-find-verb" href="{{ path(f.route, f.params) }}">{{ f.verb }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="pp-rp-calm">{{ 'reporting_brief.calm'|trans }}</p>
                {% endif %}
            </section>

            <div class="workspace-summary">
                <article><strong>{{ brief.summary.total }}</strong><span>{{ 'reporting.reservations'|trans }}{% if brief.summary.trend is not null %} ({{ 'reporting_brief.vs_previous'|trans({'%pct%': (brief.summary.trend > 0 ? '+' : '') ~ brief.summary.trend ~ ' %'}) }}){% endif %}</span></article>
                <article><strong>{{ brief.summary.users }}</strong><span>{{ 'reporting.users'|trans }}</span></article>
                <article><strong>{{ brief.summary.hours|number_format(1, ',', ' ') }} h</strong><span>{{ 'reporting.duration'|trans }}</span></article>
                <article><strong>{{ brief.summary.cancelled }}</strong><span>{{ 'reporting.cancelled'|trans }}</span></article>
            </div>

            <section aria-labelledby="pp-rp-top">
                <h2 class="pp-rp-title" id="pp-rp-top">{{ brief.topLabel }}</h2>
                {% embed 'site/_data_table.html.twig' with {
                    columns: [
                        {label: 'reporting.resource'|trans, class: 'is-grow'},
                        {label: 'reporting.reservations'|trans, numeric: true},
                        {label: 'reporting_brief.col_share'|trans, numeric: true},
                        {label: 'reporting_brief.col_hours'|trans, numeric: true},
                    ],
                    rows: brief.top,
                    empty: 'reporting.empty'|trans,
                } %}
                    {% block rows %}
                        {% for row in brief.top %}
                            <tr>
                                <td><a class="pp-rp-name" href="{{ path(row.route, row.params) }}">{{ row.label }}</a></td>
                                <td class="is-numeric">{{ row.total }}</td>
                                <td class="is-numeric">{{ row.share }} %</td>
                                <td class="is-numeric">{{ row.hours|number_format(1, ',', ' ') }}</td>
                            </tr>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            </section>

            {% if brief.idle is not empty %}
                <p class="pp-rp-idle">
                    <b>{{ 'reporting_brief.idle_label'|trans }}</b> :
                    {% for r in brief.idle %}<a href="{{ path(r.route, {id: r.id}) }}">{{ r.label }}</a>{{ not loop.last ? ' · ' : '' }}{% endfor %}
                </p>
            {% endif %}

            {#- Rapport détaillé : dates libres, activité jour par jour, export CSV (la page d'avant, intacte). -#}
            <details class="pp-rp-detail"{{ detailOpen ? ' open' : '' }}>
                <summary>{{ 'reporting_brief.detail'|trans }}</summary>
                <form class="filters-bar" method="get" action="{{ path('app_admin_reporting', {workspace: workspaceKey}) }}">
                    <input type="hidden" name="location" value="{{ venueContext.location }}">
                    <input type="hidden" name="jours" value="{{ brief.days }}">
                    <div><label for="report-from">{{ 'reporting.from'|trans }}</label><input id="report-from" type="date" name="from" value="{{ from }}"></div>
                    <div><label for="report-to">{{ 'reporting.to'|trans }}</label><input id="report-to" type="date" name="to" value="{{ to }}"></div>
                    <button class="ml-btn" type="submit">{{ 'reporting.apply'|trans }}</button>
                    <a class="ml-reset" href="{{ path('app_admin_reporting', {workspace: workspaceKey, jours: brief.days, location: venueContext.location}) }}">{{ 'common.reset'|trans }}</a>
                    <a class="ml-reset" href="{{ path('app_admin_reporting_export', {workspace: workspaceKey, from: from, to: to, location: venueContext.location}) }}">{{ 'reporting.export'|trans }}</a>
                </form>
                <h3 class="pp-rp-title">{{ 'reporting.daily'|trans }}</h3>
                {% embed 'site/_data_table.html.twig' with {columns: [{label: 'reporting.date'|trans}, {label: 'reporting.reservations'|trans, numeric: true}, {label: 'reporting.minutes'|trans, numeric: true}], rows: report.daily, empty: 'reporting.empty'|trans} %}
                    {% block rows %}{% for row in report.daily %}<tr><td>{{ row.day }}</td><td class="is-numeric">{{ row.total }}</td><td class="is-numeric">{{ row.minutes }}</td></tr>{% endfor %}{% endblock %}
                {% endembed %}
            </details>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
