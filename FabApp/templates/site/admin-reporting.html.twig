{% extends 'base.html.twig' %}
{% block title %}{{ 'reporting.title'|trans }} - FabOS{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s148j22' }}">{% endblock %}
{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'reporting.overview'|trans,
    panel_note: 'reporting.panel_note'|trans({'%count%': report.summary.total}),
    list_route: 'app_admin_reporting',
    list_route_params: {workspace: workspaceKey},
    list_query: {workspace: workspaceKey, from: from, to: to},
    workspace_key: workspaceKey,
    venue_context: venueContext,
    has_filters: true,
} %}
    {% block filters %}
        <form class="filters-bar" method="get" action="{{ path('app_admin_reporting', {workspace: workspaceKey}) }}">
            <input type="hidden" name="location" value="{{ venueContext.location }}">
            <div><label for="report-from">{{ 'reporting.from'|trans }}</label><input id="report-from" type="date" name="from" value="{{ from }}"></div>
            <div><label for="report-to">{{ 'reporting.to'|trans }}</label><input id="report-to" type="date" name="to" value="{{ to }}"></div>
            <button class="ml-btn" type="submit">{{ 'reporting.apply'|trans }}</button>
            <a class="ml-reset" href="{{ path('app_admin_reporting', {workspace: workspaceKey, location: venueContext.location}) }}">{{ 'common.reset'|trans }}</a>
        </form>
    {% endblock %}
    {# ⚠️ It was `panel_header_extra` until S141, and the list header it hung on
       no longer exists — the count moved into the band and took the row with it.
       Export is a control on this page, so it belongs on the band beside where
       the green button would be if reporting created anything. #}
    {% block header_extra %}
        <a class="admin-hero-action" href="{{ path('app_admin_reporting_export', {workspace: workspaceKey, from: from, to: to, location: venueContext.location}) }}">{{ 'reporting.export'|trans }}</a>
    {% endblock %}
    {% block content %}
        <div class="workspace-summary">
            <article><strong>{{ report.summary.total }}</strong><span>{{ 'reporting.reservations'|trans }}</span></article>
            <article><strong>{{ report.summary.users }}</strong><span>{{ 'reporting.users'|trans }}</span></article>
            <article><strong>{{ (report.summary.minutes / 60)|number_format(1, ',', ' ') }} h</strong><span>{{ 'reporting.duration'|trans }}</span></article>
            <article><strong>{{ report.summary.cancelled }}</strong><span>{{ 'reporting.cancelled'|trans }}</span></article>
        </div>
        <h3>{{ 'reporting.daily'|trans }}</h3>
        {% embed 'site/_data_table.html.twig' with {columns: [{label: 'reporting.date'|trans}, {label: 'reporting.reservations'|trans, numeric: true}, {label: 'reporting.minutes'|trans, numeric: true}], rows: report.daily, empty: 'reporting.empty'|trans} %}
            {% block rows %}{% for row in report.daily %}<tr><td>{{ row.day }}</td><td class="is-numeric">{{ row.total }}</td><td class="is-numeric">{{ row.minutes }}</td></tr>{% endfor %}{% endblock %}
        {% endembed %}
        <h3>{{ 'reporting.top_resources'|trans }}</h3>
        {% embed 'site/_data_table.html.twig' with {columns: [{label: 'reporting.resource'|trans}, {label: 'reporting.reservations'|trans, numeric: true}, {label: 'reporting.minutes'|trans, numeric: true}], rows: report.top, empty: 'reporting.empty'|trans} %}
            {% block rows %}{% for row in report.top %}<tr><td>{{ row.label }}</td><td class="is-numeric">{{ row.total }}</td><td class="is-numeric">{{ row.minutes }}</td></tr>{% endfor %}{% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
