{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_institutions.browser_title_edit'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260827-s151' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260827-s151' }}">
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel admin-list-card admin-form-card">
                {% include 'site/_admin_form_head.html.twig' with {
                    title: 'admin_institutions.edit_title'|trans,
                    subtitle: institution.nom,
                    back_href: path('app_admin_institutions'),
                    back_label: 'admin_institutions.back'|trans,
                } only %}
                <div class="admin-edit-panel-header">
                    <h2>{{ 'admin_form.fields_heading'|trans }}</h2>
                </div>

                {% include 'site/_admin_meta_grid.html.twig' with {items: [
                    {label: 'ID', value: '#' ~ institution.id},
                    {label: 'admin_form.created_at'|trans, value: institution.createdAt|lab_date('d/m/Y H:i:s')},
                ]} only %}

                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.nom) }}
                        {{ form_row(form.url) }}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_institutions') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
                {% include 'site/_admin_danger_zone.html.twig' with {
                    action: path('app_admin_institution_delete', {id: institution.id}),
                    token: 'delete_institution_' ~ institution.id,
                    heading: (institution.archived ? 'adm.restore_record' : 'adm.archive_record')|trans,
                    label: (institution.archived ? 'adm.restore_record' : 'adm.archive_record')|trans,
                    description: (institution.archived ? 'adm.restore_record_notice' : 'adm.archive_record_notice')|trans,
                    confirm: (institution.archived ? 'adm.restore_record_confirm' : 'adm.archive_record_confirm')|trans({'%name%': institution.nom}),
                } only %}
            </section>
        </div>
    </main>
{% endblock %}
