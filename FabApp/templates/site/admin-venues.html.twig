{% extends 'base.html.twig' %}

{% block title %}{{ 'venues.title'|trans }} - Admin FabOS{% endblock %}

{#
   ⚠️ **The stylesheet link stays; the local `<style>` does not.**
   Every other admin list opens with a private `.admin-table { min-width: … }`
   and its own `@media (max-width: 900px)` copy. Those predate S85, which put the
   width contract on `.admin-table` itself via `.is-grow`/`.is-tight`, and predate
   `admin.css` growing that media query at ~line 315; a local copy now fights
   both. This page carries none and proves the shell is sufficient.

   ⚠️ `base.html.twig` does **not** emit `admin.css` — every admin page links it
   itself. Dropping the block along with the `<style>` renders the whole list
   unstyled, which is exactly what happened on the first deploy of this page.
#}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260816-s142' }}">
{% endblock %}

{% block body %}
{# ⚠️ This page had NO `list_route`, so it got no filter panel, no search and no
   count line — the one admin list that never received the format it is the
   subject of. Sub-venues are what the page lists, so there is no sub-venue
   dropdown here; the tile row is their state.

   ⚠️ The note is above the embed, not inside it: a Twig comment between two keys
   of an argument hash is a syntax error. #}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'venues.action.new'|trans,
    action_route: 'app_admin_venue_new',
    panel_title: 'venues.panel.all'|trans,
    panel_note: 'venues.panel.count'|trans({'%count%': venueRows|length}),
    list_count: venueRows|length,
    list_route: 'app_admin_venues',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_client_filter: true,
    list_tiles_label: 'admin_list.facet_status'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: venueRows|length, category: 'all', active: true},
        {label: 'venues.status.active'|trans, count: venueRows|filter(row => row.venue.active)|length, category: 'active'},
        {label: 'venues.status.archived'|trans, count: venueRows|filter(row => not row.venue.active)|length, category: 'archived'},
    ],
} %}
    {% block content %}
        <div class="admin-table-wrap">
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: 'venues.column.name'|trans, class: 'is-grow'},
                    {label: 'venues.column.timezone'|trans, class: 'is-tight'},
                    {label: 'venues.column.attachments'|trans, class: 'is-tight', numeric: true},
                    {label: 'venues.column.status'|trans, class: 'is-tight'},
                    {label: 'venues.column.actions'|trans, class: 'is-tight'},
                ],
                rows: venueRows,
                empty: 'venues.empty'|trans,
            } %}
                {% block rows %}
                    {% for row in venueRows %}
                        {% set venue = row.venue %}
                        <tr data-admin-list-filter-row data-admin-list-filter-category="{{ venue.active ? 'active' : 'archived' }}">
                            {# The users list is the shape: an identity mark, the name, the
                               quiet line. A sub-venue has no photo, so the initials disc. #}
                            <td>{% include 'site/_cell_title.html.twig' with {
                                title: venue.name,
                                href: path('app_admin_venue_edit', {id: venue.id}),
                                subtitle: (venue.address ?: 'venues.no_address'|trans) ~ ' · ' ~ venue.slug,
                                media: include('site/_cell_media.html.twig', {initials: venue.name, shape: 'square'}, with_context = false),
                            } only %}</td>
                            <td>{{ venue.timezone }}</td>
                            <td class="is-numeric">{{ row.attachments }}</td>
                            {# 🔴 A bare `<span class="status-badge">` with NO state class got the
                               base rule only — no tint, no tone — so "archivé" and "par défaut"
                               were grey rectangles that read as unstyled rather than as muted. #}
                            <td>{% include 'site/_cell_state.html.twig' with {
                                label: venue.active ? 'venues.status.active'|trans : 'venues.status.archived'|trans,
                                signal: venue.active ? 'go' : 'muted',
                            } only %}{% if venue.default %}{% include 'site/_cell_state.html.twig' with {label: 'venues.status.default'|trans, signal: 'wait'} only %}{% endif %}</td>
                            <td>
                                <div class="admin-actions-cell">
                                    <a class="admin-action" href="{{ path('app_admin_venue_edit', {id: venue.id}) }}">{% include 'site/_icon.html.twig' with {name: 'edit'} only %} {{ 'common.edit'|trans }}</a>

                                    {% if venue.active %}
                                        {#  ⚠️ A refused archive is shown as a disabled control with the reason,
                                            never hidden: "why can't I?" is the question a missing button leaves
                                            unanswered. `VenueGuard` decides; this only renders its verdict. #}
                                        {% if row.refusal %}
                                            <span class="admin-action is-disabled" aria-disabled="true" title="{{ row.refusal|trans }}">{{ 'venues.action.archive'|trans }}</span>
                                        {% else %}
                                            <a class="admin-action" href="{{ path('app_admin_venue_archive', {id: venue.id}) }}">{{ 'venues.action.archive'|trans }}</a>
                                        {% endif %}
                                    {% else %}
                                        <form method="post" action="{{ path('app_admin_venue_restore', {id: venue.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('restore_venue_' ~ venue.id) }}">
                                            <button class="btn-action" type="submit">{{ 'venues.action.restore'|trans }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
