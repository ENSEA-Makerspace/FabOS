<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formations - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    <!-- ========================================
         BANDEAU D'ALERTE
         ======================================== -->
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <!-- ========================================
         HEADER
         ======================================== -->
    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    <img src="{{ asset('images/ENSEA.png') }}" alt="ENSEA" class="ensea-logo-img ensea-logo-svg">
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">Accueil</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">Calendrier</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">Machines</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link active">Formations</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">Leaderboard</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">Admin</a>
                    {% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- ========================================
         CONTENU PRINCIPAL
         ======================================== -->
    <main class="main-content">
        <!-- En-tête -->
        <section class="page-header">
            <div class="container">
                <div class="section-badge">Formations</div>
                <p class="page-description">
                    Obtenez les badges nécessaires pour utiliser les machines du FabLab. 
                    Suivez les formations et validez vos compétences.
                </p>
            </div>
        </section>

        <!-- Progression utilisateur (si connecté) -->
        <section class="user-progress-section">
            <div class="container">
                <div class="user-progress-header">
                    <div class="user-avatar-large">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <div class="user-progress-info">
                        <h3>Votre progression</h3>
                        <p>Vous n'êtes pas connecté. <a href="{{ path('app_login') }}">Se connecter</a> pour voir votre progression.</p>
                    </div>
                </div>
                
                <!-- Badges obtenus (exemple) -->
                <div class="badges-overview">
                    <div class="badges-title">
                        <h4>Badges obtenus</h4>
                        <span class="badge-count">0/12 badges</span>
                    </div>
                    <div class="badges-grid">
                        <div class="badge-card locked">
                            <div class="badge-icon">🔒</div>
                            <div class="badge-name">Niveau 1</div>
                        </div>
                        <div class="badge-card locked">
                            <div class="badge-icon">🔒</div>
                            <div class="badge-name">Niveau 2</div>
                        </div>
                        <div class="badge-card locked">
                            <div class="badge-icon">🔒</div>
                            <div class="badge-name">Niveau 3</div>
                        </div>
                        <div class="badge-card locked">
                            <div class="badge-icon">🏆</div>
                            <div class="badge-name">Impression 3D</div>
                        </div>
                        <div class="badge-card locked">
                            <div class="badge-icon">🏆</div>
                            <div class="badge-name">Découpe Laser</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Filtres -->
        <section class="filters-section">
            <div class="container">
                <div class="filter-bar">
                    <div class="filter-group">
                        <label>Catégorie:</label>
                        <select class="filter-select" id="formation-category-filter">
                            <option value="all">Toutes les catégories</option>
                            <option value="impression-3d">Impression 3D</option>
                            <option value="decoupe">Découpe</option>
                            <option value="electronique">Électronique</option>
                            <option value="usinage">Usinage</option>
                            <option value="textile">Textile</option>
                            <option value="securite">Sécurité</option>
                        </select>
                    </div>
                    
                    <div class="filter-group">
                        <label>Niveau:</label>
                        <select class="filter-select" id="formation-level-filter">
                            <option value="all">Tous les niveaux</option>
                            <option value="1">Niveau 1</option>
                            <option value="2">Niveau 2</option>
                            <option value="3">Niveau 3</option>
                        </select>
                    </div>
                    
                    <div class="filter-group">
                        <label>Statut:</label>
                        <select class="filter-select" id="formation-status-filter">
                            <option value="all">Tous les statuts</option>
                            <option value="obtenu">Obtenu</option>
                            <option value="en-cours">En cours</option>
                            <option value="non-commence">Non commencé</option>
                        </select>
                    </div>
                    
                    <div class="filter-actions">
                        <button class="btn btn-secondary" id="reset-formation-filters">Réinitialiser</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Liste des formations -->
        <section class="formations-list-section">
            <div class="container">
                <div class="results-info">
                    <span id="formations-count">{{ formations|length }} formation{{ formations|length > 1 ? 's' : '' }} disponible{{ formations|length > 1 ? 's' : '' }}</span>
                </div>

                <div class="formations-grid" id="formations-container">
                    {% for formation in formations %}
                        {% set stats = progressionStats[formation.id]|default({'total': 0, 'completed': 0, 'incomplete': 0}) %}
                        {% set categoryLabel = formation.categorie ?: 'Catégorie non renseignée' %}
                        {% set categorySlug = formation.categorie ? formation.categorie|lower|replace({' ': '-'}) : 'non-renseignee' %}
                        {% set levelLabel = formation.niveau ? 'Niveau ' ~ formation.niveau : 'Niveau non renseigné' %}
                        {% set statusSlug = stats.completed > 0 ? 'obtenu' : (stats.incomplete > 0 ? 'en-cours' : 'non-commence') %}
                        {% set visual = formationVisuals[formation.id]|default({'type': 'icon', 'icon': 'generic', 'src': null, 'label': formation.titre}) %}
                        <article class="formation-card" data-formation-id="{{ formation.id }}" data-category="{{ categorySlug }}" data-level="{{ formation.niveau ?: 'unknown' }}" data-status="{{ statusSlug }}">
                            <a href="{{ path('app_formation_detail', {id: formation.id}) }}" class="formation-card-link">
                                <div class="formation-image">
                                    <div class="formation-image-placeholder">
                                        {% include 'site/_formation_visual.html.twig' with {visual: visual} only %}
                                    </div>
                                </div>
                                <div class="formation-body">
                                    <div class="formation-header">
                                        <h3 class="formation-name">#{{ formation.id }} - {{ formation.titre }}</h3>
                                        <div class="formation-meta">
                                            <span class="formation-category-badge">{{ categoryLabel }}</span>
                                            <span class="formation-level-badge">{{ levelLabel }}</span>
                                            {% if formation.badge %}
                                                <span class="formation-category-badge">Badge: {{ formation.badge.nom }}</span>
                                            {% else %}
                                                <span class="formation-category-badge">Aucun badge</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <p class="formation-description">{{ formation.description ?? 'Aucune description.' }}</p>
                                    <div class="formation-details">
                                        <div class="formation-detail"><span>Durée : {{ formation.duree ?: 'Non renseignée' }}</span></div>
                                        <div class="formation-detail"><span>Formateur : {{ formation.formateur ?: 'Non renseigné' }}</span></div>
                                        <div class="formation-detail"><span>Places : {{ formation.placesTotales ?: 'Non renseigné' }}</span></div>
                                        <div class="formation-detail"><span>Progressions : {{ stats.total }}</span></div>
                                    </div>
                                </div>
                                <div class="formation-footer">
                                    <div class="formation-progress">
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: {{ stats.total > 0 ? (stats.completed / stats.total * 100)|round : 0 }}%;"></div>
                                        </div>
                                        <span class="progress-text">{{ stats.completed }}/{{ stats.total }} complétée{{ stats.completed > 1 ? 's' : '' }}</span>
                                    </div>
                                    <span class="btn btn-sm">Voir la formation</span>
                                </div>
                            </a>
                        </article>
                    {% else %}
                        <p>Aucune formation trouvée.</p>
                    {% endfor %}
                </div>
            </div>
        </section>

    </main>

    <!-- ========================================
         FOOTER
         ======================================== -->
    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') }}"></script>
    <script>
        // Filtrer les formations
        document.addEventListener('DOMContentLoaded', function() {
            const categoryFilter = document.getElementById('formation-category-filter');
            const levelFilter = document.getElementById('formation-level-filter');
            const statusFilter = document.getElementById('formation-status-filter');
            const resetBtn = document.getElementById('reset-formation-filters');
            const formationsContainer = document.getElementById('formations-container');
            const formationsCount = document.getElementById('formations-count');
            
            function filterFormations() {
                const selectedCategory = categoryFilter.value;
                const selectedLevel = levelFilter.value;
                const selectedStatus = statusFilter.value;
                
                const formationCards = formationsContainer.querySelectorAll('.formation-card');
                let visibleCount = 0;
                
                formationCards.forEach(card => {
                    const cardCategory = card.dataset.category;
                    const cardLevel = card.dataset.level;
                    const cardStatus = card.dataset.status;
                    
                    const categoryMatch = selectedCategory === 'all' || cardCategory === selectedCategory;
                    const levelMatch = selectedLevel === 'all' || cardLevel === selectedLevel;
                    const statusMatch = selectedStatus === 'all' || cardStatus === selectedStatus;
                    
                    if (categoryMatch && levelMatch && statusMatch) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });
                
                // Mettre à jour le compteur
                formationsCount.textContent = `${visibleCount} formation${visibleCount > 1 ? 's' : ''} ${visibleCount > 1 ? 'trouvées' : 'trouvée'}`;
            }
            
            // Écouter les changements
            if (categoryFilter) categoryFilter.addEventListener('change', filterFormations);
            if (levelFilter) levelFilter.addEventListener('change', filterFormations);
            if (statusFilter) statusFilter.addEventListener('change', filterFormations);
            
            // Réinitialiser les filtres
            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    categoryFilter.value = 'all';
                    levelFilter.value = 'all';
                    statusFilter.value = 'all';
                    filterFormations();
                });
            }
            
            // Rendre toutes les cartes de formation cliquables
            document.querySelectorAll('.formation-card').forEach(card => {
                if (!card.querySelector('.formation-card-link')) {
                    const link = document.createElement('a');
                    const cardId = Array.from(card.parentNode.children).indexOf(card) + 1;
                    link.href = `formation-detail.html?id=${cardId}`;
                    link.className = 'formation-card-link';
                    
                    // Déplacer tout le contenu dans le lien
                    while (card.firstChild) {
                        link.appendChild(card.firstChild);
                    }
                    
                    // Remplacer le bouton par un span
                    const btnLink = link.querySelector('a.btn.btn-sm');
                    if (btnLink) {
                        const span = document.createElement('span');
                        span.className = btnLink.className;
                        span.textContent = btnLink.textContent;
                        btnLink.parentNode.replaceChild(span, btnLink);
                    }
                    
                    card.appendChild(link);
                }
            });
        });
    </script>
</body>
</html>
