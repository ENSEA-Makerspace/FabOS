{% extends 'base.html.twig' %}

{# GRANTS V2, BESIDE WHAT IS ACTUALLY IN FORCE (S133b).

   ⚠️ **Nothing on this page decides anything.** The live column is the answer
   `UsageRightsService` gives today, from `USAGE_PACKAGE_FEATURE`; the shadow
   column is what grants v2 would answer, from `USAGE_GRANT`. S134 is where the
   second one starts deciding, one audited chokepoint at a time. The roadmap's
   requirement for this session is that the shadow be *visible and explicable*
   before then, and the explaining is the classification: a wall of "differs"
   would be no more actionable than no page at all.

   ⚠️ **The expected state of a healthy installation today is a page full of
   "enforcement off"**, not a page full of agreement. Enforcement is off, so the
   live model says yes to everything; that is not a fault and is not coloured as
   one. The rows that matter are `shadow_would_deny`, and they sort to the top. #}

{% block title %}{{ 'usage_rights.shadow_browser_title'|trans }}{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260816-s143b' }}">{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    page_title: 'usage_rights.shadow_title'|trans,
    panel_title: 'usage_rights.shadow_title'|trans,
    list_count: shown,
    list_total: totalMembers,
    list_route: 'app_admin_usage_rights_shadow',
} %}
    {% block content %}
        {% if not ready %}
            <p class="migration-note">{{ 'usage_rights.shadow_not_ready'|trans }}</p>
        {% endif %}

        {# The one number that says whether S134 can be attempted at all: how many
           member×capability pairs would flip to a refusal. Everything else on this
           strip is context for reading it. #}
        <div class="mail-stats">
            <div class="mail-stat"><div class="mail-stat__value">{{ summary.shadow_would_deny|default(0) }}</div><div class="mail-stat__label">{{ 'usage_rights.shadow_status_deny'|trans }}</div></div>
            <div class="mail-stat"><div class="mail-stat__value">{{ summary.shadow_would_allow|default(0) }}</div><div class="mail-stat__label">{{ 'usage_rights.shadow_status_allow'|trans }}</div></div>
            <div class="mail-stat"><div class="mail-stat__value">{{ summary.agree|default(0) }}</div><div class="mail-stat__label">{{ 'usage_rights.shadow_status_agree'|trans }}</div></div>
            <div class="mail-stat"><div class="mail-stat__value">{{ summary.enforcement_off|default(0) }}</div><div class="mail-stat__label">{{ 'usage_rights.shadow_status_off'|trans }}</div></div>
            <div class="mail-stat"><div class="mail-stat__value">{{ summary.admin_bypass|default(0) }}</div><div class="mail-stat__label">{{ 'usage_rights.shadow_status_admin'|trans }}</div></div>
        </div>
        <p class="settings-hint">{{ 'usage_rights.shadow_scope_note'|trans({'%shown%': shown, '%total%': totalMembers}) }}</p>

        {% if not enforced %}
            <p class="notice">{{ 'usage_rights.shadow_enforcement_off_note'|trans }}</p>
        {% endif %}

        <details class="settings-danger settings-danger--neutral">
            <summary>{{ 'usage_rights.shadow_groups'|trans }}</summary>
            <div>
                <p class="settings-hint">{{ 'usage_rights.shadow_groups_help'|trans }}</p>
                <ul class="group-list">
                    {% for group in groups %}
                        <li>
                            <strong>{{ group.label }}</strong>
                            <code>{{ group.key }}</code>
                            {% if group.builtin %}{% include 'site/_cell_state.html.twig' with {label: 'usage_rights.shadow_group_builtin'|trans, signal: 'muted'} only %}{% endif %}
                            {% if group.virtual %}
                                {# The distinction that keeps provisioning honest: "every
                                   active account" is not a list anyone maintains. #}
                                {% include 'site/_cell_state.html.twig' with {label: 'usage_rights.shadow_group_virtual'|trans, signal: 'caution'} only %}
                            {% else %}
                                <span class="settings-hint">{{ 'usage_rights.shadow_group_members'|trans({'%count%': group.members}) }}</span>
                            {% endif %}
                            {% if group.description %}<p class="settings-hint">{{ group.description }}</p>{% endif %}
                        </li>
                    {% else %}
                        <li class="settings-hint">{{ 'usage_rights.shadow_not_ready'|trans }}</li>
                    {% endfor %}
                </ul>
            </div>
        </details>

        {% embed 'site/_data_table.html.twig' with {
            columns: [
                {label: 'adm.col_name'|trans, class: 'is-grow'},
                {label: 'usage_rights.shadow_audiences'|trans, class: 'is-tight'},
                {label: 'usage_rights.shadow_comparison'|trans, class: 'is-grow'},
            ],
            rows: rows,
            empty: 'usage_rights.shadow_empty'|trans,
        } %}
            {% block rows %}
                {% for row in rows %}
                    <tr>
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: row.user.displayName,
                            subtitle: row.user.email,
                            href: path('app_admin_user_detail', {id: row.user.id}),
                            media: include('site/_cell_media.html.twig', {initials: row.user.displayName, shape: 'circle'}, with_context = false),
                        } only %}</td>
                        <td>{% for key in row.audiences %}<code>{{ key }}</code> {% endfor %}</td>
                        <td>
                            <dl class="shadow-grid">
                                {% for verdict in row.verdicts %}
                                    <dt>{{ verdict.capability.labelKey|trans }}</dt>
                                    <dd>
                                        {% include 'site/_cell_state.html.twig' with {
                                            label: ('usage_rights.shadow_status_' ~ (
                                                verdict.status == 'shadow_would_deny' ? 'deny'
                                                : verdict.status == 'shadow_would_allow' ? 'allow'
                                                : verdict.status == 'enforcement_off' ? 'off'
                                                : verdict.status == 'admin_bypass' ? 'admin' : 'agree'
                                            ))|trans,
                                            signal: verdict.status == 'shadow_would_deny' ? 'stop'
                                                : (verdict.status == 'shadow_would_allow' ? 'caution'
                                                : (verdict.status == 'agree' ? 'go' : 'muted')),
                                        } only %}
                                        {# The paths ARE the explanation. "Denied" and "denied
                                           because the only package that would have covered it
                                           is scoped to the other location" are different
                                           answers, and only one is actionable. #}
                                        {% if verdict.paths is not empty %}
                                            <span class="settings-hint">{% for p in verdict.paths %}{{ p.package }}{% if p.venue %} · {{ p.venue }}{% endif %}{% if p.source == 'group' %} ({{ p.sourceLabel }}){% endif %}{{ not loop.last ? ' / ' }}{% endfor %}</span>
                                        {% else %}
                                            <span class="settings-hint">{{ 'usage_rights.shadow_no_path'|trans }}</span>
                                        {% endif %}
                                    </dd>
                                {% endfor %}
                            </dl>
                        </td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
