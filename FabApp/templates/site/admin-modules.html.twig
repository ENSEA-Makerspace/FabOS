<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modules - Admin FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-fusion-home-rating' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        .admin-header { background: linear-gradient(135deg, #9E1B56 0%, #7a1542 100%); color: white; padding: var(--spacing-xl) 0; margin-bottom: var(--spacing-xl); }
        .admin-header-content, .admin-main-content { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--spacing-lg); }
        .admin-main-content { display: grid; grid-template-columns: 280px 1fr; gap: var(--spacing-xl); margin-bottom: var(--spacing-xl); }
        .admin-sidebar, .admin-panel { background: white; border-radius: var(--border-radius); padding: var(--spacing-lg); box-shadow: var(--shadow); border: 1px solid var(--border-color); }
        .admin-sidebar { height: fit-content; }
        .admin-sidebar h3, .admin-panel h2 { margin-bottom: var(--spacing-lg); }
        .admin-nav { display: flex; flex-direction: column; gap: var(--spacing-xs); }
        .admin-nav-link { display: flex; align-items: center; gap: var(--spacing-sm); padding: var(--spacing-sm) var(--spacing-md); color: var(--color-text); text-decoration: none; border-radius: var(--border-radius-sm); transition: all var(--transition); }
        .admin-nav-link:hover, .admin-nav-link.active { background: var(--color-primary); color: white; }
        .admin-nav-link svg { width: 20px; height: 20px; }
        .modules-form { display: flex; flex-direction: column; gap: 8px; }
        .module-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 16px; border: 1px solid var(--border-color); border-radius: 10px; }
        .module-row__name { font-weight: 700; }
        .module-row__desc { color: var(--color-text-light); font-size: 13px; margin-top: 2px; }
        .switch { position: relative; display: inline-block; width: 48px; height: 26px; flex: none; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .switch__slider { position: absolute; inset: 0; background: #cbd5e1; border-radius: 999px; transition: .2s; }
        .switch__slider::before { content: ""; position: absolute; height: 20px; width: 20px; left: 3px; top: 3px; background: white; border-radius: 50%; transition: .2s; }
        .switch input:checked + .switch__slider { background: #16a34a; }
        .switch input:checked + .switch__slider::before { transform: translateX(22px); }
        .modules-actions { margin-top: 16px; }
        .btn-primary { background: var(--color-primary); color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; }
        .flash { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; }
        .flash.success { background: #dcfce7; color: #166534; }
        .flash.error { background: #fee2e2; color: #991b1b; }
    </style>
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <header class="admin-header"><div class="admin-header-content"><h1>Administration &mdash; Modules</h1></div></header>
    <div class="admin-main-content">
        {% include 'site/_admin_sidebar.html.twig' %}
        <main class="admin-panel">
            <h2>Modules du site</h2>
            {% for message in app.flashes('success') %}<div class="flash success">{{ message }}</div>{% endfor %}
            {% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}
            <p style="color: var(--color-text-light); margin-bottom: 16px;">Active ou désactive les grandes fonctionnalités publiques du site. Une fois désactivé, le module disparaît du menu et ses pages renvoient une erreur 404.</p>
            {# The key stays `machines` — renaming a SITE_MODULE row would need a migration —
               but the word an operator reads is "équipement": it covers a laser cutter, a
               sewing machine and a microscope without assuming a workshop. #}
            {% set labels = {machines: 'Équipement (réservation)', leaderboard: 'Leaderboard', projects: 'Projets (galerie)', badges: 'Badges', formations: 'Formations', lab_pages: 'Pages du Lab', places: 'Espaces (réservation)', events: 'Événements', staff: 'Équipe (annuaire)', trainers: 'Formateurs (annuaire)', materials: 'Matériaux (catalogue)', loans: 'Prêts (emprunts)', maintenance: 'Maintenance'} %}
            <form method="post" action="{{ path('app_admin_modules') }}" class="modules-form">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_modules') }}">
                {% for key, enabled in modules %}
                    <div class="module-row">
                        <div>
                            <div class="module-row__name">{{ labels[key]|default(key) }}</div>
                            <div class="module-row__desc">{{ enabled ? 'Activé' : 'Désactivé' }}</div>
                        </div>
                        <label class="switch">
                            <input type="checkbox" name="modules[]" value="{{ key }}" {{ enabled ? 'checked' : '' }}>
                            <span class="switch__slider"></span>
                        </label>
                    </div>
                {% endfor %}
                <div class="modules-actions"><button type="submit" class="btn-primary">Enregistrer</button></div>
            </form>
        </main>
    </div>
</body>
</html>
