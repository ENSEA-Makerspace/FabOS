<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta http-equiv="refresh" content="60">
    <title>{{ venue_label() }} — {{ 'kiosk_home.title'|trans }}</title>
    {% include 'site/_favicon.html.twig' %}
    <link rel="stylesheet" href="{{ asset('css/kiosk.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals-kiosque-accueil.css') ~ '?v=' ~ css_version }}">
</head>
<body class="pp-kq-body" data-kiosk="home">
    <main class="pp-kq">
        <header class="pp-kq-head">
            <div>
                <h1 class="pp-kq-venue">{{ venue_label() }}</h1>
                <p class="pp-kq-status pp-kq-status--{{ home.status.signal }}">{{ home.status.label }}</p>
                {% if home.status.detail %}<p class="pp-kq-reason">{{ home.status.detail }}</p>{% endif %}
            </div>
            <p class="pp-kq-clock">{{ 'now'|lab_date('H:i') }}</p>
        </header>

        <section class="pp-kq-welcome">
            <h2>{{ 'kiosk_home.welcome'|trans }}</h2>
            <p>{{ 'kiosk_home.welcome_hint'|trans }}</p>
        </section>

        <nav class="pp-kq-tiles" aria-label="{{ 'kiosk_home.tiles_label'|trans }}">
            {% if home.events is not null %}
                <a class="pp-kq-tile" href="{{ path('app_kiosk_events') }}">
                    {% include 'site/_icon.html.twig' with { name: 'calendar' } only %}
                    <b>{{ 'kiosk_home.tile_events'|trans }}</b>
                    <p>{% if home.events.count > 0 %}{{ 'kiosk_home.events_upcoming'|trans({'%n%': home.events.count}) }}{% if home.events.next %} · {{ home.events.next }}{% endif %}{% else %}{{ 'kiosk_home.events_none'|trans }}{% endif %}</p>
                </a>
            {% endif %}
            {% if home.machines is not null and home.machines.firstId %}
                <a class="pp-kq-tile" href="{{ path('app_kiosk_machine', {id: home.machines.firstId}) }}">
                    {% include 'site/_icon.html.twig' with { name: 'tool' } only %}
                    <b>{{ 'kiosk_home.tile_machines'|trans }}</b>
                    <p>{{ (home.machines.count > 1 ? 'kiosk_home.machines_many' : 'kiosk_home.machines_one')|trans({'%n%': home.machines.count}) }}{% if home.machines.down > 0 %} · {{ 'kiosk_home.machines_down'|trans({'%n%': home.machines.down}) }}{% endif %}</p>
                </a>
            {% endif %}
            <a class="pp-kq-tile" href="#horaires">
                {% include 'site/_icon.html.twig' with { name: 'history' } only %}
                <b>{{ 'kiosk_home.tile_hours'|trans }}</b>
                <p>{{ 'kiosk_home.tile_hours_hint'|trans }}</p>
            </a>
        </nav>

        <section class="pp-kq-hours" id="horaires" aria-label="{{ 'kiosk_home.week_title'|trans }}">
            <h2>{{ 'kiosk_home.week_title'|trans }}</h2>
            <ul>
                {% for d in home.week %}
                    <li class="{{ d.today ? 'is-today' : '' }}"><b>{{ d.day }}</b><strong>{{ d.hours ?? 'kiosk.machine_closed'|trans }}</strong></li>
                {% endfor %}
            </ul>
            <a class="pp-kq-close" href="#">{{ 'kiosk_home.close'|trans }}</a>
        </section>

        <aside class="pp-kq-door" aria-label="{{ 'kiosk_home.door_label'|trans }}">
            {% include 'site/_icon.html.twig' with { name: 'lock' } only %}
            <div>
                <b>{{ 'kiosk_home.door_title'|trans }}</b>
                <p>{{ 'kiosk_home.door_hint'|trans }}</p>
            </div>
        </aside>
    </main>
</body>
</html>
