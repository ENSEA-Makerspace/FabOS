<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historique - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    {% include 'site/_logo.html.twig' %}
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">{{ 'nav.home'|trans }}</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">{{ 'nav.calendar'|trans }}</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link active">{{ 'nav.machines'|trans }}</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">{{ 'nav.trainings'|trans }}</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">{{ 'nav.leaderboard'|trans }}</a><a href="{{ path('app_leaderboard_creations') }}" class="navbar-link">{{ 'nav.projects'|trans }}</a><a href="{{ path('app_badges') }}" class="navbar-link">{{ 'nav.badges'|trans }}</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">{{ 'nav.admin'|trans }}</a>
                    {% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <main class="main-content">
        <section class="machine-detail-section">
            <div class="container">
                <nav class="breadcrumb">
                    <a href="{{ path('app_home') }}">Accueil</a>
                    <span class="breadcrumb-separator">/</span>
                    <a href="{{ path('app_machines') }}">Machines</a>
                    <span class="breadcrumb-separator">/</span>
                    <a href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ machine.nom }}</a>
                    <span class="breadcrumb-separator">/</span>
                    <span class="breadcrumb-current">Historique</span>
                </nav>

                <div class="machine-detail-header">
                    <div class="machine-info-bar">
                        <div class="machine-avatar-large">
                            <svg viewBox="0 0 100 100" class="machine-icon-large">
                                <rect x="20" y="30" width="60" height="40" fill="#9E1B56" rx="5"/>
                                <rect x="25" y="20" width="50" height="10" fill="#666" rx="2"/>
                                <circle cx="50" cy="75" r="8" fill="#444"/>
                            </svg>
                        </div>
                        <div class="machine-info-text">
                            <h1 class="machine-detail-title">Historique d'utilisation</h1>
                            <p class="machine-detail-subtitle">#{{ machine.id }} - {{ machine.nom }}</p>
                            <p class="machine-detail-subtitle">Token {{ machine.machineToken }} - {{ machine.localisation ?: 'Localisation non renseignée' }} - {{ machine.statut }}</p>
                        </div>
                    </div>
                    <div class="machine-detail-actions">
                        <a href="{{ path('app_machine_detail', {id: machine.id}) }}" class="btn btn-secondary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 12H5M12 19l-7-7 7-7"/>
                            </svg>
                            Retour à la machine
                        </a>
                    </div>
                </div>

                <div class="machine-stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <path d="M7 8h10M7 12h10M7 16h6"/>
                                <rect x="3" y="4" width="18" height="16" rx="2"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ rfidLogs|length }}</span>
                            <span class="stat-label">Passages RFID</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <polyline points="12,6 12,12 16,14"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ usageLogs|length }}</span>
                            <span class="stat-label">Logs d'utilisation</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ reservations|length }}</span>
                            <span class="stat-label">Réservations</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <path d="M9 12l2 2 4-4"/>
                                <circle cx="12" cy="12" r="10"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ machine.statut }}</span>
                            <span class="stat-label">Statut machine</span>
                        </div>
                    </div>
                </div>

                <div class="history-filters">
                    <h3 class="section-subtitle">Informations machine</h3>
                    <div class="filter-bar">
                        <div class="filter-group"><label>ID</label><strong>{{ machine.id }}</strong></div>
                        <div class="filter-group"><label>Nom</label><strong>{{ machine.nom }}</strong></div>
                        <div class="filter-group"><label>Token</label><strong>{{ machine.machineToken }}</strong></div>
                        <div class="filter-group"><label>Localisation</label><strong>{{ machine.localisation ?: 'Non renseignée' }}</strong></div>
                    </div>
                </div>

                <h3 class="section-subtitle">Passages RFID</h3>
                <div class="history-list">
                    <div class="history-list-header">
                        <span class="history-col date">Date</span>
                        <span class="history-col time">Badge UID</span>
                        <span class="history-col user">Utilisateur</span>
                        <span class="history-col duration">Autorisé</span>
                        <span class="history-col status">Statut</span>
                        <span class="history-col actions">Message</span>
                    </div>
                    {% if rfidLogs is empty %}
                        <div class="history-item"><span class="history-col user">Aucun passage RFID enregistré.</span></div>
                    {% else %}
                        {% for log in rfidLogs %}
                            <div class="history-item">
                                <span class="history-col date">{{ log.createdAt|date('d/m/Y H:i') }}</span>
                                <span class="history-col time">{{ log.badgeUid }}</span>
                                <span class="history-col user">{{ log.utilisateur ? log.utilisateur.displayName : 'Utilisateur inconnu' }}</span>
                                <span class="history-col duration">{{ log.authorized ? 'Oui' : 'Non' }}</span>
                                <span class="history-col status"><span class="status-badge {{ log.authorized ? 'completed' : 'cancelled' }}">{{ log.status }}</span></span>
                                <span class="history-col actions">{{ log.reason ?: log.message ?: log.color ?: '-' }}</span>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>

                <h3 class="section-subtitle">Logs d'utilisation</h3>
                <div class="history-list">
                    <div class="history-list-header">
                        <span class="history-col date">Début</span>
                        <span class="history-col time">Fin</span>
                        <span class="history-col user">Utilisateur</span>
                        <span class="history-col duration">Durée</span>
                        <span class="history-col status">Source</span>
                        <span class="history-col actions">Créé le</span>
                    </div>
                    {% if usageLogs is empty %}
                        <div class="history-item"><span class="history-col user">Aucun log d’utilisation enregistré.</span></div>
                    {% else %}
                        {% for usageLog in usageLogs %}
                            <div class="history-item">
                                <span class="history-col date">{{ usageLog.dateDebut|date('d/m/Y H:i') }}</span>
                                <span class="history-col time">{{ usageLog.dateFin ? usageLog.dateFin|date('d/m/Y H:i') : '-' }}</span>
                                <span class="history-col user">{{ usageLog.utilisateur ? usageLog.utilisateur.displayName : 'Utilisateur inconnu' }}</span>
                                <span class="history-col duration">{{ usageLog.duree is not null ? usageLog.duree ~ ' min' : '-' }}</span>
                                <span class="history-col status"><span class="status-badge completed">{{ usageLog.source ?: '-' }}</span></span>
                                <span class="history-col actions">{{ usageLog.createdAt|date('d/m/Y H:i') }}</span>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>

                <h3 class="section-subtitle">Réservations</h3>
                <div class="history-list">
                    <div class="history-list-header">
                        <span class="history-col date">Début</span>
                        <span class="history-col time">Fin</span>
                        <span class="history-col user">Utilisateur</span>
                        <span class="history-col duration">Motif</span>
                        <span class="history-col status">Statut</span>
                        <span class="history-col actions">Créée le</span>
                    </div>
                    {% if reservations is empty %}
                        <div class="history-item"><span class="history-col user">Aucune réservation enregistrée.</span></div>
                    {% else %}
                        {% for reservation in reservations %}
                            <div class="history-item">
                                <span class="history-col date">{{ reservation.dateDebut|date('d/m/Y H:i') }}</span>
                                <span class="history-col time">{{ reservation.dateFin|date('d/m/Y H:i') }}</span>
                                <span class="history-col user">{{ reservation.utilisateur ? reservation.utilisateur.displayName : 'Utilisateur inconnu' }}</span>
                                <span class="history-col duration">{{ reservation.motif ?: '-' }}</span>
                                <span class="history-col status"><span class="status-badge {{ reservation.dateFin < date() ? 'completed' : 'pending' }}">{{ reservation.dateFin < date() ? 'Terminée' : 'À venir' }}</span></span>
                                <span class="history-col actions">{{ reservation.created|date('d/m/Y H:i') }}</span>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') ~ '?v=20260709-header-scope' }}"></script>
    <style>
        /* ===================================================================
           Machine Historique - Styles Spécifiques
           Conforme à la charte graphique FabOS
           =================================================================== */

        /* Breadcrumb */
        .breadcrumb {
            display: flex;
            align-items: center;
            gap: var(--spacing-xs);
            margin-bottom: var(--spacing-xl);
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
            flex-wrap: wrap;
        }

        .breadcrumb a {
            color: var(--color-primary);
            text-decoration: none;
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        .breadcrumb-separator {
            color: var(--color-text-light);
        }

        .breadcrumb-current {
            color: var(--color-text-light);
            font-weight: 500;
        }

        /* Machine Detail Header */
        .machine-detail-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
        }

        .machine-info-bar {
            display: flex;
            align-items: center;
            gap: var(--spacing-lg);
            flex: 1;
            min-width: 300px;
        }

        .machine-avatar-large {
            width: 80px;
            height: 80px;
            flex-shrink: 0;
            background: var(--color-bg-light);
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .machine-avatar-large svg {
            width: 100%;
            height: 100%;
        }

        .machine-info-text {
            display: flex;
            flex-direction: column;
        }

        .machine-detail-title {
            font-size: var(--font-size-2xl);
            color: var(--color-text);
            margin: 0;
            font-weight: 700;
            line-height: 1.2;
        }

        .machine-detail-subtitle {
            font-size: var(--font-size-md);
            color: var(--color-text-light);
            margin: var(--spacing-xs) 0 0 0;
        }

        /* Stats Grid */
        .machine-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-2xl);
        }

        .stat-card {
            display: flex;
            align-items: center;
            gap: var(--spacing-md);
            background: var(--color-bg-light);
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            border: 1px solid var(--border-color);
            transition: all var(--transition);
        }

        .stat-card:hover {
            box-shadow: var(--shadow);
            transform: translateY(-2px);
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background: var(--color-bg);
            border-radius: var(--border-radius-sm);
        }

        .stat-icon svg {
            width: 28px;
            height: 28px;
        }

        .stat-info {
            display: flex;
            flex-direction: column;
        }

        .stat-value {
            font-size: var(--font-size-2xl);
            font-weight: 700;
            color: var(--color-text);
            line-height: 1;
        }

        .stat-label {
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
            margin-top: var(--spacing-xs);
        }

        /* Filtres */
        .history-filters {
            margin-bottom: var(--spacing-xl);
        }

        .section-subtitle {
            font-size: var(--font-size-lg);
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: var(--spacing-md);
        }

        .filter-bar {
            display: flex;
            flex-wrap: wrap;
            gap: var(--spacing-md);
            align-items: center;
            background: var(--color-bg-light);
            padding: var(--spacing-md);
            border-radius: var(--border-radius);
            border: 1px solid var(--border-color);
        }

        .filter-group {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }

        .filter-group label {
            font-size: var(--font-size-sm);
            font-weight: 600;
            color: var(--color-text);
        }

        .filter-select {
            padding: var(--spacing-xs) var(--spacing-sm);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            background: var(--color-bg);
            font-size: var(--font-size-sm);
            color: var(--color-text);
            cursor: pointer;
            transition: border-color var(--transition), box-shadow var(--transition);
        }

        .filter-select:focus {
            outline: none;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 2px rgba(158, 27, 86, 0.1);
        }

        .filter-select:hover {
            border-color: var(--border-color-primary);
        }

        /* Liste de l'historique */
        .history-list {
            background: var(--color-bg);
            border-radius: var(--border-radius);
            border: 1px solid var(--border-color);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

        .history-list-header {
            display: grid;
            grid-template-columns: 100px 120px 150px 100px 100px 60px;
            background: var(--color-bg-light);
            padding: var(--spacing-md);
            font-size: var(--font-size-sm);
            font-weight: 600;
            color: var(--color-text-light);
            border-bottom: 1px solid var(--border-color);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .history-item {
            display: grid;
            grid-template-columns: 100px 120px 150px 100px 100px 60px;
            padding: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
            align-items: center;
            transition: background var(--transition);
        }

        .history-item:last-child {
            border-bottom: none;
        }

        .history-item:hover {
            background: rgba(158, 27, 86, 0.03);
        }

        .history-col {
            font-size: var(--font-size-sm);
            color: var(--color-text);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            padding: var(--spacing-xs);
        }

        .history-col.date {
            font-weight: 600;
            color: var(--color-primary);
        }

        .history-col.time {
            color: var(--color-text-light);
        }

        /* Status Badge */
        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: var(--border-radius-sm);
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-badge.completed {
            background: rgba(76, 175, 80, 0.15);
            color: #4CAF50;
            border: 1px solid rgba(76, 175, 80, 0.3);
        }

        .status-badge.cancelled {
            background: rgba(244, 67, 54, 0.15);
            color: #F44336;
            border: 1px solid rgba(244, 67, 54, 0.3);
        }

        .status-badge.processing {
            background: rgba(255, 193, 7, 0.15);
            color: #FFC107;
            border: 1px solid rgba(255, 193, 7, 0.3);
        }

        /* Actions */
        .action-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: var(--border-radius);
            color: var(--color-text-light);
            text-decoration: none;
            transition: all var(--transition);
        }

        .action-link:hover {
            background: rgba(158, 27, 86, 0.1);
            color: var(--color-primary);
        }

        .action-link svg {
            width: 18px;
            height: 18px;
        }

        /* Machine Detail Actions */
        .machine-detail-actions {
            display: flex;
            gap: var(--spacing-sm);
            align-items: center;
        }

        /* Pagination */
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: var(--spacing-xs);
            margin-top: var(--spacing-xl);
            flex-wrap: wrap;
        }

        .pagination-link {
            min-width: 36px;
            height: 36px;
            padding: 0 var(--spacing-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
            text-decoration: none;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            transition: all var(--transition);
        }

        .pagination-link:hover {
            background: var(--color-bg-light);
            border-color: var(--color-primary);
            color: var(--color-primary);
        }

        .pagination-link.active {
            background: var(--color-primary);
            border-color: var(--color-primary);
            color: var(--color-text-inverse);
        }

        .pagination-dots {
            color: var(--color-text-light);
            padding: 0 var(--spacing-xs);
        }

        /* ===================================================================
           RESPONSIVE DESIGN
           =================================================================== */

        @media (max-width: 1024px) {
            .machine-detail-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .machine-info-bar {
                flex-direction: column;
                gap: var(--spacing-md);
                min-width: auto;
            }

            .history-list-header,
            .history-item {
                grid-template-columns: 80px 100px 120px 80px 80px 40px;
                font-size: var(--font-size-sm);
            }
        }

        @media (max-width: 768px) {
            .machine-stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .stat-card {
                padding: var(--spacing-md);
            }

            .stat-icon {
                width: 40px;
                height: 40px;
            }

            .stat-icon svg {
                width: 22px;
                height: 22px;
            }

            .stat-value {
                font-size: var(--font-size-lg);
            }

            .filter-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .filter-group {
                flex-direction: column;
                align-items: flex-start;
                width: 100%;
            }

            .filter-select {
                width: 100%;
            }

            .history-list-header,
            .history-item {
                grid-template-columns: 60px 80px 100px 70px 70px 40px;
                font-size: var(--font-size-xs);
            }

            .history-col {
                padding: var(--spacing-xs);
            }
        }

        @media (max-width: 480px) {
            .breadcrumb {
                font-size: var(--font-size-xs);
            }

            .machine-detail-title {
                font-size: var(--font-size-xl);
            }

            .machine-avatar-large {
                width: 60px;
                height: 60px;
            }

            .history-list-header,
            .history-item {
                grid-template-columns: 50px 60px 80px 50px 50px 30px;
                gap: var(--spacing-xs);
            }

            .action-link {
                width: 24px;
                height: 24px;
            }

            .action-link svg {
                width: 14px;
                height: 14px;
            }
        }
    </style>
</body>
</html>
