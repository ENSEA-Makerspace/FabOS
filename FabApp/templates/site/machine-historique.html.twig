{% extends 'site/base_public.html.twig' %}

{% block title %}{{ 'machine.tab_history'|trans }} - FabOS{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('css/machine-historique.css') ~ '?v=20260822-s149a' }}">
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260827-s151' }}">
{% endblock %}

{% block body %}

    <main id="main-content" tabindex="-1" class="main-content">
        <section class="machine-detail-section">
            <div class="container">
                {% include 'site/_breadcrumb.html.twig' with {trail: [
                    {label: 'nav.home'|trans, url: path('app_home')},
                    {label: 'nav.machines'|trans, url: path('app_machines')},
                    {label: machine.nom, url: path('app_machine_detail', {id: machine.id})},
                    {label: 'machine.tab_history'|trans},
                ]} only %}

                <div class="machine-detail-header">
                    <div class="machine-info-bar">
                        <div class="machine-avatar-large">
                            <svg viewBox="0 0 100 100" class="machine-icon-large">
                                <rect x="20" y="30" width="60" height="40" fill="#9E1B56" rx="5"/>
                                <rect x="25" y="20" width="50" height="10" fill="#666" rx="2"/>
                                <circle cx="50" cy="75" r="8" fill="#444"/>
                            </svg>
                        </div>
                        <div class="machine-info-text">
                            <h1 class="machine-detail-title">{{ 'mhist.title'|trans }}</h1>
                            <p class="machine-detail-subtitle">#{{ machine.id }} - {{ machine.nom }}</p>
                            <p class="machine-detail-subtitle">{{ machine.localisation ?: 'fallback.no_location'|trans }} - {{ machine.statut }}</p>
                        </div>
                    </div>
                    <div class="machine-detail-actions">
                        <a href="{{ path('app_machine_detail', {id: machine.id}) }}" class="btn btn-secondary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 12H5M12 19l-7-7 7-7"/>
                            </svg>
                            {{ 'mhist.back_machine'|trans }}
                        </a>
                    </div>
                </div>

                {# What this page shows depends on who is reading it. Saying so
                   matters: the counts below are counts of *the rows you can see*, and
                   a member who was not told would read "3 passages" as the machine's
                   whole history. #}
                {% if historyScope|default('none') == 'none' %}
                    <div class="fab-scope-notice">
                        <strong>{{ 'mhist.restricted'|trans }}</strong>
                        <a href="{{ path('app_login') }}">{{ 'mhist.sign_in'|trans }}</a> {{ 'mhist.sign_in_rest'|trans }}
                    </div>
                {% elseif historyScope|default('none') == 'own' %}
                    <div class="fab-scope-notice">
                        {# `|raw`: the value carries <strong> around the possessive, which is
                           the whole point of the sentence. #}
                        {{ 'mhist.own_scope'|trans|raw }}
                    </div>
                {% endif %}

                <div class="machine-stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <path d="M7 8h10M7 12h10M7 16h6"/>
                                <rect x="3" y="4" width="18" height="16" rx="2"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ rfidLogs|length }}</span>
                            <span class="stat-label">{{ 'home.stat_rfid'|trans }}</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <polyline points="12,6 12,12 16,14"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ usageLogs|length }}</span>
                            <span class="stat-label">{{ 'profile.usage_logs'|trans }}</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ reservations|length }}</span>
                            <span class="stat-label">{{ 'home.stat_reservations'|trans }}</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <path d="M9 12l2 2 4-4"/>
                                <circle cx="12" cy="12" r="10"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ machine.statut }}</span>
                            <span class="stat-label">{{ 'mcal.machine_status'|trans }}</span>
                        </div>
                    </div>
                </div>

                <div class="history-filters">
                    <h3 class="section-subtitle">{{ 'mhist.machine_info'|trans }}</h3>
                    <div class="filter-bar">
                        <div class="filter-group"><label>ID</label><strong>{{ machine.id }}</strong></div>
                        <div class="filter-group"><label>{{ 'machines.col_name'|trans }}</label><strong>{{ machine.nom }}</strong></div>
                        <div class="filter-group"><label>ID</label><strong>#{{ machine.id }}</strong></div>
                        <div class="filter-group"><label>{{ 'machines.col_location'|trans }}</label><strong>{{ machine.localisation ?: 'fallback.not_set_f'|trans }}</strong></div>
                    </div>
                </div>

                <h3 class="section-subtitle">{{ 'home.stat_rfid'|trans }}</h3>
                <div class="history-list">
                    <div class="history-list-header">
                        <span class="history-col date">{{ 'profile.col_date'|trans }}</span>
                        <span class="history-col time">{{ 'profile.col_badge_uid'|trans }}</span>
                        <span class="history-col user">{{ 'leaderboard.col_user'|trans }}</span>
                        <span class="history-col duration">{{ 'profile.col_authorized'|trans }}</span>
                        <span class="history-col status">{{ 'home.col_status'|trans }}</span>
                        <span class="history-col actions">{{ 'profile.col_message'|trans }}</span>
                    </div>
                    {% if rfidLogs is empty %}
                        <div class="history-item"><span class="history-col user">{{ 'profile.no_rfid'|trans }}</span></div>
                    {% else %}
                        {% for log in rfidLogs %}
                            <div class="history-item">
                                <span class="history-col date">{{ log.createdAt|lab_date('d/m/Y H:i') }}</span>
                                {# ⚠️ The badge UID is the credential the door and machine
                                   readers trust. It was rendered here in clear to anyone
                                   who opened the page — the same finding as S38, which
                                   closed the API and missed this. Admins only, and even
                                   then only because they are the ones who pair readers. #}
                                <span class="history-col time">{{ is_granted('ROLE_ADMIN') ? log.badgeUid : '—' }}</span>
                                <span class="history-col user">{{ showBookerIdentity|default(false) ? (log.utilisateur ? log.utilisateur.displayName : 'fallback.user'|trans) : '—' }}</span>
                                <span class="history-col duration">{{ log.authorized ? 'common.yes'|trans : 'common.no'|trans }}</span>
                                <span class="history-col status"><span class="status-badge {{ log.authorized ? 'completed' : 'cancelled' }}">{{ log.status }}</span></span>
                                <span class="history-col actions">{{ log.reason ?: log.message ?: log.color ?: '-' }}</span>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>

                <h3 class="section-subtitle">{{ 'profile.usage_logs'|trans }}</h3>
                <div class="history-list">
                    <div class="history-list-header">
                        <span class="history-col date">{{ 'profile.col_start'|trans }}</span>
                        <span class="history-col time">{{ 'profile.col_end'|trans }}</span>
                        <span class="history-col user">{{ 'leaderboard.col_user'|trans }}</span>
                        <span class="history-col duration">{{ 'profile.col_duration'|trans }}</span>
                        <span class="history-col status">{{ 'profile.col_source'|trans }}</span>
                        <span class="history-col actions">{{ 'profile.col_created'|trans }}</span>
                    </div>
                    {% if usageLogs is empty %}
                        <div class="history-item"><span class="history-col user">{{ 'profile.no_usage'|trans }}</span></div>
                    {% else %}
                        {% for usageLog in usageLogs %}
                            <div class="history-item">
                                <span class="history-col date">{{ usageLog.dateDebut|lab_date('d/m/Y H:i') }}</span>
                                <span class="history-col time">{{ usageLog.dateFin ? usageLog.dateFin|lab_date('d/m/Y H:i') : '-' }}</span>
                                <span class="history-col user">{{ showBookerIdentity|default(false) ? (usageLog.utilisateur ? usageLog.utilisateur.displayName : 'fallback.user'|trans) : '—' }}</span>
                                <span class="history-col duration">{{ usageLog.duree is not null ? usageLog.duree ~ ' min' : '-' }}</span>
                                {# 🔴 A state chip around a value that is NOT a state (S135). `source` is
                                   "rfid" or "manual" — where the row came from — and it was wearing
                                   `.status-badge.completed`, so a provenance read as an outcome.
                                   `is-muted` says "this is a label", and an absent source says so. #}
                                <span class="history-col status">{% if usageLog.source %}{% include 'site/_cell_state.html.twig' with {label: usageLog.source, signal: 'muted'} only %}{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}</span>
                                <span class="history-col actions">{{ usageLog.createdAt|lab_date('d/m/Y H:i') }}</span>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>

                <h3 class="section-subtitle">{{ 'home.stat_reservations'|trans }}</h3>
                <div class="history-list">
                    <div class="history-list-header">
                        <span class="history-col date">{{ 'profile.col_start'|trans }}</span>
                        <span class="history-col time">{{ 'profile.col_end'|trans }}</span>
                        <span class="history-col user">{{ 'leaderboard.col_user'|trans }}</span>
                        <span class="history-col duration">{{ 'profile.col_reason'|trans }}</span>
                        <span class="history-col status">{{ 'home.col_status'|trans }}</span>
                        <span class="history-col actions">{{ 'mhist.created_f'|trans }}</span>
                    </div>
                    {% if reservations is empty %}
                        <div class="history-item"><span class="history-col user">{{ 'mhist.no_reservations'|trans }}</span></div>
                    {% else %}
                        {% for reservation in reservations %}
                            <div class="history-item">
                                <span class="history-col date">{{ reservation.dateDebut|date('d/m/Y H:i') }}</span>
                                <span class="history-col time">{{ reservation.dateFin|date('d/m/Y H:i') }}</span>
                                <span class="history-col user">{{ showBookerIdentity|default(false) ? (reservation.utilisateur ? reservation.utilisateur.displayName : 'fallback.user'|trans) : '—' }}</span>
                                <span class="history-col duration">{{ reservation.motif ?: '-' }}</span>
                                <span class="history-col status"><span class="status-badge {{ reservation.dateFin < date() ? 'completed' : 'pending' }}">{{ reservation.dateFin < date() ? 'state.done'|trans : 'state.upcoming'|trans }}</span></span>
                                <span class="history-col actions">{{ reservation.created|lab_date('d/m/Y H:i') }}</span>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </section>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
{% endblock %}
