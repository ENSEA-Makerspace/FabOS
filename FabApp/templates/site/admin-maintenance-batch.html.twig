{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}Maintenance en lot - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s132-shell' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    {% include 'site/_admin_edit_styles.html.twig' %}
    <style>
        .batch-machines { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 6px 14px; }
        .batch-machines input { width: auto; margin-right: 7px; }
        .batch-machines label { font-weight: 400; display: inline-flex; align-items: center; }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div><h1>Maintenance en lot</h1><p>Appliquer une même tâche à plusieurs machines d’un coup.</p></div>
                <a class="btn-link" href="{{ path('app_admin_maintenance') }}">Retour</a>
            </div>
        </header>
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}
            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header"><h2>Créer pour plusieurs machines</h2></div>
                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        <div class="form-field full">{{ form_label(form.machines) }}<div class="batch-machines">{{ form_widget(form.machines) }}</div><div class="form-errors">{{ form_errors(form.machines) }}</div></div>
                        {{ form_row(form.title, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.type) }}
                        {{ form_row(form.dueDate) }}
                        {{ form_row(form.recurrenceDays) }}
                        {{ form_row(form.link, {row_attr: {class: 'full'}}) }}
                    </div>
                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_maintenance') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
{% endblock %}
