{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'maintenance.batch_browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}
            <section class="admin-panel admin-list-card admin-form-card">
                {% include 'site/_admin_form_head.html.twig' with {
                    title: 'maintenance.batch_title'|trans,
                    subtitle: 'maintenance.batch_subtitle'|trans,
                    back_href: path('app_admin_maintenance'),
                    back_label: 'common.back'|trans,
                } only %}
                <div class="admin-edit-panel-header"><h2>{{ 'maintenance.batch_panel'|trans }}</h2></div>
                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {# ⚠️ S151 — `form_row` et plus l'enveloppe à la main : la classe
                           `.choice-grid` vient du `FormType` (`attr`), et le thème donne
                           au groupe son `role`, son nom et sa description. #}
                        {{ form_row(form.machines) }}
                        {{ form_row(form.title, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.type) }}
                        {{ form_row(form.dueDate) }}
                        {{ form_row(form.recurrenceDays) }}
                        {{ form_row(form.link, {row_attr: {class: 'full'}}) }}
                    </div>
                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_maintenance') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
{% endblock %}
