<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau de bord Admin - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260731-status' }}">
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        /* Styles spécifiques à l'admin */
        
        
        .admin-welcome {
            display: flex;
            align-items: center;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-lg);
        }
        
        .admin-avatar {
            width: 80px;
            height: 80px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: var(--border-radius-circle);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            font-weight: bold;
        }
        
        .admin-welcome-text h1 {
            font-size: var(--font-size-3xl);
            margin-bottom: var(--spacing-xs);
        }
        
        .admin-welcome-text p {
            opacity: 0.9;
        }
        
        .admin-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
        }
        
        .admin-stat-card {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: var(--spacing-md);
            transition: transform var(--transition), box-shadow var(--transition);
        }
        
        .admin-stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }
        
        .admin-stat-icon {
            width: 60px;
            height: 60px;
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        
        .admin-stat-icon svg {
            width: 28px;
            height: 28px;
        }
        
        .admin-stat-info h4 {
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: var(--color-primary);
            margin-bottom: var(--spacing-xs);
        }
        
        .admin-stat-info p {
            color: var(--color-text-light);
            font-size: var(--font-size-sm);
        }
        
        
        .admin-sidebar {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            height: fit-content;
        }
        
        .admin-sidebar h3 {
            font-size: var(--font-size-lg);
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: var(--spacing-lg);
            padding-bottom: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-nav {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-xs);
        }
        
        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            padding: var(--spacing-md);
            color: var(--color-text);
            text-decoration: none;
            border-radius: var(--border-radius-sm);
            transition: all var(--transition);
            font-weight: 500;
        }
        
        .admin-nav-link:hover {
            background: var(--color-bg-light);
            color: var(--color-primary);
        }
        
        .admin-nav-link.active {
            background: var(--color-primary);
            color: white;
        }
        
        .admin-nav-link svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }
        
        .admin-content {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-lg);
        }
        
        .first-run-card { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.34); border-radius: 12px; padding: 14px 18px; margin-bottom: 20px; }
        .first-run-card strong { font-size: 15px; }
        .first-run-card span { opacity: .9; font-size: 13px; flex: 1 1 260px; }

        .admin-panel {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
        }
        
        .admin-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-lg);
            padding-bottom: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-panel-header h2 {
            font-size: var(--font-size-xl);
            font-weight: 600;
            color: var(--color-text);
        }
        
        .admin-actions {
            display: flex;
            gap: var(--spacing-sm);
        }
        
        .quick-actions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: var(--spacing-lg);
        }
        
        .quick-action-card {
            display: flex;
            align-items: center;
            gap: var(--spacing-md);
            padding: var(--spacing-lg);
            background: var(--color-bg-light);
            border-radius: var(--border-radius);
            border: 1px solid var(--border-color);
            transition: all var(--transition);
            cursor: pointer;
        }
        
        .quick-action-card:hover {
            background: var(--color-primary);
            color: white;
            border-color: var(--color-primary);
        }

        .quick-action-card.disabled {
            cursor: not-allowed;
            opacity: 0.72;
        }

        .quick-action-card.disabled:hover {
            background: var(--color-bg-light);
            color: inherit;
            border-color: var(--border-color);
        }

        .quick-action-card.disabled:hover .quick-action-icon {
            background: rgba(158, 27, 86, 0.1);
        }

        .quick-action-card.disabled:hover .quick-action-icon svg {
            color: var(--color-primary);
        }

        .quick-action-card.disabled .quick-action-text p {
            opacity: 1;
            color: var(--color-text-light);
        }
        
        .quick-action-card:hover .quick-action-icon,
        .quick-action-card:hover .quick-action-text {
            color: white;
        }
        
        .quick-action-icon {
            width: 50px;
            height: 50px;
            background: rgba(158, 27, 86, 0.1);
            border-radius: var(--border-radius-circle);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all var(--transition);
        }
        
        .quick-action-card:hover .quick-action-icon {
            background: rgba(255, 255, 255, 0.2);
        }
        
        .quick-action-icon svg {
            width: 24px;
            height: 24px;
            color: var(--color-primary);
            transition: all var(--transition);
        }
        
        .quick-action-text h4 {
            font-size: var(--font-size-base);
            font-weight: 600;
            margin-bottom: var(--spacing-xs);
        }
        
        .quick-action-text p {
            font-size: var(--font-size-sm);
            opacity: 0.7;
        }
        
        .recent-activity {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-md);
        }
        
        .activity-item {
            display: flex;
            align-items: flex-start;
            gap: var(--spacing-md);
            padding: var(--spacing-md);
            background: var(--color-bg-light);
            border-radius: var(--border-radius-sm);
            border-left: 4px solid var(--color-primary);
        }
        
        .activity-icon {
            width: 36px;
            height: 36px;
            background: rgba(158, 27, 86, 0.1);
            border-radius: var(--border-radius-circle);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        
        .activity-icon svg {
            width: 18px;
            height: 18px;
            color: var(--color-primary);
        }
        
        .activity-content h5 {
            font-size: var(--font-size-base);
            font-weight: 600;
            margin-bottom: var(--spacing-xs);
        }
        
        .activity-content p {
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
        }
        
        .activity-time {
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
            margin-left: auto;
        }
        
        /* Responsive */
        @media (max-width: 992px) {
            .admin-main-content {
                grid-template-columns: 1fr;
            }
            
            .admin-sidebar {
                order: 1;
            }
        }
        
        @media (max-width: 768px) {
            .admin-stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .admin-welcome {
                flex-direction: column;
                text-align: center;
            }
        }
        
        @media (max-width: 480px) {
            .admin-stats-grid {
                grid-template-columns: 1fr;
            }
            
            .quick-actions-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- ========================================
         BANDEAU D'ALERTE
         ======================================== -->
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <!-- ========================================
         HEADER
         ======================================== -->
    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    {% include 'site/_logo.html.twig' %}
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">{{ 'nav.home'|trans }}</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">{{ 'nav.calendar'|trans }}</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">{{ 'nav.machines'|trans }}</a>
                    {% if feature_enabled('formations') %}<a href="{{ path('app_formations') }}" class="navbar-link">{{ 'nav.trainings'|trans }}</a>{% endif %}
                    {% if feature_enabled('leaderboard') %}<a href="{{ path('app_leaderboard') }}" class="navbar-link">{{ 'nav.leaderboard'|trans }}</a>{% endif %}{% if feature_enabled('projects') %}<a href="{{ path('app_creations') }}" class="navbar-link">{{ 'nav.projects'|trans }}</a>{% endif %}{% if feature_enabled('badges') %}<a href="{{ path('app_badges') }}" class="navbar-link">{{ 'nav.badges'|trans }}</a>{% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- ========================================
         CONTENU PRINCIPAL - TABLEAU DE BORD ADMIN
         ======================================== -->
    <main class="main-content">
        <!-- En-tête Admin -->
        <section class="admin-header">
            <div class="admin-header-content">
                {% if showFirstRun|default(false) %}
                    {# Shown only on an install that has neither been configured nor
                       used — see FirstRun. A card rather than a redirect: S25 flagged
                       a global interceptor as a hazard on a live site, and a card
                       cannot strand anybody. #}
                    <div class="first-run-card">
                        <strong>Cette installation n'a pas encore été configurée.</strong>
                        <span>Quelques réponses — le nom du lieu, l'URL publique, la langue — et le reste suit.</span>
                        <a class="btn btn-primary btn-small" href="{{ path('app_admin_wizard') }}">Commencer</a>
                    </div>
                {% endif %}

                <div class="admin-welcome">
                    <div class="admin-avatar">AD</div>
                    <div class="admin-welcome-text">
                        <h1>Bienvenue, Administrateur</h1>
                        <p>Gérez votre FabLab depuis ce tableau de bord</p>
                    </div>
                </div>
                
                <!-- Statistiques globales -->
                <div class="admin-stats-grid">
                    <div class="admin-stat-card">
                        <div class="admin-stat-icon" style="background: rgba(158, 27, 86, 0.1);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                        <div class="admin-stat-info"><h4>{{ dashboardStats.users }}</h4><p>Utilisateurs</p></div>
                    </div>
                    <div class="admin-stat-card">
                        <div class="admin-stat-icon" style="background: rgba(76, 175, 80, 0.1);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                        </div>
                        <div class="admin-stat-info"><h4>{{ dashboardStats.machines }}</h4><p>Machines</p></div>
                    </div>
                    <div class="admin-stat-card">
                        <div class="admin-stat-icon" style="background: rgba(255, 193, 7, 0.1);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#FFC107" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                        </div>
                        <div class="admin-stat-info"><h4>{{ dashboardStats.formations }}</h4><p>Formations</p></div>
                    </div>
                    <div class="admin-stat-card">
                        <div class="admin-stat-icon" style="background: rgba(244, 67, 54, 0.1);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#F44336" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </div>
                        <div class="admin-stat-info"><h4>{{ dashboardStats.reservations }}</h4><p>Réservations</p></div>
                    </div>
                    <div class="admin-stat-card">
                        <div class="admin-stat-icon" style="background: rgba(33, 150, 243, 0.1);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#2196F3" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></svg>
                        </div>
                        <div class="admin-stat-info"><h4>{{ dashboardStats.rfidLogs }}</h4><p>Logs RFID</p></div>
                    </div>
                    <div class="admin-stat-card">
                        <div class="admin-stat-icon" style="background: rgba(33, 150, 243, 0.1);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#2196F3" stroke-width="2"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>
                        </div>
                        <div class="admin-stat-info"><h4>{{ dashboardStats.badges }}</h4><p>Badges</p></div>
                    </div>
                    <div class="admin-stat-card">
                        <div class="admin-stat-icon" style="background: rgba(76, 175, 80, 0.1);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                        </div>
                        <div class="admin-stat-info"><h4>{{ dashboardStats.completedFormations }}</h4><p>Formations complétées</p></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contenu principal -->
        <section class="admin-main-content">
            <!-- Sidebar -->
                {% include 'site/_admin_sidebar.html.twig' %}

            <!-- Contenu principal -->
            <div class="admin-content">
                <!-- Écrans dédiés (pages plein écran, non listées dans le menu) -->
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h2>Écrans dédiés</h2>
                    </div>
                    <p style="color: var(--color-text-light); margin: 0 0 var(--spacing-md);">Pages plein écran à afficher sur un moniteur. Non listées dans le menu.</p>
                    <div class="quick-actions-grid">
                        {% set screen_icon %}<svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>{% endset %}
                        <a class="quick-action-card" href="{{ path('app_kiosk_entries') }}" target="_blank" rel="noopener">
                            <div class="quick-action-icon">{{ screen_icon }}</div>
                            <div class="quick-action-text"><h4>Derniers passages</h4><p>Les dernières personnes entrées au FabLab</p></div>
                        </a>
                        <a class="quick-action-card" href="{{ path('app_kiosk_stats') }}" target="_blank" rel="noopener">
                            <div class="quick-action-icon">{{ screen_icon }}</div>
                            <div class="quick-action-text"><h4>Statistiques en direct</h4><p>Chiffres clés du FabLab en temps réel</p></div>
                        </a>
                        <a class="quick-action-card" href="{{ path('app_kiosk_machine', {id: 1}) }}" target="_blank" rel="noopener">
                            <div class="quick-action-icon">{{ screen_icon }}</div>
                            <div class="quick-action-text"><h4>Écran machine</h4><p>Infos + badge RFID (exemple machine #1 ; /kiosk/machine/ID)</p></div>
                        </a>
                        {% if feature_enabled('events') %}
                        <a class="quick-action-card" href="{{ path('app_kiosk_events') }}" target="_blank" rel="noopener">
                            <div class="quick-action-icon">{{ screen_icon }}</div>
                            <div class="quick-action-text"><h4>Événements</h4><p>Le prochain événement + les suivants, plein écran</p></div>
                        </a>
                        {% endif %}
                    </div>
                </div>
                <!-- Actions rapides -->
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h2>Actions rapides</h2>
                        <div class="admin-actions">
                            <a class="btn btn-secondary btn-small" href="{{ path('app_admin_users') }}">Administration</a>
                        </div>
                    </div>
                                        <div class="quick-actions-grid">
                        <a class="quick-action-card" href="{{ path('app_admin_user_new') }}">
                            <div class="quick-action-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            </div>
                            <div class="quick-action-text"><h4>Créer un utilisateur</h4><p>Ajouter un compte admin ou utilisateur</p></div>
                        </a>
                        <a class="quick-action-card" href="{{ path('app_admin_machines') }}">
                            <div class="quick-action-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                            </div>
                            <div class="quick-action-text"><h4>Voir les machines</h4><p>Consulter et filtrer le parc</p></div>
                        </a>
                        <a class="quick-action-card" href="{{ path('app_admin_machine_new') }}">
                            <div class="quick-action-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </div>
                            <div class="quick-action-text"><h4>Créer une machine</h4><p>Ajouter une machine FabLab</p></div>
                        </a>
                        <a class="quick-action-card" href="{{ path('app_admin_badge_new') }}">
                            <div class="quick-action-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            </div>
                            <div class="quick-action-text"><h4>Créer un badge</h4><p>Ajouter une certification</p></div>
                        </a>
                        <a class="quick-action-card" href="{{ path('app_admin_formation_new') }}">
                            <div class="quick-action-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                            </div>
                            <div class="quick-action-text"><h4>Créer une formation</h4><p>Ajouter un parcours</p></div>
                        </a>
                        <a class="quick-action-card" href="{{ path('app_admin_usage_logs') }}">
                            <div class="quick-action-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2"><path d="M4 19h16"/><path d="M7 16V8"/><path d="M12 16V5"/><path d="M17 16v-6"/></svg>
                            </div>
                            <div class="quick-action-text"><h4>Voir les utilisations</h4><p>Consulter les sessions machines</p></div>
                        </a>
                        <a class="quick-action-card" href="{{ path('app_admin_opening_hours') }}">
                            <div class="quick-action-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            </div>
                            <div class="quick-action-text"><h4>Gérer les horaires</h4><p>Modifier les ouvertures</p></div>
                        </a>
                    </div>
                </div>

                <!-- Activité récente -->
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h2>Activité récente</h2>
                        <div class="admin-actions">
                            <a class="btn btn-text btn-small" href="{{ path('app_admin_access_rfid_logs') }}">Voir les logs RFID</a>
                        </div>
                    </div>
                    <div class="recent-activity">
                        {% if recentActivities is empty %}
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                </div>
                                <div class="activity-content"><h5>Aucune activité récente</h5><p>Les logs RFID, réservations, progressions et utilisations apparaîtront ici.</p></div>
                                <span class="activity-time">-</span>
                            </div>
                        {% else %}
                            {% for activity in recentActivities %}
                                <div class="activity-item">
                                    <div class="activity-icon">
                                        {% if activity.type == 'reservation' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                        {% elseif activity.type == 'formation' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#2196F3" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                                        {% elseif activity.type == 'usage' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#FF9800" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                                        {% else %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></svg>
                                        {% endif %}
                                    </div>
                                    <div class="activity-content"><h5>{{ activity.title }}</h5><p>{{ activity.message }}</p></div>
                                    <span class="activity-time">{{ activity.date|date('d/m/Y H:i') }}</span>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>
    </main>

