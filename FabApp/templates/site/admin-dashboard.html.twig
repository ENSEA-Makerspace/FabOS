{% extends 'base.html.twig' %}

{#
   Accueil admin : d'abord ce qui demande une action (AdminAttention), ensuite les compteurs
   et les écrans dédiés en une ligne chacun. ⚠️ Dans `.admin-panel`, `style.css` repeint tout
   <span> en gris : texte coloré ou gras en <b>/<div>/<p>.
#}

{% block title %}{{ 'admin_dashboard.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/pages.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/page-admin-attention.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'admin_attention.panel_title'|trans,
} %}
    {% block content %}
        <div class="pp-aa" data-admin-attention>
            {#- Seul chemin vers l'assistant : aucune redirection (S25). -#}
            {% if showFirstRun|default(false) %}
                <div class="pp-aa-firstrun">
                    <b>{{ 'admin_dashboard.setup_needed'|trans }}</b>
                    <p>{{ 'admin_dashboard.setup_hint'|trans }}</p>
                    <a class="btn-link btn-primary-admin" href="{{ path('app_admin_wizard') }}">{{ 'admin_dashboard.start'|trans }}</a>
                </div>
            {% endif %}

            {% if attention.total > 0 %}
                <p class="pp-aa-lead">
                    {% include 'site/_icon.html.twig' with { name: 'warning' } only %}
                    <b>{{ (attention.total == 1 ? 'admin_attention.lead_one' : 'admin_attention.lead_many')|trans({'%n%': attention.total}) }}</b>
                </p>
            {% else %}
                <p class="pp-aa-lead is-calm">
                    {% include 'site/_icon.html.twig' with { name: 'check' } only %}
                    <b>{{ 'admin_attention.lead_calm'|trans }}</b>
                </p>
            {% endif %}

            {% for group in attention.groups %}
                <section class="pp-aa-group" aria-labelledby="pp-aa-{{ group.key }}">
                    <h2 class="pp-aa-title" id="pp-aa-{{ group.key }}">
                        {% include 'site/_icon.html.twig' with { name: group.icon } only %}
                        {{ group.title }} · {{ group.count }}
                    </h2>
                    <div class="admin-table-wrap">
                        <table class="admin-table pp-aa-table">
                            <thead>
                                <tr><th>{{ 'admin_attention.col_what'|trans }}</th><th>{{ 'admin_attention.col_where'|trans }}</th><th>{{ 'admin_attention.col_state'|trans }}</th><th>{{ 'admin_attention.col_action'|trans }}</th></tr>
                            </thead>
                            <tbody>
                                {% for row in group.rows %}
                                    <tr>
                                        <td><b class="pp-aa-name">{{ row.title }}</b></td>
                                        <td>
                                            <div class="pp-aa-meta">
                                                {{ row.where }}
                                                {% if row.when %}
                                                    {% if row.where %}<br>{% endif %}
                                                    {{ row.whenPrefix|default('') }}{% if row.whenKind == 'utc' %}{{ row.when|lab_date('d/m H:i') }}{% elseif row.whenKind == 'date' %}{{ row.when|date('d/m/Y') }}{% else %}{{ row.when|date('d/m H:i') }}{% endif %}
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td>{% include 'site/_state_chip.html.twig' with { label: row.state.label, signal: row.state.signal } only %}</td>
                                        <td>
                                            {% if row.fix|default(null) %}
                                                {% include 'site/_cell_fix.html.twig' with {
                                                    fix: row.fix.fix, route: row.fix.route, params: row.fix.params,
                                                } only %}
                                            {% else %}
                                                <a class="pp-aa-verb" href="{{ path(row.route, row.params) }}">{{ row.verb }}</a>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <p class="pp-aa-all">
                        {% if group.count > group.rows|length %}{{ 'admin_attention.more'|trans({'%n%': group.count - group.rows|length}) }} · {% endif %}
                        <a href="{{ path(group.all.route, group.all.params) }}">{{ group.all.label }}</a>
                    </p>
                </section>
            {% endfor %}

            {# Ce qui descend : les compteurs d'avant, en une ligne, et les écrans dédiés. #}
            <footer class="pp-aa-foot">
                <p class="pp-aa-stats">
                    <b>{{ attention.stats.users }}</b> {{ 'admin_dashboard.stat_users'|trans }} ·
                    <b>{{ attention.stats.machines }}</b> {{ 'admin_dashboard.stat_machines'|trans }} ·
                    <b>{{ attention.stats.formations }}</b> {{ 'admin_dashboard.stat_trainings'|trans }} ·
                    <b>{{ attention.stats.reservations }}</b> {{ 'admin_dashboard.stat_reservations'|trans }} ·
                    <b>{{ attention.stats.rfidLogs }}</b> {{ 'admin_dashboard.stat_rfid_logs'|trans }} ·
                    <b>{{ attention.stats.badges }}</b> {{ 'admin_dashboard.stat_badges'|trans }} ·
                    <b>{{ attention.stats.completedFormations }}</b> {{ 'admin_dashboard.stat_formations'|trans }}
                </p>
                <p class="pp-aa-screens">
                    <b>{{ 'admin_dashboard.screens_heading'|trans }}</b> :
                    <a href="{{ path('app_kiosk_home') }}" target="_blank" rel="noopener">{{ 'admin_dashboard.kiosk_home'|trans }}</a> ·
                    <a href="{{ path('app_kiosk_entries') }}" target="_blank" rel="noopener">{{ 'admin_dashboard.kiosk_entries'|trans }}</a> ·
                    <a href="{{ path('app_kiosk_stats') }}" target="_blank" rel="noopener">{{ 'admin_dashboard.kiosk_stats'|trans }}</a>
                    {% if feature_enabled('events') %} · <a href="{{ path('app_kiosk_events') }}" target="_blank" rel="noopener">{{ 'admin_dashboard.kiosk_events'|trans }}</a>{% endif %}
                </p>
            </footer>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
