{% extends 'base.html.twig' %}{% block title %}{{ 'network.title'|trans }} - FabOS{% endblock %}{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260812-s137-refine' }}">{% endblock %}
{% block body %}{% embed 'site/_admin_list.html.twig' with {title:'network.title'|trans,description:'network.description'|trans,panel_title:'network.identity'|trans,list_route:'app_admin_network',workspace_key:workspaceKey} %}{% block content %}
{% if instance %}<div class="workspace-summary"><article><span>{{ instance.name }}</span><small>{{ instance.uuid }}</small></article><article><span>{{ instance.origin }}</span><small>{{ instance.keyId }}</small></article></div>{% else %}<form method="post" class="form-grid"><input type="hidden" name="_token" value="{{ csrf_token('network_settings') }}"><input type="hidden" name="action" value="initialize"><div class="form-field"><label>{{ 'network.name'|trans }}</label><input name="name" required></div><div class="form-field"><label>{{ 'network.origin'|trans }}</label><input name="origin" type="url" required placeholder="https://fab.example.org"></div><button class="btn-link btn-primary-admin">{{ 'network.initialize'|trans }}</button></form>{% endif %}
<h3>{{ 'network.oidc'|trans }}</h3><form method="post" class="form-grid"><input type="hidden" name="_token" value="{{ csrf_token('network_settings') }}"><input type="hidden" name="action" value="provider">{% for field in ['key','label','issuer','clientId','secretEnv'] %}<div class="form-field"><label>{{ ('network.'~field)|trans }}</label><input name="{{ field }}" required></div>{% endfor %}<label><input type="checkbox" name="enabled" checked> {{ 'network.enabled'|trans }}</label><button class="btn-link btn-primary-admin">{{ 'common.save'|trans }}</button></form>
{% embed 'site/_data_table.html.twig' with {columns:[{label:'network.provider'|trans},{label:'network.issuer'|trans},{label:'network.state'|trans}],rows:providers,empty:'network.no_provider'|trans} %}{% block rows %}{% for provider in providers %}<tr><td>{{ provider.label }}</td><td>{{ provider.issuer }}</td><td>{% include 'site/_state_chip.html.twig' with {label:provider.enabled ? 'network.enabled'|trans : 'network.disabled'|trans,signal:provider.enabled ? 'positive':'neutral'} only %}</td></tr>{% endfor %}{% endblock %}{% endembed %}
<h3>{{ 'network.peers'|trans }}</h3>{% embed 'site/_data_table.html.twig' with {columns:[{label:'network.instance'|trans},{label:'network.origin'|trans},{label:'network.state'|trans}],rows:peers,empty:'network.no_peer'|trans} %}{% block rows %}{% for peer in peers %}<tr><td>{{ peer.institution ?: peer.instanceUuid }}</td><td>{{ peer.origin }}</td><td>{{ peer.trustState }}</td></tr>{% endfor %}{% endblock %}{% endembed %}
<details><summary>{{ 'network.add_peer'|trans }}</summary><form method="post" class="form-grid"><input type="hidden" name="_token" value="{{ csrf_token('network_settings') }}"><input type="hidden" name="action" value="peer">{% for field in ['instanceUuid','peerOrigin','keyId','publicKey'] %}<div class="form-field"><label>{{ ('network.'~field)|trans }}</label><input name="{{ field }}" required></div>{% endfor %}<button class="btn-link btn-primary-admin">{{ 'network.trust'|trans }}</button></form></details>
{% endblock %}{% endembed %}{% endblock %}
