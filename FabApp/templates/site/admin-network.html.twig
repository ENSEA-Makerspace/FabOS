{% extends 'base.html.twig' %}{% block title %}{{ 'network.title'|trans }} - FabOS{% endblock %}{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260827-s152b' }}">{% endblock %}
{# ⚠️ **S148, J-22 — les trois formulaires passent au thème.** Ils étaient écrits à
   la main, et deux d'entre eux fabriquaient leurs champs par une boucle Twig sur une
   liste de noms — ce qui les rendait tous obligatoires et tous en texte libre, y
   compris l'émetteur OIDC et l'origine du pair, qui sont des URL. #}
{% block body %}{% embed 'site/_admin_list.html.twig' with {panel_title:'network.identity'|trans,list_route:'app_admin_network',workspace_key:workspaceKey} %}{% block content %}
{% if instance %}<div class="workspace-summary"><article><span>{{ instance.name }}</span><small>{{ instance.uuid }}</small></article><article><span>{{ instance.origin }}</span><small>{{ instance.keyId }}</small></article></div>{% else %}
    {{ form_start(forms.identity, {attr: {class: 'form-grid'}}) }}
        {% form_theme forms.identity 'form/admin_theme.html.twig' %}
        {{ form_row(forms.identity.name) }}
        {{ form_row(forms.identity.origin) }}
        <div class="form-field full"><button class="btn-link btn-primary-admin" type="submit">{{ 'network.initialize'|trans }}</button></div>
    {{ form_end(forms.identity) }}
{% endif %}

<h3>{{ 'network.oidc'|trans }}</h3>
{{ form_start(forms.provider, {attr: {class: 'form-grid'}}) }}
    {% form_theme forms.provider 'form/admin_theme.html.twig' %}
    {{ form_row(forms.provider.key) }}
    {{ form_row(forms.provider.label) }}
    {{ form_row(forms.provider.issuer) }}
    {{ form_row(forms.provider.clientId) }}
    {{ form_row(forms.provider.secretEnv) }}
    {{ form_row(forms.provider.enabled) }}
    <div class="form-field full"><button class="btn-link btn-primary-admin" type="submit">{{ 'common.save'|trans }}</button></div>
{{ form_end(forms.provider) }}

{% embed 'site/_data_table.html.twig' with {columns:[{label:'network.provider'|trans},{label:'network.issuer'|trans},{label:'network.state'|trans}],rows:providers,empty:'network.no_provider'|trans} %}{% block rows %}{% for provider in providers %}<tr><td>{{ provider.label }}</td><td>{{ provider.issuer }}</td><td>{% include 'site/_state_chip.html.twig' with {label:provider.enabled ? 'network.enabled'|trans : 'network.disabled'|trans,signal:provider.enabled ? 'positive':'neutral'} only %}</td></tr>{% endfor %}{% endblock %}{% endembed %}
<h3>{{ 'network.peers'|trans }}</h3>{% embed 'site/_data_table.html.twig' with {columns:[{label:'network.instance'|trans},{label:'network.origin'|trans},{label:'network.state'|trans}],rows:peers,empty:'network.no_peer'|trans} %}{% block rows %}{% for peer in peers %}<tr><td>{{ peer.institution ?: peer.instanceUuid }}</td><td>{{ peer.origin }}</td><td>{{ peer.trustState }}</td></tr>{% endfor %}{% endblock %}{% endembed %}
<details{{ peerRefused|default(false) ? ' open' : '' }}><summary>{{ 'network.add_peer'|trans }}</summary>
    {{ form_start(forms.peer, {attr: {class: 'form-grid'}}) }}
        {% form_theme forms.peer 'form/admin_theme.html.twig' %}
        {{ form_row(forms.peer.instanceUuid) }}
        {{ form_row(forms.peer.peerOrigin) }}
        {{ form_row(forms.peer.keyId) }}
        {{ form_row(forms.peer.publicKey) }}
        <div class="form-field full"><button class="btn-link btn-primary-admin" type="submit">{{ 'network.trust'|trans }}</button></div>
    {{ form_end(forms.peer) }}
</details>
{% endblock %}{% endembed %}{% endblock %}
