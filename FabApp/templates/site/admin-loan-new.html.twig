<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouveau prêt - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260804-s78-tables' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260804-s78-tables' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    {% include 'site/_admin_edit_styles.html.twig' %}
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div><h1>Enregistrer un prêt</h1><p>Sortie d’un objet du catalogue de prêt.</p></div>
                <a class="btn-link" href="{{ path('app_admin_loans') }}">Retour aux prêts</a>
            </div>
        </header>
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}
            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header"><h2>Nouveau prêt</h2></div>
                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.item) }}
                        {{ form_row(form.borrower) }}
                        {{ form_row(form.borrowerName) }}
                        {{ form_row(form.borrowerEmail) }}
                        {{ form_row(form.borrowerPhone) }}
                        {{ form_row(form.dateTaken) }}
                        {{ form_row(form.expectedReturnDate) }}
                        {{ form_row(form.conditionOut, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.notes, {row_attr: {class: 'full'}}) }}
                    </div>
                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_loans') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
</body>
</html>
