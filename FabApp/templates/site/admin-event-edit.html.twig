<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier {{ event.titre }} - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        .admin-edit-header { background: #9E1B56; color: #fff; padding: 32px 24px; }
        .admin-edit-header-inner { max-width: var(--max-width); margin: 0 auto; display: flex; justify-content: space-between; gap: 20px; align-items: center; flex-wrap: wrap; }
        .admin-edit-header h1 { margin: 0 0 8px; font-size: 30px; }
        .admin-edit-header p { margin: 0; opacity: .9; }
        .admin-edit-layout { max-width: var(--max-width); margin: 24px auto 48px; padding: 0 24px; display: grid; grid-template-columns: 260px 1fr; gap: 24px; }
        .admin-edit-nav, .admin-edit-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: var(--shadow); }
        .admin-edit-nav { padding: 18px; align-self: start; }
        .admin-edit-nav h3 { margin: 0 0 12px; font-size: 17px; }
        .admin-edit-nav a { display: block; padding: 10px 12px; border-radius: 6px; color: #374151; text-decoration: none; }
        .admin-edit-nav a.active { background: rgba(158, 27, 86, .1); color: #9E1B56; font-weight: 700; }
        .admin-edit-panel-header { padding: 20px 24px; border-bottom: 1px solid #e5e7eb; }
        .admin-edit-panel-header h2 { margin: 0 0 6px; font-size: 22px; }
        .admin-edit-panel-header p { margin: 0; color: #6b7280; }
        .admin-edit-form { padding: 24px; }
        .form-grid { display: grid; grid-template-columns: repeat(2, minmax(220px, 1fr)); gap: 18px; }
        .form-field.full { grid-column: 1 / -1; }
        .form-field label { display: block; margin-bottom: 7px; font-weight: 700; color: #374151; }
        .form-field input, .form-field textarea { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px; background: #fff; }
        .form-field textarea { min-height: 130px; resize: vertical; }
        .form-errors { margin: 7px 0 0; color: #b91c1c; font-size: 14px; }
        .form-errors ul { margin: 0; padding-left: 18px; }
        .readonly-grid { display: grid; grid-template-columns: repeat(2, minmax(160px, 1fr)); gap: 12px; padding: 16px 24px 0; }
        .readonly-item { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; }
        .readonly-label { display: block; color: #6b7280; font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 5px; }
        .readonly-value { color: #111827; overflow-wrap: anywhere; }
        .form-actions { display: flex; justify-content: flex-end; gap: 12px; padding-top: 22px; margin-top: 22px; border-top: 1px solid #e5e7eb; }
        .btn-link { display: inline-flex; align-items: center; justify-content: center; padding: 10px 14px; border-radius: 6px; border: 1px solid #d1d5db; text-decoration: none; color: #374151; background: #fff; }
        .btn-submit button { padding: 10px 16px; border-radius: 6px; border: 0; color: #fff; background: #9E1B56; font-weight: 700; cursor: pointer; }
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid, .readonly-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Modifier un événement</h1>
                    <p>{{ event.titre }}</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_events') }}">Retour aux événements</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>Champs modifiables</h2>
                </div>

                <div class="readonly-grid">
                    <div class="readonly-item"><span class="readonly-label">ID</span><span class="readonly-value">#{{ event.id }}</span></div>
                    <div class="readonly-item"><span class="readonly-label">Créé le</span><span class="readonly-value">{{ event.createdAt|date('d/m/Y H:i:s') }}</span></div>
                </div>

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        <div class="form-field full">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre) }}
                            <div class="form-errors">{{ form_errors(form.titre) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.dateDebut) }}
                            {{ form_widget(form.dateDebut) }}
                            <div class="form-errors">{{ form_errors(form.dateDebut) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.dateFin) }}
                            {{ form_widget(form.dateFin) }}
                            <div class="form-errors">{{ form_errors(form.dateFin) }}</div>
                        </div>
                        <div class="form-field full">
                            {{ form_label(form.lieu) }}
                            {{ form_widget(form.lieu) }}
                            <div class="form-errors">{{ form_errors(form.lieu) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.locationMode) }}
                            {{ form_widget(form.locationMode) }}
                            <div class="form-errors">{{ form_errors(form.locationMode) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.address) }}
                            {{ form_widget(form.address) }}
                            <div class="form-errors">{{ form_errors(form.address) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.capacite) }}
                            {{ form_widget(form.capacite) }}
                            <div class="form-errors">{{ form_errors(form.capacite) }}</div>
                        </div>
                        <div class="form-field check">
                            {{ form_widget(form.guestsAllowed) }}
                            {{ form_label(form.guestsAllowed) }}
                        </div>
                        <div class="form-field full">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description) }}
                            <div class="form-errors">{{ form_errors(form.description) }}</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_events') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}

                {# The other QR: this one is per-event and points at the public
                   page, for printing on posters and flyers. Not to be confused
                   with the per-attendee ticket QR, which staff scan at the door. #}
                <div style="margin-top:26px; padding-top:22px; border-top:1px solid var(--border-color);">
                    <h2 style="font-size:17px; margin:0 0 4px;">QR code pour affiche</h2>
                    <p style="color:var(--color-text-light); font-size:13px; margin:0 0 14px;">
                        À imprimer sur vos affiches et flyers : en le scannant, le public arrive directement
                        sur la page de l'événement et peut s'inscrire.
                    </p>

                    {% if shareQr %}
                        <div style="display:flex; gap:20px; align-items:flex-start; flex-wrap:wrap;">
                            <img src="{{ shareQr }}" alt="QR code de l'événement"
                                 style="width:170px; height:170px; background:#fff; padding:10px; border-radius:12px; border:1px solid var(--border-color);">
                            <div style="min-width:240px;">
                                <p style="font-size:13px; color:var(--color-text-light); margin:0 0 6px;">Adresse encodée</p>
                                <code style="font-size:12.5px; word-break:break-all;">{{ shareUrl }}</code>
                                <p style="margin:14px 0 0;">
                                    <a class="btn-action" href="{{ path('app_admin_event_qr', {id: event.id}) }}">Télécharger en PNG (1200px)</a>
                                </p>
                                <p style="color:var(--color-text-light); font-size:12px; margin:8px 0 0;">
                                    Haute résolution, prêt pour l'impression A3.
                                </p>
                            </div>
                        </div>
                    {% else %}
                        {# Without a public URL the QR would encode localhost — useless on paper. #}
                        <p style="color:var(--color-text-light); font-size:13px;">
                            Renseignez l'<strong>adresse publique du site</strong> dans
                            <a href="{{ path('app_admin_emails') }}">Administration → E-mails</a> pour générer le QR code.
                        </p>
                    {% endif %}
                </div>

                {# Separate form: a file upload has to POST on its own, and the
                   poster is replaced independently of the rest of the event. #}
                <div style="margin-top:26px; padding-top:22px; border-top:1px solid var(--border-color);">
                    <h2 style="font-size:17px; margin:0 0 4px;">Affiche</h2>
                    <p style="color:var(--color-text-light); font-size:13px; margin:0 0 14px;">
                        Image mise en avant sur la page publique. PNG, JPG ou WEBP — format paysage conseillé.
                    </p>

                    {% if event.hasPoster %}
                        <img src="{{ asset('uploads/events/' ~ event.posterFilename) }}" alt=""
                             style="max-width:320px; width:100%; border-radius:12px; border:1px solid var(--border-color); display:block; margin-bottom:12px;">
                    {% endif %}

                    <form method="post" action="{{ path('app_admin_event_poster', {id: event.id}) }}" enctype="multipart/form-data" style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                        <input type="hidden" name="_token" value="{{ csrf_token('event_poster_' ~ event.id) }}">
                        <input type="file" name="poster" accept="image/png,image/jpeg,image/webp" required>
                        <button type="submit" class="btn-action">{{ event.hasPoster ? 'Remplacer' : 'Téléverser' }}</button>
                    </form>

                    {% if event.hasPoster %}
                        <form method="post" action="{{ path('app_admin_event_poster', {id: event.id}) }}" style="margin-top:10px;"
                              onsubmit="return confirm('Retirer l\'affiche ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('event_poster_' ~ event.id) }}">
                            <input type="hidden" name="action" value="remove">
                            <button type="submit" class="btn-action">Retirer l'affiche</button>
                        </form>
                    {% endif %}
                </div>
            </section>
        </div>
    </main>
</body>
</html>
