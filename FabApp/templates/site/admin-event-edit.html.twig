{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'common.edit'|trans }} {{ event.titre }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s148j22' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260823-s148j7' }}">
    <style>
        {# Blocks that live after form_end are direct children of the panel, which has no
           padding of its own — the form supplied it. Without this they sit flush against
           the panel edges. #}
        .admin-edit-extra { padding: 0 24px 24px; }
        .admin-edit-extra + .admin-edit-extra { padding-top: 0; }
        .admin-edit-extra h2 { font-size: 17px; margin: 0 0 4px; }
        .admin-edit-extra .hint { color: var(--color-text-light); font-size: 13px; margin: 0 0 14px; line-height: 1.55; }
        .admin-edit-extra .sep { border-top: 1px solid var(--border-color); margin: 0 0 20px; }
        {# The registration QR and the poster: this screen and no other. #}
        .qr-row { display: flex; gap: 20px; align-items: flex-start; flex-wrap: wrap; }
        .qr-img { width: 170px; height: 170px; background: var(--theme-surface); padding: 10px; border-radius: 12px; border: 1px solid var(--border-color); }
        .qr-url { font-size: 12.5px; word-break: break-all; background: var(--theme-surface-elevated); border: 1px solid var(--border-color); border-radius: 6px; padding: 8px 10px; display: block; }
        .poster-preview { max-width: 320px; width: 100%; border-radius: 10px; border: 1px solid var(--border-color); display: block; margin-bottom: 12px; }
        .upload-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel admin-list-card admin-form-card">
                {% include 'site/_admin_form_head.html.twig' with {
                    title: 'event_edit.title'|trans,
                    subtitle: event.titre,
                    back_href: path('app_admin_events'),
                    back_label: 'event_edit.back'|trans,
                } only %}
                <div class="admin-edit-panel-header">
                    <h2>{{ 'event_edit.fields_heading'|trans }}</h2>
                </div>

                {% include 'site/_admin_meta_grid.html.twig' with {items: [
                    {label: 'ID', value: '#' ~ event.id},
                    {label: 'event_edit.created_on'|trans, value: event.createdAt|lab_date('d/m/Y H:i:s')},
                ]} only %}

                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.titre, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.dateDebut) }}
                        {{ form_row(form.dateFin) }}
                        {{ form_row(form.venue) }}
                        {{ form_row(form.lieu, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.locationMode) }}
                        {{ form_row(form.address) }}
                        {{ form_row(form.capacite) }}
                        {#- 🔴 **A field added to `EventAdminType` draws NOTHING until it is
                            named here.** This form renders row by row, so S146f's category and
                            formation fields shipped invisible. There is no `form_rest()` to
                            catch them: it would also re-render `save`, which the actions row
                            below places deliberately. -#}
                        {{ form_row(form.category) }}
                        {{ form_row(form.formation) }}
                        <div class="form-field check">
                            {{ form_widget(form.guestsAllowed) }}
                            {{ form_label(form.guestsAllowed) }}
                        </div>
                        {{ form_row(form.description, {row_attr: {class: 'full'}}) }}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_events') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
                {% include 'site/_admin_danger_zone.html.twig' with {
                    action: path('app_admin_event_delete', {id: event.id}),
                    token: 'delete_event_' ~ event.id,
                    heading: (event.archived ? 'adm.restore_record' : 'adm.archive_record')|trans,
                    label: (event.archived ? 'adm.restore_record' : 'adm.archive_record')|trans,
                    description: (event.archived ? 'adm.restore_record_notice' : 'adm.archive_record_notice')|trans,
                    confirm: (event.archived ? 'adm.restore_record_confirm' : 'adm.archive_record_confirm')|trans({'%name%': event.titre}),
                } only %}

                {# The other QR: this one is per-event and points at the public
                   page, for printing on posters and flyers. Not to be confused
                   with the per-attendee ticket QR, which staff scan at the door. #}
                <div class="admin-edit-extra">
                    <div class="sep"></div>
                    <h2>{{ 'event_edit.qr_heading'|trans }}</h2>
                    <p class="hint">{{ 'event_edit.qr_help'|trans }}</p>

                    {% if shareQr %}
                        <div class="qr-row">
                            <img class="qr-img" src="{{ shareQr }}" alt="{{ 'event_edit.qr_alt'|trans }}">
                            <div style="min-width:240px; flex:1;">
                                <p class="hint" style="margin:0 0 6px;">{{ 'event_edit.qr_encoded_url'|trans }}</p>
                                <code class="qr-url">{{ shareUrl }}</code>
                                <p style="margin:14px 0 0;">
                                    <a class="btn-action" href="{{ path('app_admin_event_qr', {id: event.id}) }}">{{ 'event_edit.qr_download'|trans }}</a>
                                </p>
                                <p class="hint" style="margin:8px 0 0;">{{ 'event_edit.qr_download_help'|trans }}</p>
                            </div>
                        </div>
                    {% else %}
                        {# Without a public URL the QR would encode localhost — useless on paper. #}
                        <p class="hint">{{ 'event_edit.qr_no_url'|trans({'%url%': path('app_admin_emails')})|raw }}</p>
                    {% endif %}
                </div>

                {# Separate form: a file upload has to POST on its own, and the
                   poster is replaced independently of the rest of the event. #}
                <div class="admin-edit-extra">
                    <div class="sep"></div>
                    <h2>{{ 'event_edit.poster_heading'|trans }}</h2>
                    <p class="hint">
                        {{ 'event_edit.poster_help'|trans }}
                    </p>

                    {% if event.hasPoster %}
                        <img class="poster-preview" src="{{ asset('uploads/events/' ~ event.posterFilename) }}" alt="">
                    {% endif %}

                    <form method="post" action="{{ path('app_admin_event_poster', {id: event.id}) }}" enctype="multipart/form-data" class="upload-row">
                        <input type="hidden" name="_token" value="{{ csrf_token('event_poster_' ~ event.id) }}">
                        <input type="file" name="poster" accept="image/png,image/jpeg,image/webp" required>
                        <button type="submit" class="btn-action">{{ event.hasPoster ? 'common.replace'|trans : 'common.upload'|trans }}</button>
                    </form>

                    {% if event.hasPoster %}
                        {# `confirm_controller`, not `onsubmit`: the sentence was French
                           inside an HTML attribute, where no catalogue reaches it. #}
                        <form method="post" action="{{ path('app_admin_event_poster', {id: event.id}) }}" style="margin-top:10px;"
                              data-controller="confirm"
                              data-action="submit->confirm#ask"
                              data-confirm-message-value="{{ 'adm.confirm_remove_poster'|trans|e('html_attr') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('event_poster_' ~ event.id) }}">
                            <input type="hidden" name="action" value="remove">
                            <button type="submit" class="btn-action">{{ 'event_edit.poster_remove'|trans }}</button>
                        </form>
                    {% endif %}
                </div>
            </section>
        </div>
    </main>
{% endblock %}
