{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}Modifier {{ event.titre }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260809-s117-workspaces' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <style>
        /* :not(...) matters — the bare rule also caught radios and checkboxes,
           blowing them up into full-width bordered boxes. */
        .form-field input:not([type="radio"]):not([type="checkbox"]), .form-field textarea, .form-field select { width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 15px; background: var(--theme-surface); }
        .form-field input[type="radio"], .form-field input[type="checkbox"] { width: 16px; height: 16px; accent-color: #9E1B56; margin: 0; }
        /* Expanded ChoiceType renders a bare list of radio+label pairs. */
        .form-field .radio-group, .form-field > div > input[type="radio"] + label { display: inline; }
        .form-field .form-check, .form-field.check { display: flex; align-items: center; gap: 9px; }
        .form-field.check label { margin: 0; font-weight: 600; }
        .form-field fieldset { border: 0; padding: 0; margin: 0; }
        .form-field fieldset > div { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 4px; }
        .form-field fieldset label { display: inline-flex; align-items: center; gap: 7px; font-weight: 500; margin: 0; }
        .form-field .help-text, .form-field small { display: block; color: var(--color-text-light); font-size: 12.5px; margin-top: 6px; line-height: 1.5; }
        {# ⚠️ The four `.readonly-*` rules that used to sit here carried four
           literal hex values and were invisible in dark mode. They now live in
           admin.css on tokens; the markup is `_admin_meta_grid.html.twig`. #}
        /* Blocks that live after form_end are direct children of the panel,
           which has no padding of its own — the form supplied it. Without this
           they sit flush against the panel edges. */
        .admin-edit-extra { padding: 0 24px 24px; }
        .admin-edit-extra + .admin-edit-extra { padding-top: 0; }
        .admin-edit-extra h2 { font-size: 17px; margin: 0 0 4px; }
        .admin-edit-extra .hint { color: var(--color-text-light); font-size: 13px; margin: 0 0 14px; line-height: 1.55; }
        .admin-edit-extra .sep { border-top: 1px solid var(--border-color); margin: 0 0 20px; }
        .qr-row { display: flex; gap: 20px; align-items: flex-start; flex-wrap: wrap; }
        .qr-img { width: 170px; height: 170px; background: var(--theme-surface); padding: 10px; border-radius: 12px; border: 1px solid var(--border-color); }
        .qr-url { font-size: 12.5px; word-break: break-all; background: var(--theme-surface-elevated); border: 1px solid var(--border-color); border-radius: 6px; padding: 8px 10px; display: block; }
        .poster-preview { max-width: 320px; width: 100%; border-radius: 10px; border: 1px solid var(--border-color); display: block; margin-bottom: 12px; }
        .upload-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        /* This page used .btn-action without ever defining it — it was rendering
           as a bare link. Matches .btn-link, which the page does style. */
        .btn-action { display: inline-flex; align-items: center; justify-content: center; padding: 9px 14px; border-radius: 6px; border: 1px solid var(--border-color); text-decoration: none; color: var(--color-text); background: var(--theme-surface); font-size: 14px; cursor: pointer; }
        .btn-action:hover { border-color: #9E1B56; color: #9E1B56; }
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Modifier un événement</h1>
                    <p>{{ event.titre }}</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_events') }}">Retour aux événements</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>Champs modifiables</h2>
                </div>

                {% include 'site/_admin_meta_grid.html.twig' with {items: [
                    {label: 'ID', value: '#' ~ event.id},
                    {label: 'Créé le', value: event.createdAt|lab_date('d/m/Y H:i:s')},
                ]} only %}

                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.titre, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.dateDebut) }}
                        {{ form_row(form.dateFin) }}
                        {{ form_row(form.lieu, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.locationMode) }}
                        {{ form_row(form.address) }}
                        {{ form_row(form.capacite) }}
                        <div class="form-field check">
                            {{ form_widget(form.guestsAllowed) }}
                            {{ form_label(form.guestsAllowed) }}
                        </div>
                        {{ form_row(form.description, {row_attr: {class: 'full'}}) }}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_events') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
                {% include 'site/_admin_danger_zone.html.twig' with {action: path('app_admin_event_delete', {id: event.id}), token: 'delete_event_' ~ event.id, confirm: 'adm.confirm_delete_event'|trans} only %}

                {# The other QR: this one is per-event and points at the public
                   page, for printing on posters and flyers. Not to be confused
                   with the per-attendee ticket QR, which staff scan at the door. #}
                <div class="admin-edit-extra">
                    <div class="sep"></div>
                    <h2>QR code pour affiche</h2>
                    <p class="hint">
                        À imprimer sur vos affiches et flyers : en le scannant, le public arrive directement
                        sur la page de l'événement et peut s'inscrire.
                    </p>

                    {% if shareQr %}
                        <div class="qr-row">
                            <img class="qr-img" src="{{ shareQr }}" alt="QR code de l'événement">
                            <div style="min-width:240px; flex:1;">
                                <p class="hint" style="margin:0 0 6px;">Adresse encodée</p>
                                <code class="qr-url">{{ shareUrl }}</code>
                                <p style="margin:14px 0 0;">
                                    <a class="btn-action" href="{{ path('app_admin_event_qr', {id: event.id}) }}">Télécharger en PNG (1200px)</a>
                                </p>
                                <p class="hint" style="margin:8px 0 0;">Haute résolution, prêt pour l'impression A3.</p>
                            </div>
                        </div>
                    {% else %}
                        {# Without a public URL the QR would encode localhost — useless on paper. #}
                        <p class="hint">
                            Renseignez l'<strong>adresse publique du site</strong> dans
                            <a href="{{ path('app_admin_emails') }}">Administration → E-mails</a> pour générer le QR code.
                        </p>
                    {% endif %}
                </div>

                {# Separate form: a file upload has to POST on its own, and the
                   poster is replaced independently of the rest of the event. #}
                <div class="admin-edit-extra">
                    <div class="sep"></div>
                    <h2>Affiche</h2>
                    <p class="hint">
                        Image mise en avant sur la page publique. PNG, JPG ou WEBP — format paysage conseillé.
                    </p>

                    {% if event.hasPoster %}
                        <img class="poster-preview" src="{{ asset('uploads/events/' ~ event.posterFilename) }}" alt="">
                    {% endif %}

                    <form method="post" action="{{ path('app_admin_event_poster', {id: event.id}) }}" enctype="multipart/form-data" class="upload-row">
                        <input type="hidden" name="_token" value="{{ csrf_token('event_poster_' ~ event.id) }}">
                        <input type="file" name="poster" accept="image/png,image/jpeg,image/webp" required>
                        <button type="submit" class="btn-action">{{ event.hasPoster ? 'Remplacer' : 'Téléverser' }}</button>
                    </form>

                    {% if event.hasPoster %}
                        <form method="post" action="{{ path('app_admin_event_poster', {id: event.id}) }}" style="margin-top:10px;"
                              onsubmit="return confirm('Retirer l\'affiche ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('event_poster_' ~ event.id) }}">
                            <input type="hidden" name="action" value="remove">
                            <button type="submit" class="btn-action">Retirer l'affiche</button>
                        </form>
                    {% endif %}
                </div>
            </section>
        </div>
    </main>
{% endblock %}
