{% extends 'base.html.twig' %}

{% block title %}Ajouter une création - Admin FabOS{% endblock %}

{% block stylesheets %}
    <style>
        .admin-page { min-height: 100vh; background: #f6f7fb; color: #1f2937; }
        .admin-page-header { background: #9E1B56; color: #fff; padding: 30px 24px; }
        .admin-page-header-inner { max-width: var(--max-width); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
        .admin-page-header h1 { margin: 0 0 6px; font-size: 30px; }
        .admin-page-header p { margin: 0; opacity: .9; }
        .admin-layout { max-width: var(--max-width); margin: 24px auto 48px; padding: 0 24px; display: grid; grid-template-columns: 260px 1fr; gap: 24px; }
        .admin-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: var(--shadow); overflow: hidden; }
        .admin-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; border-bottom: 1px solid #e5e7eb; }
        .admin-panel-header h2 { margin: 0; font-size: 22px; }
        .admin-table-wrap { overflow-x: auto; }
        .admin-table { width: 100%; min-width: 900px; border-collapse: collapse; }
        .admin-table th, .admin-table td { padding: 14px 16px; border-bottom: 1px solid #e5e7eb; text-align: left; vertical-align: middle; }
        .admin-table th { background: #f9fafb; color: #4b5563; font-size: 13px; }
        .creation-thumb { width: 74px; height: 54px; object-fit: cover; border-radius: 6px; border: 1px solid #e5e7eb; background: #f3f4f6; }
        .admin-title-cell strong { display: block; color: #111827; margin-bottom: 3px; }
        .admin-title-cell span { color: #6b7280; font-size: 13px; overflow-wrap: anywhere; }
        .status-pill { display: inline-flex; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
        .status-pill.published { background: #dcfce7; color: #166534; }
        .status-pill.draft { background: #fef3c7; color: #92400e; }
        .admin-actions { display: flex; gap: 8px; align-items: center; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; padding: 9px 12px; border-radius: 6px; border: 1px solid #d1d5db; text-decoration: none; color: #374151; background: #fff; font-weight: 700; cursor: pointer; font-size: 14px; }
        .btn-primary-admin { background: #9E1B56; border-color: #9E1B56; color: #fff; }
        .btn-danger-admin { background: #fee2e2; border-color: #fecaca; color: #991b1b; }
        .admin-flash { margin: 0 0 16px; padding: 12px 14px; border-radius: 6px; font-weight: 700; }
        .admin-flash.success { background: #dcfce7; color: #166534; }
        .admin-flash.error { background: #fee2e2; color: #991b1b; }
        .admin-form { padding: 24px; }
        .form-grid { display: grid; grid-template-columns: repeat(2, minmax(220px, 1fr)); gap: 18px; }
        .form-field.full { grid-column: 1 / -1; }
        .form-field label { display: block; margin-bottom: 7px; font-weight: 700; color: #374151; }
        .form-field input, .form-field textarea, .form-field select { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px; background: #fff; }
        .form-field textarea { min-height: 130px; resize: vertical; }
        .form-field.checkbox label { display: flex; align-items: center; gap: 8px; }
        .form-field.checkbox input { width: auto; }
        .form-help { margin-top: 6px; color: #6b7280; font-size: 13px; }
        .form-errors { margin-top: 7px; color: #b91c1c; font-size: 14px; }
        .current-asset { display: flex; gap: 14px; align-items: center; padding: 14px; border: 1px solid #e5e7eb; border-radius: 8px; background: #f9fafb; }
        .current-asset img { width: 96px; height: 68px; object-fit: cover; border-radius: 6px; border: 1px solid #e5e7eb; }
        .form-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 22px; padding-top: 22px; border-top: 1px solid #e5e7eb; }
        .btn-submit button { padding: 10px 16px; border-radius: 6px; border: 0; color: #fff; background: #9E1B56; font-weight: 700; cursor: pointer; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid { grid-template-columns: 1fr; } .admin-page-header { padding: 24px 16px; } }
</style>
{% endblock %}

{% block body %}
<main class="admin-page">
    <header class="admin-page-header">
        <div class="admin-page-header-inner">
            <div>
                <h1>Ajouter une création</h1>
                <p>Les fichiers sont stockés dans public/uploads/creations/ et la base garde seulement le nom du fichier.</p>
            </div>
            <a class="btn-link" href="{{ path('app_admin_creations') }}">Retour aux créations</a>
        </div>
    </header>

    <div class="admin-layout">
        {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}
        <section class="admin-panel">
            <div class="admin-panel-header"><h2>Nouvelle création</h2></div>
            {{ form_start(form, {attr: {class: 'admin-form', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                <div class="form-grid">
                    <div class="form-field full">
                        <div class="current-asset">
                            {% include 'site/_creation_image.html.twig' with {creation: creation, alt: creation.title} only %}
                            <div>
                                <strong>Image actuelle</strong><br>
                                <span>{{ creation.imageFilename ?: 'Aucune image enregistrée' }}</span><br>
                                <span>{{ creation.fileFilename ? 'Fichier : ' ~ creation.fileFilename : 'Aucun fichier projet' }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-field">{{ form_label(form.title) }}{{ form_widget(form.title) }}<div class="form-errors">{{ form_errors(form.title) }}</div></div>
                    <div class="form-field">{{ form_label(form.author) }}{{ form_widget(form.author) }}<div class="form-errors">{{ form_errors(form.author) }}</div></div>
                    <div class="form-field">{{ form_label(form.authorName) }}{{ form_widget(form.authorName) }}<div class="form-errors">{{ form_errors(form.authorName) }}</div></div>
                    <div class="form-field">{{ form_label(form.externalUrl) }}{{ form_widget(form.externalUrl) }}<div class="form-errors">{{ form_errors(form.externalUrl) }}</div></div>
                    <div class="form-field">{{ form_label(form.printDurationMinutes) }}{{ form_widget(form.printDurationMinutes) }}<div class="form-errors">{{ form_errors(form.printDurationMinutes) }}</div></div>
                    <div class="form-field">{{ form_label(form.imageUpload) }}{{ form_widget(form.imageUpload) }}<div class="form-help">{{ form_help(form.imageUpload) }}</div><div class="form-errors">{{ form_errors(form.imageUpload) }}</div></div>
                    <div class="form-field">{{ form_label(form.fileUpload) }}{{ form_widget(form.fileUpload) }}<div class="form-help">{{ form_help(form.fileUpload) }}</div><div class="form-errors">{{ form_errors(form.fileUpload) }}</div></div>
                    <div class="form-field full">{{ form_label(form.description) }}{{ form_widget(form.description) }}<div class="form-errors">{{ form_errors(form.description) }}</div></div>
                    <div class="form-field checkbox">{{ form_label(form.isPublished) }}{{ form_widget(form.isPublished) }}<div class="form-errors">{{ form_errors(form.isPublished) }}</div></div>
                </div>
                <div class="form-actions">
                    <a class="btn-link" href="{{ path('app_admin_creations') }}">Annuler</a>
                    <span class="btn-submit">{{ form_widget(form.save, {label: 'Créer la création'}) }}</span>
                </div>
            {{ form_end(form) }}
        </section>
    </div>
</main>
{% endblock %}
