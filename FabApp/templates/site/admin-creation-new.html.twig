{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_creations.browser_title_new'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260903-design2' }}">
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
<main id="main-content" tabindex="-1" class="admin-page">
    <div class="admin-layout">
        {% include 'site/_admin_sidebar.html.twig' %}
        <section class="admin-panel admin-list-card admin-form-card">
            {% include 'site/_admin_form_head.html.twig' with {
                title: 'admin_creations.new_title'|trans,
                subtitle: 'admin_creations.form_subtitle'|trans,
                back_href: path('app_admin_creations'),
                back_label: 'admin_creations.back'|trans,
            } only %}
            <div class="admin-panel-header"><h2>{{ 'admin_creations.panel_new'|trans }}</h2></div>
            {% form_theme form 'form/admin_theme.html.twig' %}
            {% include 'site/_creation_form.html.twig' with {
                form: form,
                creation: creation,
                submit_label: 'admin_creations.submit_new'|trans,
            } only %}
        </section>
    </div>
</main>
{% endblock %}
