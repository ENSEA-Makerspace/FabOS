{% extends 'base.html.twig' %}

{# ⚠️ **S132 split one form into five cards.**

   This page was a single 180-line `<form>` with ten headings and one Save at
   the bottom, so there was no way to change the timezone without re-submitting
   the banner, the vocabulary, the rules and the privacy roles as collateral —
   and, worse, every write in the controller sat inside the language check, so a
   POST with an unrecognised locale silently discarded all of them.

   Each card carries its own `section`, its own submit and a one-line summary of
   what it currently says, so an operator can read the state of the installation
   without opening anything. The one dangerous control — usage-rights
   enforcement — sits in a disclosure with its preflight and its confirmation.

   No local `<style>`: `.settings-*` is in `admin.css`, where `.btn-primary` was
   being redefined for the fourth time. #}

{% block title %}{{ 'admin_settings.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260822-s148d' }}">
    {{ importmap('app') }}
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
    <div class="admin-main-content">
        {% include 'site/_admin_sidebar.html.twig' %}
        <div class="admin-column">
        <section class="admin-panel admin-list-card admin-form-card">
            {% include 'site/_admin_form_head.html.twig' with {
                title: 'admin_nav.entry.app_admin_settings'|trans,
            } only %}

            {% for message in app.flashes('success') %}<div class="flash success">{{ message|flash_text }}</div>{% endfor %}
            {% for message in app.flashes('error') %}<div class="flash error">{{ message|flash_text }}</div>{% endfor %}

            {% set sections = [
                {id: 'general', label: 'admin_settings.section_general'|trans},
                {id: 'localisation', label: 'admin_settings.section_localisation'|trans},
                {id: 'alerts', label: 'admin_settings.section_alerts'|trans},
                {id: 'operations', label: 'admin_settings.section_operations'|trans},
                {id: 'advanced', label: 'admin_settings.section_advanced'|trans},
            ] %}
            <ul class="settings-toc">
                {% for section in sections %}
                    <li><a href="#{{ section.id }}">{{ section.label }}</a></li>
                {% endfor %}
            </ul>

            {# ---- 1. Général : the words this installation calls itself by ---- #}
            <section class="settings-card" id="general">
                <div class="settings-card__head">
                    <h2>{{ 'admin_settings.section_general'|trans }}</h2>
                    <p class="settings-card__state">{{ orgName ?: 'admin_settings.state_unset'|trans }} · {{ venueLabel ?: 'admin_settings.state_unset'|trans }}</p>
                </div>
                {{ form_start(forms.general) }}
                    {% form_theme forms.general 'form/admin_theme.html.twig' %}
                    <h3>{{ 'admin_settings.vocabulary_heading'|trans }}</h3>
                    <p class="settings-hint">{{ 'admin_settings.vocabulary_help'|trans }}</p>
                    {{ form_row(forms.general.org_name) }}
                    {{ form_row(forms.general.venue_label) }}
                    <h3>{{ 'admin_settings.lab_space_heading'|trans }}</h3>
                    {{ form_row(forms.general.lab_pages_nav_label) }}
                    <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                {{ form_end(forms.general) }}
            </section>

            {# ---- 2. Localisation : language and the zone the clock is read in ---- #}
            <section class="settings-card" id="localisation">
                <div class="settings-card__head">
                    <h2>{{ 'admin_settings.section_localisation'|trans }}</h2>
                    <p class="settings-card__state">{{ availableLocales[currentLocale]|default(currentLocale) }} · {{ timezone }} · {{ 'now'|lab_date('H:i') }}</p>
                </div>
                {{ form_start(forms.localisation) }}
                    {% form_theme forms.localisation 'form/admin_theme.html.twig' %}
                    <h3>{{ 'admin_settings.language_heading'|trans }}</h3>
                    {{ form_row(forms.localisation.default_locale) }}
                    <h3>{{ 'admin_settings.timezone_heading'|trans }}</h3>
                    {{ form_row(forms.localisation.timezone, {help: 'admin_settings.timezone_now'|trans({'%time%': 'now'|lab_date('H:i')})}) }}
                    {# One key, markup included: French puts the emphasised clause in the
                       middle, other languages will not. Splitting it into head/tail
                       fragments would force every translator into French word order.
                       ⚠️ Reste hors du champ : c'est une phrase sur le réglage, pas
                       l'aide d'un contrôle — `form_help` en porte déjà une. #}
                    <p class="settings-hint">{{ 'admin_settings.timezone_hint'|trans|raw }}</p>
                    <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                {{ form_end(forms.localisation) }}
            </section>

            {# ---- 3. Alertes ---- #}
            <section class="settings-card" id="alerts">
                <div class="settings-card__head">
                    <h2>{{ 'admin_settings.section_alerts'|trans }}</h2>
                    <p class="settings-card__state">{{ (alertBannerEnabled and alertBannerText) ? 'admin_settings.state_banner_on'|trans : 'admin_settings.state_banner_off'|trans }}</p>
                </div>
                {{ form_start(forms.alerts) }}
                    {% form_theme forms.alerts 'form/admin_theme.html.twig' %}
                    {{ form_row(forms.alerts.alert_banner_enabled) }}
                    {{ form_row(forms.alerts.alert_banner_text) }}
                    <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                {{ form_end(forms.alerts) }}
            </section>

            {# ---- 4. Exploitation et sécurité : rules, who is named, feed token ---- #}
            <section class="settings-card" id="operations">
                <div class="settings-card__head">
                    <h2>{{ 'admin_settings.section_operations'|trans }}</h2>
                    <p class="settings-card__state">
                        {{ labRulesHtml ? 'admin_settings.state_rules_set'|trans : 'admin_settings.state_rules_empty'|trans }}
                        · {{ 'admin_settings.state_identity'|trans({'%count%': bookingIdentityRoles|default([])|length}) }}
                    </p>
                </div>
                {{ form_start(forms.operations) }}
                    {% form_theme forms.operations 'form/admin_theme.html.twig' %}
                    <h3>{{ 'admin_settings.rules_heading'|trans }}</h3>
                    {{ form_row(forms.operations.lab_rules_html) }}
                    {{ form_row(forms.operations.lab_rules_pdf_url) }}

                    <h3>{{ 'admin_settings.privacy_heading'|trans }}</h3>
                    {% if forms.operations.booking_identity_roles|length %}
                        {{ form_row(forms.operations.booking_identity_roles) }}
                    {% else %}
                        <p class="settings-hint">{{ 'admin_settings.privacy_no_roles'|trans }}</p>
                    {% endif %}
                    <p class="settings-hint">{{ 'admin_settings.privacy_why'|trans }}</p>

                    <h3>{{ 'admin_settings.ical_heading'|trans }}</h3>
                    {# ⚠️ Le jeton n'est PAS un champ : il ne s'édite pas, il se copie.
                       Il reste du balisage à l'intérieur du formulaire, là où
                       l'opérateur le cherche, pendant que la case à côté déclenche sa
                       régénération. #}
                    <div class="settings-field settings-field-wide">
                        <label for="ical_feed_token">{{ 'admin_settings.ical_token'|trans }}</label>
                        <input type="text" id="ical_feed_token" value="{{ icalFeedToken }}" readonly onclick="this.select()">
                    </div>
                    {{ form_row(forms.operations.regenerate_ical_token) }}
                    <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                {{ form_end(forms.operations) }}
            </section>

            {# ---- 5. Avancé ---- #}
            <section class="settings-card" id="advanced">
                <div class="settings-card__head">
                    <h2>{{ 'admin_settings.section_advanced'|trans }}</h2>
                    <p class="settings-card__state">
                        {{ developmentMode ? 'admin_settings.state_dev_on'|trans : 'admin_settings.state_dev_off'|trans }}
                        · {{ usageRightsEnforced ? 'admin_settings.state_rights_on'|trans : 'admin_settings.state_rights_off'|trans }}
                    </p>
                </div>
                {{ form_start(forms.advanced) }}
                    {% form_theme forms.advanced 'form/admin_theme.html.twig' %}
                    <h3>{{ 'admin_development.heading'|trans }}</h3>
                    {{ form_row(forms.advanced.development_mode) }}

                    {# ⚠️ The one control on this page that can refuse every member at
                       once. `open` when it is already enforced — a state you are living
                       with must not be hidden behind a click. #}
                    <details class="settings-danger" {{ usageRightsEnforced ? 'open' : '' }}>
                        <summary>{{ 'usage_rights.settings_heading'|trans }}</summary>
                        <div>
                            {{ form_row(forms.advanced.usage_rights_enforced) }}
                            <div class="rights-readiness">
                                <strong>{{ 'usage_rights.settings_preflight'|trans }}</strong>
                                <p>{{ 'usage_rights.settings_preflight_summary'|trans({
                                    '%packages%': usageRightsReadiness.packages,
                                    '%members%': usageRightsReadiness.members
                                }) }}</p>
                                <ul>
                                    {% for capability in usageRightsCapabilities %}
                                        <li>{{ capability.labelKey|trans }} <span>{{ usageRightsReadiness.coverage[capability.key]|default(0) }}</span></li>
                                    {% endfor %}
                                </ul>
                            </div>
                            {# Confirmer ce qui est déjà en place n'a pas de sens : la case
                               n'apparaît que tant que le réglage est désactivé. #}
                            {% if not usageRightsEnforced %}
                                {{ form_row(forms.advanced.usage_rights_confirm_enable) }}
                            {% endif %}
                        </div>
                    </details>
                    <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                {{ form_end(forms.advanced) }}
            </section>
        </section>
        </div>
    </div>
    </main>
{% endblock %}
