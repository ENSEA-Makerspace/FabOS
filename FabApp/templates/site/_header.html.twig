<div class="alert-bar">
    {% include 'site/_alert_bar.html.twig' %}
</div>

<header class="site-header">
    <div class="header-container">
        <a href="{{ path('app_home') }}" class="header-brand">
            <div class="logo-ensea">
                {% include 'site/_logo.html.twig' %}
            </div>
        </a>

        <nav class="main-navbar">
            <div class="navbar-container">
                <a href="{{ path('app_home') }}" class="navbar-link">{{ 'nav.home'|trans }}</a>
                <div class="navbar-item navbar-has-dropdown">
                    <a href="{{ path('app_calendar') }}" class="navbar-link">{{ 'nav.calendar'|trans }}</a>
                    <div class="navbar-dropdown">
                        <a href="{{ path('app_calendar') }}" class="navbar-dropdown-link">{{ 'cal.book_machine'|trans }}</a>
                        {% if module_enabled('places') %}<a href="{{ path('app_places') }}" class="navbar-dropdown-link">{{ 'nav.places'|trans }}</a>{% endif %}
                        {% if module_enabled('events') %}<a href="{{ path('app_events') }}" class="navbar-dropdown-link">{{ 'nav.events'|trans }}</a>{% endif %}
                    </div>
                </div>
                <a href="{{ path('app_machines') }}" class="navbar-link">{{ 'nav.machines'|trans }}</a>
                {% if module_enabled('formations') %}<a href="{{ path('app_formations') }}" class="navbar-link">{{ 'nav.trainings'|trans }}</a>{% endif %}
                {% if module_enabled('leaderboard') %}<a href="{{ path('app_leaderboard') }}" class="navbar-link">{{ 'nav.leaderboard'|trans }}</a>{% endif %}{% if module_enabled('projects') %}<a href="{{ path('app_leaderboard_creations') }}" class="navbar-link">{{ 'nav.projects'|trans }}</a>{% endif %}{% if module_enabled('badges') %}<a href="{{ path('app_badges') }}" class="navbar-link">{{ 'nav.badges'|trans }}</a>{% endif %}{% if module_enabled('lab_pages') %}{% set labNav = lab_page_nav() %}<div class="navbar-item navbar-has-dropdown">
                    <a href="{{ path('app_lab_pages') }}" class="navbar-link">{{ lab_pages_nav_label() }}</a>
                    {% if labNav is not empty %}<div class="navbar-dropdown">
                        {% for page in labNav %}
                            <a href="{{ path('app_lab_page', {id: page.id}) }}" class="navbar-dropdown-link">{{ page.titre }}</a>
                            {% for child in page.children %}<a href="{{ path('app_lab_page', {id: child.id}) }}" class="navbar-dropdown-link navbar-dropdown-child">{{ child.titre }}</a>{% endfor %}
                        {% endfor %}
                    </div>{% endif %}
                </div>{% endif %}
                {% if is_granted('ROLE_USER') %}<a href="{{ path('app_my_reservations') }}" class="navbar-link">{{ 'resv.title'|trans }}</a>{% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">{{ 'nav.admin'|trans }}</a>
                {% endif %}
            </div>
        </nav>

        <div class="header-right">
            <div class="header-search">
                <input type="text" placeholder="{{ 'common.search_placeholder'|trans }}" class="search-input-header">
                <button class="search-button-header" aria-label="{{ 'common.search'|trans }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                    </svg>
                </button>
            </div>
            <div class="header-auth">
                {% include 'site/_header_auth.html.twig' %}
            </div>
            <button class="mobile-nav-toggle" aria-label="Menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </div>
</header>
