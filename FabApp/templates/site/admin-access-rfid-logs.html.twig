{% extends 'base.html.twig' %}

{% block title %}{{ 'rfid_logs.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s134i-columns' }}">
    <style>
        .admin-rfid-page { min-height: 100vh; background: #f6f7fb; color: #1f2937; font-family: Arial, sans-serif; }
        .admin-rfid-header h1 { margin: 0 0 6px; font-size: 30px; }
        .admin-rfid-header p { margin: 0; }
        .admin-rfid-nav, .admin-rfid-panel { background: var(--theme-surface); border: 1px solid var(--border-color); border-radius: 8px; }
        .admin-rfid-nav { padding: 16px; align-self: start; }
        .admin-rfid-nav h3 { margin: 0 0 12px; font-size: 16px; }
        .admin-rfid-nav a { display: block; padding: 10px 12px; border-radius: 6px; color: var(--color-text); text-decoration: none; }
        .admin-rfid-nav a.active { background: #eef2ff; color: #3730a3; font-weight: 700; }
        .admin-rfid-panel { overflow: hidden; }
        .admin-rfid-panel-header { display: flex; justify-content: space-between; gap: 16px; padding: 18px 20px; border-bottom: 1px solid var(--border-color); }
        .admin-rfid-panel-header h2 { margin: 0; font-size: 20px; }
        .admin-rfid-count { color: var(--color-text-light); white-space: nowrap; }
        .badge-yes, .badge-no { display: inline-block; min-width: 42px; padding: 3px 8px; border-radius: 999px; text-align: center; font-weight: 700; }
        .badge-yes { background: color-mix(in srgb, var(--color-ok) 15%, var(--theme-surface)); color: var(--color-ok); }
        .badge-no { background: color-mix(in srgb, var(--color-stop, #b91c1c) 15%, var(--theme-surface)); color: var(--color-stop, #b91c1c); }
        .color-chip { display: inline-flex; align-items: center; gap: 6px; }
        .color-dot { width: 14px; height: 14px; border: 1px solid var(--border-color); border-radius: 50%; }
        .token { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 13px; }
        .migration-note { margin: 0; padding: 12px 14px; border-top: 1px solid var(--border-color); background: #fffbeb; color: #92400e; }
        @media (max-width: 900px) {.admin-rfid-layout { grid-template-columns: 1fr; padding: 16px; } .admin-rfid-header { padding: 20px 16px; }}
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main class="admin-rfid-page">
        <header class="admin-rfid-header">
            <h1>{{ 'rfid_logs.title'|trans }}</h1>
            <p>{{ 'rfid_logs.subtitle'|trans }}</p>
        </header>

        <div class="admin-rfid-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'rfid'} %}

            <section class="admin-rfid-panel">
                <div class="admin-rfid-panel-header">
                    <h2>{{ 'rfid_logs.panel_title'|trans }}</h2>
                    <span class="admin-rfid-count">{{ 'rfid_logs.count'|trans({'%count%': logs|length}) }}</span>
                </div>

                {% if readerColumnsExist is defined and not readerColumnsExist %}
                    <p class="migration-note">{{ 'rfid_logs.migration_note'|trans }}</p>
                {% endif %}

                    {% embed 'site/_data_table.html.twig' with {
                        columns: [
                            {label: 'rfid_logs.col_date'|trans},
                            {label: 'rfid_logs.col_badge'|trans},
                            {label: 'rfid_logs.col_user'|trans},
                            {label: 'rfid_logs.col_machine'|trans},
                            {label: 'rfid_logs.col_reader'|trans},
                            {label: 'rfid_logs.col_authorized'|trans},
                            {label: 'rfid_logs.col_status'|trans},
                            {label: 'rfid_logs.col_reason'|trans},
                            {label: 'rfid_logs.col_message'|trans},
                            {label: 'rfid_logs.col_color'|trans},
                        ],
                        rows: logs,
                        empty: 'rfid_logs.empty'|trans,
                    } %}
                        {% block rows %}
                        {% for log in logs %}
                            {% set fallbackLog = log is iterable %}
                            {% set user = fallbackLog ? null : log.utilisateur %}
                            {% set machine = fallbackLog ? null : log.machine %}
                            {% set reader = fallbackLog ? null : log.reader %}
                            {% set createdAt = fallbackLog ? log.createdAt : log.createdAt %}
                            {% set authorized = fallbackLog ? log.authorized : log.authorized %}
                            <tr>
                                <td>{{ createdAt|lab_date('d/m/Y H:i:s') }}</td>
                                <td>{{ log.badgeUid }}</td>
                                <td>
                                    {% if fallbackLog %}
                                        {% set fallbackUserName = ((log.user_firstName ?? '') ~ ' ' ~ (log.user_lastName ?? ''))|trim %}
                                        {% if log.user_id is defined and log.user_id %}{{ fallbackUserName ?: log.user_username ?: 'rfid_logs.unnamed_user'|trans }} (#{{ log.user_id }}){% else %}-{% endif %}
                                    {% elseif user %}
                                        {{ user.displayName }} (#{{ user.id }})
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td>
                                    {% if fallbackLog %}
                                        {% if log.machine_id is defined and log.machine_id %}{{ log.machine_nom }} (#{{ log.machine_id }}){% else %}-{% endif %}
                                    {% elseif machine %}
                                        {{ machine.nom }} (#{{ machine.id }})
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td>
                                    {% if fallbackLog %}
                                        -
                                    {% else %}
                                        {% if reader %}{{ reader.name }}<br>{% endif %}
                                        {% if log.readerToken %}<span class="token">{{ log.readerToken }}</span>{% else %}-{% endif %}
                                    {% endif %}
                                </td>
                                <td><span class="{{ authorized ? 'badge-yes' : 'badge-no' }}">{{ (authorized ? 'common.yes' : 'common.no')|trans }}</span></td>
                                <td>{{ log.status }}</td>
                                <td>{{ log.reason ?? '-' }}</td>
                                <td>{{ log.message ?? '-' }}</td>
                                <td>
                                    {% if log.color %}
                                        <span class="color-chip"><span class="color-dot" style="background: {{ log.color }}"></span>{{ log.color }}</span>
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="10">{{ 'rfid_logs.empty'|trans }}</td></tr>
                        {% endfor %}
                        {% endblock %}
                    {% endembed %}
            </section>
        </div>
    </main>
{% endblock %}
