{% extends 'base.html.twig' %}

{#
   Incidents d'accès : « À traiter » d'abord, par CAUSE, avec la santé des lecteurs à côté
   (`AccessIncidentBoard`). Le journal complet (motif, message, jeton, filtre Oui/Non,
   200 lignes) reste sur la MÊME route : `?vue=journal` — voir `admin-access-rfid-journal.html.twig`.
   ⚠️ Dans `.admin-panel`, `style.css` repeint tout <span> en gris : texte coloré ou gras en <b>/<div>/<p>.
#}

{% block title %}{{ 'rfid_logs.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/pages.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/page-incidents-acces.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'access_incidents.panel_title'|trans,
} %}
    {% block content %}
        {% set periods = {1: 'admin_emails.period_1'|trans, 7: 'admin_emails.period_7'|trans, 30: 'admin_emails.period_30'|trans, 0: 'admin_emails.period_all'|trans} %}

        <div class="pp-ai" data-access-incidents>
            <div class="pp-ai-main">
                <nav class="pp-ai-tiles" aria-label="{{ 'access_incidents.cause'|trans }}">
                    {% for tile in board.tiles %}
                        <a class="pp-ai-tile{{ tile.key == board.cause ? ' is-active' : '' }}{{ tile.count == 0 and tile.key != 'all' ? ' is-empty' : '' }}"
                           href="{{ path('app_admin_access_rfid_logs', {cause: tile.key, days: board.days, reader: board.readerId, machine: board.machineId}) }}"
                           {% if tile.key == board.cause %}aria-current="true"{% endif %}>
                            <b class="pp-ai-count">{{ tile.count }}</b>
                            <div class="pp-ai-label">{{ tile.label }}</div>
                        </a>
                    {% endfor %}
                </nav>

                <details class="pp-ai-refine"{{ board.refined ? ' open' : '' }}>
                    <summary>{{ 'admin_list.refine'|trans }}{% if board.refined %} · {{ 'access_incidents.filters_active'|trans }}{% endif %}</summary>
                                        <form class="pp-ai-refine-form" method="get" action="{{ path('app_admin_access_rfid_logs') }}">
                        <input type="hidden" name="cause" value="{{ board.cause }}">
                        <label>{{ 'admin_emails.filter_period'|trans }}
                            <select name="days">
                                {% for value, label in periods %}
                                    <option value="{{ value }}"{{ value == board.days ? ' selected' : '' }}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label>{{ 'rfid_logs.filter_reader'|trans }}
                            <select name="reader">
                                <option value="">{{ 'admin_list.all'|trans }}</option>
                                {% for r in board.readerOptions %}
                                    <option value="{{ r.id }}"{{ r.id == board.readerId ? ' selected' : '' }}>{{ r.name }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label>{{ 'rfid_logs.filter_machine'|trans }}
                            <select name="machine">
                                <option value="">{{ 'admin_list.all'|trans }}</option>
                                {% for m in board.machineOptions %}
                                    <option value="{{ m.id }}"{{ m.id == board.machineId ? ' selected' : '' }}>{{ m.name }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <button type="submit" class="btn btn-secondary">{{ 'common.apply'|trans }}</button>
                    </form>
                </details>

                <p class="pp-ai-count-line">
                    {{ (board.cause == 'all'
                        ? (board.matching == 1 ? 'access_incidents.count_all_one' : 'access_incidents.count_all_many')
                        : (board.matching == 1 ? 'access_incidents.count_refused_one' : 'access_incidents.count_refused_many'))|trans({'%n%': board.matching}) }}
                    · {{ periods[board.days] }}{% if board.shown < board.matching %} · {{ 'access_incidents.shown'|trans({'%n%': board.shown}) }}{% endif %}
                </p>

                {% embed 'site/_data_table.html.twig' with {
                    columns: [
                        {label: 'rfid_logs.col_date'|trans, class: 'is-tight'},
                        {label: 'rfid_logs.col_badge'|trans, class: 'is-grow'},
                        {label: 'access_incidents.col_where'|trans},
                        {label: 'rfid_logs.col_result'|trans, class: 'is-tight'},
                        {label: 'rfid_logs.col_fix'|trans, class: 'is-tight'},
                    ],
                    rows: board.rows,
                    empty: (board.cause == 'todo' ? 'access_incidents.empty_todo' : 'access_incidents.empty_cause')|trans,
                } %}
                    {% block rows %}
                        {% for row in board.rows %}
                            {% set log = row.log %}
                            <tr>
                                <td>{% include 'site/_cell_date.html.twig' with {
                                    value: log.createdAt, convention: 'machine', format: 'd/m H:i',
                                } only %}</td>
                                <td>{% include 'site/_cell_title.html.twig' with {
                                    title: log.badgeUid,
                                    subtitle: log.utilisateur ? log.utilisateur.displayName : '',
                                } only %}</td>
                                <td>{% include 'site/_cell_title.html.twig' with {
                                    title: log.machine ? log.machine.nom : '',
                                    subtitle: log.reader ? log.reader.name : '',
                                } only %}</td>
                                <td>{% include 'site/_rfid_result.html.twig' with {
                                    status: log.status, authorized: log.authorized, color: log.color,
                                } only %}</td>
                                <td>{% if row.fix %}{% include 'site/_cell_fix.html.twig' with {
                                    fix: row.fix.fix, route: row.fix.route, params: row.fix.params,
                                } only %}{% else %}{% include 'site/_cell_empty.html.twig' with {reason: 'cell.nothing_to_fix'} only %}{% endif %}</td>
                            </tr>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}

                <p class="pp-ai-all">
                    <a href="{{ path('app_admin_access_rfid_logs', {vue: 'journal', days: board.days, result: board.cause == 'all' ? '' : 'no', reader: board.readerId, machine: board.machineId}) }}">{{ 'access_incidents.full_journal'|trans }}</a>
                </p>
            </div>

            <aside class="pp-ai-health" aria-labelledby="pp-ai-health-title">
                <h2 class="pp-ai-health-title" id="pp-ai-health-title">
                    {% include 'site/_icon.html.twig' with { name: 'bolt' } only %}
                    {{ 'access_incidents.health'|trans }}
                </h2>
                <div class="pp-ai-stat">
                    <b class="pp-ai-stat-n">{{ board.health.ready }}</b>
                    <div>{% include 'site/_state_chip.html.twig' with { label: 'access_incidents.online'|trans, signal: 'go' } only %}</div>
                </div>
                <div class="pp-ai-stat">
                    <b class="pp-ai-stat-n">{{ board.health.offline }}</b>
                    <div>{% include 'site/_state_chip.html.twig' with { label: 'access_incidents.offline'|trans, signal: board.health.offline > 0 ? 'stop' : 'muted' } only %}</div>
                </div>
                {% if board.health.other > 0 %}
                    <div class="pp-ai-stat">
                        <b class="pp-ai-stat-n">{{ board.health.other }}</b>
                        <div>{% include 'site/_state_chip.html.twig' with { label: 'access_incidents.to_configure'|trans, signal: 'caution' } only %}</div>
                    </div>
                {% endif %}

                {% if board.health.attention %}
                    <ul class="pp-ai-readers">
                        {% for r in board.health.attention %}
                            <li>
                                <div class="pp-ai-reader-name">
                                    <b>{{ r.name }}</b>
                                    {% if r.where %}<div class="pp-ai-reader-meta">{{ r.where }}</div>{% endif %}
                                    {% if r.lastSeen %}<div class="pp-ai-reader-meta">{{ 'access_incidents.last_seen'|trans }} {{ r.lastSeen|lab_date('d/m H:i') }}</div>{% endif %}
                                </div>
                                <div>{% include 'site/_state_chip.html.twig' with { label: r.label|trans, signal: r.signal } only %}</div>
                                <a class="pp-ai-verb" href="{{ path('app_admin_rfid_reader_show', {id: r.id}) }}">{{ 'access_incidents.open_reader'|trans }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="pp-ai-reader-meta">{{ 'access_incidents.all_respond'|trans }}</p>
                {% endif %}

                <p class="pp-ai-all"><a href="{{ path('app_admin_rfid_readers') }}">{{ 'access_incidents.all_readers'|trans }}</a></p>
            </aside>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
