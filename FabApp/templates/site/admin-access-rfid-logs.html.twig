{% extends 'base.html.twig' %}

{% block title %}{{ 'rfid_logs.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260812-s137-refine' }}">
    {# 🔴 **The whole local `<style>` is gone (S135).** It re-declared the
       `.admin-rfid-*` chrome family — a sixth page skeleton — plus `.badge-yes` /
       `.badge-no`, a `.token`, a `.migration-note` on the literals `#fffbeb` and
       `#92400e`, and an `.admin-rfid-nav a.active` on `#eef2ff` / `#3730a3`.
       Every one of those literals was a dark-mode hole. The page is on
       `_admin_list` now, so the chrome comes from admin.css and the states come
       from `_cell_state`. #}
    <style>
        .color-chip { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--color-text-light); }
        .color-dot { width: 14px; height: 14px; border: 1px solid var(--border-color); border-radius: 50%; }
        .migration-note { margin: 0 0 16px; padding: 12px 14px; border-radius: var(--border-radius); background: var(--tone-warn-soft); color: var(--tone-warn-ink); }
    </style>
{% endblock %}

{% block body %}
{# ⚠️ **Ten columns became five (S135).** The reduction was already on the
   roadmap and this is it: an RFID log line answers WHEN, WHO, WHAT, ALLOWED?
   and WHY, and it was spending ten columns doing it — badge and user apart,
   machine and reader apart, status, reason, message and LED colour each in a
   column of their own, which is 1 700 px of horizontal scroll to read one
   refusal. Nothing is dropped; the pairs are stacked as title + subtitle, which
   is the shape the users list already had.

   ⚠️ `fallbackLog` stays. When the reader columns predate their migration the
   controller hands back raw arrays instead of entities, and `log is iterable`
   is what tells the two apart. Deleting that branch would 500 the page on an
   install that has not migrated. #}
{% embed 'site/_admin_list.html.twig' with {
    hero: 'compact',
    title: 'rfid_logs.title'|trans,
    description: 'rfid_logs.subtitle'|trans,
    panel_title: 'rfid_logs.panel_title'|trans,
    panel_note: 'rfid_logs.count'|trans({'%count%': logs|length}),
    list_count: logs|length,
    list_route: 'app_admin_access_rfid_logs',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_client_filter: true,
    sidebar_variant: 'rfid',
    list_tiles_label: 'rfid_logs.col_authorized'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: logs|length, category: 'all', active: true},
        {label: 'common.yes'|trans, count: logs|filter(log => log.authorized)|length, category: 'yes'},
        {label: 'common.no'|trans, count: logs|filter(log => not log.authorized)|length, category: 'no'},
    ],
} %}
    {% block content %}
        {% if readerColumnsExist is defined and not readerColumnsExist %}
            <p class="migration-note">{{ 'rfid_logs.migration_note'|trans }}</p>
        {% endif %}
        {% embed 'site/_data_table.html.twig' with {
            columns: [
                {label: 'rfid_logs.col_date'|trans, class: 'is-tight'},
                {label: 'rfid_logs.col_badge'|trans, class: 'is-grow'},
                {label: 'rfid_logs.col_machine'|trans},
                {label: 'rfid_logs.col_authorized'|trans, class: 'is-tight'},
                {label: 'rfid_logs.col_status'|trans},
            ],
            rows: logs,
            empty: 'rfid_logs.empty'|trans,
        } %}
            {% block rows %}
                {% for log in logs %}
                    {% set fallbackLog = log is iterable %}
                    {% set user = fallbackLog ? null : log.utilisateur %}
                    {% set machine = fallbackLog ? null : log.machine %}
                    {% set reader = fallbackLog ? null : log.reader %}
                    {% set fallbackUserName = fallbackLog ? ((log.user_firstName ?? '') ~ ' ' ~ (log.user_lastName ?? ''))|trim : '' %}
                    {% set userLabel = fallbackLog
                        ? (log.user_id is defined and log.user_id ? (fallbackUserName ?: log.user_username ?: 'rfid_logs.unnamed_user'|trans) : '')
                        : (user ? user.displayName : '') %}
                    {% set machineLabel = fallbackLog
                        ? (log.machine_id is defined and log.machine_id ? log.machine_nom : '')
                        : (machine ? machine.nom : '') %}
                    <tr data-admin-list-filter-row data-admin-list-filter-category="{{ log.authorized ? 'yes' : 'no' }}">
                        <td>{% include 'site/_cell_date.html.twig' with {
                            value: log.createdAt, convention: 'machine', format: 'd/m/Y H:i:s',
                        } only %}</td>
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: log.badgeUid,
                            subtitle: userLabel,
                            media: include('site/_cell_media.html.twig', {
                                initials: userLabel ?: '?', shape: 'circle',
                            }, with_context = false),
                        } only %}</td>
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: machineLabel,
                            subtitle: reader ? reader.name : (log.readerToken|default('')),
                        } only %}</td>
                        <td>{% include 'site/_cell_state.html.twig' with {
                            label: (log.authorized ? 'common.yes' : 'common.no')|trans,
                            signal: log.authorized ? 'go' : 'stop',
                        } only %}</td>
                        {# The LED colour is what the member saw on the reader, so it stays
                           beside the outcome rather than in a column of its own. #}
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: log.status,
                            subtitle: log.reason ?? log.message ?? '',
                        } only %}{% if log.color %}<span class="color-chip"><span class="color-dot" style="background: {{ log.color }}"></span>{{ log.color }}</span>{% endif %}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
