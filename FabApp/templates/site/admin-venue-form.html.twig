{% extends 'base.html.twig' %}

{% block title %}{{ (isNew ? 'venues.action.new' : 'venues.action.edit')|trans }} - Admin FabOS{% endblock %}

{#
   ⚠️ **No local `<style>`.** Every other admin edit page carries a private
   `@media (max-width: 900px) {…}`.
   `admin.css` has covered exactly that since S85 (line ~315), so those blocks are
   dead weight that only makes the next reader think the page needs them.
#}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260822-s148b' }}">
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel admin-list-card admin-form-card">
                {% include 'site/_admin_form_head.html.twig' with {
                    title: (isNew ? 'venues.action.new' : 'venues.action.edit')|trans,
                    subtitle: isNew ? 'venues.form.new_hint'|trans : venue.name,
                    back_href: path('app_admin_venues'),
                    back_label: 'venues.back'|trans,
                } only %}
                <div class="admin-edit-panel-header">
                    <h2>{{ 'venues.form.fields'|trans }}</h2>
                </div>

                {% for message in app.flashes('error') %}<div class="admin-flash error">{{ message|flash_text }}</div>{% endfor %}

                {% if not isNew %}
                    {#  The slug is not editable, so it is shown as metadata rather than as a
                        greyed-out input pretending it might become editable. #}
                    {% include 'site/_admin_meta_grid.html.twig' with {items: [
                        {label: 'venues.field.slug'|trans, value: venue.slug},
                        {label: 'venues.column.status'|trans, value: (venue.active ? 'venues.status.active' : 'venues.status.archived')|trans},
                    ]} only %}
                {% endif %}

                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.name) }}
                        {% if isNew %}{{ form_row(form.slug) }}{% endif %}
                        {{ form_row(form.address, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.timezone) }}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_venues') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}

                {#  ⚠️ No `_admin_danger_zone` here, unlike every other edit page. A venue has
                    no delete path at all: `Machine.venueId` and `LoanableItem.venueId` are
                    `NOT NULL … ON DELETE RESTRICT`, so the database would refuse, and the
                    standing decision is archive-not-delete. Archiving lives on the list,
                    behind a screen that states its cost. #}
            </section>
        </div>
    </main>
{% endblock %}
