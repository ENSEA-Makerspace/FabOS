{% extends 'base.html.twig' %}

{#
   Maintenance : une FILE d'intervention (`MaintenanceQueue`) — tuiles À faire / En retard / Cette
   semaine / Fait, la machine, la tâche, l'échéance. « Marquer faite » est un vrai POST vers
   `app_admin_maintenance_done` (jeton CSRF `done_maintenance_<id>`). Le bouton « Ajouter une tâche »
   et « Maintenance en lot » restent dans la bande.
   ⚠️ Dans `.admin-panel`, `style.css` repeint tout <span> en gris : texte coloré/gras en <b>/<div>/<p>.
#}

{% block title %}{{ 'maintenance.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/pages.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/page-maintenance.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'maintenance.list_action'|trans,
    action_route: 'app_admin_maintenance_new',
    panel_title: 'maintenance.list_panel'|trans,
} %}
    {#- Seconde action de la bande (S147) : « Maintenance en lot » n'est liée par aucun autre gabarit. -#}
    {% block header_extra %}
        <a class="admin-hero-action" href="{{ path('app_admin_maintenance_batch') }}">{{ 'maintenance.batch_action'|trans }}</a>
    {% endblock %}
    {% block content %}

        <div class="pp-mq" data-maintenance-queue>
            <nav class="pp-mq-tiles" aria-label="{{ 'maintenance_queue.filter'|trans }}">
                {% for t in queue.tiles %}
                    <a class="pp-mq-tile{{ t.active ? ' is-active' : '' }}{{ t.signal ? ' is-' ~ t.signal : '' }}" href="{{ path('app_admin_maintenance', {tuile: t.key}) }}"{% if t.active %} aria-current="true"{% endif %}>
                        <b class="pp-mq-count">{{ t.count }}</b>
                        <div class="pp-mq-label">{{ t.label }}</div>
                    </a>
                {% endfor %}
            </nav>

            {% if queue.empty %}
                <p class="pp-mq-empty">{{ 'maintenance_queue.empty'|trans }}</p>
            {% else %}
                <div class="admin-table-wrap">
                    <table class="admin-table pp-mq-table">
                        <thead>
                            <tr><th>{{ 'adm.col_machine'|trans }}</th><th>{{ 'adm.col_task'|trans }}</th><th>{{ 'adm.col_due'|trans }}</th><th>{{ 'adm.col_status'|trans }}</th><th>{{ 'adm.col_actions'|trans }}</th></tr>
                        </thead>
                        <tbody>
                            {% for row in queue.rows %}
                                <tr>
                                    <td>
                                        {% if row.machine %}
                                            <div class="pp-mq-machine">
                                                <div class="pp-mq-thumb">
                                                    {% if row.machine.photo %}<img src="{{ row.machine.photo starts with 'http' or row.machine.photo starts with '/' ? row.machine.photo : asset(row.machine.photo) }}" alt="" loading="lazy">{% else %}{% include 'site/_icon.html.twig' with { name: 'tool' } only %}{% endif %}
                                                </div>
                                                <a class="pp-mq-link" href="{{ path('app_machine_detail', {id: row.machine.id}) }}">{{ row.machine.name }}</a>
                                            </div>
                                        {% else %}
                                            {% include 'site/_cell_empty.html.twig' only %}
                                        {% endif %}
                                    </td>
                                    <td>
                                        <b class="pp-mq-name">{{ row.title }}</b>
                                        <div class="pp-mq-meta">{{ row.type }}{% if row.recurrenceDays %} · {{ 'maintenance.every_days'|trans({'%n%': row.recurrenceDays}) }}{% endif %}</div>
                                    </td>
                                    <td>
                                        {% if row.due %}<div class="pp-mq-due">{{ row.due|date('d/m/Y') }}</div>{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}
                                        {% if row.done %}<div class="pp-mq-meta">{{ 'maintenance_queue.done_on'|trans({'%date%': row.done|date('d/m/Y')}) }}</div>{% endif %}
                                    </td>
                                    <td>{% include 'site/_state_chip.html.twig' with { label: row.state.label, signal: row.state.signal } only %}</td>
                                    <td>
                                        <div class="pp-mq-actions">
                                            {% if row.open %}
                                                {# POST + jeton CSRF `done_maintenance_<id>` : le geste vit dans `doneMaintenance()`. #}
                                                <form class="pp-mq-done" method="post" action="{{ path('app_admin_maintenance_done', {id: row.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('done_maintenance_' ~ row.id) }}">
                                                    <button type="submit" class="pp-mq-verb">{{ 'maintenance_queue.mark_done'|trans }}</button>
                                                </form>
                                            {% endif %}
                                            <a class="pp-mq-secondary" href="{{ path('app_admin_maintenance_edit', {id: row.id}) }}">{{ 'common.edit'|trans }}</a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
