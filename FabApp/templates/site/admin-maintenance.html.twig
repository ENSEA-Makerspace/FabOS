{% extends 'base.html.twig' %}

{% block title %}{{ 'maintenance.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s134h-lists' }}">
    <style>
        
        .admin-table th, .admin-table td { padding: 13px 16px; border-bottom: 1px solid var(--border-color); text-align: left; vertical-align: middle; }
        .m-status { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
        .m-status.overdue { background: color-mix(in srgb, var(--color-stop, #b91c1c) 15%, var(--theme-surface)); color: var(--color-stop, #b91c1c); }
        .m-status.due_soon { background: color-mix(in srgb, var(--color-warn) 15%, var(--theme-surface)); color: var(--color-warn); }
        .m-status.pending { background: color-mix(in srgb, var(--color-info) 15%, var(--theme-surface)); color: var(--color-info); }
        .m-status.done { background: color-mix(in srgb, var(--color-ok) 15%, var(--theme-surface)); color: var(--color-ok); }
        .m-type { font-size: 12px; color: var(--color-text-light); }
        @media (max-width: 900px) {.admin-page-header { padding: 24px 16px; }}
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'maintenance.list_title'|trans,
    description: 'maintenance.list_description'|trans,
    action_label: 'maintenance.list_action'|trans,
    action_route: 'app_admin_maintenance_new',
    panel_title: 'maintenance.list_panel'|trans,
    list_tiles_label: 'admin_list.facet_status'|trans,
    list_client_filter: true,
    list_route: 'app_admin_maintenance',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: tasks|length, category: 'all', active: true},
        {label: 'admin_list.overdue'|trans, count: tasks|filter(task => task.effectiveStatus == 'overdue')|length, category: 'overdue'},
        {label: 'admin_list.due_soon'|trans, count: tasks|filter(task => task.effectiveStatus == 'due_soon')|length, category: 'due_soon'},
        {label: 'admin_list.done'|trans, count: tasks|filter(task => task.effectiveStatus == 'done')|length, category: 'done'},
    ],
} %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: 'adm.col_task'|trans},
                    {label: 'adm.col_machine'|trans},
                    {label: 'adm.col_due'|trans},
                    {label: 'adm.col_status'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: tasks,
                empty: 'adm.maintenance_empty'|trans,
            } %}
                {% block rows %}
                    {% for task in tasks %}
                        {% set st = task.effectiveStatus %}
                        <tr data-admin-list-filter-row data-admin-list-filter-category="{{ st }}" data-admin-list-filter-row-href="{{ path('app_admin_maintenance_edit', {id: task.id}) }}">
                            <td>{{ task.title }}<div class="m-type">{{ (task.type == 'corrective' ? 'maintenance.type_corrective' : 'maintenance.type_preventive')|trans }}{% if task.recurrenceDays %} · {{ 'maintenance.every_days'|trans({'%n%': task.recurrenceDays}) }}{% endif %}</div></td>
                            <td>{{ task.machine ? task.machine.nom : '—' }}</td>
                            <td>{{ task.dueDate ? task.dueDate|date('d/m/Y') : '—' }}</td>
                            <td>
                                <span class="m-status {{ st }}">
                                    {{ st == 'done' ? 'state.done_m'|trans : (st == 'overdue' ? 'state.overdue'|trans : (st == 'due_soon' ? 'state.soon'|trans : 'state.todo_f'|trans)) }}
                                </span>
                                {% if task.doneDate %}<div style="font-size:12px;color:#6b7280;margin-top:3px;">le {{ task.doneDate|date('d/m/Y') }}</div>{% endif %}
                            </td>
                            <td><a class="admin-action" href="{{ path('app_admin_maintenance_edit', {id: task.id}) }}">{% include 'site/_icon.html.twig' with { name: 'edit' } only %} {{ 'common.edit'|trans }}</a></td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
