{% extends 'base.html.twig' %}

{% block title %}{{ 'maintenance.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s148j22' }}">
    {# S134j — `.m-status` was a FIFTH private copy of the state chip (after
       `.status-badge`, `.ml-state`, `.loan-status` and `.pill`), and `.m-type` a
       private copy of `.is-meta`. Both are `_cell_*` now and this page has no
       local CSS. The `.admin-table` padding line was a verbatim copy of the
       shared rule. #}
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'maintenance.list_action'|trans,
    action_route: 'app_admin_maintenance_new',
    panel_title: 'maintenance.list_panel'|trans,
    list_tiles_label: 'admin_list.facet_status'|trans,
    list_client_filter: true,
    panel_note: 'maintenance.panel_note'|trans({'%count%': tasks|length}),
    list_count: tasks|length,
    list_route: 'app_admin_maintenance',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: tasks|length, category: 'all', active: true},
        {label: 'admin_list.overdue'|trans, count: tasks|filter(task => task.effectiveStatus == 'overdue')|length, category: 'overdue'},
        {label: 'admin_list.due_soon'|trans, count: tasks|filter(task => task.effectiveStatus == 'due_soon')|length, category: 'due_soon'},
        {label: 'admin_list.done'|trans, count: tasks|filter(task => task.effectiveStatus == 'done')|length, category: 'done'},
    ],
} %}
    {#- ⚠️ **S147, J-18 — « Maintenance groupée » n'était liée par AUCUN gabarit.**
        La route existait, la page répondait 200, le formulaire fonctionnait, et
        personne ne pouvait y arriver sans connaître l'URL : `app_machine_ical`
        est resté orphelin une phase entière de la même façon. Le crochet
        `header_extra` est déjà le motif pour une seconde action (c'est ainsi que
        `/admin/rfid-readers` ouvre son appairage), donc rien de neuf à dessiner. -#}
    {% block header_extra %}
        <a class="admin-hero-action" href="{{ path('app_admin_maintenance_batch') }}">{{ 'maintenance.batch_action'|trans }}</a>
    {% endblock %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: 'adm.col_task'|trans},
                    {label: 'adm.col_machine'|trans},
                    {label: 'adm.col_due'|trans},
                    {label: 'adm.col_status'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: tasks,
                empty: 'adm.maintenance_empty'|trans,
            } %}
                {% block rows %}
                    {% for task in tasks %}
                        {% set st = task.effectiveStatus %}
                        <tr data-admin-list-filter-row data-admin-list-filter-category="{{ st }}" data-admin-list-filter-row-href="{{ path('app_admin_maintenance_edit', {id: task.id}) }}">
                            <td>{% include 'site/_cell_title.html.twig' with {
                                title: task.title,
                                href: path('app_admin_maintenance_edit', {id: task.id}),
                                subtitle: task.archived ? 'adm.archived'|trans : ((task.type == 'corrective' ? 'maintenance.type_corrective' : 'maintenance.type_preventive')|trans ~ (task.recurrenceDays ? ' · ' ~ 'maintenance.every_days'|trans({'%n%': task.recurrenceDays}) : '')),
                            } only %}</td>
                            <td>{% if task.machine %}{{ task.machine.nom }}{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}</td>
                            <td>{% include 'site/_cell_date.html.twig' with {value: task.dueDate, convention: 'wall', format: 'd/m/Y'} only %}</td>
                            <td>{% include 'site/_cell_state.html.twig' with {
                                label: st == 'done' ? 'state.done_m'|trans : (st == 'overdue' ? 'state.overdue'|trans : (st == 'due_soon' ? 'state.soon'|trans : 'state.todo_f'|trans)),
                                signal: st == 'done' ? 'go' : (st == 'overdue' ? 'stop' : (st == 'due_soon' ? 'caution' : 'wait')),
                            } only %}{% if task.doneDate %}<span class="cell-date-meta">{{ task.doneDate|date('d/m/Y') }}</span>{% endif %}</td>
                            <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                                actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_maintenance_edit', {id: task.id})}],
                            } only %}</td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
