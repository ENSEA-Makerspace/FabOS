{% extends 'base.html.twig' %}

{% block title %}{{ 'materials.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s135-vocabulary' }}">
    {# S134j — `.mat-thumb` is gone. It was the SAME twelve declarations in this
       file and in admin-loanable-items, and its `onerror="this.style.display='none'"`
       silently swapped a broken upload for an empty cell. `_cell_media` now, which
       sizes the box once and says "no image" out loud. #}
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'materials.list_title'|trans,
    description: 'materials.list_description'|trans,
    action_label: 'materials.list_action'|trans,
    action_route: 'app_admin_material_new',
    panel_title: 'materials.list_panel'|trans,
    list_tiles_label: 'admin_list.facet_category'|trans,
    list_client_filter: true,
    list_count: materials|length,
    list_route: 'app_admin_materials',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [{label: 'admin_list.all'|trans, count: materials|length, category: 'all', active: true}]|merge(materialCategoryTiles),
} %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: '', width: '1px'},
                    {label: 'adm.col_name'|trans},
                    {label: 'adm.col_category'|trans},
                    {label: 'adm.col_storage'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: materials,
                empty: 'adm.materials_empty'|trans,
            } %}
                {% block rows %}
                    {% for material in materials %}
                        <tr data-admin-list-filter-row data-admin-list-filter-category="{{ material.category|lower|replace({' ': '-'}) }}" data-admin-list-filter-row-href="{{ path('app_admin_material_edit', {id: material.id}) }}">
                            <td>{% include 'site/_cell_media.html.twig' with {
                                src: material.imageUrl, alt: material.name, glyph: material.icon ?: '📦',
                            } only %}</td>
                            <td>{% include 'site/_cell_title.html.twig' with {
                                title: material.name,
                                href: path('app_admin_material_edit', {id: material.id}),
                            } only %}</td>
                            <td>{{ material.category ?: '' }}</td>
                            <td>{% if material.storageLocation %}{{ material.storageLocation }}{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}</td>
                            <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                                actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_material_edit', {id: material.id})}],
                            } only %}</td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
