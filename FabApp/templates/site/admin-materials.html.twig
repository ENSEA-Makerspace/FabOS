{% extends 'base.html.twig' %}

{% block title %}Matériaux - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s132-shared' }}">
    <style>
        
        .mat-thumb { width: 34px; height: 34px; border-radius: 6px; object-fit: cover; vertical-align: middle; background: var(--color-bg-light); display: inline-flex; align-items: center; justify-content: center; font-size: 20px; }
        @media (max-width: 900px) {.admin-page-header { padding: 24px 16px; }}
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'Matériaux',
    description: 'Catalogue partagé des matériaux du FabLab (filaments, plaques, résines…).',
    action_label: 'Ajouter un matériau',
    action_route: 'app_admin_material_new',
    panel_title: 'Tous les matériaux',
    list_tools: true,
    list_client_filter: true,
    list_route: 'app_admin_materials',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [{label: 'admin_list.all'|trans, count: materials|length, category: 'all', active: true}]|merge(materialCategoryTiles),
} %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: '', width: '1px'},
                    {label: 'adm.col_name'|trans},
                    {label: 'adm.col_category'|trans},
                    {label: 'adm.col_storage'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: materials,
                empty: 'adm.materials_empty'|trans,
            } %}
                {% block rows %}
                    {% for material in materials %}
                        <tr data-admin-list-filter-row data-admin-list-filter-category="{{ material.category|lower|replace({' ': '-'}) }}" data-admin-list-filter-row-href="{{ path('app_admin_material_edit', {id: material.id}) }}">
                            <td>
                                {% if material.imageUrl %}
                                    <img class="mat-thumb" src="{{ material.imageUrl }}" alt="{{ material.name }}" onerror="this.style.display='none'">
                                {% else %}
                                    <span class="mat-thumb">{{ material.icon ?: '📦' }}</span>
                                {% endif %}
                            </td>
                            <td>{{ material.name }}</td>
                            <td>{{ material.category ?: '—' }}</td>
                            <td>{{ material.storageLocation ?: '—' }}</td>
                            <td>
                                <a class="admin-action" href="{{ path('app_admin_material_edit', {id: material.id}) }}">{% include 'site/_icon.html.twig' with { name: 'edit' } only %} {{ 'common.edit'|trans }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
