{% extends 'base.html.twig' %}

{% block title %}Matériaux - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260804-s82-lists' }}">
    <style>
        .admin-table { width: 100%; min-width: 640px; border-collapse: collapse; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 8px 11px; border-radius: 6px; border: 1px solid var(--border-color); text-decoration: none; color: var(--color-text); background: var(--theme-surface); font-weight: 700; cursor: pointer; font-size: 13px; }
        .mat-thumb { width: 34px; height: 34px; border-radius: 6px; object-fit: cover; vertical-align: middle; background: var(--color-bg-light); display: inline-flex; align-items: center; justify-content: center; font-size: 20px; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .admin-page-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
<main class="admin-page">
    <header class="admin-page-header">
        <div class="admin-page-header-inner">
            <div>
                <h1>Matériaux</h1>
                <p>Catalogue partagé des matériaux du FabLab (filaments, plaques, résines…).</p>
            </div>
            <a class="btn-link btn-primary-admin" href="{{ path('app_admin_material_new') }}">Ajouter un matériau</a>
        </div>
    </header>

    <div class="admin-layout">
        {% include 'site/_admin_sidebar.html.twig' %}
        <section class="admin-panel">
            <div class="admin-panel-header"><h2>Tous les matériaux</h2></div>
            <div>
                {% for message in app.flashes('success') %}<div class="admin-flash success">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="admin-flash error">{{ message }}</div>{% endfor %}
            </div>
            {% embed 'site/_data_table.html.twig' with {
                columns: [
                    {label: '', width: '1px'},
                    {label: 'adm.col_name'|trans},
                    {label: 'adm.col_category'|trans},
                    {label: 'adm.col_storage'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: materials,
                empty: 'adm.materials_empty'|trans,
            } %}
                {% block rows %}
                    {% for material in materials %}
                        <tr>
                            <td>
                                {% if material.imageUrl %}
                                    <img class="mat-thumb" src="{{ material.imageUrl }}" alt="{{ material.name }}" onerror="this.style.display='none'">
                                {% else %}
                                    <span class="mat-thumb">{{ material.icon ?: '📦' }}</span>
                                {% endif %}
                            </td>
                            <td>{{ material.name }}</td>
                            <td>{{ material.category ?: '—' }}</td>
                            <td>{{ material.storageLocation ?: '—' }}</td>
                            <td>
                                <div class="admin-actions">
                                    <a class="btn-action" href="{{ path('app_admin_material_edit', {id: material.id}) }}">{{ 'common.edit'|trans }}</a>
                                    {% include 'site/_admin_delete_form.html.twig' with {
                                        action: path('app_admin_material_delete', {id: material.id}),
                                        token: 'delete_material_' ~ material.id,
                                        confirm: 'adm.confirm_delete_material'|trans,
                                        label: 'common.delete'|trans,
                                    } only %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        </section>
    </div>
</main>
{% endblock %}
