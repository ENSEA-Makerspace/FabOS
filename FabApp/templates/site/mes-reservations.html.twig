{% extends 'site/base_public.html.twig' %}

{#
   MES RÉSERVATIONS — on the S59 catalogue shell.

   ⚠️ It uses the **shared** shell and the **shared** card — no card markup lives
   here. A reservation carries a cancel form, and a `<form>` inside the card's
   anchor is invalid HTML; that is why `_catalogue_card.html.twig` gained an
   `actions` block outside the anchor, and why `url` may now be empty. Both are
   extension points on the one card, not a second card: restyling stays a
   single-file job for all eight surfaces.

   ⚠️ The four states are TILES, not sections. That is S59's rule: grouping a grid
   by category leaves a group of one as a row of one, and this page routinely has
   one "en cours" and none "annulées". The tiles filter server-side, so the URL is
   shareable and there is no client-side copy of the rule to drift.

   ⚠️ Dark mode comes from `machines-list.css`, which contains **zero literal
   colours**. Do not add a hex here; take a token, or the page needs the whole S29
   dark-mode treatment again.
#}

{% block title %}{{ 'resv.title'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=20260802-s77-cardclip' }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-modern.css') ~ '?v=20260709-header-scope' }}">
{% endblock %}

{% block body %}

{#
   The undo offer, arriving as `?undo=<id>` from the cancel redirect — S47's
   cancel-with-undo, absorbed here rather than built a second time.

   ⚠️ The controller re-checked it before this renders, and the restore endpoint
   re-runs the entire booking sequence again on submit. Undo is not a status
   flip: the slot was genuinely released the moment it was cancelled, so somebody
   may have taken it in the meantime, and a restore that assumed otherwise would
   double-book a member who did nothing wrong.
#}
{% if undo is defined and undo %}
    <section class="resv-undo">
        <p>{{ 'resv.undo_prompt'|trans({'%resource%': undo.reservableLabel ?: 'resv.unit'|trans}) }}</p>
        <form method="post" action="{{ path('api_reservation_restore', {id: undo.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('restore_reservation_' ~ undo.id) }}">
            <button class="ml-btn" type="submit">{{ 'resv.act_restore'|trans }}</button>
        </form>
    </section>
{% endif %}

{% embed 'site/_catalogue.html.twig' with {
    route: 'app_my_reservations',
    title: 'resv.title'|trans,
    tiles: tiles,
    tile_all_label: 'resv.all'|trans,
    filter_key: 'etat',
    filter_value: activeState,
    search: search,
    total: totalShown,
    all: totalAll,
    unit: 'resv.unit'|trans,
    unit_plural: 'resv.unit_plural'|trans,
    show_tile_icons: false,
    reveal_after: 6,
    reveal_more_label: 'resv.see_more'|trans,
    reveal_less_label: 'resv.see_less'|trans,
    empty_text: 'resv.none_desc'|trans,
} %}

    {% block head_extra %}
        <div class="ml-head-actions">
            {% if has_calendar_layer() %}<a href="{{ path('app_calendar') }}" class="ml-btn">{{ 'resv.book_slot'|trans }}</a>{% endif %}
            <a href="{{ path('app_profile') }}" class="ml-reset">{{ 'resv.my_profile'|trans }}</a>
        </div>
    {% endblock %}


    {% block cards %}
        {% for kind, rows in groupsInOrder %}
            {% for reservation in rows %}
                {% set res = reservable(reservation) %}
                {% set resourceName = res.name ?: 'Ressource inconnue' %}

                {# Head = a fact about the BOOKING; foot = what YOU can do about it.
                   Same separation-by-position rule as the catalogue card. #}
                {% set state = reservation.declined ? 'resv.state_declined'|trans
                    : (reservation.cancelled ? 'resv.state_cancelled'|trans
                    : (reservation.pending ? 'resv.state_pending'|trans
                    : (kind == 'current' ? 'resv.state_current'|trans
                    : (kind == 'past' ? 'resv.state_past'|trans : 'resv.state_confirmed'|trans)))) %}
                {% set tone = kind == 'current' ? 'free'
                    : (kind == 'upcoming' ? (reservation.pending ? 'busy' : 'free')
                    : (kind == 'cancelled' ? 'down' : 'closed')) %}

                {# The SHARED card, not a copy of it. Everything variable is a
                   parameter; the cancel form goes in the `actions` block, which is
                   the only part a catalogue card could not already express. #}
                {% embed 'site/_catalogue_card.html.twig' with {
                    url: res.url ?: '',
                    title: resourceName,
                    type: reservation.dateDebut|date('d/m/Y'),
                    meta: reservation.dateDebut|date('H:i') ~ ' – ' ~ reservation.dateFin|date('H:i'),
                    note: reservation.motif ? 'profile.col_reason'|trans ~ ' :' : '',
                    note_strong: reservation.motif,
                    state: state,
                    state_tone: tone,
                    icon_slug: res.iconSlug|default(''),
                    action: res.url ? 'machines.see'|trans : '',
                    reservation: reservation,
                    resourceName: resourceName,
                    res: res,
                    now: now,
                } %}
                    {% block actions %}
                        {#
                           ⚠️ Every decision here was already made by BookingVerbService
                           and is only being *read*. No `reservation.dateDebut > now`
                           in this file any more: that is how the page came to hide a
                           control the endpoint would have honoured, and to hide it
                           without saying why.
                        #}
                        {% set v = verbs[reservation.id]|default({}) %}

                        {# The refusals worth screen space, deduplicated: inside the
                           lock window cancel and déplacer are refused by the same
                           rule with the same sentence, and printing it twice under
                           one card reads as a glitch rather than as a rule.
                           ⚠️ Built with `if`, not a `for` — a `{% set %}` inside a
                           Twig `for` is scoped to the loop and would be gone by the
                           time it is printed. `end_now` is absent on purpose: every
                           one of its refusals is quiet. #}
                        {% set cancelWhy = (v.cancel|default(null) and v.cancel.explain) ? v.cancel.message : '' %}
                        {% set moveWhy = (v.reschedule|default(null) and v.reschedule.explain) ? v.reschedule.message : '' %}
                        {% set notes = [] %}
                        {% if cancelWhy %}{% set notes = notes|merge([cancelWhy]) %}{% endif %}
                        {% if moveWhy and moveWhy != cancelWhy %}{% set notes = notes|merge([moveWhy]) %}{% endif %}

                        {% set canCancel = v.cancel.allowed|default(false) %}
                        {% set canMove = v.reschedule.allowed|default(false) %}
                        {% set canEnd = v.end_now.allowed|default(false) %}
                        {% set canRestore = v.restore.allowed|default(false) %}

                        {% if res.calendarUrl or canCancel or canMove or canEnd or canRestore or notes %}
                            <div class="ml-card-actions">
                                {% if res.calendarUrl %}
                                    <a class="ml-reset" href="{{ res.calendarUrl }}">{{ 'resv.see_calendar'|trans }}</a>
                                {% endif %}

                                {# "Terminer maintenant" comes first on a running booking
                                   because it is the only thing that can be done to one,
                                   and because the lab wants it pressed. It is a plain
                                   submit with no confirmation on purpose: the member is
                                   standing at the machine having just finished, and a
                                   dialog there is friction on the one action that gives
                                   the slot back early. #}
                                {% if canEnd %}
                                    <form method="post" action="{{ path('api_reservation_end_now', {id: reservation.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('end_now_reservation_' ~ reservation.id) }}">
                                        <button class="ml-btn" type="submit">{{ 'resv.act_end_now'|trans }}</button>
                                    </form>
                                {% endif %}

                                {% if canRestore %}
                                    <form method="post" action="{{ path('api_reservation_restore', {id: reservation.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('restore_reservation_' ~ reservation.id) }}">
                                        <button class="ml-btn" type="submit">{{ 'resv.act_restore'|trans }}</button>
                                    </form>
                                {% endif %}

                                {% if canCancel %}
                                    <form method="post" action="{{ path('api_reservation_cancel', {id: reservation.id}) }}"
                                          class="cancel-reservation-form"
                                          data-machine="{{ resourceName|e('html_attr') }}"
                                          data-date="{{ reservation.dateDebut|date('d/m/Y') }}"
                                          data-start="{{ reservation.dateDebut|date('H:i') }}"
                                          data-end="{{ reservation.dateFin|date('H:i') }}"
                                          data-motif="{{ (reservation.motif ?: '')|e('html_attr') }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_reservation_' ~ reservation.id) }}">
                                        <button class="ml-btn ml-btn-quiet" type="submit">{{ 'common.cancel'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>

                            {#
                               ⚠️ `<details>`, not a dialog. A fourth modal on this page
                               would be a fourth thing for S51's confirm-controller job to
                               untangle, and this one needs no script at all: it opens
                               natively, it degrades to an open form without JS, and the
                               fields are the exact `datetime-local` strings the endpoint
                               parses. ⚠️ Values printed with plain `|date` — a booking is
                               convention-B wall-clock; `|lab_date` here would prefill the
                               form with a time hours off the one on the card.
                            #}
                            {% if canMove %}
                                <details class="ml-move">
                                    <summary class="ml-btn ml-btn-quiet">{{ 'resv.act_reschedule'|trans }}</summary>
                                    <form method="post" action="{{ path('api_reservation_reschedule', {id: reservation.id}) }}" class="ml-move-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reschedule_reservation_' ~ reservation.id) }}">
                                        <p class="ml-move-hint">{{ 'resv.move_hint'|trans }}</p>
                                        <label>
                                            <span>{{ 'resv.move_start'|trans }}</span>
                                            <input type="datetime-local" name="dateDebut" required
                                                   value="{{ reservation.dateDebut|date('Y-m-d\\TH:i') }}">
                                        </label>
                                        <label>
                                            <span>{{ 'resv.move_end'|trans }}</span>
                                            <input type="datetime-local" name="dateFin" required
                                                   value="{{ reservation.dateFin|date('Y-m-d\\TH:i') }}">
                                        </label>
                                        <label>
                                            <span>{{ 'profile.col_reason'|trans }}</span>
                                            <input type="text" name="motif" maxlength="500"
                                                   value="{{ (reservation.motif ?: '')|e('html_attr') }}">
                                        </label>
                                        <button class="ml-btn" type="submit">{{ 'resv.move_confirm'|trans }}</button>
                                    </form>
                                </details>
                            {% endif %}

                            {#
                               ⚠️ The reason the control is absent, where the control
                               would have been. This page shipped with cancel rendered
                               only when it applied, so a member whose list was mostly
                               past saw no controls at all and concluded there were none
                               — an absent button and an impossible action look identical.
                               These sentences are what tells them apart, and each names
                               either the deadline that passed or the verb that does work.
                            #}
                            {% for note in notes %}
                                <p class="ml-why">{{ note }}</p>
                            {% endfor %}
                        {% endif %}
                    {% endblock %}
                {% endembed %}
            {% endfor %}
        {% endfor %}
    {% endblock %}


{% endembed %}

    <div class="booking-panel-backdrop" id="cancel-backdrop"></div>
    <section class="booking-panel cancel-confirm-panel" id="cancel-confirm-panel" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="cancel-confirm-title">
        <div class="booking-panel-header">
            <div>
                <h2 id="cancel-confirm-title">{{ 'resv.confirm_cancel'|trans }}</h2>
                <p>{{ 'resv.confirm_cancel_desc'|trans }}</p>
            </div>
            <button class="booking-panel-close" type="button" id="cancel-confirm-close" aria-label="{{ 'common.close'|trans }}">×</button>
        </div>
        <div class="cancel-confirm-body">
            <dl class="cancel-reservation-summary">
                <div><dt>{{ 'profile.col_machine'|trans }}</dt><dd id="cancel-machine">-</dd></div>
                <div><dt>{{ 'profile.col_date'|trans }}</dt><dd id="cancel-date">-</dd></div>
                <div><dt>{{ 'resv.col_schedule'|trans }}</dt><dd id="cancel-time">-</dd></div>
                <div id="cancel-motif-row"><dt>{{ 'profile.col_reason'|trans }}</dt><dd id="cancel-motif">-</dd></div>
            </dl>
            <div class="booking-form-actions">
                <button type="button" class="btn btn-secondary" id="cancel-confirm-keep">{{ 'resv.keep'|trans }}</button>
                <button type="button" class="btn btn-primary danger" id="cancel-confirm-submit">{{ 'resv.do_cancel'|trans }}</button>
            </div>
            <div class="booking-message" id="cancel-confirm-message" aria-live="polite"></div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/main.js') ~ '?v=20260801-s52' }}"></script>
    {# ⚠️ Cancellation confirmation only — the "voir plus" toggle that used to live
       here is now `reveal_controller.js`. This block stays inline for the moment
       because it guards a destructive action and folds into the shared confirm
       controller in its own change, with its own verification. #}
    <script>
        let pendingCancelForm = null;

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.cancel-reservation-form').forEach(form => form.addEventListener('submit', event => {
                event.preventDefault();
                openCancelConfirm(form);
            }));
            document.getElementById('cancel-backdrop')?.addEventListener('click', closeCancelConfirm);
            document.getElementById('cancel-confirm-close')?.addEventListener('click', closeCancelConfirm);
            document.getElementById('cancel-confirm-keep')?.addEventListener('click', closeCancelConfirm);
            document.getElementById('cancel-confirm-submit')?.addEventListener('click', () => {
                if (!pendingCancelForm) return;
                document.getElementById('cancel-confirm-message').textContent = 'Annulation en cours...';
                pendingCancelForm.submit();
            });
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape' && document.getElementById('cancel-confirm-panel')?.classList.contains('is-open')) closeCancelConfirm();
            });
        });

        function openCancelConfirm(form) {
            pendingCancelForm = form;
            document.getElementById('cancel-machine').textContent = form.dataset.machine || '-';
            document.getElementById('cancel-date').textContent = form.dataset.date || '-';
            document.getElementById('cancel-time').textContent = `${form.dataset.start || '-'} - ${form.dataset.end || '-'}`;
            document.getElementById('cancel-motif').textContent = form.dataset.motif || '-';
            document.getElementById('cancel-motif-row').style.display = form.dataset.motif ? '' : 'none';
            document.getElementById('cancel-confirm-message').textContent = '';
            document.getElementById('cancel-backdrop').classList.add('is-open');
            document.getElementById('cancel-confirm-panel').classList.add('is-open');
            document.getElementById('cancel-confirm-panel').setAttribute('aria-hidden', 'false');
            window.setTimeout(() => document.getElementById('cancel-confirm-keep')?.focus(), 80);
        }

        function closeCancelConfirm() {
            pendingCancelForm = null;
            document.getElementById('cancel-backdrop').classList.remove('is-open');
            document.getElementById('cancel-confirm-panel').classList.remove('is-open');
            document.getElementById('cancel-confirm-panel').setAttribute('aria-hidden', 'true');
        }
    </script>
{% endblock %}
