{% extends 'site/base_public.html.twig' %}

{#
   MES RÉSERVATIONS — on the S59 catalogue shell.

   ⚠️ It uses the **shared** shell and the **shared** card — no card markup lives
   here. A reservation carries a cancel form, and a `<form>` inside the card's
   anchor is invalid HTML; that is why `_catalogue_card.html.twig` gained an
   `actions` block outside the anchor, and why `url` may now be empty. Both are
   extension points on the one card, not a second card: restyling stays a
   single-file job for all eight surfaces.

   ⚠️ The four states are TILES, not sections. That is S59's rule: grouping a grid
   by category leaves a group of one as a row of one, and this page routinely has
   one "en cours" and none "annulées". The tiles filter server-side, so the URL is
   shareable and there is no client-side copy of the rule to drift.

   ⚠️ Dark mode comes from `machines-list.css`, which contains **zero literal
   colours**. Do not add a hex here; take a token, or the page needs the whole S29
   dark-mode treatment again.
#}

{% block title %}{{ 'resv.title'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=20260804-s83-surface' }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-modern.css') ~ '?v=20260812-s137-frame' }}">
{% endblock %}

{% block body %}

{#
   The undo offer, arriving as `?undo=<id>` from the cancel redirect — S47's
   cancel-with-undo, absorbed here rather than built a second time.

   ⚠️ The controller re-checked it before this renders, and the restore endpoint
   re-runs the entire booking sequence again on submit. Undo is not a status
   flip: the slot was genuinely released the moment it was cancelled, so somebody
   may have taken it in the meantime, and a restore that assumed otherwise would
   double-book a member who did nothing wrong.
#}
{% if undo is defined and undo %}
    <section class="resv-undo">
        <p>{{ 'resv.undo_prompt'|trans({'%resource%': undo.reservableLabel ?: 'resv.unit'|trans}) }}</p>
        <form method="post" action="{{ path('api_reservation_restore', {id: undo.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('restore_reservation_' ~ undo.id) }}">
            <button class="ml-btn" type="submit">{{ 'resv.act_restore'|trans }}</button>
        </form>
    </section>
{% endif %}

{% embed 'site/_catalogue.html.twig' with {
    route: 'app_my_reservations',
    title: 'resv.title'|trans,
    tiles: tiles,
    tile_all_label: 'resv.all'|trans,
    filter_key: 'etat',
    filter_value: activeState,
    search: search,
    total: totalShown,
    all: totalAll,
    unit: 'resv.unit'|trans,
    unit_plural: 'resv.unit_plural'|trans,
    show_tile_icons: false,
    reveal_after: 6,
    reveal_more_label: 'resv.see_more'|trans,
    reveal_less_label: 'resv.see_less'|trans,
    empty_text: 'resv.none_desc'|trans,
} %}

    {% block head_extra %}
        <div class="ml-head-actions">
            {% if has_calendar_layer() %}<a href="{{ path('app_calendar') }}" class="ml-btn">{{ 'resv.book_slot'|trans }}</a>{% endif %}
            <a href="{{ path('app_profile') }}" class="ml-reset">{{ 'resv.my_profile'|trans }}</a>
        </div>
    {% endblock %}


    {% block cards %}
        {% for kind, rows in groupsInOrder %}
            {% for reservation in rows %}
                {% set res = reservable(reservation) %}
                {% set resourceName = res.name ?: 'fallback.resource'|trans %}

                {# Head = a fact about the BOOKING; foot = what YOU can do about it.
                   Same separation-by-position rule as the catalogue card. #}
                {% set state = reservation.declined ? 'resv.state_declined'|trans
                    : (reservation.cancelled ? 'resv.state_cancelled'|trans
                    : (reservation.pending ? 'resv.state_pending'|trans
                    : (kind == 'current' ? 'resv.state_current'|trans
                    : (kind == 'past' ? 'resv.state_past'|trans : 'resv.state_confirmed'|trans)))) %}
                {% set tone = kind == 'current' ? 'go'
                    : (kind == 'upcoming' ? (reservation.pending ? 'wait' : 'go')
                    : (kind == 'cancelled' ? 'stop' : 'muted')) %}

                {# The SHARED card, not a copy of it. Everything variable is a
                   parameter; the cancel form goes in the `actions` block, which is
                   the only part a catalogue card could not already express. #}
                {# ⚠️ The card leads to the BOOKING, not to the machine. It used to
                   point at `res.url` — a page about a different thing, which said
                   nothing about your slot and offered nothing you could do to it. #}
                {% embed 'site/_catalogue_card.html.twig' with {
                    url: path('app_reservation_detail', {id: reservation.id}),
                    title: resourceName,
                    type: reservation.dateDebut|date('d/m/Y'),
                    meta: reservation.dateDebut|date('H:i') ~ ' – ' ~ reservation.dateFin|date('H:i'),
                    note: reservation.motif ? 'profile.col_reason'|trans ~ ' :' : '',
                    note_strong: reservation.motif,
                    state: state,
                    state_tone: tone,
                    icon_slug: res.iconSlug|default(''),
                    action: 'resv.manage'|trans,
                    reservation: reservation,
                    resourceName: resourceName,
                    res: res,
                    now: now,
                } %}
                    {% block actions %}
                        {#
                           ⚠️ **One button, not a verb row.** Cancel, Déplacer, Terminer and
                           Rétablir all live on `/reservations/{id}` now. A grid of cards each
                           carrying four controls — one of them a date form that expands in place
                           — is a wall of buttons where the member is only ever acting on one
                           booking at a time. The card's job is to get you to the right booking.
                    
                           ⚠️ Nothing is hidden by this: the whole card is a link to that page,
                           and the page explains any verb it cannot offer. The rule still lives
                           in `BookingVerbService`, asked once, on the page that acts.
                        #}
                        <div class="ml-card-actions">
                            <a class="ml-btn ml-btn-quiet" href="{{ path('app_reservation_detail', {id: reservation.id}) }}">{{ 'resv.manage'|trans }}</a>
                        </div>
                    {% endblock %}
                {% endembed %}
            {% endfor %}
        {% endfor %}
    {% endblock %}


{% endembed %}

{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
    {# ⚠️ The ~50-line cancel-confirmation `<script>` that lived here is gone with
       the verb row: cancel is on `/reservations/{id}` now, where the page itself
       is the summary the modal used to re-state, and the confirmation is
       `confirm_controller.js`. That is one of the two dialogs S51 had queued —
       retired rather than ported. #}
{% endblock %}
