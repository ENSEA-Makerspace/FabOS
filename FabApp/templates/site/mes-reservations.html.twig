{% extends 'site/base_public.html.twig' %}

{# Mes réservations : LA prochaine (ou celle en cours) en tête, le reste en lignes datées. Données : `MyReservations` + photo des machines et portes des espaces (`visuals` du contrôleur). #}

{% block title %}{{ 'resv.title'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/pages.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% if undo is defined and undo %}
    <section class="resv-undo">
        <p>{{ 'resv.undo_prompt'|trans({'%resource%': undo.reservableLabel ?: 'resv.unit'|trans}) }}</p>
        <form method="post" action="{{ path('api_reservation_restore', {id: undo.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('restore_reservation_' ~ undo.id) }}">
            <button class="ml-btn" type="submit">{{ 'resv.act_restore'|trans }}</button>
        </form>
    </section>
{% endif %}
{% set current = groupsInOrder.current|default([]) %}
{% set upcoming = groupsInOrder.upcoming|default([]) %}
{% set hero = current|first ?: (upcoming|first ?: null) %}
{% set today = 'now'|lab_date('Y-m-d') %}
{% set tomorrow = 'now'|date_modify('+1 day')|lab_date('Y-m-d') %}

<main id="main-content" tabindex="-1" class="ml-page">
    <div class="ml-wrap pp-resv">
        <header class="pp-resv-head">
            <h1>{{ 'resv.title'|trans }}</h1>
            {% if has_calendar_layer() %}<a href="{{ path('app_calendar') }}" class="ml-btn">{{ 'resv.book_slot'|trans }}</a>{% endif %}
        </header>

        {% if hero %}
            {% set res = reservable(hero) %}
            {% set day = hero.dateDebut|date('Y-m-d') %}
            {% set photo = photoOf[hero.id]|default(null) %}
            {% embed 'site/_next_card.html.twig' with {
                id: 'pp-next-title',
                media_photo: photo,
                photo_class: 'pt-photo',
                media_icon: hero.reservableType and hero.reservableType.value == 'place' ? 'map' : 'calendar',
                kicker: hero in current ? 'resv.state_current'|trans : 'resv.next_booking'|trans,
                when_strong: day == today ? 'resv.today'|trans : (day == tomorrow ? 'resv.tomorrow'|trans : hero.dateDebut|loc_date('EEEE d MMMM')|capitalize),
                when_rest: hero.dateDebut|date('H:i') ~ '–' ~ hero.dateFin|date('H:i'),
                title: res.name ?: 'fallback.resource'|trans,
                title_url: res.url,
                note: hero.motif,
                actions: [{label: 'resv.manage'|trans, url: path('app_reservation_detail', {id: hero.id})}]|merge(res.calendarUrl ? [{label: 'nav.calendar'|trans, url: res.calendarUrl, style: 'secondary'}] : []),
            } %}
                {% block main_extra %}
                    {% include 'site/_state_chip.html.twig' with { label: hero.pending ? 'resv.state_pending'|trans : 'resv.state_confirmed'|trans, signal: hero.pending ? 'wait' : 'go' } only %}
                {% endblock %}
                {% block side_before %}
                    {% if doorsOf[hero.id] is defined %}
                        <div class="pp-next-access">
                            <p class="pp-next-access-title">{% include 'site/_icon.html.twig' with { name: 'key' } only %} {{ 'resv.badge_opens'|trans }}</p>
                            <p class="pp-next-access-time">{{ hero.dateDebut|date_modify('-15 minutes')|date('H:i') }}–{{ hero.dateFin|date_modify('+15 minutes')|date('H:i') }}</p>
                            {% for door in doorsOf[hero.id] %}<p class="pp-next-door">{{ door }}</p>{% endfor %}
                        </div>
                    {% endif %}
                {% endblock %}
            {% endembed %}
        {% else %}
            {% include 'site/_cell_empty.html.twig' with {reason: 'resv.none'} only %}
        {% endif %}

        {% set sections = [
            {key: 'upcoming', title: 'resv.f_upcoming'|trans, rows: (current|slice(1)|merge(hero in current ? upcoming : upcoming|slice(1)))},
            {key: 'past', title: 'resv.f_past'|trans, rows: groupsInOrder.past|default([])},
        ] %}
        {% for section in sections %}
            {% if section.rows|length %}
                {% set isPast = section.key == 'past' %}
                {% set rowsOut = [] %}
                {% for r in section.rows|slice(0, isPast ? 5 : 50) %}
                    {% set rowsOut = rowsOut|merge([{
                        date: {day: r.dateDebut|loc_date('EEE')|capitalize, text: r.dateDebut|loc_date('d MMM')},
                        what: {small: r.dateDebut|date('H:i') ~ '–' ~ r.dateFin|date('H:i'), text: reservable(r).name ?: 'fallback.resource'|trans},
                        notes: [r.motif],
                        chip: (not isPast and r.pending) ? {label: 'resv.state_pending'|trans, signal: 'wait'} : null,
                        verb: {label: (isPast ? 'common.see'|trans : 'resv.manage'|trans), url: path('app_reservation_detail', {id: r.id})},
                    }]) %}
                {% endfor %}
                {% include 'site/_dated_rows.html.twig' with {
                    title: section.title,
                    class: isPast ? 'is-past' : '',
                    rows: rowsOut,
                    chip_column: true,
                    more: isPast and section.rows|length > 5 ? {url: path('app_my_reservations', {etat: 'past'}), label: 'resv.all_past'|trans({'%n%': section.rows|length})} : null,
                } only %}
            {% endif %}
        {% endfor %}

        {% if groupsInOrder.cancelled|default([])|length %}
            {% set rowsOut = [] %}
            {% for r in groupsInOrder.cancelled %}
                {% set rowsOut = rowsOut|merge([{
                    date: {day: r.dateDebut|loc_date('EEE')|capitalize, text: r.dateDebut|loc_date('d MMM')},
                    what: {small: r.dateDebut|date('H:i') ~ '–' ~ r.dateFin|date('H:i'), text: reservable(r).name},
                    notes: [r.motif],
                    chip: {label: r.declined ? 'resv.state_declined'|trans : 'resv.state_cancelled'|trans, signal: 'stop'},
                    verb: {label: 'common.see'|trans, url: path('app_reservation_detail', {id: r.id})},
                }]) %}
            {% endfor %}
            {% include 'site/_dated_rows.html.twig' with {
                tag: 'details',
                title: 'resv.f_cancelled'|trans ~ ' (' ~ groupsInOrder.cancelled|length ~ ')',
                class: 'is-past',
                rows: rowsOut,
            } only %}
        {% endif %}
    </div>
</main>
{% endblock %}
