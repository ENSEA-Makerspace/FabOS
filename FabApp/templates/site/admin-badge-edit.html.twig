{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_badge_form.browser_title_edit'|trans({'%badge%': badge.nom}) }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s148j22' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260822-s148d' }}">
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel admin-list-card admin-form-card">
                {% include 'site/_admin_form_head.html.twig' with {
                    title: 'admin_badge_form.title_edit'|trans,
                    subtitle: 'admin_badge_form.subtitle_edit'|trans({'%badge%': badge.nom}),
                    back_href: path('app_admin_badges'),
                    back_label: 'admin_badge_form.back'|trans,
                } only %}
                <div class="admin-edit-panel-header">
                    <h2>{{ 'admin_badge_form.panel_edit'|trans }}</h2>
                    <p>{{ 'admin_badge_form.hint_edit'|trans }}</p>
                </div>

                {% include 'site/_admin_meta_grid.html.twig' with {items: [
                    {label: 'ID', value: '#' ~ badge.id},
                    {label: 'admin_badge_form.meta_created'|trans, value: badge.createdAt|lab_date('d/m/Y H:i:s')},
                ]} only %}

                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.nom) }}
                        {{ form_row(form.icone) }}
                        {{ form_row(form.description, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.institutions, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.prerequisiteBadge) }}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_badges') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
                <form method="post" action="{{ path(badge.archived ? 'app_admin_badge_restore' : 'app_admin_badge_archive', {id: badge.id}) }}" class="admin-archive-action">
                    <input type="hidden" name="_token" value="{{ csrf_token((badge.archived ? 'restore_badge_' : 'archive_badge_') ~ badge.id) }}">
                    <button class="btn-link {{ badge.archived ? '' : 'btn-danger-admin' }}" type="submit">{{ (badge.archived ? 'admin_badge_form.restore' : 'admin_badge_form.archive')|trans }}</button>
                    <p>{{ 'admin_badge_form.archive_note'|trans }}</p>
                </form>
            </section>
        </div>
    </main>
{% endblock %}
