<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier {{ badge.nom }} - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260731-status' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        .readonly-grid { display: grid; grid-template-columns: repeat(2, minmax(160px, 1fr)); gap: 12px; padding: 16px 24px 0; }
        .readonly-item { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; }
        .readonly-label { display: block; color: #6b7280; font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 5px; }
        .readonly-value { color: #111827; overflow-wrap: anywhere; }
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid, .readonly-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Modifier un badge</h1>
                    <p>{{ badge.nom }} · relations formations et utilisateurs non modifiables ici</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_badges') }}">Retour aux badges</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>Champs modifiables</h2>
                    <p>ID, date de création et relations restent verrouillés.</p>
                </div>

                <div class="readonly-grid">
                    <div class="readonly-item"><span class="readonly-label">ID</span><span class="readonly-value">#{{ badge.id }}</span></div>
                    <div class="readonly-item"><span class="readonly-label">Créé le</span><span class="readonly-value">{{ badge.createdAt|date('d/m/Y H:i:s') }}</span></div>
                </div>

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        <div class="form-field">
                            {{ form_label(form.nom) }}
                            {{ form_widget(form.nom) }}
                            <div class="form-errors">{{ form_errors(form.nom) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.icone) }}
                            {{ form_widget(form.icone) }}
                            <div class="form-errors">{{ form_errors(form.icone) }}</div>
                        </div>
                        <div class="form-field full">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description) }}
                            <div class="form-errors">{{ form_errors(form.description) }}</div>
                        </div>
                        <div class="form-field full">
                            {{ form_label(form.institutions) }}
                            {{ form_widget(form.institutions) }}
                            <div class="form-errors">{{ form_errors(form.institutions) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.prerequisiteBadge) }}
                            {{ form_widget(form.prerequisiteBadge) }}
                            <div class="form-errors">{{ form_errors(form.prerequisiteBadge) }}</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_badges') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
</body>
</html>
