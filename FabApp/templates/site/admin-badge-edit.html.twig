<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier {{ badge.nom }} - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260802-s78-nav' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260802-s78-forms' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        {# ⚠️ The four `.readonly-*` rules that used to sit here carried four
           literal hex values and were invisible in dark mode. They now live in
           admin.css on tokens; the markup is `_admin_meta_grid.html.twig`. #}
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Modifier un badge</h1>
                    <p>{{ badge.nom }} · relations formations et utilisateurs non modifiables ici</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_badges') }}">Retour aux badges</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>Champs modifiables</h2>
                    <p>ID, date de création et relations restent verrouillés.</p>
                </div>

                {% include 'site/_admin_meta_grid.html.twig' with {items: [
                    {label: 'ID', value: '#' ~ badge.id},
                    {label: 'Créé le', value: badge.createdAt|lab_date('d/m/Y H:i:s')},
                ]} only %}

                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.nom) }}
                        {{ form_row(form.icone) }}
                        {{ form_row(form.description, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.institutions, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.prerequisiteBadge) }}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_badges') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
</body>
</html>
