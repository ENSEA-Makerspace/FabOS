{% extends 'base.html.twig' %}

{% block title %}Modération créations - Admin FabOS{% endblock %}

{% block stylesheets %}
    <style>
        .admin-page { min-height: 100vh; background: #f6f7fb; color: #1f2937; }
        .admin-page-header { background: #9E1B56; color: #fff; padding: 30px 24px; }
        .admin-page-header-inner { max-width: var(--max-width); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
        .admin-page-header h1 { margin: 0 0 6px; font-size: 30px; }
        .admin-page-header p { margin: 0; opacity: .9; }
        .admin-layout { max-width: var(--max-width); margin: 24px auto 48px; padding: 0 24px; display: grid; grid-template-columns: 260px 1fr; gap: 24px; }
        .admin-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: var(--shadow); overflow: hidden; }
        .admin-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; border-bottom: 1px solid #e5e7eb; }
        .admin-panel-header h2 { margin: 0; font-size: 22px; }
        .admin-table-wrap { overflow-x: auto; }
        .admin-table { width: 100%; min-width: 1080px; border-collapse: collapse; }
        .admin-table th, .admin-table td { padding: 14px 16px; border-bottom: 1px solid #e5e7eb; text-align: left; vertical-align: middle; }
        .admin-table th { background: #f9fafb; color: #4b5563; font-size: 13px; }
        .creation-thumb { width: 74px; height: 54px; object-fit: cover; border-radius: 6px; border: 1px solid #e5e7eb; background: #f3f4f6; }
        .admin-title-cell strong { display: block; color: #111827; margin-bottom: 3px; }
        .admin-title-cell span { color: #6b7280; font-size: 13px; overflow-wrap: anywhere; }
        .admin-rating-count { color: #6b7280; font-size: 12px; font-weight: 700; }
        .status-pill { display: inline-flex; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
        .status-pill.published { background: #dcfce7; color: #166534; }
        .status-pill.draft { background: #fef3c7; color: #92400e; }
        .admin-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 8px 11px; border-radius: 6px; border: 1px solid #d1d5db; text-decoration: none; color: #374151; background: #fff; font-weight: 700; cursor: pointer; font-size: 13px; }
        .btn-primary-admin { background: #9E1B56; border-color: #9E1B56; color: #fff; }
        .btn-danger-admin { background: #fee2e2; border-color: #fecaca; color: #991b1b; }
        .admin-flash { margin: 0 0 16px; padding: 12px 14px; border-radius: 6px; font-weight: 700; }
        .admin-flash.success { background: #dcfce7; color: #166534; }
        .admin-flash.error { background: #fee2e2; color: #991b1b; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .admin-page-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
<main class="admin-page">
    <header class="admin-page-header">
        <div class="admin-page-header-inner">
            <div>
                <h1>Modération créations</h1>
                <p>Validation rapide des créations publiées depuis la galerie leaderboard.</p>
            </div>
            <a class="btn-link btn-primary-admin" href="{{ path('app_admin_creation_new') }}">Ajouter une création</a>
        </div>
    </header>

    <div class="admin-layout">
        {% include 'site/_admin_sidebar.html.twig' %}
        <section class="admin-panel">
            <div class="admin-panel-header"><h2>Toutes les créations</h2></div>
            <div style="padding: 0 24px;">
                {% for message in app.flashes('success') %}<div class="admin-flash success">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="admin-flash error">{{ message }}</div>{% endfor %}
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>Image</th><th>Titre</th><th>Auteur</th><th>Date</th><th>Impression</th><th>Notes</th><th>Statut</th><th>Actions</th></tr></thead>
                    <tbody>
                    {% for row in creationRows %}
                        {% set creation = row.creation %}
                        <tr>
                            <td>{% include 'site/_creation_image.html.twig' with {creation: creation, class: 'creation-thumb', alt: creation.title} only %}</td>
                            <td class="admin-title-cell"><strong>{{ creation.title }}</strong><span>{{ creation.imageFilename ?: 'Aucune image' }}{% if creation.fileFilename %} · {{ creation.fileFilename }}{% endif %}</span></td>
                            <td>{{ creation.displayAuthor }}</td>
                            <td>{{ creation.createdAt|date('d/m/Y H:i') }}</td>
                            <td>{{ creation.formattedPrintDuration ?: 'Non renseigné' }}</td>
                            <td>{{ row.averageRating is not null ? row.averageRating|number_format(1, '.', ' ') ~ '/5' : 'Aucune' }}<br><span class="admin-rating-count">{{ row.ratingCount }} note{{ row.ratingCount > 1 ? 's' : '' }}</span></td>
                            <td><span class="status-pill {{ creation.published ? 'published' : 'draft' }}">{{ creation.published ? 'Publié' : 'Non publié' }}</span></td>
                            <td>
                                <div class="admin-actions">
                                    {% if creation.published %}<a class="btn-action" href="{{ path('app_leaderboard_creations') }}#creation-{{ creation.id }}">Voir</a>{% endif %}
                                    <a class="btn-action" href="{{ path('app_admin_creation_edit', {id: creation.id}) }}">Modifier</a>
                                    <form method="post" action="{{ path('app_admin_creation_toggle_published', {id: creation.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_creation_' ~ creation.id) }}">
                                        <button class="btn-action" type="submit">{{ creation.published ? 'Dépublier' : 'Publier' }}</button>
                                    </form>
                                    <form method="post" action="{{ path('app_admin_creation_delete', {id: creation.id}) }}" onsubmit="return confirm('Supprimer cette création et ses fichiers ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_creation_' ~ creation.id) }}">
                                        <button class="btn-action btn-danger-admin" type="submit">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8">Aucune création enregistrée.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
{% endblock %}
