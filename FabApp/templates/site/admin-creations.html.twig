{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_creations.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260903-rev' }}">
    <style>
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'admin_creations.action_label'|trans,
    action_route: 'app_admin_creation_new',
    panel_title: 'admin_creations.panel_title'|trans,
    list_tiles_label: 'admin_list.facet_status'|trans,
    list_client_filter: true,
    panel_note: 'admin_creations.panel_note'|trans({'count': creationRows|length}),
    list_count: creationRows|length,
    list_route: 'app_admin_creations',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: creationRows|length, category: 'all', active: true},
        {label: 'admin_list.published'|trans, count: creationRows|filter(row => row.creation.published)|length, category: 'published'},
        {label: 'admin_list.draft'|trans, count: creationRows|filter(row => not row.creation.published)|length, category: 'draft'},
    ],
} %}
    {% block content %}
            <div class="admin-table-wrap">
                {% embed 'site/_data_table.html.twig' with {
                    pin_actions: true,
                    columns: [
                        {label: 'admin_creations.col_creation'|trans, class: 'is-grow'},
                        {label: 'admin_creations.col_author'|trans},
                        {label: 'admin_creations.col_date'|trans},
                        {label: 'admin_creations.col_status'|trans},
                        {label: 'admin_creations.col_actions'|trans},
                    ],
                    rows: creationRows,
                    empty: 'admin_creations.empty'|trans,
                } %}
                    {% block rows %}
{% for row in creationRows %}
                        {% set creation = row.creation %}
                        <tr data-admin-list-filter-row data-admin-list-filter-category="{{ creation.published ? 'published' : 'draft' }}" data-admin-list-filter-row-href="{{ path('app_admin_creation_edit', {id: creation.id}) }}">
                            <td>{% include 'site/_cell_title.html.twig' with {
                                title: creation.title,
                                href: path('app_admin_creation_edit', {id: creation.id}),
                                subtitle: creation.archived ? 'adm.archived'|trans : (creation.imageFilename ?: 'admin_creations.no_image'|trans),
                                media: include('site/_creation_image.html.twig', {creation: creation, class: 'cell-media', alt: creation.title}, with_context = false),
                            } only %}</td>
                            <td>{% if creation.displayAuthor %}{{ creation.displayAuthor }}{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}</td>
                            <td>{% include 'site/_cell_date.html.twig' with {value: creation.createdAt, convention: 'machine'} only %}</td>
                            {# 🔴 `.status-pill` was a SECOND status chip with its own radius and
                               weight, on this page and nowhere else in the admin. Its own comment
                               in admin.css said so. `_cell_state` and a signal. #}
                            <td>{% include 'site/_cell_state.html.twig' with {
                                label: (creation.published ? 'admin_creations.published' : 'admin_creations.unpublished')|trans,
                                signal: creation.published ? 'go' : 'caution',
                            } only %}{% if creation.pinned %}{% include 'site/_cell_state.html.twig' with {label: 'admin_creations.pinned'|trans, signal: 'muted'} only %}{% endif %}</td>
                            <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                                actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_creation_edit', {id: creation.id})}],
                            } only %}</td>
                        </tr>
                    {% endfor %}
                    {% endblock %}
                {% endembed %}
            </div>
    {% endblock %}
{% endembed %}
{% endblock %}
