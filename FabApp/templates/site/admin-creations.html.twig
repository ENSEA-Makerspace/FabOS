{% extends 'base.html.twig' %}

{% block title %}Modération créations - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260805-s84-surfaces' }}">
    <style>
        .admin-table { width: 100%; min-width: 1080px; border-collapse: collapse; }
        .creation-thumb { width: 74px; height: 54px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-color); background: var(--color-bg-light); }
        .admin-title-cell strong { display: block; color: var(--color-text); margin-bottom: 3px; }
        .admin-title-cell span { color: var(--color-text-light); font-size: 13px; overflow-wrap: anywhere; }
        .admin-rating-count { color: var(--color-text-light); font-size: 12px; font-weight: 700; }
        .status-pill { display: inline-flex; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
        .status-pill.published { background: color-mix(in srgb, var(--color-ok) 15%, var(--theme-surface)); color: var(--color-ok); }
        .status-pill.draft { background: color-mix(in srgb, var(--color-warn) 15%, var(--theme-surface)); color: var(--color-warn); }
        .status-pill.pinned { background: color-mix(in srgb, var(--color-text-light) 15%, var(--theme-surface)); color: var(--color-text-light); margin-left: 6px; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 8px 11px; border-radius: 6px; border: 1px solid var(--border-color); text-decoration: none; color: var(--color-text); background: var(--theme-surface); font-weight: 700; cursor: pointer; font-size: 13px; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .admin-page-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'Modération créations',
    description: 'Validation rapide des créations publiées depuis la galerie leaderboard.',
    action_label: 'Ajouter une création',
    action_route: 'app_admin_creation_new',
    panel_title: 'Toutes les créations',
} %}
    {% block content %}
            <div class="admin-table-wrap">
                {% embed 'site/_data_table.html.twig' with {
                    columns: [
                        {label: 'Image'},
                        {label: 'Titre'},
                        {label: 'Auteur'},
                        {label: 'Date'},
                        {label: 'Impression'},
                        {label: 'Notes'},
                        {label: 'Statut'},
                        {label: 'Actions'},
                    ],
                    rows: creationRows,
                    empty: 'Aucune création enregistrée.',
                } %}
                    {% block rows %}
{% for row in creationRows %}
                        {% set creation = row.creation %}
                        <tr>
                            <td>{% include 'site/_creation_image.html.twig' with {creation: creation, class: 'creation-thumb', alt: creation.title} only %}</td>
                            <td class="admin-title-cell"><strong>{{ creation.title }}</strong><span>{{ creation.imageFilename ?: 'Aucune image' }}{% if creation.fileFilename %} · {{ creation.fileFilename }}{% endif %}</span></td>
                            <td>{{ creation.displayAuthor }}</td>
                            <td>{{ creation.createdAt|lab_date('d/m/Y H:i') }}</td>
                            <td>{{ creation.formattedPrintDuration ?: 'Non renseigné' }}</td>
                            <td>{{ row.averageRating is not null ? row.averageRating|number_format(1, '.', ' ') ~ '/5' : 'Aucune' }}<br><span class="admin-rating-count">{{ row.ratingCount }} note{{ row.ratingCount > 1 ? 's' : '' }}</span></td>
                            <td>
                                <span class="status-pill {{ creation.published ? 'published' : 'draft' }}">{{ creation.published ? 'Publié' : 'Non publié' }}</span>
                                {% if creation.pinned %}<span class="status-pill pinned">Épinglé</span>{% endif %}
                            </td>
                            <td>
                                <div class="admin-actions">
                                    {% if creation.published %}<a class="btn-action" href="{{ path('app_creations') }}#creation-{{ creation.id }}">Voir</a>{% endif %}
                                    <a class="btn-action" href="{{ path('app_admin_creation_edit', {id: creation.id}) }}">Modifier</a>
                                    <form method="post" action="{{ path('app_admin_creation_toggle_published', {id: creation.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_creation_' ~ creation.id) }}">
                                        <button class="btn-action" type="submit">{{ creation.published ? 'Dépublier' : 'Publier' }}</button>
                                    </form>
                                    <form method="post" action="{{ path('app_admin_creation_toggle_pinned', {id: creation.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_pinned_creation_' ~ creation.id) }}">
                                        <button class="btn-action" type="submit">{{ creation.pinned ? 'Désépingler' : 'Épingler' }}</button>
                                    </form>
                                    <form method="post" action="{{ path('app_admin_creation_delete', {id: creation.id}) }}" onsubmit="return confirm('Supprimer cette création et ses fichiers ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_creation_' ~ creation.id) }}">
                                        <button class="btn-action btn-danger-admin" type="submit">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8">Aucune création enregistrée.</td></tr>
                    {% endfor %}
                    {% endblock %}
                {% endembed %}
            </div>
    {% endblock %}
{% endembed %}
{% endblock %}
