<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Créations - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-fusion-home-rating' }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=20260709-fusion-home-rating' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body class="leaderboard-sky-page">
    <div class="alert-bar">{% include 'site/_alert_bar.html.twig' %}</div>
    <header class="site-header"><div class="header-container">
        <a href="{{ path('app_home') }}" class="header-brand"><div class="logo-ensea">{% include 'site/_logo.html.twig' %}</div></a>
        <nav class="main-navbar"><div class="navbar-container"><a href="{{ path('app_home') }}" class="navbar-link">{{ 'nav.home'|trans }}</a><a href="{{ path('app_leaderboard') }}" class="navbar-link active">{{ 'nav.leaderboard'|trans }}</a><a href="{{ path('app_leaderboard_creations') }}" class="navbar-link">{{ 'nav.projects'|trans }}</a><a href="{{ path('app_badges') }}" class="navbar-link">{{ 'nav.badges'|trans }}</a>{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_admin_dashboard') }}" class="navbar-link">{{ 'nav.admin'|trans }}</a>{% endif %}</div></nav>
        <div class="header-right"><div class="header-auth">{% include 'site/_header_auth.html.twig' %}</div></div>
    </div></header>

    <main class="leaderboard-game creations-game">
        <span class="lb-cloud lb-cloud-1"></span><span class="lb-cloud lb-cloud-2"></span><span class="lb-character lb-character-happy"></span><span class="lb-character lb-character-upside"></span>
        <section class="creation-hero">
            <div class="container creation-hero-inner">
                <div>
                    <div class="creation-hero-kicker"><div class="section-badge">Best creations</div><a class="creation-btn secondary creation-ranking-link" href="{{ path('app_leaderboard_creations_ranking') }}">Classement</a></div>
                    <h1>La galerie des légendes</h1><p>Publie ta création et tente de devenir la légende du FabLab ce mois-ci.</p>
                </div>
                {% if app.user %}<a class="creation-btn primary" href="{{ path('app_leaderboard_creation_new') }}">Publier ma création</a>{% else %}<a class="creation-btn primary" href="{{ path('app_login') }}">Se connecter pour publier</a>{% endif %}
            </div>
        </section>

        <section class="creation-gallery-section">
            <div class="container">
                {% for message in app.flashes('success') %}<div class="creation-flash success">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('warning') %}<div class="creation-flash warning">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="creation-flash error">{{ message }}</div>{% endfor %}

                {% if topRows is defined and topRows|length > 0 %}
                    <section class="top-creations" aria-labelledby="top-creations-title">
                        <div class="lb-section-heading"><h2 id="top-creations-title">Top créations</h2></div>
                        <div class="top-creations-grid">
                            {% for row in topRows %}
                                {% set creation = row.creation %}
                                <a class="top-creation" href="#creation-{{ creation.id }}">
                                    <span class="top-creation__rank">#{{ loop.index }}</span>
                                    {% include 'site/_creation_image.html.twig' with {creation: creation, class: 'top-creation__image', alt: creation.title} only %}
                                    <span class="top-creation__body"><strong>{{ creation.title }}</strong><span>{{ row.averageRating|number_format(1, '.', ' ') }}/5 · {{ row.ratingCount }} note{{ row.ratingCount > 1 ? 's' : '' }}</span></span>
                                </a>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}

                <div class="creation-sort-tabs" aria-label="Tri des créations">
                    <a class="leaderboard-type-btn {{ activeSort == 'recent' ? 'active' : '' }}" href="{{ path('app_leaderboard_creations', {sort: 'recent'}) }}">Plus récentes</a>
                    <a class="leaderboard-type-btn {{ activeSort == 'rating' ? 'active' : '' }}" href="{{ path('app_leaderboard_creations', {sort: 'rating'}) }}">Mieux notées</a>
                </div>

                <div class="creation-gallery">
                    {% for row in creationRows %}
                        {% set creation = row.creation %}
                        {% set safeFileFilename = creation.fileFilename and creation.fileFilename matches '/^[A-Za-z0-9._-]+$/' ? creation.fileFilename : null %}
                        {% set selectedRating = row.userRating is not null ? row.userRating : 0 %}
                        <article class="creation-card" id="creation-{{ creation.id }}">
                            <div class="creation-image-wrap">{% include 'site/_creation_image.html.twig' with {creation: creation, class: 'creation-image', alt: creation.title} only %}</div>
                            <div class="creation-body">
                                <div class="creation-meta"><span>{{ creation.displayAuthor }}</span><span>{{ creation.createdAt|date('d/m/Y') }}</span></div>
                                <h2>{{ creation.title }}</h2>
                                <div class="creation-stats">
                                    {% if creation.formattedPrintDuration %}<span>{{ creation.formattedPrintDuration }} d’impression</span>{% endif %}
                                    <span>Moyenne : {{ row.averageRating is not null ? row.averageRating|number_format(1, '.', ' ') ~ '/5' : 'aucune' }}</span>
                                    {% if row.ratingCount > 0 %}
                                        <button type="button" class="creation-voters-toggle" aria-expanded="false" aria-controls="voters-{{ creation.id }}" data-target="voters-{{ creation.id }}">{{ row.ratingCount }} note{{ row.ratingCount > 1 ? 's' : '' }}</button>
                                    {% else %}
                                        <span>0 note</span>
                                    {% endif %}
                                </div>
                                {% if row.voters is not empty %}
                                    <div class="creation-voters" id="voters-{{ creation.id }}" hidden>
                                        <strong class="creation-voters__title">Qui a noté</strong>
                                        <ul class="creation-voters__list">
                                            {% for voter in row.voters %}
                                                <li class="creation-voters__item"><span class="creation-voters__name">{{ voter.name }}</span><span class="creation-voters__rating">{{ voter.rating|number_format(1, '.', ' ') }}/5</span></li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% endif %}
                                <p>{{ creation.description ?: 'Création FabLab partagée par la communauté.' }}</p>

                                <div class="creation-rating-panel">
                                    {% if app.user %}
                                        <form method="post" action="{{ path('app_leaderboard_creation_vote', {id: creation.id}) }}" class="creation-rating-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('vote_creation_' ~ creation.id) }}">
                                            <input type="hidden" name="rating" value="{{ selectedRating > 0 ? selectedRating|number_format(1, '.', '') : '' }}" class="star-rating__input">
                                            <div class="star-rating" data-initial-rating="{{ selectedRating > 0 ? selectedRating|number_format(1, '.', '') : '0' }}" aria-label="Noter cette création">
                                                {% for star in 1..5 %}
                                                    <button type="button" class="star-rating__star" data-star="{{ star }}" aria-label="Noter {{ star }} étoile{{ star > 1 ? 's' : '' }}">
                                                        <span class="star-rating__base">★</span><span class="star-rating__fill">★</span>
                                                    </button>
                                                {% endfor %}
                                            </div>
                                            <div class="star-rating__status" aria-live="polite">{% if row.userRating is not null %}Ta note : {{ row.userRating|number_format(1, '.', ' ') }}/5{% else %}Sélectionne une note{% endif %}</div>
                                            <button class="creation-btn star-rating__button" type="submit">Confirmer ma note</button>
                                        </form>
                                    {% else %}
                                        <div class="star-rating star-rating--readonly" data-initial-rating="{{ row.averageRating is not null ? row.averageRating|number_format(1, '.', '') : '0' }}" aria-label="Moyenne de cette création">
                                            {% for star in 1..5 %}<span class="star-rating__star" data-star="{{ star }}"><span class="star-rating__base">★</span><span class="star-rating__fill">★</span></span>{% endfor %}
                                        </div>
                                        <a class="creation-btn star-rating__button" href="{{ path('app_login') }}">Connecte-toi pour noter</a>
                                    {% endif %}
                                </div>

                                <div class="creation-actions">
                                    {% if safeFileFilename %}<a href="{{ asset('uploads/creations/files/' ~ safeFileFilename) }}" class="creation-btn" download>Télécharger</a>{% endif %}
                                    {% if creation.externalUrl %}<a href="{{ creation.externalUrl }}" class="creation-btn secondary" target="_blank" rel="noopener noreferrer">Lien externe</a>{% endif %}
                                    {% if app.user and creation.author and app.user.id == creation.author.id %}
                                        <form method="post" action="{{ path('app_leaderboard_creation_delete', {id: creation.id}) }}" class="creation-delete-form" onsubmit="return confirm('Supprimer définitivement cette création ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_creation_' ~ creation.id) }}">
                                            <button type="submit" class="creation-btn danger">Supprimer</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        </article>
                    {% else %}
                        <div class="creation-empty">Aucune création publiée pour le moment.</div>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>
    {% include 'site/_footer.html.twig' %}
    <script>
        document.querySelectorAll('.creation-voters-toggle').forEach((toggle) => {
            const panel = document.getElementById(toggle.dataset.target);
            if (!panel) {
                return;
            }
            toggle.addEventListener('click', () => {
                const isHidden = panel.hasAttribute('hidden');
                if (isHidden) {
                    panel.removeAttribute('hidden');
                } else {
                    panel.setAttribute('hidden', '');
                }
                toggle.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
            });
        });

        document.querySelectorAll('.star-rating').forEach((ratingEl) => {
            const form = ratingEl.closest('.creation-rating-form');
            const input = form ? form.querySelector('.star-rating__input') : null;
            const status = form ? form.querySelector('.star-rating__status') : null;
            const stars = Array.from(ratingEl.querySelectorAll('.star-rating__star'));
            let selected = Number.parseFloat(ratingEl.dataset.initialRating || '0') || 0;

            const render = (value) => {
                stars.forEach((star) => {
                    const index = Number.parseInt(star.dataset.star, 10);
                    const fill = Math.max(0, Math.min(1, value - index + 1));
                    star.style.setProperty('--fill', `${fill * 100}%`);
                });
            };

            const select = (value) => {
                selected = Math.max(0.5, Math.min(5, Math.round(value * 2) / 2));
                if (input) {
                    input.value = selected.toFixed(1);
                }
                if (status) {
                    status.textContent = `Ta note : ${selected.toFixed(1)}/5`;
                }
                render(selected);
            };

            render(selected);

            if (ratingEl.classList.contains('star-rating--readonly')) {
                return;
            }

            stars.forEach((star) => {
                const pointerValue = (event) => {
                    const rect = star.getBoundingClientRect();
                    const base = Number.parseInt(star.dataset.star, 10) - 1;
                    return base + (event.clientX - rect.left <= rect.width / 2 ? 0.5 : 1);
                };

                star.addEventListener('pointermove', (event) => render(pointerValue(event)));
                star.addEventListener('click', (event) => select(pointerValue(event)));
                star.addEventListener('keydown', (event) => {
                    if (!['ArrowLeft', 'ArrowDown', 'ArrowRight', 'ArrowUp', 'Home', 'End', 'Enter', ' '].includes(event.key)) {
                        return;
                    }
                    event.preventDefault();
                    if (event.key === 'Home') select(0.5);
                    if (event.key === 'End') select(5);
                    if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') select((selected || 0.5) - 0.5);
                    if (event.key === 'ArrowRight' || event.key === 'ArrowUp') select((selected || 0) + 0.5);
                    if (event.key === 'Enter' || event.key === ' ') select(Number.parseInt(star.dataset.star, 10));
                });
            });

            ratingEl.addEventListener('pointerleave', () => render(selected));
        });
    </script>
</body>
</html>
