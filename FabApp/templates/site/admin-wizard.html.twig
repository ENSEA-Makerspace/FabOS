{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_wizard.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260827-s152d' }}">
    <style>
        .wz-intro { color: var(--color-text-light); max-width: 78ch; }
        .wz-step { border-top: 1px solid var(--border-color); margin-top: 24px; padding-top: 20px; }
        .wz-step:first-of-type { border-top: 0; margin-top: 8px; padding-top: 0; }
        .wz-step h3 { margin: 0 0 4px; font-size: 17px; }
        .wz-step h3 span { color: var(--color-text-light); font-weight: 600; margin-right: 8px; }
        .wz-step > p { color: var(--color-text-light); font-size: 13px; margin: 0 0 14px; max-width: 74ch; }
        .wz-field { margin-bottom: 14px; max-width: 560px; }
        .wz-field label { display: block; font-weight: 600; font-size: 13px; margin-bottom: 4px; }
        .wz-field input, .wz-field select { width: 100%; padding: 9px 11px; border: 1px solid var(--border-color); border-radius: 6px; background: var(--theme-input, white); color: var(--color-text); }
        .wz-field small { display: block; color: var(--color-text-light); font-size: 12px; margin-top: 4px; }
        .wz-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 26px; }
        .wz-done { border: 1px solid var(--border-color); border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; font-size: 13px; }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    {# ⚠️ S142d: the full-bleed `.admin-header` band is gone, as it is everywhere
       else. `<main class="admin-page">` is what paints the recessed ground and,
       with `display: flow-root`, what stops the grid's top margin collapsing out
       and showing 24 px of the body gradient under the site header. #}
    <main id="main-content" tabindex="-1" class="admin-page">
    <div class="admin-main-content">
        {% include 'site/_admin_sidebar.html.twig' %}
        <section class="admin-panel admin-list-card admin-form-card">
            {% include 'site/_admin_form_head.html.twig' with {
                title: 'admin_wizard.page_title'|trans,
            } only %}
            <h2>{{ 'admin_wizard.heading'|trans }}</h2>

            {% if completedAt %}
                {# Reachable again on purpose: it is a form, not a one-shot ritual. #}
                <div class="wz-done admin-status-ok">
                    {{ 'admin_wizard.already_done'|trans({'%date%': completedAt|lab_date('d/m/Y H:i')}) }}
                </div>
            {% endif %}

            <p class="wz-intro">{{ 'admin_wizard.intro'|trans|raw }}</p>

            {{ form_start(wizardForm) }}
                {% form_theme wizardForm 'form/admin_theme.html.twig' %}

                <div class="wz-step">
                    <h3><span>1.</span>{{ 'admin_wizard.step1_title'|trans }}</h3>
                    <p>{{ 'admin_wizard.step1_help'|trans }}</p>
                    {{ form_row(wizardForm.org_name) }}
                    {{ form_row(wizardForm.venue_label) }}
                </div>

                <div class="wz-step">
                    <h3><span>2.</span>{{ 'admin_wizard.step2_title'|trans }}</h3>
                    {# This one is worth its own step: without it mail carries no link
                       at all, and a ticket carries no QR code. It is the single most
                       consequential empty setting on a new install. #}
                    <p>{{ 'admin_wizard.step2_help'|trans|raw }}</p>
                    {{ form_row(wizardForm.public_base_url) }}
                </div>

                <div class="wz-step">
                    <h3><span>3.</span>{{ 'admin_wizard.step3_title'|trans }}</h3>
                    <p>{{ 'admin_wizard.step3_help'|trans }}</p>
                    {{ form_row(wizardForm.lab_address) }}
                    {{ form_row(wizardForm.timezone) }}
                    {{ form_row(wizardForm.default_locale) }}
                </div>

                <div class="wz-step">
                    <h3><span>4.</span>{{ 'admin_wizard.step4_title'|trans }}</h3>
                    {# Deliberately a link, not a copy of the feature screen: two places
                       to switch the same thing on is how they drift apart. #}
                    {# The anchor lives inside the catalogue value: its text is part of
                       the sentence, and a language that puts the link elsewhere needs to
                       be able to move it. Only the href is passed in. #}
                    <p>{{ 'admin_wizard.step4_help'|trans({'%url%': path('app_admin_features')})|raw }}</p>
                    <p>{{ 'admin_wizard.step4_next'|trans({'%url%': path('app_admin_setup')})|raw }}</p>
                </div>

                <div class="wz-actions">
                    <button type="submit" class="btn btn-primary btn-small">{{ 'admin_wizard.save'|trans }}</button>
                    <button type="submit" name="action" value="skip" class="btn btn-secondary btn-small">{{ 'admin_wizard.skip'|trans }}</button>
                </div>
            {{ form_end(wizardForm) }}
        </section>
    </div>
    </main>
{% endblock %}

