{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_homepage.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260816-s139e' }}">
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260812-s138-brace' }}">
    <style>

        .homepage-form { display: flex; flex-direction: column; gap: var(--spacing-lg); }
        .homepage-table .role-cell { text-align: center; }
        .homepage-table input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--color-primary); }
        .order-input { width: 90px; }
        .section-key { display: block; color: var(--color-text-light); font-size: var(--font-size-sm); margin-top: 4px; }
        .alert { padding: var(--spacing-md); border-radius: var(--border-radius-sm); margin-bottom: var(--spacing-md); }
        .alert-success { background: #e8f5e9; color: #2e7d32; }
        .admin-actions { display: flex; justify-content: flex-end; gap: var(--spacing-md); }
        @media (max-width: 900px) {.homepage-table { min-width: 760px; } .admin-panel { overflow-x: auto; }}
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}

    <section class="admin-header">
        <div class="admin-header-content">
            <h1>{{ 'admin_homepage.title'|trans }}</h1>
            <p>{{ 'admin_homepage.subtitle'|trans }}</p>
        </div>
    </section>

    <main class="admin-main-content">
        {% include 'site/_admin_sidebar.html.twig' %}

        <div class="admin-column">
        <section class="admin-panel">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            <h2>{{ 'admin_homepage.panel_title'|trans }}</h2>
            <form method="post" action="{{ path('app_admin_homepage') }}" class="homepage-form">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_homepage') }}">
                {% embed 'site/_data_table.html.twig' with {
                    columns: [
                        {label: 'admin_homepage.col_block'|trans},
                        {label: 'admin_homepage.col_anonymous'|trans},
                        {label: 'admin_homepage.col_user'|trans},
                        {label: 'admin_homepage.col_staff'|trans},
                        {label: 'admin_homepage.col_admin'|trans},
                        {label: 'admin_homepage.col_order'|trans},
                    ],
                    rows: sections,
                    empty: 'admin_homepage.empty'|trans,
                } %}
                    {% block rows %}
                    {% for section in sections %}
                        <tr>
                            <td>
                                <strong>{{ section.label }}</strong>
                                <span class="section-key">{{ section.sectionKey }}</span>
                            </td>
                            <td class="role-cell">
                                <input type="checkbox" name="sections[{{ section.sectionKey }}][visibleAnonymous]" value="1" aria-label="{{ 'admin_homepage.aria_anonymous'|trans({'%block%': section.label}) }}" {% if section.visibleAnonymous %}checked{% endif %}>
                            </td>
                            <td class="role-cell">
                                <input type="checkbox" name="sections[{{ section.sectionKey }}][visibleUser]" value="1" aria-label="{{ 'admin_homepage.aria_user'|trans({'%block%': section.label}) }}" {% if section.visibleUser %}checked{% endif %}>
                            </td>
                            {% if showStaffColumn %}
                                <td class="role-cell">
                                    <input type="checkbox" name="sections[{{ section.sectionKey }}][visibleStaff]" value="1" aria-label="{{ 'admin_homepage.aria_staff'|trans({'%block%': section.label}) }}" {% if section.visibleStaff %}checked{% endif %}>
                                </td>
                            {% endif %}
                            <td class="role-cell">
                                <input type="checkbox" name="sections[{{ section.sectionKey }}][visibleAdmin]" value="1" aria-label="{{ 'admin_homepage.aria_admin'|trans({'%block%': section.label}) }}" {% if section.visibleAdmin %}checked{% endif %}>
                            </td>
                            <td>
                                <input class="filter-input order-input" type="number" name="sections[{{ section.sectionKey }}][sortOrder]" value="{{ section.sortOrder }}" step="1">
                            </td>
                        </tr>
                    {% endfor %}
                    {% endblock %}
                {% endembed %}
                <div class="admin-actions">
                    <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary">{{ 'common.cancel'|trans }}</a>
                    <button type="submit" class="btn btn-primary">{{ 'admin_homepage.save'|trans }}</button>
                </div>
            </form>
        </section>
        </div>
    </main>
{% endblock %}
