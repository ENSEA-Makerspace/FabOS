{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   S84 — the list is a `_data_table` now and the inline block is gone. It was
   the biggest of the five at 460 lines, and it contained: page chrome S82
   unwound, a `.admin-panel` copy that **overrode S83's ground and lift**, a
   complete modal (overlay, header, body, footer, its own form controls and a
   keyframe animation) for a dialog **that is not in this page's markup and has
   not been for some time**, and a 12-track `grid-template-columns` with a
   `min-width: 1760px`.

   🔴 Found by the conversion: the status cell was `class="status-badge
   disponible"` **hardcoded**, so a machine in `panne` or `maintenance` printed
   its real word inside a green chip. The class comes off the value now. #}

{% block title %}Gestion des Machines - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s129-venues' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'Gestion des Machines',
    description: 'Gérez toutes les machines du FabLab',
    action_label: 'Créer une machine',
    action_route: 'app_admin_machine_new',
    panel_title: 'Liste des machines',
    panel_note: machines|length ~ ' machine' ~ (machines|length > 1 ? 's' : ''),
    list_tools: true,
    list_route: 'app_admin_machines',
    list_search: filters.q|default(''),
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_query: machineListQuery|merge({location: venueContext.location}),
    venue_context: venueContext,
    list_tiles_preserve_query: false,
    list_tiles: machineCategoryTiles,
    list_tile_groups: [{label: 'adm.col_status'|trans, preserve_query: false, tiles: machineStatusTiles}],
    has_advanced_filters: true,
} %}
    {% block advanced_filters %}
        <form class="ml-filters" method="get" action="{{ path('app_admin_machines') }}">
            <input type="hidden" name="location" value="{{ venueContext.location }}">
            <div class="ml-field"><label for="machine-level">{{ 'workspace.filter.niveau'|trans }}</label><input id="machine-level" name="niveau" value="{{ filters.niveau }}"></div>
            <div class="ml-field"><label for="machine-badge">{{ 'workspace.filter.badge'|trans }}</label><select id="machine-badge" name="badge"><option value="">—</option>{% for badge in availableBadges %}<option value="{{ badge.id }}"{{ filters.badge == badge.id ? ' selected' : '' }}>{{ badge.nom }}</option>{% endfor %}</select></div>
            <button class="ml-btn" type="submit">{{ 'common.confirm'|trans }}</button>
        </form>
    {% endblock %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'Nom', class: 'is-grow'},
                {label: 'Localisation', class: 'is-tight'},
                {label: 'Statut', class: 'is-tight'},
                {label: 'Dernière autorisation', class: 'is-tight'},
                {label: 'Actions', class: 'is-actions'},
            ],
            rows: machines,
            empty: 'Aucune machine trouvée.',
        } %}
            {% block rows %}
                {% for machine in machines %}
                    <tr data-admin-list-filter-row data-admin-list-filter-row-href="{{ path('app_admin_machine_edit', {id: machine.id}) }}">
                        <td><a href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ machine.nom }}</a></td>
                        <td>{{ machine.localisation ?? '-' }}</td>
                        {# 🔴 Was `status-badge disponible` whatever the value. #}
                        <td><span class="status-badge {{ (machine.statut ?? '')|lower|replace({' ': '-', '_': '-'}) }}">{{ machine.statut }}</span></td>
                        <td>{{ machine.lastAuthorizationTime ? machine.lastAuthorizationTime|lab_date('d/m/Y H:i:s') : '-' }}</td>
                        <td class="is-actions"><a class="admin-action" href="{{ path('app_admin_machine_edit', {id: machine.id}) }}">{% include 'site/_icon.html.twig' with { name: 'edit' } only %} Modifier</a></td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
