{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   S84 — the list is a `_data_table` now and the inline block is gone. It was
   the biggest of the five at 460 lines, and it contained: page chrome S82
   unwound, a `.admin-panel` copy that **overrode S83's ground and lift**, a
   complete modal (overlay, header, body, footer, its own form controls and a
   keyframe animation) for a dialog **that is not in this page's markup and has
   not been for some time**, and a 12-track `grid-template-columns` with a
   `min-width: 1760px`.

   🔴 Found by the conversion: the status cell was `class="status-badge
   disponible"` **hardcoded**, so a machine in `panne` or `maintenance` printed
   its real word inside a green chip. The class comes off the value now. #}

{% block title %}{{ 'admin_machines.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260812-s137-frame2' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
{% endblock %}

{% block body %}
{# S134h — the format allows exactly ONE tile row, for the facet that defines the
   page. A machines list is about what the machines ARE, so category keeps the
   row; status, level and badge become "Affiner" menus. A refine field passing
   `tiles:` rather than `options:` reuses `machineStatusTiles` unchanged — the
   counts come along and the controller did not have to learn a second shape.

   ⚠️ The counts and the "3 sur 11" line read `machineCount`, the venue-scoped
   list BEFORE filtering.

   ⚠️ These notes live above the embed, not inside it: a Twig comment placed
   between two keys of an argument hash is a syntax error, and it is the same
   trap that has broken this file's deploy before. #}
{% embed 'site/_admin_list.html.twig' with {
    hero: 'compact',
    title: 'admin_machines.title'|trans,
    description: 'admin_machines.description'|trans,
    action_label: 'admin_machines.action_label'|trans,
    action_route: 'app_admin_machine_new',
    panel_title: 'admin_machines.panel_title'|trans,
    panel_note: 'admin_machines.panel_note'|trans({'%count%': machines|length}),
    list_count: machines|length,
    list_total: machineCount,
    list_route: 'app_admin_machines',
    list_search: filters.q|default(''),
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_query: machineListQuery|merge({location: venueContext.location}),
    venue_context: venueContext,
    list_tiles_label: 'admin_list.facet_category'|trans,
    list_tiles: machineCategoryTiles,
    list_refine: [
        {name: 'statut', label: 'admin_list.facet_status'|trans, value: filters.statut, tiles: machineStatusTiles},
        {name: 'niveau', label: 'workspace.filter.niveau'|trans, value: filters.niveau, options: [
            {value: '', label: 'admin_list.all'|trans},
            {value: '1', label: 'machines.level1'|trans},
            {value: '2', label: 'machines.level2'|trans},
            {value: '3', label: 'machines.level3'|trans},
        ]},
        {name: 'badge', label: 'workspace.filter.badge'|trans, value: filters.badge, options: [{value: '', label: 'admin_list.all'|trans}]|merge(availableBadges|map(badge => {value: badge.id, label: badge.nom}))},
    ],
} %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'admin_machines.col_name'|trans, class: 'is-grow'},
                {label: 'admin_machines.col_location'|trans, class: 'is-tight'},
                {label: 'admin_machines.col_status'|trans, class: 'is-tight'},
                {label: 'admin_machines.col_last_auth'|trans, class: 'is-tight'},
                {label: 'admin_machines.col_actions'|trans, class: 'is-actions'},
            ],
            rows: machines,
            empty: 'admin_machines.empty'|trans,
        } %}
            {% block rows %}
                {% for machine in machines %}
                    <tr data-admin-list-filter-row data-admin-list-filter-row-href="{{ path('app_admin_machine_edit', {id: machine.id}) }}">
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: machine.nom,
                            href: path('app_machine_detail', {id: machine.id}),
                            subtitle: machine.categoryLabel|default(''),
                        } only %}</td>
                        <td>{% if machine.localisation %}{{ machine.localisation }}{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}</td>
                        {# 🔴 Was `status-badge disponible` whatever the value (S84), and
                           then printed the stored word itself: `disponible` and `idle`
                           side by side on the same French page. `Machine::getStatusKey()`
                           is the one mapping now — see the entity. #}
                        {% set statusKey = machine.statusKey %}
                        <td>{% include 'site/_cell_state.html.twig' with {
                            label: statusKey|trans,
                            signal: statusKey == 'machines.st_available' ? 'go' : (statusKey == 'machines.st_maintenance' ? 'caution' : 'stop'),
                        } only %}</td>
                        <td>{% include 'site/_cell_date.html.twig' with {
                            value: machine.lastAuthorizationTime, convention: 'machine', format: 'd/m/Y H:i',
                        } only %}</td>
                        <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                            actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_machine_edit', {id: machine.id})}],
                        } only %}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
