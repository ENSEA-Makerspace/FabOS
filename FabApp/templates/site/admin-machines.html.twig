<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Machines - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260731-status' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        .admin-page-header {
            background: linear-gradient(135deg, #9E1B56 0%, #7a1542 100%);
            color: white;
            padding: var(--spacing-xl) 0;
            margin-bottom: var(--spacing-xl);
        }
        
        .admin-page-header-content {
            max-width: var(--max-width);
            margin: 0 auto;
            padding: 0 var(--spacing-lg);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-lg);
        }
        
        .admin-page-title h1 {
            font-size: var(--font-size-3xl);
            margin-bottom: var(--spacing-sm);
        }
        
        .admin-page-title p {
            opacity: 0.9;
        }
        
        .admin-page-actions {
            display: flex;
            gap: var(--spacing-sm);
        }
        
        .admin-main {
            max-width: var(--max-width);
            margin: 0 auto var(--spacing-xl);
            padding: 0 var(--spacing-lg);
        }
        
        .admin-content-grid {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: var(--spacing-xl);
        }
        
        .admin-sidebar {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            height: fit-content;
        }
        
        .admin-sidebar h3 {
            font-size: var(--font-size-lg);
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: var(--spacing-lg);
            padding-bottom: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-nav {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-xs);
        }
        
        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            padding: var(--spacing-md);
            color: var(--color-text);
            text-decoration: none;
            border-radius: var(--border-radius-sm);
            transition: all var(--transition);
            font-weight: 500;
        }
        
        .admin-nav-link:hover {
            background: var(--color-bg-light);
            color: var(--color-primary);
        }
        
        .admin-nav-link.active {
            background: var(--color-primary);
            color: white;
        }
        
        .admin-nav-link svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }
        
        .admin-main-content {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-lg);
        }
        
        .admin-panel {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-xl);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
        }
        
        .admin-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-lg);
            padding-bottom: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-panel-header h2 {
            font-size: var(--font-size-xl);
            font-weight: 600;
            color: var(--color-text);
        }
        
        .filters-bar {
            display: flex;
            gap: var(--spacing-lg);
            flex-wrap: wrap;
            margin-bottom: var(--spacing-lg);
        }
        
        .filter-group {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }
        
        .filter-group label {
            font-size: var(--font-size-sm);
            font-weight: 500;
            color: var(--color-text);
        }
        
        .filter-select {
            padding: var(--spacing-sm) var(--spacing-md);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: var(--font-size-base);
            background: white;
            cursor: pointer;
        }
        
        .filter-input {
            width: 200px;
            padding: var(--spacing-sm) var(--spacing-md);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: var(--font-size-base);
        }
        
        .machines-list-container {
            overflow-x: auto;
        }

        .machines-list {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .machine-list-row {
            display: grid;
            grid-template-columns: 40px 200px 150px 120px 120px 100px;
            align-items: center;
            padding: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
            transition: background var(--transition);
        }

        .machine-list-row:hover {
            background: var(--color-bg-light);
        }

        .machine-list-row.header {
            background: var(--color-bg-light);
            font-weight: 600;
            font-size: var(--font-size-sm);
        }

        .machine-list-cell {
            padding: var(--spacing-xs) var(--spacing-sm);
            font-size: var(--font-size-sm);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .machine-list-row.machine-db-row {
            grid-template-columns: 70px 190px 220px 120px 110px 130px 180px 150px 150px 150px 170px 120px;
            min-width: 1760px;
        }

        .machine-readonly-note {
            color: var(--color-text-light);
            font-size: var(--font-size-sm);
        }

        .machine-list-cell.checkbox {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .machine-list-cell.checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--color-primary);
        }

        .machine-list-cell.name {
            font-weight: 600;
        }

        .machine-list-cell.category {
            display: flex;
            align-items: center;
        }

        .category-badge {
            display: inline-block;
            padding: 2px 8px;
            background: rgba(158, 27, 86, 0.1);
            color: var(--color-primary);
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
        }

        .machine-list-cell.actions {
            display: flex;
            justify-content: flex-end;
        }

        .action-buttons {
            display: flex;
            gap: var(--spacing-xs);
        }

        .action-btn {
            padding: 4px 10px;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            background: white;
            cursor: pointer;
            font-size: 11px;
            transition: all var(--transition);
        }

        .action-btn:hover {
            background: var(--color-bg-light);
        }

        .action-btn.edit:hover {
            background: rgba(33, 150, 243, 0.1);
            color: #2196F3;
            border-color: #2196F3;
        }

        .action-btn.delete:hover {
            background: rgba(244, 67, 54, 0.1);
            color: #F44336;
            border-color: #F44336;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }

        .status-badge.disponible {
            background: rgba(76, 175, 80, 0.1);
            color: #4CAF50;
        }

        .status-badge.maintenance {
            background: rgba(255, 152, 0, 0.2);
            color: #FF9800;
        }

        .status-badge.panne {
            background: rgba(244, 67, 54, 0.1);
            color: #F44336;
        }

        .status-badge.hors-service {
            background: rgba(158, 27, 86, 0.1);
            color: #9E1B56;
        }

        .machines-list-header {
            position: sticky;
            top: 0;
            z-index: 10;
            background: var(--color-text-inverse);
        }

        .bulk-actions {
            display: flex;
            gap: var(--spacing-sm);
            flex-wrap: wrap;
        }

        .btn-danger {
            background: #F44336;
            color: white;
            border: none;
        }

        .btn-danger:hover {
            background: #d32f2f;
        }

        .btn-sm {
            padding: var(--spacing-xs) var(--spacing-sm);
            font-size: var(--font-size-sm);
        }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: var(--spacing-xs);
            padding: var(--spacing-lg) 0;
        }

        .pagination-link {
            min-width: 36px;
            height: 36px;
            padding: 0 var(--spacing-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
            text-decoration: none;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            transition: all var(--transition);
        }

        .pagination-link:hover {
            background: var(--color-bg-light);
            color: var(--color-primary);
        }

        .pagination-link.active {
            background: var(--color-primary);
            border-color: var(--color-primary);
            color: white;
        }
        
        /* Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }
        
        .modal-overlay.active {
            display: flex;
        }
        
        .modal {
            background: white;
            border-radius: var(--border-radius);
            width: 100%;
            max-width: 700px;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: var(--shadow-lg);
            animation: modalSlideIn 0.3s ease;
        }
        
        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--spacing-xl);
            border-bottom: 1px solid var(--border-color);
        }
        
        .modal-header h2 {
            font-size: var(--font-size-xl);
            font-weight: 600;
        }
        
        .modal-close {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 24px;
            color: var(--color-text-light);
        }
        
        .modal-body {
            padding: var(--spacing-xl);
        }
        
        .form-group-modal {
            margin-bottom: var(--spacing-lg);
        }
        
        .form-label-modal {
            display: block;
            font-size: var(--font-size-base);
            font-weight: 500;
            color: var(--color-text);
            margin-bottom: var(--spacing-xs);
        }
        
        .form-input-modal {
            width: 100%;
            padding: var(--spacing-sm) var(--spacing-md);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: var(--font-size-base);
            margin-bottom: var(--spacing-sm);
        }
        
        .form-row-modal {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-md);
        }
        
        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: var(--spacing-sm);
            padding: var(--spacing-xl);
            border-top: 1px solid var(--border-color);
        }
        
        /* Responsive */
        @media (max-width: 992px) {
            .admin-content-grid {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 768px) {
            .admin-page-header-content {
                flex-direction: column;
                text-align: center;
            }
            
            .filters-bar {
                flex-direction: column;
                align-items: stretch;
            }
            
            .filter-input {
                width: 100%;
            }
            
            .form-row-modal {
                grid-template-columns: 1fr;
            }
            
            .machine-list-row {
                grid-template-columns: 40px 150px 100px 100px 80px 80px;
            }
        }
    </style>
</head>
<body>
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    {% include 'site/_logo.html.twig' %}
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">{{ 'nav.home'|trans }}</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">{{ 'nav.calendar'|trans }}</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link active">{{ 'nav.machines'|trans }}</a>
                    {% if feature_enabled('formations') %}<a href="{{ path('app_formations') }}" class="navbar-link">{{ 'nav.trainings'|trans }}</a>{% endif %}
                    {% if feature_enabled('leaderboard') %}<a href="{{ path('app_leaderboard') }}" class="navbar-link">{{ 'nav.leaderboard'|trans }}</a>{% endif %}{% if feature_enabled('projects') %}<a href="{{ path('app_creations') }}" class="navbar-link">{{ 'nav.projects'|trans }}</a>{% endif %}{% if feature_enabled('badges') %}<a href="{{ path('app_badges') }}" class="navbar-link">{{ 'nav.badges'|trans }}</a>{% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <main class="main-content">
        <section class="admin-page-header">
            <div class="admin-page-header-content">
                <div class="admin-page-title">
                    <h1>Gestion des Machines</h1>
                    <p>Gérez toutes les machines du FabLab</p>
                </div>
                <div class="admin-page-actions">
                    <a class="btn btn-primary" href="{{ path('app_admin_machine_new') }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Créer une machine
                    </a>
                    <span class="status-badge disponible">Edition admin active</span>
                </div>
            </div>
        </section>

        <div class="admin-main">
            <div class="admin-content-grid">
                {% include 'site/_admin_sidebar.html.twig' %}

                <div class="admin-main-content">
                    <div class="admin-panel">
                        <div class="admin-panel-header">
                            <h2>Liste des machines</h2>
                            <div class="bulk-actions">
                                <span class="machine-readonly-note">Données chargées depuis MariaDB</span>
                            </div>
                        </div>
                        {% for message in app.flashes('success') %}
                            <div style="margin-top: 12px; padding: 12px 14px; border-radius: 6px; background: rgba(76, 175, 80, 0.12); color: #256029; font-weight: 600;">{{ message }}</div>
                        {% endfor %}
                        {% for message in app.flashes('warning') %}
                            <div style="margin-top: 12px; padding: 12px 14px; border-radius: 6px; background: #fff7ed; color: #9a3412; font-weight: 600;">{{ message }}</div>
                        {% endfor %}
                        <form class="filters-bar" method="get" action="{{ path('app_admin_machines') }}" style="margin-top: 18px;">
                            <div class="filter-group"><label for="machine-q">Rechercher:</label><input type="search" name="q" id="machine-q" class="filter-input" placeholder="Nom, description, token, catégorie" value="{{ filters.q|default('') }}"></div>
                            <div class="filter-group"><label for="machine-statut">Statut:</label><input type="text" name="statut" id="machine-statut" class="filter-input" placeholder="disponible, idle..." value="{{ filters.statut|default('') }}"></div>
                            <div class="filter-group"><label for="machine-niveau">Niveau:</label><select name="niveau" id="machine-niveau" class="filter-select"><option value="all">Tous</option>{% for level in 1..3 %}<option value="{{ level }}" {{ filters.niveau|default('') == level ? 'selected' : '' }}>Niveau {{ level }}</option>{% endfor %}</select></div>
                            <div class="filter-group"><label for="machine-badge">Badge:</label><select name="badge" id="machine-badge" class="filter-select"><option value="all">Tous</option>{% for badge in availableBadges|default([]) %}<option value="{{ badge.id }}" {{ filters.badge|default('') == badge.id ? 'selected' : '' }}>{{ badge.nom }}</option>{% endfor %}</select></div>
                            <button class="btn btn-secondary btn-small" type="submit">Filtrer</button><a class="btn btn-secondary btn-small" href="{{ path('app_admin_machines') }}">Réinitialiser</a>
                        </form>
                    </div>

                    <div class="admin-panel">
                        <div class="machines-list-container">
                            <div class="machines-list-header">
                                <div class="machine-list-row machine-db-row header">
                                    <div class="machine-list-cell">ID</div>
                                    <div class="machine-list-cell">Nom</div>
                                    <div class="machine-list-cell">Description</div>
                                    <div class="machine-list-cell">Localisation</div>
                                    <div class="machine-list-cell">Statut</div>
                                    <div class="machine-list-cell">Granularité</div>
                                    <div class="machine-list-cell">Limite réservations</div>
                                    <div class="machine-list-cell">Token</div>
                                    <div class="machine-list-cell">Créée le</div>
                                    <div class="machine-list-cell">Mise à jour</div>
                                    <div class="machine-list-cell">Dernière autorisation</div>
                                    <div class="machine-list-cell">Actions</div>
                                </div>
                            </div>
                            <div class="machines-list">
                                {% for machine in machines %}
                                    <div class="machine-list-row machine-db-row">
                                        <div class="machine-list-cell">#{{ machine.id }}</div>
                                        <div class="machine-list-cell"><a href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ machine.nom }}</a></div>
                                        <div class="machine-list-cell" title="{{ machine.description ?? '' }}">{{ machine.description ?? '-' }}</div>
                                        <div class="machine-list-cell">{{ machine.localisation ?? '-' }}</div>
                                        <div class="machine-list-cell"><span class="status-badge disponible">{{ machine.statut }}</span></div>
                                        <div class="machine-list-cell">{{ machine.granulariteMinutes }}</div>
                                        <div class="machine-list-cell">{{ machine.limiteReservations }}</div>
                                        <div class="machine-list-cell">{{ machine.machineToken }}</div>
                                        <div class="machine-list-cell">{{ machine.createdAt|date('d/m/Y H:i:s') }}</div>
                                        <div class="machine-list-cell">{{ machine.updated|date('d/m/Y H:i:s') }}</div>
                                        <div class="machine-list-cell">{{ machine.lastAuthorizationTime ? machine.lastAuthorizationTime|date('d/m/Y H:i:s') : '-' }}</div>
                                        <div class="machine-list-cell actions"><a class="action-btn edit" href="{{ path('app_admin_machine_edit', {id: machine.id}) }}">Modifier</a></div>
                                    </div>
                                {% else %}
                                    <div class="machine-list-row machine-db-row"><div class="machine-list-cell">Aucune machine trouvée.</div></div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-section">
                <div class="footer-logo">
                    <span class="logo-text">FabOS</span>
                    <p>Système de gestion de FabLab</p>
                </div>
            </div>
            <div class="footer-section">
                <h4>Navigation</h4>
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('app_machines') }}">Machines</a>
                <a href="{{ path('app_calendar') }}">Calendrier</a>
                <a href="{{ path('app_formations') }}">Formations</a>
                <a href="{{ path('app_leaderboard') }}">Leaderboard</a>
            </div>
            <div class="footer-section">
                <h4>Ressources</h4>
                <a href="#">Documentation</a>
                <a href="#">Support</a>
                <a href="#">API</a>
                <a href="#">Statut</a>
            </div>
            <div class="footer-section">
                <h4>Légal</h4>
                <a href="#">Mentions légales</a>
                <a href="#">Politique de confidentialité</a>
                <a href="#">Conditions d'utilisation</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 FabOS - Développé pour l'ENSEA. Tous droits réservés.</p>
            <p class="footer-version">Version 1.0.0</p>
        </div>
    </footer>

    <script src="{{ asset('js/main.js') ~ '?v=20260709-header-scope' }}"></script>
</body>
</html>
