{% extends 'base.html.twig' %}

{% block title %}{{ 'usage_rights.title'|trans }} · FabOS{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s132-shared' }}">{% endblock %}
{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'usage_rights.title'|trans,
    description: 'usage_rights.description'|trans,
    action_label: 'usage_rights.create'|trans,
    action_route: 'app_admin_usage_rights_new',
    panel_title: 'usage_rights.packages'|trans,
    panel_note: packages|length ~ ' ' ~ ('usage_rights.package_count'|trans),
    list_tools: true,
    list_client_filter: true,
    list_route: 'app_admin_usage_rights',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: tiles,
} %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'adm.col_name'|trans, class: 'is-grow'},
                {label: 'usage_rights.features'|trans},
                {label: 'usage_rights.assignments'|trans, numeric: true},
                {label: 'adm.col_status'|trans},
                {label: 'adm.col_actions'|trans, class: 'is-actions'},
            ], rows: packages, empty: 'usage_rights.empty'|trans,
        } %}
            {% block rows %}
                {% for package in packages %}
                    <tr data-admin-list-filter-row data-admin-list-filter-category="{{ package.active ? 'active' : 'inactive' }}" data-admin-list-filter-row-href="{{ path('app_admin_usage_rights_edit', {id: package.id}) }}">
                        <td><strong>{{ package.name }}</strong>{% if package.description %}<span class="admin-cell-stack">{{ package.description }}</span>{% endif %}</td>
                        <td><span class="usage-feature-count">{{ package.fullAccess ? 'usage_rights.full_access'|trans : package.features|length }}</span></td>
                        <td class="is-numeric">{{ package.assignments }}</td>
                        <td><span class="status-badge {{ package.active ? 'actif' : 'inactif' }}">{{ package.active ? 'usage_rights.active'|trans : 'usage_rights.inactive'|trans }}</span></td>
                        <td class="is-actions"><a class="admin-action" href="{{ path('app_admin_usage_rights_edit', {id: package.id}) }}">{% include 'site/_icon.html.twig' with {name: 'edit'} only %} {{ 'admin_inline.edit'|trans }}</a></td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
