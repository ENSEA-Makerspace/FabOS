{% extends 'base.html.twig' %}

{% block title %}{{ 'usage_rights.title'|trans }} · FabOS{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s148j5' }}">{% endblock %}
{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'usage_rights.create'|trans,
    action_route: 'app_admin_usage_rights_new',
    panel_title: 'usage_rights.packages'|trans,
    panel_note: 'usage_rights.panel_note'|trans({'count': packages|length}),
    list_tiles_label: 'admin_list.facet_status'|trans,
    list_client_filter: true,
    list_route: 'app_admin_usage_rights',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: tiles,
} %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'adm.col_name'|trans, class: 'is-grow'},
                {label: 'usage_rights.features'|trans},
                {label: 'usage_rights.assignments'|trans, numeric: true},
                {label: 'adm.col_status'|trans},
                {label: 'adm.col_actions'|trans, class: 'is-actions'},
            ], rows: packages, empty: 'usage_rights.empty'|trans,
        } %}
            {% block rows %}
                {% for package in packages %}
                    <tr data-admin-list-filter-row data-admin-list-filter-category="{{ package.active ? 'active' : 'inactive' }}" data-admin-list-filter-row-href="{{ path('app_admin_usage_rights_edit', {id: package.id}) }}">
                        {# `.admin-cell-stack` was used here as a plain second LINE, which is
                           not what it is — it is the grid that holds the two lines. The
                           description is the subtitle. #}
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: package.name,
                            href: path('app_admin_usage_rights_edit', {id: package.id}),
                            subtitle: package.description,
                        } only %}</td>
                        <td class="is-numeric">{{ package.fullAccess ? 'usage_rights.full_access'|trans : package.features|length }}</td>
                        <td class="is-numeric">{{ package.assignments }}</td>
                        <td>{% include 'site/_cell_state.html.twig' with {
                            label: package.active ? 'usage_rights.active'|trans : 'usage_rights.inactive'|trans,
                            signal: package.active ? 'go' : 'muted',
                        } only %}</td>
                        <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                            actions: [{label: 'admin_inline.edit'|trans, icon: 'edit', href: path('app_admin_usage_rights_edit', {id: package.id})}],
                        } only %}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
