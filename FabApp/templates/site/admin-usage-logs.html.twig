{% extends 'base.html.twig' %}

{# S85 — this page was on the `.admin-rfid-*` skeleton: a FOURTH page shape for
   a list, with its own header, its own two-column layout, its own panel and its
   own filter bar (`.admin-usage-filters`, a bespoke 7-track grid). That is why
   "the lists still don't look the same" survived S85's first pass — the table
   rules landed, the page around it did not. On `_admin_list` now, like the
   other fourteen. The inline <style> is gone: every rule in it was either the
   fourth copy of the shared chrome or a filter bar the shell already draws. #}

{% block title %}Utilisations machines - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260805-s85-lists' }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'Utilisations machines',
    description: 'Historique des sessions d’utilisation créées par l’API RFID ou d’autres sources.',
    panel_title: 'Sessions enregistrées',
    panel_note: usageLogs|length ~ ' session' ~ (usageLogs|length > 1 ? 's' : ''),
    list_tools: true,
    list_client_filter: true,
    list_route: 'app_admin_usage_logs',
    list_search: filters.q,
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: usageLogs|length, category: 'all', active: true},
        {label: 'admin_list.open'|trans, count: usageLogs|filter(log => not log.dateFin)|length, category: 'open'},
        {label: 'admin_list.closed'|trans, count: usageLogs|filter(log => log.dateFin)|length, category: 'closed'},
    ],
    sidebar_variant: 'rfid',
} %}
    {% block filters %}
        <form class="filters-bar" method="get" action="{{ path('app_admin_usage_logs') }}">
            <div class="filter-group">
                <label for="usage-q">Recherche</label>
                <input id="usage-q" type="search" name="q" value="{{ filters.q }}" placeholder="Utilisateur, machine, token, source">
            </div>
            <div class="filter-group">
                <label for="usage-state">État</label>
                <select id="usage-state" name="state">
                    <option value="all" {{ filters.state == 'all' ? 'selected' : '' }}>Tous</option>
                    <option value="open" {{ filters.state == 'open' ? 'selected' : '' }}>Ouvertes</option>
                    <option value="closed" {{ filters.state == 'closed' ? 'selected' : '' }}>Terminées</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="usage-source">Source</label>
                <select id="usage-source" name="source">
                    <option value="all" {{ filters.source == 'all' ? 'selected' : '' }}>Toutes</option>
                    {% for source in sourceChoices %}
                        {% set sourceValue = source|lower %}
                        <option value="{{ sourceValue }}" {{ filters.source == sourceValue ? 'selected' : '' }}>{{ source }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-group">
                <label for="usage-date-from">Du</label>
                <input id="usage-date-from" type="date" name="dateFrom" value="{{ filters.dateFrom }}">
            </div>
            <div class="filter-group">
                <label for="usage-date-to">Au</label>
                <input id="usage-date-to" type="date" name="dateTo" value="{{ filters.dateTo }}">
            </div>
            <button class="btn-link btn-primary-admin" type="submit">Filtrer</button>
            <a class="btn-link" href="{{ path('app_admin_usage_logs') }}">Réinitialiser</a>
        </form>
    {% endblock %}
    {% block content %}
                    {% embed 'site/_data_table.html.twig' with {
                        columns: [
                            {label: 'ID'},
                            {label: 'Utilisateur'},
                            {label: 'Machine'},
                            {label: 'Date début'},
                            {label: 'Date fin'},
                            {label: 'Durée'},
                            {label: 'Source'},
                            {label: 'État'},
                        ],
                        rows: usageLogs,
                        empty: 'Aucune session d’utilisation ne correspond aux filtres.',
                    } %}
                        {% block rows %}
                        {% for log in usageLogs %}
                            {% set user = log.utilisateur %}
                            {% set machine = log.machine %}
                            <tr data-admin-list-filter-row data-admin-list-filter-category="{{ log.dateFin ? 'closed' : 'open' }}">
                                <td>#{{ log.id }}</td>
                                <td>{% if user %}{{ user.displayName }} (#{{ user.id }}){% else %}Utilisateur inconnu{% endif %}</td>
                                <td>{% if machine %}{{ machine.nom }} (#{{ machine.id }}){% else %}Machine inconnue{% endif %}</td>
                                <td>{{ log.dateDebut|lab_date('d/m/Y H:i:s') }}</td>
                                <td>{% if log.dateFin %}{{ log.dateFin|lab_date('d/m/Y H:i:s') }}{% else %}-{% endif %}</td>
                                <td>
                                    {% if log.duree is not null %}
                                        {% set totalMinutes = (log.duree / 60)|round(0, 'floor') %}
                                        {% set hours = (totalMinutes / 60)|round(0, 'floor') %}
                                        {% set minutes = totalMinutes % 60 %}
                                        {% if hours > 0 and minutes > 0 %}
                                            {{ hours }} h {{ minutes }}
                                        {% elseif hours > 0 %}
                                            {{ hours }} h
                                        {% elseif totalMinutes > 0 %}
                                            {{ totalMinutes }} min
                                        {% else %}
                                            Moins d’une minute
                                        {% endif %}
                                    {% elseif log.dateFin is null %}
                                        En cours
                                    {% else %}
                                        Non calculée
                                    {% endif %}
                                </td>
                                <td>{{ log.source ?? '-' }}</td>
                                <td><span class="{{ log.dateFin ? 'badge-yes' : 'badge-no' }}">{{ log.dateFin ? 'Terminée' : 'Ouverte' }}</span></td>
                            </tr>
                        {% else %}
                            <tr><td class="admin-empty-row" colspan="8">Aucune session d’utilisation ne correspond aux filtres.</td></tr>
                        {% endfor %}
                        {% endblock %}
                    {% endembed %}
    {% endblock %}
{% endembed %}
{% include 'site/_footer.html.twig' %}
{% endblock %}
