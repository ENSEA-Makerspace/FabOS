{% extends 'base.html.twig' %}

{% block title %}Utilisations machines - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260728-admin' }}">
    <style>
        .admin-rfid-page { min-height: 100vh; background: #f6f7fb; color: #1f2937; font-family: Arial, sans-serif; }
        .admin-rfid-header { background: #fff; border-bottom: 1px solid #e5e7eb; padding: 24px 32px; }
        .admin-rfid-header h1 { margin: 0 0 8px; font-size: 28px; }
        .admin-rfid-header p { margin: 0; color: #6b7280; }
        .admin-rfid-layout { display: grid; grid-template-columns: 240px 1fr; gap: 24px; padding: 24px 32px; }
        .admin-rfid-nav, .admin-rfid-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; }
        .admin-rfid-nav { padding: 16px; align-self: start; }
        .admin-rfid-nav h3 { margin: 0 0 12px; font-size: 16px; }
        .admin-rfid-nav a { display: block; padding: 10px 12px; border-radius: 6px; color: #374151; text-decoration: none; }
        .admin-rfid-nav a.active { background: #eef2ff; color: #3730a3; font-weight: 700; }
        .admin-rfid-panel { overflow: hidden; }
        .admin-rfid-panel-header { display: flex; justify-content: space-between; gap: 16px; padding: 18px 20px; border-bottom: 1px solid #e5e7eb; }
        .admin-rfid-panel-header h2 { margin: 0; font-size: 20px; }
        .admin-rfid-count { color: #6b7280; white-space: nowrap; }
        .admin-usage-filters { display: grid; grid-template-columns: minmax(220px, 2fr) repeat(4, minmax(130px, 1fr)) auto auto; gap: 12px; padding: 18px 20px; border-bottom: 1px solid #e5e7eb; background: #f9fafb; align-items: end; }
        .admin-usage-field { display: flex; flex-direction: column; gap: 6px; }
        .admin-usage-field label { color: #4b5563; font-size: 13px; font-weight: 700; }
        .admin-usage-field input, .admin-usage-field select { width: 100%; border: 1px solid #d1d5db; border-radius: 6px; padding: 9px 10px; background: #fff; color: #111827; font: inherit; }
        .admin-usage-actions { display: flex; gap: 8px; align-items: center; }
        .admin-usage-button { border: 1px solid #9E1B56; border-radius: 6px; padding: 9px 12px; background: #9E1B56; color: #fff; font-weight: 700; text-decoration: none; cursor: pointer; white-space: nowrap; }
        .admin-usage-button.secondary { background: #fff; color: #374151; border-color: #d1d5db; }
        .admin-rfid-table-wrap { overflow-x: auto; }
        .admin-rfid-table { width: 100%; border-collapse: collapse; font-size: 14px; }
        .admin-rfid-table th, .admin-rfid-table td { padding: 12px 14px; border-bottom: 1px solid #e5e7eb; text-align: left; vertical-align: top; }
        .admin-rfid-table th { background: #f9fafb; color: #4b5563; font-weight: 700; }
        .badge-yes, .badge-no { display: inline-block; min-width: 72px; padding: 3px 8px; border-radius: 999px; text-align: center; font-weight: 700; }
        .badge-yes { background: #dcfce7; color: #166534; }
        .badge-no { background: #fef3c7; color: #92400e; }
        .admin-empty-row { color: #6b7280; text-align: center; }
        @media (max-width: 1200px) { .admin-usage-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); } .admin-usage-actions { grid-column: 1 / -1; } }
        @media (max-width: 900px) { .admin-rfid-layout { grid-template-columns: 1fr; padding: 16px; } .admin-rfid-header { padding: 20px 16px; } .admin-usage-filters { grid-template-columns: 1fr; } }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main class="admin-rfid-page">
        <header class="admin-rfid-header">
            <h1>Utilisations machines</h1>
            <p>Historique des sessions d’utilisation créées par l’API RFID ou d’autres sources.</p>
        </header>

        <div class="admin-rfid-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'rfid'} %}

            <section class="admin-rfid-panel">
                <div class="admin-rfid-panel-header">
                    <h2>Sessions enregistrées</h2>
                    <span class="admin-rfid-count">{{ usageLogs|length }} session{{ usageLogs|length > 1 ? 's' : '' }}</span>
                </div>

                <form class="admin-usage-filters" method="get" action="{{ path('app_admin_usage_logs') }}">
                    <div class="admin-usage-field">
                        <label for="usage-q">Recherche</label>
                        <input id="usage-q" type="search" name="q" value="{{ filters.q }}" placeholder="Utilisateur, machine, token, source">
                    </div>
                    <div class="admin-usage-field">
                        <label for="usage-state">État</label>
                        <select id="usage-state" name="state">
                            <option value="all" {{ filters.state == 'all' ? 'selected' : '' }}>Tous</option>
                            <option value="open" {{ filters.state == 'open' ? 'selected' : '' }}>Ouvertes</option>
                            <option value="closed" {{ filters.state == 'closed' ? 'selected' : '' }}>Terminées</option>
                        </select>
                    </div>
                    <div class="admin-usage-field">
                        <label for="usage-source">Source</label>
                        <select id="usage-source" name="source">
                            <option value="all" {{ filters.source == 'all' ? 'selected' : '' }}>Toutes</option>
                            {% for source in sourceChoices %}
                                {% set sourceValue = source|lower %}
                                <option value="{{ sourceValue }}" {{ filters.source == sourceValue ? 'selected' : '' }}>{{ source }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="admin-usage-field">
                        <label for="usage-date-from">Du</label>
                        <input id="usage-date-from" type="date" name="dateFrom" value="{{ filters.dateFrom }}">
                    </div>
                    <div class="admin-usage-field">
                        <label for="usage-date-to">Au</label>
                        <input id="usage-date-to" type="date" name="dateTo" value="{{ filters.dateTo }}">
                    </div>
                    <div class="admin-usage-actions">
                        <button class="admin-usage-button" type="submit">Filtrer</button>
                        <a class="admin-usage-button secondary" href="{{ path('app_admin_usage_logs') }}">Réinitialiser</a>
                    </div>
                </form>

                <div class="admin-rfid-table-wrap">
                    <table class="admin-rfid-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Utilisateur</th>
                                <th>Machine</th>
                                <th>Date début</th>
                                <th>Date fin</th>
                                <th>Durée</th>
                                <th>Source</th>
                                <th>État</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for log in usageLogs %}
                            {% set user = log.utilisateur %}
                            {% set machine = log.machine %}
                            <tr>
                                <td>#{{ log.id }}</td>
                                <td>{% if user %}{{ user.displayName }} (#{{ user.id }}){% else %}Utilisateur inconnu{% endif %}</td>
                                <td>{% if machine %}{{ machine.nom }} (#{{ machine.id }}){% else %}Machine inconnue{% endif %}</td>
                                <td>{{ log.dateDebut|date('d/m/Y H:i:s') }}</td>
                                <td>{% if log.dateFin %}{{ log.dateFin|date('d/m/Y H:i:s') }}{% else %}-{% endif %}</td>
                                <td>
                                    {% if log.duree is not null %}
                                        {% set totalMinutes = (log.duree / 60)|round(0, 'floor') %}
                                        {% set hours = (totalMinutes / 60)|round(0, 'floor') %}
                                        {% set minutes = totalMinutes % 60 %}
                                        {% if hours > 0 and minutes > 0 %}
                                            {{ hours }} h {{ minutes }}
                                        {% elseif hours > 0 %}
                                            {{ hours }} h
                                        {% elseif totalMinutes > 0 %}
                                            {{ totalMinutes }} min
                                        {% else %}
                                            Moins d’une minute
                                        {% endif %}
                                    {% elseif log.dateFin is null %}
                                        En cours
                                    {% else %}
                                        Non calculée
                                    {% endif %}
                                </td>
                                <td>{{ log.source ?? '-' }}</td>
                                <td><span class="{{ log.dateFin ? 'badge-yes' : 'badge-no' }}">{{ log.dateFin ? 'Terminée' : 'Ouverte' }}</span></td>
                            </tr>
                        {% else %}
                            <tr><td class="admin-empty-row" colspan="8">Aucune session d’utilisation ne correspond aux filtres.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
