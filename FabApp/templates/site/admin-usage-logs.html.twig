{% extends 'base.html.twig' %}

{# S85 — this page was on the `.admin-rfid-*` skeleton: a FOURTH page shape for
   a list, with its own header, its own two-column layout, its own panel and its
   own filter bar (`.admin-usage-filters`, a bespoke 7-track grid). That is why
   "the lists still don't look the same" survived S85's first pass — the table
   rules landed, the page around it did not. On `_admin_list` now, like the
   other fourteen. The inline <style> is gone: every rule in it was either the
   fourth copy of the shared chrome or a filter bar the shell already draws. #}

{% block title %}{{ 'admin_usage_logs.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260827-s151' }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'admin_usage_logs.panel_title'|trans,
    panel_note: 'admin_usage_logs.panel_note'|trans({'count': usageLogs|length}),
    list_tiles_label: 'admin_list.facet_status'|trans,
    list_client_filter: true,
    list_route: 'app_admin_usage_logs',
    list_search: filters.q,
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: usageLogs|length, category: 'all', active: true},
        {label: 'admin_list.open'|trans, count: usageLogs|filter(log => not log.dateFin)|length, category: 'open'},
        {label: 'admin_list.closed'|trans, count: usageLogs|filter(log => log.dateFin)|length, category: 'closed'},
    ],
} %}
    {% block content %}
                    {% embed 'site/_data_table.html.twig' with {
                        columns: [
                            {label: 'admin_usage_logs.col_user'|trans, class: 'is-grow'},
                            {label: 'admin_usage_logs.col_machine'|trans},
                            {label: 'admin_usage_logs.col_session'|trans},
                            {label: 'admin_usage_logs.col_source'|trans},
                            {label: 'admin_usage_logs.col_state'|trans},
                        ],
                        rows: usageLogs,
                        empty: 'admin_usage_logs.empty'|trans,
                    } %}
                        {% block rows %}
                        {% for log in usageLogs %}
                            {% set user = log.utilisateur %}
                            {% set machine = log.machine %}
                            <tr data-admin-list-filter-row data-admin-list-filter-category="{{ log.dateFin ? 'closed' : 'open' }}">
                                {# The users list is the reference shape: an identity disc, the
                                   name, then the quiet line under it. This page had the same two
                                   values and drew them as a bare name plus a loose `.is-meta`. #}
                                <td>{% include 'site/_cell_title.html.twig' with {
                                    title: user ? user.displayName : '',
                                    reason: 'admin_usage_logs.unknown_user',
                                    subtitle: user ? user.email : '',
                                    media: include('site/_cell_media.html.twig', {
                                        initials: user ? (user.firstName ?? user.username)|slice(0, 1) ~ (user.lastName ?? '')|slice(0, 1) : '?',
                                        shape: 'circle',
                                    }, with_context = false),
                                } only %}</td>
                                <td>{% if machine %}{{ machine.nom }}{% else %}{% include 'site/_cell_empty.html.twig' with {reason: 'admin_usage_logs.unknown_machine'} only %}{% endif %}</td>
                                <td>
                                    <span class="is-strong">{{ log.dateDebut|lab_date('d/m/Y H:i') }}</span>
                                    {% if log.duree is not null %}
                                        {% set totalMinutes = (log.duree / 60)|round(0, 'floor') %}
                                        {% set hours = (totalMinutes / 60)|round(0, 'floor') %}
                                        {% set minutes = totalMinutes % 60 %}
                                        {% if hours > 0 and minutes > 0 %}
                                            {{ 'admin_usage_logs.duration_hm'|trans({'%h%': hours, '%m%': minutes}) }}
                                        {% elseif hours > 0 %}
                                            {{ 'admin_usage_logs.duration_h'|trans({'%h%': hours}) }}
                                        {% elseif totalMinutes > 0 %}
                                            {{ 'admin_usage_logs.duration_min'|trans({'%m%': totalMinutes}) }}
                                        {% else %}
                                            {{ 'admin_usage_logs.under_minute'|trans }}
                                        {% endif %}
                                    {% elseif log.dateFin is null %}
                                        {{ 'admin_usage_logs.ongoing'|trans }}
                                    {% else %}
                                        {{ 'admin_usage_logs.not_computed'|trans }}
                                    {% endif %}
                                </td>
                                <td>{% if log.source %}{{ log.source }}{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}</td>
                                {# 🔴 `.badge-yes` / `.badge-no` was a THIRD status chip — a
                                   yes/no pair pressed into service as open/closed, which is
                                   why "open" was painted in the danger colour. #}
                                <td>{% include 'site/_cell_state.html.twig' with {
                                    label: (log.dateFin ? 'admin_usage_logs.state_closed' : 'admin_usage_logs.state_open')|trans,
                                    signal: log.dateFin ? 'muted' : 'wait',
                                } only %}</td>
                            </tr>
                        {% endfor %}
                        {% endblock %}
                    {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
