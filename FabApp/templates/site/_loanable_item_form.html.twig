{% form_theme form 'form/admin_theme.html.twig' %}
{{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
    {{ form_errors(form) }}

    {# ⚠️ **Le découpage vient du `FormType`, pas d'ici** — `LoanableItemAdminType::SECTIONS`.
       Le gabarit ne décide plus ni de l'ordre des champs, ni de leur largeur, ni
       de ce qui est replié : il déroule ce que le formulaire déclare. C'est ce
       qui permet à deux gabarits (création et édition) de rendre le même type
       sans tenir deux listes qui divergent — le défaut mesuré sur les machines,
       où deux champs n'étaient dans aucune des deux listes et sortaient par
       `form_rest()` APRÈS le bouton « Enregistrer ».

       ⚠️ **S151 — la boucle elle-même vit dans `_form_sections.html.twig`.** Elle
       était écrite ici et nulle part ailleurs, alors que trois `FormType` portent
       une constante `SECTIONS`. Les commentaires sur le repli qui se rouvre et sur
       `name in _fields` ont suivi la boucle. #}
    {% include 'site/_form_sections.html.twig' with {
        form: form,
        sections: constant('App\\Form\\LoanableItemAdminType::SECTIONS'),
    } only %}

    <div class="form-actions">
        <a class="btn-link" href="{{ path('app_admin_loanable_items') }}">{{ 'common.cancel'|trans }}</a>
        <span class="btn-submit">{{ form_widget(form.save, {label: submit_label|default('common.save'|trans)}) }}</span>
    </div>
{{ form_end(form) }}
