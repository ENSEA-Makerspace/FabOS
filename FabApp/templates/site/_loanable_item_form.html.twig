{% form_theme form 'form/admin_theme.html.twig' %}
{{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
    {{ form_errors(form) }}
    <div class="form-grid">
        {{ form_row(form.name, {row_attr: {class: 'full'}}) }}
        {{ form_row(form.category) }}
        {{ form_row(form.quantity) }}
        {{ form_row(form.description, {row_attr: {class: 'full'}}) }}
        {{ form_row(form.imageUrl) }}
        {{ form_row(form.icon) }}
        {# Venue = which site; storageLocation = which drawer inside it. Adjacent on
           purpose so the pair reads as one question refined, not two rival fields. #}
        {{ form_row(form.venue) }}
        {{ form_row(form.storageLocation, {row_attr: {class: 'full'}}) }}
    </div>
    <div class="form-actions">
        <a class="btn-link" href="{{ path('app_admin_loanable_items') }}">Annuler</a>
        <span class="btn-submit">{{ form_widget(form.save, {label: submit_label|default('Enregistrer')}) }}</span>
    </div>
{{ form_end(form) }}
