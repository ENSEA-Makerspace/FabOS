<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouvelle tâche de maintenance - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260731-tokens' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260731-tokens' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    {% include 'site/_admin_edit_styles.html.twig' %}
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div><h1>Nouvelle tâche de maintenance</h1><p>Une tâche à faire sur une machine.</p></div>
                <a class="btn-link" href="{{ path('app_admin_maintenance') }}">Retour</a>
            </div>
        </header>
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}
            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header"><h2>Nouvelle tâche</h2></div>
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        <div class="form-field">{{ form_label(form.machine) }}{{ form_widget(form.machine) }}<div class="form-errors">{{ form_errors(form.machine) }}</div></div>
                        <div class="form-field">{{ form_label(form.type) }}{{ form_widget(form.type) }}<div class="form-errors">{{ form_errors(form.type) }}</div></div>
                        <div class="form-field full">{{ form_label(form.title) }}{{ form_widget(form.title) }}<div class="form-errors">{{ form_errors(form.title) }}</div></div>
                        <div class="form-field">{{ form_label(form.dueDate) }}{{ form_widget(form.dueDate) }}<div class="form-errors">{{ form_errors(form.dueDate) }}</div></div>
                        <div class="form-field">{{ form_label(form.recurrenceDays) }}{{ form_widget(form.recurrenceDays) }}<div class="form-errors">{{ form_errors(form.recurrenceDays) }}</div></div>
                        <div class="form-field full">{{ form_label(form.link) }}{{ form_widget(form.link) }}<div class="form-errors">{{ form_errors(form.link) }}</div></div>
                        <div class="form-field full">{{ form_label(form.notes) }}{{ form_widget(form.notes) }}<div class="form-errors">{{ form_errors(form.notes) }}</div></div>
                    </div>
                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_maintenance') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
</body>
</html>
