{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ (task is defined ? 'maintenance.form_browser_title_edit' : 'maintenance.form_browser_title_new')|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260816-s141' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260816-s139e' }}">
    {% include 'site/_admin_edit_styles.html.twig' %}
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div><h1>{{ (task is defined ? 'maintenance.form_edit_title' : 'maintenance.form_new_title')|trans }}</h1><p>{{ task is defined ? task.title : 'maintenance.form_new_subtitle'|trans }}</p></div>
                <a class="btn-link" href="{{ path('app_admin_maintenance') }}">{{ 'common.back'|trans }}</a>
            </div>
        </header>
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}
            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header"><h2>{{ task is defined ? task.title : 'maintenance.form_panel_new'|trans }}</h2></div>
                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.machine) }}
                        {{ form_row(form.type) }}
                        {{ form_row(form.title, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.dueDate) }}
                        {{ form_row(form.recurrenceDays) }}
                        {{ form_row(form.link, {row_attr: {class: 'full'}}) }}
                        {{ form_row(form.notes, {row_attr: {class: 'full'}}) }}
                    </div>
                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_maintenance') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
                {% if task is defined %}{% include 'site/_admin_danger_zone.html.twig' with {action: path('app_admin_maintenance_delete', {id: task.id}), token: 'delete_maintenance_' ~ task.id, confirm: 'adm.confirm_delete_maintenance'|trans} only %}{% endif %}
            </section>
        </div>
    </main>
{% endblock %}
