{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_formation_new.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s148j5' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260823-s148j5' }}">
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel admin-list-card admin-form-card">
                {% include 'site/_admin_form_head.html.twig' with {
                    title: 'admin_formation_new.title'|trans,
                    subtitle: 'admin_formation_new.subtitle'|trans,
                    back_href: path('app_admin_formations'),
                    back_label: 'admin_formation_new.back'|trans,
                } only %}
                <div class="admin-edit-panel-header">
                    <h2>{{ 'admin_formation_new.panel_title'|trans }}</h2>
                    <p>{{ 'admin_formation_new.panel_hint'|trans }}</p>
                </div>

                {% if form.badge.vars.value is empty %}
                    <div class="form-warning">{{ 'admin_formation_new.no_badge_warning'|trans }}</div>
                {% endif %}

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    <div class="form-errors">{{ form_errors(form) }}</div>
                    <div class="form-grid">
                        {% for field in [form.titre, form.image, form.categorie, form.niveau, form.duree, form.formateur, form.placesTotales, form.badge] %}
                            <div class="form-field">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}

                        {% for field in [form.description, form.objectifs, form.prerequis, form.materielFourni] %}
                            <div class="form-field full">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_formations') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save, {label: 'admin_formation_new.submit'|trans}) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
{% endblock %}
