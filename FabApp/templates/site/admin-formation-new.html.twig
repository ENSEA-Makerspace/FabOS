{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}Créer une formation - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260804-s83-surface' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <style>
        .form-field input, .form-field select, .form-field textarea { width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 15px; background: var(--theme-surface); }
        .form-field textarea { min-height: 120px; resize: vertical; }
        .form-warning { margin: 18px 24px 0; padding: 12px 14px; border-radius: 6px; background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; font-weight: 600; }
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Créer une formation</h1>
                    <p>Création d’une formation seule, sans progression, utilisateur ni machine associée.</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_formations') }}">Retour aux formations</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>Nouvelle formation</h2>
                    <p>Associer un badge est fortement recommandé pour que la formation donne une certification.</p>
                </div>

                {% if form.badge.vars.value is empty %}
                    <div class="form-warning">Cette formation ne donnera aucun badge tant qu’un badge n’est pas associé.</div>
                {% endif %}

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    <div class="form-errors">{{ form_errors(form) }}</div>
                    <div class="form-grid">
                        {% for field in [form.titre, form.image, form.categorie, form.niveau, form.duree, form.formateur, form.placesTotales, form.badge] %}
                            <div class="form-field">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}

                        {% for field in [form.description, form.objectifs, form.prerequis, form.materielFourni] %}
                            <div class="form-field full">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_formations') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save, {label: 'Créer la formation'}) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
{% endblock %}
