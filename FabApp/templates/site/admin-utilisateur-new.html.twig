{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_user_new.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260822-s148b' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260822-s147' }}">
    <style>
        {# The only rule left: this form puts a checkbox on the same ROW as a labelled
           input, so it needs the label's height back. The rest is in admin.css. #}
        .form-field.check { padding-top: 28px; }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel admin-list-card admin-form-card">
                {% include 'site/_admin_form_head.html.twig' with {
                    title: 'admin_user_new.title'|trans,
                    subtitle: 'admin_user_new.subtitle'|trans,
                    back_href: path('app_admin_users'),
                    back_label: 'admin_user_new.back'|trans,
                } only %}
                <div class="admin-edit-panel-header">
                    <h2>{{ 'admin_user_new.panel_title'|trans }}</h2>
                    <p>{{ 'admin_user_new.password_note'|trans }}</p>
                </div>

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {% for field in [form.email, form.username, form.firstName, form.lastName, form.plainPassword, form.confirmPassword, form.role, form.identifiantRfid, form.numeroId, form.statut, form.theme, form.langue] %}
                            <div class="form-field">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}
                        <div class="form-field check">
                            {{ form_widget(form.notificationEmail) }}
                            {{ form_label(form.notificationEmail) }}
                            <div class="form-errors">{{ form_errors(form.notificationEmail) }}</div>
                        </div>
                        <div class="form-field check">
                            {{ form_widget(form.notificationPush) }}
                            {{ form_label(form.notificationPush) }}
                            <div class="form-errors">{{ form_errors(form.notificationPush) }}</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_users') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
{% endblock %}
