<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Créer un utilisateur - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260802-s78-nav' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260802-s78-table' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        .form-field input, .form-field select { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px; background: #fff; }
        .form-field.check { display: flex; align-items: center; gap: 10px; padding-top: 28px; }
        .form-field.check label { margin: 0; }
        .form-field.check input { width: auto; }
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Créer un utilisateur</h1>
                    <p>Ajout d’un compte applicatif et association au rôle choisi.</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_users') }}">Retour aux utilisateurs</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>Nouvel utilisateur</h2>
                    <p>Le mot de passe est hashé par Symfony et n’est jamais affiché.</p>
                </div>

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {% for field in [form.email, form.username, form.firstName, form.lastName, form.plainPassword, form.confirmPassword, form.role, form.identifiantRfid, form.numeroId, form.statut, form.theme, form.langue] %}
                            <div class="form-field">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}
                        <div class="form-field check">
                            {{ form_widget(form.notificationEmail) }}
                            {{ form_label(form.notificationEmail) }}
                            <div class="form-errors">{{ form_errors(form.notificationEmail) }}</div>
                        </div>
                        <div class="form-field check">
                            {{ form_widget(form.notificationPush) }}
                            {{ form_label(form.notificationPush) }}
                            <div class="form-errors">{{ form_errors(form.notificationPush) }}</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_users') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
</body>
</html>
