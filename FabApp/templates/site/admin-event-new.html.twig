<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Créer un événement - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260802-s78-nav' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260802-s78-table' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        /* :not(...) matters — the bare rule also caught radios and checkboxes,
           blowing them up into full-width bordered boxes. */
        .form-field input:not([type="radio"]):not([type="checkbox"]), .form-field textarea, .form-field select { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px; background: #fff; }
        .form-field input[type="radio"], .form-field input[type="checkbox"] { width: 16px; height: 16px; accent-color: #9E1B56; margin: 0; }
        /* Expanded ChoiceType renders a bare list of radio+label pairs. */
        .form-field .radio-group, .form-field > div > input[type="radio"] + label { display: inline; }
        .form-field .form-check, .form-field.check { display: flex; align-items: center; gap: 9px; }
        .form-field.check label { margin: 0; font-weight: 600; }
        .form-field fieldset { border: 0; padding: 0; margin: 0; }
        .form-field fieldset > div { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 4px; }
        .form-field fieldset label { display: inline-flex; align-items: center; gap: 7px; font-weight: 500; margin: 0; }
        .form-field .help-text, .form-field small { display: block; color: #6b7280; font-size: 12.5px; margin-top: 6px; line-height: 1.5; }
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Créer un événement</h1>
                    <p>Un événement daté affiché sur l'accueil, le calendrier et l'écran dédié.</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_events') }}">Retour aux événements</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>Nouvel événement</h2>
                </div>

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        <div class="form-field full">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre) }}
                            <div class="form-errors">{{ form_errors(form.titre) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.dateDebut) }}
                            {{ form_widget(form.dateDebut) }}
                            <div class="form-errors">{{ form_errors(form.dateDebut) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.dateFin) }}
                            {{ form_widget(form.dateFin) }}
                            <div class="form-errors">{{ form_errors(form.dateFin) }}</div>
                        </div>
                        <div class="form-field full">
                            {{ form_label(form.lieu) }}
                            {{ form_widget(form.lieu) }}
                            <div class="form-errors">{{ form_errors(form.lieu) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.locationMode) }}
                            {{ form_widget(form.locationMode) }}
                            <div class="form-errors">{{ form_errors(form.locationMode) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.address) }}
                            {{ form_widget(form.address) }}
                            <div class="form-errors">{{ form_errors(form.address) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.capacite) }}
                            {{ form_widget(form.capacite) }}
                            <div class="form-errors">{{ form_errors(form.capacite) }}</div>
                        </div>
                        <div class="form-field check">
                            {{ form_widget(form.guestsAllowed) }}
                            {{ form_label(form.guestsAllowed) }}
                        </div>
                        <div class="form-field full">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description) }}
                            <div class="form-errors">{{ form_errors(form.description) }}</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_events') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save, {label: 'Créer l’événement'}) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
</body>
</html>
