<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    <!-- ========================================
         BANDEAU D'ALERTE
         ======================================== -->
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <!-- ========================================
         HEADER
         ======================================== -->
    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    {% include 'site/_logo.html.twig' %}
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">{{ 'nav.home'|trans }}</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">{{ 'nav.calendar'|trans }}</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">{{ 'nav.machines'|trans }}</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">{{ 'nav.trainings'|trans }}</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">{{ 'nav.leaderboard'|trans }}</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">{{ 'nav.admin'|trans }}</a>
                    {% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- ========================================
         CONTENU PRINCIPAL - FORMULAIRE D'INSCRIPTION
         ======================================== -->
    <main class="main-content">
        <section class="register-section">
            <div class="container">
                <div class="register-container">
                    <!-- Cartouche de section -->
                    <div class="section-badge register-badge">Inscription</div>
                    
                    <div class="register-card">
                        <div class="register-header">
                            <h1 class="register-title">Créer un compte</h1>
                            <p class="register-subtitle">Inscrivez-vous pour accéder aux réservations, formations et badges FabOS.</p>
                        </div>

                        <div class="register-illustration">
                            <svg viewBox="0 0 200 150" class="register-icon" aria-label="Inscription">
                                <circle cx="70" cy="60" r="25" fill="none" stroke="#9E1B56" stroke-width="3"/>
                                <path d="M50 85 Q70 100 90 85" fill="none" stroke="#9E1B56" stroke-width="2"/>
                                <line x1="60" y1="95" x2="80" y2="95" stroke="#9E1B56" stroke-width="2"/>
                                
                                <circle cx="130" cy="60" r="25" fill="none" stroke="#9E1B56" stroke-width="3"/>
                                <path d="M110 85 Q130 100 150 85" fill="none" stroke="#9E1B56" stroke-width="2"/>
                                <line x1="120" y1="95" x2="140" y2="95" stroke="#9E1B56" stroke-width="2"/>
                                
                                <line x1="90" y1="50" x2="110" y2="50" stroke="#9E1B56" stroke-width="2"/>
                            </svg>
                        </div>

                        <form class="register-form" id="registerForm" method="post" action="{{ path('app_register') }}">
                            {% if errors|default([]) is not empty %}
                                <div class="auth-alert auth-alert-error">
                                    <strong>Inscription impossible</strong>
                                    <ul>
                                        {% for error in errors %}
                                            <li>{{ error }}</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}

                            <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="firstName" class="form-label">Prénom</label>
                                    <div class="input-wrapper">
                                        <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                        <input type="text" id="firstName" name="firstName" class="form-input" placeholder="Jean" value="{{ formData.firstName|default('') }}" required>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="lastName" class="form-label">Nom</label>
                                    <div class="input-wrapper">
                                        <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                        <input type="text" id="lastName" name="lastName" class="form-input" placeholder="Dupont" value="{{ formData.lastName|default('') }}" required>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="email" class="form-label">Adresse email</label>
                                <div class="input-wrapper">
                                    <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                        <polyline points="22,6 12,13 2,6"/>
                                    </svg>
                                    <input type="email" id="email" name="email" class="form-input" placeholder="jean.dupont@ensea.fr" value="{{ formData.email|default('') }}" required>
                                </div>
                            </div>

                            <div class="form-group field-disabled">
                                <label for="studentId" class="form-label">Numéro étudiant (si applicable)</label>
                                <div class="input-wrapper">
                                    <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                        <line x1="16" y1="2" x2="16" y2="6"/>
                                        <line x1="8" y1="2" x2="8" y2="6"/>
                                        <line x1="3" y1="10" x2="21" y2="10"/>
                                    </svg>
                                    <input type="text" id="studentId" name="studentId" class="form-input" placeholder="Bientôt disponible" disabled aria-disabled="true">
                                </div>
                                <span class="field-note">Bientôt disponible</span>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="password" class="form-label">Mot de passe</label>
                                    <div class="input-wrapper">
                                        <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                        </svg>
                                        <input type="password" id="password" name="password" class="form-input" placeholder="Minimum 8 caractères" required>
                                        <button type="button" class="password-toggle" aria-label="Afficher le mot de passe">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                <circle cx="12" cy="12" r="3"/>
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="password-strength">
                                        <div class="strength-bar" id="password-strength"></div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="confirmPassword" class="form-label">Confirmer le mot de passe</label>
                                    <div class="input-wrapper">
                                        <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                        </svg>
                                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="Confirmez votre mot de passe" required>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="checkbox-wrapper terms-checkbox">
                                    <input type="checkbox" id="terms" name="terms" {% if formData.terms|default(false) %}checked{% endif %} required>
                                    <span class="checkmark"></span>
                                    <span class="checkbox-label">J'accepte les <a href="#" class="terms-link">conditions d'utilisation</a> et la <a href="#" class="terms-link">politique de confidentialité</a></span>
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary btn-block btn-large">
                                Créer mon compte
                            </button>

                            <div class="register-divider">
                                <span class="divider-text">ou</span>
                            </div>

                            <button type="button" class="btn btn-secondary btn-block btn-cas" disabled>
                                <svg viewBox="0 0 24 24" class="cas-icon" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                    <line x1="8" y1="21" x2="16" y2="21"/>
                                    <line x1="12" y1="17" x2="12" y2="21"/>
                                </svg>
                                Inscription CAS bientôt disponible
                            </button>
                        </form>

                        <div class="register-footer">
                            <p class="already-account">Vous avez déjà un compte ? 
                                <a href="{{ path('app_login') }}" class="login-link">Connectez-vous</a>
                            </p>
                        </div>
                    </div>

                    <!-- Avantages de l'inscription -->
                    <div class="register-benefits">
                        <h3 class="benefits-title">Pourquoi créer un compte ?</h3>
                        <div class="benefits-grid">
                            <div class="benefit-card">
                                <div class="benefit-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </div>
                                <div class="benefit-content">
                                    <h4>Accès aux machines</h4>
                                    <p>Réservez et utilisez toutes les machines du FabLab avec vos badges.</p>
                                </div>
                            </div>
                            
                            <div class="benefit-card">
                                <div class="benefit-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                        <line x1="16" y1="2" x2="16" y2="6"/>
                                        <line x1="8" y1="2" x2="8" y2="6"/>
                                        <line x1="3" y1="10" x2="21" y2="10"/>
                                    </svg>
                                </div>
                                <div class="benefit-content">
                                    <h4>Formations gratuites</h4>
                                    <p>Accédez à toutes les formations pour obtenir de nouveaux badges.</p>
                                </div>
                            </div>
                            
                            <div class="benefit-card">
                                <div class="benefit-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                        <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                                    </svg>
                                </div>
                                <div class="benefit-content">
                                    <h4>Classement et récompenses</h4>
                                    <p>Gagnez des points et appearissez dans le leaderboard du FabLab.</p>
                                </div>
                            </div>
                            
                            <div class="benefit-card">
                                <div class="benefit-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                    </svg>
                                </div>
                                <div class="benefit-content">
                                    <h4>Historique complet</h4>
                                    <p>Retrouvez toutes vos réservations et votre temps d'utilisation.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- ========================================
         FOOTER
         ======================================== -->
    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') ~ '?v=20260709-header-scope' }}"></script>
</body>
</html>
