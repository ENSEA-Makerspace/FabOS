{% extends 'site/base_public.html.twig' %}

{% block title %}{{ 'register.badge'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260822-s148d' }}">
{% endblock %}

{% block body %}

    <!-- ========================================
         CONTENU PRINCIPAL - FORMULAIRE D'INSCRIPTION
         ======================================== -->
    <main id="main-content" tabindex="-1" class="main-content">
        <section class="register-section">
            <div class="container">
                <div class="register-container">
                    <!-- Cartouche de section -->
                    <div class="section-badge register-badge">{{ 'register.badge'|trans }}</div>
                    
                    <div class="register-card">
                        <div class="register-header">
                            <h1 class="register-title">{{ 'register.title'|trans }}</h1>
                            <p class="register-subtitle">{{ 'register.subtitle'|trans }}</p>
                        </div>

                        <div class="register-illustration">
                            <svg viewBox="0 0 200 150" class="register-icon" aria-label="{{ 'register.illustration_alt'|trans }}">
                                <circle cx="70" cy="60" r="25" fill="none" stroke="#9E1B56" stroke-width="3"/>
                                <path d="M50 85 Q70 100 90 85" fill="none" stroke="#9E1B56" stroke-width="2"/>
                                <line x1="60" y1="95" x2="80" y2="95" stroke="#9E1B56" stroke-width="2"/>
                                
                                <circle cx="130" cy="60" r="25" fill="none" stroke="#9E1B56" stroke-width="3"/>
                                <path d="M110 85 Q130 100 150 85" fill="none" stroke="#9E1B56" stroke-width="2"/>
                                <line x1="120" y1="95" x2="140" y2="95" stroke="#9E1B56" stroke-width="2"/>
                                
                                <line x1="90" y1="50" x2="110" y2="50" stroke="#9E1B56" stroke-width="2"/>
                            </svg>
                        </div>

                        <form class="register-form" id="registerForm" method="post" action="{{ path('app_register') }}">
                            {% if errors|default([]) is not empty %}
                                <div class="auth-alert auth-alert-error">
                                    <strong>{{ 'register.error_title'|trans }}</strong>
                                    <ul>
                                        {% for error in errors %}
                                            <li>{{ error }}</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}

                            <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="firstName" class="form-label">{{ 'register.firstname'|trans }}</label>
                                    <div class="input-wrapper">
                                        <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                        <input type="text" id="firstName" name="firstName" class="form-input" placeholder="{{ 'register.first_name_placeholder'|trans }}" value="{{ formData.firstName|default('') }}" required>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="lastName" class="form-label">{{ 'register.lastname'|trans }}</label>
                                    <div class="input-wrapper">
                                        <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                        <input type="text" id="lastName" name="lastName" class="form-input" placeholder="{{ 'register.last_name_placeholder'|trans }}" value="{{ formData.lastName|default('') }}" required>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="email" class="form-label">{{ 'register.email'|trans }}</label>
                                <div class="input-wrapper">
                                    <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                        <polyline points="22,6 12,13 2,6"/>
                                    </svg>
                                    <input type="email" id="email" name="email" class="form-input" placeholder="{{ 'register.email_placeholder'|trans }}" value="{{ formData.email|default('') }}" required>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="password" class="form-label">{{ 'login.password_label'|trans }}</label>
                                    <div class="input-wrapper">
                                        <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                        </svg>
                                        <input type="password" id="password" name="password" class="form-input" placeholder="{{ 'register.password_hint'|trans }}" required>
                                        <button type="button" class="password-toggle" aria-label="{{ 'login.show_password'|trans }}">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                <circle cx="12" cy="12" r="3"/>
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="password-strength">
                                        <div class="strength-bar" id="password-strength"></div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="confirmPassword" class="form-label">{{ 'register.confirm_password'|trans }}</label>
                                    <div class="input-wrapper">
                                        <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                        </svg>
                                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="{{ 'register.confirm_placeholder'|trans }}" required>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="checkbox-wrapper terms-checkbox">
                                    <input type="checkbox" id="terms" name="terms" {% if formData.terms|default(false) %}checked{% endif %} required>
                                    <span class="checkmark"></span>
                                    <span class="checkbox-label">{{ 'register.accept_terms_pre'|trans }} <a href="#" class="terms-link">{{ 'register.terms'|trans }}</a> et la <a href="#" class="terms-link">{{ 'register.privacy'|trans }}</a></span>
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary btn-block btn-large">
                                {{ 'register.submit'|trans }}
                            </button>
                        </form>

                        <div class="register-footer">
                            <p class="already-account">{{ 'register.already'|trans }} 
                                <a href="{{ path('app_login') }}" class="login-link">{{ 'register.login_link'|trans }}</a>
                            </p>
                        </div>
                    </div>

                    <!-- Avantages de l'inscription -->
                    <div class="register-benefits">
                        <h3 class="benefits-title">{{ 'register.why_title'|trans }}</h3>
                        <div class="benefits-grid">
                            <div class="benefit-card">
                                <div class="benefit-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </div>
                                <div class="benefit-content">
                                    <h4>{{ 'register.benefit1_title'|trans }}</h4>
                                    <p>{{ 'register.benefit1_desc'|trans }}</p>
                                </div>
                            </div>
                            
                            <div class="benefit-card">
                                <div class="benefit-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                        <line x1="16" y1="2" x2="16" y2="6"/>
                                        <line x1="8" y1="2" x2="8" y2="6"/>
                                        <line x1="3" y1="10" x2="21" y2="10"/>
                                    </svg>
                                </div>
                                <div class="benefit-content">
                                    <h4>{{ 'register.benefit2_title'|trans }}</h4>
                                    <p>{{ 'register.benefit2_desc'|trans }}</p>
                                </div>
                            </div>
                            
                            <div class="benefit-card">
                                <div class="benefit-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                        <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                                    </svg>
                                </div>
                                <div class="benefit-content">
                                    <h4>{{ 'register.benefit3_title'|trans }}</h4>
                                    <p>{{ 'register.benefit3_desc'|trans }}</p>
                                </div>
                            </div>
                            
                            <div class="benefit-card">
                                <div class="benefit-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                    </svg>
                                </div>
                                <div class="benefit-content">
                                    <h4>{{ 'register.benefit4_title'|trans }}</h4>
                                    <p>{{ 'register.benefit4_desc'|trans }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- ========================================
         FOOTER
         ======================================== -->
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
{% endblock %}
