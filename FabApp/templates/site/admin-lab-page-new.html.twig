<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Créer une page du Lab - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260802-s78-nav' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260802-s78-forms' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        .form-field input, .form-field textarea, .form-field select { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px; background: #fff; }
        .form-field textarea { min-height: 180px; resize: vertical; }
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Créer une page</h1>
                    <p>Choisissez une page parente pour en faire une sous-page (2 niveaux maximum).</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_lab_pages') }}">Retour aux pages</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>Nouvelle page</h2>
                </div>

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        <div class="form-field full">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre) }}
                            <div class="form-errors">{{ form_errors(form.titre) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.parentPage) }}
                            {{ form_widget(form.parentPage) }}
                            <div class="form-errors">{{ form_errors(form.parentPage) }}</div>
                        </div>
                        <div class="form-field full">
                            {{ form_label(form.contenu) }}
                            {{ form_widget(form.contenu) }}
                            <div class="form-errors">{{ form_errors(form.contenu) }}</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_lab_pages') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save, {label: 'Créer la page'}) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
</body>
</html>
