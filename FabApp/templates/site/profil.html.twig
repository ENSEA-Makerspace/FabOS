{% extends 'site/base_public.html.twig' %}

{# Server-rendered so the member's preference is on the document before the
   script below runs — the script only resolves 'system' into light or dark. #}
{% set html_attrs = 'data-theme-preference="' ~ user.theme|e('html_attr') ~ '"' %}

{% block title %}{{ 'profile.browser_title'|trans({'%name%': user.displayName}) }}{% endblock %}

{% block head %}
    <script>
        (() => {
            const preference = {{ user.theme|json_encode|raw }};
            const resolved = preference === 'system'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : preference;
            document.documentElement.dataset.theme = resolved;
            document.documentElement.dataset.themePreference = preference;
        })();
    </script>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260827-s152d' }}">
    <link rel="stylesheet" href="{{ asset('css/badges.css') ~ '?v=20260827-s152d' }}">
{% endblock %}

{% block body %}

    <!-- ========================================
         CONTENU PRINCIPAL - PROFIL UTILISATEUR
         ======================================== -->
    <main id="main-content" tabindex="-1" class="main-content">
        <section class="profile-section">
            <div class="container">
                {# S51 toasts — success fades, error persists. See index.html.twig. #}
                <div class="fab-toasts">
                    {% for message in app.flashes('success') %}
                        <div class="fab-toast fab-toast--success" role="status">{{ message|flash_text }}</div>
                    {% endfor %}
                    {% for message in app.flashes('error') %}
                        <div class="fab-toast fab-toast--error" role="alert">{{ message|flash_text }}</div>
                    {% endfor %}
                </div>
                <!-- En-tête de profil -->
                {% set bannerFilename = user.bannerFilename %}
                {% set safeBannerFilename = bannerFilename and bannerFilename matches '/^[A-Za-z0-9._-]+$/' ? bannerFilename : null %}
                <div class="profile-header">
                    <div class="section-badge profile-badge">{{ 'profile.title'|trans }}</div>
                    <div class="profile-banner {{ safeBannerFilename ? 'has-custom-banner' : '' }}">
                        <div class="profile-theme-control">
                            <button
                                type="button"
                                class="day-night-switch"
                                data-theme-switch
                                data-save-url="{{ path('app_profile') }}"
                                data-csrf-token="{{ csrf_token('profile_preferences') }}"
                                {# main.js has no catalogue: its six theme labels ride in here. #}
                                data-label-to-light="{{ 'profile.switch_to_light'|trans }}"
                                data-label-to-dark="{{ 'profile.switch_to_dark'|trans }}"
                                data-label-system-dark="{{ 'profile.theme_system_dark'|trans }}"
                                data-label-system-light="{{ 'profile.theme_system_light'|trans }}"
                                data-label-mode-dark="{{ 'profile.mode_dark'|trans }}"
                                data-label-mode-light="{{ 'profile.mode_light'|trans }}"
                                role="switch"
                                aria-checked="{{ user.theme == 'dark' ? 'true' : 'false' }}"
                                aria-label="{{ 'profile.dark_toggle'|trans }}"
                                title="{{ 'profile.change_theme'|trans }}"
                            >
                                <span class="day-night-switch__track" aria-hidden="true">
                                    <span class="day-night-switch__stars">
                                        <i></i><i></i><i></i><i></i><i></i>
                                    </span>
                                    <span class="day-night-switch__clouds">
                                        <i></i><i></i><i></i>
                                    </span>
                                    <span class="day-night-switch__orb">
                                        <i class="day-night-switch__crater day-night-switch__crater--one"></i>
                                        <i class="day-night-switch__crater day-night-switch__crater--two"></i>
                                        <i class="day-night-switch__crater day-night-switch__crater--three"></i>
                                    </span>
                                </span>
                                <span class="sr-only">{{ 'profile.theme_toggle_desc'|trans }}</span>
                            </button>
                            <span class="theme-switch-caption" data-theme-switch-label aria-live="polite"></span>
                        </div>
                        <div class="profile-cover">
                            {% if safeBannerFilename %}
                                <img src="{{ asset('uploads/profile-banners/' ~ safeBannerFilename) }}" alt="{{ 'profile.banner_alt'|trans({'%name%': user.displayName}) }}" class="profile-cover-image">
                            {% endif %}
                            <div class="cover-overlay"></div>
                        </div>
                        <div class="profile-avatar-large">
                            {% include 'site/_user_avatar.html.twig' with {user: user, size: 96, class: 'profile-user-avatar', alt: user.displayName} only %}
                            <div class="avatar-status online"></div>
                        </div>
                        <div class="profile-info-main">
                            <h1 class="profile-name">{{ user.displayName }}</h1>
                            <p class="profile-email">{{ user.email }}</p>
                            <p class="profile-student-id">{{ 'profile.id_number'|trans }}: {{ user.numeroId ?? 'profile.not_set'|trans }}</p>
                        </div>
                    </div>

                    {# Navigation profil. The first five are anchors into this page; the
                       last two are the personal pages that left the main menu — they live
                       here now, so this strip is the account's whole index. The
                       `is-page` ones carry an arrow so a jump off the page doesn't look
                       like a jump down it. #}
                    <div class="profile-nav">
                        <a href="#info" class="profile-nav-link active">{{ 'profile.tab_personal'|trans }}</a>
                        <a href="#usage-rights" class="profile-nav-link">{{ 'usage_rights.profile_tab'|trans }}</a>
                        <a href="#badges" class="profile-nav-link">{{ 'profile.tab_badges'|trans }}</a>
                        <a href="#reservations" class="profile-nav-link">{{ 'profile.tab_history'|trans }}</a>
                        <a href="#stats" class="profile-nav-link">{{ 'profile.tab_stats'|trans }}</a>
                        <a href="#settings" class="profile-nav-link">{{ 'profile.tab_settings'|trans }}</a>
                        <a href="{{ path('app_my_reservations') }}" class="profile-nav-link is-page">{{ 'resv.title'|trans }}</a>
                        {% if feature_enabled('person_booking') %}
                            <a href="{{ path('app_person_my_availability') }}" class="profile-nav-link is-page">{{ 'booking.my_availability'|trans }}</a>
                        {% endif %}
                    </div>
                </div>

                <!-- Section Informations Personnelles -->
                <section class="profile-content-section" id="info">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">{{ 'profile.tab_personal'|trans }}</h2>
                        </div>
                        

                        <div class="profile-avatar-settings">
                            <div class="profile-avatar-preview">
                                {% include 'site/_user_avatar.html.twig' with {user: user, size: 88, class: 'profile-settings-avatar', alt: user.displayName} only %}
                                <div>
                                    <h3>{{ 'profile.photo'|trans }}</h3>
                                    <p>{{ 'profile.photo_formats'|trans }}</p>
                                </div>
                            </div>
                            <form method="post" action="{{ path('app_profile') }}" enctype="multipart/form-data" class="profile-avatar-form">
                                <input type="hidden" name="_profile_form" value="avatar">
                                <input type="hidden" name="_token" value="{{ csrf_token('profile_avatar') }}">
                                <input type="file" name="avatar" accept="image/png,image/jpeg,image/webp" required aria-label="{{ 'profile.photo'|trans }}">
                                <button type="submit" class="btn btn-sm btn-primary">{{ 'profile.update_photo'|trans }}</button>
                            </form>
                        </div>

                        <div class="profile-avatar-settings profile-banner-settings">
                            <div class="profile-avatar-preview profile-banner-preview">
                                {% if safeBannerFilename %}
                                    <img src="{{ asset('uploads/profile-banners/' ~ safeBannerFilename) }}" alt="{{ 'profile.banner_current_alt'|trans }}" class="profile-banner-preview-image">
                                {% else %}
                                    <div class="profile-banner-preview-default"></div>
                                {% endif %}
                                <div>
                                    <h3>{{ 'profile.banner'|trans }}</h3>
                                    <p>{{ 'profile.banner_formats'|trans }}</p>
                                </div>
                            </div>
                            <div class="profile-banner-actions">
                                <form method="post" action="{{ path('app_profile') }}" enctype="multipart/form-data" class="profile-avatar-form">
                                    <input type="hidden" name="_profile_form" value="banner">
                                    <input type="hidden" name="_token" value="{{ csrf_token('profile_banner') }}">
                                    <input type="file" name="banner" accept="image/png,image/jpeg,image/webp,image/gif" required aria-label="{{ 'profile.banner'|trans }}">
                                    <button type="submit" class="btn btn-sm btn-primary">{{ 'profile.update_banner'|trans }}</button>
                                </form>
                                {% if safeBannerFilename %}
                                    <form method="post" action="{{ path('app_profile') }}" class="profile-avatar-form">
                                        <input type="hidden" name="_profile_form" value="delete_banner">
                                        <input type="hidden" name="_token" value="{{ csrf_token('profile_banner_delete') }}">
                                        <button type="submit" class="btn btn-sm btn-danger">{{ 'profile.delete_banner'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>

                        <div class="info-grid">
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    {{ 'profile.first_name'|trans }}
                                </div>
                                <div class="info-value">{{ user.firstName ?? 'fallback.not_set_m'|trans }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    {{ 'profile.last_name'|trans }}
                                </div>
                                <div class="info-value">{{ user.lastName ?? 'fallback.not_set_m'|trans }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                        <polyline points="22,6 12,13 2,6"/>
                                    </svg>
                                    {{ 'profile.email'|trans }}
                                </div>
                                <div class="info-value">{{ user.email }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                    {{ 'profile.status'|trans }}
                                </div>
                                <div class="info-value">
                                    <span class="status-badge {{ user.verified ? 'verified' : 'inactive' }}">{{ (user.verified ? 'profile.account_verified' : 'profile.account_unverified')|trans }}</span>
                                    {# 🔴 Was `status-badge active` whatever the value, and printed the stored
                                       word (`actif`) rather than a label. Third page with the same
                                       pair of bugs after S84's two lists. #}
                                    <span class="status-badge {{ (user.statut ?? '')|lower|replace({' ': '-', '_': '-'}) }}">{{ user.statusKey|trans }}</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                        <line x1="16" y1="2" x2="16" y2="6"/>
                                        <line x1="8" y1="2" x2="8" y2="6"/>
                                        <line x1="3" y1="10" x2="21" y2="10"/>
                                    </svg>
                                    {{ 'profile.id_number'|trans }}
                                </div>
                                <div class="info-value">{{ user.numeroId ?? 'profile.not_set'|trans }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                                        <line x1="3" y1="6" x2="21" y2="6"/>
                                        <path d="M16 10a4 4 0 0 1-8 0"/>
                                    </svg>
                                    {{ 'profile.registered_on'|trans }}
                                </div>
                                <div class="info-value">{{ user.createdAt|lab_date('d/m/Y H:i') }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">{{ 'profile.username'|trans }}</div>
                                <div class="info-value">{{ user.username }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">{{ 'profile.rfid_uid'|trans }}</div>
                                <div class="info-value">{{ user.identifiantRfid ?? 'fallback.not_set_m'|trans }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">{{ 'profile.last_login'|trans }}</div>
                                <div class="info-value">{{ user.derniereConnexion ? user.derniereConnexion|lab_date('d/m/Y H:i') : 'fallback.never_connected'|trans }}</div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Section Mes Badges -->
                <section class="profile-content-section" id="usage-rights">
                    {% include 'site/_usage_rights_summary.html.twig' with {
                        overview: usageRightsSummary,
                        title: 'usage_rights.profile_section'|trans,
                        description: 'usage_rights.profile_section_description'|trans,
                        id_prefix: 'profile-usage-rights',
                        allowances: usageBudgets,
                    } only %}
                </section>

                <section class="profile-content-section" id="badges">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">{{ 'profile.tab_badges'|trans }}</h2>
                            <div class="badges-stats">
                                <span class="stat-pill">
                                    <span class="pill-value">{{ profileStats.badges }}</span>
                                    <span class="pill-label">{{ 'profile.badges_earned'|trans }}</span>
                                </span>
                                <span class="stat-pill">
                                    <span class="pill-value">{{ profileStats.completedFormations }}</span>
                                    <span class="pill-label">{{ 'profile.formations_validated'|trans }}</span>
                                </span>
                            </div>
                        </div>

                        <div class="badges-grid">
                            {% if userBadges is empty %}
                                <div class="badge-card locked">
                                    <div class="badge-info">
                                        <h3 class="badge-name">{{ 'profile.no_badges'|trans }}</h3>
                                        <p class="badge-description">{{ 'profile.badges_empty'|trans }}</p>
                                    </div>
                                </div>
                            {% else %}
                                {% for userBadge in userBadges %}
                                    {% set badge = userBadge.badge %}
                                    <div class="badge-card obtained">
                                        <div class="badge-icon large profile-badge-visual-shell">
                                            {% include 'site/_badge_visual.html.twig' with {
                                                badge: badge,
                                                formation: null,
                                                size: 'md'
                                            } only %}
                                        </div>
                                        <div class="badge-info">
                                            <h3 class="badge-name">{{ badge.nom }}</h3>
                                            <p class="badge-description">{{ badge.description ?: 'fallback.no_description'|trans }}</p>
                                            <div class="badge-meta">
                                                <span class="badge-level">#{{ badge.id }}</span>
                                                <span class="badge-date">{{ 'profile.obtained_on'|trans({'%date%': userBadge.dateObtention|lab_date('d/m/Y H:i')}) }}</span>
                                            </div>
                                        </div>
                                        <div class="badge-checkmark">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="3">
                                                <polyline points="20,6 9,17 4,12"/>
                                            </svg>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>

                        <div class="section-link">
                            <a href="{{ path('app_formations') }}" class="btn btn-text">
                                {{ 'profile.see_all_trainings'|trans }}
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Section Historique des Réservations -->
                {# Essential-first (S48): identity, badges and what is coming next stay open;
                   the back-catalogue of past bookings is volume, not consequence, so it is
                   disclosed on request. Native <details> — the rows stay in the DOM, so
                   in-page search and "expand all" in print still find them. #}
                <section class="profile-content-section" id="reservations">
                    <details class="section-card profile-disclosure"{% if reservations|default([])|length <= 5 %} open{% endif %}>
                        <summary class="section-card-header">
                            <h2 class="section-card-title">{{ 'profile.reservations_history'|trans }}</h2>
                        </summary>

                        <div class="reservations-table">
                            <div class="reservation-row header">
                                <div class="res-col machine">{{ 'profile.col_machine'|trans }}</div>
                                <div class="res-col date">{{ 'profile.col_date'|trans }}</div>
                                <div class="res-col time">{{ 'profile.col_time'|trans }}</div>
                                <div class="res-col duration">{{ 'profile.col_reason'|trans }}</div>
                                <div class="res-col status">{{ 'home.col_status'|trans }}</div>
                                <div class="res-col actions">{{ 'profile.col_actions'|trans }}</div>
                            </div>

                            {% if reservations is empty %}
                                <div class="reservation-row">
                                    <div class="res-col machine">{{ 'profile.no_reservations'|trans }}</div>
                                    <div class="res-col date"></div>
                                    <div class="res-col time"></div>
                                    <div class="res-col duration"></div>
                                    <div class="res-col status"></div>
                                    <div class="res-col actions"></div>
                                </div>
                            {% else %}
                                {% for reservation in reservations %}
                                    {% set reservationCancelled = reservation.cancelled %}
                                    {% set reservationFuture = reservation.dateDebut > date() %}
                                    {% set reservationStatusClass = reservationCancelled ? 'cancelled' : (reservation.dateFin < date() ? 'completed' : 'confirmed') %}
                                    {% set reservationStatusLabel = reservationCancelled ? 'state.cancelled'|trans : (reservation.dateFin < date() ? 'state.done'|trans : 'state.upcoming'|trans) %}
                                    <div class="reservation-row">
                                        <div class="res-col machine">
                                            {% set res = reservable(reservation) %}
                                            <div class="machine-name">{{ res.name ?: 'fallback.resource'|trans }}</div>
                                            <div class="machine-category">{{ res.type ? ('reservable.type.' ~ res.type.value)|trans : '' }}</div>
                                        </div>
                                        <div class="res-col date">{{ reservation.dateDebut|date('d/m/Y') }}</div>
                                        <div class="res-col time">{{ reservation.dateDebut|date('H:i') }} - {{ reservation.dateFin|date('H:i') }}</div>
                                        <div class="res-col duration">{{ reservation.motif ?: '-' }}</div>
                                        <div class="res-col status">
                                            <span class="status-tag {{ reservationStatusClass }}">{{ reservationStatusLabel }}</span>
                                        </div>
                                        <div class="res-col actions">
                                            {% if not reservationCancelled and reservationFuture %}
                                                <form method="post" action="{{ path('api_reservation_cancel', {id: reservation.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_reservation_' ~ reservation.id) }}">
                                                    <button class="action-btn cancel" type="submit">{{ 'common.cancel'|trans }}</button>
                                                </form>
                                            {% else %}
                                                <span class="user-readonly-note">-</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>

                        <div class="section-link">
                            <a href="{{ path('app_my_reservations') }}" class="btn btn-primary">{{ 'profile.manage_reservations'|trans }}</a>
                        </div>
                    </details>
                </section>

                {% if loansEnabled and myLoans is not empty %}
                <section class="profile-content-section" id="loans">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">{{ 'loans.my_loans'|trans }}</h2>
                        </div>
                        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;">
                            {% for loan in myLoans %}
                                {% set st = loan.effectiveStatus %}
                                {% set label = st == 'returned' ? 'loans.status_returned' : (st == 'overdue' ? 'loans.status_overdue' : 'loans.status_out') %}
                                <li style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border:1px solid var(--border-color);border-radius:10px;flex-wrap:wrap;">
                                    <span style="font-weight:700;">{{ loan.item ? loan.item.name : '—' }}</span>
                                    <span style="padding:3px 10px;border-radius:999px;font-size:12px;font-weight:700;{{ st == 'overdue' ? 'background:#fee2e2;color:#991b1b;' : (st == 'returned' ? 'background:#dcfce7;color:#166534;' : 'background:#dbeafe;color:#1e40af;') }}">{{ label|trans }}</span>
                                    <span style="color:var(--color-text-light);font-size:13px;">{{ loan.dateTaken|date('d/m/Y') }}{% if loan.expectedReturnDate %} → {{ loan.expectedReturnDate|date('d/m/Y') }}{% endif %}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </section>
                {% endif %}

                {% if eventsEnabled and myEventRegistrations is not empty %}
                <section class="profile-content-section" id="event-registrations">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">{{ 'event.registration.title'|trans }}</h2>
                        </div>
                        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;">
                            {% for reg in myEventRegistrations %}
                                <li style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border:1px solid var(--border-color);border-radius:10px;flex-wrap:wrap;">
                                    <a href="{{ path('app_event_detail', {id: reg.event.id}) }}" style="font-weight:700;">{{ reg.event.titre }}</a>
                                    <span style="padding:3px 10px;border-radius:999px;font-size:12px;font-weight:700;{{ reg.waitlisted ? 'background:rgba(245,158,11,.16);color:#b45309;' : 'background:rgba(34,197,94,.16);color:#15803d;' }}">
                                        {{ (reg.waitlisted ? 'event.registration.state_waitlisted' : 'event.registration.state_registered')|trans }}
                                    </span>
                                    <span style="color:var(--color-text-light);font-size:13px;">
                                        {{ reg.event.dateDebut|date('d/m/Y H:i') }}{% if reg.event.cancelled %} · {{ 'event.called_off.banner'|trans }}{% endif %}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </section>
                {% endif %}

                <!-- Section Statistiques -->
                <section class="profile-content-section" id="stats">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">{{ 'profile.my_stats'|trans }}</h2>
                            <div class="stats-period">
                                <span class="period-label">{{ 'profile.all_period'|trans }}</span>
                            </div>
                        </div>

                        <div class="profile-stats-grid">
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ user.tempsPresenceTotal }}</span>
                                    <span class="profile-stat-label">{{ 'profile.total_presence'|trans }}</span>
                                </div>
                            </div>
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ profileStats.completedFormations }}</span>
                                    <span class="profile-stat-label">{{ 'home.stat_completed'|trans }}</span>
                                </div>
                            </div>
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ profileStats.badges }}</span>
                                    <span class="profile-stat-label">{{ 'profile.badges_earned'|trans }}</span>
                                </div>
                            </div>
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ profileStats.reservations }}</span>
                                    <span class="profile-stat-label">{{ 'home.stat_reservations'|trans }}</span>
                                </div>
                            </div>
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ profileStats.rfidLogs }}</span>
                                    <span class="profile-stat-label">{{ 'home.stat_rfid'|trans }}</span>
                                </div>
                            </div>
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ profileStats.machinesUsed }}</span>
                                    <span class="profile-stat-label">{{ 'profile.machines_used'|trans }}</span>
                                </div>
                            </div>
                        </div>

                        <div class="activity-chart">
                            <h3 class="chart-title">{{ 'profile.formations_progress'|trans }}</h3>
                            <div class="reservations-table">
                                <div class="reservation-row header">
                                    <div class="res-col machine">{{ 'profile.col_formation'|trans }}</div>
                                    <div class="res-col date">{{ 'profile.col_score'|trans }}</div>
                                    <div class="res-col time">{{ 'home.col_status'|trans }}</div>
                                    <div class="res-col duration">{{ 'profile.col_start'|trans }}</div>
                                    <div class="res-col status">{{ 'profile.col_end'|trans }}</div>
                                    <div class="res-col actions">{{ 'profile.col_badge'|trans }}</div>
                                </div>
                                {% if progressions is empty %}
                                    <div class="reservation-row"><div class="res-col machine">{{ 'profile.no_progress'|trans }}</div></div>
                                {% else %}
                                    {% for progression in progressions %}
                                        <div class="reservation-row">
                                            <div class="res-col machine">{{ progression.formation ? progression.formation.titre : 'fallback.formation'|trans }}</div>
                                            <div class="res-col date">{{ progression.score }}</div>
                                            <div class="res-col time">{{ progression.completed ? 'state.completed_f'|trans : 'state.doing'|trans }}</div>
                                            <div class="res-col duration">{{ progression.dateDebut|lab_date('d/m/Y H:i') }}</div>
                                            <div class="res-col status">{{ progression.dateEnd ? progression.dateEnd|lab_date('d/m/Y H:i') : '-' }}</div>
                                            <div class="res-col actions">{{ progression.formation and progression.formation.badge ? progression.formation.badge.nom : '-' }}</div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>

                        <div class="activity-chart">
                            <h3 class="chart-title">{{ 'profile.rfid_activity'|trans }}</h3>
                            <div class="reservations-table">
                                <div class="reservation-row header">
                                    <div class="res-col machine">{{ 'profile.col_date'|trans }}</div>
                                    <div class="res-col date">{{ 'profile.col_badge_uid'|trans }}</div>
                                    <div class="res-col time">{{ 'profile.col_machine'|trans }}</div>
                                    <div class="res-col duration">{{ 'profile.col_authorized'|trans }}</div>
                                    <div class="res-col status">{{ 'home.col_status'|trans }}</div>
                                    <div class="res-col actions">{{ 'profile.col_message'|trans }}</div>
                                </div>
                                {% if rfidLogs is empty %}
                                    <div class="reservation-row"><div class="res-col machine">{{ 'profile.no_rfid'|trans }}</div></div>
                                {% else %}
                                    {% for log in rfidLogs|slice(0, 10) %}
                                        <div class="reservation-row">
                                            <div class="res-col machine">{{ log.createdAt|lab_date('d/m/Y H:i') }}</div>
                                            <div class="res-col date">{{ log.badgeUid }}</div>
                                            <div class="res-col time">{{ log.machine ? log.machine.nom : 'fallback.machine'|trans }}</div>
                                            <div class="res-col duration">{{ log.authorized ? 'common.yes'|trans : 'common.no'|trans }}</div>
                                            <div class="res-col status"><span class="status-tag {{ log.authorized ? 'completed' : 'cancelled' }}">{{ log.status }}</span></div>
                                            <div class="res-col actions">{{ log.message ?: log.reason ?: '-' }}</div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>

                        <div class="activity-chart">
                            <h3 class="chart-title">{{ 'profile.usage_logs'|trans }}</h3>
                            <div class="reservations-table">
                                <div class="reservation-row header">
                                    <div class="res-col machine">{{ 'profile.col_machine'|trans }}</div>
                                    <div class="res-col date">{{ 'profile.col_start'|trans }}</div>
                                    <div class="res-col time">{{ 'profile.col_end'|trans }}</div>
                                    <div class="res-col duration">{{ 'profile.col_duration'|trans }}</div>
                                    <div class="res-col status">{{ 'profile.col_source'|trans }}</div>
                                    <div class="res-col actions">{{ 'profile.col_created'|trans }}</div>
                                </div>
                                {% if usageLogs is empty %}
                                    <div class="reservation-row"><div class="res-col machine">{{ 'profile.no_usage'|trans }}</div></div>
                                {% else %}
                                    {% for usageLog in usageLogs %}
                                        <div class="reservation-row">
                                            <div class="res-col machine">{{ usageLog.machine ? usageLog.machine.nom : 'fallback.machine'|trans }}</div>
                                            <div class="res-col date">{{ usageLog.dateDebut|lab_date('d/m/Y H:i') }}</div>
                                            <div class="res-col time">{{ usageLog.dateFin ? usageLog.dateFin|lab_date('d/m/Y H:i') : '-' }}</div>
                                            <div class="res-col duration">{{ usageLog.duree is not null ? usageLog.duree ~ ' min' : '-' }}</div>
                                            <div class="res-col status">{{ usageLog.source ?: '-' }}</div>
                                            <div class="res-col actions">{{ usageLog.createdAt|lab_date('d/m/Y H:i') }}</div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </section>

                <section class="profile-content-section" id="public-profile">
                    <div class="section-card">
                        <div class="section-card-header"><h2 class="section-card-title">{{ 'public_profile.settings'|trans }}</h2>{% if user.publicProfileEnabled and user.publicSlug %}<a class="btn btn-sm" href="{{ path('app_public_member', {slug: user.publicSlug}) }}">{{ 'public_profile.preview'|trans }}</a>{% endif %}</div>
                        <form method="post" action="{{ path('app_profile') }}" class="settings-form">
                            <input type="hidden" name="_profile_form" value="public_profile"><input type="hidden" name="_token" value="{{ csrf_token('public_profile') }}">
                            <p>{{ 'public_profile.private_default'|trans }}</p>
                            <label><input type="checkbox" name="publicProfileEnabled" value="1"{{ user.publicProfileEnabled ? ' checked' : '' }}> {{ 'public_profile.enable'|trans }}</label>
                            <div class="form-field"><label for="public-slug">{{ 'public_profile.slug'|trans }}</label><input id="public-slug" name="publicSlug" value="{{ user.publicSlug }}" maxlength="80" placeholder="prenom-nom"></div>
                            <div class="form-field"><label for="public-bio">{{ 'public_profile.bio'|trans }}</label><textarea id="public-bio" name="publicBio" maxlength="500">{{ user.publicBio }}</textarea></div>
                            <fieldset><legend>{{ 'public_profile.visible_fields'|trans }}</legend>{% for field in ['name', 'avatar', 'bio', 'badges', 'trainings'] %}<label><input type="checkbox" name="publicFields[]" value="{{ field }}"{{ field in user.publicFields ? ' checked' : '' }}> {{ ('public_profile.field.' ~ field)|trans }}</label>{% endfor %}</fieldset>
                            <div class="settings-footer"><button class="btn btn-primary" type="submit">{{ 'common.save'|trans }}</button></div>
                        </form>
                        <details><summary>{{ 'network.exchange'|trans }}</summary><form method="post" action="{{ path('app_profile_network_qr') }}" class="form-grid"><input type="hidden" name="_token" value="{{ csrf_token('network_exchange') }}"><div class="form-field"><label>{{ 'network.destination'|trans }}</label><input name="audienceUuid" required aria-label="{{ 'network.destination'|trans }}" placeholder="00000000-0000-4000-8000-000000000000"></div><label><input type="checkbox" name="consent" value="1" required> {{ 'network.exchange_consent'|trans }}</label><button class="btn btn-primary">{{ 'network.download_qr'|trans }}</button></form></details>
                    </div>
                </section>

                <!-- Section Paramètres -->
                <section class="profile-content-section" id="settings">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">{{ 'profile.account_settings'|trans }}</h2>
                        </div>
                        
                        <form method="post" action="{{ path('app_profile') }}" class="settings-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('profile_preferences') }}">
                            <div class="settings-grid">
                            <div class="settings-section">
                                <h3 class="settings-subtitle">{{ 'profile.notif_prefs'|trans }}</h3>
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>{{ 'profile.notif_email'|trans }}</h4>
                                        <p>{{ 'profile.notif_email_desc'|trans }}</p>
                                    </div>
                                    <div class="setting-toggle">
                                        <label class="switch">
                                            <input type="checkbox" name="notificationEmail" value="1" {{ user.notificationEmail ? 'checked' : '' }}>
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>
                                
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>{{ 'profile.notif_push'|trans }}</h4>
                                        <p>{{ 'profile.notif_push_desc'|trans }}</p>
                                    </div>
                                    <div class="setting-toggle">
                                        <label class="switch">
                                            <input type="checkbox" name="notificationPush" value="1" {{ user.notificationPush ? 'checked' : '' }}>
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>

                                {# Per-category switches. These replace the old single
                                   "rappelReservation" toggle, which nothing ever read. #}
                                {% for category, accepted in notificationCategories %}
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>{{ ('notification.category.' ~ category ~ '.label')|trans }}</h4>
                                        <p>{{ ('notification.category.' ~ category ~ '.description')|trans }}</p>
                                    </div>
                                    <div class="setting-toggle">
                                        <label class="switch">
                                            <input type="checkbox" name="notify_{{ category }}" value="1" {{ accepted ? 'checked' : '' }}>
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>

                            <div class="settings-section">
                                <h3 class="settings-subtitle">{{ 'profile.security'|trans }}</h3>
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>{{ 'profile.change_password'|trans }}</h4>
                                        <p>{{ 'profile.change_password_desc'|trans }}</p>
                                    </div>
                                    <div class="setting-action">
                                        <a href="{{ path('app_profile_password') }}" class="btn btn-sm">{{ 'profile.change_password_btn'|trans }}</a>
                                    </div>
                                </div>

                                {# ⚠️ A LINK, not a form. Erasure is the one irreversible
                                   control a member has, so it opens a page that can say
                                   what leaves and what stays before anything happens —
                                   a submit button here would put it one stray click from
                                   a settings form people scroll through. #}
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>{{ 'account_delete.title'|trans }}</h4>
                                        <p>{{ 'account_delete.intro'|trans }}</p>
                                    </div>
                                    <div class="setting-action">
                                        <a href="{{ path('app_profile_delete') }}" class="btn btn-sm btn-danger">{{ 'account_delete.title'|trans }}</a>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-section">
                                <h3 class="settings-subtitle">{{ 'profile.display_prefs'|trans }}</h3>
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>{{ 'profile.preferred_venue'|trans }}</h4>
                                        <p>{{ 'profile.preferred_venue_help'|trans }}</p>
                                    </div>
                                    <div class="setting-action">
                                        <select name="preferredVenue">
                                            <option value="">{{ 'profile.all_venues'|trans }}</option>
                                            {% for venue in activeVenues %}
                                                <option value="{{ venue.slug }}"{{ user.preferredVenue and user.preferredVenue.id == venue.id ? ' selected' : '' }}>{{ venue.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>{{ 'profile.theme'|trans }}</h4>
                                        <p>{{ 'profile.theme_desc'|trans }}</p>
                                    </div>
                                    <div class="setting-action">
                                        <select class="theme-select" name="theme" data-theme-select required>
                                            <option value="light" {{ user.theme == 'light' ? 'selected' : '' }}>{{ 'profile.theme_light'|trans }}</option>
                                            <option value="dark" {{ user.theme == 'dark' ? 'selected' : '' }}>{{ 'profile.theme_dark'|trans }}</option>
                                            <option value="system" {{ user.theme == 'system' ? 'selected' : '' }}>{{ 'profile.theme_system'|trans }}</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>{{ 'profile.language'|trans }}</h4>
                                        <p>{{ 'profile.language_desc'|trans }}</p>
                                    </div>
                                    <div class="setting-action">
                                        <select class="lang-select" name="langue" required>
                                            {# Was a hardcoded fr/en pair while the app enables
                                               five languages, so three of them were unreachable
                                               from a member's own profile. #}
                                            {% for code, label in availableLocales %}
                                                <option value="{{ code }}" {{ user.langue == code ? 'selected' : '' }}>{{ label }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>

                        </div>

                            <div class="settings-footer">
                                <button type="submit" class="btn btn-primary">{{ 'profile.save_prefs'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </section>
    </main>

    <!-- ========================================
         FOOTER
         ======================================== -->
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
{% endblock %}
