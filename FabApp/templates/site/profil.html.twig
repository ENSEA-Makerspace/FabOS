<!DOCTYPE html>
<html lang="fr" data-theme-preference="{{ user.theme }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ user.displayName }} - Profil FabOS</title>
    <script>
        (() => {
            const preference = {{ user.theme|json_encode|raw }};
            const resolved = preference === 'system'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : preference;
            document.documentElement.dataset.theme = resolved;
            document.documentElement.dataset.themePreference = preference;
        })();
    </script>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260710-profile-machine-detail' }}">
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260709-fusion-home-rating' }}">
    <link rel="stylesheet" href="{{ asset('css/badges.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    <!-- ========================================
         BANDEAU D'ALERTE
         ======================================== -->
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <!-- ========================================
         HEADER
         ======================================== -->
    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    {% include 'site/_logo.html.twig' %}
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">Accueil</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">Calendrier</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">Machines</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">Formations</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">Leaderboard</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">Admin</a>
                    {% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- ========================================
         CONTENU PRINCIPAL - PROFIL UTILISATEUR
         ======================================== -->
    <main class="main-content">
        <section class="profile-section">
            <div class="container">
                {% for message in app.flashes('success') %}
                    <div class="profile-flash success">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="profile-flash error">{{ message }}</div>
                {% endfor %}
                <!-- En-tête de profil -->
                {% set bannerFilename = user.bannerFilename %}
                {% set safeBannerFilename = bannerFilename and bannerFilename matches '/^[A-Za-z0-9._-]+$/' ? bannerFilename : null %}
                <div class="profile-header">
                    <div class="section-badge profile-badge">Mon Profil</div>
                    <div class="profile-banner {{ safeBannerFilename ? 'has-custom-banner' : '' }}">
                        <div class="profile-theme-control">
                            <button
                                type="button"
                                class="day-night-switch"
                                data-theme-switch
                                data-save-url="{{ path('app_profile') }}"
                                data-csrf-token="{{ csrf_token('profile_preferences') }}"
                                role="switch"
                                aria-checked="{{ user.theme == 'dark' ? 'true' : 'false' }}"
                                aria-label="Activer le thème sombre"
                                title="Changer le thème"
                            >
                                <span class="day-night-switch__track" aria-hidden="true">
                                    <span class="day-night-switch__stars">
                                        <i></i><i></i><i></i><i></i><i></i>
                                    </span>
                                    <span class="day-night-switch__clouds">
                                        <i></i><i></i><i></i>
                                    </span>
                                    <span class="day-night-switch__orb">
                                        <i class="day-night-switch__crater day-night-switch__crater--one"></i>
                                        <i class="day-night-switch__crater day-night-switch__crater--two"></i>
                                        <i class="day-night-switch__crater day-night-switch__crater--three"></i>
                                    </span>
                                </span>
                                <span class="sr-only">Basculer entre le thème clair et le thème sombre</span>
                            </button>
                            <span class="theme-switch-caption" data-theme-switch-label aria-live="polite"></span>
                        </div>
                        <div class="profile-cover">
                            {% if safeBannerFilename %}
                                <img src="{{ asset('uploads/profile-banners/' ~ safeBannerFilename) }}" alt="Bannière de profil de {{ user.displayName }}" class="profile-cover-image">
                            {% endif %}
                            <div class="cover-overlay"></div>
                        </div>
                        <div class="profile-avatar-large">
                            {% include 'site/_user_avatar.html.twig' with {user: user, size: 96, class: 'profile-user-avatar', alt: user.displayName} only %}
                            <div class="avatar-status online"></div>
                        </div>
                        <div class="profile-info-main">
                            <h1 class="profile-name">{{ user.displayName }}</h1>
                            <p class="profile-email">{{ user.email }}</p>
                            <p class="profile-student-id">Numéro étudiant: {{ user.numeroId ?? 'Non renseigné' }}</p>
                        </div>
                    </div>

                    <!-- Navigation profil -->
                    <div class="profile-nav">
                        <a href="#info" class="profile-nav-link active">Informations personnelles</a>
                        <a href="#badges" class="profile-nav-link">Mes badges</a>
                        <a href="#reservations" class="profile-nav-link">Historique</a>
                        <a href="#stats" class="profile-nav-link">Statistiques</a>
                        <a href="#settings" class="profile-nav-link">Paramètres</a>
                    </div>
                </div>

                <!-- Section Informations Personnelles -->
                <section class="profile-content-section" id="info">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">Informations personnelles</h2>
                            <button class="btn btn-sm btn-secondary edit-btn" disabled>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                                Modification bientôt disponible
                            </button>
                        </div>
                        

                        <div class="profile-avatar-settings">
                            <div class="profile-avatar-preview">
                                {% include 'site/_user_avatar.html.twig' with {user: user, size: 88, class: 'profile-settings-avatar', alt: user.displayName} only %}
                                <div>
                                    <h3>Photo de profil</h3>
                                    <p>Formats acceptés : PNG, JPG, JPEG, WEBP. Taille max : 2 Mo.</p>
                                </div>
                            </div>
                            <form method="post" action="{{ path('app_profile') }}" enctype="multipart/form-data" class="profile-avatar-form">
                                <input type="hidden" name="_profile_form" value="avatar">
                                <input type="hidden" name="_token" value="{{ csrf_token('profile_avatar') }}">
                                <input type="file" name="avatar" accept="image/png,image/jpeg,image/webp" required>
                                <button type="submit" class="btn btn-sm btn-primary">Mettre à jour la photo</button>
                            </form>
                        </div>

                        <div class="profile-avatar-settings profile-banner-settings">
                            <div class="profile-avatar-preview profile-banner-preview">
                                {% if safeBannerFilename %}
                                    <img src="{{ asset('uploads/profile-banners/' ~ safeBannerFilename) }}" alt="Bannière actuelle" class="profile-banner-preview-image">
                                {% else %}
                                    <div class="profile-banner-preview-default"></div>
                                {% endif %}
                                <div>
                                    <h3>Bannière de profil</h3>
                                    <p>Formats acceptés : PNG, JPG, JPEG, WEBP, GIF. Taille max : 5 Mo.</p>
                                </div>
                            </div>
                            <div class="profile-banner-actions">
                                <form method="post" action="{{ path('app_profile') }}" enctype="multipart/form-data" class="profile-avatar-form">
                                    <input type="hidden" name="_profile_form" value="banner">
                                    <input type="hidden" name="_token" value="{{ csrf_token('profile_banner') }}">
                                    <input type="file" name="banner" accept="image/png,image/jpeg,image/webp,image/gif" required>
                                    <button type="submit" class="btn btn-sm btn-primary">Mettre à jour la bannière</button>
                                </form>
                                {% if safeBannerFilename %}
                                    <form method="post" action="{{ path('app_profile') }}" class="profile-avatar-form">
                                        <input type="hidden" name="_profile_form" value="delete_banner">
                                        <input type="hidden" name="_token" value="{{ csrf_token('profile_banner_delete') }}">
                                        <button type="submit" class="btn btn-sm btn-danger">Supprimer ma bannière</button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>

                        <div class="info-grid">
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    Prénom
                                </div>
                                <div class="info-value">{{ user.firstName ?? 'Non renseigné' }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    Nom
                                </div>
                                <div class="info-value">{{ user.lastName ?? 'Non renseigné' }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                        <polyline points="22,6 12,13 2,6"/>
                                    </svg>
                                    Email
                                </div>
                                <div class="info-value">{{ user.email }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                    Statut
                                </div>
                                <div class="info-value">
                                    <span class="status-badge {{ user.verified ? 'verified' : 'inactive' }}">{{ user.verified ? 'Compte vérifié' : 'Compte non vérifié' }}</span>
                                    <span class="status-badge active">{{ user.statut }}</span>
                                </div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                        <line x1="16" y1="2" x2="16" y2="6"/>
                                        <line x1="8" y1="2" x2="8" y2="6"/>
                                        <line x1="3" y1="10" x2="21" y2="10"/>
                                    </svg>
                                    Numéro étudiant
                                </div>
                                <div class="info-value">{{ user.numeroId ?? 'Non renseigné' }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                                        <line x1="3" y1="6" x2="21" y2="6"/>
                                        <path d="M16 10a4 4 0 0 1-8 0"/>
                                    </svg>
                                    Date d'inscription
                                </div>
                                <div class="info-value">{{ user.createdAt|date('d/m/Y H:i') }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Username</div>
                                <div class="info-value">{{ user.username }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">UID RFID</div>
                                <div class="info-value">{{ user.identifiantRfid ?? 'Non renseigné' }}</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Dernière connexion</div>
                                <div class="info-value">{{ user.derniereConnexion ? user.derniereConnexion|date('d/m/Y H:i') : 'Jamais connecté' }}</div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Section Mes Badges -->
                <section class="profile-content-section" id="badges">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">Mes badges</h2>
                            <div class="badges-stats">
                                <span class="stat-pill">
                                    <span class="pill-value">{{ profileStats.badges }}</span>
                                    <span class="pill-label">Badges obtenus</span>
                                </span>
                                <span class="stat-pill">
                                    <span class="pill-value">{{ profileStats.completedFormations }}</span>
                                    <span class="pill-label">Formations validées</span>
                                </span>
                            </div>
                        </div>

                        <div class="badges-grid">
                            {% if userBadges is empty %}
                                <div class="badge-card locked">
                                    <div class="badge-info">
                                        <h3 class="badge-name">Aucun badge obtenu pour le moment.</h3>
                                        <p class="badge-description">Les badges obtenus via les formations apparaitront ici.</p>
                                    </div>
                                </div>
                            {% else %}
                                {% for userBadge in userBadges %}
                                    {% set badge = userBadge.badge %}
                                    <div class="badge-card obtained">
                                        <div class="badge-icon large profile-badge-visual-shell">
                                            {% include 'site/_badge_visual.html.twig' with {
                                                badge: badge,
                                                formation: null,
                                                size: 'md'
                                            } only %}
                                        </div>
                                        <div class="badge-info">
                                            <h3 class="badge-name">{{ badge.nom }}</h3>
                                            <p class="badge-description">{{ badge.description ?: 'Sans description' }}</p>
                                            <div class="badge-meta">
                                                <span class="badge-level">#{{ badge.id }}</span>
                                                <span class="badge-date">Obtenu le {{ userBadge.dateObtention|date('d/m/Y H:i') }}</span>
                                            </div>
                                        </div>
                                        <div class="badge-checkmark">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="3">
                                                <polyline points="20,6 9,17 4,12"/>
                                            </svg>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>

                        <div class="section-link">
                            <a href="{{ path('app_formations') }}" class="btn btn-text">
                                Voir toutes les formations disponibles
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Section Historique des Réservations -->
                <section class="profile-content-section" id="reservations">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">Historique des réservations</h2>
                            <div class="filter-tabs">
                                <button class="filter-tab active" disabled>Toutes</button>
                                <button class="filter-tab" disabled>À venir</button>
                                <button class="filter-tab" disabled>Passées</button>
                            </div>
                        </div>

                        <div class="reservations-table">
                            <div class="reservation-row header">
                                <div class="res-col machine">Machine</div>
                                <div class="res-col date">Date</div>
                                <div class="res-col time">Heure</div>
                                <div class="res-col duration">Motif</div>
                                <div class="res-col status">Statut</div>
                                <div class="res-col actions">Actions</div>
                            </div>

                            {% if reservations is empty %}
                                <div class="reservation-row">
                                    <div class="res-col machine">Aucune réservation pour le moment.</div>
                                    <div class="res-col date"></div>
                                    <div class="res-col time"></div>
                                    <div class="res-col duration"></div>
                                    <div class="res-col status"></div>
                                    <div class="res-col actions"></div>
                                </div>
                            {% else %}
                                {% for reservation in reservations %}
                                    {% set reservationCancelled = reservation.cancelled %}
                                    {% set reservationFuture = reservation.dateDebut > date() %}
                                    {% set reservationStatusClass = reservationCancelled ? 'cancelled' : (reservation.dateFin < date() ? 'completed' : 'confirmed') %}
                                    {% set reservationStatusLabel = reservationCancelled ? 'Annulée' : (reservation.dateFin < date() ? 'Terminée' : 'À venir') %}
                                    <div class="reservation-row">
                                        <div class="res-col machine">
                                            <div class="machine-name">{{ reservation.machine ? reservation.machine.nom : 'Machine inconnue' }}</div>
                                            <div class="machine-category">{{ reservation.machine ? reservation.machine.localisation ?: 'Localisation non renseignée' : '' }}</div>
                                        </div>
                                        <div class="res-col date">{{ reservation.dateDebut|date('d/m/Y') }}</div>
                                        <div class="res-col time">{{ reservation.dateDebut|date('H:i') }} - {{ reservation.dateFin|date('H:i') }}</div>
                                        <div class="res-col duration">{{ reservation.motif ?: '-' }}</div>
                                        <div class="res-col status">
                                            <span class="status-tag {{ reservationStatusClass }}">{{ reservationStatusLabel }}</span>
                                        </div>
                                        <div class="res-col actions">
                                            {% if not reservationCancelled and reservationFuture %}
                                                <form method="post" action="{{ path('api_reservation_cancel', {id: reservation.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_reservation_' ~ reservation.id) }}">
                                                    <button class="action-btn cancel" type="submit">Annuler</button>
                                                </form>
                                            {% else %}
                                                <span class="user-readonly-note">-</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>

                        <div class="section-link">
                            <a href="{{ path('app_my_reservations') }}" class="btn btn-primary">Gérer mes réservations</a>
                        </div>
                    </div>
                </section>

                <!-- Section Statistiques -->
                <section class="profile-content-section" id="stats">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">Mes statistiques</h2>
                            <div class="stats-period">
                                <select class="period-select" disabled>
                                    <option value="all">Toute la période</option>
                                </select>
                            </div>
                        </div>

                        <div class="profile-stats-grid">
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ user.tempsPresenceTotal }}</span>
                                    <span class="profile-stat-label">Temps de présence total</span>
                                </div>
                            </div>
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ profileStats.completedFormations }}</span>
                                    <span class="profile-stat-label">Formations complétées</span>
                                </div>
                            </div>
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ profileStats.badges }}</span>
                                    <span class="profile-stat-label">Badges obtenus</span>
                                </div>
                            </div>
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ profileStats.reservations }}</span>
                                    <span class="profile-stat-label">Réservations</span>
                                </div>
                            </div>
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ profileStats.rfidLogs }}</span>
                                    <span class="profile-stat-label">Passages RFID</span>
                                </div>
                            </div>
                            <div class="profile-stat-card">
                                <div class="profile-stat-info">
                                    <span class="profile-stat-value">{{ profileStats.machinesUsed }}</span>
                                    <span class="profile-stat-label">Machines utilisées</span>
                                </div>
                            </div>
                        </div>

                        <div class="activity-chart">
                            <h3 class="chart-title">Formations et progressions</h3>
                            <div class="reservations-table">
                                <div class="reservation-row header">
                                    <div class="res-col machine">Formation</div>
                                    <div class="res-col date">Score</div>
                                    <div class="res-col time">Statut</div>
                                    <div class="res-col duration">Début</div>
                                    <div class="res-col status">Fin</div>
                                    <div class="res-col actions">Badge</div>
                                </div>
                                {% if progressions is empty %}
                                    <div class="reservation-row"><div class="res-col machine">Aucune progression enregistrée.</div></div>
                                {% else %}
                                    {% for progression in progressions %}
                                        <div class="reservation-row">
                                            <div class="res-col machine">{{ progression.formation ? progression.formation.titre : 'Formation inconnue' }}</div>
                                            <div class="res-col date">{{ progression.score }}</div>
                                            <div class="res-col time">{{ progression.completed ? 'Complétée' : 'En cours' }}</div>
                                            <div class="res-col duration">{{ progression.dateDebut|date('d/m/Y H:i') }}</div>
                                            <div class="res-col status">{{ progression.dateEnd ? progression.dateEnd|date('d/m/Y H:i') : '-' }}</div>
                                            <div class="res-col actions">{{ progression.formation and progression.formation.badge ? progression.formation.badge.nom : '-' }}</div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>

                        <div class="activity-chart">
                            <h3 class="chart-title">Activité récente RFID</h3>
                            <div class="reservations-table">
                                <div class="reservation-row header">
                                    <div class="res-col machine">Date</div>
                                    <div class="res-col date">Badge UID</div>
                                    <div class="res-col time">Machine</div>
                                    <div class="res-col duration">Autorisé</div>
                                    <div class="res-col status">Statut</div>
                                    <div class="res-col actions">Message</div>
                                </div>
                                {% if rfidLogs is empty %}
                                    <div class="reservation-row"><div class="res-col machine">Aucun passage RFID enregistré.</div></div>
                                {% else %}
                                    {% for log in rfidLogs|slice(0, 10) %}
                                        <div class="reservation-row">
                                            <div class="res-col machine">{{ log.createdAt|date('d/m/Y H:i') }}</div>
                                            <div class="res-col date">{{ log.badgeUid }}</div>
                                            <div class="res-col time">{{ log.machine ? log.machine.nom : 'Machine inconnue' }}</div>
                                            <div class="res-col duration">{{ log.authorized ? 'Oui' : 'Non' }}</div>
                                            <div class="res-col status"><span class="status-tag {{ log.authorized ? 'completed' : 'cancelled' }}">{{ log.status }}</span></div>
                                            <div class="res-col actions">{{ log.message ?: log.reason ?: '-' }}</div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>

                        <div class="activity-chart">
                            <h3 class="chart-title">Logs d'utilisation</h3>
                            <div class="reservations-table">
                                <div class="reservation-row header">
                                    <div class="res-col machine">Machine</div>
                                    <div class="res-col date">Début</div>
                                    <div class="res-col time">Fin</div>
                                    <div class="res-col duration">Durée</div>
                                    <div class="res-col status">Source</div>
                                    <div class="res-col actions">Créé le</div>
                                </div>
                                {% if usageLogs is empty %}
                                    <div class="reservation-row"><div class="res-col machine">Aucun log d’utilisation enregistré.</div></div>
                                {% else %}
                                    {% for usageLog in usageLogs %}
                                        <div class="reservation-row">
                                            <div class="res-col machine">{{ usageLog.machine ? usageLog.machine.nom : 'Machine inconnue' }}</div>
                                            <div class="res-col date">{{ usageLog.dateDebut|date('d/m/Y H:i') }}</div>
                                            <div class="res-col time">{{ usageLog.dateFin ? usageLog.dateFin|date('d/m/Y H:i') : '-' }}</div>
                                            <div class="res-col duration">{{ usageLog.duree is not null ? usageLog.duree ~ ' min' : '-' }}</div>
                                            <div class="res-col status">{{ usageLog.source ?: '-' }}</div>
                                            <div class="res-col actions">{{ usageLog.createdAt|date('d/m/Y H:i') }}</div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Section Paramètres -->
                <section class="profile-content-section" id="settings">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">Paramètres du compte</h2>
                        </div>
                        
                        <form method="post" action="{{ path('app_profile') }}" class="settings-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('profile_preferences') }}">
                            <div class="settings-grid">
                            <div class="settings-section">
                                <h3 class="settings-subtitle">Préférences de notification</h3>
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>Notifications par email</h4>
                                        <p>Recevoir des notifications pour les réservations et annulations</p>
                                    </div>
                                    <div class="setting-toggle">
                                        <label class="switch">
                                            <input type="checkbox" name="notificationEmail" value="1" {{ user.notificationEmail ? 'checked' : '' }}>
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>
                                
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>Notifications push</h4>
                                        <p>Activer les notifications dans le navigateur</p>
                                    </div>
                                    <div class="setting-toggle">
                                        <label class="switch">
                                            <input type="checkbox" name="notificationPush" value="1" {{ user.notificationPush ? 'checked' : '' }}>
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>

                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>Rappels de réservation</h4>
                                        <p>Recevoir un rappel 1h avant chaque réservation</p>
                                    </div>
                                    <div class="setting-toggle">
                                        <label class="switch">
                                            <input type="checkbox" name="rappelReservation" value="1" {{ user.rappelReservation ? 'checked' : '' }}>
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-section">
                                <h3 class="settings-subtitle">Sécurité</h3>
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>Changer le mot de passe</h4>
                                        <p>Mettre à jour votre mot de passe</p>
                                    </div>
                                    <div class="setting-action">
                                        <a href="{{ path('app_profile_password') }}" class="btn btn-sm">Changer mon mot de passe</a>
                                    </div>
                                </div>
                                
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>Authentification à deux facteurs</h4>
                                        <p>Ajouter une couche de sécurité supplémentaire</p>
                                    </div>
                                    <div class="setting-action">
                                        <button class="btn btn-sm btn-secondary" disabled>Modification bientôt disponible</button>
                                    </div>
                                </div>

                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>Sessions actives</h4>
                                        <p>Gérer les appareils connectés à votre compte</p>
                                    </div>
                                    <div class="setting-action">
                                        <button class="btn btn-sm" disabled>Modification bientôt disponible</button>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-section">
                                <h3 class="settings-subtitle">Préférences d'affichage</h3>
                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>Thème</h4>
                                        <p>Choisir entre le mode clair et sombre</p>
                                    </div>
                                    <div class="setting-action">
                                        <select class="theme-select" name="theme" data-theme-select required>
                                            <option value="light" {{ user.theme == 'light' ? 'selected' : '' }}>Clair</option>
                                            <option value="dark" {{ user.theme == 'dark' ? 'selected' : '' }}>Sombre</option>
                                            <option value="system" {{ user.theme == 'system' ? 'selected' : '' }}>Système</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="setting-item">
                                    <div class="setting-info">
                                        <h4>Langue</h4>
                                        <p>Langue de l'interface</p>
                                    </div>
                                    <div class="setting-action">
                                        <select class="lang-select" name="langue" required>
                                            <option value="fr" {{ user.langue == 'fr' ? 'selected' : '' }}>Français</option>
                                            <option value="en" {{ user.langue == 'en' ? 'selected' : '' }}>English</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-section danger-zone">
                                <h3 class="settings-subtitle">Zone dangereuse</h3>
                                <div class="setting-item danger">
                                    <div class="setting-info">
                                        <h4>Supprimer mon compte</h4>
                                        <p>Cette action est irréversible. Toutes vos données seront supprimées.</p>
                                    </div>
                                    <div class="setting-action">
                                        <button class="btn btn-sm btn-danger" disabled>Modification bientôt disponible</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                            <div class="settings-footer">
                                <button type="submit" class="btn btn-primary">Enregistrer les préférences</button>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </section>
    </main>

    <!-- ========================================
         FOOTER
         ======================================== -->
    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') ~ '?v=20260708-theme-switch-fix' }}"></script>
</body>
</html>
