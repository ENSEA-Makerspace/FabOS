{% extends 'base.html.twig' %}

{#
   Annuaire des utilisateurs : les tuiles trient par TRAVAIL (à valider, suspendus, expire bientôt,
   sans badge — `AdminUserDirectory`). Les filtres Groupe et Forfait (`AudienceResolver`, côté
   contrôleur) et le bouton de création restent. ⚠️ Un commentaire Twig entre deux clés d'un hash
   d'arguments est une erreur de syntaxe : celui-ci reste hors des `with { … }`.
#}

{% block title %}{{ 'admin_users.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/pages.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/page-annuaire-utilisateurs.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'admin_users.action_label'|trans,
    action_route: 'app_admin_user_new',
    panel_title: 'admin_users.panel_title'|trans,
    list_count: directory.shown,
    list_total: directory.total,
    list_route: 'app_admin_users',
    list_search: filters.q|default(''),
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_query: {tuile: directory.tile, package: filters.package|default(''), groupe: filters.groupe|default('')},
    list_tiles_label: 'admin_user_directory.tiles_label'|trans,
    list_tiles: directory.tiles,
    list_refine: []|merge(groupChoices|length > 0 ? [
        {name: 'groupe', label: 'admin_users.filter_group'|trans, value: filters.groupe|default(''), options: [{value: '', label: 'admin_list.all'|trans}]|merge(groupChoices|map(g => {value: g.id, label: g.label}))},
    ] : [])|merge(packageChoices|length > 0 ? [
        {name: 'package', label: 'admin_users.filter_package'|trans, value: filters.package|default(''), options: [{value: '', label: 'admin_list.all'|trans}]|merge(packageChoices|map(p => {value: p.id, label: p.name}))},
    ] : []),
} %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'admin_users.col_member'|trans, class: 'is-grow'},
                {label: 'admin_users.col_status'|trans, class: 'is-tight'},
                {label: 'admin_user_directory.col_trainings'|trans, class: 'is-tight'},
                {label: 'admin_user_directory.col_last'|trans, class: 'is-tight'},
                {label: 'common.see'|trans, class: 'is-actions'},
            ],
            rows: directory.rows,
            empty: 'admin_users.empty'|trans,
        } %}
            {% block rows %}
                {% for row in directory.rows %}
                    <tr>
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: row.name,
                            href: path('app_admin_user_detail', {id: row.id}),
                            subtitle: row.email,
                            media: include('site/_cell_media.html.twig', {
                                initials: row.initials,
                                shape: 'circle',
                            }, with_context = false),
                        } only %}</td>
                        <td>
                            {% include 'site/_cell_state.html.twig' with { label: row.statusKey|trans, signal: row.signal } only %}
                            {% if row.note %}
                                <div class="pp-au-note">
                                    {{ row.note }}{% if row.until %} · {{ 'admin_user_directory.until'|trans({'%date%': row.until|date('d/m/Y')}) }}{% endif %}
                                </div>
                            {% endif %}
                        </td>
                        <td>{% include 'site/_cell_meter.html.twig' with {
                            value: row.trainingsDone,
                            max: directory.formationsTotal,
                            signal: directory.formationsTotal > 0 and row.trainingsDone >= directory.formationsTotal ? 'go' : '',
                            label: (row.hasBadge ? 'admin_user_directory.badge_registered' : 'admin_user_directory.tile_no_badge')|trans,
                        } only %}</td>
                        <td>
                            {% if row.last %}
                                <div class="pp-au-last">{{ row.last|lab_date('d/m/Y H:i') }}</div>
                                <div class="pp-au-note">{{ row.lastKind }}</div>
                            {% else %}
                                {% include 'site/_cell_empty.html.twig' with { reason: 'admin_user_directory.no_activity' } only %}
                            {% endif %}
                        </td>
                        <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                            actions: [{
                                label: (row.examine ? 'admin_user_directory.examine' : 'admin_user_directory.open')|trans,
                                icon: row.examine ? 'view' : 'open',
                                href: path('app_admin_user_detail', {id: row.id}),
                                tone: row.examine ? 'primary' : 'default',
                            }],
                        } only %}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
