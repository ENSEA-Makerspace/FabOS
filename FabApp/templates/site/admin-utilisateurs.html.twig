{% extends 'base.html.twig' %}

{# S78 step 7 — this page had its own <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of these
   grew a <style> and every <style> grew literal colours. The shell emits the
   doctype, style.css, the favicon and importmap('app'); this file keeps only
   what is its own.

   S84 — the list is a `_data_table` now and the 325-line inline block is gone:
   page chrome S82 unwound, a `.admin-panel` copy that **overrode S83's ground
   and lift**, a complete modal that is not in this page's markup, a
   `.users-table` ruleset for a `<table>` this page stopped having, and a
   15-track `grid-template-columns` with a `min-width: 1780px`.

   🔴 Found by the conversion: the status cell was `class="status-badge active"`
   **hardcoded**, so a banned or pending member printed their real word inside a
   green chip. The class comes off the value now. #}

{% block title %}Gestion des Utilisateurs - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260805-s85-lists' }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'Gestion des Utilisateurs',
    description: 'Gérez tous les utilisateurs du FabLab',
    action_label: 'Créer un utilisateur',
    action_route: 'app_admin_user_new',
    panel_title: 'Liste des utilisateurs',
    panel_note: users|length ~ ' utilisateur' ~ (users|length > 1 ? 's' : ''),
    list_tools: true,
    list_client_filter: true,
    list_route: 'app_admin_users',
    list_search: filters.q|default(''),
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: users|length, category: 'all', active: true},
        {label: 'admin_list.active'|trans, count: users|filter(user => user.statut == 'actif')|length, category: 'actif'},
        {label: 'admin_list.inactive'|trans, count: users|filter(user => user.statut == 'inactif')|length, category: 'inactif'},
        {label: 'admin_list.pending'|trans, count: users|filter(user => user.statut == 'pending')|length, category: 'pending'},
    ],
} %}
    {% block filters %}
        <form class="filters-bar" method="get" action="{{ path('app_admin_users') }}">
            <div class="filter-group">
                <label for="search-users">Rechercher:</label>
                <input type="search" name="q" id="search-users" class="filter-input" placeholder="Nom, prénom, email, username, RFID" value="{{ filters.q|default('') }}">
            </div>
            <div class="filter-group">
                <label for="status-filter">Statut:</label>
                <select name="statut" id="status-filter" class="filter-select">
                    <option value="all">Tous</option>
                    {% for value, label in {'actif': 'Actif', 'inactif': 'Inactif', 'pending': 'En attente', 'banned': 'Banni'} %}
                        <option value="{{ value }}" {{ filters.statut|default('') == value ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-group">
                <label for="role-filter">Rôle:</label>
                <select name="role" id="role-filter" class="filter-select">
                    <option value="all">Tous</option>
                    {% for role in roleChoices|default([]) %}
                        <option value="{{ role }}" {{ filters.role|default('') == role ? 'selected' : '' }}>{{ role }}</option>
                    {% endfor %}
                </select>
            </div>
            <button class="btn btn-secondary btn-small" type="submit">Filtrer</button>
            <a class="btn btn-secondary btn-small" href="{{ path('app_admin_users') }}">Réinitialiser</a>
        </form>
    {% endblock %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'Membre', class: 'is-grow'},
                {label: 'Statut', class: 'is-tight'},
                {label: 'Progressions', class: 'is-tight'},
                {label: 'Logs RFID', class: 'is-tight'},
                {label: 'Détail', class: 'is-actions'},
            ],
            rows: users,
            empty: 'Aucun utilisateur trouvé.',
        } %}
            {% block rows %}
                {% for user in users %}
                    {% set logCount = logCounts[user.id]|default(0) %}
                    <tr data-admin-list-filter-row data-admin-list-filter-category="{{ (user.statut ?? '')|lower|replace({' ': '-'}) }}">
                        <td><div class="admin-cell-user"><span class="user-avatar-small">{{ ((user.firstName ?? user.username)|slice(0, 1) ~ (user.lastName ?? '')|slice(0, 1))|upper }}</span><div class="admin-cell-stack"><span class="is-strong">{{ user.displayName }}</span><span class="is-meta">{{ user.email }}</span></div></div></td>
                        {# 🔴 Was `status-badge active` whatever the value. #}
                        <td><span class="status-badge {{ (user.statut ?? '')|lower|replace({' ': '-', '_': '-'}) }}">{{ user.statut }}</span></td>
                        <td class="is-numeric">{{ progressionCounts[user.id]|default(0) }}</td>
                        <td class="is-numeric"><a class="rfid-log-link" href="{{ path('app_admin_access_rfid_logs') }}">{{ logCount }}</a></td>
                        <td class="is-actions"><a class="admin-action" href="{{ path('app_admin_user_detail', {id: user.id}) }}">{% include 'site/_icon.html.twig' with { name: 'open' } only %} Ouvrir</a></td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% include 'site/_footer.html.twig' %}
{% endblock %}
