{% extends 'site/base_public.html.twig' %}

{# « Rendez-vous avec une personne » : en tête le prochain créneau, une bande de 14 jours,
   les créneaux du jour choisi (`?jour=`) et, à droite, « Votre rendez-vous » (`?creneau=`)
   qui porte le VRAI formulaire de confirmation (POST `app_person_book`, jeton CSRF,
   droit d'usage). Les créneaux viennent de `App\Page\PersonAppointment`, donc de
   `PersonAvailabilityService::dailySlots()`. Une demande libre (autre moment) reste
   possible sous les créneaux (POST `app_person_request`). #}

{% block title %}{{ person.displayName }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/pages.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/page-rendez-vous.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% set pid = person.id %}
{% set dur = appointment.duration %}
{% set soon = appointment.next %}
{% set day = appointment.day %}
{% set slot = appointment.slot %}
{% set dayKey = day ? day.date|date('Y-m-d') : null %}
<main id="main-content" tabindex="-1" class="main-content">
    <section class="machine-detail-section">
        <div class="container pp-rdv" data-person-booking="{{ pid }}">
            {# 🔴 Fixed on the way past: the middle link sat inside an `{% if %}`
               while its separator sat outside, so a person who is neither a
               trainer nor staff — or whose feature is switched off — got
               "Accueil / / Léa". Passing `null` lets the shell close the gap. #}
            {% set person_section = person.isTrainer and feature_enabled('trainers')
                ? {label: 'nav.trainers'|trans, url: path('app_trainers')}
                : (person.isStaff and feature_enabled('staff')
                    ? {label: 'nav.staff'|trans, url: path('app_staff')}
                    : null) %}
            {% include 'site/_breadcrumb.html.twig' with {trail: [
                {label: 'nav.home'|trans, url: path('app_home')},
                person_section,
                {label: person.displayName},
            ]} only %}

            <h1>{{ 'booking.book_person'|trans }}</h1>

            {% for message in app.flashes('success') %}<div class="pp-rdv-flash is-success">{{ message|flash_text }}</div>{% endfor %}
            {% for message in app.flashes('error') %}<div class="pp-rdv-flash is-error">{{ message|flash_text }}</div>{% endfor %}

            {% if usageRight.enforced and not usageRight.allowed %}
                {% include 'site/_usage_right_state.html.twig' with {
                    capability: usageRight.capability,
                    verdict: usageRight,
                    action: usageRight.reason == 'signin_required'
                        ? {label: 'nav.login'|trans, url: path('app_login')}
                        : {label: 'usage_rights.my_rights'|trans, url: path('app_profile') ~ '#usage-rights'}
                } only %}
            {% endif %}

            <div class="pp-rdv-grid">
                <div class="pp-rdv-main">
                    <section class="detail-card pp-rdv-person">
                        <div class="pp-rdv-avatar">
                            {% include 'site/_user_avatar.html.twig' with {user: person, size: 96, alt: person.displayName} only %}
                        </div>
                        <div class="pp-rdv-id">
                            <h2>{{ person.displayName }}</h2>
                            <p class="pp-rdv-role">
                                {% if person.isTrainer %}{{ 'trainers.role_label'|trans }}{% endif %}{% if person.isTrainer and person.isStaff %} · {% endif %}{% if person.isStaff %}{{ 'staff.role_label'|trans }}{% endif %}
                            </p>
                            {% if person.bookingNote %}<p class="pp-rdv-note">{{ person.bookingNote }}</p>{% endif %}
                        </div>
                        <div class="pp-rdv-nextslot">
                            <p class="pp-rdv-kicker">{{ 'appointment.next_slot'|trans }}</p>
                            {% if soon %}
                                <p class="pp-rdv-nextwhen">
                                    <b>{{ ('booking.weekday.' ~ soon.date.format('N'))|trans }} {{ soon.date|date('d/m') }} · {{ soon.slot.start|date('H:i') }}</b>
                                </p>
                                <a class="btn btn-primary" href="{{ path('app_person_booking', {id: pid, duree: dur, jour: soon.date|date('Y-m-d'), creneau: soon.slot.start|date('H:i')}) }}">{{ 'appointment.take_slot'|trans }}</a>
                            {% else %}
                                <p class="pp-rdv-nextwhen">{{ 'appointment.no_slot_horizon'|trans({'%days%': horizonDays}) }}</p>
                            {% endif %}
                        </div>
                    </section>

                    {% if appointment.durations|length > 1 %}
                        <nav class="pp-rdv-durations" aria-label="{{ 'booking.duration_label'|trans }}">
                            {% for d in appointment.durations %}
                                <a href="{{ path('app_person_booking', {id: pid, duree: d}) }}"
                                   class="pp-rdv-chip{{ d == dur ? ' is-active' : '' }}"{% if d == dur %} aria-current="true"{% endif %}>{{ 'booking.duration_minutes'|trans({'%minutes%': d}) }}</a>
                            {% endfor %}
                        </nav>
                    {% endif %}

                    <section>
                        <h2 class="pp-rdv-h">{{ 'appointment.choose_day'|trans }}</h2>
                        <ol class="pp-rdv-strip">
                            {% for s in appointment.strip %}
                                <li>
                                    {% if s.free > 0 %}
                                        <a class="pp-rdv-day{{ s.key == dayKey ? ' is-active' : '' }}"
                                           href="{{ path('app_person_booking', {id: pid, duree: dur, jour: s.key}) }}"
                                           {% if s.key == dayKey %}aria-current="date"{% endif %}>
                                            <b>{{ ('booking.weekday.' ~ s.dow)|trans|slice(0, 3) }}</b>
                                            <strong>{{ s.date|date('d/m') }}</strong>
                                            <small>{{ (s.free > 1 ? 'appointment.free_many' : 'appointment.free_one')|trans({'%n%': s.free}) }}</small>
                                        </a>
                                    {% else %}
                                        <div class="pp-rdv-day is-empty" aria-disabled="true">
                                            <b>{{ ('booking.weekday.' ~ s.dow)|trans|slice(0, 3) }}</b>
                                            <strong>{{ s.date|date('d/m') }}</strong>
                                            <small>—</small>
                                        </div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    </section>

                    {% if day %}
                        <section>
                            <h2 class="pp-rdv-h">{{ ('booking.weekday.' ~ day.dayLabel)|trans }} {{ day.date|date('d/m') }}</h2>
                            <ul class="pp-rdv-slots">
                                {% for sl in day.slots %}
                                    {% set hm = sl.start|date('H:i') %}
                                    <li>
                                        <a class="pp-rdv-slot{{ slot and slot.start|date('H:i') == hm ? ' is-active' : '' }}"
                                           href="{{ path('app_person_booking', {id: pid, duree: dur, jour: dayKey, creneau: hm}) }}"
                                           {% if slot and slot.start|date('H:i') == hm %}aria-current="true"{% endif %}>{{ hm }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                            <p class="pp-rdv-tz">{{ 'appointment.lab_time'|trans }}</p>
                        </section>
                    {% else %}
                        <section class="detail-card">
                            <p class="pp-rdv-muted">{{ 'booking.no_slots'|trans({'%days%': horizonDays}) }}</p>
                        </section>
                    {% endif %}

                    <details class="detail-card pp-rdv-request" id="demande"{% if not day %} open{% endif %}>
                        <summary class="detail-card-title">{{ 'booking.request_title'|trans }}</summary>
                        <div class="detail-card-content">
                            <p class="pp-rdv-muted">{{ 'booking.request_hint'|trans }}</p>
                            {% if app.user and usageRight.allowed %}
                                <form method="post" action="{{ path('app_person_request', {id: pid}) }}" class="pp-rdv-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('person_request_' ~ pid) }}">
                                    <div class="pp-rdv-form-row">
                                        <div>
                                            <label for="request-date">{{ 'booking.date_label'|trans }}</label>
                                            <input type="date" id="request-date" name="date" required>
                                        </div>
                                        <div>
                                            <label for="request-time">{{ 'booking.start_label'|trans }}</label>
                                            <input type="time" id="request-time" name="startTime" required>
                                        </div>
                                        <div>
                                            <label for="request-duration">{{ 'booking.duration_label'|trans }}</label>
                                            <input type="number" id="request-duration" name="duration" list="offered-durations"
                                                   min="5" max="480" step="5" value="{{ dur }}" required>
                                            <datalist id="offered-durations">
                                                {% for d in appointment.durations %}<option value="{{ d }}"></option>{% endfor %}
                                            </datalist>
                                        </div>
                                    </div>
                                    <div>
                                        <label for="request-motif">{{ 'booking.request_reason_label'|trans }}</label>
                                        <textarea id="request-motif" name="motif" maxlength="500" required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-secondary">{{ 'booking.send_request'|trans }}</button>
                                </form>
                            {% elseif not app.user %}
                                <p><a href="{{ path('app_login') }}">{{ 'login.submit'|trans }}</a> {{ 'booking.login_to_book'|trans }}</p>
                            {% else %}
                                <p class="pp-rdv-muted">{{ ('usage_rights.verdict.' ~ usageRight.reason ~ '.description')|trans }}</p>
                            {% endif %}
                        </div>
                    </details>

                    <section class="detail-card">
                        <h2 class="detail-card-title">{{ 'booking.weekly_availability'|trans }}</h2>
                        <div class="detail-card-content">
                            {% if weeklyWindows is empty %}
                                <p class="pp-rdv-muted">{{ 'booking.no_availability'|trans }}</p>
                            {% else %}
                                <ul class="pp-rdv-week">
                                    {% for dayOfWeek, windows in weeklyWindows %}
                                        <li>
                                            <b>{{ ('booking.weekday.' ~ dayOfWeek)|trans }}</b>
                                            — {% for window in windows %}{{ window.displayLabel }}{% if not loop.last %}, {% endif %}{% endfor %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </section>
                </div>

                <aside class="detail-card pp-rdv-recap" aria-label="{{ 'appointment.recap_title'|trans }}">
                    <h2>{{ 'appointment.recap_title'|trans }}</h2>
                    <dl class="pp-rdv-facts">
                        <div><dt>{{ 'appointment.with'|trans }}</dt><dd>{{ person.displayName }}</dd></div>
                        {% if slot %}
                            <div><dt>{{ 'appointment.when'|trans }}</dt><dd>{{ ('booking.weekday.' ~ day.dayLabel)|trans }} {{ day.date|date('d/m/Y') }}</dd></div>
                            <div><dt>{{ 'appointment.time'|trans }}</dt><dd>{{ slot.start|date('H:i') }} – {{ slot.end|date('H:i') }}</dd></div>
                        {% else %}
                            <div><dt>{{ 'appointment.when'|trans }}</dt><dd class="pp-rdv-muted">{{ 'appointment.pick_slot'|trans }}</dd></div>
                        {% endif %}
                        <div><dt>{{ 'appointment.duration'|trans }}</dt><dd>{{ 'booking.duration_minutes'|trans({'%minutes%': dur}) }}</dd></div>
                        <div><dt>{{ 'appointment.place'|trans }}</dt><dd class="pp-rdv-muted">{{ 'appointment.place_value'|trans }}</dd></div>
                    </dl>
                    {% if slot %}
                        {% if not app.user %}
                            <p><a href="{{ path('app_login') }}">{{ 'login.submit'|trans }}</a> {{ 'booking.login_to_book'|trans }}</p>
                        {% elseif not usageRight.allowed %}
                            <p class="pp-rdv-muted">{{ ('usage_rights.verdict.' ~ usageRight.reason ~ '.description')|trans }}</p>
                        {% else %}
                            <form method="post" action="{{ path('app_person_book', {id: pid}) }}" class="pp-rdv-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('person_book_' ~ pid) }}">
                                <input type="hidden" name="duration" value="{{ dur }}">
                                <input type="hidden" name="start" value="{{ slot.start|date('Y-m-d H:i') }}">
                                <div>
                                    <label for="slot-motif">{{ 'booking.reason_label'|trans }}</label>
                                    <textarea id="slot-motif" name="motif" maxlength="500"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">{{ 'booking.confirm'|trans }}</button>
                            </form>
                        {% endif %}
                    {% else %}
                        <p class="pp-rdv-tz">{{ 'appointment.pick_slot_hint'|trans }}</p>
                    {% endif %}
                </aside>
            </div>
        </div>
    </section>
</main>
{% endblock %}
