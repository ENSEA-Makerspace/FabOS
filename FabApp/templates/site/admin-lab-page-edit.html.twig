{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}Modifier {{ page.titre }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260804-s78-tables' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <style>
        .form-field input, .form-field textarea, .form-field select { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px; background: #fff; }
        .form-field textarea { min-height: 180px; resize: vertical; }
        .form-hint { margin: 7px 0 0; color: #6b7280; font-size: 13px; }
        .btn-submit button, .btn-submit-inline { padding: 10px 16px; border-radius: 6px; border: 0; color: #fff; background: #9E1B56; font-weight: 700; cursor: pointer; }
        .lab-photos-section { padding: 0 24px 24px; }
        .lab-photos-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; margin: 14px 0; }
        .lab-photo-card { border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; background: #f9fafb; }
        .lab-photo-card img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; }
        .lab-photo-card form { padding: 8px; }
        .lab-photo-card button { width: 100%; padding: 6px; border-radius: 6px; border: 1px solid #fecaca; background: #fee2e2; color: #991b1b; font-weight: 700; cursor: pointer; font-size: 12px; }
        .lab-photo-upload { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Modifier une page</h1>
                    <p>{{ page.titre }}</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_lab_pages') }}">Retour aux pages</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>Champs modifiables</h2>
                    {% if hadChildren %}<p>Cette page a des sous-pages : elle reste une page de premier niveau.</p>{% endif %}
                </div>

                {% for message in app.flashes('success') %}<div class="admin-flash success" style="margin: 16px 24px 0; padding: 12px 14px; border-radius: 6px; font-weight: 700; background: #dcfce7; color: #166534;">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="admin-flash error" style="margin: 16px 24px 0; padding: 12px 14px; border-radius: 6px; font-weight: 700; background: #fee2e2; color: #991b1b;">{{ message }}</div>{% endfor %}

                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.titre, {row_attr: {class: 'full'}}) }}
                        {% if not hadChildren %}
                            {{ form_row(form.parentPage) }}
                        {% endif %}
                        {{ form_row(form.contenu, {row_attr: {class: 'full'}}) }}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_lab_pages') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}

                <div class="lab-photos-section">
                    <h3>Galerie photo</h3>
                    <div class="lab-photos-grid">
                        {% for image in page.images %}
                            <div class="lab-photo-card">
                                <img src="{{ asset('uploads/lab-pages/' ~ image.imageFilename) }}" alt="{{ page.titre }}">
                                <form method="post" action="{{ path('app_admin_lab_page_photo_delete', {id: page.id, photoId: image.id}) }}" onsubmit="return confirm('Supprimer cette photo ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('lab_page_photo_delete_' ~ image.id) }}">
                                    <button type="submit">Supprimer</button>
                                </form>
                            </div>
                        {% else %}
                            <p class="form-hint">Aucune photo pour le moment.</p>
                        {% endfor %}
                    </div>
                    <form method="post" action="{{ path('app_admin_lab_page_photo_add', {id: page.id}) }}" enctype="multipart/form-data" class="lab-photo-upload">
                        <input type="hidden" name="_token" value="{{ csrf_token('lab_page_photo_' ~ page.id) }}">
                        <input type="file" name="photo" accept=".png,.jpg,.jpeg,.webp" required>
                        <button type="submit" class="btn-submit-inline">Ajouter la photo</button>
                    </form>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
