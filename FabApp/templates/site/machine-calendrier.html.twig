</svg>
                </div>
            </a>
            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">Accueil</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">Calendrier</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link active">Machines</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">Formations</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">Leaderboard</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">Admin</a>
                    {% endif %}
                </div>
            </nav>
            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>
                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <main class="main-content">
        <section class="machine-calendar-section">
            <div class="container">
                <nav class="breadcrumb">
                    <a href="{{ path('app_home') }}">Accueil</a>
                    <span class="breadcrumb-separator">/</span>
                    <a href="{{ path('app_machines') }}">Machines</a>
                    <span class="breadcrumb-separator">/</span>
                    <a href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ machine.nom }}</a>
                    <span class="breadcrumb-separator">/</span>
                    <span class="breadcrumb-current">Calendrier</span>
                </nav>

                <div class="machine-calendar-header">
                    <div class="machine-info-bar">
                        <div class="machine-avatar">
                            <svg viewBox="0 0 100 100" class="machine-icon">
                                <rect x="20" y="30" width="60" height="40" fill="#9E1B56" rx="5"/>
                                <rect x="25" y="20" width="50" height="10" fill="#666" rx="2"/>
                                <circle cx="50" cy="75" r="8" fill="#444"/>
                            </svg>
                        </div>
                        <div class="machine-info-text">
                            <h1 class="machine-calendar-title">{{ machine.nom }}</h1>
                            <p class="machine-calendar-location">{{ machine.localisation ?? 'Localisation non renseignée' }} - {{ machine.statut }}</p>
                        </div>
                    </div>
                    <div class="machine-calendar-nav">
                        <a href="{{ path('app_machine_detail', {id: machine.id}) }}" class="btn btn-secondary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 12H5M12 19l-7-7 7-7"/>
                            </svg>
                            Retour à la machine
                        </a>
                        <a href="{{ path('app_calendar') }}" class="btn btn-primary">
                            Voir le calendrier complet
                        </a>
                    </div>
                </div>

                <div class="machine-calendar-filters">
                    <div class="filter-selector">
                        <label>Machine:</label>
                        <select class="filter-select" id="machine-filter" disabled>
                            {% for item in machines %}
                                <option value="{{ item.id }}" {{ item.id == machine.id ? 'selected' : '' }}>{{ item.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="week-navigation">
                        <button class="btn btn-secondary" id="prev-week">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="15,18 9,12 15,6"/>
                            </svg>
                            Semaine précédente
                        </button>
                        <div class="current-week-display" id="current-week-display">
                            Semaine 25 (16 - 22 Juin 2026)
                        </div>
                        <button class="btn btn-secondary" id="next-week">
                            Semaine suivante
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9,18 15,12 9,6"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="section-card reservation-create-panel" style="padding: 16px; margin-bottom: 16px;">
                    <h3 style="margin: 0 0 12px;">Réserver {{ machine.nom }}</h3>
                    {% if app.user %}
                        <form id="reservation-form" class="reservation-form" style="display: grid; grid-template-columns: repeat(2, minmax(180px, 1fr)); gap: 12px; align-items: end;">
                            <input type="hidden" name="machineId" value="{{ machine.id }}">
                            <div class="form-group">
                                <label for="reservation-date-debut">Date début</label>
                                <input type="datetime-local" id="reservation-date-debut" name="dateDebut" class="filter-input" required>
                            </div>
                            <div class="form-group">
                                <label for="reservation-date-fin">Date fin</label>
                                <input type="datetime-local" id="reservation-date-fin" name="dateFin" class="filter-input" required>
                            </div>
                            <div class="form-group" style="grid-column: 1 / -1;">
                                <label for="reservation-motif">Motif</label>
                                <input type="text" id="reservation-motif" name="motif" class="filter-input" maxlength="500" placeholder="Optionnel">
                            </div>
                            <div style="grid-column: 1 / -1; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                                <button type="submit" class="btn btn-primary" id="reservation-submit">Réserver</button>
                                <span id="reservation-message" aria-live="polite"></span>
                            </div>
                        </form>
                    {% else %}
                        <p style="margin: 0;">Connectez-vous pour créer une réservation.</p>
                    {% endif %}
                </div>

                {% if reservations is empty %}
                    <div class="section-card" style="padding: 16px; margin-bottom: 16px;">Aucune réservation pour cette machine.</div>
                {% endif %}

                <div class="weekly-calendar" id="weekly-calendar-container">
                    <div class="calendar-days-header" id="days-header">
                        <div class="calendar-time-header">Heure</div>
                        <div class="calendar-day-header">Lundi 16</div>
                        <div class="calendar-day-header">Mardi 17</div>
                        <div class="calendar-day-header">Mercredi 18</div>
                        <div class="calendar-day-header">Jeudi 19</div>
                        <div class="calendar-day-header">Vendredi 20</div>
                        <div class="calendar-day-header">Samedi 21</div>
                        <div class="calendar-day-header">Dimanche 22</div>
                    </div>
                    <div class="calendar-slots" id="calendar-slots"></div>
                </div>

                <div class="calendar-legend">
                    <div class="legend-item">
                        <span class="legend-color reservation"></span>
                        <span>Réservation (autre utilisateur)</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-color my-reservation"></span>
                        <span>Ma réservation</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-color maintenance"></span>
                        <span>En maintenance</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-color panne"></span>
                        <span>Machine en panne</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-color free"></span>
                        <span>Disponible</span>
                    </div>
                </div>

                <div class="calendar-selection-info" id="calendar-selection-info" style="display: none;">
                    <p>Sélection: <span id="selection-info"></span></p>
                    <button class="btn btn-primary" id="reserve-btn" disabled>Création bientôt disponible</button>
                </div>
            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') }}"></script>
    <script>
        // Configuration spécifique pour une seule machine
        const MACHINE_ID = {{ machine.id }};
        const MACHINE_NAME = {{ machine.nom|json_encode|raw }};
        const MACHINE_COLOR = "#9E1B56";
        
        const CALENDAR_CONFIG = {
            startHour: {{ calendarStartHour }},
            endHour: {{ calendarEndHour }},
            slotHeight: 40,
            minSlotDuration: 30
        };
        
        const RESERVATIONS = [
{% for reservation in reservations %}
            { machine_id: {{ machine.id }}, date: {{ reservation.dateDebut|date('Y-m-d')|json_encode|raw }}, day: {{ reservation.dateDebut|date('N') - 1 }}, start: {{ reservation.dateDebut|date('H:i')|json_encode|raw }}, end: {{ reservation.dateFin|date('H:i')|json_encode|raw }}, user: {{ reservation.utilisateur ? reservation.utilisateur.displayName|json_encode|raw : 'Utilisateur'|json_encode|raw }}, user_id: {{ reservation.utilisateur ? reservation.utilisateur.id : 'null' }} }{{ not loop.last ? ',' : '' }}
{% endfor %}
        ];
        const OPENING_HOURS = {{ openingHoursJson|json_encode|raw }};
        const FABLAB_HOURS = OPENING_HOURS.reduce((hours, openingHour) => {
            hours[openingHour.dayIndex] = openingHour.isClosed ? null : [timeToMinutes(openingHour.openTime), timeToMinutes(openingHour.closeTime)];
            return hours;
        }, {});
        
        let currentDate = new Date();
        let selectedMachine = MACHINE_ID;
        let selectedSlot = null;
        const userId = {{ app.user ? app.user.id : 'null' }};
        const IS_AUTHENTICATED = {{ app.user ? 'true' : 'false' }};
        
        document.addEventListener('DOMContentLoaded', function() {
            initCalendar();
        });
        
        function initCalendar() {
            document.getElementById('prev-week')?.addEventListener('click', function() {
                currentDate.setDate(currentDate.getDate() - 7);
                renderCalendar();
            });
            
            document.getElementById('next-week')?.addEventListener('click', function() {
                currentDate.setDate(currentDate.getDate() + 7);
                renderCalendar();
            });
            
            document.getElementById('machine-filter')?.addEventListener('change', function(e) {
                selectedMachine = parseInt(e.target.value);
                renderCalendar();
            });

            document.getElementById('calendar-slots')?.addEventListener('click', handleCalendarClick);
            initReservationForm();
            
            renderCalendar();
        }
        
        function renderCalendar() {
            renderHeader();
            renderGrid();
        }
        
        function renderHeader() {
            const weekStart = getWeekStartDate(currentDate);
            const weekEnd = new Date(weekStart);
            weekEnd.setDate(weekEnd.getDate() + 6);
            
            const weekDisplay = document.getElementById('current-week-display');
            if (weekDisplay) {
                const options = { day: 'numeric', month: 'short' };
                weekDisplay.textContent = `Semaine ${getWeekNumber(currentDate)} (${weekStart.toLocaleDateString('fr-FR', options)} - ${weekEnd.toLocaleDateString('fr-FR', options)})`;
            }
            
            const daysHeader = document.getElementById('days-header');
            if (daysHeader) {
                const days = getWeekDays();
                const dayHeaderHTML = '<div class="calendar-time-header">Heure</div>' +
                    days.map(day => {
                        const dayName = day.toLocaleDateString('fr-FR', { weekday: 'short' });
                        const dayNum = day.getDate();
                        const isToday = isSameDay(day, new Date());
                        return `<div class="calendar-day-header${isToday ? ' today' : ''}">${dayName} ${dayNum}</div>`;
                    }).join('');
                daysHeader.innerHTML = dayHeaderHTML;
            }
        }
        
        function renderGrid() {
            const slotsContainer = document.getElementById('calendar-slots');
            if (!slotsContainer) return;
            
            const days = getWeekDays();
            const hours = getTimeSlots();
            
            let html = '';
            
            hours.forEach(hour => {
                html += `<div class="calendar-slot">${hour}:00</div>`;
                days.forEach((day, dayIndex) => {
                    html += `<div class="calendar-cell" data-day="${dayIndex}" data-time="${hour}"></div>`;
                });
            });
            
            slotsContainer.innerHTML = html;
            renderReservations();
        }
        
        function renderReservations() {
            const slotsContainer = document.getElementById('calendar-slots');
            if (!slotsContainer) return;
            
            const cells = slotsContainer.querySelectorAll('.calendar-cell');
            
            cells.forEach(cell => {
                cell.innerHTML = '';
                cell.classList.remove('reservation', 'maintenance', 'panne', 'my-reservation', 'closed');
                cell.style.height = '';
            });
            
            const visibleDateKeys = new Set(getWeekDays().map(formatDateKey));
            const filteredReservations = RESERVATIONS.filter(r => r.machine_id == selectedMachine && visibleDateKeys.has(r.date));
            
            filteredReservations.forEach(reservation => {
                const dayIndex = reservation.day;
                const startHour = reservation.start.substring(0, 2);
                const startMinute = reservation.start.substring(3, 5);
                const endHour = reservation.end.substring(0, 2);
                const endMinute = reservation.end.substring(3, 5);
                
                const startTotalMinutes = parseInt(startHour) * 60 + parseInt(startMinute);
                const endTotalMinutes = parseInt(endHour) * 60 + parseInt(endMinute);
                const durationMinutes = endTotalMinutes - startTotalMinutes;
                const rowSpan = Math.ceil(durationMinutes / CALENDAR_CONFIG.minSlotDuration);
                
                const firstCell = slotsContainer.querySelector(`[data-day="${dayIndex}"][data-time="${startHour}"]`);
                if (!firstCell) return;
                
                const isMyReservation = userId !== null && reservation.user_id === userId;
                
                const reservationContent = document.createElement('div');
                reservationContent.className = 'reservation-content';
                reservationContent.style.setProperty('--color', isMyReservation ? '#4CAF50' : MACHINE_COLOR);
                reservationContent.innerHTML = `
                    <span class="reservation-user">${reservation.user}</span>
                    <span class="reservation-time">${reservation.start} - ${reservation.end}</span>
                `;
                
                firstCell.classList.add('reservation');
                if (isMyReservation) {
                    firstCell.classList.add('my-reservation');
                }
                firstCell.style.height = `${rowSpan * CALENDAR_CONFIG.slotHeight}px`;
                firstCell.appendChild(reservationContent);
                
                if (rowSpan > 1) {
                    for (let i = 1; i < rowSpan; i++) {
                        const hour = (parseInt(startHour) + Math.floor((startMinute + i * CALENDAR_CONFIG.minSlotDuration) / 60)) % 24;
                        const nextCell = slotsContainer.querySelector(`[data-day="${dayIndex}"][data-time="${String(hour).padStart(2, '0')}"]`);
                        if (nextCell) {
                            nextCell.style.display = 'none';
                        }
                    }
                }
                
            });
            
            markMachineStatus();
            markClosedSlots();
        }

        function markClosedSlots() {
            const slotsContainer = document.getElementById('calendar-slots');
            if (!slotsContainer) return;

            slotsContainer.querySelectorAll('.calendar-cell').forEach(cell => {
                if (cell.classList.contains('reservation')) return;

                const dayIndex = parseInt(cell.dataset.day, 10);
                const hour = parseInt(cell.dataset.time, 10);
                const fabLabHours = FABLAB_HOURS[dayIndex];

                if (fabLabHours === null) {
                    cell.classList.add('closed');
                    return;
                }

                const [openMinute, closeMinute] = fabLabHours;
                const slotMinute = hour * 60;
                if (slotMinute < openMinute || slotMinute >= closeMinute) {
                    cell.classList.add('closed');
                }
            });
        }
        
        function markMachineStatus() {
            const machineStatus = {
                2: 'maintenance',
                6: 'panne'
            };
            
            if (machineStatus[selectedMachine]) {
                const cells = document.querySelectorAll('.calendar-cell');
                cells.forEach(cell => {
                    if (cell.classList.contains('reservation')) return;
                    cell.classList.add(machineStatus[selectedMachine]);
                });
            }
        }
        
        function handleCalendarClick(event) {
            const cell = event.target.closest('.calendar-cell');
            if (!cell) return;
            if (cell.classList.contains('maintenance') || cell.classList.contains('panne') || cell.classList.contains('closed')) return;

            if (!cell.classList.contains('reservation')) {
                selectFreeSlot(cell);
                return;
            }

            const dayIndex = parseInt(cell.dataset.day, 10);
            const hourStr = cell.dataset.time;
            const visibleDateKeys = new Set(getWeekDays().map(formatDateKey));
            const reservation = RESERVATIONS.find(res =>
                res.day === dayIndex &&
                res.machine_id === selectedMachine &&
                res.start.startsWith(hourStr) &&
                visibleDateKeys.has(res.date)
            );
            if (reservation) selectReservation(reservation, cell);
        }

        function selectFreeSlot(cell) {
            document.querySelector('.calendar-cell.selected')?.classList.remove('selected');
            cell.classList.add('selected');

            const dayIndex = parseInt(cell.dataset.day, 10);
            const hourStr = cell.dataset.time;
            const startValue = buildDateTimeLocal(dayIndex, hourStr, 0);
            const endValue = buildDateTimeLocal(dayIndex, hourStr, CALENDAR_CONFIG.minSlotDuration);

            const startInput = document.getElementById('reservation-date-debut');
            const endInput = document.getElementById('reservation-date-fin');
            if (startInput) startInput.value = startValue;
            if (endInput) endInput.value = endValue;

            const selectionInfo = document.getElementById('calendar-selection-info');
            const selectionText = document.getElementById('selection-info');
            const reserveBtn = document.getElementById('reserve-btn');
            if (selectionInfo && selectionText) {
                selectionInfo.style.display = 'flex';
                selectionText.textContent = `${MACHINE_NAME} - créneau disponible le ${startValue.replace('T', ' à ')}`;
                reserveBtn.textContent = IS_AUTHENTICATED ? 'Utiliser le formulaire' : 'Connexion requise';
                reserveBtn.disabled = true;
            }
        }

        function selectReservation(reservation, cell) {
            const selectionInfo = document.getElementById('calendar-selection-info');
            const selectionText = document.getElementById('selection-info');
            const reserveBtn = document.getElementById('reserve-btn');
            
            const previouslySelected = document.querySelector('.calendar-cell.selected');
            if (previouslySelected) {
                previouslySelected.classList.remove('selected');
            }
            
            cell.classList.add('selected');
            selectedSlot = reservation;
            
            const isMyReservation = userId !== null && reservation.user_id === userId;
            
            if (selectionInfo && selectionText) {
                selectionInfo.style.display = 'flex';
                selectionText.textContent = `${MACHINE_NAME} - ${reservation.start} à ${reservation.end} (${reservation.user})`;
                reserveBtn.textContent = 'Création bientôt disponible';
                reserveBtn.disabled = true;
            }
        }
        
        function initReservationForm() {
            const form = document.getElementById('reservation-form');
            if (!form) return;

            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                const message = document.getElementById('reservation-message');
                const submit = document.getElementById('reservation-submit');
                const payload = {
                    machineId: form.machineId.value,
                    dateDebut: form.dateDebut.value,
                    dateFin: form.dateFin.value,
                    motif: form.motif.value
                };

                if (message) {
                    message.textContent = 'Création en cours...';
                    message.style.color = '#666';
                }
                if (submit) submit.disabled = true;

                try {
                    const response = await fetch('{{ path('api_reservation_create') }}', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        credentials: 'same-origin',
                        body: JSON.stringify(payload)
                    });
                    const data = await response.json().catch(() => ({}));
                    if (!response.ok) {
                        throw new Error(data.error || 'Réservation refusée');
                    }
                    if (message) {
                        message.textContent = 'Réservation créée. Actualisation...';
                        message.style.color = '#2e7d32';
                    }
                    window.setTimeout(() => window.location.reload(), 700);
                } catch (error) {
                    if (message) {
                        message.textContent = error.message;
                        message.style.color = '#b00020';
                    }
                    if (submit) submit.disabled = false;
                }
            });
        }

        function timeToMinutes(value) {
            if (!value) return null;
            const [hours, minutes] = value.split(':').map(Number);
            return hours * 60 + minutes;
        }

        function buildDateTimeLocal(dayIndex, hourStr, offsetMinutes) {
            const day = getWeekDays()[dayIndex];
            const date = new Date(day);
            date.setHours(parseInt(hourStr, 10), offsetMinutes, 0, 0);
            return `${formatDateKey(date)}T${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`;
        }

        function formatDateKey(date) {
            return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
        }

        function getWeekStartDate(date) {
            const d = new Date(date);
            const day = d.getDay();
            const diff = d.getDate() - day + (day === 0 ? -6 : 1);
            return new Date(d.setDate(diff));
        }
        
        function getWeekDays() {
            const start = getWeekStartDate(currentDate);
            return Array.from({length: 7}, (_, i) => {
                const day = new Date(start);
                day.setDate(start.getDate() + i);
                return day;
            });
        }
        
        function getTimeSlots() {
            return Array.from({length: CALENDAR_CONFIG.endHour - CALENDAR_CONFIG.startHour}, 
                (_, i) => String(CALENDAR_CONFIG.startHour + i).padStart(2, '0'));
        }
        
        function getWeekNumber(date) {
            const d = new Date(date);
            const firstDayOfYear = new Date(d.getFullYear(), 0, 1);
            const pastDaysOfYear = (d - firstDayOfYear) / 86400000;
            return Math.ceil((pastDaysOfYear + firstDayOfYear.getDay() + 1) / 7);
        }
        
        function isSameDay(date1, date2) {
            return date1.getFullYear() === date2.getFullYear() &&
                   date1.getMonth() === date2.getMonth() &&
                   date1.getDate() === date2.getDate();
        }
    </script>
</body>
</html>
