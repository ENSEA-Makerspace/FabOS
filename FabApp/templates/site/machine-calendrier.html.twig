{% extends 'site/base_public.html.twig' %}


{% block title %}{{ 'machine_calendar.browser_title'|trans({'%machine%': machine.nom}) }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=20260709-calheader-userlogo' }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-fix.css') }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-modern.css') ~ '?v=20260812-s138-brace' }}">
{% endblock %}

{% block body %}

    <main class="main-content calendar-modern-page">
        <section class="container calendar-shell">
            {% include 'site/_breadcrumb.html.twig' with {trail: [
                {label: 'nav.home'|trans, url: path('app_home')},
                {label: 'nav.machines'|trans, url: path('app_machines')},
                {label: machine.nom, url: path('app_machine_detail', {id: machine.id})},
                {label: 'nav.calendar'|trans},
            ]} only %}

            <div class="calendar-hero">
                <div>
                    <span class="calendar-eyebrow">{{ 'mcal.title'|trans }}</span>
                    <h1>{{ machine.nom }}</h1>
                    <p>{{ machine.localisation ?? 'machine_calendar.no_location'|trans }} · {{ machine.categoryLabel }} · {{ 'machine_calendar.slot_length'|trans({'%length%': machine.granulariteLabel}) }}</p>
                </div>
                <div class="calendar-actions">
                    <a class="btn btn-secondary" href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ 'mcal.back_machine'|trans }}</a>
                    {% if app.user %}<a class="btn btn-secondary" href="{{ path('app_my_reservations') }}">{{ 'resv.title'|trans }}</a>{% endif %}
                    {% if app.user %}
                        {% set ical_url = url('app_machine_ical', {id: machine.id}) ~ '?token=' ~ ical_feed_token() %}
                        <a class="btn btn-secondary" href="{{ ical_url|replace({'https://': 'webcal://', 'http://': 'webcal://'}) }}" title="{{ 'ical.subscribe_hint'|trans }}">📅 {{ 'ical.subscribe'|trans }}</a>
                    {% endif %}
                    <a class="btn btn-primary" href="{{ path('app_calendar') }}">{{ 'mcal.full_calendar'|trans }}</a>
                </div>
            </div>

            <div class="calendar-stats">
                {# 🔴 **This printed `machine.statut` RAW** — the stored word, so an install
                   holding `idle` showed the English database value on a French page, and
                   the class came off that same word so a value no stylesheet knew about
                   got no colour at all. It is the exact fault S84 fixed on /admin/machines
                   and it survived here. `getStatusKey()` is the one mapping. #}
                <article class="calendar-stat-card"><span>{{ 'mcal.machine_status'|trans }}</span><strong>{% include 'site/_cell_state.html.twig' with {
                    label: machine.statusKey|trans,
                    signal: machine.statusKey == 'machines.st_available' ? 'go' : (machine.statusKey == 'machines.st_maintenance' ? 'caution' : 'stop'),
                } only %}</strong></article>
                <article class="calendar-stat-card"><span>{{ 'cal.today_hours'|trans }}</span><strong id="today-opening-hours">{{ 'cal.loading'|trans }}</strong></article>
                <article class="calendar-stat-card"><span>{{ 'cal.reservations_today'|trans }}</span><strong id="today-reservation-count">0</strong></article>
                <article class="calendar-stat-card"><span>{{ 'cal.next_slot'|trans }}</span><strong id="next-open-slot">{{ 'cal.select'|trans }}</strong></article>
            </div>

            <div class="calendar-workspace machine-specific-layout">
                <aside class="machine-context-panel">
                    <h2>{{ machine.nom }}</h2>
                    {% include 'site/_cell_state.html.twig' with {
                        label: machine.statusKey|trans,
                        signal: machine.statusKey == 'machines.st_available' ? 'go' : (machine.statusKey == 'machines.st_maintenance' ? 'caution' : 'stop'),
                    } only %}
                    <p>{{ machine.description ?: machine.requirementDescription }}</p>
                    <div class="panel-title-row"><h2>{{ 'kiosk.machine_required_badges'|trans }}</h2></div>
                    <div class="badge-strip">
                        {% for machineBadge in machine.requiredMachineBadges %}
                            {% set badge = machineBadge.badge %}
                            {% if badge %}<span class="badge-chip">{{ badge.nom }}</span>{% endif %}
                        {% else %}
                            <span class="badge-chip">{{ 'machine.no_badges'|trans }}</span>
                        {% endfor %}
                    </div>
                    <div class="panel-title-row" style="margin-top: 18px;"><h2>{{ 'home.col_hours'|trans }}</h2></div>
                    <div class="week-hours-strip" id="calendar-week-hours-side" aria-label="{{ 'mcal.week_hours_aria'|trans }}"></div>
                    {% if machine.statut|lower matches '/maintenance|panne|indisponible|hors/' %}
                        <div class="login-callout" style="margin-top: 16px;">{{ 'mcal.not_available_notice'|trans }}</div>
                    {% endif %}
                    {% if usageRight.enforced and not usageRight.allowed %}
                        {% include 'site/_usage_right_state.html.twig' with {
                            capability: usageRight.capability,
                            verdict: usageRight,
                            compact: true,
                            action: usageRight.reason == 'signin_required'
                                ? {label: 'nav.login'|trans, url: path('app_login')}
                                : {label: 'usage_rights.my_rights'|trans, url: path('app_profile') ~ '#usage-rights'}
                        } only %}
                    {% endif %}
                    {% if app.user and not is_granted('ROLE_ADMIN') and bookingAccess and not bookingAccess.canReserve %}
                        <div class="login-callout training-lock-callout" style="margin-top: 16px;">{{ bookingAccess.reasonLabel ?: 'machine_calendar.training_not_validated'|trans }}{{ 'machine_calendar.locked_note'|trans }}</div>
                    {% endif %}
                </aside>

                <section class="calendar-board">
                    <div class="calendar-board-header">
                        <div>
                            <h2>{{ 'mcal.availability'|trans }}</h2>
                            <p class="calendar-board-subtitle">{{ 'mcal.click_slot'|trans }}</p>
                        </div>
                        <div class="calendar-nav-bar">
                            <button class="btn btn-secondary" type="button" id="prev-week">{{ 'mcal.prev_week'|trans }}</button>
                            <div class="week-chip" id="current-week-display">{{ 'mcal.week'|trans }}</div>
                            <button class="btn btn-secondary" type="button" id="today-week">{{ 'mcal.today'|trans }}</button>
                            <button class="btn btn-secondary" type="button" id="next-week">{{ 'mcal.next_week'|trans }}</button>
                        </div>
                    </div>

                    <div class="week-hours-strip" id="calendar-week-hours" aria-label="{{ 'mcal.week_hours_aria'|trans }}"></div>
                    <div class="calendar-scroll-area"><div class="agenda-grid" id="agenda-grid"></div></div>
                    <div class="calendar-legend-modern">
                        <span class="legend-dot free">{{ 'machines.st_available'|trans }}</span>
                        <span class="legend-dot reserved">{{ 'cal.legend_reserved'|trans }}</span>
                        <span class="legend-dot mine">{{ 'cal.legend_mine'|trans }}</span>
                        <span class="legend-dot closed">{{ 'kiosk.machine_closed'|trans }}</span>
                        <span class="legend-dot out">{{ 'cal.legend_offhours'|trans }}</span>
                        <span class="legend-dot cancelled">{{ 'cal.legend_cancelled'|trans }}</span>
                    </div>
                </section>
            </div>
        </section>
    </main>

    <div class="booking-panel-backdrop" id="booking-backdrop"></div>
    <section class="booking-panel" id="booking-panel" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="booking-title">
        <div class="booking-panel-header">
            <div><h2 id="booking-title">{{ 'machine_calendar.book_slot'|trans }}</h2><p id="booking-context">{{ 'machine_calendar.pick_free_slot'|trans }}</p></div>
            <button class="booking-panel-close" type="button" id="booking-close" aria-label="{{ 'common.close'|trans }}">×</button>
        </div>
        {% if app.user %}
            <form id="booking-form" class="booking-form">
                <input type="hidden" name="machineId" value="{{ machine.id }}">
                <input id="booking-start" name="dateDebut" type="hidden" required>
                <input id="booking-end" name="dateFin" type="hidden" required>
                <div class="booking-summary-grid">
                    <div class="booking-summary-card"><span>{{ 'machine_calendar.selected_date'|trans }}</span><strong id="booking-date-label">-</strong></div>
                    <div class="booking-summary-card"><span>{{ 'machine_calendar.slot'|trans }}</span><strong id="booking-time-label">-</strong></div>
                </div>
                <div class="booking-time-picker" aria-label="{{ 'machine_calendar.time_picker_label'|trans }}">
                    <div><label for="booking-start-time">{{ 'machine_calendar.start_time'|trans }}</label><select id="booking-start-time" class="time-picker-select"></select></div>
                    <div><label for="booking-end-time">{{ 'machine_calendar.end_time'|trans }}</label><select id="booking-end-time" class="time-picker-select"></select></div>
                </div>
                <div class="duration-shortcuts" aria-label="{{ 'machine_calendar.quick_durations'|trans }}">
                    <button type="button" class="duration-chip" data-duration="30">{{ 'machine_calendar.minutes'|trans({'%n%': 30}) }}</button>
                    <button type="button" class="duration-chip is-active" data-duration="60">{{ 'machine_calendar.hours'|trans({'%n%': 1}) }}</button>
                    <button type="button" class="duration-chip" data-duration="120">{{ 'machine_calendar.hours'|trans({'%n%': 2}) }}</button>
                </div>
                <div><label for="booking-motif">{{ 'machine_calendar.reason'|trans }}</label><textarea id="booking-motif" name="motif" maxlength="500" placeholder="{{ 'machine_calendar.reason_placeholder'|trans }}"></textarea></div>
                <div class="booking-form-actions"><button type="submit" class="btn btn-primary" id="booking-submit">{{ 'machine_calendar.book'|trans }}</button><button type="button" class="btn btn-secondary" id="booking-cancel">{{ 'common.cancel'|trans }}</button></div>
                <div class="booking-message" id="booking-message" aria-live="polite"></div>
            </form>
        {% else %}
            <div class="login-callout"><p>{{ 'machine_calendar.sign_in_to_book'|trans }}</p><a class="btn btn-primary" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a></div>
        {% endif %}
    </section>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
    <script>
        const MACHINE_ID = {{ machine.id }};
        const MACHINE_NAME = {{ machine.nom|json_encode|raw }};
        const MACHINE_STATE = {{ machine.statut|lower|json_encode|raw }};
        const CALENDAR_CONFIG = { startHour: {{ calendarStartHour }}, endHour: {{ calendarEndHour }}, slotMinutes: 60 };
        const RESERVATIONS = [
{# Same rule as calendrier.html.twig: identity only for a viewer entitled to it, no
   `user_id` on the wire, `mine` decided server-side (S38). #}
{% for reservation in reservations %}
{% set mine = viewerId|default(null) is not null and reservation.utilisateur and reservation.utilisateur.id == viewerId %}
{% set showName = showBookerIdentity|default(false) and reservation.utilisateur %}
            { id: {{ reservation.id }}, date: {{ reservation.dateDebut|date('Y-m-d')|json_encode|raw }}, day: {{ reservation.dateDebut|date('N') - 1 }}, start: {{ reservation.dateDebut|date('H:i')|json_encode|raw }}, end: {{ reservation.dateFin|date('H:i')|json_encode|raw }}, mine: {{ mine ? 'true' : 'false' }}, url: {{ mine ? path('app_reservation_detail', {id: reservation.id})|json_encode|raw : 'null' }}, user: {{ showName ? reservation.utilisateur.displayName|json_encode|raw : 'null' }}, motif: {{ ((showBookerIdentity|default(false) or mine) and reservation.motif) ? reservation.motif|json_encode|raw : 'null' }}, statut: {{ reservation.statut|json_encode|raw }} }{{ not loop.last ? ',' : '' }}
{% endfor %}
        ];
        const OPENING_HOURS = {{ openingHoursJson|json_encode|raw }};
        const FABLAB_HOURS = OPENING_HOURS.reduce((hours, row) => { hours[row.dayIndex] = row.isClosed ? null : [timeToMinutes(row.openTime), timeToMinutes(row.closeTime)]; return hours; }, {});
        // ⚠️ **S134d — the envelope above is for LAYOUT, these ranges are for
        // permission.** A day may now open 09:00–12:00 and 14:00–18:00; the
        // envelope spans the lunch break by construction, so anything asking
        // "is this slot bookable" must read FABLAB_RANGES or it will invite
        // members into an hour the server then refuses.
        const FABLAB_RANGES = OPENING_HOURS.reduce((all, row) => { all[row.dayIndex] = (row.ranges || []).map(r => [timeToMinutes(r[0]), timeToMinutes(r[1])]); return all; }, {});
        function isMinuteOpen(dayIndex, minute) { const ranges = FABLAB_RANGES[dayIndex] || []; if (!ranges.length) return FABLAB_HOURS[dayIndex] !== null && FABLAB_HOURS[dayIndex] !== undefined; return ranges.some(([from, to]) => minute >= from && minute < to); }
        function openingRangesLabel(dayIndex) { const ranges = FABLAB_RANGES[dayIndex] || []; if (!ranges.length) return null; return ranges.map(([from, to]) => `${formatMinutes(from)} - ${formatMinutes(to)}`).join(' · '); }
        const IS_AUTHENTICATED = {{ app.user ? 'true' : 'false' }};
        // ⚠️ Every user-visible string this script writes comes from the catalogue,
        // through here. S134c closed the gap the previous note described — this page
        // and `calendrier.html.twig` held the same French literals twice over, on a
        // site that ships five languages. A new string belongs in `messages.*.yaml`
        // and in T below, never inline.
        const MANAGE_LABEL = {{ 'resv.manage'|trans|json_encode|raw }};
        const T = {{ {
            practicalLocked: 'cal.js_practical_locked'|trans,
            venueClosed: 'cal.js_venue_closed'|trans,
            outOfHours: 'cal.js_out_of_hours'|trans,
            available: 'cal.legend_free'|trans,
            clickToBook: 'cal.js_click_to_book'|trans,
            moreBookings: 'cal.js_more_bookings'|trans,
            confirmed: 'cal.js_confirmed'|trans,
            mine: 'cal.js_mine'|trans,
            taken: 'cal.js_taken'|trans,
            endBeforeStart: 'cal.js_end_before_start'|trans,
            outsideHours: 'cal.js_outside_hours'|trans,
            creating: 'cal.js_creating'|trans,
            refused: 'cal.js_refused'|trans,
            created: 'cal.js_created'|trans,
            closedShort: 'cal.js_closed_short'|trans,
            nextWeek: 'cal.next_week'|trans,
            week: 'cal.week_label'|trans,
            hour: 'profile.col_time'|trans,
            unavailableWarning: 'machine_calendar.js_unavailable_warning'|trans,
            datesRequired: 'machine_calendar.js_dates_required'|trans,
            context: 'machine_calendar.js_context'|trans,
            contextDay: 'machine_calendar.js_context_day'|trans,
        }|json_encode|raw }};
        const IS_ADMIN = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};
        const BOOKING_ACCESS = {{ bookingAccess|default({})|json_encode|raw }};
        const HAS_USAGE_RIGHT = {{ usageRight.allowed ? 'true' : 'false' }};
        const USAGE_RIGHT_LABEL = {{ ('usage_rights.verdict.' ~ usageRight.reason ~ '.label')|trans|json_encode|raw }};
        const CAN_RESERVE_MACHINE = (!IS_AUTHENTICATED || IS_ADMIN || Boolean(BOOKING_ACCESS.canReserve)) && HAS_USAGE_RIGHT;
        const BOOKING_LOCK_LABEL = !HAS_USAGE_RIGHT ? USAGE_RIGHT_LABEL : (BOOKING_ACCESS.reasonLabel || T.practicalLocked);
        const TIME_STEP_MINUTES = 15;
        let currentDate = new Date();
        let bookingDraft = null;

        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('prev-week')?.addEventListener('click', () => { currentDate.setDate(currentDate.getDate() - 7); renderCalendar(); });
            document.getElementById('next-week')?.addEventListener('click', () => { currentDate.setDate(currentDate.getDate() + 7); renderCalendar(); });
            document.getElementById('today-week')?.addEventListener('click', () => { currentDate = new Date(); renderCalendar(); });
            document.getElementById('booking-backdrop')?.addEventListener('click', closeBookingPanel);
            document.getElementById('booking-close')?.addEventListener('click', closeBookingPanel);
            document.getElementById('booking-cancel')?.addEventListener('click', closeBookingPanel);
            document.getElementById('booking-form')?.addEventListener('submit', submitBookingForm);
            document.getElementById('booking-start-time')?.addEventListener('change', () => { updateBookingDraftFromControls('start'); });
            document.getElementById('booking-end-time')?.addEventListener('change', () => { updateBookingDraftFromControls('end'); });
            document.querySelectorAll('.duration-chip').forEach(button => button.addEventListener('click', () => applyDurationShortcut(parseInt(button.dataset.duration, 10))));
            document.addEventListener('keydown', event => { if (event.key === 'Escape' && document.getElementById('booking-panel')?.classList.contains('is-open')) closeBookingPanel(); });
            renderCalendar();
        });

        function renderCalendar() { renderHeader(); renderStats(); renderWeekHours(); renderAgenda(); }
        function renderHeader() { const start = getWeekStartDate(currentDate); const end = new Date(start); end.setDate(end.getDate() + 6); document.getElementById('current-week-display').textContent = `${T.week} ${getWeekNumber(currentDate)} · ${start.toLocaleDateString(FABOS_LOCALE, { day: 'numeric', month: 'short' })} - ${end.toLocaleDateString(FABOS_LOCALE, { day: 'numeric', month: 'short', year: 'numeric' })}`; }
        function renderStats() { const today = new Date(); const todayIndex = today.getDay() === 0 ? 6 : today.getDay() - 1; const todayKey = formatDateKey(today); document.getElementById('today-opening-hours').textContent = getOpeningHoursLabel(todayIndex); document.getElementById('today-reservation-count').textContent = RESERVATIONS.filter(res => res.date === todayKey && res.statut !== 'cancelled').length; document.getElementById('next-open-slot').textContent = findNextOpenSlotLabel(); }
        function renderWeekHours() { const days = getWeekDays(); const html = days.map((day, index) => `<span class="week-hour-chip${FABLAB_HOURS[index] === null ? ' closed' : ''}"><strong>${day.toLocaleDateString(FABOS_LOCALE, { weekday: 'short', day: 'numeric' })}</strong><br>${getOpeningHoursLabel(index)}</span>`).join(''); document.getElementById('calendar-week-hours').innerHTML = html; document.getElementById('calendar-week-hours-side').innerHTML = html; }
        function renderAgenda() {
            const grid = document.getElementById('agenda-grid'); const days = getWeekDays(); const hours = getTimeSlots(); const reservations = RESERVATIONS.filter(res => res.statut !== 'cancelled');
            let html = '<div class="agenda-header"><div class="agenda-time-head">${escapeHtml(T.hour)}</div>' + days.map(day => `<div class="agenda-day-head${isSameDay(day, new Date()) ? ' today' : ''}"><span>${day.toLocaleDateString(FABOS_LOCALE, { weekday: 'short', day: 'numeric' })}</span><small>${getOpeningHoursLabel(day.getDay() === 0 ? 6 : day.getDay() - 1)}</small></div>`).join('') + '</div>';
            hours.forEach(hour => { html += `<div class="agenda-row"><div class="agenda-time-cell">${hour}:00</div>`; days.forEach((day, dayIndex) => { const dateKey = formatDateKey(day); const slotStart = parseInt(hour, 10) * 60; const slotReservations = reservations.filter(res => res.date === dateKey && overlapsHour(res, slotStart)); const slotState = getSlotState(dayIndex, slotStart); const lockedByTraining = IS_AUTHENTICATED && !CAN_RESERVE_MACHINE; const canBook = !slotState.closed && !lockedByTraining; const cellClassName = `${slotState.className}${lockedByTraining ? ' is-training-locked' : ''}`; const cellTitle = lockedByTraining ? BOOKING_LOCK_LABEL : T.clickToBook; html += `<div class="agenda-slot-cell ${cellClassName}" data-day="${dayIndex}" data-hour="${hour}"${canBook ? ` role="button" tabindex="0" title="${escapeHtml(cellTitle)}" aria-label="${escapeHtml(cellTitle)}"` : ''}>`; if (slotState.closed) { html += `<span class="slot-state-label">${slotState.label}</span>`; } else { slotReservations.slice(0, 3).forEach(res => html += reservationCardHtml(res)); if (slotReservations.length > 3) html += `<button type="button" class="slot-more-button">${escapeHtml(T.moreBookings.replace('%count%', slotReservations.length - 3))}</button>`; html += lockedByTraining ? `<span class="slot-state-label training-lock-label">${escapeHtml(BOOKING_LOCK_LABEL)}</span>` : `<span class="slot-book-affordance" aria-hidden="true">${isMachineUnavailable() ? '!' : '+'}</span>`; } html += '</div>'; }); html += '</div>'; });
            grid.innerHTML = html; grid.querySelectorAll('.agenda-slot-cell.is-open[role="button"]').forEach(cell => { const open = () => openBookingPanel(parseInt(cell.dataset.day, 10), cell.dataset.hour); cell.addEventListener('click', event => { if (event.target.closest('.slot-reservation-card, .slot-more-button')) return; open(); }); cell.addEventListener('keydown', event => { if (event.key !== 'Enter' && event.key !== ' ') return; event.preventDefault(); open(); }); });
        }
        // `mine` comes from the server; `res.user` is null when the viewer may not
        // see who booked, and the slot must still read as taken. See calendrier.html.twig.
        // ⚠️ Only your own slot is a link — `res.url` is emitted server-side solely
        // when `mine`. `/reservations/{id}` 404s for anyone else, so a link on
        // another member's slot would be a control that cannot work, and it would
        // put their booking id on the wire. Same reasoning as calendrier.html.twig.
        function reservationCardHtml(res) { const mine = res.mine; const who = mine ? T.mine : (res.user ? escapeHtml(res.user) : T.taken); const cls = `slot-reservation-card${mine ? ' mine' : ''}`; const body = `<strong>${escapeHtml(res.start)} - ${escapeHtml(res.end)}</strong><span>${who} · ${escapeHtml(T.confirmed)}</span>${res.motif ? `<span>${escapeHtml(res.motif)}</span>` : ''}`; return res.url ? `<a class="${cls} is-linked" href="${escapeHtml(res.url)}" title="${escapeHtml(MANAGE_LABEL)}">${body}</a>` : `<article class="${cls}">${body}</article>`; }
        function openBookingPanel(dayIndex, hourStr) { const panel = document.getElementById('booking-panel'); document.getElementById('booking-backdrop').classList.add('is-open'); panel.classList.add('is-open'); panel.setAttribute('aria-hidden', 'false'); document.body.classList.add('booking-modal-open'); if (!IS_AUTHENTICATED) { const startValue = buildDateTimeLocal(dayIndex, hourStr, 0); const endValue = buildDateTimeLocal(dayIndex, hourStr, CALENDAR_CONFIG.slotMinutes); document.getElementById('booking-context').textContent = T.context.replace('%machine%', MACHINE_NAME).replace('%start%', startValue.replace('T', ' ')).replace('%end%', endValue.split('T')[1]); return; } if (!CAN_RESERVE_MACHINE) { document.getElementById('booking-context').textContent = BOOKING_LOCK_LABEL; setBookingMessage(BOOKING_LOCK_LABEL, 'error'); document.getElementById('booking-submit').disabled = true; return; } setBookingSelection(dayIndex, hourStr); document.getElementById('booking-submit').disabled = false; setBookingMessage(isMachineUnavailable() ? T.unavailableWarning : '', isMachineUnavailable() ? 'error' : ''); window.setTimeout(() => document.getElementById('booking-start-time')?.focus(), 80); }
        function setBookingSelection(dayIndex, hourStr) { const day = getWeekDays()[dayIndex]; const slotStart = parseInt(hourStr, 10) * 60; const opening = FABLAB_HOURS[dayIndex]; const defaultEnd = opening ? Math.min(slotStart + CALENDAR_CONFIG.slotMinutes, opening[1]) : slotStart + CALENDAR_CONFIG.slotMinutes; bookingDraft = { dayIndex, dateKey: formatDateKey(day), date: day, startMinutes: slotStart, endMinutes: defaultEnd }; populateBookingTimeControls(); syncBookingHiddenFields(); }
        function populateBookingTimeControls() { if (!bookingDraft) return; const opening = FABLAB_HOURS[bookingDraft.dayIndex]; const startSelect = document.getElementById('booking-start-time'); const endSelect = document.getElementById('booking-end-time'); if (!startSelect || !endSelect) return; const min = opening ? opening[0] : CALENDAR_CONFIG.startHour * 60; const max = opening ? opening[1] : CALENDAR_CONFIG.endHour * 60; startSelect.innerHTML = buildTimeOptions(min, Math.max(min, max - TIME_STEP_MINUTES), bookingDraft.startMinutes); endSelect.innerHTML = buildTimeOptions(min + TIME_STEP_MINUTES, max, bookingDraft.endMinutes); startSelect.value = String(bookingDraft.startMinutes); endSelect.value = String(bookingDraft.endMinutes); }
        function updateBookingDraftFromControls(changed) { if (!bookingDraft) return; const startSelect = document.getElementById('booking-start-time'); const endSelect = document.getElementById('booking-end-time'); bookingDraft.startMinutes = parseInt(startSelect.value, 10); bookingDraft.endMinutes = parseInt(endSelect.value, 10); if (changed === 'start' && bookingDraft.endMinutes <= bookingDraft.startMinutes) { bookingDraft.endMinutes = bookingDraft.startMinutes + CALENDAR_CONFIG.slotMinutes; populateBookingTimeControls(); } syncBookingHiddenFields(); }
        function applyDurationShortcut(durationMinutes) { if (!bookingDraft) return; const opening = FABLAB_HOURS[bookingDraft.dayIndex]; bookingDraft.endMinutes = opening ? Math.min(bookingDraft.startMinutes + durationMinutes, opening[1]) : bookingDraft.startMinutes + durationMinutes; document.querySelectorAll('.duration-chip').forEach(button => button.classList.toggle('is-active', parseInt(button.dataset.duration, 10) === durationMinutes)); populateBookingTimeControls(); syncBookingHiddenFields(); }
        function syncBookingHiddenFields() { if (!bookingDraft) return; document.getElementById('booking-start').value = `${bookingDraft.dateKey}T${formatMinutes(bookingDraft.startMinutes)}`; document.getElementById('booking-end').value = `${bookingDraft.dateKey}T${formatMinutes(bookingDraft.endMinutes)}`; document.getElementById('booking-date-label').textContent = bookingDraft.date.toLocaleDateString(FABOS_LOCALE, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }); document.getElementById('booking-time-label').textContent = `${formatMinutes(bookingDraft.startMinutes)} - ${formatMinutes(bookingDraft.endMinutes)}`; document.getElementById('booking-context').textContent = T.contextDay.replace('%machine%', MACHINE_NAME).replace('%day%', bookingDraft.date.toLocaleDateString(FABOS_LOCALE, { weekday: 'short', day: 'numeric', month: 'short' })); validateBookingDraft(); }
        function validateBookingDraft() { if (!bookingDraft) return false; const opening = FABLAB_HOURS[bookingDraft.dayIndex]; let message = ''; if (bookingDraft.endMinutes <= bookingDraft.startMinutes) message = T.endBeforeStart; if (opening && (bookingDraft.startMinutes < opening[0] || bookingDraft.endMinutes > opening[1])) message = T.outsideHours; if (IS_AUTHENTICATED && !CAN_RESERVE_MACHINE) message = BOOKING_LOCK_LABEL; const valid = !message; document.getElementById('booking-submit').disabled = !valid; setBookingMessage(message || (isMachineUnavailable() ? T.unavailableWarning : ''), message ? 'error' : (isMachineUnavailable() ? 'error' : '')); return valid; }
        function buildTimeOptions(min, max, selected) { let html = ''; for (let minutes = min; minutes <= max; minutes += TIME_STEP_MINUTES) html += `<option value="${minutes}"${minutes === selected ? ' selected' : ''}>${formatMinutes(minutes)}</option>`; return html; }
        function closeBookingPanel() { document.getElementById('booking-panel').classList.remove('is-open'); document.getElementById('booking-backdrop').classList.remove('is-open'); document.getElementById('booking-panel').setAttribute('aria-hidden', 'true'); document.body.classList.remove('booking-modal-open'); }
        async function submitBookingForm(event) { event.preventDefault(); const form = event.currentTarget; if (!form.dateDebut.value || !form.dateFin.value) return setBookingMessage(T.datesRequired, 'error'); if (!validateBookingDraft()) return; if (new Date(form.dateFin.value) <= new Date(form.dateDebut.value)) return setBookingMessage(T.endBeforeStart, 'error'); setBookingMessage(T.creating, 'loading'); document.getElementById('booking-submit').disabled = true; try { const response = await fetch('{{ path('api_reservation_create') }}', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ reservableType: 'machine', reservableId: form.machineId.value, dateDebut: form.dateDebut.value, dateFin: form.dateFin.value, motif: form.motif.value }) }); const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.error || T.refused); setBookingMessage(T.created, 'success'); window.setTimeout(() => window.location.reload(), 700); } catch (error) { setBookingMessage(error.message, 'error'); document.getElementById('booking-submit').disabled = false; } }
        function setBookingMessage(text, state) { const message = document.getElementById('booking-message'); if (!message) return; message.textContent = text; message.className = `booking-message ${state}`; }
        function isMachineUnavailable() { return /maintenance|panne|indisponible|hors/.test(MACHINE_STATE); }
        function getSlotState(dayIndex, slotStart) { const hours = FABLAB_HOURS[dayIndex]; if (!hours) return { closed: true, className: 'is-closed', label: T.venueClosed }; /* ⚠️ S134d — the RANGES decide, not the envelope: between two ranges the lab is shut. */ if (!isMinuteOpen(dayIndex, slotStart)) return { closed: true, className: 'is-out', label: T.outOfHours }; return { closed: false, className: 'is-open', label: T.available }; }
        function overlapsHour(res, slotStart) { const start = timeToMinutes(res.start); const end = timeToMinutes(res.end); return start < slotStart + 60 && end > slotStart; }
        function findNextOpenSlotLabel() { const days = getWeekDays(); const now = new Date(); for (let d = 0; d < days.length; d++) { const hours = FABLAB_HOURS[d]; if (!hours) continue; for (let minutes = hours[0]; minutes < hours[1]; minutes += 60) { const candidate = new Date(days[d]); candidate.setHours(Math.floor(minutes / 60), minutes % 60, 0, 0); if (candidate > now) return candidate.toLocaleDateString(FABOS_LOCALE, { weekday: 'short', day: 'numeric' }) + ' ' + formatMinutes(minutes); } } return T.nextWeek; }
        function timeToMinutes(value) { if (!value) return 0; const [h, m] = value.split(':').map(Number); return h * 60 + (m || 0); }
        function formatMinutes(total) { return `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`; }
        function getOpeningHoursLabel(dayIndex) { return openingRangesLabel(dayIndex) || (FABLAB_HOURS[dayIndex] ? `${formatMinutes(FABLAB_HOURS[dayIndex][0])} - ${formatMinutes(FABLAB_HOURS[dayIndex][1])}` : T.closedShort); }
        function getWeekStartDate(date) { const d = new Date(date); const day = d.getDay(); const diff = d.getDate() - day + (day === 0 ? -6 : 1); d.setDate(diff); d.setHours(0,0,0,0); return d; }
        function getWeekDays() { const start = getWeekStartDate(currentDate); return Array.from({length: 7}, (_, i) => { const day = new Date(start); day.setDate(start.getDate() + i); return day; }); }
        function getTimeSlots() { return Array.from({length: CALENDAR_CONFIG.endHour - CALENDAR_CONFIG.startHour}, (_, i) => String(CALENDAR_CONFIG.startHour + i).padStart(2, '0')); }
        function getWeekNumber(date) { const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate())); d.setUTCDate(d.getUTCDate() + 4 - (d.getUTCDay() || 7)); const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1)); return Math.ceil((((d - yearStart) / 86400000) + 1) / 7); }
        function isSameDay(a, b) { return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate(); }
        function formatDateKey(date) { return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`; }
        function buildDateTimeLocal(dayIndex, hourStr, offsetMinutes) { const day = getWeekDays()[dayIndex]; const date = new Date(day); date.setHours(parseInt(hourStr, 10), offsetMinutes, 0, 0); return `${formatDateKey(date)}T${String(date.getHours()).padStart(2,'0')}:${String(date.getMinutes()).padStart(2,'0')}`; }
        function escapeHtml(value) { return String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;'); }
    </script>
{% endblock %}
