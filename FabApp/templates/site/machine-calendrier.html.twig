{% extends 'site/base_public.html.twig' %}

{#
   One machine's calendar.

   ⚠️ **Same component as `/calendrier` (S146a).** The grid, the week and month
   views, the opening-hours rules and the booking dialog come from
   `site/_calendar.html.twig` + `site/_calendar_booking.html.twig`. This file keeps
   only what is about THIS machine: its identity, its badges, its status and the
   sentence that says why booking is locked when it is.

   ⚠️ **The week it draws is this machine's LOCATION's week**, not the default
   venue's — the controller passes `machine.venue`. Reading one location's hours
   over another location's machine is the fault S145a existed to fix.

   ⚠️ **`/machines/{id}/calendrier` is on its way out.** S146b folds this into the
   machine's own page and leaves a redirect; keep new behaviour in the component,
   not here.
#}

{% block title %}{{ 'machine_calendar.browser_title'|trans({'%machine%': machine.nom}) }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=20260709-calheader-userlogo' }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-fix.css') }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-modern.css') ~ '?v=20260820-s146a' }}">
{% endblock %}

{% block body %}

    <main class="main-content calendar-modern-page">
        <section class="container calendar-shell"
                 data-controller="calendar"
                 data-calendar-payload-value="{{ calendar|json_encode }}">
            {% include 'site/_breadcrumb.html.twig' with {trail: [
                {label: 'nav.home'|trans, url: path('app_home')},
                {label: 'nav.machines'|trans, url: path('app_machines')},
                {label: machine.nom, url: path('app_machine_detail', {id: machine.id})},
                {label: 'nav.calendar'|trans},
            ]} only %}

            <div class="calendar-hero">
                <div>
                    <span class="calendar-eyebrow">{{ 'mcal.title'|trans }}</span>
                    <h1>{{ machine.nom }}</h1>
                    <p>{{ machine.localisation ?? 'machine_calendar.no_location'|trans }} · {{ machine.categoryLabel }} · {{ 'machine_calendar.slot_length'|trans({'%length%': machine.granulariteLabel}) }}</p>
                </div>
                <div class="calendar-actions">
                    <a class="btn btn-secondary" href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ 'mcal.back_machine'|trans }}</a>
                    {% if app.user %}<a class="btn btn-secondary" href="{{ path('app_my_reservations') }}">{{ 'resv.title'|trans }}</a>{% endif %}
                    {% if app.user %}
                        {% set ical_url = url('app_machine_ical', {id: machine.id}) ~ '?token=' ~ ical_feed_token() %}
                        <a class="btn btn-secondary" href="{{ ical_url|replace({'https://': 'webcal://', 'http://': 'webcal://'}) }}" title="{{ 'ical.subscribe_hint'|trans }}">📅 {{ 'ical.subscribe'|trans }}</a>
                    {% endif %}
                    <a class="btn btn-primary" href="{{ path('app_calendar') }}">{{ 'mcal.full_calendar'|trans }}</a>
                </div>
            </div>

            <div class="calendar-stats">
                {# 🔴 **This printed `machine.statut` RAW** — the stored word, so an install
                   holding `idle` showed the English database value on a French page, and
                   the class came off that same word so a value no stylesheet knew about
                   got no colour at all. It is the exact fault S84 fixed on /admin/machines
                   and it survived here. `getStatusKey()` is the one mapping. #}
                <article class="calendar-stat-card"><span>{{ 'mcal.machine_status'|trans }}</span><strong>{% include 'site/_cell_state.html.twig' with {
                    label: machine.statusKey|trans,
                    signal: machine.statusKey == 'machines.st_available' ? 'go' : (machine.statusKey == 'machines.st_maintenance' ? 'caution' : 'stop'),
                } only %}</strong></article>
                <article class="calendar-stat-card"><span>{{ 'cal.today_hours'|trans }}</span><strong data-calendar-target="todayHours">{{ 'cal.loading'|trans }}</strong></article>
                <article class="calendar-stat-card"><span>{{ 'cal.reservations_today'|trans }}</span><strong data-calendar-target="todayCount">0</strong></article>
                <article class="calendar-stat-card"><span>{{ 'cal.next_slot'|trans }}</span><strong data-calendar-target="nextSlot">{{ 'cal.select'|trans }}</strong></article>
            </div>

            <div class="calendar-workspace machine-specific-layout">
                <aside class="machine-context-panel">
                    <h2>{{ machine.nom }}</h2>
                    {% include 'site/_cell_state.html.twig' with {
                        label: machine.statusKey|trans,
                        signal: machine.statusKey == 'machines.st_available' ? 'go' : (machine.statusKey == 'machines.st_maintenance' ? 'caution' : 'stop'),
                    } only %}
                    <p>{{ machine.description ?: machine.requirementDescription }}</p>
                    <div class="panel-title-row"><h2>{{ 'kiosk.machine_required_badges'|trans }}</h2></div>
                    <div class="badge-strip">
                        {% for machineBadge in machine.requiredMachineBadges %}
                            {% set badge = machineBadge.badge %}
                            {% if badge %}<span class="badge-chip">{{ badge.nom }}</span>{% endif %}
                        {% else %}
                            <span class="badge-chip">{{ 'machine.no_badges'|trans }}</span>
                        {% endfor %}
                    </div>
                    <div class="panel-title-row" style="margin-top: 18px;"><h2>{{ 'home.col_hours'|trans }}</h2></div>
                    <div class="week-hours-strip" data-calendar-target="weekHours" aria-label="{{ 'mcal.week_hours_aria'|trans }}"></div>
                    {% if machine.statut|lower matches '/maintenance|panne|indisponible|hors/' %}
                        <div class="login-callout" style="margin-top: 16px;">{{ 'mcal.not_available_notice'|trans }}</div>
                    {% endif %}
                    {% if usageRight.enforced and not usageRight.allowed %}
                        {% include 'site/_usage_right_state.html.twig' with {
                            capability: usageRight.capability,
                            verdict: usageRight,
                            compact: true,
                            action: usageRight.reason == 'signin_required'
                                ? {label: 'nav.login'|trans, url: path('app_login')}
                                : {label: 'usage_rights.my_rights'|trans, url: path('app_profile') ~ '#usage-rights'}
                        } only %}
                    {% endif %}
                    {% if app.user and not is_granted('ROLE_ADMIN') and bookingAccess and not bookingAccess.canReserve %}
                        <div class="login-callout training-lock-callout" style="margin-top: 16px;">{{ bookingAccess.reasonLabel ?: 'machine_calendar.training_not_validated'|trans }}{{ 'machine_calendar.locked_note'|trans }}</div>
                    {% endif %}
                </aside>

                {% include 'site/_calendar.html.twig' with {
                    heading: 'mcal.availability'|trans,
                    subtitle: 'mcal.click_slot'|trans,
                } only %}
            </div>

            {% include 'site/_calendar_booking.html.twig' with {
                title: 'machine_calendar.book_slot'|trans,
                hint: 'machine_calendar.pick_free_slot'|trans,
                resources: resources,
                resources_by_kind: {},
                booking_access: {},
                signed_in: app.user is not null,
            } only %}
        </section>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
{% endblock %}
