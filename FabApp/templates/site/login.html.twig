{% extends 'site/base_public.html.twig' %}

{% block title %}{{ 'login.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260824-s149b' }}">
{% endblock %}

{% block body %}

    <!-- ========================================
         CONTENU PRINCIPAL - FORMULAIRE DE CONNEXION
         ======================================== -->
    <main id="main-content" tabindex="-1" class="main-content">
        <section class="login-section">
            <div class="container">
                <div class="login-container">
                    <!-- Cartouche de section -->
                    <div class="section-badge login-badge">{{ 'nav.login'|trans }}</div>
                    
                    <div class="login-card">
                        <div class="login-header">
                            <h1 class="login-title">{{ 'login.welcome'|trans }}</h1>
                            <p class="login-subtitle">{{ 'login.subtitle'|trans }}</p>
                        </div>

                        <div class="login-illustration">
                            <svg viewBox="0 0 200 150" class="login-icon" aria-label="{{ 'login.illustration_alt'|trans }}">
                                <rect x="50" y="40" width="100" height="70" fill="none" stroke="#9E1B56" stroke-width="3" rx="5"/>
                                <circle cx="100" cy="30" r="15" fill="none" stroke="#9E1B56" stroke-width="3"/>
                                <path d="M80 75 Q100 90 120 75" fill="none" stroke="#9E1B56" stroke-width="2"/>
                                <line x1="90" y1="85" x2="110" y2="85" stroke="#9E1B56" stroke-width="2"/>
                            </svg>
                        </div>

                        <form class="login-form" id="loginForm" method="post" action="{{ path('app_login') }}">
                            {% for message in app.flashes('success') %}
                                <div class="auth-alert auth-alert-success">{{ message|flash_text }}</div>
                            {% endfor %}
                            {% if error %}
                                <div class="auth-alert auth-alert-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            {% endif %}
                            <div class="form-group">
                                <label for="email" class="form-label">{{ 'login.email_label'|trans }}</label>
                                <div class="input-wrapper">
                                    <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                        <polyline points="22,6 12,13 2,6"/>
                                    </svg>
                                    <input type="email" id="email" name="_username" class="form-input" placeholder="{{ 'login.email_placeholder'|trans }}" value="{{ last_username|default('') }}" required>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="password" class="form-label">{{ 'login.password_label'|trans }}</label>
                                <div class="input-wrapper">
                                    <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                    </svg>
                                    <input type="password" id="password" name="_password" class="form-input" placeholder="{{ 'login.password_placeholder'|trans }}" required>
                                    <button type="button" class="password-toggle" aria-label="{{ 'login.show_password'|trans }}">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <div class="form-options">
                                <label class="checkbox-wrapper">
                                    <input type="checkbox" id="remember" name="_remember_me">
                                    <span class="checkmark"></span>
                                    <span class="checkbox-label">{{ 'login.remember'|trans }}</span>
                                </label>
                                <a href="{{ path('app_forgot_password') }}" class="forgot-link">{{ 'login.forgot'|trans }}</a>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                            <button type="submit" id="loginSubmitButton" class="btn btn-primary btn-block btn-large">
                                {{ 'login.submit'|trans }}
                            </button>
                        </form>
                        {% if oidcProviders|default([]) is not empty %}<div class="auth-federated"><p>{{ 'network.sign_in_with'|trans }}</p>{% for provider in oidcProviders %}<a class="btn btn-secondary btn-block" href="{{ path('app_oidc_start',{provider:provider.key}) }}">{{ provider.label }}</a>{% endfor %}</div>{% endif %}

                        <div class="login-footer">
                            <p class="no-account">{{ 'login.no_account'|trans }} 
                                <a href="{{ path('app_register') }}" class="register-link">{{ 'login.create_one'|trans }}</a>
                            </p>
                        </div>
                    </div>

                    <!-- Informations supplémentaires -->
                    <div class="login-info">
                        <div class="info-card">
                            <div class="info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                                    <line x1="12" y1="9" x2="12" y2="13"/>
                                    <line x1="12" y1="17" x2="12.01" y2="17"/>
                                </svg>
                            </div>
                            <div class="info-content">
                                <h4>{{ 'login.secure_title'|trans }}</h4>
                                <p>{{ 'login.secure_desc'|trans }}</p>
                            </div>
                        </div>
                        
                        <div class="info-card">
                            <div class="info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polyline points="12,6 12,12 16,14"/>
                                </svg>
                            </div>
                            <div class="info-content">
                                <h4>{{ 'login.hours_title'|trans }}</h4>
                                <p>{{ 'login.hours_desc'|trans }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- ========================================
         FOOTER
         ======================================== -->
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
    <script>
        document.getElementById('loginForm')?.addEventListener('submit', function (event) {
            const submit = document.getElementById('loginSubmitButton');
            if (!submit || submit.disabled) {
                event.preventDefault();
                return;
            }

            submit.disabled = true;
            submit.setAttribute('aria-busy', 'true');
        });

        // A back/forward-cache restore must not leave the form permanently disabled.
        window.addEventListener('pageshow', function () {
            const submit = document.getElementById('loginSubmitButton');
            submit?.removeAttribute('aria-busy');
            if (submit) submit.disabled = false;
        });
    </script>
{% endblock %}
