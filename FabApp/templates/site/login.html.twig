<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    <!-- ========================================
         BANDEAU D'ALERTE
         ======================================== -->
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <!-- ========================================
         HEADER
         ======================================== -->
    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    {% include 'site/_logo.html.twig' %}
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">{{ 'nav.home'|trans }}</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">{{ 'nav.calendar'|trans }}</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">{{ 'nav.machines'|trans }}</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">{{ 'nav.trainings'|trans }}</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">{{ 'nav.leaderboard'|trans }}</a><a href="{{ path('app_leaderboard_creations') }}" class="navbar-link">{{ 'nav.projects'|trans }}</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">{{ 'nav.admin'|trans }}</a>
                    {% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- ========================================
         CONTENU PRINCIPAL - FORMULAIRE DE CONNEXION
         ======================================== -->
    <main class="main-content">
        <section class="login-section">
            <div class="container">
                <div class="login-container">
                    <!-- Cartouche de section -->
                    <div class="section-badge login-badge">Connexion</div>
                    
                    <div class="login-card">
                        <div class="login-header">
                            <h1 class="login-title">Bienvenue sur FabOS</h1>
                            <p class="login-subtitle">Connectez-vous pour accéder à toutes les fonctionnalités</p>
                        </div>

                        <div class="login-illustration">
                            <svg viewBox="0 0 200 150" class="login-icon" aria-label="Connexion">
                                <rect x="50" y="40" width="100" height="70" fill="none" stroke="#9E1B56" stroke-width="3" rx="5"/>
                                <circle cx="100" cy="30" r="15" fill="none" stroke="#9E1B56" stroke-width="3"/>
                                <path d="M80 75 Q100 90 120 75" fill="none" stroke="#9E1B56" stroke-width="2"/>
                                <line x1="90" y1="85" x2="110" y2="85" stroke="#9E1B56" stroke-width="2"/>
                            </svg>
                        </div>

                        <form class="login-form" id="loginForm" method="post" action="{{ path('app_login') }}">
                            {% for message in app.flashes('success') %}
                                <div class="auth-alert auth-alert-success">{{ message }}</div>
                            {% endfor %}
                            {% if error %}
                                <div class="auth-alert auth-alert-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            {% endif %}
                            <div class="form-group">
                                <label for="email" class="form-label">Adresse email ou identifiant CAS</label>
                                <div class="input-wrapper">
                                    <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                        <polyline points="22,6 12,13 2,6"/>
                                    </svg>
                                    <input type="email" id="email" name="_username" class="form-input" placeholder="votre.email@ensea.fr" value="{{ last_username|default('') }}" required>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="password" class="form-label">Mot de passe</label>
                                <div class="input-wrapper">
                                    <svg viewBox="0 0 24 24" class="input-icon" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                    </svg>
                                    <input type="password" id="password" name="_password" class="form-input" placeholder="Votre mot de passe" required>
                                    <button type="button" class="password-toggle" aria-label="Afficher le mot de passe">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <div class="form-options">
                                <label class="checkbox-wrapper">
                                    <input type="checkbox" id="remember" name="_remember_me">
                                    <span class="checkmark"></span>
                                    <span class="checkbox-label">Se souvenir de moi</span>
                                </label>
                                <a href="{{ path('app_forgot_password') }}" class="forgot-link">Mot de passe oublié ?</a>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                            <button type="submit" class="btn btn-primary btn-block btn-large">
                                Se connecter
                            </button>

                            <div class="login-divider">
                                <span class="divider-text">ou</span>
                            </div>

                            <button type="button" class="btn btn-secondary btn-block btn-cas" disabled title="Connexion CAS bientôt disponible">
                                <svg viewBox="0 0 24 24" class="cas-icon" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                    <line x1="8" y1="21" x2="16" y2="21"/>
                                    <line x1="12" y1="17" x2="12" y2="21"/>
                                </svg>
                                Connexion CAS bientôt disponible
                            </button>
                        </form>

                        <div class="login-footer">
                            <p class="no-account">Vous n'avez pas de compte ? 
                                <a href="{{ path('app_register') }}" class="register-link">Créez-en un</a>
                            </p>
                        </div>
                    </div>

                    <!-- Informations supplémentaires -->
                    <div class="login-info">
                        <div class="info-card">
                            <div class="info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                                    <line x1="12" y1="9" x2="12" y2="13"/>
                                    <line x1="12" y1="17" x2="12.01" y2="17"/>
                                </svg>
                            </div>
                            <div class="info-content">
                                <h4>Accès sécurisé</h4>
                                <p>Vos données sont protégées par chiffrement SSL et conforme RGPD.</p>
                            </div>
                        </div>
                        
                        <div class="info-card">
                            <div class="info-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polyline points="12,6 12,12 16,14"/>
                                </svg>
                            </div>
                            <div class="info-content">
                                <h4>Horaires d'accès</h4>
                                <p>Le FabLab est accessible selon les horaires d'ouverture de l'ENSEA.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- ========================================
         FOOTER
         ======================================== -->
    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') ~ '?v=20260709-header-scope' }}"></script>
</body>
</html>
