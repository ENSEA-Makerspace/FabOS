{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'materials.edit_browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260903-design2' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260903-design2' }}">
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel admin-list-card admin-form-card">
                {% include 'site/_admin_form_head.html.twig' with {
                    title: 'materials.edit_title'|trans,
                    subtitle: material.name,
                    back_href: path('app_admin_materials'),
                    back_label: 'materials.back'|trans,
                } only %}
                <div class="admin-edit-panel-header"><h2>{{ material.name }}</h2></div>
                {{ include('site/_material_form.html.twig', {form: form, submit_label: 'common.save_changes'|trans}) }}
                {% include 'site/_admin_danger_zone.html.twig' with {
                    action: path('app_admin_material_delete', {id: material.id}),
                    token: 'delete_material_' ~ material.id,
                    heading: (material.archived ? 'adm.restore_record' : 'adm.archive_record')|trans,
                    label: (material.archived ? 'adm.restore_record' : 'adm.archive_record')|trans,
                    description: (material.archived ? 'adm.restore_record_notice' : 'adm.archive_record_notice')|trans,
                    confirm: (material.archived ? 'adm.restore_record_confirm' : 'adm.archive_record_confirm')|trans({'%name%': material.name}),
                } only %}
            </section>
        </div>
    </main>
{% endblock %}
