<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier {{ formation.titre }} - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260731-tokens' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260731-tokens' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260801-s48' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        .admin-edit-panel-header { padding: 20px 24px; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; gap: 16px; align-items: start; flex-wrap: wrap; }
        .form-field input, .form-field select, .form-field textarea { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px; background: #fff; }
        .form-field textarea { min-height: 120px; resize: vertical; }
        .readonly-grid { display: grid; grid-template-columns: repeat(2, minmax(160px, 1fr)); gap: 12px; padding: 16px 24px 0; }
        .readonly-item { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; }
        .readonly-label { display: block; color: #6b7280; font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 5px; }
        .readonly-value { color: #111827; overflow-wrap: anywhere; }
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid, .readonly-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Modifier une formation</h1>
                    <p>{{ formation.titre }}</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_formations') }}">Retour aux formations</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <div>
                        <h2>Champs modifiables</h2>
                        <p>ID et relations complexes restent verrouillés.</p>
                    </div>
                    <a class="btn-link" href="{{ path('app_formation_detail', {id: formation.id}) }}">Voir la fiche publique</a>
                </div>

                <div class="readonly-grid">
                    <div class="readonly-item"><span class="readonly-label">ID</span><span class="readonly-value">#{{ formation.id }}</span></div>
                    <div class="readonly-item"><span class="readonly-label">Badge associé</span><span class="readonly-value">{{ formation.badge ? formation.badge.nom : 'Aucun' }}</span></div>
                </div>

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    <div class="form-errors">{{ form_errors(form) }}</div>
                    <div class="form-grid">
                        {% for field in [form.titre, form.image, form.categorie, form.niveau, form.duree, form.formateur, form.placesTotales, form.badge] %}
                            <div class="form-field">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}

                        {% for field in [form.description, form.objectifs, form.prerequis, form.materielFourni] %}
                            <div class="form-field full">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_formations') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
</body>
</html>
