{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_formations.browser_title_edit'|trans({'%formation%': formation.titre}) }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260827-s152c' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260827-s152c' }}">
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel admin-list-card admin-form-card">
                {% include 'site/_admin_form_head.html.twig' with {
                    title: 'admin_formations.edit_title'|trans,
                    subtitle: formation.titre,
                    back_href: path('app_admin_formations'),
                    back_label: 'admin_formations.back'|trans,
                } only %}
                <div class="admin-edit-panel-header">
                    <div>
                        <h2>{{ 'admin_form.fields_heading'|trans }}</h2>
                        <p>{{ 'admin_formations.fields_hint'|trans }}</p>
                    </div>
                    <a class="btn-link" href="{{ path('app_formation_detail', {id: formation.id}) }}">{{ 'admin_form.view_public'|trans }}</a>
                </div>

                {% include 'site/_admin_meta_grid.html.twig' with {items: [
                    {label: 'ID', value: '#' ~ formation.id},
                    {label: 'admin_formations.badge_label'|trans, value: formation.badge ? formation.badge.nom : 'common.none'|trans},
                ]} only %}

                {% include 'site/_formation_form.html.twig' with {
                    form: form,
                } only %}
                <form method="post" action="{{ path('app_admin_formation_archive', {id: formation.id}) }}" class="admin-archive-action">
                    <input type="hidden" name="_token" value="{{ csrf_token('archive_formation_' ~ formation.id) }}">
                    {% if formation.archived %}<input type="hidden" name="restore" value="1">{% endif %}
                    <button class="btn-link {{ formation.archived ? '' : 'btn-danger-admin' }}" type="submit">{{ (formation.archived ? 'admin_formation_form.restore' : 'admin_formation_form.archive')|trans }}</button>
                    <p>{{ 'admin_formation_form.archive_note'|trans }}</p>
                </form>

            </section>
        </div>
    </main>
{% endblock %}
