{% extends 'base.html.twig' %}

{# LES PAGES REVUES D'APRÈS LES PLANCHES (2026-10-01), menu Développement.
   L'index : le tri des 52 planches face à nos pages (`docs/references/PROPOSITIONS.md`,
   rendu ici plutôt que recopié), puis une vignette par proposition. Chaque
   proposition est aussi une sous-page du menu.
   ⚠️ Non traduit, comme les autres outils de ce menu. #}

{% block title %}Propositions — Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with { panel_title: 'Propositions de pages' } %}
    {% block content %}
        <div class="pp-index">
            <p class="pp-index-intro">Chaque planche de <a href="{{ path('app_admin_references') }}">Références</a> est comparée à la page qui existe. Quand la planche apporte une meilleure idée, une <b>proposition</b> la pose sur nos composants — à regarder, puis à retenir ou refuser. Rien ici n’enregistre quoi que ce soit.</p>
            <div class="pp-index-grid">
                {% for p in proposals %}
                    <a class="pp-index-card" href="{{ path('app_admin_proposal', {slug: p.slug}) }}">
                        <img src="{{ asset('images/references/' ~ p.planche) }}" alt="" loading="lazy">
                        <div class="pp-index-name">{{ p.title }}</div>
                        <div class="pp-index-cur">remplacerait {{ p.current.label }}</div>
                    </a>
                {% endfor %}
            </div>
            {% if triage %}<div class="pp-triage">{{ triage|raw }}</div>{% endif %}
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
