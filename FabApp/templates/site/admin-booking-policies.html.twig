{% extends 'base.html.twig' %}
{% block title %}{{ 'booking_policy.title'|trans }} - FabOS{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260816-s143' }}">{% endblock %}
{% block body %}
{# ⚠️ The band says "Quotas"; WHICH quotas is the whole point of this screen, and
   it used to be the visible panel heading. `panel_note` puts it back as the
   band's subtitle. Written ABOVE the embed, never between two keys of its
   argument hash — a Twig comment there is a syntax error. #}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: ('reservable.type.' ~ selectedType.value)|trans,
    panel_note: ('reservable.type.' ~ selectedType.value)|trans,
    list_route: 'app_admin_booking_policies',
    workspace_key: workspaceKey,
} %}
    {% block content %}
        <form method="post" action="{{ path('app_admin_booking_policies', {reservableType: selectedType.value}) }}" class="admin-edit-panel">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_booking_policies') }}">
            <p class="blueprint-footnote">{{ 'booking_policy.empty_hint'|trans }}</p>
            <div class="policy-profiles">
                {% for tierKey, cell in grid %}
                    <details class="policy-profile"{{ cell.restricted ? ' open' : '' }}>
                        <summary><span>{{ cell.tierLabel }}</span>{% if cell.restricted %}{% include 'site/_state_chip.html.twig' with {label: 'booking_policy.restricted'|trans, signal: 'caution'} only %}{% endif %}</summary>
                        <div class="form-grid">
                            {% for field in fields %}
                                <div class="form-field">
                                    <label for="policy-{{ tierKey }}-{{ field }}">{{ ('booking_policy.field.' ~ field)|trans }}</label>
                                    <input id="policy-{{ tierKey }}-{{ field }}" type="number" min="0" step="1" name="{{ selectedType.value }}_{{ tierKey }}_{{ field }}" value="{{ cell.values[field] is null ? '' : cell.values[field] }}" placeholder="—">
                                    <small>{{ ('booking_policy.help.' ~ field)|trans }}</small>
                                </div>
                            {% endfor %}
                        </div>
                    </details>
                {% endfor %}
            </div>
            <div class="admin-actions"><button type="submit" class="btn-link btn-primary-admin">{{ 'common.save'|trans }}</button></div>
        </form>
    {% endblock %}
{% endembed %}
{% endblock %}
