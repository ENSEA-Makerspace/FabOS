{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ (mode == 'new' ? 'rfid_form.title_new' : 'rfid_form.title_edit')|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260827-s151b' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260827-s151b' }}">
    <style>
        {# What this screen has and no other does: the .env block the operator copies
           into the reader, and the dialog trigger rows. Everything else — the form
           controls, the buttons, both dialogs, the danger zone, the help callout — is
           in admin.css since S142. #}
        .header-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-left: auto; }
        .danger-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        .form-field.checkbox { display: grid; grid-template-columns: auto 1fr; column-gap: 10px; align-items: start; }
        .form-field.checkbox input { margin-top: 3px; }
        .form-field.checkbox .form-help, .form-field.checkbox .form-errors { grid-column: 2; }
        .env-header { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin: 18px 24px 8px; flex-wrap: wrap; }
        .env-title { font-weight: 800; color: var(--color-text); }
        .env-note { margin: 0 24px; color: var(--color-text-light); font-size: 13px; }
        .env-example { margin: 10px 24px 0; padding: 16px; background: #111827; color: #e5e7eb; border-radius: 8px; overflow-x: auto; }
        .env-example code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; white-space: pre; }
        .copy-feedback { min-height: 18px; margin: 8px 24px 0; color: var(--color-ok-fill); font-weight: 700; font-size: 13px; }
    </style>
    {# AssetMapper (Stimulus seul, Turbo desactive). Cette page est autonome : elle ne
       passe par aucun shell, donc elle porte sa propre ligne. #}
    {{ importmap('app') }}
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel admin-list-card admin-form-card">
                {# ⚠️ The one form page that writes its own band instead of
                   including `_admin_form_head`: it has TWO controls on the right,
                   and an `{% include %}` cannot take a block. Same classes, same
                   rules — if this band and the partial ever disagree, the partial
                   is right. Both buttons carry `.admin-hero-action`, which is
                   what keeps them off the `--theme-input` smudge the dark
                   blankets would otherwise paint them. #}
                <header class="admin-hero">
                    <div class="admin-hero-text">
                        <h1>{{ (mode == 'new' ? 'rfid_form.title_new' : 'rfid_form.title_edit')|trans }}</h1>
                        <p class="admin-hero-note">{{ 'rfid_form.subtitle'|trans }}</p>
                    </div>
                    <div class="header-actions">
                        <button class="admin-hero-action" type="button" data-open-pairing-modal>{{ 'rfid_form.pairing_open'|trans }}</button>
                        <a class="admin-hero-action" href="{{ path('app_admin_rfid_readers') }}">{{ 'rfid_form.back'|trans }}</a>
                    </div>
                </header>
                <div class="admin-edit-panel-header">
                    <h2>{{ mode == 'new' ? 'rfid_form.new_reader'|trans : reader.name }}</h2>
                    <p>{{ 'rfid_form.token_note'|trans }}</p>
                </div>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}<div class="flash {{ label }}">{{ message|flash_text }}</div>{% endfor %}
                {% endfor %}

                <p class="reader-help">{{ 'rfid_form.reader_help'|trans }}</p>

                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.name) }}
                        <div class="form-field">
                            {{ form_label(form.readerToken) }}
                            {{ form_widget(form.readerToken) }}
                            <div class="form-help">{{ form.readerToken.vars.help }}</div>
                            <div class="form-errors">{{ form_errors(form.readerToken) }}</div>
                        </div>
                        {{ form_row(form.machine, {row_attr: {class: 'full'}}) }}
                        <div class="form-field checkbox full">
                            {{ form_widget(form.isActive) }}
                            <div>
                                {{ form_label(form.isActive) }}
                                <div class="form-help">{{ form.isActive.vars.help }}</div>
                            </div>
                            <div class="form-errors">{{ form_errors(form.isActive) }}</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_rfid_readers') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save, {label: (mode == 'new' ? 'rfid_form.create' : 'common.save')|trans}) }}</span>
                    </div>
                {{ form_end(form) }}

                {% set envReaderToken = mode == 'edit' ? reader.readerToken : (reader.readerToken ?: 'reader-printer-01') %}
                {% set envMachineToken = reader.machine ? reader.machine.machineToken : 'printer-01' %}
                <div class="env-header">
                    <div class="env-title">{{ (mode == 'edit' ? 'rfid_form.env_title_edit' : 'rfid_form.env_title_new')|trans }}</div>
                    <button class="btn-secondary" type="button" data-copy-config>{{ 'rfid_form.copy_config'|trans }}</button>
                </div>
                {% if mode == 'new' %}
                    <p class="env-note">{{ 'rfid_form.env_note_new'|trans }}</p>
                {% endif %}
                <p class="env-note">{{ 'rfid_form.env_note_host'|trans }}</p>
                <div class="env-example"><code id="rfid-reader-env-config">FABOS_READER_TOKEN={{ envReaderToken }}
FABOS_MACHINE_TOKEN={{ envMachineToken }}
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
FABOS_DB_HOST=192.168.0.25
FABOS_DB_PORT=3306
FABOS_DB_NAME=fabos
FABOS_DB_USER=fabos
FABOS_DB_PASSWORD=fabos_password</code></div>
                {# The two copy outcomes are catalogue strings, read off the element
                   rather than written into the script: a literal in JS is a string no
                   translator can reach. #}
                <div class="copy-feedback" id="copy-feedback" aria-live="polite"
                     data-copied="{{ 'rfid_form.copy_done'|trans }}"
                     data-copy-failed="{{ 'rfid_form.copy_failed'|trans }}"></div>

                {% if mode == 'edit' %}
                    {#- ⚠️ **S147, J-2 — cette page écrivait sa propre zone de danger.**
                        `_admin_danger_zone` existe et porte déjà la confirmation, le
                        jeton et le libellé variable ; la copie locale n'avait ni l'un
                        ni l'autre et disait « Supprimer » au-dessus d'un bouton qui
                        archive désormais. Une zone, un composant. -#}
                    {% include 'site/_admin_danger_zone.html.twig' with {
                        action: path('app_admin_rfid_reader_delete', {id: reader.id}),
                        token: 'delete_rfid_reader_' ~ reader.id,
                        heading: (reader.archived ? 'adm.restore_record' : 'adm.archive_record')|trans,
                        label: (reader.archived ? 'adm.restore_record' : 'adm.archive_record')|trans,
                        description: (reader.archived ? 'adm.restore_record_notice' : 'adm.archive_record_notice')|trans,
                        confirm: (reader.archived ? 'adm.restore_record_confirm' : 'adm.archive_record_confirm')|trans({'%name%': reader.name}),
                    } only %}
                {% endif %}
            </section>
        </div>
    </main>

    {% include 'site/_rfid_pairing_modal.html.twig' %}

    {% include 'site/_delete_confirm_modal.html.twig' %}

    <script>
        (function () {
            {# The pairing-modal open/close wiring moved into
               `_rfid_pairing_modal.html.twig` with the markup it drives. What is left
               here is this page's own thing: the live .env preview and its copy button. #}
            const configBlock = document.getElementById('rfid-reader-env-config');
            const feedback = document.getElementById('copy-feedback');
            const copyButton = document.querySelector('[data-copy-config]');
            const tokenInput = document.getElementById('{{ form.readerToken.vars.id }}');
            const machineSelect = document.getElementById('{{ form.machine.vars.id }}');

            function selectedMachineToken() {
                if (!machineSelect || !machineSelect.selectedOptions || machineSelect.selectedOptions.length === 0) return 'printer-01';
                return machineSelect.selectedOptions[0].dataset.machineToken || 'printer-01';
            }

            function configText() {
                const readerToken = tokenInput && tokenInput.value.trim() !== '' ? tokenInput.value.trim() : '{{ mode == 'edit' ? reader.readerToken|e('js') : 'reader-printer-01' }}';
                return 'FABOS_READER_TOKEN=' + readerToken + '\n'
                    + 'FABOS_MACHINE_TOKEN=' + selectedMachineToken() + '\n'
                    + 'MQTT_HOST=127.0.0.1\n'
                    + 'MQTT_PORT=1883\n'
                    + 'FABOS_DB_HOST=192.168.0.25\n'
                    + 'FABOS_DB_PORT=3306\n'
                    + 'FABOS_DB_NAME=fabos\n'
                    + 'FABOS_DB_USER=fabos\n'
                    + 'FABOS_DB_PASSWORD=fabos_password';
            }

            function updateConfigBlock() {
                if (configBlock) configBlock.textContent = configText();
            }

            async function copyConfig() {
                const text = configBlock ? configBlock.textContent : configText();
                try {
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        await navigator.clipboard.writeText(text);
                    } else {
                        const area = document.createElement('textarea');
                        area.value = text;
                        area.setAttribute('readonly', 'readonly');
                        area.style.position = 'fixed';
                        area.style.left = '-9999px';
                        document.body.appendChild(area);
                        area.select();
                        document.execCommand('copy');
                        document.body.removeChild(area);
                    }
                    if (feedback) feedback.textContent = feedback.dataset.copied;
                } catch (error) {
                    if (feedback) feedback.textContent = feedback.dataset.copyFailed;
                }
            }

            if (tokenInput) tokenInput.addEventListener('input', updateConfigBlock);
            if (machineSelect) machineSelect.addEventListener('change', updateConfigBlock);
            if (copyButton) copyButton.addEventListener('click', copyConfig);
            updateConfigBlock();
        })();
    </script>
{% endblock %}
