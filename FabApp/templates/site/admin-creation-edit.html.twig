{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_creations.browser_title_edit'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260812-s137-refine' }}">
    <style>

        

        
        
        .admin-actions { display: flex; gap: 8px; align-items: center; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; padding: 9px 12px; border-radius: 6px; border: 1px solid var(--border-color); text-decoration: none; color: var(--color-text); background: var(--theme-surface); font-weight: 700; cursor: pointer; font-size: 14px; }
        .admin-form { padding: 24px; }
        .form-field input, .form-field textarea, .form-field select { width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 15px; background: var(--theme-surface); }
        .form-field.checkbox label { display: flex; align-items: center; gap: 8px; }
        .form-field.checkbox input { width: auto; }
        .form-help { margin-top: 6px; color: var(--color-text-light); font-size: 13px; }
        .form-errors { margin-top: 7px; color: #b91c1c; font-size: 14px; }
        .current-asset { display: flex; gap: 14px; align-items: center; padding: 14px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--theme-surface-elevated); }
        .current-asset img { width: 96px; height: 68px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-color); }
        .form-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--border-color); }
</style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
<main class="admin-page">
    <header class="admin-page-header">
        <div class="admin-page-header-inner">
            <div>
                <h1>{{ 'admin_creations.edit_title'|trans }}</h1>
                <p>{{ 'admin_creations.form_subtitle'|trans }}</p>
            </div>
            <a class="btn-link" href="{{ path('app_admin_creations') }}">{{ 'admin_creations.back'|trans }}</a>
        </div>
    </header>

    <div class="admin-layout">
        {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}
        <section class="admin-panel">
            <div class="admin-panel-header"><h2>{{ creation.title }}</h2></div>
            {% form_theme form 'form/admin_theme.html.twig' %}
            {{ form_start(form, {attr: {class: 'admin-form', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                <div class="form-grid">
                    <div class="form-field full">
                        <div class="current-asset">
                            {% include 'site/_creation_image.html.twig' with {creation: creation, alt: creation.title} only %}
                            <div>
                                <strong>{{ 'admin_form.current_image'|trans }}</strong><br>
                                <span>{{ creation.imageFilename ?: 'admin_creations.no_image_saved'|trans }}</span><br>
                                <span>{{ creation.fileFilename ? 'Fichier : ' ~ creation.fileFilename : 'admin_creations.no_project_file'|trans }}</span>
                            </div>
                        </div>
                    </div>
                    {{ form_row(form.title) }}
                    {{ form_row(form.author) }}
                    {{ form_row(form.authorName) }}
                    {{ form_row(form.externalUrl) }}
                    {{ form_row(form.printDurationMinutes) }}
                    <div class="form-field">{{ form_label(form.imageUpload) }}{{ form_widget(form.imageUpload) }}<div class="form-help">{{ form_help(form.imageUpload) }}</div><div class="form-errors">{{ form_errors(form.imageUpload) }}</div></div>
                    <div class="form-field">{{ form_label(form.fileUpload) }}{{ form_widget(form.fileUpload) }}<div class="form-help">{{ form_help(form.fileUpload) }}</div><div class="form-errors">{{ form_errors(form.fileUpload) }}</div></div>
                    {{ form_row(form.description, {row_attr: {class: 'full'}}) }}
                    {{ form_row(form.isPublished, {row_attr: {class: 'checkbox'}}) }}
                </div>
                <div class="form-actions">
                    <a class="btn-link" href="{{ path('app_admin_creations') }}">{{ 'common.cancel'|trans }}</a>
                    <span class="btn-submit">{{ form_widget(form.save, {label: 'common.save'|trans}) }}</span>
                </div>
            {{ form_end(form) }}
            {% include 'site/_admin_danger_zone.html.twig' with {action: path('app_admin_creation_delete', {id: creation.id}), token: 'delete_creation_' ~ creation.id} only %}
        </section>
    </div>
</main>
{% endblock %}
