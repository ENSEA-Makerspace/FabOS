{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_machine_new.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s134i-contrast' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <style>
        .form-field input, .form-field select, .form-field textarea { width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 15px; background: var(--theme-surface); }
        .form-field textarea { min-height: 110px; resize: vertical; }
        .form-help { color: var(--color-text-light); font-size: 13px; margin-top: 6px; }
        .form-warning { margin: 18px 24px 0; padding: 12px 14px; border-radius: 6px; background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; font-weight: 600; }
        .badge-checkbox-grid { display: grid; grid-template-columns: repeat(2, minmax(220px, 1fr)); gap: 10px; }
        .badge-checkbox { display: flex; gap: 10px; align-items: flex-start; padding: 12px; border: 1px solid var(--border-color); border-radius: 6px; background: var(--theme-surface-elevated); }
        .badge-checkbox input { width: auto; margin-top: 3px; }
        .badge-checkbox-title { display: block; font-weight: 700; color: var(--color-text); }
        .badge-checkbox-meta { display: block; margin-top: 3px; color: var(--color-text-light); font-size: 13px; }
        .empty-state { margin: 0; color: var(--color-text-light); }
        @media (max-width: 900px) {.admin-edit-header { padding: 24px 16px; }}
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>{{ 'admin_machine_new.title'|trans }}</h1>
                    <p>{{ 'admin_machine_new.subtitle'|trans }}</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_machines') }}">{{ 'admin_machine_edit.back'|trans }}</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>{{ 'admin_machine_new.panel_title'|trans }}</h2>
                    <p>{{ 'admin_machine_new.panel_hint'|trans }}</p>
                </div>

                {% if selectedBadgeIds is empty %}
                    <div class="form-warning">{{ 'admin_machine_new.no_badge_warning'|trans }}</div>
                {% endif %}

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {% for field in [form.nom, form.machineToken, form.venue, form.localisation, form.statut, form.granularite, form.limiteReservations, form.categorie, form.niveau, form.icone, form.popularite, form.photo] %}
                            <div class="form-field">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                {% if field.vars.help is defined and field.vars.help %}<div class="form-help">{{ field.vars.help|trans }}</div>{% endif %}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}

                        {% for field in [form.description, form.materiaux, form.caracteristiques, form.prerequis] %}
                            <div class="form-field full">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                {% if field.vars.help is defined and field.vars.help %}<div class="form-help">{{ field.vars.help|trans }}</div>{% endif %}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}

                        <div class="form-field full">
                            <label>{{ 'admin_machine_edit.badges_label'|trans }}</label>
                            {% if availableBadges is empty %}
                                <p class="empty-state">{{ 'admin_machine_edit.badges_empty'|trans }}</p>
                            {% else %}
                                <div class="badge-checkbox-grid">
                                    {% for badge in availableBadges %}
                                        <label class="badge-checkbox">
                                            <input type="checkbox" name="requiredBadges[]" value="{{ badge.id }}" {{ badge.id in selectedBadgeIds ? 'checked' : '' }}>
                                            <span>
                                                <span class="badge-checkbox-title">{{ badge.nom }}</span>
                                                <span class="badge-checkbox-meta">{{ badge.description ?: 'machine.badge_required_desc'|trans }}</span>
                                            </span>
                                        </label>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_machines') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save, {label: 'admin_machine_new.submit'|trans}) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
{% endblock %}
