{% extends 'base.html.twig' %}
{% block title %}{{ 'admin_themes.browser_title'|trans }}{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s130c-venue-tiles' }}">{% endblock %}
{% block body %}
{% embed 'site/_admin_list.html.twig' with {title: 'admin_themes.title'|trans, description: 'admin_themes.description'|trans, panel_title: 'admin_themes.panel_title'|trans, list_route: 'app_admin_themes'} %}
    {% block content %}
        <form method="post" action="{{ path('app_admin_themes') }}" class="theme-editor">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_themes') }}">
            <div class="theme-editor-grid">
                <label>{{ 'admin_themes.org_name'|trans }}<input name="theme[orgName]" maxlength="80" required value="{{ draft.orgName }}"></label>
                <label>{{ 'admin_themes.venue_label'|trans }}<input name="theme[venueLabel]" maxlength="80" required value="{{ draft.venueLabel }}"></label>
                <label>{{ 'admin_themes.primary_color'|trans }}<input name="theme[primaryColor]" maxlength="7" placeholder="#9E1B56" value="{{ draft.primaryColor }}"></label>
                <label>{{ 'admin_themes.logo_path'|trans }}<input name="theme[logoPath]" maxlength="255" placeholder="logo.svg" value="{{ draft.logoPath }}"></label>
            </div>
            {% if preview %}<section class="theme-preview" style="--theme-preview-accent: {{ draft.primaryColor ?: 'var(--color-primary)' }}"><strong>{{ draft.orgName }} · {{ draft.venueLabel }}</strong><span>{{ 'admin_themes.preview_note'|trans }}</span><i></i></section>{% endif %}
            <div class="admin-actions">
                <button class="btn-link" name="action" value="save">{{ 'admin_themes.save'|trans }}</button>
                <button class="btn-link" name="action" value="preview">{{ 'admin_themes.preview'|trans }}</button>
                <button class="btn-link btn-primary-admin" name="action" value="publish">{{ 'admin_themes.publish'|trans }}</button>
                <button class="btn-link" name="action" value="discard">{{ 'admin_themes.discard'|trans }}</button>
                <a class="btn-link" href="{{ path('app_admin_homepage') }}">{{ 'admin_themes.order_blocks'|trans }}</a>
            </div>
        </form>
    {% endblock %}
{% endembed %}
{% endblock %}
