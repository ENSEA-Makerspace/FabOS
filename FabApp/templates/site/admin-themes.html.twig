{% extends 'base.html.twig' %}
{% block title %}{{ 'admin_themes.browser_title'|trans }}{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <style>
        /* La médiathèque d'identité (S165). Une grille de vignettes : ce qu'on
           choisit ici est une IMAGE, et une liste de noms de fichiers ne dit pas
           laquelle. */
        .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; margin: 12px 0 0; }
        .media-card { border: 1px solid var(--border-color); border-radius: var(--border-radius); padding: 10px; display: flex; flex-direction: column; gap: 8px; }
        /* Damier : un logo transparent sur fond blanc a l'air d'un logo blanc, et
           on ne s'en aperçoit qu'une fois le site publié. */
        .media-card__frame { height: 96px; display: flex; align-items: center; justify-content: center; border-radius: 6px;
            background-color: var(--theme-surface-elevated, var(--theme-surface));
            background-image: linear-gradient(45deg, rgba(128,128,128,.18) 25%, transparent 25%, transparent 75%, rgba(128,128,128,.18) 75%),
                              linear-gradient(45deg, rgba(128,128,128,.18) 25%, transparent 25%, transparent 75%, rgba(128,128,128,.18) 75%);
            background-size: 16px 16px; background-position: 0 0, 8px 8px; }
        .media-card__frame img { max-width: 100%; max-height: 92px; display: block; }
        .media-card__name { font-size: 12.5px; word-break: break-word; }
        .media-card__meta { color: var(--color-text-light); font-size: 12px; }
        .media-upload { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 10px; }
        .media-hint { color: var(--color-text-light); font-size: 13px; margin: 0; line-height: 1.55; }
        .contrast-rows { display: flex; flex-direction: column; gap: 6px; margin: 4px 0 14px; }
        .contrast-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 13px; }
        .contrast-need { color: var(--color-text-light); }
        /* L'aperçu sur de vraies surfaces (S167). Les cadres portent une largeur
           FIXE et sont mis à l'échelle : un cadre « mobile » large de 900 px
           rendrait la mise en page desktop et ne prouverait rien. */
        .tp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin: 12px 0 18px; }
        .tp-frame { margin: 0; border: 1px solid var(--border-color); border-radius: var(--border-radius); overflow: hidden; background: var(--theme-surface); }
        .tp-frame figcaption { padding: 8px 12px; font-size: 12.5px; color: var(--color-text-light); border-bottom: 1px solid var(--border-color); }
        .tp-frame iframe { display: block; border: 0; height: 420px; background: #fff; }
        .tp-frame--desktop iframe { width: 1280px; transform: scale(.32); transform-origin: 0 0; height: 1312px; }
        .tp-frame--mobile iframe { width: 390px; transform: scale(.62); transform-origin: 0 0; height: 677px; }
        /* ⚠️ La mise à l'échelle laisse la place d'origine dans le flux : le
           conteneur doit être ramené à la hauteur VUE, sinon chaque cadre traîne
           800 px de blanc derrière lui. */
        .tp-frame--desktop { height: 460px; } .tp-frame--mobile { height: 460px; }
    </style>
{% endblock %}
{% block body %}
{% embed 'site/_admin_list.html.twig' with {panel_title: 'admin_themes.panel_title'|trans, list_route: 'app_admin_themes'} %}
    {% block content %}
        {# ⚠️ **S148, J-22 — au thème.** Les quatre champs étaient enveloppés dans des
           `<label>` nus, et les trois refus de `ThemeManager` s'affichaient en flash
           APRÈS une redirection : une couleur sans dièse effaçait aussi les deux noms
           publics et le logo.

           ⚠️ **« Remplacer le brouillon » sort du formulaire.** C'est une action qui
           ne lit aucun champ ; la laisser dedans la rendrait impossible tant qu'un
           champ est refusé, c'est-à-dire précisément quand on en a besoin. #}
        {{ form_start(form, {action: path('app_admin_themes'), attr: {class: 'theme-editor'}}) }}
            {% form_theme form 'form/admin_theme.html.twig' %}
            <div class="form-grid">
                {{ form_row(form.orgName) }}
                {{ form_row(form.venueLabel) }}
                {{ form_row(form.primaryColor) }}
                {{ form_row(form.logoPath) }}
            </div>
            {# LE CONTRASTE, MESURÉ ET AFFICHÉ (S166).

               🔴 **Une palette qui échoue est REFUSÉE**, pas signalée : un
               avertissement qu'on peut ignorer se fait ignorer. Ce bloc ne sert
               donc pas à prévenir — il sert à montrer la MARGE, pour choisir la
               couleur suivante en connaissance de cause.

               ⚠️ **Deux contrôles et pas trois.** Le contraste WCAG est
               symétrique : « blanc sur la couleur » et « la couleur sur blanc »
               donnent le même nombre. Les afficher tous les deux aurait fait
               croire à une vérification de plus.

               ⚠️ **Le second n'est pas redondant** : du noir pur passe le premier
               à 21:1 et échoue le second à 3,39:1 — sa variante éclaircie devient
               un gris moyen, illisible sur le panneau sombre. #}
            <div class="contrast-rows">
                {% for check in contrast.checks %}
                    <div class="contrast-row">
                        {% include 'site/_cell_state.html.twig' with {
                            label: ('admin_themes.contrast_' ~ check.key)|trans,
                            signal: check.ok ? 'go' : 'stop',
                        } only %}
                        <b>{{ check.ratio|number_format(2, ',', ' ') }}:1</b>
                        <span class="contrast-need">{{ 'admin_themes.contrast_needed'|trans({'%n%': check.needed|number_format(1, ',', ' ')}) }}</span>
                    </div>
                {% endfor %}
            </div>

            {# 🔴 **S167 — l'aperçu rend les VRAIES pages.**

               Ce qui était ici : une bande dessinée à la main, un `<strong>`, un
               `<span>` et un `<i>` teintés de la couleur du brouillon. Elle
               prouvait qu'on savait dessiner une bande. Elle ne disait RIEN de ce
               qu'on veut savoir — si le badigeon `!important` de `style.css`
               repeint l'accent, si un jeton est lu là où on croit, si le logo
               tient dans l'en-tête. C'est la leçon de
               `feedback-fabos-verify-pixels`, appliquée à l'écran qui en a le
               plus besoin.

               ⚠️ **Quatre cadres : deux largeurs × deux thèmes.** Un aperçu qui
               ne montre que le clair en grand laisse passer précisément ce que
               S166 a trouvé — du bordeaux sur un panneau sombre.

               ⚠️ **`?theme=draft` est réservé aux administrateurs**, et vérifié
               par la page APERÇUE, pas par celle-ci : ce sont l'accueil et le
               catalogue qui liraient le brouillon, et aucun des deux n'appartient
               à l'administration. #}
            {% if preview %}
                <div class="tp-grid">
                    {% for frame in preview_frames %}
                        <figure class="tp-frame tp-frame--{{ frame.width }}">
                            <figcaption>{{ frame.label|trans }}</figcaption>
                            {# ⚠️ Pas de `sandbox` : ces pages sont les nôtres, et un
                               bac à sable couperait le script qui pose le thème. #}
                            <iframe src="{{ frame.src }}" title="{{ frame.label|trans }}" loading="lazy"></iframe>
                        </figure>
                    {% endfor %}
                </div>
                <p class="media-hint">{{ 'admin_themes.preview_note'|trans }}</p>
            {% endif %}
            <div class="admin-actions">
                <button class="btn-link" name="action" value="save">{{ 'admin_themes.save'|trans }}</button>
                <button class="btn-link" name="action" value="preview">{{ 'admin_themes.preview'|trans }}</button>
                <button class="btn-link btn-primary-admin" name="action" value="publish">{{ 'admin_themes.publish'|trans }}</button>
            </div>
        {{ form_end(form) }}
        <form method="post" action="{{ path('app_admin_themes') }}" class="admin-actions">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_themes_discard') }}">
            <input type="hidden" name="action" value="discard">
            <button class="btn-link" type="submit">{{ 'admin_themes.discard'|trans }}</button>
            <a class="btn-link" href="{{ path('app_admin_homepage') }}">{{ 'admin_themes.order_blocks'|trans }}</a>
        </form>

        {# LA MÉDIATHÈQUE D'IDENTITÉ (S165).

           🔴 **Avant, changer le logo demandait un accès au serveur.** Le champ
           réclamait le nom d'un fichier qui devait DÉJÀ être dans
           `public/images/` : un réglage qu'on ne pouvait pas régler depuis
           l'écran qui le proposait.

           ⚠️ **Des vignettes, pas une liste de noms.** Ce qu'on choisit est une
           IMAGE ; un nom de fichier ne dit pas laquelle, et le nom sur disque est
           un identifiant tiré au sort.

           ⚠️ **Une image utilisée n'a PAS de bouton Supprimer** — publiée ou en
           brouillon. Un bouton qui existe et refuse est pire qu'un bouton absent,
           et la garde est refaite côté action de toute façon. #}
        <div class="admin-edit-panel-header"><h2>{{ 'admin_themes.media_heading'|trans }}</h2></div>
        <p class="media-hint">{{ 'admin_themes.media_help'|trans }}</p>

        <form method="post" action="{{ path('app_admin_theme_media_upload') }}" enctype="multipart/form-data" class="media-upload">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_theme_media') }}">
            <input type="file" name="image" accept="image/png,image/jpeg,image/webp" required aria-label="{{ 'admin_themes.media_file'|trans }}">
            <button type="submit" class="btn-action">{{ 'common.upload'|trans }}</button>
        </form>

        {% if media is empty %}
            <p class="media-hint">{{ 'admin_themes.media_empty'|trans }}</p>
        {% else %}
            <div class="media-grid">
                {% for item in media %}
                    {% set in_use = item.mediaId in referenced %}
                    <div class="media-card">
                        <div class="media-card__frame"><img src="{{ asset('uploads/identity/' ~ item.filename) }}" alt="{{ item.originalName ?: item.filename }}"></div>
                        <span class="media-card__name">{{ item.originalName ?: item.filename }}</span>
                        <span class="media-card__meta">{{ item.width ?? '?' }}×{{ item.height ?? '?' }}</span>
                        {% if in_use %}
                            {% include 'site/_cell_state.html.twig' with {label: 'admin_themes.media_in_use'|trans, signal: 'go'} only %}
                        {% else %}
                            <form method="post" action="{{ path('app_admin_theme_media_delete', {mediaId: item.mediaId}) }}"
                                  data-controller="confirm"
                                  data-action="submit->confirm#ask"
                                  data-confirm-message-value="{{ 'admin_themes.media_delete_confirm'|trans|e('html_attr') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_theme_media') }}">
                                <button type="submit" class="btn-link btn-danger-admin">{{ 'common.delete'|trans }}</button>
                            </form>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endblock %}
{% endembed %}
{% endblock %}
