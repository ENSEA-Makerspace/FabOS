{% extends 'site/base_public.html.twig' %}

{% from 'site/_admin_inline.html.twig' import admin_actions %}

{% block title %}{{ page.titre }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block page_styles %}
    <style>
        .lab-detail-section { padding: 24px 0 48px; }
        .lab-detail-content { max-width: 780px; margin: 0 auto; line-height: 1.7; white-space: pre-line; }
        /* ⚠️ Jeton d'alerte, pas un littéral : la couverture sombre repeint
           tout `<span>` d'un panneau, et ce bandeau doit rester lisible dans les
           deux thèmes. */
        .lab-unpublished { margin: 0 0 18px; padding: 10px 14px; border-radius: var(--border-radius);
            border: 1px solid var(--color-warn); color: var(--color-text);
            background: color-mix(in srgb, var(--color-warn) 14%, transparent); font-size: 13.5px; }
        .lab-detail-children { margin-top: 32px; }
        .lab-detail-children h2 { font-size: 20px; margin-bottom: 12px; }
        .lab-detail-children ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
        .lab-detail-children a {
            display: inline-block; padding: 8px 16px; border-radius: 999px;
            background: color-mix(in srgb, var(--color-primary) 8%, transparent); color: var(--color-primary-text); text-decoration: none; font-weight: 600;
        }
        .lab-detail-children a:hover { background: color-mix(in srgb, var(--color-primary) 15%, transparent); }
        .lab-gallery { margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
        .lab-gallery img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 10px; border: 1px solid var(--border-color); }
    </style>
{% endblock %}

{% block body %}
    <main id="main-content" tabindex="-1" class="main-content">

    {# 🔴 **Cette page est dépubliée, et seul qui peut la rééditer la voit (S168b).**
       Sans ce bandeau, un opérateur relit une page retirée du site en croyant
       qu'elle est en ligne — et la conclusion qu'il en tire est fausse dans les
       deux sens. Un visiteur, lui, n'arrive jamais ici : il est renvoyé à
       l'accueil avec un message. #}
    {% if unpublishedNotice|default(false) %}
        <p class="lab-unpublished">{{ 'lab.page_unpublished_notice'|trans }}</p>
    {% endif %}
        <section class="lab-detail-section">
            <div class="container">
                {# The parent step is conditional, so it is passed as `null` and the
                   shell drops it — rather than an `{% if %}` around a separator, which
                   is how person-booking ended up rendering "Accueil / / Léa". #}
                {% include 'site/_breadcrumb.html.twig' with {trail: [
                    {label: 'nav.home'|trans, url: path('app_home')},
                    {label: 'nav.lab_pages'|trans, url: path('app_lab_pages')},
                    page.parentPage ? {label: page.parentPage.titre, url: path('app_lab_page', {id: page.parentPage.id})} : null,
                    {label: page.titre},
                ]} only %}

                <h1>{{ page.titre }}{{ admin_actions([
                    { route: 'app_admin_lab_page_edit', params: { id: page.id }, label: 'admin_inline.edit'|trans }
                ]) }}</h1>

                {% if page.contenu %}<div class="lab-detail-content">{{ page.contenu }}</div>{% endif %}

                {% if page.images is not empty %}
                    <div class="lab-gallery">
                        {% for image in page.images %}
                            <img src="{{ asset('uploads/lab-pages/' ~ image.imageFilename) }}" alt="{{ page.titre }}" loading="lazy">
                        {% endfor %}
                    </div>
                {% endif %}

                {% if page.liveChildren is not empty %}
                    <div class="lab-detail-children">
                        <h2>{{ 'lab.sub_pages'|trans }}</h2>
                        <ul>
                            {% for child in page.liveChildren %}
                                <li><a href="{{ path('app_lab_page', {id: child.id}) }}">{{ child.titre }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
        </section>
    </main>
{% endblock %}
