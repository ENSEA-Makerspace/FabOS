{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_institutions.browser_title_list'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s130b-one-nav' }}">
    <style>
        
        @media (max-width: 900px) {.admin-page-header { padding: 24px 16px; }}
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'admin_institutions.list_title'|trans,
    description: 'admin_institutions.list_description'|trans,
    action_label: 'admin_institutions.list_action'|trans,
    action_route: 'app_admin_institution_new',
    panel_title: 'admin_institutions.list_panel'|trans,
    list_tools: true,
    list_client_filter: true,
    list_route: 'app_admin_institutions',
    list_search_placeholder: 'common.search_placeholder'|trans,
} %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: 'adm.col_name'|trans},
                    {label: 'adm.col_link'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: institutions,
                empty: 'adm.institutions_empty'|trans,
            } %}
                {% block rows %}
                    {% for institution in institutions %}
                        <tr data-admin-list-filter-row data-admin-list-filter-row-href="{{ path('app_admin_institution_edit', {id: institution.id}) }}">
                            <td>{{ institution.nom }}</td>
                            <td>{% if institution.url %}<a href="{{ institution.url }}" target="_blank" rel="noopener noreferrer">{{ institution.url }}</a>{% else %}—{% endif %}</td>
                            <td>
                                <a class="admin-action" href="{{ path('app_admin_institution_edit', {id: institution.id}) }}">{% include 'site/_icon.html.twig' with { name: 'edit' } only %} {{ 'common.edit'|trans }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
