{% extends 'base.html.twig' %}

{% block title %}Institutions - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260805-s84-surfaces' }}">
    <style>
        .admin-table { width: 100%; min-width: 640px; border-collapse: collapse; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 8px 11px; border-radius: 6px; border: 1px solid var(--border-color); text-decoration: none; color: var(--color-text); background: var(--theme-surface); font-weight: 700; cursor: pointer; font-size: 13px; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .admin-page-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'Institutions',
    description: 'Organismes qui peuvent reconnaître les badges du FabLab.',
    action_label: 'Ajouter une institution',
    action_route: 'app_admin_institution_new',
    panel_title: 'Toutes les institutions',
} %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                columns: [
                    {label: 'adm.col_name'|trans},
                    {label: 'adm.col_link'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: institutions,
                empty: 'adm.institutions_empty'|trans,
            } %}
                {% block rows %}
                    {% for institution in institutions %}
                        <tr>
                            <td>{{ institution.nom }}</td>
                            <td>{% if institution.url %}<a href="{{ institution.url }}" target="_blank" rel="noopener noreferrer">{{ institution.url }}</a>{% else %}—{% endif %}</td>
                            <td>
                                <div class="admin-actions">
                                    <a class="btn-action" href="{{ path('app_admin_institution_edit', {id: institution.id}) }}">{{ 'common.edit'|trans }}</a>
                                    {% include 'site/_admin_delete_form.html.twig' with {
                                        action: path('app_admin_institution_delete', {id: institution.id}),
                                        token: 'delete_institution_' ~ institution.id,
                                        confirm: 'adm.confirm_delete_institution'|trans,
                                        label: 'common.delete'|trans,
                                    } only %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
