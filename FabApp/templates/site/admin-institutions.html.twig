{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_institutions.browser_title_list'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260816-s143' }}">
    <style>
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'admin_institutions.list_action'|trans,
    action_route: 'app_admin_institution_new',
    panel_title: 'admin_institutions.list_panel'|trans,
    list_client_filter: true,
    panel_note: 'admin_institutions.panel_note'|trans({'%count%': institutions|length}),
    list_count: institutions|length,
    list_route: 'app_admin_institutions',
    list_search_placeholder: 'common.search_placeholder'|trans,
} %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: 'adm.col_name'|trans},
                    {label: 'adm.col_link'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: institutions,
                empty: 'adm.institutions_empty'|trans,
            } %}
                {% block rows %}
                    {% for institution in institutions %}
                        <tr data-admin-list-filter-row data-admin-list-filter-row-href="{{ path('app_admin_institution_edit', {id: institution.id}) }}">
                            <td>{% include 'site/_cell_title.html.twig' with {
                                title: institution.nom,
                                href: path('app_admin_institution_edit', {id: institution.id}),
                            } only %}</td>
                            <td>{% if institution.url %}<a href="{{ institution.url }}" target="_blank" rel="noopener noreferrer">{{ institution.url }}</a>{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}</td>
                            <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                                actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_institution_edit', {id: institution.id})}],
                            } only %}</td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
