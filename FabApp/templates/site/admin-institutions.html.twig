{% extends 'base.html.twig' %}

{% block title %}Institutions - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260731-status' }}">
    <style>
        .admin-table { width: 100%; min-width: 640px; border-collapse: collapse; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 8px 11px; border-radius: 6px; border: 1px solid #d1d5db; text-decoration: none; color: #374151; background: #fff; font-weight: 700; cursor: pointer; font-size: 13px; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .admin-page-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
<main class="admin-page">
    <header class="admin-page-header">
        <div class="admin-page-header-inner">
            <div>
                <h1>Institutions</h1>
                <p>Organismes qui peuvent reconnaître les badges du FabLab.</p>
            </div>
            <a class="btn-link btn-primary-admin" href="{{ path('app_admin_institution_new') }}">Ajouter une institution</a>
        </div>
    </header>

    <div class="admin-layout">
        {% include 'site/_admin_sidebar.html.twig' %}
        <section class="admin-panel">
            <div class="admin-panel-header"><h2>Toutes les institutions</h2></div>
            <div style="padding: 0 24px;">
                {% for message in app.flashes('success') %}<div class="admin-flash success">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="admin-flash error">{{ message }}</div>{% endfor %}
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>Nom</th><th>Lien</th><th>Actions</th></tr></thead>
                    <tbody>
                    {% for institution in institutions %}
                        <tr>
                            <td>{{ institution.nom }}</td>
                            <td>{% if institution.url %}<a href="{{ institution.url }}" target="_blank" rel="noopener noreferrer">{{ institution.url }}</a>{% else %}—{% endif %}</td>
                            <td>
                                <div class="admin-actions">
                                    <a class="btn-action" href="{{ path('app_admin_institution_edit', {id: institution.id}) }}">Modifier</a>
                                    <form method="post" action="{{ path('app_admin_institution_delete', {id: institution.id}) }}" onsubmit="return confirm('Supprimer cette institution ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_institution_' ~ institution.id) }}">
                                        <button class="btn-action btn-danger-admin" type="submit">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3">Aucune institution enregistrée.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
{% endblock %}
