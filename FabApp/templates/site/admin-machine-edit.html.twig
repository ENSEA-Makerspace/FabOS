<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier {{ machine.nom }} - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260802-s78-nav' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260802-s78-table' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        .admin-edit-panel-header { padding: 20px 24px; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; gap: 16px; align-items: start; flex-wrap: wrap; }
        .form-field input, .form-field select, .form-field textarea { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 15px; background: #fff; }
        .form-field textarea { min-height: 110px; resize: vertical; }
        .form-help { color: #6b7280; font-size: 13px; margin-top: 6px; }
        .readonly-grid { display: grid; grid-template-columns: repeat(3, minmax(160px, 1fr)); gap: 12px; padding: 16px 24px 0; }
        .readonly-item { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; }
        .readonly-label { display: block; color: #6b7280; font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 5px; }
        .readonly-value { color: #111827; overflow-wrap: anywhere; }
        .badge-checkbox-grid { display: grid; grid-template-columns: repeat(2, minmax(220px, 1fr)); gap: 10px; }
        .badge-checkbox { display: flex; gap: 10px; align-items: flex-start; padding: 12px; border: 1px solid #e5e7eb; border-radius: 6px; background: #f9fafb; }
        .badge-checkbox input { width: auto; margin-top: 3px; }
        .badge-checkbox-title { display: block; font-weight: 700; color: #111827; }
        .badge-checkbox-meta { display: block; margin-top: 3px; color: #6b7280; font-size: 13px; }
        .empty-state { margin: 0; color: #6b7280; }
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid, .readonly-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Modifier une machine</h1>
                    <p>{{ machine.nom }} · token non modifiable : {{ machine.machineToken }}</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_machines') }}">Retour aux machines</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <div>
                        <h2>Champs modifiables</h2>
                        <p>ID, token, création et dernière autorisation restent verrouillés.</p>
                    </div>
                    <a class="btn-link" href="{{ path('app_machine_detail', {id: machine.id}) }}">Voir la fiche publique</a>
                </div>

                <div class="readonly-grid">
                    <div class="readonly-item"><span class="readonly-label">ID</span><span class="readonly-value">#{{ machine.id }}</span></div>
                    <div class="readonly-item"><span class="readonly-label">Token</span><span class="readonly-value">{{ machine.machineToken }}</span></div>
                    <div class="readonly-item"><span class="readonly-label">Créée le</span><span class="readonly-value">{{ machine.createdAt|lab_date('d/m/Y H:i:s') }}</span></div>
                </div>

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {% for field in [form.nom, form.localisation, form.statut, form.granularite, form.limiteReservations, form.categorie, form.niveau, form.icone, form.popularite, form.photo] %}
                            <div class="form-field">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                {% if field.vars.help is defined and field.vars.help %}<div class="form-help">{{ field.vars.help }}</div>{% endif %}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}

                        {% for field in [form.description, form.materiaux, form.caracteristiques, form.prerequis] %}
                            <div class="form-field full">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                {% if field.vars.help is defined and field.vars.help %}<div class="form-help">{{ field.vars.help }}</div>{% endif %}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}

                    <div class="form-field full">
                        <label>Badges requis pour cette machine</label>
                        {% if availableBadges is empty %}
                            <p class="empty-state">Aucun badge disponible.</p>
                        {% else %}
                            <div class="badge-checkbox-grid">
                                {% for badge in availableBadges %}
                                    <label class="badge-checkbox">
                                        <input type="checkbox" name="requiredBadges[]" value="{{ badge.id }}" {{ badge.id in selectedBadgeIds ? 'checked' : '' }}>
                                        <span>
                                            <span class="badge-checkbox-title">{{ badge.nom }}</span>
                                            <span class="badge-checkbox-meta">{{ badge.description ?: 'Badge nécessaire pour utiliser cette machine' }}</span>
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_machines') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
</body>
</html>
