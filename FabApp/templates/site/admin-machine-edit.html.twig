{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_machine_edit.browser_title'|trans({'%machine%': machine.nom}) }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260816-s142' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260816-s139e' }}">
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>{{ 'admin_machine_edit.title'|trans }}</h1>
                    <p>{{ 'admin_machine_edit.subtitle'|trans({'%machine%': machine.nom, '%token%': machine.machineToken}) }}</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_machines') }}">{{ 'admin_machine_edit.back'|trans }}</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <div>
                        <h2>{{ 'admin_machine_edit.fields_heading'|trans }}</h2>
                        <p>{{ 'admin_machine_edit.fields_hint'|trans }}</p>
                    </div>
                    <a class="btn-link" href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ 'admin_machine_edit.view_public'|trans }}</a>
                </div>

                {% include 'site/_admin_meta_grid.html.twig' with {items: [
                    {label: 'ID', value: '#' ~ machine.id},
                    {label: 'admin_machine_edit.meta_token'|trans, value: machine.machineToken},
                    {label: 'admin_machine_edit.meta_created'|trans, value: machine.createdAt|lab_date('d/m/Y H:i:s')},
                ]} only %}

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {% for field in [form.nom, form.venue, form.localisation, form.statut, form.granularite, form.limiteReservations, form.categorie, form.niveau, form.icone, form.popularite, form.photo] %}
                            <div class="form-field">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                {% if field.vars.help is defined and field.vars.help %}<div class="form-help">{{ field.vars.help|trans }}</div>{% endif %}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}

                        {% for field in [form.description, form.materiaux, form.caracteristiques, form.prerequis] %}
                            <div class="form-field full">
                                {{ form_label(field) }}
                                {{ form_widget(field) }}
                                {% if field.vars.help is defined and field.vars.help %}<div class="form-help">{{ field.vars.help|trans }}</div>{% endif %}
                                <div class="form-errors">{{ form_errors(field) }}</div>
                            </div>
                        {% endfor %}

                    <div class="form-field full">
                        <label>{{ 'admin_machine_edit.badges_label'|trans }}</label>
                        {% if availableBadges is empty %}
                            <p class="empty-state">{{ 'admin_machine_edit.badges_empty'|trans }}</p>
                        {% else %}
                            <div class="badge-checkbox-grid">
                                {% for badge in availableBadges %}
                                    <label class="badge-checkbox">
                                        <input type="checkbox" name="requiredBadges[]" value="{{ badge.id }}" {{ badge.id in selectedBadgeIds ? 'checked' : '' }}>
                                        <span>
                                            <span class="badge-checkbox-title">{{ badge.nom }}</span>
                                            <span class="badge-checkbox-meta">{{ badge.description ?: 'machine.badge_required_desc'|trans }}</span>
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_machines') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
{% endblock %}
