{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_machine_edit.browser_title'|trans({'%machine%': machine.nom}) }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260901-s158' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260901-s158' }}">
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel admin-list-card admin-form-card">
                {% include 'site/_admin_form_head.html.twig' with {
                    title: 'admin_machine_edit.title'|trans,
                    subtitle: 'admin_machine_edit.subtitle'|trans({'%machine%': machine.nom, '%token%': machine.machineToken}),
                    back_href: path('app_admin_machines'),
                    back_label: 'admin_machine_edit.back'|trans,
                } only %}

                <div class="admin-edit-panel-header">
                    <div>
                        <h2>{{ 'admin_machine_edit.fields_heading'|trans }}</h2>
                        <p>{{ 'admin_machine_edit.fields_hint'|trans }}</p>
                    </div>
                    <a class="btn-link" href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ 'admin_machine_edit.view_public'|trans }}</a>
                </div>

                {% include 'site/_admin_meta_grid.html.twig' with {items: [
                    {label: 'ID', value: '#' ~ machine.id},
                    {label: 'admin_machine_edit.meta_token'|trans, value: machine.machineToken},
                    {label: 'admin_machine_edit.meta_created'|trans, value: machine.createdAt|lab_date('d/m/Y H:i:s')},
                ]} only %}

                {% include 'site/_machine_form.html.twig' with {
                    form: form,
                    categoryChoices: categoryChoices|default([]),
                    availableBadges: availableBadges,
                    selectedBadgeIds: selectedBadgeIds,
                } only %}
                {% include 'site/_machine_documents_admin.html.twig' with {
                    machine: machine,
                    documents: machineDocuments|default([]),
                } only %}

                <form method="post" action="{{ path('app_admin_machine_archive', {id: machine.id}) }}" class="admin-archive-action">
                    <input type="hidden" name="_token" value="{{ csrf_token('archive_machine_' ~ machine.id) }}">
                    {% if machine.archived %}<input type="hidden" name="restore" value="1">{% endif %}
                    <button class="btn-link {{ machine.archived ? '' : 'btn-danger-admin' }}" type="submit">{{ (machine.archived ? 'admin_machine_form.restore' : 'admin_machine_form.archive')|trans }}</button>
                    <p>{{ 'admin_machine_form.archive_note'|trans }}</p>
                </form>

            </section>
        </div>
    </main>
{% endblock %}
