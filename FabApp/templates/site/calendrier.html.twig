{% extends 'site/base_public.html.twig' %}

{#
   The aggregated calendar.

   ⚠️ **It owns no calendar code of its own any more (S146a).** The grid, the week
   and month views, the opening-hours rules and the booking dialog all come from
   `site/_calendar.html.twig` + `site/_calendar_booking.html.twig`, driven by the
   `calendar` Stimulus controller and the payload `App\Calendar\CalendarPayload`
   builds. This file decides the WORDS and which resources are on the page — the
   same split as the catalogues.

   🔴 **Why that mattered enough to do first.** This template and
   `machine-calendrier.html.twig` used to carry twelve identically-named JavaScript
   functions each. S134d and S134e had to edit the same opening-hours rule in both,
   four times, in one session — and the calendar disagreeing with the booking gate
   about when the lab is open is the exact fault the schedule model was rebuilt to
   prevent.

   ⚠️ **The location tiles are new here (S146a).** Every catalogue got a location
   filter in S137/S138; the calendar never had one, though "which location is this"
   is most of the reason locations exist. Choosing one re-renders the page, because
   the opening hours, the exceptions and the bookable resources all change with it.
#}

{% block title %}{{ 'nav.calendar'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=20260709-calheader-userlogo' }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-fix.css') }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-modern.css') ~ '?v=20260820-s146a' }}">
    {# The location tiles are the catalogues' `ml-*` filter row, not a shape of
       their own — same markup, same sheet, so a change to the filter row reaches
       the calendar too. #}
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=20260820-s146a' }}">
{% endblock %}

{% block body %}

    <main class="main-content calendar-modern-page">
        <section class="container calendar-shell"
                 data-controller="calendar"
                 data-calendar-payload-value="{{ calendar|json_encode }}">
            <div class="calendar-hero">
                <div>
                    <span class="calendar-eyebrow">{{ 'cal.planning'|trans }}</span>
                    <h1>{{ 'cal.book_machine'|trans }}</h1>
                    <p>{{ 'cal.subtitle'|trans }}</p>
                </div>
                <div class="calendar-actions">
                    {% if app.user %}
                        <a class="btn btn-secondary" href="{{ path('app_my_reservations') }}">{{ 'resv.title'|trans }}</a>
                    {% else %}
                        <a class="btn btn-secondary" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
                    {% endif %}
                    {% if feature_enabled('machines') %}<a class="btn btn-primary" href="{{ path('app_machines') }}">{{ 'resv.see_machines'|trans }}</a>{% endif %}
                </div>
            </div>

            <div class="calendar-stats" aria-label="{{ 'cal.summary'|trans }}">
                <article class="calendar-stat-card"><span>{{ 'cal.today_hours'|trans }}</span><strong data-calendar-target="todayHours">{{ 'cal.loading'|trans }}</strong></article>
                <article class="calendar-stat-card"><span>{{ 'cal.reservations_today'|trans }}</span><strong data-calendar-target="todayCount">0</strong></article>
                <article class="calendar-stat-card"><span>{{ 'cal.machines_shown'|trans }}</span><strong data-calendar-target="visibleCount">{{ resources|length }}</strong></article>
                <article class="calendar-stat-card"><span>{{ 'cal.next_slot'|trans }}</span><strong data-calendar-target="nextSlot">{{ 'cal.select'|trans }}</strong></article>
            </div>

            <div class="calendar-workspace">
                <aside class="machine-filter-panel" aria-label="{{ 'cal.machines_filter'|trans }}">
                    <div class="panel-title-row">
                        <h2>{{ 'home.stat_machines'|trans }}</h2>
                        <button class="btn btn-secondary btn-sm" type="button" data-action="calendar#resetResources">{{ 'cal.show_all'|trans }}</button>
                    </div>
                    <div class="machine-search-grid">
                        <label for="machine-search">{{ 'common.search'|trans }}</label>
                        <input id="machine-search" class="calendar-input" type="search"
                               placeholder="{{ 'cal.search_ph2'|trans }}"
                               data-calendar-target="resourceSearch"
                               data-action="input->calendar#filterResources">
                        <label for="machine-status-filter">{{ 'home.col_status'|trans }}</label>
                        <select id="machine-status-filter" class="calendar-select"
                                data-calendar-target="resourceStatus"
                                data-action="change->calendar#filterResources">
                            <option value="all">{{ 'machines.all_statuses'|trans }}</option>
                            {% set statuses = [] %}
                            {% for resource in resources %}
                                {% if resource.status not in statuses %}
                                    {% set statuses = statuses|merge([resource.status]) %}
                                    <option value="{{ resource.status|lower }}">{{ resource.status }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                    <div class="machine-list-modern">
                        {# Machines and spaces share one filter list; the checkbox
                           value is the composite kind:id key, since ids collide
                           across the two kinds. #}
                        {% for resource in resources %}
                            <label class="machine-option-card"
                                   data-calendar-target="resourceCard"
                                   data-name="{{ resource.name|lower }}" data-status="{{ resource.status|lower }}" data-category="{{ resource.category|lower }}">
                                <input type="checkbox" class="machine-toggle" value="{{ resource.key }}" checked
                                       data-calendar-target="resourceToggle"
                                       data-action="change->calendar#toggleResource">
                                <span class="machine-card-main">
                                    <span class="machine-card-title">{{ resource.name }}</span>
                                    <span class="machine-card-meta">
                                        <span class="status-pill {{ resource.statusKey }}">{{ resource.status }}</span>
                                        <span class="calendar-pill">{{ resource.category }}</span>
                                    </span>
                                </span>
                            </label>
                        {% else %}
                            <p>{{ 'cal.no_machines'|trans }}</p>
                        {% endfor %}
                    </div>
                </aside>

                {# ⚠️ The board's words are view-neutral. "Semaine de réservation",
                   and a subtitle about stacking bookings inside one hour, described
                   the week grid and read as a lie the moment the month was shown in
                   the same box. #}
                {% include 'site/_calendar.html.twig' with {
                    heading: 'cal.board_title'|trans,
                    subtitle: 'cal.board_desc'|trans,
                    venue_context: venueContext,
                    venue_route: 'app_calendar',
                    venue_query: app.request.query.all,
                } only %}
            </div>

            {% include 'site/_calendar_booking.html.twig' with {
                title: 'cal.book_this'|trans,
                hint: 'cal.pick_free'|trans,
                resources: resources,
                resources_by_kind: resourcesByKind,
                booking_access: bookingAccess,
                signed_in: app.user is not null,
            } only %}
        </section>

    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
{% endblock %}
