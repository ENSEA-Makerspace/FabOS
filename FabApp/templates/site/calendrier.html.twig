<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calendrier - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-calheader-userlogo' }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=20260709-calheader-userlogo' }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-fix.css') }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-modern.css') ~ '?v=20260709-calheader-userlogo' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body class="header-calendar-page {{ is_granted('ROLE_ADMIN') ? 'header-calendar-compact' : '' }}">
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    {% include 'site/_logo.html.twig' %}
                </div>
            </a>
            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">Accueil</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link active">Calendrier</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">Machines</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">Formations</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">Leaderboard</a>
                    {% if is_granted('ROLE_USER') %}<a href="{{ path('app_my_reservations') }}" class="navbar-link">Mes réservations</a>{% endif %}
                    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_admin_dashboard') }}" class="navbar-link">Admin</a>{% endif %}
                </div>
            </nav>
            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header" aria-label="Rechercher">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    </button>
                </div>
                <div class="header-auth">{% include 'site/_header_auth.html.twig' %}</div>
                <button class="mobile-nav-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
            </div>
        </div>
    </header>

    <main class="main-content calendar-modern-page">
        <section class="container calendar-shell">
            <div class="calendar-hero">
                <div>
                    <span class="calendar-eyebrow">Planning FabLab</span>
                    <h1>Réserver une machine</h1>
                    <p>Visualisez les ouvertures, les créneaux déjà pris et vos réservations, puis réservez directement depuis la semaine.</p>
                </div>
                <div class="calendar-actions">
                    {% if app.user %}
                        <a class="btn btn-secondary" href="{{ path('app_my_reservations') }}">Mes réservations</a>
                    {% else %}
                        <a class="btn btn-secondary" href="{{ path('app_login') }}">Connexion</a>
                    {% endif %}
                    <a class="btn btn-primary" href="{{ path('app_machines') }}">Voir les machines</a>
                </div>
            </div>

            <div class="calendar-stats" aria-label="Synthèse calendrier">
                <article class="calendar-stat-card"><span>Horaires du jour</span><strong id="today-opening-hours">Chargement</strong></article>
                <article class="calendar-stat-card"><span>Réservations aujourd'hui</span><strong id="today-reservation-count">0</strong></article>
                <article class="calendar-stat-card"><span>Machines affichées</span><strong id="visible-machine-count">{{ machines|length }}</strong></article>
                <article class="calendar-stat-card"><span>Prochain créneau</span><strong id="next-open-slot">Sélectionnez</strong></article>
            </div>

            <div class="calendar-workspace">
                <aside class="machine-filter-panel" aria-label="Filtres machines">
                    <div class="panel-title-row">
                        <h2>Machines</h2>
                        <button class="btn btn-secondary btn-sm" type="button" id="reset-machine-filters">Tout afficher</button>
                    </div>
                    <div class="machine-search-grid">
                        <label for="machine-search">Rechercher</label>
                        <input id="machine-search" class="calendar-input" type="search" placeholder="Nom, catégorie, statut">
                        <label for="machine-status-filter">Statut</label>
                        <select id="machine-status-filter" class="calendar-select">
                            <option value="all">Tous les statuts</option>
                            {% set statuses = [] %}
                            {% for machine in machines %}
                                {% if machine.statut not in statuses %}
                                    {% set statuses = statuses|merge([machine.statut]) %}
                                    <option value="{{ machine.statut|lower }}">{{ machine.statut }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                    <div class="machine-list-modern" id="machine-list-modern">
                        {% for machine in machines %}
                            <label class="machine-option-card" data-name="{{ machine.nom|lower }}" data-status="{{ machine.statut|lower }}" data-category="{{ machine.categoryLabel|lower }}">
                                <input type="checkbox" class="machine-toggle" value="{{ machine.id }}" checked>
                                <span class="machine-card-main">
                                    <span class="machine-card-title">{{ machine.nom }}</span>
                                    <span class="machine-card-meta">
                                        <span class="status-pill {{ machine.statut|lower|replace({' ': '-'}) }}">{{ machine.statut }}</span>
                                        <span class="calendar-pill">{{ machine.categoryLabel }}</span>
                                    </span>
                                </span>
                            </label>
                        {% else %}
                            <p>Aucune machine enregistrée.</p>
                        {% endfor %}
                    </div>
                </aside>

                <section class="calendar-board">
                    <div class="calendar-board-header">
                        <div>
                            <h2>Semaine de réservation</h2>
                            <p class="calendar-board-subtitle">Les réservations se superposant dans une même heure sont empilées et la cellule s’agrandit.</p>
                        </div>
                        <div class="calendar-nav-bar">
                            <button class="btn btn-secondary" type="button" id="prev-week">Semaine précédente</button>
                            <div class="week-chip" id="current-week-display">Semaine</div>
                            <button class="btn btn-secondary" type="button" id="today-week">Aujourd'hui</button>
                            <button class="btn btn-secondary" type="button" id="next-week">Semaine suivante</button>
                        </div>
                    </div>

                    <div class="week-hours-strip" id="calendar-week-hours" aria-label="Horaires d'ouverture de la semaine"></div>

                    <div class="calendar-scroll-area" aria-label="Calendrier hebdomadaire">
                        <div class="agenda-grid" id="agenda-grid"></div>
                    </div>

                    <div class="calendar-legend-modern" aria-label="Légende">
                        <span class="legend-dot free">Disponible</span>
                        <span class="legend-dot reserved">Réservé</span>
                        <span class="legend-dot mine">Ma réservation</span>
                        <span class="legend-dot closed">Fermé</span>
                        <span class="legend-dot out">Hors horaires</span>
                        <span class="legend-dot cancelled">Annulé (historique)</span>
                    </div>
                </section>
            </div>
        </section>
    </main>

    <div class="booking-panel-backdrop" id="booking-backdrop"></div>
    <section class="booking-panel" id="booking-panel" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="booking-title">
        <div class="booking-panel-header">
            <div>
                <h2 id="booking-title">Réserver ce créneau</h2>
                <p id="booking-context">Choisissez un créneau libre.</p>
            </div>
            <button class="booking-panel-close" type="button" id="booking-close" aria-label="Fermer">×</button>
        </div>
        {% if app.user %}
            <form id="booking-form" class="booking-form">
                <input id="booking-start" name="dateDebut" type="hidden" required>
                <input id="booking-end" name="dateFin" type="hidden" required>
                <div class="booking-summary-grid">
                    <div class="booking-summary-card">
                        <span>Date sélectionnée</span>
                        <strong id="booking-date-label">-</strong>
                    </div>
                    <div class="booking-summary-card">
                        <span>Créneau</span>
                        <strong id="booking-time-label">-</strong>
                    </div>
                </div>
                <div>
                    <label for="booking-machine">Machine</label>
                    <select id="booking-machine" name="machineId" required>
                        {% for machine in machines %}
                            {% set access = bookingAccessByMachine[machine.id]|default(null) %}
                            {% set disabledForTraining = app.user and not is_granted('ROLE_ADMIN') and access and not access.canReserve %}
                            <option value="{{ machine.id }}"{% if disabledForTraining %} disabled data-lock-reason="{{ access.reason|default('training_required') }}"{% endif %}>{{ machine.nom }}{% if disabledForTraining and access.reasonLabel %} — {{ access.reasonLabel }}{% endif %}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="booking-time-picker" aria-label="Choix des horaires">
                    <div>
                        <label for="booking-start-time">Heure début</label>
                        <select id="booking-start-time" class="time-picker-select"></select>
                    </div>
                    <div>
                        <label for="booking-end-time">Heure fin</label>
                        <select id="booking-end-time" class="time-picker-select"></select>
                    </div>
                </div>
                <div class="duration-shortcuts" aria-label="Durées rapides">
                    <button type="button" class="duration-chip" data-duration="30">30 min</button>
                    <button type="button" class="duration-chip is-active" data-duration="60">1 h</button>
                    <button type="button" class="duration-chip" data-duration="120">2 h</button>
                </div>
                <div>
                    <label for="booking-motif">Motif optionnel</label>
                    <textarea id="booking-motif" name="motif" maxlength="500" placeholder="Ex : prototype, découpe, maintenance projet..."></textarea>
                </div>
                <div class="booking-form-actions">
                    <button type="submit" class="btn btn-primary" id="booking-submit">Réserver</button>
                    <button type="button" class="btn btn-secondary" id="booking-cancel">Annuler</button>
                </div>
                <div class="booking-message" id="booking-message" aria-live="polite"></div>
            </form>
        {% else %}
            <div class="login-callout">
                <p>Connectez-vous pour créer une réservation. Vous pouvez consulter les disponibilités librement.</p>
                <a class="btn btn-primary" href="{{ path('app_login') }}">Se connecter</a>
            </div>
        {% endif %}
    </section>

    {% include 'site/_footer.html.twig' %}
    <script src="{{ asset('js/main.js') ~ '?v=20260709-calheader-userlogo' }}"></script>
    <script>
        const CALENDAR_CONFIG = { startHour: {{ calendarStartHour }}, endHour: {{ calendarEndHour }}, slotMinutes: 60 };
        const MACHINES = [
{% for machine in machines %}
            { id: {{ machine.id }}, name: {{ machine.nom|json_encode|raw }}, status: {{ machine.statut|json_encode|raw }}, statusKey: {{ machine.statut|lower|replace({' ': '-'})|json_encode|raw }}, category: {{ machine.categoryLabel|json_encode|raw }} }{{ not loop.last ? ',' : '' }}
{% endfor %}
        ];
        const RESERVATIONS = [
{% for reservation in reservations %}
            { id: {{ reservation.id }}, machine_id: {{ reservation.machine ? reservation.machine.id : 'null' }}, machine: {{ reservation.machine ? reservation.machine.nom|json_encode|raw : 'Machine inconnue'|json_encode|raw }}, date: {{ reservation.dateDebut|date('Y-m-d')|json_encode|raw }}, day: {{ reservation.dateDebut|date('N') - 1 }}, start: {{ reservation.dateDebut|date('H:i')|json_encode|raw }}, end: {{ reservation.dateFin|date('H:i')|json_encode|raw }}, user: {{ reservation.utilisateur ? reservation.utilisateur.displayName|json_encode|raw : 'Utilisateur'|json_encode|raw }}, user_id: {{ reservation.utilisateur ? reservation.utilisateur.id : 'null' }}, motif: {{ reservation.motif ? reservation.motif|json_encode|raw : 'null' }}, statut: {{ reservation.statut|json_encode|raw }} }{{ not loop.last ? ',' : '' }}
{% endfor %}
        ];
        const OPENING_HOURS = {{ openingHoursJson|json_encode|raw }};
        const FABLAB_HOURS = OPENING_HOURS.reduce((hours, row) => { hours[row.dayIndex] = row.isClosed ? null : [timeToMinutes(row.openTime), timeToMinutes(row.closeTime)]; return hours; }, {});
        const USER_ID = {{ app.user ? app.user.id : 'null' }};
        const IS_AUTHENTICATED = {{ app.user ? 'true' : 'false' }};
        const IS_ADMIN = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};
        const BOOKING_ACCESS = {{ bookingAccessByMachine|json_encode|raw }};
        const TIME_STEP_MINUTES = 15;
        let currentDate = new Date();
        let selectedMachineIds = new Set(MACHINES.map(machine => String(machine.id)));
        let bookingDraft = null;

        document.addEventListener('DOMContentLoaded', () => {
            bindCalendarControls();
            renderCalendar();
        });

        function bindCalendarControls() {
            document.getElementById('prev-week')?.addEventListener('click', () => { currentDate.setDate(currentDate.getDate() - 7); renderCalendar(); });
            document.getElementById('next-week')?.addEventListener('click', () => { currentDate.setDate(currentDate.getDate() + 7); renderCalendar(); });
            document.getElementById('today-week')?.addEventListener('click', () => { currentDate = new Date(); renderCalendar(); });
            document.getElementById('machine-search')?.addEventListener('input', filterMachineCards);
            document.getElementById('machine-status-filter')?.addEventListener('change', filterMachineCards);
            document.getElementById('reset-machine-filters')?.addEventListener('click', () => {
                document.getElementById('machine-search').value = '';
                document.getElementById('machine-status-filter').value = 'all';
                document.querySelectorAll('.machine-toggle').forEach(input => { input.checked = true; selectedMachineIds.add(input.value); });
                filterMachineCards();
                renderCalendar();
            });
            document.querySelectorAll('.machine-toggle').forEach(input => input.addEventListener('change', () => {
                input.checked ? selectedMachineIds.add(input.value) : selectedMachineIds.delete(input.value);
                renderCalendar();
            }));
            document.getElementById('booking-backdrop')?.addEventListener('click', closeBookingPanel);
            document.getElementById('booking-close')?.addEventListener('click', closeBookingPanel);
            document.getElementById('booking-cancel')?.addEventListener('click', closeBookingPanel);
            document.getElementById('booking-form')?.addEventListener('submit', submitBookingForm);
            document.getElementById('booking-machine')?.addEventListener('change', validateBookingDraft);
            document.getElementById('booking-start-time')?.addEventListener('change', () => { updateBookingDraftFromControls('start'); });
            document.getElementById('booking-end-time')?.addEventListener('change', () => { updateBookingDraftFromControls('end'); });
            document.querySelectorAll('.duration-chip').forEach(button => button.addEventListener('click', () => applyDurationShortcut(parseInt(button.dataset.duration, 10))));
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape' && document.getElementById('booking-panel')?.classList.contains('is-open')) closeBookingPanel();
            });
        }

        function renderCalendar() {
            renderHeader();
            renderStats();
            renderWeekHours();
            renderAgenda();
        }

        function renderHeader() {
            const start = getWeekStartDate(currentDate);
            const end = new Date(start); end.setDate(end.getDate() + 6);
            document.getElementById('current-week-display').textContent = `Semaine ${getWeekNumber(currentDate)} · ${start.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })} - ${end.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}`;
        }

        function renderStats() {
            const today = new Date();
            const todayIndex = today.getDay() === 0 ? 6 : today.getDay() - 1;
            const todayKey = formatDateKey(today);
            const visibleReservations = getVisibleReservations();
            document.getElementById('today-opening-hours').textContent = getOpeningHoursLabel(todayIndex);
            document.getElementById('today-reservation-count').textContent = visibleReservations.filter(res => res.date === todayKey).length;
            document.getElementById('visible-machine-count').textContent = getVisibleMachines().length;
            document.getElementById('next-open-slot').textContent = findNextOpenSlotLabel();
        }

        function renderWeekHours() {
            const days = getWeekDays();
            document.getElementById('calendar-week-hours').innerHTML = days.map((day, index) => {
                const closed = FABLAB_HOURS[index] === null;
                return `<span class="week-hour-chip${closed ? ' closed' : ''}"><strong>${day.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric' })}</strong><br>${getOpeningHoursLabel(index)}</span>`;
            }).join('');
        }

        function renderAgenda() {
            const grid = document.getElementById('agenda-grid');
            const days = getWeekDays();
            const hours = getTimeSlots();
            const reservations = getVisibleReservations();
            let html = '<div class="agenda-header"><div class="agenda-time-head">Heure</div>';
            html += days.map(day => `<div class="agenda-day-head${isSameDay(day, new Date()) ? ' today' : ''}"><span>${day.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric' })}</span><small>${getOpeningHoursLabel(day.getDay() === 0 ? 6 : day.getDay() - 1)}</small></div>`).join('');
            html += '</div>';

            hours.forEach(hour => {
                html += `<div class="agenda-row"><div class="agenda-time-cell">${hour}:00</div>`;
                days.forEach((day, dayIndex) => {
                    const dateKey = formatDateKey(day);
                    const slotStart = parseInt(hour, 10) * 60;
                    const slotReservations = reservations.filter(res => res.date === dateKey && overlapsHour(res, slotStart));
                    const slotState = getSlotState(dayIndex, slotStart);
                    const visibleMachines = getVisibleMachines();
                    const hasBookableMachine = !IS_AUTHENTICATED || visibleMachines.some(machine => canReserveMachine(machine.id));
                    const lockedByTraining = IS_AUTHENTICATED && !hasBookableMachine;
                    const canBook = !slotState.closed && !lockedByTraining;
                    const lockLabel = getVisibleLockLabel(visibleMachines);
                    const cellClassName = `${slotState.className}${lockedByTraining ? ' is-training-locked' : ''}`;
                    const cellTitle = lockedByTraining ? lockLabel : 'Cliquer pour réserver';
                    html += `<div class="agenda-slot-cell ${cellClassName}" data-day="${dayIndex}" data-hour="${hour}"${canBook ? ` role="button" tabindex="0" title="${escapeHtml(cellTitle)}" aria-label="${escapeHtml(cellTitle)}"` : ''}>`;
                    if (slotState.closed) {
                        html += `<span class="slot-state-label">${slotState.label}</span>`;
                    } else {
                        const shown = slotReservations.slice(0, 3);
                        shown.forEach(res => { html += reservationCardHtml(res); });
                        if (slotReservations.length > shown.length) html += `<button type="button" class="slot-more-button" data-more="${escapeHtml(JSON.stringify(slotReservations.map(r => r.id)))}">+${slotReservations.length - shown.length} autres</button>`;
                        html += lockedByTraining
                            ? `<span class="slot-state-label training-lock-label">${escapeHtml(lockLabel)}</span>`
                            : '<span class="slot-book-affordance" aria-hidden="true">+</span>';
                    }
                    html += '</div>';
                });
                html += '</div>';
            });
            grid.innerHTML = html;
            grid.querySelectorAll('.agenda-slot-cell.is-open[role="button"]').forEach(cell => {
                const open = () => openBookingPanel(parseInt(cell.dataset.day, 10), cell.dataset.hour);
                cell.addEventListener('click', event => {
                    if (event.target.closest('.slot-reservation-card, .slot-more-button')) return;
                    open();
                });
                cell.addEventListener('keydown', event => {
                    if (event.key !== 'Enter' && event.key !== ' ') return;
                    event.preventDefault();
                    open();
                });
            });
        }

        function reservationCardHtml(res) {
            const mine = USER_ID !== null && res.user_id === USER_ID;
            const statusLabel = res.statut === 'cancelled' ? 'Annulée' : 'Confirmée';
            return `<article class="slot-reservation-card${mine ? ' mine' : ''}${res.statut === 'cancelled' ? ' cancelled' : ''}">
                <strong>${escapeHtml(res.start)} - ${escapeHtml(res.end)} · ${escapeHtml(res.machine)}</strong>
                <span>${mine ? 'Ma réservation' : escapeHtml(res.user)} · ${statusLabel}</span>
                ${res.motif ? `<span>${escapeHtml(res.motif)}</span>` : ''}
            </article>`;
        }

        function filterMachineCards() {
            const query = document.getElementById('machine-search').value.trim().toLowerCase();
            const status = document.getElementById('machine-status-filter').value;
            document.querySelectorAll('.machine-option-card').forEach(card => {
                const matchesQuery = !query || `${card.dataset.name} ${card.dataset.status} ${card.dataset.category}`.includes(query);
                const matchesStatus = status === 'all' || card.dataset.status === status;
                card.style.display = matchesQuery && matchesStatus ? '' : 'none';
            });
        }

        function getVisibleMachines() {
            return MACHINES.filter(machine => selectedMachineIds.has(String(machine.id)));
        }

        function getVisibleReservations() {
            return RESERVATIONS.filter(res => selectedMachineIds.has(String(res.machine_id)) && res.statut !== 'cancelled');
        }

        function openBookingPanel(dayIndex, hourStr) {
            const panel = document.getElementById('booking-panel');
            const backdrop = document.getElementById('booking-backdrop');
            panel.classList.add('is-open');
            backdrop.classList.add('is-open');
            panel.setAttribute('aria-hidden', 'false');
            document.body.classList.add('booking-modal-open');
            if (!IS_AUTHENTICATED) {
                const startValue = buildDateTimeLocal(dayIndex, hourStr, 0);
                const endValue = buildDateTimeLocal(dayIndex, hourStr, CALENDAR_CONFIG.slotMinutes);
                document.getElementById('booking-context').textContent = `Créneau du ${startValue.replace('T', ' à ')} au ${endValue.split('T')[1]}`;
                return;
            }
            setBookingSelection(dayIndex, hourStr);
            const visibleMachines = getVisibleMachines();
            const machineId = visibleMachines.find(machine => canReserveMachine(machine.id))?.id || '';
            document.getElementById('booking-machine').value = machineId;
            document.getElementById('booking-submit').disabled = false;
            setBookingMessage('', '');
            validateBookingDraft();
            window.setTimeout(() => document.getElementById('booking-start-time')?.focus(), 80);
        }

        function setBookingSelection(dayIndex, hourStr) {
            const day = getWeekDays()[dayIndex];
            const slotStart = parseInt(hourStr, 10) * 60;
            const opening = FABLAB_HOURS[dayIndex];
            const defaultEnd = opening ? Math.min(slotStart + CALENDAR_CONFIG.slotMinutes, opening[1]) : slotStart + CALENDAR_CONFIG.slotMinutes;
            bookingDraft = { dayIndex, dateKey: formatDateKey(day), date: day, startMinutes: slotStart, endMinutes: defaultEnd };
            populateBookingTimeControls();
            syncBookingHiddenFields();
        }

        function populateBookingTimeControls() {
            if (!bookingDraft) return;
            const opening = FABLAB_HOURS[bookingDraft.dayIndex];
            const startSelect = document.getElementById('booking-start-time');
            const endSelect = document.getElementById('booking-end-time');
            if (!startSelect || !endSelect) return;
            const min = opening ? opening[0] : CALENDAR_CONFIG.startHour * 60;
            const max = opening ? opening[1] : CALENDAR_CONFIG.endHour * 60;
            startSelect.innerHTML = buildTimeOptions(min, Math.max(min, max - TIME_STEP_MINUTES), bookingDraft.startMinutes);
            endSelect.innerHTML = buildTimeOptions(min + TIME_STEP_MINUTES, max, bookingDraft.endMinutes);
            startSelect.value = String(bookingDraft.startMinutes);
            endSelect.value = String(bookingDraft.endMinutes);
        }

        function updateBookingDraftFromControls(changed) {
            if (!bookingDraft) return;
            const startSelect = document.getElementById('booking-start-time');
            const endSelect = document.getElementById('booking-end-time');
            bookingDraft.startMinutes = parseInt(startSelect.value, 10);
            bookingDraft.endMinutes = parseInt(endSelect.value, 10);
            if (changed === 'start' && bookingDraft.endMinutes <= bookingDraft.startMinutes) {
                bookingDraft.endMinutes = bookingDraft.startMinutes + CALENDAR_CONFIG.slotMinutes;
                populateBookingTimeControls();
            }
            syncBookingHiddenFields();
        }

        function applyDurationShortcut(durationMinutes) {
            if (!bookingDraft) return;
            const opening = FABLAB_HOURS[bookingDraft.dayIndex];
            bookingDraft.endMinutes = opening ? Math.min(bookingDraft.startMinutes + durationMinutes, opening[1]) : bookingDraft.startMinutes + durationMinutes;
            document.querySelectorAll('.duration-chip').forEach(button => button.classList.toggle('is-active', parseInt(button.dataset.duration, 10) === durationMinutes));
            populateBookingTimeControls();
            syncBookingHiddenFields();
        }

        function syncBookingHiddenFields() {
            if (!bookingDraft) return;
            document.getElementById('booking-start').value = `${bookingDraft.dateKey}T${formatMinutes(bookingDraft.startMinutes)}`;
            document.getElementById('booking-end').value = `${bookingDraft.dateKey}T${formatMinutes(bookingDraft.endMinutes)}`;
            document.getElementById('booking-date-label').textContent = bookingDraft.date.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
            document.getElementById('booking-time-label').textContent = `${formatMinutes(bookingDraft.startMinutes)} - ${formatMinutes(bookingDraft.endMinutes)}`;
            document.getElementById('booking-context').textContent = `Créneau du ${bookingDraft.date.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' })}`;
            validateBookingDraft();
        }

        function validateBookingDraft() {
            if (!bookingDraft) return false;
            const opening = FABLAB_HOURS[bookingDraft.dayIndex];
            let message = '';
            const machineSelect = document.getElementById('booking-machine');
            const machineId = machineSelect ? machineSelect.value : '';
            if (bookingDraft.endMinutes <= bookingDraft.startMinutes) message = 'La fin doit être après le début.';
            if (opening && (bookingDraft.startMinutes < opening[0] || bookingDraft.endMinutes > opening[1])) message = 'Ce créneau sort des horaires d’ouverture.';
            if (IS_AUTHENTICATED && machineId && !canReserveMachine(machineId)) message = getMachineLockLabel(machineId);
            if (IS_AUTHENTICATED && !machineId) message = 'Aucune machine réservable avec vos formations actuelles.';
            const valid = !message;
            document.getElementById('booking-submit').disabled = !valid;
            setBookingMessage(message, message ? 'error' : '');
            return valid;
        }

        function buildTimeOptions(min, max, selected) {
            let html = '';
            for (let minutes = min; minutes <= max; minutes += TIME_STEP_MINUTES) {
                html += `<option value="${minutes}"${minutes === selected ? ' selected' : ''}>${formatMinutes(minutes)}</option>`;
            }
            return html;
        }

        function closeBookingPanel() {
            document.getElementById('booking-panel').classList.remove('is-open');
            document.getElementById('booking-backdrop').classList.remove('is-open');
            document.getElementById('booking-panel').setAttribute('aria-hidden', 'true');
            document.body.classList.remove('booking-modal-open');
        }

        async function submitBookingForm(event) {
            event.preventDefault();
            const form = event.currentTarget;
            if (!form.dateDebut.value || !form.dateFin.value || !form.machineId.value) return setBookingMessage('Tous les champs obligatoires doivent être remplis.', 'error');
            if (!validateBookingDraft()) return;
            if (new Date(form.dateFin.value) <= new Date(form.dateDebut.value)) return setBookingMessage('La date de fin doit être après la date de début.', 'error');
            setBookingMessage('Création en cours...', 'loading');
            document.getElementById('booking-submit').disabled = true;
            try {
                const response = await fetch('{{ path('api_reservation_create') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ machineId: form.machineId.value, dateDebut: form.dateDebut.value, dateFin: form.dateFin.value, motif: form.motif.value })
                });
                const data = await response.json().catch(() => ({}));
                if (!response.ok) throw new Error(data.error || 'Réservation refusée');
                setBookingMessage('Réservation créée. Actualisation...', 'success');
                window.setTimeout(() => window.location.reload(), 700);
            } catch (error) {
                setBookingMessage(error.message, 'error');
                document.getElementById('booking-submit').disabled = false;
            }
        }

        function setBookingMessage(text, state) {
            const message = document.getElementById('booking-message');
            if (!message) return;
            message.textContent = text;
            message.className = `booking-message ${state}`;
        }

        function canReserveMachine(machineId) {
            if (!IS_AUTHENTICATED) return true;
            if (IS_ADMIN) return true;
            return Boolean(BOOKING_ACCESS[String(machineId)]?.canReserve ?? BOOKING_ACCESS[machineId]?.canReserve);
        }

        function getMachineLockLabel(machineId) {
            const access = BOOKING_ACCESS[String(machineId)] || BOOKING_ACCESS[machineId] || {};
            return access.reasonLabel || 'Formation pratique non validée';
        }

        function getVisibleLockLabel(machines) {
            const physicalLocked = machines.some(machine => {
                const access = BOOKING_ACCESS[String(machine.id)] || BOOKING_ACCESS[machine.id] || {};
                return access.reason === 'physical_training_required';
            });
            return physicalLocked ? 'Formation pratique non validée' : 'Formation requise';
        }

        function getSlotState(dayIndex, slotStart) {
            const hours = FABLAB_HOURS[dayIndex];
            if (!hours) return { closed: true, className: 'is-closed', label: 'FabLab fermé' };
            if (slotStart < hours[0] || slotStart >= hours[1]) return { closed: true, className: 'is-out', label: 'Hors horaires' };
            return { closed: false, className: 'is-open', label: 'Disponible' };
        }

        function overlapsHour(reservation, slotStart) {
            const start = timeToMinutes(reservation.start);
            const end = timeToMinutes(reservation.end);
            return start < slotStart + 60 && end > slotStart;
        }

        function findNextOpenSlotLabel() {
            const days = getWeekDays();
            const now = new Date();
            for (let d = 0; d < days.length; d++) {
                const hours = FABLAB_HOURS[d];
                if (!hours) continue;
                for (let minutes = hours[0]; minutes < hours[1]; minutes += 60) {
                    const candidate = new Date(days[d]); candidate.setHours(Math.floor(minutes / 60), minutes % 60, 0, 0);
                    if (candidate > now) return candidate.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric' }) + ' ' + formatMinutes(minutes);
                }
            }
            return 'Semaine suivante';
        }

        function timeToMinutes(value) { if (!value) return 0; const [h, m] = value.split(':').map(Number); return h * 60 + (m || 0); }
        function formatMinutes(total) { return `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`; }
        function getOpeningHoursLabel(dayIndex) { const hours = FABLAB_HOURS[dayIndex]; return hours ? `${formatMinutes(hours[0])} - ${formatMinutes(hours[1])}` : 'Fermé'; }
        function getWeekStartDate(date) { const d = new Date(date); const day = d.getDay(); const diff = d.getDate() - day + (day === 0 ? -6 : 1); d.setDate(diff); d.setHours(0,0,0,0); return d; }
        function getWeekDays() { const start = getWeekStartDate(currentDate); return Array.from({length: 7}, (_, i) => { const day = new Date(start); day.setDate(start.getDate() + i); return day; }); }
        function getTimeSlots() { return Array.from({length: CALENDAR_CONFIG.endHour - CALENDAR_CONFIG.startHour}, (_, i) => String(CALENDAR_CONFIG.startHour + i).padStart(2, '0')); }
        function getWeekNumber(date) { const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate())); d.setUTCDate(d.getUTCDate() + 4 - (d.getUTCDay() || 7)); const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1)); return Math.ceil((((d - yearStart) / 86400000) + 1) / 7); }
        function isSameDay(a, b) { return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate(); }
        function formatDateKey(date) { return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`; }
        function buildDateTimeLocal(dayIndex, hourStr, offsetMinutes) { const day = getWeekDays()[dayIndex]; const date = new Date(day); date.setHours(parseInt(hourStr, 10), offsetMinutes, 0, 0); return `${formatDateKey(date)}T${String(date.getHours()).padStart(2,'0')}:${String(date.getMinutes()).padStart(2,'0')}`; }
        function escapeHtml(value) { return String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;'); }
    </script>
</body>
</html>
