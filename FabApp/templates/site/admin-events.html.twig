{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_events.browser_title_list'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260816-s134' }}">
    <style>
        
        .event-past td { opacity: .55; }
    </style>
{% endblock %}

{% block body %}
{# ⚠️ The tiles count `allEvents` — `events` is the filtered result — and compare
   against the controller's `now` (`LabClock::storedFormOf`), never Twig's
   `date()`. These columns hold the wall-clock digits the operator typed while the
   server instant is UTC, so near midnight an event moved between tiles up to two
   hours early.

   ⚠️ Kept out of the argument hash: a comment between two of its keys is a Twig
   syntax error. #}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'admin_events.list_action'|trans,
    action_route: 'app_admin_event_new',
    panel_title: 'admin_events.list_panel'|trans,
    panel_note: 'admin_events.panel_note'|trans({'%count%': events|length}),
    list_count: events|length,
    list_total: allEvents|length,
    list_route: 'app_admin_events',
    list_query: {location: venueContext.location, type: filters.type},
    list_search: filters.q,
    venue_context: venueContext,
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles_label: 'admin_list.facet_period'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: allEvents|length, query: {type: ''}, active: filters.type == ''},
        {label: 'events.tile_upcoming'|trans, count: allEvents|filter(event => (event.dateFin ?: event.dateDebut) >= now)|length, query: {type: 'upcoming'}, active: filters.type == 'upcoming'},
        {label: 'events.tile_past'|trans, count: allEvents|filter(event => (event.dateFin ?: event.dateDebut) < now)|length, query: {type: 'past'}, active: filters.type == 'past'},
    ],
} %}
    {% block content %}
            {# `now` is computed before the embed and passed in explicitly below.
               The `rows` block is rendered by the shell, so relying on it being
               ambiently in scope is the kind of assumption that works until it
               doesn't; handing it over is one line. #}
            {#  ⚠️ `now` comes from the controller (LabClock::storedFormOf), NOT from Twig's
    `date()`. `date()` is the server instant in UTC, while these columns hold the
    wall-clock digits the operator typed — comparing them flipped an event between
    À venir and Passé up to two hours early around midnight. #}
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: 'adm.col_title'|trans},
                    {label: 'adm.col_start'|trans},
                    {label: 'adm.col_end'|trans},
                    {label: 'adm.col_venue'|trans},
                    {label: 'adm.col_actions'|trans, class: 'is-actions'},
                ],
                rows: events,
                empty: 'adm.events_empty'|trans,
                now: now,
            } %}
                {% block rows %}
                    {% for event in events %}
                        <tr class="{{ (event.dateFin ?: event.dateDebut) < now ? 'event-past' : '' }}" data-admin-list-filter-row data-admin-list-filter-category="{{ (event.dateFin ?: event.dateDebut) < now ? 'past' : 'upcoming' }}" data-admin-list-filter-row-href="{{ path('app_admin_event_edit', {id: event.id}) }}">
                            <td>{% include 'site/_cell_title.html.twig' with {
                                title: event.titre,
                                href: path('app_admin_event_edit', {id: event.id}),
                            } only %}</td>
                            {# ⚠️ `wall` on both: an event's dates are the digits the operator
                               typed. This is the page whose tabs were two hours out. #}
                            <td>{% include 'site/_cell_date.html.twig' with {value: event.dateDebut, convention: 'wall'} only %}</td>
                            <td>{% include 'site/_cell_date.html.twig' with {value: event.dateFin, convention: 'wall'} only %}</td>
                            {# ⚠️ **The column showed `event.lieu` — the free-text address —
                               and never the location (S133).** So an offsite event and an
                               onsite one whose address field was left blank rendered
                               identically, as a dash, on a page whose whole job here is to
                               keep the two apart. The location is the title; the address
                               is the line under it; an event with no location says so in
                               words rather than by being blank. #}
                            <td>{% if event.venue %}{% include 'site/_cell_title.html.twig' with {
                                    title: event.venue.name,
                                    subtitle: event.lieu|default(''),
                                } only %}{% else %}{% include 'site/_cell_title.html.twig' with {
                                    title: 'venue_context.menu_offsite'|trans,
                                    subtitle: event.lieu|default(''),
                                } only %}{% endif %}</td>
                            <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                                actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_event_edit', {id: event.id})}],
                            } only %}</td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
