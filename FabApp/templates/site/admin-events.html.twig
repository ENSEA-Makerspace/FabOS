{% extends 'base.html.twig' %}

{% block title %}Événements - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260731-status' }}">
    <style>
        .admin-table { width: 100%; min-width: 640px; border-collapse: collapse; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 8px 11px; border-radius: 6px; border: 1px solid #d1d5db; text-decoration: none; color: #374151; background: #fff; font-weight: 700; cursor: pointer; font-size: 13px; }
        .event-past td { opacity: .55; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .admin-page-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
<main class="admin-page">
    <header class="admin-page-header">
        <div class="admin-page-header-inner">
            <div>
                <h1>Événements</h1>
                <p>Ateliers, journées portes ouvertes, rencontres… affichés sur l'accueil, le calendrier et un écran dédié.</p>
            </div>
            <a class="btn-link btn-primary-admin" href="{{ path('app_admin_event_new') }}">Ajouter un événement</a>
        </div>
    </header>

    <div class="admin-layout">
        {% include 'site/_admin_sidebar.html.twig' %}
        <section class="admin-panel">
            <div class="admin-panel-header"><h2>Tous les événements</h2></div>
            <div>
                {% for message in app.flashes('success') %}<div class="admin-flash success">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="admin-flash error">{{ message }}</div>{% endfor %}
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>Titre</th><th>Début</th><th>Fin</th><th>Lieu</th><th>Actions</th></tr></thead>
                    <tbody>
                    {% set now = date() %}
                    {% for event in events %}
                        <tr class="{{ (event.dateFin ?: event.dateDebut) < now ? 'event-past' : '' }}">
                            <td>{{ event.titre }}</td>
                            <td>{{ event.dateDebut|date('d/m/Y H:i') }}</td>
                            <td>{{ event.dateFin ? event.dateFin|date('d/m/Y H:i') : '—' }}</td>
                            <td>{{ event.lieu ?: '—' }}</td>
                            <td>
                                <div class="admin-actions">
                                    <a class="btn-action" href="{{ path('app_admin_event_edit', {id: event.id}) }}">Modifier</a>
                                    <a class="btn-action" href="{{ path('app_admin_event_registrations', {id: event.id}) }}">Inscriptions</a>
                                    <form method="post" action="{{ path('app_admin_event_delete', {id: event.id}) }}" onsubmit="return confirm('Supprimer cet événement ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
                                        <button class="btn-action btn-danger-admin" type="submit">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5">Aucun événement enregistré.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
{% endblock %}
