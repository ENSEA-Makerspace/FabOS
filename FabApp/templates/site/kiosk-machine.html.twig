<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="refresh" content="60">
    <title>{{ venue_label() }} — {{ machine.name }}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <link rel="stylesheet" href="{{ asset('css/kiosk.css') ~ '?v=20260903-design' }}">
    <style>        body { height: 100vh; overflow: hidden; }
        .station { height: 100vh; display: grid; grid-template-columns: 1.05fr 1fr; }
        .station__left { padding: 5vh 4vw; display: flex; flex-direction: column; background: radial-gradient(circle at 30% 20%, rgba(56,189,248,0.12), transparent 60%); }
        .station__right { padding: 5vh 3.5vw; background: rgba(255,255,255,0.03); border-left: 1px solid rgba(255,255,255,0.08); overflow-y: auto; }
        .badge-avail { align-self: flex-start; display: inline-flex; align-items: center; gap: 0.8vw; background: rgba(34,197,94,0.15); color: var(--k-go-ink); padding: 0.8vh 1.4vw; border-radius: 999px; font-size: 1.5vw; font-weight: 800; }
        .badge-avail::before { content: ""; width: 1.1vw; height: 1.1vw; min-width: 12px; min-height: 12px; background: var(--k-go); border-radius: 50%; box-shadow: 0 0 0 0 rgba(34,197,94,0.7); animation: pulse 2s infinite; }
        h1 { font-size: 5vw; line-height: 1.02; letter-spacing: -0.02em; margin: 3vh 0 1.5vh; }
        .station__meta { font-size: 1.7vw; color: var(--k-muted); display: flex; flex-wrap: wrap; gap: 0.6vw 2vw; }
        .station__meta b { color: var(--k-ink-strong); font-weight: 700; }
        .scan { margin-top: auto; border: 2px dashed rgba(56,189,248,0.4); border-radius: 24px; padding: 4vh 3vw; text-align: center; }
        .scan__icon { width: 6vw; height: 6vw; min-width: 60px; min-height: 60px; margin: 0 auto 2vh; border-radius: 50%; background: rgba(56,189,248,0.15); display: flex; align-items: center; justify-content: center; animation: pulse 2s infinite; }
        .scan__icon svg { width: 55%; height: 55%; stroke: var(--k-accent); }
        .scan__text { font-size: 2.2vw; font-weight: 800; color: var(--k-accent-bright); }
        .block { margin-bottom: 4vh; }
        .block__title { font-size: 1.5vw; text-transform: uppercase; letter-spacing: 0.06em; color: var(--k-dim); margin-bottom: 1.4vh; }
        .block__body { font-size: 1.9vw; line-height: 1.4; }
        .req-title { font-weight: 800; font-size: 2.1vw; margin-bottom: 0.8vh; }
        .chips { display: flex; flex-wrap: wrap; gap: 0.8vw; }
        .chip { background: rgba(168,85,247,0.16); color: var(--k-info-ink); padding: 0.7vh 1.3vw; border-radius: 999px; font-size: 1.6vw; font-weight: 700; }
        .chip--mat { background: rgba(56,189,248,0.14); color: var(--k-accent-ink); }
        .hours { list-style: none; display: flex; flex-direction: column; gap: 0.5vh; }
        .hours li { display: flex; justify-content: space-between; font-size: 1.6vw; padding: 0.7vh 1vw; border-radius: 10px; }
        .hours li.today { background: rgba(56,189,248,0.12); font-weight: 800; }
        .hours .closed { color: var(--k-stop-text); }
        @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(56,189,248,0.5); } 70% { box-shadow: 0 0 0 2vw rgba(56,189,248,0); } 100% { box-shadow: 0 0 0 0 rgba(56,189,248,0); } }
    </style>
</head>
<body>
    <div class="station">
        <div class="station__left">
            <span class="badge-avail">{{ 'kiosk.machine_available'|trans }}</span>
            <h1>{{ machine.name }}</h1>
            <div class="station__meta">
                <span><b>{{ 'kiosk.machine_category'|trans }}:</b> {{ machine.categoryLabel }}</span>
                <span><b>{{ 'kiosk.machine_level'|trans }}:</b> {{ machine.levelLabel }}</span>
                {% if machine.localisation %}<span>{% include 'site/_icon.html.twig' with { name: 'pin' } only %} {{ machine.localisation }}</span>{% endif %}
            </div>
            <div class="scan">
                <div class="scan__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 9h6M7 13h4"/><circle cx="17" cy="13" r="2"/></svg>
                </div>
                <div class="scan__text">{{ 'kiosk.machine_scan_prompt'|trans }}</div>
            </div>
        </div>
        <div class="station__right">
            <div class="block">
                <div class="block__title">{{ 'kiosk.machine_how_to'|trans }}</div>
                <div class="req-title">{{ machine.requirementTitle }}</div>
                <div class="block__body">{{ machine.requirementDescription }}</div>
                {% if machine.description %}<div class="block__body" style="margin-top:1.4vh; color:#cbd5e1;">{{ machine.description }}</div>{% endif %}
            </div>
            <div class="block">
                <div class="block__title">{{ 'kiosk.machine_required_badges'|trans }}</div>
                {% set reqBadges = machine.requiredMachineBadges %}
                {% if reqBadges|length > 0 %}
                    <div class="chips">{% for mb in reqBadges %}{% if mb.badge %}<span class="chip">{{ mb.badge.nom }}</span>{% endif %}{% endfor %}</div>
                {% else %}
                    <div class="block__body" style="color:#4ade80;">{{ 'kiosk.machine_free_access'|trans }}</div>
                {% endif %}
            </div>
            {% if machine.materials|length > 0 %}
                <div class="block">
                    <div class="block__title">{{ 'kiosk.machine_materials'|trans }}</div>
                    <div class="chips">{% for mat in machine.materials %}<span class="chip chip--mat">{{ mat }}</span>{% endfor %}</div>
                </div>
            {% endif %}
            {# ⚠️ S134e — today first, with its reason. The week below is
               reference; what somebody standing here needs is whether the door
               opens today and, if not, why. #}
            {% if today is defined and not today.open %}
                <div class="block">
                    <div class="block__title">{{ 'kiosk.today_closed'|trans }}</div>
                    <p class="closed">{{ today.reason ?: 'kiosk.machine_closed'|trans }}</p>
                </div>
            {% endif %}
            <div class="block">
                <div class="block__title">{{ 'kiosk.machine_hours'|trans }}</div>
                <ul class="hours">
                    {% for h in openingHours %}
                        <li class="{{ h.dayIndex == todayIndex ? 'today' : '' }}">
                            <span>{{ h.label }}</span>
                            {# ⚠️ S134d — `displayLabel` already joins a day's ranges ("09:00 – 12:00 · 14:00 – 18:00"); the envelope would hide the lunch break the kiosk is standing next to. #}
                            {% if h.isClosed %}<span class="closed">{{ 'kiosk.machine_closed'|trans }}</span>{% else %}<span>{{ h.displayLabel }}</span>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</body>
</html>
