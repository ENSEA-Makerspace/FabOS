{% set journeyText = pageContent.journey|default({}) %}
<section class="formation-detail-journey section-journey-section admin-editable-block" data-section-journey aria-labelledby="formation-journey-title">
    {% if is_granted('ROLE_ADMIN') %}
        <a class="admin-inline-edit admin-inline-edit--journey" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#journey">{{ 'common.edit'|trans }}</a>
    {% endif %}
    <div class="section-journey-hero">
        <div>
            {# The fallbacks are what a fresh install shows before the operator writes
                anything, so they belong in the catalogues — a German lab should not be
                greeted in French. Operator-authored `journeyText` still wins. #}
            <span class="section-journey-kicker">{{ journeyText.kicker|default('journey.kicker'|trans) }}</span>
            <h2 id="formation-journey-title">{{ journeyText.title|default('journey.title'|trans) }}</h2>
            <p>{{ journeyText.intro|default('journey.intro'|trans) }}</p>
        </div>
        <div class="section-journey-gauge" style="--journey-progress: {{ sectionJourney.percent }};" aria-label="{{ 'journey.gauge_label'|trans({'%percent%': sectionJourney.percent}) }}">
            <div class="section-journey-gauge__content">
                <strong>{{ sectionJourney.completed }}/{{ sectionJourney.total }}</strong>
                <span>{{ 'journey.sections_done'|trans }}</span>
            </div>
        </div>
    </div>

    {% set journeyCards = journeyText.cards|default([]) %}
    <div class="section-journey-overview" aria-label="{{ 'journey.overview_label'|trans }}">
        {% for card in journeyCards %}
            <article class="section-journey-overview-card admin-editable-block">
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="admin-inline-edit admin-inline-edit--small" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#journey">{{ 'common.edit'|trans }}</a>
                {% endif %}
                <span class="section-journey-overview-card__icon" aria-hidden="true">{{ loop.index }}</span>
                <div>
                    <h3>{{ card.title }}</h3>
                    <p>
                        {{ card.text }}
                        {% if loop.index == 2 %}
                            <span class="journey-weight-note">{{ 'journey.weights'|trans({'%training%': journeyWeights.training, '%quiz%': journeyWeights.quiz}) }}</span>
                        {% elseif loop.index == 3 and formationPolicy.physicalRequired %}
                            <span class="journey-weight-note">{{ 'journey.physical_required'|trans }}</span>
                        {% endif %}
                    </p>
                </div>
            </article>
        {% endfor %}
    </div>

    {% if sectionJourney.items is empty %}
        <div class="section-journey-import">{{ 'journey.no_sections'|trans }}</div>
    {% elseif not sectionJourney.configured %}
        <div class="section-journey-import">{{ 'journey.no_quizzes'|trans }}</div>
    {% endif %}

    <div class="section-journey-list">
        {% for item in sectionJourney.items %}
            {% set section = item.section %}
            {% set content = item.content %}
            {% set stateLabel = (item.completed ? 'journey.state_done' : (item.unlocked ? 'journey.state_open' : 'journey.state_locked'))|trans %}
            <article class="journey-card is-{{ item.status }} {{ item.active ? 'is-open' : '' }}" data-section-card data-section-id="{{ section.id }}">
                {% if is_granted('ROLE_ADMIN') %}
                    <div class="journey-card__admin-actions">
                        <a class="admin-inline-edit" href="{{ path('app_admin_formation_section_edit', {id: formation.id, sectionId: section.id}) }}">{{ 'journey.edit_section'|trans }}</a>
                        {% if item.quiz %}
                            <a class="admin-inline-edit admin-inline-edit--secondary" href="{{ path('app_admin_formation_quiz_edit', {id: formation.id, quizId: item.quiz.id}) }}">{{ 'journey.edit_quiz'|trans }}</a>
                        {% else %}
                            <a class="admin-inline-edit admin-inline-edit--secondary" href="{{ path('app_admin_formation_quiz_new', {id: formation.id, section: section.id}) }}">{{ 'journey.add_quiz'|trans }}</a>
                        {% endif %}
                    </div>
                {% endif %}
                <button
                    type="button"
                    class="journey-card__toggle"
                    data-section-toggle
                    aria-expanded="{{ item.active ? 'true' : 'false' }}"
                    aria-controls="section-panel-{{ section.id }}"
                    {{ item.unlocked ? '' : 'disabled' }}
                >
                    <span class="journey-card__number">{{ item.completed ? '✓' : item.position }}</span>
                    <span>
                        <span class="journey-card__eyebrow">{{ 'journey.step_of'|trans({'%n%': item.position, '%total%': sectionJourney.total}) }}</span>
                        <span class="journey-card__title">{{ section.titre }}</span>
                        <span class="journey-card__summary">
                            {% if item.unlocked %}
                                {{ content.intro|length > 120 ? content.intro|slice(0, 120) ~ '…' : content.intro }}
                            {% else %}
                                {{ 'journey.locked_summary'|trans }}
                            {% endif %}
                        </span>
                    </span>
                    <span class="journey-card__state">
                        {{ stateLabel }}
                        {% if item.unlocked %}
                            <svg class="journey-card__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        {% else %}
                            <span aria-hidden="true">{% include 'site/_icon.html.twig' with { name: 'lock' } only %}</span>
                        {% endif %}
                    </span>
                </button>

                <div id="section-panel-{{ section.id }}" class="journey-card__panel" data-section-panel {{ item.active ? '' : 'hidden' }}>
                    {% if item.unlocked %}
                        <div class="journey-content">
                            <p class="journey-content__intro">{{ content.intro }}</p>

                            <div class="journey-reading-guide">
                                <article class="journey-reading-guide__item">
                                    <strong>{{ 'journey.in_this_step'|trans }}</strong>
                                    <p>{{ 'journey.key_moves'|trans({'count': content.steps|length}) }}</p>
                                </article>
                                <article class="journey-reading-guide__item">
                                    <strong>{{ 'journey.expected_validation'|trans }}</strong>
                                    <p>{{ 'journey.threshold_note'|trans({'%threshold%': item.quiz.noteMinimale|default(80)}) }}</p>
                                </article>
                                <article class="journey-reading-guide__item">
                                    <strong>{{ 'journey.outcome'|trans }}</strong>
                                    <p>{{ 'journey.outcome_note'|trans }}</p>
                                </article>
                            </div>

                            {% if content.objectives is not empty %}
                                <div class="journey-objectives" aria-label="{{ 'journey.objectives_label'|trans }}">
                                    {% for objective in content.objectives %}<span class="journey-objective">{{ objective }}</span>{% endfor %}
                                </div>
                            {% endif %}

                            {% if content.steps is not empty %}
                                <div class="journey-steps">
                                    {% for step in content.steps %}
                                        <article class="journey-step">
                                            <span class="journey-step__number">{{ loop.index }}</span>
                                            <h4>{{ step.title }}</h4>
                                            <p>{{ step.text }}</p>
                                        </article>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% if content.callouts is not empty %}
                                <div class="journey-callouts">
                                    {% for callout in content.callouts %}
                                        {% set icon = callout.type == 'warning' ? '!' : (callout.type == 'check' ? '✓' : (callout.type == 'info' ? 'i' : '✦')) %}
                                        <div class="journey-callout is-{{ callout.type }}">
                                            <span class="journey-callout__icon" aria-hidden="true">{{ icon }}</span>
                                            <div><strong>{{ callout.title }}</strong><p>{{ callout.text }}</p></div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        {% if item.completed %}
                            <div class="section-complete-panel">
                                <span class="section-complete-panel__icon" aria-hidden="true">✓</span>
                                <div><strong>{{ 'journey.section_done'|trans }}</strong><p>{{ 'journey.section_done_note'|trans }}</p></div>
                            </div>
                        {% elseif item.quiz and item.questions is not empty %}
                            <form
                                class="section-mini-quiz"
                                data-section-quiz
                                data-save-url="{{ path('app_quiz_result_save', {quizId: item.quiz.id}) }}"
                                data-csrf-token="{{ csrf_token('quiz_result_' ~ item.quiz.id) }}"
                            >
                                <div class="section-mini-quiz__header">
                                    <div>
                                        <span class="section-journey-kicker">{{ 'journey.quiz_kicker'|trans }}</span>
                                        <h3>{{ 'journey.quiz_title'|trans }}</h3>
                                        <p>{{ 'journey.quiz_meta'|trans({'count': item.questions|length, 'threshold': item.quiz.noteMinimale}) }}</p>
                                    </div>
                                    <span class="section-mini-quiz__badge">{{ 'journey.quiz_counts'|trans }}</span>
                                </div>

                                {% for question in item.questions %}
                                    <fieldset class="section-mini-question" data-section-question data-question-id="{{ question.id }}">
                                        <legend>{{ loop.index }}. {{ question.text }}</legend>
                                        <div class="section-mini-options">
                                            {% for choice in question.choices %}
                                                <label class="section-mini-option">
                                                    <input
                                                        type="{{ question.type == 'multiple' ? 'checkbox' : 'radio' }}"
                                                        name="section-{{ section.id }}-question-{{ question.id }}"
                                                        value="{{ choice.id }}"
                                                    >
                                                    <span>{{ choice.text }}</span>
                                                </label>
                                            {% endfor %}
                                        </div>
                                    </fieldset>
                                {% endfor %}

                                <div class="section-mini-quiz__actions">
                                    {% if app.user %}
                                        <button type="submit" class="section-mini-quiz__submit" data-section-quiz-submit>{{ 'journey.submit'|trans }}</button>
                                        <p class="section-mini-quiz__message" data-section-quiz-message role="status">
                                            {% if item.result %}{{ 'journey.best_score'|trans({'%score%': item.result.score}) }}{% endif %}
                                        </p>
                                    {% else %}
                                        <a class="section-mini-quiz__submit" href="{{ path('app_login') }}">{{ 'journey.sign_in_to_validate'|trans }}</a>
                                        <p class="section-mini-quiz__message">{{ 'journey.sign_in_note'|trans }}</p>
                                    {% endif %}
                                </div>
                            </form>
                        {% else %}
                            <div class="section-journey-import">{{ 'journey.quiz_missing'|trans }}</div>
                        {% endif %}
                    {% else %}
                        <div class="journey-locked-panel">
                            <span aria-hidden="true">{% include 'site/_icon.html.twig' with { name: 'lock' } only %}</span>
                            <div><strong>{{ 'journey.locked_title'|trans }}</strong><p>{{ 'journey.locked_note'|trans }}</p></div>
                        </div>
                    {% endif %}
                </div>
            </article>
        {% endfor %}
    </div>
    {% if is_granted('ROLE_ADMIN') %}
        <div class="formation-journey-admin-footer">
            <a class="btn btn-secondary" href="{{ path('app_admin_formation_section_new', {id: formation.id}) }}">{{ 'journey.create_section'|trans }}</a>
            <a class="btn btn-primary" href="{{ path('app_admin_formation_quiz_new', {id: formation.id}) }}">{{ 'journey.add_quiz'|trans }}</a>
        </div>
    {% endif %}
</section>
