{# S195 — le comportement des cartes de création (votants, étoiles), déplacé ici
   pour servir la galerie ET la fiche. #}
<script>
        {# The one sentence this block writes, translated. See the note at the top of
           public/js/quiz.js: a literal here reaches no catalogue. #}
        const RATING_LABEL = {{ 'projects.your_rating'|trans|json_encode|raw }};
        document.querySelectorAll('.creation-voters-toggle').forEach((toggle) => {
            const panel = document.getElementById(toggle.dataset.target);
            if (!panel) {
                return;
            }
            toggle.addEventListener('click', () => {
                const isHidden = panel.hasAttribute('hidden');
                if (isHidden) {
                    panel.removeAttribute('hidden');
                } else {
                    panel.setAttribute('hidden', '');
                }
                toggle.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
            });
        });

        document.querySelectorAll('.star-rating').forEach((ratingEl) => {
            const form = ratingEl.closest('.creation-rating-form');
            const input = form ? form.querySelector('.star-rating__input') : null;
            const status = form ? form.querySelector('.star-rating__status') : null;
            const stars = Array.from(ratingEl.querySelectorAll('.star-rating__star'));
            let selected = Number.parseFloat(ratingEl.dataset.initialRating || '0') || 0;

            const render = (value) => {
                stars.forEach((star) => {
                    const index = Number.parseInt(star.dataset.star, 10);
                    const fill = Math.max(0, Math.min(1, value - index + 1));
                    star.style.setProperty('--fill', `${fill * 100}%`);
                });
            };

            const select = (value) => {
                selected = Math.max(0.5, Math.min(5, Math.round(value * 2) / 2));
                if (input) {
                    input.value = selected.toFixed(1);
                }
                if (status) {
                    status.textContent = RATING_LABEL.replace('%score%', selected.toFixed(1));
                }
                render(selected);
            };

            render(selected);

            if (ratingEl.classList.contains('star-rating--readonly')) {
                return;
            }

            stars.forEach((star) => {
                const pointerValue = (event) => {
                    const rect = star.getBoundingClientRect();
                    const base = Number.parseInt(star.dataset.star, 10) - 1;
                    return base + (event.clientX - rect.left <= rect.width / 2 ? 0.5 : 1);
                };

                star.addEventListener('pointermove', (event) => render(pointerValue(event)));
                star.addEventListener('click', (event) => select(pointerValue(event)));
                star.addEventListener('keydown', (event) => {
                    if (!['ArrowLeft', 'ArrowDown', 'ArrowRight', 'ArrowUp', 'Home', 'End', 'Enter', ' '].includes(event.key)) {
                        return;
                    }
                    event.preventDefault();
                    if (event.key === 'Home') select(0.5);
                    if (event.key === 'End') select(5);
                    if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') select((selected || 0.5) - 0.5);
                    if (event.key === 'ArrowRight' || event.key === 'ArrowUp') select((selected || 0) + 0.5);
                    if (event.key === 'Enter' || event.key === ' ') select(Number.parseInt(star.dataset.star, 10));
                });
            });

            ratingEl.addEventListener('pointerleave', () => render(selected));
        });
    </script>
