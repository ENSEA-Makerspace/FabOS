{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_emails.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260812-s137-refine' }}">
    <style>

        .settings-field { max-width: 520px; margin-bottom: 16px; }
        .settings-field label { display: block; font-weight: 700; margin-bottom: 6px; }
        {# Match on "not a checkbox" rather than listing types: the previous
           allow-list covered text and email only, so the url and number fields
           added later rendered as bare unstyled inputs. #}
        .settings-field input:not([type="checkbox"]) { width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 15px; }
        .settings-hint { color: var(--color-text-light); font-size: 13px; margin-top: 6px; }
        .btn-primary { background: var(--color-primary); color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; margin-top: 8px; }
        .btn-secondary { background: white; color: var(--color-primary); border: 1px solid var(--color-primary); padding: 10px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; margin-top: 8px; }

        .notice { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; background: color-mix(in srgb, var(--color-warn) 15%, var(--theme-surface)); color: var(--color-warn); }
        .mail-stats { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; }
        .mail-stat { background: var(--theme-surface-elevated); border: 1px solid var(--border-color); border-radius: 10px; padding: 10px 16px; min-width: 110px; }
        .mail-stat__value { font-size: 22px; font-weight: 800; }
        .mail-stat__label { color: var(--color-text-light); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
        {# 🔴 `.pill` deleted (S135) — the FIFTH private status chip in the admin,
           and the one whose `queued` state was a literal `#e0e7ff` / `#3730a3`
           pair that dark mode had to be patched for separately in admin.css.
           `_cell_state` and a signal. `.mail-error` went with it: a `#991b1b`
           that stays `#991b1b` on a dark panel. #}
        .mail-error { color: var(--color-stop); font-size: 12px; display: block; max-width: 320px; word-break: break-word; }
        .reminder-toggle { display: flex; align-items: center; gap: 10px; font-weight: 600; cursor: pointer; }
        .reminder-toggle input { width: 18px; height: 18px; accent-color: var(--color-primary, #9E1B56); cursor: pointer; }
        .mail-empty { color: var(--color-text-light); padding: 18px 0; }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <header class="admin-header"><div class="admin-header-content"><h1>{{ 'admin_emails.page_title'|trans }}</h1></div></header>
    <div class="admin-main-content">
        {% include 'site/_admin_sidebar.html.twig' %}
        <div class="admin-column">
        <main class="admin-panel">
            {% for message in app.flashes('success') %}<div class="flash success">{{ message }}</div>{% endfor %}
            {% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}

            {% if mailPaused %}
                <div class="notice">{{ 'admin_emails.paused_notice'|trans|raw }}</div>
            {% elseif not configured %}
                <div class="notice">{{ 'admin_emails.unconfigured_notice'|trans }}</div>
            {% endif %}

            <h2>{{ 'admin_emails.account_heading'|trans }}</h2>
            <form method="post" action="{{ path('app_admin_emails') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_emails') }}">
                <input type="hidden" name="action" value="save">
                <div class="settings-field">
                    <label for="mail_transport_dsn">{{ 'admin_emails.dsn'|trans }}</label>
                    <input type="text" name="mail_transport_dsn" id="mail_transport_dsn" value="{{ transportDsn }}" placeholder="{{ 'admin_emails.dsn_placeholder'|trans }}" autocomplete="off" spellcheck="false">
                    <p class="settings-hint">{{ 'admin_emails.dsn_help'|trans|raw }}</p>
                </div>
                <div class="settings-field">
                    <label for="mail_from_address">{{ 'admin_emails.from_address'|trans }}</label>
                    <input type="email" name="mail_from_address" id="mail_from_address" value="{{ fromAddress }}" placeholder="fablab@exemple.fr">
                </div>
                <div class="settings-field">
                    <label for="mail_from_name">{{ 'admin_emails.from_name'|trans }}</label>
                    <input type="text" name="mail_from_name" id="mail_from_name" value="{{ fromName }}" maxlength="120" placeholder="{{ 'admin_emails.from_name_placeholder'|trans }}">
                    <p class="settings-hint">{{ 'admin_emails.from_name_help'|trans }}</p>
                </div>
                <div class="settings-field">
                    <label for="mail_reply_to">{{ 'admin_emails.reply_to'|trans }}</label>
                    <input type="email" name="mail_reply_to" id="mail_reply_to" value="{{ replyTo }}" placeholder="contact@exemple.fr">
                </div>
                <div class="settings-field">
                    <label for="public_base_url">{{ 'admin_emails.public_url'|trans }}</label>
                    <input type="url" name="public_base_url" id="public_base_url" value="{{ publicBaseUrl }}" placeholder="https://fablab.exemple.fr" spellcheck="false">
                    <p class="settings-hint">{{ 'admin_emails.public_url_help'|trans|raw }}</p>
                </div>
                <div class="settings-field">
                    <label class="reminder-toggle">
                        <input type="checkbox" name="mail_paused" value="1" {{ mailPaused ? 'checked' : '' }}>
                        <span>{{ 'admin_emails.pause_label'|trans }}</span>
                    </label>
                    <p class="settings-hint">{{ 'admin_emails.pause_help'|trans|raw }}</p>
                </div>
                <button type="submit" class="btn-primary">{{ 'common.save'|trans }}</button>
            </form>

            <h2 style="margin-top: 28px;">{{ 'admin_emails.test_heading'|trans }}</h2>
            <form method="post" action="{{ path('app_admin_emails') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_emails') }}">
                <input type="hidden" name="action" value="test">
                <div class="settings-field">
                    <label for="test_recipient">{{ 'admin_emails.test_recipient'|trans }}</label>
                    <input type="email" name="test_recipient" id="test_recipient" value="{{ app.user ? app.user.email : '' }}" placeholder="{{ 'admin_emails.test_placeholder'|trans }}">
                    <p class="settings-hint">{{ 'admin_emails.test_help'|trans }}</p>
                </div>
                <button type="submit" class="btn-secondary">{{ 'admin_emails.test_send'|trans }}</button>
            </form>

            <h2 style="margin-top: 28px;">{{ 'admin_emails.reminders_heading'|trans }}</h2>
            <p class="settings-hint" style="margin-top: 0;">{{ 'admin_emails.reminders_help'|trans|raw }}</p>
            <form method="post" action="{{ path('app_admin_emails') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_emails') }}">
                <input type="hidden" name="action" value="reminders">

                <div class="settings-field">
                    <label class="reminder-toggle">
                        <input type="checkbox" name="reminder_booking" value="1" {{ reminders.booking ? 'checked' : '' }}>
                        <span>{{ 'admin_emails.reminder_booking'|trans }}</span>
                    </label>
                    <p class="settings-hint">{{ 'admin_emails.reminder_booking_help'|trans }}</p>
                </div>
                <div class="settings-field">
                    <label for="reminder_booking_lead_hours">{{ 'admin_emails.lead_hours'|trans }}</label>
                    <input type="number" name="reminder_booking_lead_hours" id="reminder_booking_lead_hours" value="{{ reminderBookingLeadHours }}" min="1" max="168" style="max-width: 120px;">
                    <p class="settings-hint">{{ 'admin_emails.lead_hours_help'|trans }}</p>
                </div>

                <div class="settings-field">
                    <label class="reminder-toggle">
                        <input type="checkbox" name="reminder_event" value="1" {{ reminders.event ? 'checked' : '' }}>
                        <span>{{ 'admin_emails.reminder_event'|trans }}</span>
                    </label>
                    <p class="settings-hint">{{ 'admin_emails.reminder_event_help'|trans }}</p>
                </div>
                <div class="settings-field">
                    <label for="reminder_event_lead_hours">{{ 'admin_emails.lead_hours'|trans }}</label>
                    <input type="number" name="reminder_event_lead_hours" id="reminder_event_lead_hours" value="{{ reminderEventLeadHours }}" min="1" max="168" style="max-width: 120px;">
                    <p class="settings-hint">{{ 'admin_emails.lead_hours_help'|trans }}</p>
                </div>

                <div class="settings-field">
                    <label class="reminder-toggle">
                        <input type="checkbox" name="reminder_loan_due" value="1" {{ reminders.loan_due ? 'checked' : '' }}>
                        <span>{{ 'admin_emails.reminder_loan_due'|trans }}</span>
                    </label>
                </div>
                <div class="settings-field">
                    <label for="reminder_loan_lead_days">{{ 'admin_emails.lead_days'|trans }}</label>
                    <input type="number" name="reminder_loan_lead_days" id="reminder_loan_lead_days" value="{{ reminderLoanLeadDays }}" min="0" max="30" style="max-width: 120px;">
                    <p class="settings-hint">{{ 'admin_emails.lead_days_help'|trans }}</p>
                </div>

                <div class="settings-field">
                    <label class="reminder-toggle">
                        <input type="checkbox" name="reminder_loan_overdue" value="1" {{ reminders.loan_overdue ? 'checked' : '' }}>
                        <span>{{ 'admin_emails.reminder_loan_overdue'|trans }}</span>
                    </label>
                    <p class="settings-hint">{{ 'admin_emails.reminder_loan_overdue_help'|trans }}</p>
                </div>

                <div class="settings-field">
                    <label class="reminder-toggle">
                        <input type="checkbox" name="reminder_maintenance_overdue" value="1" {{ reminders.maintenance_overdue ? 'checked' : '' }}>
                        <span>{{ 'admin_emails.reminder_maintenance'|trans }}</span>
                    </label>
                    <p class="settings-hint">{{ 'admin_emails.reminder_maintenance_help'|trans }}</p>
                </div>

                <button type="submit" class="btn-primary">{{ 'admin_emails.reminders_save'|trans }}</button>
            </form>

            {% if reminderCounts is not empty %}
                <div class="mail-stats" style="margin-top: 16px;">
                    {% for kind, total in reminderCounts %}
                        <div class="mail-stat"><div class="mail-stat__value">{{ total }}</div><div class="mail-stat__label">{{ kind }}</div></div>
                    {% endfor %}
                </div>
                <p class="settings-hint">{{ 'admin_emails.reminder_counts_help'|trans }}</p>
            {% endif %}

            <h2 style="margin-top: 28px;">{{ 'admin_emails.log_heading'|trans }}</h2>
            <div class="mail-stats">
                <div class="mail-stat"><div class="mail-stat__value">{{ counts.sent|default(0) }}</div><div class="mail-stat__label">{{ 'admin_emails.count_sent'|trans }}</div></div>
                <div class="mail-stat"><div class="mail-stat__value">{{ counts.queued|default(0) }}</div><div class="mail-stat__label">{{ 'admin_emails.count_queued'|trans }}</div></div>
                <div class="mail-stat"><div class="mail-stat__value">{{ counts.failed|default(0) }}</div><div class="mail-stat__label">{{ 'admin_emails.count_failed'|trans }}</div></div>
                <div class="mail-stat"><div class="mail-stat__value">{{ queueSize }}</div><div class="mail-stat__label">{{ 'admin_emails.count_queue'|trans }}</div></div>
            </div>
            {% if queueSize > 0 %}
                <div class="notice">{{ 'admin_emails.queue_notice'|trans({'%n%': queueSize})|raw }}</div>
            {% endif %}

            {% if logs is empty %}
                <p class="mail-empty">{{ 'admin_emails.log_empty'|trans }}</p>
            {% else %}
                {% embed 'site/_data_table.html.twig' with {
                    columns: [
                        {label: 'admin_emails.col_date'|trans, class: 'is-tight'},
                        {label: 'admin_emails.col_recipient'|trans, class: 'is-grow'},
                        {label: 'admin_emails.col_subject'|trans},
                        {label: 'admin_emails.col_status'|trans, class: 'is-tight'},
                    ],
                    rows: logs,
                    empty: 'admin_emails.log_empty'|trans,
                } %}
                    {% block rows %}
{% for log in logs %}
                            <tr>
                                <td>{% include 'site/_cell_date.html.twig' with {value: log.queuedAt, convention: 'machine'} only %}</td>
                                {# The users list is the shape: an identity mark, the name,
                                   the address under it. A recipient is a person. #}
                                <td>{% include 'site/_cell_title.html.twig' with {
                                    title: log.recipientName ?: log.recipient,
                                    subtitle: log.recipientName ? log.recipient : '',
                                    media: include('site/_cell_media.html.twig', {
                                        initials: log.recipientName ?: log.recipient, shape: 'circle',
                                    }, with_context = false),
                                } only %}</td>
                                <td>{% include 'site/_cell_title.html.twig' with {
                                    title: log.subject|default(''),
                                    subtitle: log.category ~ ' / ' ~ log.template,
                                } only %}</td>
                                <td>{% include 'site/_cell_state.html.twig' with {
                                    label: ('admin_emails.status_' ~ log.status)|trans,
                                    signal: log.status == 'sent' ? 'go' : (log.status == 'failed' ? 'stop' : 'wait'),
                                } only %}{% if log.error %}<span class="mail-error">{{ log.error }}</span>{% endif %}</td>
                            </tr>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </main>
        </div>
    </div>
{% endblock %}
