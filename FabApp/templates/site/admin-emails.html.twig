{% extends 'base.html.twig' %}

{# ⚠️ **S132 — three readable tasks instead of one scroll.**

   This was a notice, a sender-account form, a test-send form, five reminder
   switches, two count strips and a log, separated by `<h2 style="margin-top">`
   and nothing else, with three Save buttons and no way to tell which belonged
   to what. The roadmap asked for état/diagnostic, modèles/préférences and a
   filterable journal; they are the three cards below, on the same anchored-card
   shape `/admin/settings` uses.

   ⚠️ **The journal filters on the server.** It rendered `recent(50)`, so the
   fiftieth-most-recent message was the horizon and "did last Tuesday's reminder
   reach Camille?" could not be asked at all. Period and status are the shared
   filter component; the recipient is its new `text_fields` — an address list is
   not a dropdown.

   ⚠️ Secrets are never printed: `transportDsn` arrives masked and
   `MailSettings::isMasked()` stops a re-post writing the dots over the password.

   No local `<style>`: `.settings-*`, `.mail-*` and `.notice` are in `admin.css`.

   ⚠️ **S150 — quinze champs à l'arrivée, dont sept qu'on ne touche jamais deux
   fois** (règle 1 de `FORM-DESIGN.md`). L'adresse de réponse, l'adresse publique,
   l'arrêt d'urgence et l'envoi de test passent derrière des replis ; l'écran
   s'ouvre sur onze. **Un `<details>` fermé soumet ses champs** — c'est ce qui
   permet de replier sans qu'aucune valeur ne retombe sur son défaut à
   l'enregistrement suivant, ce qu'un `{% if %}` aurait fait en silence.

   ⚠️ **Les trois délais sont des PHRASES** (règle 3) : le libellé porte le début,
   l'aide porte la fin, `form-sentence--tail` les pose de part et d'autre du champ.
   Rien n'est rendu à la main — voir `MailRemindersType`.

   ⚠️ **Et chacun porte sa ligne de conséquence** (règle 4) : l'horizon que la
   prochaine passe va réellement balayer, calculé par le contrôleur avec
   l'arithmétique des scanners eux-mêmes. `|lab_date()` et pas `|date()` : c'est un
   horodatage machine, et se tromper là-dessus est silencieux.

   🔴 **`refusedEditor` vient du contrôleur.** Un repli qui reste fermé sur un refus
   cache l'erreur et la saisie ; le lire depuis `form.vars.submitted` dans le
   gabarit est le piège documenté (`prod` sans `strict_variables`). #}

{% block title %}{{ 'admin_emails.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260824-s149' }}">
    {{ importmap('app') }}
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
    <div class="admin-main-content">
        {% include 'site/_admin_sidebar.html.twig' %}
        <div class="admin-column">
        <section class="admin-panel admin-list-card admin-form-card">
            {% include 'site/_admin_form_head.html.twig' with {
                title: 'admin_nav.entry.app_admin_emails'|trans,
            } only %}

            {% for message in app.flashes('success') %}<div class="flash success">{{ message|flash_text }}</div>{% endfor %}
            {% for message in app.flashes('error') %}<div class="flash error">{{ message|flash_text }}</div>{% endfor %}

            <ul class="settings-toc">
                <li><a href="#etat">{{ 'admin_emails.task_state'|trans }}</a></li>
                <li><a href="#preferences">{{ 'admin_emails.task_preferences'|trans }}</a></li>
                <li><a href="#journal">{{ 'admin_emails.task_journal'|trans }}</a></li>
            </ul>

            {# ---- 1. État et diagnostic ---- #}
            <section class="settings-card" id="etat">
                <div class="settings-card__head">
                    <h2>{{ 'admin_emails.task_state'|trans }}</h2>
                    <p class="settings-card__state">
                        {% if mailPaused %}{{ 'admin_emails.state_paused'|trans }}
                        {%- elseif configured %}{{ 'admin_emails.state_ready'|trans }}
                        {%- else %}{{ 'admin_emails.state_unconfigured'|trans }}{% endif %}
                    </p>
                </div>

                {% if mailPaused %}
                    <div class="notice">{{ 'admin_emails.paused_notice'|trans|raw }}</div>
                {% elseif not configured %}
                    <div class="notice">{{ 'admin_emails.unconfigured_notice'|trans }}</div>
                {% endif %}

                <div class="mail-stats">
                    <div class="mail-stat"><div class="mail-stat__value">{{ counts.sent|default(0) }}</div><div class="mail-stat__label">{{ 'admin_emails.count_sent'|trans }}</div></div>
                    <div class="mail-stat"><div class="mail-stat__value">{{ counts.queued|default(0) }}</div><div class="mail-stat__label">{{ 'admin_emails.count_queued'|trans }}</div></div>
                    <div class="mail-stat"><div class="mail-stat__value">{{ counts.failed|default(0) }}</div><div class="mail-stat__label">{{ 'admin_emails.count_failed'|trans }}</div></div>
                    <div class="mail-stat"><div class="mail-stat__value">{{ queueSize }}</div><div class="mail-stat__label">{{ 'admin_emails.count_queue'|trans }}</div></div>
                </div>
                {% if queueSize > 0 %}
                    <div class="notice">{{ 'admin_emails.queue_notice'|trans({'n': queueSize})|raw }}</div>
                {% endif %}

                <h3>{{ 'admin_emails.account_heading'|trans }}</h3>
                {{ form_start(accountForm) }}
                    {% form_theme accountForm 'form/admin_theme.html.twig' %}
                    {# Le cas courant est celui que dit déjà `unconfigured_notice` un
                       peu plus haut : « renseignez au minimum un DSN de transport et
                       une adresse d'expéditeur ». Ces trois-là restent donc de plein
                       pied ; les trois autres n'y étaient que par habitude. #}
                    {{ form_row(accountForm.mail_transport_dsn) }}
                    {{ form_row(accountForm.mail_from_address) }}
                    {{ form_row(accountForm.mail_from_name) }}

                    {# ⚠️ **Règle 7 dans le `<summary>` : la valeur, pas seulement le
                       titre.** Replier l'adresse publique risquait de la faire oublier
                       — sans elle, aucun lien de désinscription n'est ajouté aux
                       e-mails. Le repli affiche donc ce qu'elle vaut : « non
                       renseigné » se lit sans ouvrir quoi que ce soit. #}
                    <details class="settings-danger settings-danger--neutral"{{ refusedEditor|default(null) == 'account' ? ' open' : '' }}>
                        <summary>{{ 'admin_emails.account_options'|trans }} — {{ publicBaseUrl ?: 'admin_settings.state_unset'|trans }}</summary>
                        <div>
                            {{ form_row(accountForm.mail_reply_to) }}
                            {{ form_row(accountForm.public_base_url) }}
                        </div>
                    </details>

                    {# 🔴 L'arrêt d'urgence : le seul contrôle de cette carte qui, coché
                       par erreur, arrête AUSSI les confirmations de réservation. Il
                       n'est pas neutre, donc pas `--neutral` — et il est OUVERT quand
                       il est actif : un état qu'on subit ne se cache pas derrière un
                       clic. Le bandeau `paused_notice` en haut de carte reste la
                       première chose qu'on lit ; ceci en est l'interrupteur. #}
                    <details class="settings-danger"{{ (mailPaused or refusedEditor|default(null) == 'account') ? ' open' : '' }}>
                        <summary>{{ 'admin_emails.pause_label'|trans }}</summary>
                        <div>
                            {{ form_row(accountForm.mail_paused) }}
                        </div>
                    </details>
                    <button type="submit" class="btn-link btn-primary-admin">{{ 'common.save'|trans }}</button>
                {{ form_end(accountForm) }}

                {# ⚠️ Le titre de section devient le `<summary>` — même clé, pas de
                   doublon. Envoyer un test est une vérification qu'on fait une fois,
                   le jour où l'on branche le compte ; l'état de ce branchement est
                   déjà résumé en haut de carte, donc le champ n'a pas à être ouvert
                   en permanence.

                   🔴 Rouvert quand l'adresse a été refusée, sinon le message « L'email
                   est invalide » s'affiche dans une boîte fermée. #}
                <details class="settings-danger settings-danger--neutral"{{ refusedEditor|default(null) == 'test' ? ' open' : '' }}>
                    <summary>{{ 'admin_emails.test_heading'|trans }}</summary>
                    <div>
                        {{ form_start(testForm) }}
                            {% form_theme testForm 'form/admin_theme.html.twig' %}
                            {{ form_row(testForm.test_recipient) }}
                            <button type="submit" class="btn-link">{{ 'admin_emails.test_send'|trans }}</button>
                        {{ form_end(testForm) }}
                    </div>
                </details>
            </section>

            {# ---- 2. Modèles et préférences ---- #}
            <section class="settings-card" id="preferences">
                <div class="settings-card__head">
                    <h2>{{ 'admin_emails.task_preferences'|trans }}</h2>
                    <p class="settings-card__state">{{ 'admin_emails.state_reminders'|trans({
                        'count': reminders|filter(v => v)|length,
                        'total': reminders|length,
                    }) }}</p>
                </div>
                <p class="settings-hint">{{ 'admin_emails.reminders_help'|trans|raw }}</p>
                {{ form_start(remindersForm) }}
                    {% form_theme remindersForm 'form/admin_theme.html.twig' %}
                    {{ form_row(remindersForm.reminder_booking) }}
                    {{ form_row(remindersForm.reminder_booking_lead_hours) }}

                    {{ form_row(remindersForm.reminder_event) }}
                    {{ form_row(remindersForm.reminder_event_lead_hours) }}

                    {{ form_row(remindersForm.reminder_loan_due) }}
                    {{ form_row(remindersForm.reminder_loan_lead_days) }}

                    {{ form_row(remindersForm.reminder_loan_overdue) }}
                    {{ form_row(remindersForm.reminder_maintenance_overdue) }}

                    <button type="submit" class="btn-link btn-primary-admin">{{ 'admin_emails.reminders_save'|trans }}</button>
                {{ form_end(remindersForm) }}

                {% if reminderCounts is not empty %}
                    <div class="mail-stats">
                        {% for kind, total in reminderCounts %}
                            <div class="mail-stat"><div class="mail-stat__value">{{ total }}</div><div class="mail-stat__label">{{ kind }}</div></div>
                        {% endfor %}
                    </div>
                    <p class="settings-hint">{{ 'admin_emails.reminder_counts_help'|trans }}</p>
                {% endif %}

                {# ⚠️ Read from `NotificationCategory::OPTOUTABLE`, not written out
                   here: which mail a member may mute is a decision the code already
                   records, and a second list of it on this page would be free to
                   disagree with the profile screen that honours it. #}
                <h3>{{ 'admin_emails.optout_heading'|trans }}</h3>
                <p class="settings-hint">{{ 'admin_emails.optout_help'|trans }}</p>
                <p class="settings-hint"><strong>{{ optOutable|join(' · ') }}</strong></p>
            </section>

            {# ---- 3. Journal ---- #}
            <section class="settings-card" id="journal">
                <div class="settings-card__head">
                    <h2>{{ 'admin_emails.task_journal'|trans }}</h2>
                    <p class="settings-card__state">{{ 'admin_list.count_of'|trans({'%count%': logs|length, '%total%': logMatching}) }}</p>
                </div>

                {# The shared filter component, standalone: status as the tile row —
                   it is what a mail log is *about* — period and recipient as
                   "Affiner". `#journal` on the route so a filtered view comes back
                   to the card that was filtered. #}
                {# ⚠️ The anchor rides on `list_route_params`, never on `list_query`.
                   `_fragment` is a URL-generator directive, so in `list_query` it
                   would be re-emitted as a hidden `<input name="_fragment">` and
                   arrive as a literal query parameter that scrolls nowhere. On the
                   route params it becomes `#journal` on the tile links and on the
                   refine form's action, which browsers keep when they set the
                   query. #}
                {% include 'site/_admin_filters.html.twig' with {
                    list_route: 'app_admin_emails',
                    list_route_params: {_fragment: 'journal'},
                    list_query: {days: logDays, status: logStatus, recipient: logRecipient},
                    tiles_label: 'admin_emails.col_status'|trans,
                    tiles: [
                        {label: 'admin_list.all'|trans, query: {status: ''}, active: logStatus == ''},
                        {label: 'admin_emails.status_sent'|trans, count: counts.sent|default(0), query: {status: 'sent'}, active: logStatus == 'sent'},
                        {label: 'admin_emails.status_queued'|trans, count: counts.queued|default(0), query: {status: 'queued'}, active: logStatus == 'queued'},
                        {label: 'admin_emails.status_failed'|trans, count: counts.failed|default(0), query: {status: 'failed'}, active: logStatus == 'failed'},
                    ],
                    refine: [
                        {name: 'days', label: 'admin_emails.filter_period'|trans, value: logDays, options: [
                            {value: 1, label: 'admin_emails.period_1'|trans},
                            {value: 7, label: 'admin_emails.period_7'|trans},
                            {value: 30, label: 'admin_emails.period_30'|trans},
                            {value: 0, label: 'admin_emails.period_all'|trans},
                        ]},
                    ],
                    text_fields: [
                        {name: 'recipient', label: 'admin_emails.col_recipient'|trans, value: logRecipient, placeholder: 'admin_emails.filter_recipient_placeholder'|trans},
                    ],
                } only %}

                {# ⚠️ `is-grow` on the recipient AND on the subject. The recipient column
                   alone took all the slack, leaving the subject at its minimum, and its
                   subtitle carries a technical identifier — one unbreakable token, measured
                   at 233 px of text in a 216 px cell, so it broke mid-word. Two `is-grow`
                   columns share the surplus instead of one taking it.

                   ⚠️ No `{% if logs is empty %}` guard: `_data_table` renders its own
                   empty row from `empty:`. #}
                {% embed 'site/_data_table.html.twig' with {
                        columns: [
                            {label: 'admin_emails.col_date'|trans, class: 'is-tight'},
                            {label: 'admin_emails.col_recipient'|trans, class: 'is-grow'},
                            {label: 'admin_emails.col_subject'|trans, class: 'is-grow'},
                            {label: 'admin_emails.col_status'|trans, class: 'is-tight'},
                        ],
                        rows: logs,
                        empty: 'admin_emails.log_empty'|trans,
                    } %}
                        {% block rows %}
                            {% for log in logs %}
                                <tr>
                                    <td>{% include 'site/_cell_date.html.twig' with {value: log.queuedAt, convention: 'machine'} only %}</td>
                                    {# The users list is the shape: an identity mark, the name,
                                       the address under it. A recipient is a person. #}
                                    <td>{% include 'site/_cell_title.html.twig' with {
                                        title: log.recipientName ?: log.recipient,
                                        subtitle: log.recipientName ? log.recipient : '',
                                        media: include('site/_cell_media.html.twig', {
                                            initials: log.recipientName ?: log.recipient, shape: 'circle',
                                        }, with_context = false),
                                    } only %}</td>
                                    <td>{% include 'site/_cell_title.html.twig' with {
                                        title: log.subject|default(''),
                                        subtitle: log.category ~ ' / ' ~ log.template,
                                    } only %}</td>
                                    <td>{% include 'site/_cell_state.html.twig' with {
                                        label: ('admin_emails.status_' ~ log.status)|trans,
                                        signal: log.status == 'sent' ? 'go' : (log.status == 'failed' ? 'stop' : 'wait'),
                                    } only %}{% if log.error %}<span class="mail-error">{{ log.error }}</span>{% endif %}</td>
                                </tr>
                            {% endfor %}
                        {% endblock %}
                {% endembed %}
            </section>
        </section>
        </div>
    </div>
    </main>
{% endblock %}
