{% extends 'site/base_public.html.twig' %}

{# The other half of S134g's round trip. It reuses `forgot-password`'s auth-card
   shape so the two screens are visibly one flow, and it has exactly two states:
   a form, or an honest "this link is no longer valid".

   ⚠️ The expired state does NOT say why. "Already used", "expired" and "the
   password changed since" are three different facts about somebody's account,
   and this page is reachable by anyone holding a URL. One sentence, one door. #}

{% block title %}{{ 'reset.title'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260823-s148j7' }}">
    <style>
        .auth-flash { margin-bottom: var(--spacing-md); padding: 12px 14px; border-radius: 8px; font-size: 14px; }
        .auth-flash.success { background: var(--tone-ok-soft); color: var(--tone-ok-ink); }
        .auth-flash.error { background: var(--tone-stop-soft); color: var(--color-stop); }
    </style>
{% endblock %}

{% block body %}
    <main id="main-content" tabindex="-1" class="main-content">
        <section class="auth-section">
            <div class="auth-container">
                <div class="auth-card">
                    <div class="auth-header">
                        <h1 class="auth-title">{{ 'reset.title'|trans }}</h1>
                        <p class="auth-subtitle">{{ expired ? 'reset.expired_subtitle'|trans : 'reset.subtitle'|trans }}</p>
                    </div>

                    {% for message in app.flashes('error') %}<div class="auth-flash error">{{ message|trans }}</div>{% endfor %}

                    {% if expired %}
                        <div class="auth-links">
                            <p><a href="{{ path('app_forgot_password') }}">{{ 'reset.ask_again'|trans }}</a></p>
                        </div>
                    {% else %}
                        <form class="auth-form" method="post" action="{{ path('app_reset_password', {token: token}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">
                            <div class="form-group">
                                <label class="form-label" for="reset-password">{{ 'reset.new_password'|trans }}</label>
                                {# `new-password` so a manager offers to generate one rather than
                                   filling in the password being replaced. #}
                                <input class="form-input" id="reset-password" type="password" name="password"
                                       required minlength="8" autocomplete="new-password" autofocus>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="reset-confirm">{{ 'reset.confirm_password'|trans }}</label>
                                <input class="form-input" id="reset-confirm" type="password" name="password_confirm"
                                       required minlength="8" autocomplete="new-password">
                            </div>
                            <button class="btn btn-primary" type="submit">{{ 'reset.submit'|trans }}</button>
                        </form>
                    {% endif %}

                    <div class="auth-links">
                        <p><a href="{{ path('app_login') }}">{{ 'login.submit'|trans }}</a></p>
                    </div>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
