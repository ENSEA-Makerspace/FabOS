{% extends 'base.html.twig' %}

{% block title %}{{ 'usage_vision.rights_title'|trans }} · FabOS{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260809-s100-visions' }}">{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'usage_vision.rights_title'|trans,
    description: 'usage_vision.rights_description'|trans,
    panel_title: 'usage_vision.prototype_title'|trans,
} %}
    {% block content %}
        <div class="blueprint-notice" role="note">
            {% include 'site/_state_chip.html.twig' with {label: 'usage_vision.prototype'|trans, signal: 'caution'} only %}
            <p>{{ 'usage_vision.prototype_notice'|trans }}</p>
            <a class="admin-action" href="{{ path('app_roadmap_usage_rights') }}">{{ 'usage_vision.read_plan'|trans }}</a>
        </div>

        <ol class="blueprint-steps" aria-label="{{ 'usage_vision.flow_label'|trans }}">
            {% for key in ['audience', 'rights', 'scope', 'quota', 'review'] %}
                <li><span>{{ loop.index }}</span>{{ ('usage_vision.step_' ~ key)|trans }}</li>
            {% endfor %}
        </ol>

        <div class="blueprint-layout">
            <div class="blueprint-main">
                <section class="blueprint-section">
                    <div class="blueprint-heading"><span>1</span><div><h2>{{ 'usage_vision.audience_title'|trans }}</h2><p>{{ 'usage_vision.audience_hint'|trans }}</p></div></div>
                    <div class="blueprint-options blueprint-options-audience">
                        <label class="blueprint-option"><input type="checkbox" checked><span><strong>{{ 'usage_vision.audience_authenticated'|trans }}</strong><small>authenticated</small></span></label>
                        {% for role in roleRows %}
                            {% set role_key = role.name|lower|replace({'role_': ''}) %}
                            {% if role_key not in ['admin', 'user'] %}
                                <label class="blueprint-option"><input type="checkbox"><span><strong>{{ role_key in ['staff', 'trainer'] ? ('usage_vision.audience_' ~ role_key)|trans : role.name|replace({'ROLE_': ''})|lower|title }}</strong><small>{{ role.name }}</small></span></label>
                            {% endif %}
                        {% endfor %}
                        <label class="blueprint-option"><input type="checkbox" checked disabled><span><strong>{{ 'usage_vision.audience_admin'|trans }}</strong><small>system recovery</small></span></label>
                        <label class="blueprint-option"><input type="checkbox"><span><strong>{{ 'usage_vision.audience_guest'|trans }}</strong><small>anonymous</small></span></label>
                    </div>
                    <p class="blueprint-footnote">{{ 'usage_vision.roles_found'|trans({'%count%': roleRows|length}) }}</p>
                    <div class="blueprint-callout is-caution">{{ 'usage_vision.guest_warning'|trans }}</div>
                </section>

                <section class="blueprint-section">
                    <div class="blueprint-heading"><span>2</span><div><h2>{{ 'usage_vision.capabilities_title'|trans }}</h2><p>{{ 'usage_vision.capabilities_hint'|trans }}</p></div></div>
                    {% include 'site/_usage_rights_matrix.html.twig' with {
                        capabilities: capabilities,
                        enabled: enabledCapabilities,
                        selected: enabledCapabilities,
                        id_prefix: 'vision-rights',
                    } only %}
                </section>

                <section class="blueprint-section">
                    <div class="blueprint-heading"><span>3</span><div><h2>{{ 'usage_vision.scope_title'|trans }}</h2><p>{{ 'usage_vision.scope_hint'|trans }}</p></div></div>
                    <fieldset class="blueprint-fieldset">
                        <legend>{{ 'usage_vision.venues'|trans }}</legend>
                        <div class="blueprint-options">
                            <label class="blueprint-option"><input type="radio" name="vision-venue" checked><span><strong>{{ 'usage_vision.all_venues'|trans }}</strong><small>{{ 'usage_vision.default_scope'|trans }}</small></span></label>
                            <label class="blueprint-option"><input type="radio" name="vision-venue"><span><strong>{{ 'usage_vision.example_north'|trans }}</strong><small>{{ 'usage_vision.future_entity'|trans }}</small></span></label>
                            <label class="blueprint-option"><input type="radio" name="vision-venue"><span><strong>{{ 'usage_vision.example_south'|trans }}</strong><small>{{ 'usage_vision.future_entity'|trans }}</small></span></label>
                        </div>
                    </fieldset>
                    <fieldset class="blueprint-fieldset">
                        <legend>{{ 'usage_vision.machine_categories'|trans }}</legend>
                        <div class="blueprint-category-list">
                            {% for category in categories %}
                                <label><input type="checkbox"><span>{% include 'site/_category_icon.html.twig' with {slug: category.slug} only %}{{ category.label ?: 'usage_vision.uncategorized'|trans }} <small>{{ category.count }}</small></span></label>
                            {% else %}
                                <p>{{ 'usage_vision.no_categories'|trans }}</p>
                            {% endfor %}
                        </div>
                    </fieldset>
                </section>

                <section class="blueprint-section">
                    <div class="blueprint-heading"><span>4</span><div><h2>{{ 'usage_vision.quota_title'|trans }}</h2><p>{{ 'usage_vision.quota_hint'|trans }}</p></div></div>
                    <div class="blueprint-options">
                        {% for profile in ['inherit', 'member', 'trainer', 'unrestricted'] %}
                            <label class="blueprint-option"><input type="radio" name="vision-quota" {{ profile == 'member' ? 'checked' : '' }}><span><strong>{{ ('usage_vision.quota_' ~ profile)|trans }}</strong><small>{{ ('usage_vision.quota_' ~ profile ~ '_hint')|trans }}</small></span></label>
                        {% endfor %}
                    </div>
                    <div class="blueprint-callout">{{ 'usage_vision.no_field_merge'|trans }}</div>
                </section>
            </div>

            <aside class="blueprint-preview">
                <div class="blueprint-preview-head"><span>5</span><div><h2>{{ 'usage_vision.review_title'|trans }}</h2><p>{{ 'usage_vision.review_hint'|trans }}</p><small class="blueprint-preview-note">{{ 'usage_vision.fixed_example'|trans }}</small></div></div>
                <dl class="blueprint-summary">
                    <div><dt>{{ 'usage_vision.summary_who'|trans }}</dt><dd>{{ 'usage_vision.summary_who_value'|trans }}</dd></div>
                    <div><dt>{{ 'usage_vision.summary_what'|trans }}</dt><dd>{{ 'usage_vision.summary_what_value'|trans }}</dd></div>
                    <div><dt>{{ 'usage_vision.summary_where'|trans }}</dt><dd>{{ 'usage_vision.all_venues'|trans }}</dd></div>
                    <div><dt>{{ 'usage_vision.summary_quota'|trans }}</dt><dd>{{ 'usage_vision.quota_member'|trans }}</dd></div>
                </dl>
                <div class="blueprint-decision">
                    {% include 'site/_state_chip.html.twig' with {label: 'usage_vision.allowed_example'|trans, signal: 'go'} only %}
                    <p>{{ 'usage_vision.allowed_reason'|trans }}</p>
                </div>
                <ol class="blueprint-rule-order">
                    {% for key in ['availability', 'audience', 'grant', 'safety', 'hard_rules', 'soft_quota', 'capacity'] %}
                        <li>{{ ('usage_vision.rule_' ~ key)|trans }}</li>
                    {% endfor %}
                </ol>
            </aside>
        </div>
    {% endblock %}
{% endembed %}
{% include 'site/_footer.html.twig' %}
{% endblock %}
