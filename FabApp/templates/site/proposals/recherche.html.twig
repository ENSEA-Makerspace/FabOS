{% extends 'site/base_public.html.twig' %}

{# PROPOSITION — la recherche, d'après `coordination/05-recherche.png`.
   Mêmes résultats que `/recherche` (`SiteSearch::groups()`, inchangé). Ce qui change :
   1. AVANT la saisie : des accès rapides (mes réservations, mes formations,
      événements, machines) au lieu de trois conseils sur la façon de chercher ;
   2. les types deviennent un FILTRE à un clic (`?type=`), « Tout » en premier ;
   3. les résultats en lignes, chacune avec le pictogramme de son type, et pour
      chaque groupe un « Voir tout » vers le catalogue déjà filtré par la saisie.
   🅿️ À la décision : retirer ce gabarit, son entrée, la branche du contrôleur et
   le bloc `recherche` de `proposals.css`. #}

{% block title %}Proposition — Recherche - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% include 'site/proposals/_banner.html.twig' %}
{% set icons = {destinations: 'compass', users: 'view', machines: 'tool', places: 'map', events: 'calendar', formations: 'ticket', badges: 'key', loans: 'box', materials: 'box', creations: 'image', lab_pages: 'open'} %}
{% set catalogues = {machines: 'app_machines', places: 'app_places', events: 'app_events', formations: 'app_formations', badges: 'app_badges', loans: 'app_loans', materials: 'app_materials', creations: 'app_creations'} %}
{% set type = app.request.query.get('type', '') %}
{% set shown = type ? groups|filter(g => g.key == type) : groups %}
<main id="main-content" tabindex="-1" class="main-content">
    <section class="machine-detail-section">
        <div class="container pp-search">
            <h1>Recherche</h1>
            <form class="pp-search-form" method="get">
                {% include 'site/_icon.html.twig' with { name: 'search' } only %}
                <label class="sr-only" for="pp-q">{{ 'common.search'|trans }}</label>
                <input id="pp-q" type="search" name="q" value="{{ query }}" placeholder="Une machine, un espace, une formation, un événement…" autofocus>
                {% if type %}<input type="hidden" name="type" value="{{ type }}">{% endif %}
            </form>

            {% if query == '' %}
                <h2 class="pp-search-h">Accès rapides</h2>
                <div class="pp-quick">
                    {% set quick = [] %}
                    {% if app.user %}{% set quick = quick|merge([{icon: 'calendar', title: 'search.dest.my_bookings'|trans, hint: 'Vos prochains créneaux', url: path('app_my_reservations')}]) %}{% endif %}
                    {% set quick = quick|merge([
                        {icon: 'tool', title: 'nav.machines'|trans, hint: 'Ce qui est libre, et ce qu’il faut pour s’en servir', url: path('app_machines')},
                        {icon: 'ticket', title: 'nav.trainings'|trans, hint: 'Pour obtenir un badge', url: path('app_formations')},
                        {icon: 'bell', title: 'nav.events'|trans, hint: 'Les prochains rendez-vous', url: path('app_events')},
                    ]) %}
                    {% for q in quick %}
                        <a class="pp-quick-tile" href="{{ q.url }}">
                            <span class="pp-quick-ic" aria-hidden="true">{% include 'site/_icon.html.twig' with { name: q.icon } only %}</span>
                            <b>{{ q.title }}</b><small>{{ q.hint }}</small>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <nav class="ml-cats pp-search-types" aria-label="Types">
                    <a class="ml-tile{{ type == '' ? ' is-on' : '' }}" href="?q={{ query|url_encode }}">Tout <span class="ml-tile-count">{{ totalResults }}</span></a>
                    {% for g in groups %}
                        <a class="ml-tile{{ type == g.key ? ' is-on' : '' }}" href="?q={{ query|url_encode }}&amp;type={{ g.key }}">{{ g.label_key|trans }} <span class="ml-tile-count">{{ g.items|length }}</span></a>
                    {% endfor %}
                </nav>
                {% if shown is empty %}
                    <p>Aucun résultat de ce type.</p>
                {% endif %}
                {% for g in shown %}
                    <section class="pp-rows pp-search-group">
                        <h2>
                            {% include 'site/_icon.html.twig' with { name: icons[g.key]|default('open') } only %}
                            {{ g.label_key|trans }} <small>{{ g.items|length }}</small>
                            {% if catalogues[g.key] is defined %}<a class="pp-search-all" href="{{ path(catalogues[g.key], {q: query}) }}">Voir tout ›</a>{% endif %}
                        </h2>
                        <ul>
                            {% for item in g.items|slice(0, type ? 50 : 5) %}
                                <li>
                                    <a class="pp-search-row" href="{{ item.url }}">
                                        <span class="pp-search-ic" aria-hidden="true">{% include 'site/_icon.html.twig' with { name: icons[g.key]|default('open') } only %}</span>
                                        <span class="pp-search-what"><b>{{ item.title }}</b>{% if item.description %}<small>{{ item.description }}</small>{% endif %}</span>
                                        <span class="pp-search-meta">{{ item.meta }}</span>
                                        <span class="pp-search-go" aria-hidden="true">›</span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                        {% if not type and g.items|length > 5 %}<p class="pp-rows-more"><a href="?q={{ query|url_encode }}&amp;type={{ g.key }}">Les {{ g.items|length }} résultats</a></p>{% endif %}
                    </section>
                {% endfor %}
            {% endif %}
        </div>
    </section>
</main>
{% endblock %}
