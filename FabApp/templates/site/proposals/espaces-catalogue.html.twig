{% extends 'site/base_public.html.twig' %}

{# PROPOSITION — catalogue des espaces, d'après `espaces/01-catalogue-espaces.png`.
   Mêmes données que `/places` (`PlaceCatalogue`), même coquille `_catalogue`,
   même carte `_catalogue_card`. Ce qui change :
   1. « Libre maintenant » en tête (ou, labo fermé, UNE ligne qui le dit et les
      premiers créneaux de la réouverture) — au lieu de « Labo fermé » répété sur
      chaque carte ;
   2. la carte dit QUAND (« Libre demain 09:00 ») même labo fermé ;
   3. le pied porte la capacité avec son pictogramme, et l'action devient un
      vrai bouton « Réserver ».
   🅿️ À la décision : retirer ce gabarit, son entrée dans `PageProposals` et le
   bloc `espaces-catalogue` de `proposals.css`. #}

{% block title %}Proposition — {{ 'nav.places'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% include 'site/proposals/_banner.html.twig' %}
{% set people_svg %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>{% endset %}
{# Le « quand » de chaque espace, calculé une fois (mêmes clés que `/places`). #}
{% set whenOf = {} %}
{% for c in cards %}
    {% if c.slot %}
        {% set label = c.slot.start|lab_date('Y-m-d') == 'now'|lab_date('Y-m-d')
            ? 'state.free_at'|trans({'%time%': c.slot.start|lab_date('H:i')})
            : 'state.free_on'|trans({'%day%': c.slot.start|lab_date('d/m'), '%time%': c.slot.start|lab_date('H:i')}) %}
    {% else %}
        {% set label = 'state.full'|trans %}
    {% endif %}
    {% set whenOf = whenOf|merge({('p' ~ c.place.id): label}) %}
{% endfor %}
{# Démo seulement : `?vue=ouvert` simule le labo ouvert, pour voir le bandeau la nuit. #}
{% set demoOpen = app.request.query.get('vue') == 'ouvert' %}
{% if demoOpen %}{% set venueOpenNow = true %}{% set cards = cards|map(c => c|merge({freeNow: true})) %}{% endif %}
{% set soonest = cards|filter(c => c.slot)|sort((a, b) => a.slot.start <=> b.slot.start) %}
{% embed 'site/_catalogue.html.twig' with {
    venue_context: venueContext,
    route: 'app_places',
    title: 'nav.places'|trans,
    search: search,
    total: totalCount,
    all: allCount,
    unit: 'espace',
    unit_plural: 'espaces',
    headline_count: freeCount,
    headline_label: 'state.available_now'|trans,
    empty_text: 'places.no_places'|trans,
} %}
    {% block before_grid %}
        {# Labo fermé : la ligne suffit, les cartes disent déjà QUAND — un bandeau de plus
           répéterait trois fois le même créneau. #}
        {% set featured = venueOpenNow ? cards|filter(c => c.freeNow) : [] %}
        <section class="pp-now" aria-labelledby="pp-now-title">
            {% if not venueOpenNow %}
                <p class="pp-closed"><a href="?vue=ouvert" style="margin-left:auto;order:2">Démo : voir labo ouvert</a>{% include 'site/_icon.html.twig' with { name: 'lock' } only %}
                    <span><b>{{ 'state.closed'|trans }}{% if venueClosureReason %} — {{ venueClosureReason }}{% endif %}.</b>
                    {% if soonest|length %}Réouverture : {{ whenOf['p' ~ (soonest|first).place.id]|lower }}.{% endif %}</span></p>
            {% endif %}
            {% if featured|length %}
                <div class="pp-now-head">
                    <h2 id="pp-now-title">Libre maintenant</h2>
                    <p>Réservable tout de suite.</p>
                </div>
                <div class="pp-now-list">
                    {% for entry in featured|slice(0, 3) %}
                        {% set p = entry.place %}
                        <article class="pp-hcard">
                            <div class="pp-hcard-media">{% include 'site/_icon.html.twig' with { name: 'map' } only %}</div>
                            <div>
                                <h3>{{ p.nom }}</h3>
                                <p class="pp-hcard-meta">
                                    {% if p.capacite %}<span>{{ people_svg }} {{ p.capacite }} {{ 'places.capacity_suffix'|trans }}</span>{% endif %}
                                    {% if p.localisation %}<span>{% include 'site/_icon.html.twig' with { name: 'pin' } only %} {{ p.localisation }}</span>{% endif %}
                                </p>
                                <p class="pp-hcard-when{{ entry.freeNow ? '' : ' is-later' }}">● {{ entry.freeNow ? 'state.free'|trans : whenOf['p' ~ p.id] }}</p>
                            </div>
                            <a class="btn btn-primary" href="{{ path('app_place_detail', {id: p.id}) }}#place-calendar">Réserver</a>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    {% endblock %}
    {% block cards %}
        {% for entry in cards %}
            {% set p = entry.place %}
            {% set blocked = entry.usageRight.enforced and not entry.usageRight.allowed %}
            <div class="pp-cta" style="display: contents">
            {% include 'site/_catalogue_card.html.twig' with {
                url: path('app_place_detail', {id: p.id}),
                title: p.nom,
                meta: p.localisation,
                state: entry.freeNow ? 'state.free'|trans : whenOf['p' ~ p.id],
                state_tone: entry.freeNow ? 'go' : 'wait',
                foot: blocked ? ('usage_rights.verdict.' ~ entry.usageRight.reason ~ '.label')|trans : (p.capacite ? p.capacite ~ ' ' ~ 'places.capacity_suffix'|trans : ''),
                foot_tone: blocked ? entry.usageRight.tone : 'muted',
                action: blocked ? 'machines.see'|trans : 'Réserver',
                fallback_icon: 'map',
            } only %}
            </div>
        {% endfor %}
    {% endblock %}
{% endembed %}
{% endblock %}
