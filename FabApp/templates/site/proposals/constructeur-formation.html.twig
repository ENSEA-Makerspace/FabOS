{% extends 'base.html.twig' %}

{#
   PROPOSITION `constructeur-formation` — le parcours d'une formation en UNE liste.

   Ce qui change par rapport à `/admin/formations/{id}/content`
   (admin-formation-content.html.twig) :
   - la checklist de publication reste EN TÊTE, telle quelle (`_commissioning`
     + `PublishChecklist`) ;
   - au lieu de neuf cartes repliées, dont deux listes séparées (sections d'un
     côté, quiz de l'autre), UN parcours ordonné dans l'ordre où l'apprenant le
     vit : chaque section suivie de SES quiz, puis les quiz de fin, la validation
     pratique, le badge. Une ligne = numéro, type, titre, état, un verbe vers la
     vraie page d'édition ;
   - à droite « Résultat après validation » : le badge délivré et ce qu'il ouvre
     (machines via `MachineBadgeRepository::machinesOpenedBy`, pièces via
     `PLACE_BADGE`) ;
   - aucun glisser-déposer (l'ordre se règle toujours par les flèches de la page
     réelle), aucun POST.
   Données : `TrainingBuilder::build()` (lecture seule). Styles : `pp-cf-*`.

   ⚠️ Dans `.admin-panel`, `style.css` repeint tout <span> en gris `!important` :
   le texte coloré ou gras ici est en <b>, <div> ou <p>, jamais en <span>.

   🅿️ À la décision : retirer ce gabarit, son entrée, la branche du contrôleur,
   `src/Design/TrainingBuilder.php` et `public/css/proposals-constructeur-formation.css`.
#}

{% block title %}Proposition — Construire une formation{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals-constructeur-formation.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'Formations',
} %}
    {% block content %}
        {% include 'site/proposals/_banner.html.twig' %}

        {% if builder is null %}
            <p class="pp-cf-empty">Aucune formation à montrer.</p>
        {% else %}
        {% set formation = builder.formation %}
        <div class="pp-cf">
            <nav class="pp-cf-choices" aria-label="Formations à comparer">
                {% for choice in builder.choices %}
                    <a class="pp-cf-choice{{ choice.current ? ' is-current' : '' }}"
                       href="?formation={{ choice.formation.id }}"{{ choice.current ? ' aria-current="page"' : '' }}>
                        {{ choice.formation.titre }} · {{ choice.sections }} {{ choice.sections > 1 ? 'sections' : 'section' }}
                    </a>
                {% endfor %}
            </nav>

            <h2 class="pp-cf-name">{{ formation.titre }}</h2>

            {% include 'site/_commissioning.html.twig' with {
                steps: builder.publishSteps, label_ns: 'formation_content.pub_', title: 'formation_content.pub_title',
            } only %}

            <div class="pp-cf-grid">
                <section class="detail-card pp-cf-journey" aria-labelledby="pp-cf-journey-title">
                    <h3 id="pp-cf-journey-title">Parcours de formation</h3>
                    <ol class="pp-cf-steps">
                        {% set n = 0 %}
                        {% for step in builder.steps %}
                            {% set n = n + 1 %}
                            <li class="pp-cf-step is-{{ step.kind }}{{ step.nested ? ' is-nested' : '' }}">
                                <b class="pp-cf-num">{{ n }}</b>
                                <div class="pp-cf-ico">{% include 'site/_icon.html.twig' with { name: step.icon } only %}</div>
                                <div class="pp-cf-what">
                                    <p class="pp-cf-type">{{ step.typeLabel }}</p>
                                    <b class="pp-cf-title">{{ step.title }}</b>
                                    {% if step.meta %}<p class="pp-cf-meta">{{ step.meta }}</p>{% endif %}
                                </div>
                                <div class="pp-cf-state">{% include 'site/_state_chip.html.twig' with { label: step.state.label, signal: step.state.signal } only %}</div>
                                <a class="pp-cf-verb" href="{{ path(step.route, step.params) }}">{{ step.verb }}</a>
                            </li>
                        {% endfor %}
                    </ol>
                    <p class="pp-cf-add">
                        <a href="{{ path('app_admin_formation_section_new', {id: formation.id}) }}">Ajouter une section</a>
                        · <a href="{{ path('app_admin_formation_quiz_new', {id: formation.id}) }}">Ajouter un quiz</a>
                        · <a href="{{ path('app_admin_formation_content', {id: formation.id}) }}">Tous les réglages de la formation</a>
                    </p>
                </section>

                <aside class="detail-card pp-cf-result" aria-labelledby="pp-cf-result-title">
                    <h3 id="pp-cf-result-title">Résultat après validation</h3>
                    {% set result = builder.result %}
                    {% if result.badge is null %}
                        <p class="pp-cf-meta">Cette formation ne délivre aucun badge : elle n’ouvre rien. C’est normal pour un cours d’information.</p>
                    {% else %}
                        <div class="pp-cf-fact">
                            <div class="pp-cf-ico">{% include 'site/_icon.html.twig' with { name: 'key' } only %}</div>
                            <div><p class="pp-cf-type">Badge délivré</p><b>{{ result.badge.nom }}</b></div>
                        </div>
                        <div class="pp-cf-fact">
                            <div class="pp-cf-ico">{% include 'site/_icon.html.twig' with { name: 'tool' } only %}</div>
                            <div>
                                <p class="pp-cf-type">Machines ouvertes</p>
                                {% if result.machines is empty %}
                                    <p class="pp-cf-meta">Aucune pour l’instant.</p>
                                {% else %}
                                    <ul class="pp-cf-list">{% for machine in result.machines %}<li><a href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ machine.nom }}</a></li>{% endfor %}</ul>
                                {% endif %}
                            </div>
                        </div>
                        <div class="pp-cf-fact">
                            <div class="pp-cf-ico">{% include 'site/_icon.html.twig' with { name: 'lock' } only %}</div>
                            <div>
                                <p class="pp-cf-type">Pièces ouvertes</p>
                                {% if result.places is empty %}
                                    <p class="pp-cf-meta">Aucune pour l’instant.</p>
                                {% else %}
                                    <ul class="pp-cf-list">{% for place in result.places %}<li><a href="{{ path('app_admin_place_edit', {id: place.id}) }}">{{ place.nom }}</a></li>{% endfor %}</ul>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </aside>
            </div>
        </div>
        {% endif %}
    {% endblock %}
{% endembed %}
{% endblock %}
