{#
   Le bandeau de TOUTE proposition : on ne doit jamais la confondre avec le
   produit. Il dit ce que c'est, renvoie à la planche et à la page actuelle, et
   liste ce qu'on prend de la planche et ce qu'on garde de chez nous.
   Styles : `proposals.css` (préfixe `pp-`), chargé ici pour que chaque
   proposition n'ait rien à se rappeler.
#}
<link rel="stylesheet" href="{{ asset('css/proposals.css') ~ '?v=' ~ css_version }}">
<aside class="pp-banner" aria-label="Proposition">
    <div class="pp-banner-in">
        <p class="pp-banner-kicker">Proposition · pas un écran réel · rien n’est enregistré</p>
        <h1 class="pp-banner-title">{{ proposal.title }}</h1>
        <p class="pp-banner-links">
            <a href="{{ asset('images/references/' ~ proposal.planche) }}" target="_blank" rel="noopener">Voir la planche</a>
            · <a href="{{ path(proposal.current.route, proposal.current.params) }}">Page actuelle ({{ proposal.current.label }})</a>
            · <a href="{{ path('app_admin_proposals') }}">Toutes les propositions</a>
        </p>
        <div class="pp-banner-cols">
            <div>
                <h2>Pris de la planche</h2>
                <ul>{% for line in proposal.take %}<li>{{ line }}</li>{% endfor %}</ul>
            </div>
            <div>
                <h2>Gardé de chez nous</h2>
                <ul>{% for line in proposal.keep %}<li>{{ line }}</li>{% endfor %}</ul>
            </div>
        </div>
    </div>
</aside>
