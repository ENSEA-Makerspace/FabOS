{% extends 'base.html.twig' %}

{#
   PROPOSITION `annuaire-utilisateurs` — l'annuaire qui dit QUOI TRAITER.

   Ce qui change par rapport à `/admin/utilisateurs` (admin-utilisateurs.html.twig) :
   - la rangée de tuiles ne trie plus par état brut (Tous / Actif / Inactif /
     Pending) mais par TRAVAIL, chacune avec son compteur : « À valider »,
     « Suspendus ou inactifs », « Expire bientôt » (une appartenance de groupe
     qui prend fin dans 30 jours) et « Sans badge » (compte actif sans badge
     enregistré) ;
   - la colonne « Progressions » (un entier) devient « Formations » en « 3 / 4 »
     avec sa jauge (`_cell_meter`), contre les formations visibles du lab ;
   - le compteur brut de passages RFID cède la place à « Dernière activité » :
     le plus récent de la dernière connexion et du dernier passage de badge,
     avec laquelle des deux c'était ;
   - le verbe dit la tâche : « Examiner » pour une ligne qui demande une
     décision (en attente, suspendue, adresse non confirmée, échéance proche),
     « Ouvrir » sinon — même fiche `app_admin_user_detail` dans les deux cas.
   Gardés : la coquille `_admin_list`, la recherche, `_data_table`, `_cell_title`,
   `_cell_state`, `_cell_actions`. Les filtres Groupe / Forfait de la page réelle
   ne sont pas rejoués ici (ils ne changent pas).
   Lit `?tuile=<valider|suspendus|expire|sans-badge>` et `?q=` (lecture seule).
   Données : `AdminUserDirectory::build()`.

   ⚠️ Un commentaire Twig entre deux clés d'un hash d'arguments est une erreur
   de syntaxe : celui-ci reste hors des `with { … }`.

   🅿️ À la décision : retirer ce gabarit, son entrée, la branche du contrôleur,
   `src/Design/AdminUserDirectory.php` et `public/css/proposals-annuaire-utilisateurs.css`.
#}

{% block title %}Proposition — Annuaire des utilisateurs{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals-annuaire-utilisateurs.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'admin_users.action_label'|trans,
    action_route: 'app_admin_user_new',
    panel_title: 'admin_users.panel_title'|trans,
    list_count: directory.shown,
    list_total: directory.total,
    list_route: 'app_admin_proposal',
    list_route_params: {slug: proposal.slug},
    list_search: directory.q,
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_query: {tuile: directory.tile},
    list_tiles_label: 'À traiter',
    list_tiles: directory.tiles,
} %}
    {% block content %}
        {% include 'site/proposals/_banner.html.twig' %}

        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'Utilisateur', class: 'is-grow'},
                {label: 'Statut', class: 'is-tight'},
                {label: 'Formations', class: 'is-tight'},
                {label: 'Dernière activité', class: 'is-tight'},
                {label: 'Action', class: 'is-actions'},
            ],
            rows: directory.rows,
            empty: 'Aucun utilisateur dans cette tuile.',
        } %}
            {% block rows %}
                {% for row in directory.rows %}
                    <tr>
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: row.name,
                            href: path('app_admin_user_detail', {id: row.id}),
                            subtitle: row.email,
                            media: include('site/_cell_media.html.twig', {
                                initials: row.initials,
                                shape: 'circle',
                            }, with_context = false),
                        } only %}</td>
                        <td>
                            {% include 'site/_cell_state.html.twig' with { label: row.statusKey|trans, signal: row.signal } only %}
                            {% if row.note %}
                                <div class="pp-au-note">
                                    {{ row.note }}{% if row.until %} · jusqu’au {{ row.until|date('d/m/Y') }}{% endif %}
                                </div>
                            {% endif %}
                        </td>
                        <td>{% include 'site/_cell_meter.html.twig' with {
                            value: row.trainingsDone,
                            max: directory.formationsTotal,
                            signal: directory.formationsTotal > 0 and row.trainingsDone >= directory.formationsTotal ? 'go' : '',
                            label: row.hasBadge ? 'Badge enregistré' : 'Sans badge',
                        } only %}</td>
                        <td>
                            {% if row.last %}
                                <div class="pp-au-last">{{ row.last|lab_date('d/m/Y H:i') }}</div>
                                <div class="pp-au-note">{{ row.lastKind }}</div>
                            {% else %}
                                {% include 'site/_cell_empty.html.twig' with { reason: 'Aucune activité' } only %}
                            {% endif %}
                        </td>
                        <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                            actions: [{
                                label: row.examine ? 'Examiner' : 'Ouvrir',
                                icon: row.examine ? 'view' : 'open',
                                href: path('app_admin_user_detail', {id: row.id}),
                                tone: row.examine ? 'primary' : 'default',
                            }],
                        } only %}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
