{% extends 'site/base_public.html.twig' %}

{# PROPOSITION — « Mes formations », d'après `formations/lms-my-trainings.png`
   (et l'idée du verbe par état de `lms-training-catalogue.png`).
   Aujourd'hui la progression d'un membre vit dans un tableau de `/profil#stats`,
   entre deux graphiques. Ici, une page à soi :
   1. « À reprendre » — la formation la plus avancée, ses étapes (`LearnerJourney`,
      S179) et LE verbe de l'étape suivante (les libellés `fdet.next_*` existants) ;
   2. « En cours » — une ligne par formation : étape suivante, quiz validés, verbe ;
   3. « Terminées » — le badge obtenu, à un clic.
   🅿️ À la décision : retirer ce gabarit, son entrée, la branche du contrôleur,
   `MyTrainings` (s'il ne sert pas la vraie page) et le bloc `mes-formations` de
   `proposals.css`. #}

{% block title %}Proposition — Mes formations - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% include 'site/proposals/_banner.html.twig' %}
<main id="main-content" tabindex="-1" class="main-content">
    <section class="machine-detail-section">
        <div class="container pp-home">
            <header class="pp-resv-head">
                <h1>Mes formations</h1>
                <a class="btn btn-secondary" href="{{ path('app_formations') }}">Découvrir d’autres formations</a>
            </header>

            {% if trainings is null %}
                <p>Cette proposition se regarde avec un compte membre : <a href="?membre=45">voir avec alice</a>.</p>
            {% elseif not trainings.resume and trainings.done is empty %}
                <section class="detail-card">
                    <p>Vous n’avez encore commencé aucune formation. C’est par là qu’on obtient un badge, et le badge ouvre les machines.</p>
                    <a class="btn btn-primary" href="{{ path('app_formations') }}">{{ 'machine.see_trainings'|trans }}</a>
                </section>
            {% else %}
                {% if trainings.resume %}
                    {% set t = trainings.resume %}
                    <section class="detail-card pp-tr-resume" aria-labelledby="pp-tr-resume-title">
                        <p class="md-kicker">À reprendre</p>
                        <div class="pp-tr-resume-in">
                            <div>
                                <h2 id="pp-tr-resume-title" class="pp-next-title"><a href="{{ path('app_formation_detail', {id: t.formation.id}) }}">{{ t.formation.titre }}</a></h2>
                                <ol class="pp-steps">
                                    {% for step in t.journey.steps %}
                                        <li class="{{ step.done ? 'is-done' : (step.key == t.journey.next ? 'is-next' : '') }}">
                                            <span class="pp-steps-mark" aria-hidden="true">{{ step.done ? '✓' : loop.index }}</span>
                                            <b>{{ ('fdet.step_' ~ step.key)|trans }}</b>
                                            <small>{{ step.done ? 'Fait' : (step.key == t.journey.next ? 'Étape suivante' : (step.blocking ? 'Attend l’équipe' : 'À venir')) }}</small>
                                        </li>
                                    {% endfor %}
                                </ol>
                            </div>
                            <div class="pp-tr-resume-side">
                                {% if t.journey.next %}
                                    <a class="btn btn-primary" href="{{ path('app_formation_follow', {id: t.formation.id}) }}">{{ ('fdet.next_' ~ t.journey.next)|trans }}</a>
                                {% endif %}
                                {% if t.journey.badge %}
                                    <p class="pp-tr-badge">{% include 'site/_icon.html.twig' with { name: 'key' } only %} Badge : <a href="{{ path('app_badge_detail', {id: t.journey.badge.id}) }}">{{ t.journey.badge.nom }}</a></p>
                                {% endif %}
                            </div>
                        </div>
                    </section>
                {% endif %}

                {% for group in [
                    {title: 'En cours', rows: trainings.ongoing, done: false},
                    {title: 'Terminées', rows: trainings.done, done: true},
                ] %}
                    {% if group.rows|length %}
                        <section class="pp-rows{{ group.done ? ' is-past' : '' }}">
                            <h2>{{ group.title }}</h2>
                            <ul>
                                {% for t in group.rows %}
                                    <li class="pp-tr-row">
                                        <span class="pp-row-what"><a href="{{ path('app_formation_detail', {id: t.formation.id}) }}">{{ t.formation.titre }}</a></span>
                                        <span class="pp-row-motif">{{ group.done ? 'Formation terminée' : (t.journey.next ? ('fdet.step_' ~ t.journey.next)|trans : '—') }}</span>
                                        <span class="pp-row-motif">{% if t.journey.quizTotal %}{{ t.journey.quizValidated }}/{{ t.journey.quizTotal }} quiz validés{% else %}{{ t.journey.percent }} %{% endif %}</span>
                                        {% if group.done and t.journey.badge %}
                                            <a class="pp-row-go" href="{{ path('app_badge_detail', {id: t.journey.badge.id}) }}">Voir le badge</a>
                                        {% else %}
                                            <a class="pp-row-go" href="{{ path('app_formation_follow', {id: t.formation.id}) }}">{{ t.journey.next ? ('fdet.next_' ~ t.journey.next)|trans : 'Voir' }}</a>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endif %}
                {% endfor %}
            {% endif %}
        </div>
    </section>
</main>
{% endblock %}
