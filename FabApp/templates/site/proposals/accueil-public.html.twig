{% extends 'site/base_public.html.twig' %}

{# PROPOSITION — l'accueil d'un VISITEUR anonyme, d'après `01-accueil-configurable.png`.
   (Pas l'accueil d'un membre : voir `accueil-membre`. Ici `$user` est ignoré.)
   Aujourd'hui l'accueil est une grande image, un titre, un carrousel d'événements,
   les horaires de la semaine, puis « Comment ça fonctionne ? ». Ici, l'ordre d'un
   visiteur qui se demande « puis-je venir, et que puis-je faire ? » :
   1. le titre et UNE pastille d'état du jour (« Ouvert aujourd'hui 9:00–18:30 »
      / « Fermé — rouvre lundi 9:00 ») ;
   2. « Espaces » puis « Équipements » : 4 cartes max chacun, leur état du jour
      (« Libre maintenant », « Libre à 14:00 », « Libre demain 09:00 »), « Voir tout » ;
   3. les prochains événements, puis « Comment ça fonctionne ? ».
   Mêmes calculs que `/places` et `/machines` (`PublicHome`, user = null) ; mêmes
   cartes (`_catalogue_card`). La configuration par blocs/rôles (`/admin/homepage`,
   `HomepageVisibilityService`) reste celle de la vraie page : non reproduite ici.
   🅿️ À la décision : retirer ce gabarit, `public/css/proposals-accueil-public.css`,
   son entrée de registre, la branche du contrôleur et `src/Design/PublicHome.php`. #}

{% block title %}Proposition — Accueil public - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals-accueil-public.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% include 'site/proposals/_banner.html.twig' %}
<main id="main-content" tabindex="-1" class="main-content">
    <section class="machine-detail-section">
        <div class="container pp-ap">

            <header class="pp-ap-hero">
                <div class="pp-ap-hero-text">
                    <p class="pp-ap-today pp-ap-today--{{ today.openNow ? 'go' : (today.open ? 'wait' : 'muted') }}">
                        <b><span class="pp-ap-dot" aria-hidden="true"></span>{{ today.open ? today.label : today.label ~ (today.reason ? ' — ' ~ today.reason : '') }}</b>
                        {% if today.hours %}<i>{{ today.open ? today.hours : '— ' ~ today.hours }}</i>{% endif %}
                    </p>
                    <h1>{{ venue_label() }} {{ org_name() }}</h1>
                    <p class="pp-ap-tagline">{{ 'home.tagline'|trans({'%venue%': venue_label()}) }}</p>
                    <p>
                        <a class="btn btn-primary" href="{{ path('app_places') }}">Découvrir nos espaces</a>
                        <a class="btn btn-secondary" href="{{ path('app_register') }}">Créer un compte</a>
                    </p>
                </div>
                <div class="pp-ap-hero-art">
                    <img src="{{ asset('images/hero-bg.jpg') }}" alt="{{ venue_label() }} {{ org_name() }}" loading="lazy" decoding="async">
                </div>
            </header>

            {% if places is not null %}
                <section class="pp-ap-row" aria-labelledby="pp-ap-places">
                    <div class="pp-ap-row-head">
                        <h2 id="pp-ap-places">Espaces</h2>
                        <a href="{{ path('app_places') }}">Voir tout{% if places.total > places.cards|length %} ({{ places.total }}){% endif %}</a>
                    </div>
                    {% if places.cards is empty %}
                        <p class="pp-ap-empty">Aucun espace à réserver pour le moment.</p>
                    {% else %}
                        <div class="ml-grid">
                            {% for c in places.cards %}
                                {% include 'site/_catalogue_card.html.twig' with {
                                    url: path('app_place_detail', {id: c.place.id}),
                                    title: c.place.nom,
                                    meta: c.place.localisation,
                                    state: c.state,
                                    state_tone: c.tone,
                                    foot: c.place.capacite ? c.place.capacite ~ ' ' ~ 'places.capacity_suffix'|trans : '',
                                    foot_tone: 'muted',
                                    action: 'machines.see'|trans,
                                    fallback_icon: 'map',
                                } only %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>
            {% endif %}

            {% if machines is not null %}
                <section class="pp-ap-row" aria-labelledby="pp-ap-machines">
                    <div class="pp-ap-row-head">
                        <h2 id="pp-ap-machines">Équipements</h2>
                        <a href="{{ path('app_machines') }}">Voir tout{% if machines.total > machines.cards|length %} ({{ machines.total }}){% endif %}</a>
                    </div>
                    {% if machines.cards is empty %}
                        <p class="pp-ap-empty">Aucun équipement à réserver pour le moment.</p>
                    {% else %}
                        <div class="ml-grid">
                            {% for c in machines.cards %}
                                {% include 'site/_catalogue_card.html.twig' with {
                                    url: path('app_machine_detail', {id: c.machine.id}),
                                    title: c.machine.nom,
                                    type: c.machine.categoryLabel,
                                    meta: c.machine.localisation,
                                    state: c.state,
                                    state_tone: c.tone,
                                    action: 'machines.see'|trans,
                                    icon_slug: c.machine.categorySlug,
                                    photo: c.machine.photo,
                                } only %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>
            {% endif %}

            <section class="pp-ap-row" aria-labelledby="pp-ap-events">
                <div class="pp-ap-row-head">
                    <h2 id="pp-ap-events">{{ 'nav.events'|trans }}</h2>
                    <a href="{{ path('app_events') }}">{{ 'events.see_all'|trans }}</a>
                </div>
                {% if events is empty %}
                    <p class="pp-ap-empty">{{ 'home.events_empty_title'|trans }}</p>
                {% else %}
                    <div class="ml-grid">
                        {% for e in events %}
                            {% include 'site/_catalogue_card.html.twig' with {
                                url: path('app_event_detail', {id: e.event.id}),
                                title: e.event.titre,
                                meta: e.event.dateDebut|loc_date('EEEE d MMMM') ~ ' · ' ~ e.event.dateDebut|date('H:i'),
                                note: e.event.lieu|default(''),
                                photo: e.thumb,
                                placeholder_seed: e.event.id,
                                action: 'machines.see'|trans,
                            } only %}
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            <section class="pp-ap-row" aria-labelledby="pp-ap-how">
                <div class="pp-ap-row-head"><h2 id="pp-ap-how">{{ 'home.how_it_works'|trans }}</h2></div>
                <ol class="pp-ap-steps">
                    {% for step in [
                        {n: 1, icon: 'key', url: path('app_register')},
                        {n: 2, icon: 'check', url: feature_enabled('formations') ? path('app_formations') : ''},
                        {n: 3, icon: 'calendar', url: has_calendar_layer() ? path('app_calendar') : ''},
                        {n: 4, icon: 'bolt', url: ''},
                    ] %}
                        <li class="detail-card pp-ap-step">
                            <span class="pp-ap-step-ic" aria-hidden="true">{% include 'site/_icon.html.twig' with { name: step.icon } only %}</span>
                            <div>
                                <h3>{% if step.url %}<a href="{{ step.url }}">{{ ('home.step' ~ step.n ~ '_title')|trans }}</a>{% else %}{{ ('home.step' ~ step.n ~ '_title')|trans }}{% endif %}</h3>
                                <p>{{ ('home.step' ~ step.n ~ '_desc')|trans }}</p>
                            </div>
                        </li>
                    {% endfor %}
                </ol>
            </section>
        </div>
    </section>
</main>
{% endblock %}
