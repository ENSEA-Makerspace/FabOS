{% extends 'base.html.twig' %}

{#
   PROPOSITION `rapports` — un rapport qui CONDUIT quelque part au lieu de décrire.

   Ce qui change par rapport à `/admin/reporting/{workspace}` (admin-reporting.html.twig) :
   - EN TÊTE « À retenir » : au plus trois constats courts tirés des mêmes chiffres
     (concentration sur une ressource, annulations, variation vs la période
     précédente, ressources jamais réservées), chacun avec UN verbe vers la fiche
     ou la liste où l'on agit. Les règles sont dans `ReportingBrief` ;
   - chaque ligne du classement ouvre la fiche de la machine ou de l'espace ;
     la part des réservations remplace la colonne de minutes brutes ;
   - la période se choisit en trois tuiles (7 / 30 / 90 jours) au lieu de deux
     champs date ; la période précédente de même durée sert à la comparaison ;
   - le tableau jour par jour ne figure pas ici (il reste sur la page réelle,
     avec les dates libres et l'export CSV) ; aucun graphique inventé.
   Données : `ReportingBrief::build()` → mêmes adaptateurs que la page actuelle.
   Lit `?espace=equipment|spaces` (défaut equipment) et `?jours=7|30|90` (défaut 30).

   ⚠️ Dans `.admin-panel`, `style.css` repeint tout <span> en gris `!important` :
   le texte coloré ou gras ici est en <b>, <p> ou <div>, jamais en <span>.

   🅿️ À la décision : retirer ce gabarit, son entrée, la branche du contrôleur,
   `ReportingBrief` et `proposals-rapports.css`.
#}

{% block title %}Proposition — Rapports{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals-rapports.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'Rapports',
    list_route: 'app_admin_proposal',
    list_route_params: {slug: proposal.slug},
    list_query: {espace: brief.workspace, jours: brief.days},
    list_tiles_label: 'Période',
    list_tiles: brief.periods,
} %}
    {% block header_extra %}
        <a class="admin-hero-action" href="{{ path('app_admin_reporting_export', {workspace: brief.workspace, from: brief.from|date('Y-m-d'), to: brief.until|date('Y-m-d')}) }}">Exporter en CSV</a>
    {% endblock %}
    {% block content %}
        {% include 'site/proposals/_banner.html.twig' %}

        <div class="pp-rp">
            <p class="pp-rp-switch">
                {% for key, label in {equipment: 'Machines', spaces: 'Espaces'} %}
                    {% if key == brief.workspace %}<b>{{ label }}</b>{% else %}<a href="{{ path('app_admin_proposal', {slug: proposal.slug, espace: key, jours: brief.days}) }}">{{ label }}</a>{% endif %}
                {% endfor %}
                <span>du {{ brief.from|date('d/m/Y') }} au {{ brief.until|date('d/m/Y') }}</span>
            </p>

            <section class="pp-rp-head" aria-labelledby="pp-rp-retenir">
                <h2 class="pp-rp-title" id="pp-rp-retenir">À retenir</h2>
                {% if brief.findings is not empty %}
                    <ul class="pp-rp-finds">
                        {% for f in brief.findings %}
                            <li class="pp-rp-find">
                                <div>{% include 'site/_icon.html.twig' with { name: f.icon } only %}</div>
                                <p class="pp-rp-find-text">{{ f.text }}</p>
                                <p class="pp-rp-find-hint">{{ f.hint }}</p>
                                <a class="pp-rp-find-verb" href="{{ path(f.route, f.params) }}">{{ f.verb }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="pp-rp-calm">Rien à signaler sur cette période.</p>
                {% endif %}
            </section>

            <div class="workspace-summary">
                <article><strong>{{ brief.summary.total }}</strong><span>Réservations{% if brief.summary.trend is not null %} ({{ brief.summary.trend > 0 ? '+' : '' }}{{ brief.summary.trend }} % vs période précédente){% endif %}</span></article>
                <article><strong>{{ brief.summary.users }}</strong><span>Utilisateurs distincts</span></article>
                <article><strong>{{ brief.summary.hours|number_format(1, ',', ' ') }} h</strong><span>Durée réservée</span></article>
                <article><strong>{{ brief.summary.cancelled }}</strong><span>Annulées</span></article>
            </div>

            <section aria-labelledby="pp-rp-top">
                <h2 class="pp-rp-title" id="pp-rp-top">{{ brief.topLabel }}</h2>
                {% embed 'site/_data_table.html.twig' with {
                    columns: [
                        {label: 'Ressource', class: 'is-grow'},
                        {label: 'Réservations', numeric: true},
                        {label: 'Part', numeric: true},
                        {label: 'Heures', numeric: true},
                    ],
                    rows: brief.top,
                    empty: 'Aucune donnée sur cette période.',
                } %}
                    {% block rows %}
                        {% for row in brief.top %}
                            <tr>
                                <td><a class="pp-rp-name" href="{{ path(row.route, row.params) }}">{{ row.label }}</a></td>
                                <td class="is-numeric">{{ row.total }}</td>
                                <td class="is-numeric">{{ row.share }} %</td>
                                <td class="is-numeric">{{ row.hours|number_format(1, ',', ' ') }}</td>
                            </tr>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            </section>

            {% if brief.idle is not empty %}
                <p class="pp-rp-idle">
                    <b>Sans réservation sur la période</b> :
                    {% for r in brief.idle %}<a href="{{ path(r.route, {id: r.id}) }}">{{ r.label }}</a>{{ not loop.last ? ' · ' : '' }}{% endfor %}
                </p>
            {% endif %}

            <p class="pp-rp-idle">
                Dates libres, activité jour par jour : <a href="{{ path('app_admin_reporting', {workspace: brief.workspace}) }}">rapport complet</a>.
            </p>
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
