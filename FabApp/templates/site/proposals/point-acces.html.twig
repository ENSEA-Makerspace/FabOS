{% extends 'base.html.twig' %}

{#
   PROPOSITION `point-acces` — une FICHE de porte, l'état d'abord.

   Ce qui change par rapport à `/admin/access-points/{id}/edit`
   (admin-access-point-form.html.twig : un formulaire, aucun parcours de mise en
   service ; la liste ne dit que « sans lecteur ») :
   - EN TÊTE l'état : « En service » / « À mettre en service » ;
   - tant que ce n'est pas fini, la liste des étapes réelles monte juste sous
     l'en-tête : pièce reliée, lecteur relié et en ligne, badge exigé par la
     pièce, horaires de la pièce, premier passage ; l'étape BLOQUANTE est dite
     en clair. Les étapes facultatives (badge, horaires sans badge) ne
     retardent pas le « En service » ;
   - « Ce que fait cette porte » : la règle effective en une phrase
     (réservation ±15 min, ou badge seul pendant les heures) ;
   - les 5 derniers passages / refus des lecteurs de cette porte, avec un lien
     vers le journal ;
   - le formulaire d'édition n'est plus qu'un lien « Modifier les réglages ».
   - Aucun secret ni jeton affiché. Le secret « affiché une fois » de la planche
     concerne le LECTEUR : il reste sur sa propre page.
   - La liste d'étapes reprend les classes `commissioning__*` du composant
     `_commissioning` (ses libellés viennent de clés de traduction `rfid_form.*`,
     faites pour les lecteurs : ici les étapes sont celles d'une porte).
   Données : `DoorSheet::build()` (lecture seule). `?porte=<id>` choisit la porte
   (défaut : la première non archivée). Styles : `pp-pa-*`.

   ⚠️ Dans `.admin-panel`, `style.css` repeint tout <span> en gris `!important` :
   texte coloré ou gras ici en <b>, <div>, <p>, jamais en <span>.

   🅿️ À la décision : retirer ce gabarit, son entrée, la branche du contrôleur,
   `src/Design/DoorSheet.php` et `public/css/proposals-point-acces.css`.
#}

{% block title %}Proposition — Fiche d’un point d’accès{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals-point-acces.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'Points d’accès',
} %}
    {% block content %}
        {% include 'site/proposals/_banner.html.twig' %}

        <div class="pp-pa">
            {% if door.point is null %}
                <p class="pp-pa-empty">Aucun point d’accès n’est déclaré : rien à montrer.</p>
            {% else %}
                {% set point = door.point %}

                <nav class="pp-pa-switch" aria-label="Autres portes">
                    <b>Comparer :</b>
                    {% for o in door.others %}
                        <a href="?porte={{ o.point.id }}"{% if o.current %} class="is-current" aria-current="page"{% endif %}>
                            {% include 'site/_state_chip.html.twig' with { label: o.point.nom, signal: o.signal } only %}
                        </a>
                    {% endfor %}
                </nav>

                <header class="pp-pa-head">
                    <div>
                        <h2 class="pp-pa-state is-{{ door.signal }}">
                            {% include 'site/_icon.html.twig' with { name: door.inService ? 'check' : (door.signal == 'stop' ? 'warning' : 'hourglass') } only %}
                            <b>{{ door.headline }}</b>
                        </h2>
                        <p class="pp-pa-sub">
                            {{ point.nom }}
                            {% if point.place %} · {{ point.place.nom }}{% endif %}
                            {% if point.localisation %} · {{ point.localisation }}{% endif %}
                        </p>
                    </div>
                    <div class="pp-pa-edit">
                        <a href="{{ path('app_admin_access_point_edit', {id: point.id}) }}">Modifier les réglages</a>
                    </div>
                </header>

                {% if not door.inService %}
                    {% if door.blocking %}
                        <p class="pp-pa-block"><b>À faire d’abord : {{ door.blocking.label }}.</b> {{ door.blocking.note }}</p>
                    {% endif %}
                    <section class="commissioning" aria-labelledby="pp-pa-steps">
                        <h3 class="commissioning__title" id="pp-pa-steps">Mise en service</h3>
                        <ol class="commissioning__list">
                            {% for step in door.steps %}
                                <li class="commissioning__step{{ step.done ? ' is-done' : (step.blocking ? ' is-blocking' : '') }}">
                                    <span class="commissioning__mark" aria-hidden="true">{{ step.done ? '✓' : '•' }}</span>
                                    <span class="commissioning__body">
                                        <span class="sr-only">{{ step.done ? 'Fait' : 'À faire' }} — </span>
                                        <b>{{ step.label }}{% if step.optional and not step.done %} (facultatif){% endif %}</b>
                                        <span class="commissioning__note">{{ step.note }}</span>
                                    </span>
                                </li>
                            {% endfor %}
                        </ol>
                    </section>
                {% endif %}

                <section class="pp-pa-card" aria-labelledby="pp-pa-rule">
                    <h2 id="pp-pa-rule">Ce que fait cette porte</h2>
                    <p class="pp-pa-rule">{{ door.rule }}</p>
                    {% if door.hoursToday %}
                        <p class="pp-pa-sub">Heures d’ouverture de la pièce aujourd’hui : {{ door.hoursToday }}.</p>
                    {% endif %}
                </section>

                <div class="pp-pa-grid">
                    <section class="pp-pa-card" aria-labelledby="pp-pa-events">
                        <h2 id="pp-pa-events">Derniers passages</h2>
                        {% if door.events %}
                            <ul class="pp-pa-events">
                                {% for e in door.events %}
                                    <li>
                                        <div>
                                            <b class="{{ e.authorized ? 'is-ok' : 'is-refused' }}">{{ e.outcome }}</b>
                                            <small>{{ e.who }}{% if e.detail %} · {{ e.detail }}{% endif %}</small>
                                        </div>
                                        <div>{{ e.at|lab_date('d/m H:i') }}</div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="pp-pa-empty">Aucun passage enregistré sur cette porte.</p>
                        {% endif %}
                        {% for row in door.readers %}
                            {% if loop.first %}<p class="pp-pa-sub"><a href="{{ path('app_admin_access_rfid_logs', {reader: row.reader.id, days: 0}) }}">Voir tout le journal de ce lecteur</a></p>{% endif %}
                        {% endfor %}
                    </section>

                    <section class="pp-pa-card" aria-labelledby="pp-pa-readers">
                        <h2 id="pp-pa-readers">Lecteurs de cette porte</h2>
                        {% if door.readers %}
                            <ul class="pp-pa-readers">
                                {% for row in door.readers %}
                                    <li>
                                        {% include 'site/_state_chip.html.twig' with { label: row.stateLabel|capitalize, signal: row.health.signal } only %}
                                        <a href="{{ path('app_admin_rfid_reader_edit', {id: row.reader.id}) }}">{{ row.reader.name }}</a>
                                        <small>{% if row.reader.lastSeenAt %}dernier contact {{ row.reader.lastSeenAt|lab_date('d/m H:i') }}{% else %}jamais contacté{% endif %}</small>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="pp-pa-empty">Aucun lecteur ne commande cette porte.</p>
                            <a href="{{ path('app_admin_rfid_reader_new') }}">Ajouter un lecteur</a>
                        {% endif %}
                    </section>
                </div>
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
