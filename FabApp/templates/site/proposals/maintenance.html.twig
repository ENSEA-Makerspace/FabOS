{% extends 'base.html.twig' %}

{#
   PROPOSITION `maintenance` — une FILE d'intervention au lieu d'un tableau à éditer.

   Ce qui change par rapport à `/admin/maintenance` (admin-maintenance.html.twig) :
   - tuiles À faire / En retard / Cette semaine / Fait (la 3e est neuve : échéance
     dans les 7 jours), cliquables (`?tuile=<clé>`), « À faire » par défaut ;
   - chaque ligne dit la MACHINE (lien vers sa fiche, photo ou icône en petit),
     la tâche, l'échéance et l'état ;
   - le verbe principal d'une tâche ouverte est « Marquer faite ». ⚠️ La route
     `app_admin_maintenance_done` est en POST : la proposition n'enregistre rien,
     le verbe mène donc à la liste réelle, qui porte le bouton. « Modifier » passe
     en lien secondaire.
   Données : `MaintenanceQueue::build()` (lecture seule, mêmes dépôt et statut
   effectif que la page actuelle). Styles : `pp-mq-*`. Pas de pourcentage de
   disponibilité : FabOS n'a pas cette donnée.

   ⚠️ Dans `.admin-panel`, `style.css` repeint tout <span> en gris `!important` :
   texte coloré/gras en <b>, <div>, <p>.

   🅿️ À la décision : retirer ce gabarit, son entrée, la branche du contrôleur,
   `src/Design/MaintenanceQueue.php` et `public/css/proposals-maintenance.css`.
#}

{% block title %}Proposition — Maintenance{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals-maintenance.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'Maintenance',
} %}
    {% block content %}
        {% include 'site/proposals/_banner.html.twig' %}

        <div class="pp-mq">
            <nav class="pp-mq-tiles" aria-label="Filtrer la file">
                {% for t in queue.tiles %}
                    <a class="pp-mq-tile{{ t.active ? ' is-active' : '' }}{{ t.signal ? ' is-' ~ t.signal : '' }}" href="?tuile={{ t.key }}"{% if t.active %} aria-current="true"{% endif %}>
                        <b class="pp-mq-count">{{ t.count }}</b>
                        <div class="pp-mq-label">{{ t.label }}</div>
                    </a>
                {% endfor %}
            </nav>

            {% if queue.empty %}
                <p class="pp-mq-empty">Aucune tâche dans cette vue.</p>
            {% else %}
                <div class="admin-table-wrap">
                    <table class="admin-table pp-mq-table">
                        <thead>
                            <tr><th>Machine</th><th>Tâche</th><th>Échéance</th><th>État</th><th>Action</th></tr>
                        </thead>
                        <tbody>
                            {% for row in queue.rows %}
                                <tr>
                                    <td>
                                        {% if row.machine %}
                                            <div class="pp-mq-machine">
                                                <div class="pp-mq-thumb">
                                                    {% if row.machine.photo %}<img src="{{ row.machine.photo starts with 'http' or row.machine.photo starts with '/' ? row.machine.photo : asset(row.machine.photo) }}" alt="" loading="lazy">{% else %}{% include 'site/_icon.html.twig' with { name: 'tool' } only %}{% endif %}
                                                </div>
                                                <a class="pp-mq-link" href="{{ path('app_machine_detail', {id: row.machine.id}) }}">{{ row.machine.name }}</a>
                                            </div>
                                        {% else %}
                                            {% include 'site/_cell_empty.html.twig' only %}
                                        {% endif %}
                                    </td>
                                    <td>
                                        <b class="pp-mq-name">{{ row.title }}</b>
                                        <div class="pp-mq-meta">{{ row.type }}{% if row.recurrenceDays %} · tous les {{ row.recurrenceDays }} jours{% endif %}</div>
                                    </td>
                                    <td>
                                        {% if row.due %}<div class="pp-mq-due">{{ row.due|date('d/m/Y') }}</div>{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}
                                        {% if row.done %}<div class="pp-mq-meta">Faite le {{ row.done|date('d/m/Y') }}</div>{% endif %}
                                    </td>
                                    <td>{% include 'site/_state_chip.html.twig' with { label: row.state.label, signal: row.state.signal } only %}</td>
                                    <td>
                                        <div class="pp-mq-actions">
                                            {% if row.open %}
                                                {# POST dans l'application : la proposition mène à la liste réelle. #}
                                                <a class="pp-mq-verb" href="{{ path('app_admin_maintenance') }}">Marquer faite</a>
                                            {% endif %}
                                            <a class="pp-mq-secondary" href="{{ path('app_admin_maintenance_edit', {id: row.id}) }}">Modifier</a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
