{% extends 'site/base_public.html.twig' %}

{# PROPOSITION (2026-10-02) — « Mon compte », la refonte de `/profil`.
   Diagnostic mesuré sur la page actuelle (vue d'un membre) : 8 200 px de haut ;
   481 px d'en-tête décoratif ; le premier contenu est le formulaire d'envoi de
   photo ; « Mes droits » répète 4 fois la même phrase (153 mots pour UN fait) ;
   « Statistiques » = 1 189 px de tableaux vides ; les « onglets » sont des ancres
   sur une seule longue page.
   Ici : un en-tête compact qui dit l'essentiel en puces ; de VRAIS onglets (un
   seul panneau à la fois) ; l'Aperçu répond à « qu'est-ce que je dois faire, que
   puis-je faire » ; les réglages deviennent des lignes « valeur + Modifier » ;
   l'absence se tait (pas de tableau vide) ; le technique est replié.
   🅿️ À la décision : retirer ce gabarit, `ProfileProposalController`, son entrée
   de menu, `ProfileOverview` (s'il ne sert pas la vraie page) et
   `page-profil-proposition.css`. #}

{% block title %}Proposition — Mon compte - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/pages.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/page-profil-proposition.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% set q = demo ? {membre: demo} : {} %}
{% set explained = p.today.explained %}

{% block body %}
<aside class="pp-pf-banner" aria-label="Proposition">
    <div class="container">
        <b>Proposition · pas un écran réel</b> — refonte de <a href="{{ path('app_profile') }}">/profil</a>.
        Démo : <a href="?membre=45">alice</a> · <a href="?membre=3">un membre avec formations</a> · <a href="?membre=55">frank</a>.
        Avant : 8 200 px, droits répétés 4×, 1 189 px de tableaux vides.
    </div>
</aside>
<main id="main-content" tabindex="-1" class="main-content">
    <section class="machine-detail-section">
        <div class="container pp-pf">
            {# ---- L'en-tête : qui, et l'état du compte en puces — 1 écran, pas 2 ---- #}
            <header class="pp-pf-head">
                {% include 'site/_user_avatar.html.twig' with {user: member, size: 72, class: 'pp-pf-avatar', alt: member.displayName} only %}
                <div class="pp-pf-id">
                    <h1>{{ member.displayName }}</h1>
                    <p>{{ member.email }} · membre depuis le {{ member.createdAt|lab_date('d/m/Y') }}</p>
                    <ul class="pp-pf-chips">
                        <li>{% include 'site/_state_chip.html.twig' with { label: member.verified ? 'Compte vérifié' : 'Adresse à confirmer', signal: member.verified ? 'go' : 'caution' } only %}</li>
                        <li>{% include 'site/_state_chip.html.twig' with { label: explained.badges|length ~ ' badge' ~ (explained.badges|length > 1 ? 's' : ''), signal: explained.badges|length ? 'go' : 'muted' } only %}</li>
                        <li>{% include 'site/_state_chip.html.twig' with { label: explained.badge.registered ? 'Carte enregistrée ' ~ explained.badge.hint : 'Carte non enregistrée', signal: explained.badge.registered ? 'go' : 'caution' } only %}</li>
                    </ul>
                </div>
                <a class="btn btn-secondary" href="?{{ q|merge({onglet: 'reglages'})|url_encode }}">Modifier mes informations</a>
            </header>

            {# ---- De vrais onglets : un seul panneau à la fois ---- #}
            <nav class="ml-cats pp-pf-tabs" aria-label="Sections du compte">
                {% for key, label in {apercu: 'Aperçu', acces: 'Mes accès', activite: 'Mon activité', reglages: 'Réglages'} %}
                    <a class="ml-tile{{ tab == key ? ' is-on' : '' }}" href="?{{ q|merge({onglet: key})|url_encode }}"{% if tab == key %} aria-current="page"{% endif %}>{{ label }}</a>
                {% endfor %}
            </nav>

            {% if tab == 'apercu' %}
                {# À faire, prochaine réservation, ce que le badge ouvre : le bloc de l'accueil, tel quel. #}
                {% include 'site/_home_member.html.twig' with { member: member, today: p.today, greet: false } only %}

                <div class="pp-pf-tiles">
                    <a class="pp-pf-tile" href="?{{ q|merge({onglet: 'acces'})|url_encode }}">
                        <span class="pp-pf-tile-k">Je peux</span>
                        <b>{% for key in p.rights.allowed %}{{ key|trans|lower }}{% if not loop.last %}, {% endif %}{% else %}rien pour l’instant{% endfor %}</b>
                    </a>
                    <a class="pp-pf-tile" href="{{ path('app_my_trainings') }}">
                        <span class="pp-pf-tile-k">Formations</span>
                        <b>{{ (p.trainings.resume ? 1 : 0) + p.trainings.ongoing|length }} en cours · {{ p.trainings.done|length }} terminée{{ p.trainings.done|length > 1 ? 's' : '' }}</b>
                    </a>
                    <a class="pp-pf-tile" href="?{{ q|merge({onglet: 'activite'})|url_encode }}">
                        <span class="pp-pf-tile-k">Prêts</span>
                        <b>{{ p.loans|length ? p.loans|length ~ ' objet' ~ (p.loans|length > 1 ? 's' : '') ~ ' à rendre' : 'Rien à rendre' }}</b>
                    </a>
                    <a class="pp-pf-tile" href="?{{ q|merge({onglet: 'activite'})|url_encode }}">
                        <span class="pp-pf-tile-k">Événements</span>
                        <b>{{ p.events|length ? p.events|length ~ ' inscription' ~ (p.events|length > 1 ? 's' : '') ~ ' à venir' : 'Aucune inscription' }}</b>
                    </a>
                </div>

            {% elseif tab == 'acces' %}
                <section class="detail-card">
                    <h2 class="detail-card-title">Ce que je peux faire</h2>
                    {# UNE ligne au lieu de quatre cartes identiques. #}
                    <ul class="md-access-list">
                        {% for key in p.rights.allowed %}
                            <li class="is-ok"><span class="md-access-mark" aria-hidden="true">✓</span><span>{{ key|trans }}</span></li>
                        {% endfor %}
                        {% for d in p.rights.denied %}
                            <li class="is-missing"><span class="md-access-mark" aria-hidden="true">✗</span><span>{{ d.labelKey|trans }} — {{ ('usage_rights.verdict.' ~ d.reason ~ '.label')|trans }}</span></li>
                        {% endfor %}
                    </ul>
                    {% if p.rights.sources|length %}
                        <p class="md-note">
                            {% for s in p.rights.sources %}Grâce au forfait « {{ s.package }} »{% if s.group %} (groupe « {{ s.group }} »){% endif %}{{ s.until ? ', jusqu’au ' ~ s.until|date('d/m/Y') : ', sans date de fin' }}.{% if not loop.last %} {% endif %}{% endfor %}
                        </p>
                    {% endif %}
                </section>
                {% if explained.badges|length %}
                    <section class="detail-card">
                        <h2 class="detail-card-title">Mes badges</h2>
                        <ul class="md-access-list">
                            {% for held in explained.badges %}
                                <li class="is-ok"><span class="md-access-mark" aria-hidden="true">✓</span><span><a href="{{ path('app_badge_detail', {id: held.badge.id}) }}">{{ held.badge.nom }}</a> — obtenu le {{ held.obtainedAt ? held.obtainedAt|lab_date('d/m/Y') : '—' }}</span></li>
                            {% endfor %}
                        </ul>
                        <p class="md-note">Chaque badge mène à ce qu’il vous autorise à utiliser.</p>
                    </section>
                {% endif %}
                {% include 'site/_badge_reach.html.twig' with { explained: explained, audience: 'self', id_prefix: 'pp-pf-reach' } only %}

            {% elseif tab == 'activite' %}
                <div class="pp-pf-grid">
                    <section class="detail-card">
                        <h2 class="detail-card-title">Réservations</h2>
                        {% if p.today.next %}
                            {% set r = p.today.next %}
                            <p><b>{{ reservable(r).name }}</b> · {{ r.dateDebut|loc_date('EEEE d MMMM')|capitalize }} · {{ r.dateDebut|date('H:i') }}–{{ r.dateFin|date('H:i') }}</p>
                        {% else %}
                            <p class="md-note">Aucune réservation à venir.</p>
                        {% endif %}
                        <p class="md-note">{{ p.reservationCount }} réservation{{ p.reservationCount > 1 ? 's' : '' }} en tout · <a href="{{ path('app_my_reservations') }}">Mes réservations ›</a></p>
                    </section>
                    <section class="detail-card">
                        <h2 class="detail-card-title">Formations</h2>
                        {% if p.trainings.resume %}<p>À reprendre : <b>{{ p.trainings.resume.formation.titre }}</b></p>{% endif %}
                        <p class="md-note">{{ p.trainings.ongoing|length + (p.trainings.resume ? 1 : 0) }} en cours · {{ p.trainings.done|length }} terminée{{ p.trainings.done|length > 1 ? 's' : '' }} · <a href="{{ path('app_my_trainings') }}">Mes formations ›</a></p>
                    </section>
                    {% if p.loans|length %}
                        <section class="detail-card">
                            <h2 class="detail-card-title">Prêts en cours</h2>
                            <ul class="md-access-list">
                                {% for loan in p.loans %}
                                    <li class="{{ loan.effectiveStatus == 'overdue' ? 'is-missing' : 'is-ok' }}"><span class="md-access-mark" aria-hidden="true">{{ loan.effectiveStatus == 'overdue' ? '!' : '•' }}</span><span><a href="{{ path('app_loans_item', {id: loan.item.id}) }}">{{ loan.item.name }}</a>{% if loan.expectedReturnDate %} — à rendre le {{ loan.expectedReturnDate|date('d/m/Y') }}{% endif %}</span></li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endif %}
                    {% if p.events|length %}
                        <section class="detail-card">
                            <h2 class="detail-card-title">Événements à venir</h2>
                            <ul class="md-access-list">
                                {% for reg in p.events %}
                                    <li class="is-ok"><span class="md-access-mark" aria-hidden="true">•</span><span><a href="{{ path('app_event_detail', {id: reg.event.id}) }}">{{ reg.event.titre }}</a> — {{ reg.event.dateDebut|date('d/m H:i') }}</span></li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endif %}
                </div>
                <p class="md-note">Les tableaux vides de l’ancien onglet « Statistiques » (passages RFID, journaux d’utilisation) n’apparaissent que s’ils ont quelque chose à dire.</p>

            {% else %}
                {# Réglages : une ligne = une chose, sa valeur, et UN verbe. Les formulaires
                   restent sur leur page (dans la vraie page : un panneau qui s'ouvre). #}
                <section class="detail-card pp-pf-set">
                    <h2 class="detail-card-title">Mes informations</h2>
                    <dl>
                        <div><dt>Nom</dt><dd>{{ member.displayName }}</dd><dd><a href="{{ path('app_profile') }}#info">Modifier</a></dd></div>
                        <div><dt>Photo</dt><dd>{{ member.avatarFilename and member.avatarFilename != 'default-avatar.svg' ? 'Personnalisée' : 'Par défaut' }}</dd><dd><a href="{{ path('app_profile') }}#info">Changer</a></dd></div>
                        <div><dt>Adresse e-mail</dt><dd>{{ member.email }} {% include 'site/_state_chip.html.twig' with { label: member.verified ? 'Vérifiée' : 'À confirmer', signal: member.verified ? 'go' : 'caution' } only %}</dd><dd></dd></div>
                        <div><dt>Profil public</dt><dd>{{ member.publicProfileEnabled ? 'Publié' : 'Privé' }}</dd><dd><a href="{{ path('app_profile') }}#public-profile">Régler</a></dd></div>
                    </dl>
                </section>
                <section class="detail-card pp-pf-set">
                    <h2 class="detail-card-title">E-mails</h2>
                    <dl>
                        <div><dt>Essentiels</dt><dd>Toujours envoyés (confirmations, changements de vos réservations)</dd><dd></dd></div>
                        <div><dt>Optionnels</dt><dd>{{ p.emails.optionalOn }} sur {{ p.emails.optional }} reçus</dd><dd><a href="{{ path('app_profile') }}#settings">Choisir</a></dd></div>
                    </dl>
                </section>
                <section class="detail-card pp-pf-set">
                    <h2 class="detail-card-title">Sécurité</h2>
                    <dl>
                        <div><dt>Mot de passe</dt><dd>••••••••</dd><dd><a href="{{ path('app_profile_password') }}">Modifier</a></dd></div>
                        {% if p.account.mfa is not null %}
                            <div><dt>Double authentification</dt><dd>{% include 'site/_state_chip.html.twig' with { label: p.account.mfa == 'enabled' ? 'Activée' : 'Recommandée', signal: p.account.mfa == 'enabled' ? 'go' : 'caution' } only %}</dd><dd><a href="{{ path('app_profile_mfa') }}">{{ p.account.mfa == 'enabled' ? 'Gérer' : 'Activer' }}</a></dd></div>
                        {% endif %}
                        {% if p.account.sessions is not null %}
                            <div><dt>Sessions ouvertes</dt><dd>{{ p.account.sessions ? p.account.sessions ~ ' autre(s)' : 'Aucune autre' }}</dd><dd><a href="{{ path('app_profile_sessions') }}">Voir</a></dd></div>
                        {% endif %}
                    </dl>
                </section>
                <section class="detail-card pp-pf-set">
                    <h2 class="detail-card-title">Affichage</h2>
                    <dl>
                        <div><dt>Langue</dt><dd>{{ app.request.locale|upper }}</dd><dd><a href="{{ path('app_profile') }}#settings">Changer</a></dd></div>
                        <div><dt>Thème</dt><dd>Clair, sombre ou système</dd><dd><a href="{{ path('app_profile') }}#settings">Changer</a></dd></div>
                        <div><dt>Lieu préféré</dt><dd>Pour ouvrir les listes au bon endroit</dd><dd><a href="{{ path('app_profile') }}#settings">Changer</a></dd></div>
                    </dl>
                </section>
                <details class="detail-card pp-pf-tech">
                    <summary>Détails techniques</summary>
                    <dl>
                        <div><dt>Identifiant</dt><dd>{{ member.username }}</dd></div>
                        <div><dt>Numéro d’identification</dt><dd>{{ member.numeroId ?: '—' }}</dd></div>
                        <div><dt>Dernière connexion</dt><dd>{{ member.derniereConnexion ? member.derniereConnexion|lab_date('d/m/Y H:i') : '—' }}</dd></div>
                    </dl>
                </details>
                <p class="md-note pp-pf-delete"><a href="{{ path('app_profile_delete') }}">Supprimer mon compte</a></p>
            {% endif %}
        </div>
    </section>
</main>
{% endblock %}
