{% extends 'base.html.twig' %}

{#
   PROPOSITION `fiche-lecteur` — une FICHE de lecteur, l'état d'abord.

   Ce qui change par rapport à `/admin/rfid-readers/{id}/edit`
   (admin-rfid-reader-form.html.twig : formulaire, bloc .env, mise en service
   SOUS le formulaire) :
   - EN TÊTE l'état calculé (`ReaderHealth` : Prêt / Hors ligne depuis … /
     À configurer), le dernier contact, et ce que le lecteur commande avec un
     lien vers sa fiche ;
   - tant que le lecteur n'est pas en service, la mise en service
     (`_commissioning`) monte juste sous l'en-tête, l'étape BLOQUANTE dite en
     clair et, sans premier contact, « en attente d'une première connexion » ;
   - les 5 derniers événements du journal RFID de CE lecteur, avec un lien vers
     le journal filtré ;
   - le formulaire d'édition descend : ici un simple lien « Modifier les
     réglages » vers la vraie page (en vrai : un <details> replié).
   - Aucun secret ni jeton affiché (ni readerToken, ni UID de badge).
   Données : `ReaderSheet::build()` (lecture seule). `?lecteur=<id>` choisit le
   lecteur (défaut : le premier non archivé). Styles : `pp-fl-*`.

   ⚠️ Dans `.admin-panel`, `style.css` repeint tout <span> en gris `!important` :
   texte coloré ou gras ici en <b>, <div>, <p>, jamais en <span>.

   🅿️ À la décision : retirer ce gabarit, son entrée, la branche du contrôleur,
   `src/Design/ReaderSheet.php` et `public/css/proposals-fiche-lecteur.css`.
#}

{% block title %}Proposition — Fiche d’un lecteur{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals-fiche-lecteur.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'Lecteurs RFID',
} %}
    {% block content %}
        {% include 'site/proposals/_banner.html.twig' %}

        <div class="pp-fl">
            {% if sheet.reader is null %}
                <p class="pp-fl-empty">Aucun lecteur n’est déclaré : rien à montrer.</p>
            {% else %}
                {% set reader = sheet.reader %}

                <nav class="pp-fl-switch" aria-label="Autres lecteurs">
                    <b>Comparer :</b>
                    {% for o in sheet.others %}
                        <a href="?lecteur={{ o.reader.id }}"{% if o.current %} class="is-current" aria-current="page"{% endif %}>
                            {% include 'site/_state_chip.html.twig' with { label: o.reader.name, signal: o.health.signal } only %}
                        </a>
                    {% endfor %}
                </nav>

                <header class="pp-fl-head">
                    <div>
                        <h2 class="pp-fl-state is-{{ sheet.health.signal }}">
                            {% include 'site/_icon.html.twig' with { name: sheet.health.signal == 'go' ? 'check' : (sheet.health.signal == 'stop' ? 'warning' : 'hourglass') } only %}
                            <b>{{ sheet.headline }}{% if sheet.health.state == 'offline' and reader.lastSeenAt %} depuis {{ reader.lastSeenAt|lab_date('d/m H:i') }}{% endif %}</b>
                        </h2>
                        <p class="pp-fl-sub">
                            {{ reader.name }} ·
                            {% if reader.lastSeenAt %}dernier contact {{ reader.lastSeenAt|lab_date('d/m H:i') }}{% else %}jamais contacté{% endif %}
                        </p>
                    </div>
                    <div class="pp-fl-target">
                        {% if reader.machine %}
                            <b>{{ reader.machine.nom }}</b><br>
                            <a href="{{ path('app_admin_machine_edit', {id: reader.machine.id}) }}">Ouvrir la machine</a>
                        {% elseif reader.accessPoint %}
                            <b>{{ reader.accessPoint.nom }}</b><br>
                            <a href="{{ path('app_admin_access_point_edit', {id: reader.accessPoint.id}) }}">Ouvrir le point d’accès</a>
                        {% else %}
                            <b>Ne commande rien</b>
                            <p class="pp-fl-sub">Associez une machine ou un point d’accès.</p>
                        {% endif %}
                    </div>
                </header>

                {% if sheet.commissioning %}
                    {% if not reader.lastSeenAt %}
                        <p class="pp-fl-wait"><b>En attente d’une première connexion.</b> Le lecteur apparaîtra dès son premier appel.</p>
                    {% endif %}
                    {% if sheet.blockingStep %}
                        <p class="pp-fl-block"><b>Étape bloquante :</b> {{ ('rfid_form.step_' ~ sheet.blockingStep)|trans }} — {{ ('rfid_form.step_' ~ sheet.blockingStep ~ '_note')|trans }}</p>
                    {% endif %}
                    {% include 'site/_commissioning.html.twig' with {
                        steps: sheet.steps, label_ns: 'rfid_form.step_', title: 'rfid_form.commissioning_title',
                    } only %}
                {% endif %}

                <div class="pp-fl-grid">
                    <section class="pp-fl-card" aria-labelledby="pp-fl-events">
                        <h2 id="pp-fl-events">Derniers événements</h2>
                        {% if sheet.events %}
                            <ul class="pp-fl-events">
                                {% for e in sheet.events %}
                                    <li>
                                        <div>
                                            <b>{{ e.outcome }}</b>
                                            <small>{{ e.who }}{% if e.detail %} · {{ e.detail }}{% endif %}</small>
                                        </div>
                                        <div>{{ e.at|lab_date('d/m H:i') }}</div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="pp-fl-empty">Aucun événement enregistré pour ce lecteur.</p>
                        {% endif %}
                        <a href="{{ path('app_admin_access_rfid_logs', {reader: reader.id, days: 0}) }}">Voir tout le journal de ce lecteur</a>
                    </section>

                    <section class="pp-fl-card" aria-labelledby="pp-fl-edit">
                        <h2 id="pp-fl-edit">Réglages</h2>
                        <p class="pp-fl-sub">Nom, association, identifiant et activation se règlent sur la page d’édition. Le jeton n’est jamais affiché ici.</p>
                        <a href="{{ path('app_admin_rfid_reader_edit', {id: reader.id}) }}">Modifier les réglages</a>
                    </section>
                </div>
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
