{% extends 'site/base_public.html.twig' %}

{# S134c — this page carried its own `<!DOCTYPE>`, `<head>` and a byte-for-byte
   copy of the site header: six navbar links, the search box and the burger, all
   in French literals no catalogue could reach. It also marked *Leaderboard* as
   the active link, on the page that publishes a creation.

   On `base_public` the header comes from `_header.html.twig` (which already
   includes the alert bar), so the eleven literals are gone, the active link is
   whatever the shared header decides, and the page gains the shared footer and
   `main.js` — its burger button had nothing wired to it. #}

{% set body_class = 'leaderboard-sky-page' %}

{% block title %}{{ 'projects.publish_page'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=20260823-s148j7' }}">
{% endblock %}

{% block body %}
    <main id="main-content" tabindex="-1" class="leaderboard-game creation-form-page">
        <span class="lb-cloud lb-cloud-2"></span><span class="lb-character lb-character-relax"></span>
        <section class="creation-form-shell">
            <div class="creation-form-card">
                <a class="creation-back" href="{{ path('app_creations') }}" aria-label="{{ 'projects.back_gallery_aria'|trans }}"><span aria-hidden="true">←</span> {{ 'projects.back_to_gallery'|trans }}</a>
                <div class="section-badge">{{ 'projects.new_creation'|trans }}</div>
                <h1>{{ 'projects.publish'|trans }}</h1>
                {# ⚠️ MERGE 2026-08-05 — `main` replaced these four with hardcoded French and
                   its help line also mentioned the new compression + thumbnail. The keys are
                   kept because i18n parity across 5 locales is a hard constraint; the extra
                   sentence is worth adding, but as 5 translation rows, not as French here. #}
                <p class="creation-form-help">{{ 'projects.upload_help'|trans }}</p>
                {% for message in app.flashes('success') %}<div class="creation-flash success">{{ message|flash_text }}</div>{% endfor %}
                {% for message in app.flashes('warning') %}<div class="creation-flash warning">{{ message|flash_text }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="creation-flash error">{{ message|flash_text }}</div>{% endfor %}
                {{ form_start(form, {method: 'POST', action: path('app_creation_new'), attr: {class: 'creation-public-form', novalidate: 'novalidate'}}) }}
                    <div class="form-errors full">{{ form_errors(form) }}</div>
                    <div class="form-field">{{ form_label(form.title) }}{{ form_widget(form.title) }}<div class="form-errors">{{ form_errors(form.title) }}</div></div>
                    <div class="form-field">{{ form_label(form.imageUpload) }}{{ form_widget(form.imageUpload) }}<div class="form-help">{{ form_help(form.imageUpload) }}</div><div class="form-errors">{{ form_errors(form.imageUpload) }}</div></div>
                    <div class="form-field">{{ form_label(form.printDurationFormatted) }}{{ form_widget(form.printDurationFormatted) }}<div class="form-help">{{ form_help(form.printDurationFormatted) }}</div><div class="form-errors">{{ form_errors(form.printDurationFormatted) }}</div></div>
                    <div class="form-field">{{ form_label(form.fileUpload) }}{{ form_widget(form.fileUpload) }}<div class="form-help">{{ form_help(form.fileUpload) }}</div><div class="form-errors">{{ form_errors(form.fileUpload) }}</div></div>
                    <div class="form-field">{{ form_label(form.externalUrl) }}{{ form_widget(form.externalUrl) }}<div class="form-errors">{{ form_errors(form.externalUrl) }}</div></div>
                    <div class="form-field">{{ form_label(form.tagsInput) }}{{ form_widget(form.tagsInput) }}<div class="form-help">{{ form_help(form.tagsInput) }}</div><div class="form-errors">{{ form_errors(form.tagsInput) }}</div></div>
                    <div class="form-field full">{{ form_label(form.description) }}{{ form_widget(form.description) }}<div class="form-errors">{{ form_errors(form.description) }}</div></div>
                    <div class="creation-form-actions"><span class="btn-submit">{{ form_widget(form.save) }}</span></div>
                {{ form_end(form) }}
            </div>
        </section>
    </main>
{% endblock %}
