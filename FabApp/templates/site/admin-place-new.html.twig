{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'admin_places.browser_title_new'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260812-s137-frame2' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <style>
        @media (max-width: 900px) {.admin-edit-header { padding: 24px 16px; }}
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>{{ 'admin_places.new_title'|trans }}</h1>
                    <p>{{ 'admin_places.new_subtitle'|trans }}</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_places') }}">{{ 'admin_places.back'|trans }}</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>{{ 'admin_places.panel_new'|trans }}</h2>
                </div>

                {# ⚠️ Scoped to this form, never set globally in twig.yaml: a global
                   theme would restyle booking, registration and the wizard in the
                   same commit, and none of that is render-testable from here. #}
                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.nom) }}
                        {{ form_row(form.venue) }}
                        {{ form_row(form.localisation) }}
                        {{ form_row(form.capacite) }}
                        {# `full` comes from PlaceAdminType's row_attr, not from here —
                           which field spans the grid is a fact about the form, and it
                           was previously re-decided in both new and edit. #}
                        {{ form_row(form.description, {row_attr: {class: 'full'}}) }}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_places') }}">{{ 'common.cancel'|trans }}</a>
                        <span class="btn-submit">{{ form_widget(form.save, {label: 'admin_places.submit_new'|trans}) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
{% endblock %}
