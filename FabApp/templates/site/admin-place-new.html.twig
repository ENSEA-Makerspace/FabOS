<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Créer un espace - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260731-tokens' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260731-tokens' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Créer un espace</h1>
                    <p>Une salle ou un espace que les membres pourront réserver, comme une machine.</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_places') }}">Retour aux espaces</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>Nouvel espace</h2>
                </div>

                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        <div class="form-field">
                            {{ form_label(form.nom) }}
                            {{ form_widget(form.nom) }}
                            <div class="form-errors">{{ form_errors(form.nom) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.localisation) }}
                            {{ form_widget(form.localisation) }}
                            <div class="form-errors">{{ form_errors(form.localisation) }}</div>
                        </div>
                        <div class="form-field">
                            {{ form_label(form.capacite) }}
                            {{ form_widget(form.capacite) }}
                            <div class="form-errors">{{ form_errors(form.capacite) }}</div>
                        </div>
                        <div class="form-field full">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description) }}
                            <div class="form-errors">{{ form_errors(form.description) }}</div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_places') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save, {label: 'Créer l’espace'}) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
</body>
</html>
