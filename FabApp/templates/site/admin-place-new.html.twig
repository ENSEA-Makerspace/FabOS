<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Créer un espace - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260802-s78-nav' }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260802-s78-forms' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        @media (max-width: 900px) { .admin-edit-layout { grid-template-columns: 1fr; padding: 0 16px; } .form-grid { grid-template-columns: 1fr; } .admin-edit-header { padding: 24px 16px; } }
    </style>
</head>
<body>
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-edit-header">
            <div class="admin-edit-header-inner">
                <div>
                    <h1>Créer un espace</h1>
                    <p>Une salle ou un espace que les membres pourront réserver, comme une machine.</p>
                </div>
                <a class="btn-link" href="{{ path('app_admin_places') }}">Retour aux espaces</a>
            </div>
        </header>

        <div class="admin-edit-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'edit'} %}

            <section class="admin-edit-panel">
                <div class="admin-edit-panel-header">
                    <h2>Nouvel espace</h2>
                </div>

                {# ⚠️ Scoped to this form, never set globally in twig.yaml: a global
                   theme would restyle booking, registration and the wizard in the
                   same commit, and none of that is render-testable from here. #}
                {% form_theme form 'form/admin_theme.html.twig' %}
                {{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    <div class="form-grid">
                        {{ form_row(form.nom) }}
                        {{ form_row(form.localisation) }}
                        {{ form_row(form.capacite) }}
                        {# `full` comes from PlaceAdminType's row_attr, not from here —
                           which field spans the grid is a fact about the form, and it
                           was previously re-decided in both new and edit. #}
                        {{ form_row(form.description, {row_attr: {class: 'full'}}) }}
                    </div>

                    <div class="form-actions">
                        <a class="btn-link" href="{{ path('app_admin_places') }}">Annuler</a>
                        <span class="btn-submit">{{ form_widget(form.save, {label: 'Créer l’espace'}) }}</span>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
</body>
</html>
