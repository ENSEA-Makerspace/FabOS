{% extends 'site/base_public.html.twig' %}

{% block title %}{{ 'profile.change_password_btn'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260824-s149' }}">
{% endblock %}

{% block body %}

    <main id="main-content" tabindex="-1" class="main-content">
        <section class="profile-section">
            <div class="container">
                <div class="profile-header">
                    <div class="section-badge profile-badge">{{ 'profile.title'|trans }}</div>
                    <div class="profile-banner">
                        <div class="profile-cover"><div class="cover-overlay"></div></div>
                        <div class="profile-avatar-large">
                            <span class="avatar-initial">{{ ((user.firstName ?? user.username)|slice(0, 1) ~ (user.lastName ?? '')|slice(0, 1))|upper }}</span>
                            <div class="avatar-status online"></div>
                        </div>
                        <div class="profile-info-main">
                            <h1 class="profile-name">{{ 'profile.change_password_btn'|trans }}</h1>
                            <p class="profile-email">{{ user.email }}</p>
                            <p class="profile-student-id">Compte: {{ user.displayName }}</p>
                        </div>
                    </div>

                    <div class="profile-nav">
                        <a href="{{ path('app_profile') }}#info" class="profile-nav-link">{{ 'profile.tab_personal'|trans }}</a>
                        <a href="{{ path('app_profile') }}#settings" class="profile-nav-link active">{{ 'profile.tab_settings'|trans }}</a>
                    </div>
                </div>

                <section class="profile-content-section" id="password">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">{{ 'pwd.account_security'|trans }}</h2>
                            <a href="{{ path('app_profile') }}#settings" class="btn btn-sm btn-secondary">{{ 'pwd.back_profile'|trans }}</a>
                        </div>

                        {% if errors is not empty %}
                            <div class="profile-flash error">
                                {% for error in errors %}
                                    <div>{{ error }}</div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <form method="post" action="{{ path('app_profile_password') }}" class="settings-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('profile_password') }}">

                            <div class="settings-grid">
                                <div class="settings-section">
                                    <h3 class="settings-subtitle">{{ 'login.password_label'|trans }}</h3>

                                    <div class="setting-item">
                                        <div class="setting-info">
                                            <h4 id="pw-current-label">{{ 'pwd.current_pw'|trans }}</h4>
                                            <p id="pw-current-desc">{{ 'pwd.current_pw_desc'|trans }}</p>
                                        </div>
                                        <div class="setting-action">
                                            <input class="form-input" type="password" name="currentPassword" autocomplete="current-password" required aria-labelledby="pw-current-label" aria-describedby="pw-current-desc">
                                        </div>
                                    </div>

                                    <div class="setting-item">
                                        <div class="setting-info">
                                            <h4 id="pw-new-label">{{ 'pwd.new_pw'|trans }}</h4>
                                            <p id="pw-new-desc">{{ 'pwd.new_pw_desc'|trans }}</p>
                                        </div>
                                        <div class="setting-action">
                                            <input class="form-input" type="password" name="newPassword" autocomplete="new-password" minlength="8" required aria-labelledby="pw-new-label" aria-describedby="pw-new-desc">
                                        </div>
                                    </div>

                                    <div class="setting-item">
                                        <div class="setting-info">
                                            <h4 id="pw-confirm-label">{{ 'pwd.confirmation'|trans }}</h4>
                                            <p id="pw-confirm-desc">{{ 'pwd.confirm_desc'|trans }}</p>
                                        </div>
                                        <div class="setting-action">
                                            <input class="form-input" type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required aria-labelledby="pw-confirm-label" aria-describedby="pw-confirm-desc">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-footer">
                                <button type="submit" class="btn btn-primary">{{ 'pwd.update_pw'|trans }}</button>
                                <a href="{{ path('app_profile') }}#settings" class="btn btn-secondary">{{ 'common.cancel'|trans }}</a>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </section>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
{% endblock %}
