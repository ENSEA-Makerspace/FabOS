<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Changer mon mot de passe - Profil FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">{% include 'site/_logo.html.twig' %}</div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">{{ 'nav.home'|trans }}</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">{{ 'nav.calendar'|trans }}</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">{{ 'nav.machines'|trans }}</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">{{ 'nav.trainings'|trans }}</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">{{ 'nav.leaderboard'|trans }}</a><a href="{{ path('app_leaderboard_creations') }}" class="navbar-link">{{ 'nav.projects'|trans }}</a><a href="{{ path('app_badges') }}" class="navbar-link">{{ 'nav.badges'|trans }}</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">{{ 'nav.admin'|trans }}</a>
                    {% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>
            </div>
        </div>
    </header>

    <main class="main-content">
        <section class="profile-section">
            <div class="container">
                <div class="profile-header">
                    <div class="section-badge profile-badge">Mon Profil</div>
                    <div class="profile-banner">
                        <div class="profile-cover"><div class="cover-overlay"></div></div>
                        <div class="profile-avatar-large">
                            <span class="avatar-initial">{{ ((user.firstName ?? user.username)|slice(0, 1) ~ (user.lastName ?? '')|slice(0, 1))|upper }}</span>
                            <div class="avatar-status online"></div>
                        </div>
                        <div class="profile-info-main">
                            <h1 class="profile-name">Changer mon mot de passe</h1>
                            <p class="profile-email">{{ user.email }}</p>
                            <p class="profile-student-id">Compte: {{ user.displayName }}</p>
                        </div>
                    </div>

                    <div class="profile-nav">
                        <a href="{{ path('app_profile') }}#info" class="profile-nav-link">Informations personnelles</a>
                        <a href="{{ path('app_profile') }}#settings" class="profile-nav-link active">Paramètres</a>
                    </div>
                </div>

                <section class="profile-content-section" id="password">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h2 class="section-card-title">Sécurité du compte</h2>
                            <a href="{{ path('app_profile') }}#settings" class="btn btn-sm btn-secondary">Retour au profil</a>
                        </div>

                        {% if errors is not empty %}
                            <div class="profile-flash error">
                                {% for error in errors %}
                                    <div>{{ error }}</div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <form method="post" action="{{ path('app_profile_password') }}" class="settings-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('profile_password') }}">

                            <div class="settings-grid">
                                <div class="settings-section">
                                    <h3 class="settings-subtitle">Mot de passe</h3>

                                    <div class="setting-item">
                                        <div class="setting-info">
                                            <h4>Mot de passe actuel</h4>
                                            <p>Confirmez votre identité avant modification.</p>
                                        </div>
                                        <div class="setting-action">
                                            <input class="form-input" type="password" name="currentPassword" autocomplete="current-password" required>
                                        </div>
                                    </div>

                                    <div class="setting-item">
                                        <div class="setting-info">
                                            <h4>Nouveau mot de passe</h4>
                                            <p>Utilisez au moins 8 caractères.</p>
                                        </div>
                                        <div class="setting-action">
                                            <input class="form-input" type="password" name="newPassword" autocomplete="new-password" minlength="8" required>
                                        </div>
                                    </div>

                                    <div class="setting-item">
                                        <div class="setting-info">
                                            <h4>Confirmation</h4>
                                            <p>Répétez le nouveau mot de passe.</p>
                                        </div>
                                        <div class="setting-action">
                                            <input class="form-input" type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-footer">
                                <button type="submit" class="btn btn-primary">Mettre à jour le mot de passe</button>
                                <a href="{{ path('app_profile') }}#settings" class="btn btn-secondary">Annuler</a>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') ~ '?v=20260709-header-scope' }}"></script>
</body>
</html>
