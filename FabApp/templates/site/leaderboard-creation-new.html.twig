<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Publier une création - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260711-creation-optimized' }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=20260711-creation-optimized' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body class="leaderboard-sky-page">
    <div class="alert-bar">{% include 'site/_alert_bar.html.twig' %}</div>
    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand"><div class="logo-ensea">{% include 'site/_logo.html.twig' %}</div></a>
            <nav class="main-navbar"><div class="navbar-container">
                <a href="{{ path('app_home') }}" class="navbar-link">Accueil</a>
                <a href="{{ path('app_calendar') }}" class="navbar-link">Calendrier</a>
                <a href="{{ path('app_machines') }}" class="navbar-link">Machines</a>
                <a href="{{ path('app_formations') }}" class="navbar-link">Formations</a>
                <a href="{{ path('app_leaderboard') }}" class="navbar-link active">Leaderboard</a>
                {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_admin_dashboard') }}" class="navbar-link">Admin</a>{% endif %}
            </div></nav>
            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header" aria-label="Rechercher">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    </button>
                </div>
                <div class="header-auth">{% include 'site/_header_auth.html.twig' %}</div>
                <button class="mobile-nav-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
            </div>
        </div>
    </header>
    <main class="leaderboard-game creation-form-page">
        <span class="lb-cloud lb-cloud-2"></span><span class="lb-character lb-character-relax"></span>
        <section class="creation-form-shell">
            <div class="creation-form-card">
                <a class="creation-back" href="{{ path('app_leaderboard_creations') }}" aria-label="Retour à la galerie des créations"><span aria-hidden="true">←</span> Retour à la galerie</a>
                <div class="section-badge">Nouvelle création</div>
                <h1>Publier ma création</h1>
                <p class="creation-form-help">Image obligatoire : PNG, JPG, JPEG ou WEBP, 5 Mo max. Elle sera compressée et une miniature sera créée automatiquement. Fichier optionnel : STL, 3MF, OBJ, STEP, PDF, ZIP ou AFDESIGN, 20 Mo max.</p>
                {% for message in app.flashes('success') %}<div class="creation-flash success">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('warning') %}<div class="creation-flash warning">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="creation-flash error">{{ message }}</div>{% endfor %}
                {{ form_start(form, {method: 'POST', action: path('app_leaderboard_creation_new'), attr: {class: 'creation-public-form', novalidate: 'novalidate'}}) }}
                    <div class="form-errors full">{{ form_errors(form) }}</div>
                    <div class="form-field">{{ form_label(form.title) }}{{ form_widget(form.title) }}<div class="form-errors">{{ form_errors(form.title) }}</div></div>
                    <div class="form-field">{{ form_label(form.imageUpload) }}{{ form_widget(form.imageUpload) }}<div class="form-help">{{ form_help(form.imageUpload) }}</div><div class="form-errors">{{ form_errors(form.imageUpload) }}</div></div>
                    <div class="form-field">{{ form_label(form.printDurationFormatted) }}{{ form_widget(form.printDurationFormatted) }}<div class="form-help">{{ form_help(form.printDurationFormatted) }}</div><div class="form-errors">{{ form_errors(form.printDurationFormatted) }}</div></div>
                    <div class="form-field">{{ form_label(form.fileUpload) }}{{ form_widget(form.fileUpload) }}<div class="form-help">{{ form_help(form.fileUpload) }}</div><div class="form-errors">{{ form_errors(form.fileUpload) }}</div></div>
                    <div class="form-field">{{ form_label(form.externalUrl) }}{{ form_widget(form.externalUrl) }}<div class="form-errors">{{ form_errors(form.externalUrl) }}</div></div>
                    <div class="form-field full">{{ form_label(form.description) }}{{ form_widget(form.description) }}<div class="form-errors">{{ form_errors(form.description) }}</div></div>
                    <div class="creation-form-actions"><span class="btn-submit">{{ form_widget(form.save) }}</span></div>
                {{ form_end(form) }}
            </div>
        </section>
    </main>
</body>
</html>
