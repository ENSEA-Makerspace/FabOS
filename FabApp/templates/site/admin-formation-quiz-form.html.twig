{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ (isNew ? 'quiz_form.title_new' : 'quiz_form.title_edit')|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/formation-content-admin.css') ~ '?v=' ~ css_version }}">
    {# AssetMapper (Stimulus seul, Turbo desactive). Cette page est autonome : elle ne
       passe par aucun shell, donc elle porte sa propre ligne. #}
    {{ importmap('app') }}
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}

    <main id="main-content" tabindex="-1" class="admin-content-page">
        <div class="admin-content-container">
            <section class="admin-content-hero">
                <div>
                    <span class="admin-content-eyebrow">{{ (isNew ? 'quiz_form.eyebrow_new' : 'quiz_form.eyebrow_edit')|trans }}</span>
                    <h1>{{ isNew ? 'quiz_form.add'|trans : formData.title }}</h1>
                    <p>{{ 'quiz_form.subtitle'|trans({'%formation%': formation.titre}) }}</p>
                </div>
                <div class="admin-content-actions">
                    <a class="admin-secondary-button" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#quizzes">{{ 'quiz_form.back_to_editor'|trans }}</a>
                    <a class="admin-secondary-button" href="{{ path('app_formation_detail', {id: formation.id}) }}">{{ 'quiz_form.view_page'|trans }}</a>
                </div>
            </section>

            {% for message in app.flashes('warning') %}<div class="admin-flash admin-flash-warning">{{ message|flash_text }}</div>{% endfor %}
            {% if errors is not empty %}
                <div class="admin-error-list"><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>
            {% endif %}

            <section class="admin-content-card">
                <form method="post" id="quiz-admin-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('formation_quiz_' ~ (isNew ? 'new_' ~ formation.id : 'edit_' ~ quiz.id)) }}">
                    <div class="admin-form-grid">
                        <div class="admin-form-field admin-form-field--full">
                            <label for="quiz-title">{{ 'quiz_form.field_title'|trans }}</label>
                            <input class="admin-form-control" id="quiz-title" name="title" value="{{ formData.title }}" required>
                        </div>
                        <div class="admin-form-field">
                            <label for="quiz-type">{{ 'quiz_form.field_type'|trans }}</label>
                            <select class="admin-form-control" id="quiz-type" name="type" {{ legacyDirectQuiz ? 'disabled' : '' }}>
                                <option value="section" {{ formData.type == 'section' ? 'selected' : '' }}>{{ 'quiz_form.type_section'|trans }}</option>
                                <option value="required" {{ formData.type == 'required' ? 'selected' : '' }}>{{ 'quiz_form.type_required'|trans }}</option>
                                <option value="bonus" {{ formData.type == 'bonus' ? 'selected' : '' }}>{{ 'quiz_form.type_bonus'|trans }}</option>
                            </select>
                            {% if legacyDirectQuiz %}<input type="hidden" name="type" value="required">{% endif %}
                        </div>
                        <div class="admin-form-field">
                            <label for="quiz-score">{{ 'quiz_form.field_threshold'|trans }}</label>
                            <input class="admin-form-control" id="quiz-score" type="number" min="0" max="100" name="noteMinimale" value="{{ formData.noteMinimale }}" required>
                        </div>
                        <div class="admin-form-field admin-form-field--full" id="section-select-field">
                            <label for="quiz-section">{{ 'quiz_form.field_section'|trans }}</label>
                            <select class="admin-form-control" id="quiz-section" name="sectionId">
                                <option value="">{{ 'quiz_form.select_section'|trans }}</option>
                                {% for section in sections %}
                                    <option value="{{ section.id }}" {{ formData.sectionId == (section.id ~ '') ? 'selected' : '' }}>{{ section.ordre }}. {{ section.titre }}</option>
                                {% endfor %}
                            </select>
                            <small>{{ 'quiz_form.section_help'|trans }}</small>
                        </div>
                    </div>

                    <div class="admin-help-box">{{ 'quiz_form.help'|trans }}</div>

                    <div class="admin-content-card__header" style="margin-top: 24px;">
                        <div><h2>{{ 'quiz_form.questions_heading'|trans }}</h2><p>{{ 'quiz_form.questions_help'|trans }}</p></div>
                        <button type="button" class="admin-secondary-button" id="add-question">{{ 'quiz_form.add_question'|trans }}</button>
                    </div>

                    <div class="admin-question-list" id="question-list">
                        {% import 'site/_quiz_question_card.html.twig' as qcard %}
                        {% for question in formData.questions %}
                            {{ qcard.card(question, loop.index0) }}
                        {% endfor %}
                    </div>

                    <div class="admin-form-actions">
                        <a class="admin-secondary-button" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#quizzes">{{ 'common.cancel'|trans }}</a>
                        <button class="admin-save-button" type="submit">{{ (isNew ? 'quiz_form.create' : 'quiz_form.save')|trans }}</button>
                    </div>
                </form>
            </section>
        </div>
    </main>

    {% import 'site/_quiz_question_card.html.twig' as qcard %}
    {# ⚠️ Les gabarits de NOUVELLE question et de NOUVELLE réponse sortent de la
       MÊME macro que les questions enregistrées : c'était la divergence entre
       deux copies écrites à la main qui laissait les réponses existantes sans
       leur repère de renumérotation. #}
    <template id="question-template">{{ qcard.card({text: '', kind: 'choice', choices: []}, null) }}</template>
    <template id="choice-template">{{ qcard.choice_row({text: '', correct: false}, null, null) }}</template>

    <script src="{{ asset('js/main.js') ~ '?v=' ~ js_version }}"></script>
    <script>
        (() => {
            const list = document.getElementById('question-list');
            const questionTemplate = document.getElementById('question-template');
            const choiceTemplate = document.getElementById('choice-template');
            const addQuestionButton = document.getElementById('add-question');
            const typeSelect = document.getElementById('quiz-type');
            const sectionField = document.getElementById('section-select-field');

            if (!list || !questionTemplate || !choiceTemplate) return;

            /*
             * 🔴 S182d — la renumérotation retrouve CHAQUE champ par son repère
             * `data-*`, jamais par son type HTML. L'ancienne cherchait le texte
             * d'une réponse par `[data-choice-text], input[type="text"]` : les
             * réponses déjà enregistrées n'avaient ni l'un ni l'autre, et
             * supprimer une ligne décalait la case « bonne réponse » sur la
             * mauvaise réponse, sans message.
             */
            const reindex = () => {
                [...list.querySelectorAll('[data-question-card]')].forEach((card, q) => {
                    const number = card.querySelector('[data-question-number]');
                    if (number) number.textContent = String(q + 1);
                    card.querySelector('[data-question-text]').name = `questions[${q}][text]`;
                    card.querySelector('[data-question-kind]').name = `questions[${q}][kind]`;

                    [...card.querySelectorAll('[data-choice-row]')].forEach((row, c) => {
                        row.querySelector('[data-choice-correct]').name = `questions[${q}][choices][${c}][correct]`;
                        row.querySelector('[data-choice-text]').name = `questions[${q}][choices][${c}][text]`;
                        const rank = row.querySelector('[data-choice-rank]');
                        if (rank) rank.textContent = String(c + 1);
                    });
                });
            };

            // Le minimum de lignes dépend du type : deux réponses pour un choix,
            // deux étapes pour un ordre, UNE réponse acceptée pour une réponse courte.
            const minimumChoices = (card) => (card.dataset.kind === 'short' ? 1 : 2);

            const addChoice = (card, checked = false) => {
                const fragment = choiceTemplate.content.cloneNode(true);
                const row = fragment.querySelector('[data-choice-row]');
                const checkbox = fragment.querySelector('[data-choice-correct]');
                if (checkbox) checkbox.checked = checked;
                card.querySelector('[data-choice-list]').appendChild(fragment);
                reindex();
                return row;
            };

            const addQuestion = () => {
                const fragment = questionTemplate.content.cloneNode(true);
                const card = fragment.querySelector('[data-question-card]');
                list.appendChild(fragment);
                addChoice(card, true);
                addChoice(card, false);
                reindex();
            };

            list.addEventListener('change', (event) => {
                const target = event.target;
                if (target instanceof HTMLSelectElement && target.matches('[data-question-kind]')) {
                    const card = target.closest('[data-question-card]');
                    card.dataset.kind = target.value;
                    while (card.querySelectorAll('[data-choice-row]').length < minimumChoices(card)) {
                        addChoice(card);
                    }
                }
            });

            list.addEventListener('click', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) return;
                const button = target.closest('button');
                if (!button) return;
                const card = button.closest('[data-question-card]');

                if (button.matches('[data-add-choice]')) {
                    addChoice(card);
                }
                if (button.matches('[data-remove-choice]')) {
                    if (card.querySelectorAll('[data-choice-row]').length > minimumChoices(card)) {
                        button.closest('[data-choice-row]').remove();
                    }
                    reindex();
                }
                if (button.matches('[data-move-choice]')) {
                    // Pour « remettre dans l'ordre » : l'auteur corrige l'ordre
                    // sans retaper les étapes.
                    const row = button.closest('[data-choice-row]');
                    const sibling = button.dataset.moveChoice === 'up' ? row.previousElementSibling : row.nextElementSibling;
                    if (sibling) {
                        if (button.dataset.moveChoice === 'up') sibling.before(row); else sibling.after(row);
                        reindex();
                        button.focus();
                    }
                }
                if (button.matches('[data-remove-question]')) {
                    if (list.querySelectorAll('[data-question-card]').length > 1) {
                        card.remove();
                    }
                    reindex();
                }
            });

            addQuestionButton?.addEventListener('click', addQuestion);

            const updateSectionVisibility = () => {
                if (!typeSelect || !sectionField) return;
                sectionField.hidden = typeSelect.value !== 'section';
            };
            typeSelect?.addEventListener('change', updateSectionVisibility);
            updateSectionVisibility();
            reindex();
        })();
    </script>
{% endblock %}
