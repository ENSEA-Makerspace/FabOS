{% extends 'site/base_public.html.twig' %}

{% block title %}{{ event.titre }} - FabOS{% endblock %}

{#
   ⚠️ **The page has two shapes, and the artwork picks which.** `EventArtwork`
   measures the uploaded file and says `poster` (portrait) or `banner`
   (landscape, or nothing uploaded at all); the reasoning lives in that class and
   is not repeated here. What this file owns is the consequence:

     poster  the image is a finished design — its title and date are already
             printed inside it. So it is shown WHOLE, portrait, never cropped,
             and the page's own words go UNDERNEATH it.
     banner  the image is a photograph and carries no words, so the page writes
             them OVER it and the result reads as a poster.

   The words themselves are identical in both — that is what the `titleblock`
   macro below is for. One block, two positions; adding a field must not mean
   remembering to add it twice.
#}

{% macro titleblock(event, location, over, past) %}
    {# ⚠️ Imported INSIDE the macro. A macro does not inherit the template's own
       imports — a `{% from %}` at the top of the file is invisible in here, and
       the failure is an "unknown function" at render time, not at lint time. #}
    {% from 'site/_admin_inline.html.twig' import admin_actions %}
    {% set sameDay = event.dateFin is null or event.dateFin|date('Y-m-d') == event.dateDebut|date('Y-m-d') %}
    <div class="ev-title {{ over ? 'is-over' : '' }}">
        <p class="ev-kicker">
            <span class="ev-kicker__mark" aria-hidden="true">🗓</span>
            {#- A multi-day event has to name both days, or "2 août 14:00 – 18:00"
                quietly loses the fact that it runs all weekend. -#}
            {{ event.dateDebut|loc_date('EEEE d MMMM') }} · {{ event.dateDebut|date('H:i') }}
            {%- if event.dateFin %} – {% if not sameDay %}{{ event.dateFin|loc_date('EEEE d MMMM') }} · {% endif %}{{ event.dateFin|date('H:i') }}{% endif %}
        </p>
        <h1 class="ev-h1">{{ event.titre }}{{ admin_actions([
            { route: 'app_admin_event_edit', params: { id: event.id }, label: 'admin_inline.edit'|trans },
            { route: 'app_admin_event_registrations', params: { id: event.id }, label: 'admin_inline.registrations'|trans }
        ]) }}</h1>
        <div class="ev-chips">
            {% if location.label %}
                <span class="ev-chip"><span aria-hidden="true">📍</span>{{ location.label }}</span>
            {% endif %}
            {% if event.cancelled %}
                <span class="ev-chip is-stop">{{ 'event.called_off.banner'|trans }}</span>
            {#- ⚠️ `past` comes in as a parameter and is NOT re-derived here.
                `event.registrationOpen` compares against the server instant while
                the date beside it is wall-clock, so this chip could contradict
                the panel below it and the card that linked here (S139d). -#}
            {% elseif not past %}
                {% set days = date(event.dateDebut).diff(date()).days %}
                <span class="ev-chip is-go">
                    <span aria-hidden="true">⏳</span>
                    {% if days == 0 %}{{ 'event.hero.today'|trans }}{% else %}{{ 'event.hero.in_days'|trans({'%days%': days}) }}{% endif %}
                </span>
            {% else %}
                <span class="ev-chip is-muted">{{ 'event.hero.past'|trans }}</span>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% import _self as ev %}

{% block page_styles %}
    <style>
        /* The line warning a member that their place also enrols them in the
           training (S146e). Quiet, and above the button it qualifies — never a
           colour that reads as an error, because nothing is wrong.
           ⚠️ Here rather than in `calendar-modern.css`: this page does not load
           that sheet, so the rule would simply never have applied. */
        .ev-session-note { margin: 0 0 12px; font-size: .88rem; color: var(--color-text-light); }

        /* Theme variables throughout: this page is public and a signed-in
           visitor arrives with their own light/dark preference. */
        {# ⚠️ The ground goes on the full-bleed wrapper, never on `.ev-wrap`:
           that one is width-capped at 1040px, so painting the ground there
           draws a stripe down the middle of the page with `--color-bg` either
           side of it. Same trap `.ml-wrap` set in S83, which is why `.ml-page`
           exists. In dark the blanket `:is(.main-content, …)` rule already
           resolves to `--surface-ground`, so this only adds the light half. #}
        .ev-page { background: var(--surface-ground); }
        .ev-wrap { max-width: 1040px; margin: 0 auto; padding: 0 20px 72px; }

        /* ---- The words, once ---------------------------------------------
           Two positions (under the poster, over the banner) and one set of
           rules. `.is-over` only changes colour and shadow — never the layout,
           so the two shapes cannot drift apart. */
        .ev-title { margin: 22px 0 26px; }
        .ev-kicker { display: flex; align-items: center; gap: 8px; margin: 0 0 6px; font-size: 13.5px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: var(--color-primary); }
        .ev-h1 { margin: 0 0 12px; font-size: clamp(26px, 4.6vw, 42px); line-height: 1.1; letter-spacing: -.015em; }
        .ev-chips { display: flex; flex-wrap: wrap; gap: 8px; }
        .ev-chip { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; font-size: 12.5px; font-weight: 700; background: var(--color-bg-light); border: 1px solid var(--border-color); color: var(--color-text); }
        .ev-chip.is-go { background: rgba(34,197,94,.14); border-color: rgba(34,197,94,.3); color: #15803d; }
        .ev-chip.is-stop { background: rgba(239,68,68,.14); border-color: rgba(239,68,68,.3); color: #b91c1c; }
        .ev-chip.is-muted { color: var(--color-text-light); }
        html[data-theme="dark"] .ev-chip.is-go { color: #86efac; }
        html[data-theme="dark"] .ev-chip.is-stop { color: #fca5a5; }

        .ev-title.is-over { position: absolute; left: 0; right: 0; bottom: 0; margin: 0; padding: 26px 28px; color: #fff; z-index: 1; }
        .ev-title.is-over .ev-kicker { color: rgba(255,255,255,.9); }
        .ev-title.is-over .ev-h1 { color: #fff; text-shadow: 0 2px 18px rgba(0,0,0,.5); }
        .ev-title.is-over .ev-chip { background: rgba(255,255,255,.16); border-color: rgba(255,255,255,.3); color: #fff; backdrop-filter: blur(6px); }
        .ev-title.is-over .ev-chip.is-go { background: rgba(34,197,94,.34); border-color: rgba(255,255,255,.34); color: #fff; }
        .ev-title.is-over .ev-chip.is-stop { background: rgba(239,68,68,.4); border-color: rgba(255,255,255,.34); color: #fff; }
        @media (max-width: 620px) { .ev-title.is-over { padding: 18px 18px 20px; } }

        /* ---- Banner: photo, words laid over it ---------------------------- */
        .ev-hero { position: relative; border-radius: 20px; overflow: hidden; margin: 20px 0 28px; border: 1px solid var(--border-color); background: var(--theme-surface); }
        .ev-hero__media { position: relative; aspect-ratio: 21 / 9; background: linear-gradient(135deg, #9E1B56 0%, #7a1542 60%, #55102e 100%); overflow: hidden; }
        .ev-hero__media img { width: 100%; height: 100%; object-fit: cover; display: block; transform-origin: 52% 46%; animation: evDrift 26s ease-in-out infinite alternate; }
        /* Scrim so white text stays legible over any photograph. */
        .ev-hero__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.02) 0%, rgba(0,0,0,.36) 52%, rgba(0,0,0,.76) 100%); }
        .ev-hero__noposter { position: absolute; inset: 0; display: grid; place-items: center; font-size: 68px; opacity: .22; }
        @media (max-width: 620px) { .ev-hero__media { aspect-ratio: 4 / 3; } }

        /* ---- Poster: the design shown whole ------------------------------
           ⚠️ `object-fit: contain`, and the band behind it is a blurred, scaled
           copy of the same image. A poster cropped to a letterbox loses the very
           thing it was designed to say, and a portrait image in a wide band
           otherwise leaves two grey bars. This is the cinema-lobby treatment and
           it is the whole reason the page has a second shape at all. */
        .ev-stage { position: relative; margin: 20px 0 0; border-radius: 20px; overflow: hidden; border: 1px solid var(--border-color); background: var(--color-bg-light); }
        .ev-stage__wash { position: absolute; inset: -8%; background-size: cover; background-position: center; filter: blur(38px) saturate(1.25) brightness(.82); transform: scale(1.1); }
        html[data-theme="dark"] .ev-stage__wash { filter: blur(38px) saturate(1.15) brightness(.5); }
        .ev-stage__frame { position: relative; display: grid; place-items: center; padding: 30px 20px; }
        .ev-stage__art {
            /* Capped in both directions. Measured at 74vh: the stage came out
               595px tall on a 720px laptop and the event's own title sat below
               the fold — a poster page you have to scroll to learn the name of. */
            display: block; max-width: min(100%, 380px); max-height: min(58vh, 480px); width: auto; height: auto;
            border-radius: 8px; box-shadow: 0 22px 60px rgba(0,0,0,.42), 0 2px 6px rgba(0,0,0,.28);
            animation: evSettle 900ms cubic-bezier(.22,.61,.36,1) both;
        }
        /* One slow sheen across the paper, once, on arrival. It is the only
           thing on this page that moves without the reader doing anything, and
           it is over in under two seconds. */
        .ev-stage__frame::after {
            content: ''; position: absolute; inset: 0; pointer-events: none;
            background: linear-gradient(105deg, transparent 38%, rgba(255,255,255,.22) 48%, transparent 58%);
            background-size: 260% 100%; background-position: 130% 0;
            animation: evSheen 1900ms cubic-bezier(.4,0,.2,1) 520ms 1;
        }
        @media (max-width: 620px) { .ev-stage__frame { padding: 18px 14px; } .ev-stage__art { max-height: 62vh; } }

        /* ---- Layout ----------------------------------------------------- */
        .ev-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(280px, 1fr); gap: 24px; align-items: start; }
        @media (max-width: 860px) { .ev-grid { grid-template-columns: 1fr; } }

        {# S84 — the last surface outside the rule, and the only one of the three
           that was already theme-correct: `--theme-surface` and
           `--border-color` were right. What it had was **no elevation at all**,
           so the cards were flat outlined boxes on a flat page — the shape S83
           named when it separated `--shadow-card` (16/40, wide and faint, reads
           as lift) from `--shadow` (4/6, a button's shadow). #}
        .ev-card { background: var(--theme-surface); border: 1px solid var(--border-color); border-radius: 16px; padding: 22px 24px; margin-bottom: 20px; box-shadow: var(--shadow-card); }
        .ev-card h2 { font-size: 16px; margin: 0 0 14px; letter-spacing: .01em; }
        .ev-body { line-height: 1.75; white-space: pre-line; color: var(--color-text); }

        /* ---- Location --------------------------------------------------- */
        .ev-loc { display: flex; gap: 14px; align-items: flex-start; }
        .ev-loc__pin { flex: none; width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; font-size: 20px; background: rgba(158,27,86,.1); }
        html[data-theme="dark"] .ev-loc__pin { background: rgba(233,140,183,.16); }
        .ev-loc__name { font-weight: 700; }
        .ev-loc__addr { color: var(--color-text-light); font-size: 14px; margin-top: 2px; line-height: 1.5; }
        .ev-tag { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: .02em; margin-bottom: 6px; }
        .ev-tag.onsite { background: rgba(34,197,94,.16); color: #15803d; }
        .ev-tag.offsite { background: rgba(59,130,246,.16); color: #1d4ed8; }
        html[data-theme="dark"] .ev-tag.onsite { color: #86efac; }
        html[data-theme="dark"] .ev-tag.offsite { color: #93c5fd; }
        .ev-directions { display: inline-flex; align-items: center; gap: 7px; margin-top: 12px; padding: 8px 15px; border-radius: 10px; border: 1px solid var(--border-color); color: var(--color-text); text-decoration: none; font-size: 13px; font-weight: 700; transition: transform 160ms ease, border-color 160ms ease; }
        .ev-directions:hover { transform: translateY(-1px); border-color: var(--color-primary); color: var(--color-primary); }

        /* ---- Registration ----------------------------------------------- */
        .ev-reg { position: sticky; top: 20px; }
        .ev-seats { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
        .ev-seats strong { font-size: 26px; font-weight: 800; }
        .ev-seats span { color: var(--color-text-light); font-size: 13px; }
        .ev-meter { height: 6px; border-radius: 999px; background: var(--color-bg-lighter, rgba(128,128,128,.18)); overflow: hidden; margin: 10px 0 16px; }
        /* ⚠️ The width is an inline custom property, not an inline `width`. The
           old rule declared a transition from `width: 0` that nothing ever
           triggered — the element was born at its final width, so the bar never
           actually moved. A keyframe with `backwards` fill does move. */
        .ev-meter__fill { height: 100%; width: var(--ev-pct, 0%); border-radius: 999px; background: linear-gradient(90deg, #9E1B56, #d1477f); animation: evFill 1000ms cubic-bezier(.22,.61,.36,1) 280ms backwards; }
        .ev-meter__fill.full { background: linear-gradient(90deg, #b45309, #f59e0b); }
        .ev-state { display: inline-block; padding: 4px 13px; border-radius: 999px; font-size: 12px; font-weight: 700; margin-bottom: 12px; }
        .ev-state.in { background: rgba(34,197,94,.16); color: #15803d; }
        .ev-state.wait { background: rgba(245,158,11,.16); color: #b45309; }
        html[data-theme="dark"] .ev-state.in { color: #86efac; }
        html[data-theme="dark"] .ev-state.wait { color: #fcd34d; }
        .ev-fields { display: grid; gap: 11px; margin-bottom: 14px; }
        .ev-fields label { font-weight: 700; font-size: 13px; display: block; margin-bottom: 4px; }
        .ev-fields input { width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 10px; background: var(--theme-input); color: var(--color-text); font-size: 14px; transition: border-color 160ms ease, box-shadow 160ms ease; }
        .ev-fields input:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(158,27,86,.14); }
        .ev-btn { width: 100%; padding: 12px 18px; border: none; border-radius: 11px; background: var(--color-primary); color: #fff; font-weight: 700; font-size: 15px; cursor: pointer; transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease; }
        .ev-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(158,27,86,.28); filter: brightness(1.05); }
        .ev-btn.ghost { background: none; color: var(--color-text); border: 1px solid var(--border-color); }
        .ev-btn.ghost:hover { border-color: var(--color-primary); color: var(--color-primary); box-shadow: none; }
        .ev-note { color: var(--color-text-light); font-size: 12.5px; line-height: 1.55; margin: 11px 0 0; }
        .ev-flash { padding: 11px 15px; border-radius: 10px; margin-bottom: 14px; font-size: 14px; }
        .ev-flash.success { background: rgba(34,197,94,.16); color: #15803d; }
        .ev-flash.error { background: rgba(239,68,68,.16); color: #b91c1c; }
        html[data-theme="dark"] .ev-flash.success { color: #86efac; }
        html[data-theme="dark"] .ev-flash.error { color: #fca5a5; }
        /* ⚠️ `.ev-cancelled` became `.ev-notice` + a TONE (S139e). A past event
           needed the same full-width banner and the operator found the chip "rather
           small"; adding a second banner class would have been two things to restyle.
           The tone names are the ones the chips beside it already use — `is-stop`,
           `is-muted` — so the page has one signal vocabulary rather than two. */
        .ev-notice { border-radius: 14px; padding: 16px 20px; margin-bottom: 22px; line-height: 1.6; }
        .ev-notice strong { display: block; font-size: 19px; letter-spacing: -.01em; }
        .ev-notice.is-stop { background: rgba(239,68,68,.12); color: #b91c1c; }
        /* ⚠️ `is-accent`, and deliberately NOT one of the traffic-light signals.
           The operator found the grey version "unremarkable" — but a finished event
           is not an error (red), not a warning (amber) and not availability (green),
           and borrowing one of those to get attention is exactly how a signal
           vocabulary stops meaning anything. The accent is the fourth thing the
           design system has: brand, not signal. `--tone-primary-soft` (S83) is the
           accent at 12% over the surface, so it inherits a themed install's own
           colour instead of pinning FabOS magenta. The left bar carries the weight;
           the tint only has to be noticed. */
        .ev-notice.is-accent { background: var(--tone-primary-soft); border: 1px solid color-mix(in srgb, var(--color-primary) 26%, transparent); border-left: 5px solid var(--color-primary); color: var(--color-text); }
        .ev-notice.is-accent strong { color: var(--color-primary-text); }
        html[data-theme="dark"] .ev-notice.is-stop { color: #fca5a5; }

        /* ⚠️ The same recession the catalogue card uses (`.ml-card.is-spent`), so a
           finished event looks finished in the list AND on its own page. Both hero
           shapes are covered — the poster stage and its blurred wash, and the banner.
           Grayscale AND opacity: opacity alone muddies a poster on dark, grayscale
           alone leaves it just as loud. */
        .ev-page.is-spent :is(.ev-stage__art, .ev-hero__media img) { filter: grayscale(1); opacity: .7; }
        .ev-page.is-spent .ev-stage__wash { filter: blur(38px) grayscale(1) brightness(.7); }

        /* ---- Motion ------------------------------------------------------
           Small staggered entrance. Disabled wholesale for anyone who asked
           for reduced motion — the page must not move for them at all. */
        .ev-rise { opacity: 0; transform: translateY(14px); animation: evRise 620ms cubic-bezier(.22,.61,.36,1) forwards; }
        .ev-rise-1 { animation-delay: 60ms; }
        .ev-rise-2 { animation-delay: 130ms; }
        .ev-rise-3 { animation-delay: 200ms; }
        .ev-chips .ev-chip { opacity: 0; animation: evRise 520ms cubic-bezier(.22,.61,.36,1) forwards; }
        .ev-chips .ev-chip:nth-child(1) { animation-delay: 260ms; }
        .ev-chips .ev-chip:nth-child(2) { animation-delay: 330ms; }
        .ev-chips .ev-chip:nth-child(3) { animation-delay: 400ms; }
        @keyframes evRise { to { opacity: 1; transform: none; } }
        @keyframes evFill { from { width: 0; } }
        @keyframes evSettle { from { opacity: 0; transform: translateY(10px) scale(.985); } to { opacity: 1; transform: none; } }
        @keyframes evSheen { from { background-position: 130% 0; } to { background-position: -60% 0; } }
        @keyframes evDrift { from { transform: scale(1.03); } to { transform: scale(1.09); } }
        @media (prefers-reduced-motion: reduce) {
            .ev-rise, .ev-chips .ev-chip { animation: none; opacity: 1; transform: none; }
            .ev-stage__art { animation: none; }
            .ev-stage__frame::after { animation: none; background: none; }
            .ev-hero__media img { animation: none; transform: scale(1.03); }
            .ev-meter__fill { animation: none; }
            .ev-btn, .ev-directions { transition: none; }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="main-content ev-page{{ past ? ' is-spent' : '' }}">
        <div class="ev-wrap">
            {# The inline `padding-top:18px` this carried moved to `.breadcrumb-inset`
               in details.css — the shell emits one markup shape and cannot take a
               style attribute, which is the point. #}
            <div class="breadcrumb-inset">
                {% include 'site/_breadcrumb.html.twig' with {trail: [
                    {label: 'nav.home'|trans, url: path('app_home')},
                    {label: 'nav.events'|trans, url: path('app_events')},
                    {label: event.titre},
                ]} only %}
            </div>

            {% if artwork.kind == 'poster' %}
                <header class="ev-stage ev-rise">
                    {# The wash is decorative — the same picture, blurred, purely to
                       fill the band. It is a background rather than a second <img>
                       so no screen reader announces the poster twice. #}
                    <div class="ev-stage__wash" style="background-image: url('{{ asset(artwork.thumb) }}');" aria-hidden="true"></div>
                    <div class="ev-stage__frame">
                        <img class="ev-stage__art" src="{{ asset(artwork.thumb) }}"
                             width="{{ artwork.width }}" height="{{ artwork.height }}"
                             alt="{{ 'event.poster_alt'|trans({'%event%': event.titre}) }}">
                    </div>
                </header>
                {{ ev.titleblock(event, location, false, past) }}
            {% else %}
                <header class="ev-hero ev-rise">
                    <div class="ev-hero__media">
                        {% if artwork.has %}
                            <img src="{{ asset(artwork.thumb) }}" alt="" width="{{ artwork.width }}" height="{{ artwork.height }}">
                        {% else %}
                            {# No artwork at all: the brand gradient carries it, with a quiet glyph. #}
                            <div class="ev-hero__noposter">🎉</div>
                        {% endif %}
                        {{ ev.titleblock(event, location, true, past) }}
                    </div>
                </header>
            {% endif %}

            {#- ⚠️ One banner element, two tones. A cancelled event and a finished
                one are both facts the reader must not miss, and the chip in the hero
                was too quiet for either (operator, 2026-08-16). Cancelled wins when
                both could apply: it is the more surprising fact. -#}
            {% if event.cancelled %}
                <div class="ev-notice is-stop ev-rise ev-rise-1">
                    <strong>{{ 'event.called_off.banner'|trans }}</strong>
                    {% if event.cancellationReason %}{{ event.cancellationReason }}{% endif %}
                </div>
            {% elseif past %}
                <div class="ev-notice is-accent ev-rise ev-rise-1">
                    <strong>{{ 'event.hero.past'|trans }}</strong>
                    {{ 'event.registration.over'|trans }}
                </div>
            {% endif %}

            <div class="ev-grid">
                <div>
                    {% if event.description %}
                        <section class="ev-card ev-rise ev-rise-1">
                            <h2>{{ 'event.about'|trans }}</h2>
                            <div class="ev-body">{{ event.description }}</div>
                        </section>
                    {% endif %}

                    {% if location.hasAnything %}
                        <section class="ev-card ev-rise ev-rise-2">
                            <h2>{{ 'event.where'|trans }}</h2>
                            <div class="ev-loc">
                                <div class="ev-loc__pin">📍</div>
                                <div>
                                    <span class="ev-tag {{ location.onsite ? 'onsite' : 'offsite' }}">
                                        {{ (location.onsite ? 'event.location.onsite' : 'event.location.offsite')|trans }}
                                    </span>
                                    {% if location.label %}<div class="ev-loc__name">{{ location.label }}</div>{% endif %}
                                    {% if location.address %}<div class="ev-loc__addr">{{ location.address }}</div>{% endif %}
                                    {% if location.directionsUrl %}
                                        <a class="ev-directions" href="{{ location.directionsUrl }}" target="_blank" rel="noopener noreferrer">
                                            🧭 {{ 'event.location.directions'|trans }}
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </section>
                    {% endif %}
                </div>

                {% if feature_enabled('events') and not event.cancelled %}
                    <aside class="ev-reg">
                        <section class="ev-card ev-rise ev-rise-2">
                            {#- ⚠️ "Inscription" was the last live-sounding word left on a
                                finished event's page: the panel below it now says
                                attendance and "this took place", under a heading that
                                still invited you to sign up. A past event's panel is
                                about participation, not registration. -#}
                            <h2>{{ (past ? 'event.registration.title_past' : 'event.registration.title')|trans }}</h2>

                            {% for message in app.flashes('success') %}<div class="ev-flash success">{{ message|flash_text }}</div>{% endfor %}
                            {% for message in app.flashes('error') %}<div class="ev-flash error">{{ message|flash_text }}</div>{% endfor %}

                            {#- 🔴 A past event showed all of this: a seats-left
                                number, an animated fill meter, a waiting-list
                                count. The operator's report — "the mention that
                                it is in the past is small and the registrations
                                still look current" — was mostly THIS panel, not
                                the catalogue card. A number of free seats and a
                                filling bar are the vocabulary of something you
                                can still join.

                                What a past event owes the reader is how many
                                came, not how many could still come. So: the
                                attendance figure, flat, and no meter. -#}
                            {% if past %}
                                <div class="ev-seats">
                                    <strong>{{ seatsTaken }}</strong>
                                    <span>{{ 'event.registration.attended'|trans }}</span>
                                </div>
                            {% elseif seatsRemaining is null %}
                                <div class="ev-seats"><strong>{{ seatsTaken }}</strong><span>{{ 'event.registration.seats_unlimited_short'|trans }}</span></div>
                            {% else %}
                                <div class="ev-seats">
                                    <strong>{{ seatsRemaining }}</strong>
                                    <span>{{ 'event.registration.seats_left'|trans({'%total%': event.capacite}) }}</span>
                                </div>
                                {% set pct = event.capacite > 0 ? (seatsTaken / event.capacite * 100)|round : 0 %}
                                <div class="ev-meter">
                                    <div class="ev-meter__fill {{ seatsRemaining == 0 ? 'full' : '' }}" style="--ev-pct: {{ pct > 100 ? 100 : pct }}%;"></div>
                                </div>
                            {% endif %}

                            {#- ⚠️ The waiting list is only news while there is
                                something to wait FOR. -#}
                            {% if waitlistCount > 0 and not past %}
                                <p class="ev-note" style="margin-top:0;">{{ 'event.registration.waiting'|trans({'%count%': waitlistCount}) }}</p>
                            {% endif %}

                            {% if myRegistration and not myRegistration.cancelled %}
                                <span class="ev-state {{ myRegistration.waitlisted ? 'wait' : 'in' }}">
                                    {{ (myRegistration.waitlisted ? 'event.registration.state_waitlisted' : 'event.registration.state_registered')|trans }}
                                </span>
                                {#- ⚠️ The state chip stays on a past event — it is the
                                    member's own record that they had a place. The CANCEL
                                    button does not: you cannot withdraw from something
                                    that already happened, and a live-looking button that
                                    can only fail is worse than no button. -#}
                                {% if not past %}
                                    <form method="post" action="{{ path('app_event_registration_cancel_own', {registration: myRegistration.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('event_cancel_' ~ myRegistration.id) }}">
                                        <button type="submit" class="ev-btn ghost">{{ 'event.registration.cancel'|trans }}</button>
                                    </form>
                                {% endif %}

                            {#- ⚠️ `past` is handled by saying NOTHING here. The banner
                                at the top of the page already says "Événement passé —
                                cet événement a eu lieu", and this panel is headed
                                "Participation" with an attendance figure: the fact is
                                stated twice within one screen otherwise, which on mobile
                                stacks into the same sentence repeated.

                                It still has to come BEFORE `not registrationOpen`, whose
                                "inscriptions fermées" is registration vocabulary — a
                                closed registration is a thing that was recently open,
                                which is precisely why a finished event read as current. -#}
                            {% elseif past %}

                            {% elseif not registrationOpen %}
                                <p class="ev-note">{{ 'event.registration.closed'|trans }}</p>

                            {% elseif app.user and usageRight and not usageRight.allowed %}
                                {% include 'site/_usage_right_state.html.twig' with {
                                    capability: usageRight.capability,
                                    verdict: usageRight,
                                    action: {label: 'usage_rights.my_rights'|trans, url: path('app_profile') ~ '#usage-rights'}
                                } only %}

                            {% elseif app.user %}
                                {# 🔴 **Said BEFORE the button, not after the click** (S146e).
                                   Taking this place also enrols the member in the training,
                                   which is a second consequence of one button: a member who
                                   only learns of it from the confirmation has been signed up
                                   for something they did not knowingly choose.
                                   ⚠️ And it states the limit in the same breath — attending
                                   certifies nothing, a trainer validates. Guests see nothing
                                   of this: with no account there is nothing to enrol. #}
                                {% if event.formation %}
                                    <p class="ev-session-note">{{ 'event.registration.session_enrols'|trans({'%formation%': event.formation.titre}) }}</p>
                                {% endif %}
                                <form method="post" action="{{ path('app_event_register', {id: event.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('event_register_' ~ event.id) }}">
                                    <button type="submit" class="ev-btn">
                                        {{ (seatsRemaining == 0 ? 'event.registration.join_waitlist' : 'event.registration.register')|trans }}
                                    </button>
                                </form>

                            {% elseif event.guestsAllowed %}
                                <form method="post" action="{{ path('app_event_register', {id: event.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('event_register_' ~ event.id) }}">
                                    <div class="ev-fields">
                                        <div>
                                            <label for="reg-name">{{ 'event.registration.your_name'|trans }}</label>
                                            <input type="text" name="name" id="reg-name" maxlength="180" required>
                                        </div>
                                        <div>
                                            <label for="reg-email">{{ 'event.registration.your_email'|trans }}</label>
                                            <input type="email" name="email" id="reg-email" maxlength="180" required>
                                        </div>
                                    </div>
                                    <button type="submit" class="ev-btn">
                                        {{ (seatsRemaining == 0 ? 'event.registration.join_waitlist' : 'event.registration.register')|trans }}
                                    </button>
                                    <p class="ev-note">{{ 'event.registration.guest_note'|trans }}</p>
                                </form>

                            {% else %}
                                <p class="ev-note" style="margin-top:0;">{{ 'event.registration.members_only'|trans }}</p>
                                <a class="ev-btn" style="display:block; text-align:center; text-decoration:none;" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
                            {% endif %}
                        </section>
                    </aside>
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}
