{% extends 'site/base_public.html.twig' %}

{% block title %}{{ event.titre }} - FabOS{% endblock %}

{#
   ⚠️ **The page has two shapes, and the artwork picks which.** `EventArtwork`
   measures the uploaded file and says `poster` (portrait) or `banner`
   (landscape, or nothing uploaded at all); the reasoning lives in that class and
   is not repeated here. What this file owns is the consequence:

     poster  the image is a finished design — its title and date are already
             printed inside it. So it is shown WHOLE, portrait, never cropped,
             and the page's own words go UNDERNEATH it.
     banner  the image is a photograph and carries no words, so the page writes
             them OVER it and the result reads as a poster.

   The words themselves are identical in both — that is what the `titleblock`
   macro below is for. One block, two positions; adding a field must not mean
   remembering to add it twice.
#}

{% macro titleblock(event, location, over, past) %}
    {# ⚠️ Imported INSIDE the macro. A macro does not inherit the template's own
       imports — a `{% from %}` at the top of the file is invisible in here, and
       the failure is an "unknown function" at render time, not at lint time. #}
    {% from 'site/_admin_inline.html.twig' import admin_actions %}
    {% set sameDay = event.dateFin is null or event.dateFin|date('Y-m-d') == event.dateDebut|date('Y-m-d') %}
    <div class="ev-title {{ over ? 'is-over' : '' }}">
        <p class="ev-kicker">
            <span class="ev-kicker__mark" aria-hidden="true">{% include 'site/_icon.html.twig' with { name: 'calendar' } only %}</span>
            {#- A multi-day event has to name both days, or "2 août 14:00 – 18:00"
                quietly loses the fact that it runs all weekend. -#}
            {{ event.dateDebut|loc_date('EEEE d MMMM') }} · {{ event.dateDebut|date('H:i') }}
            {%- if event.dateFin %} – {% if not sameDay %}{{ event.dateFin|loc_date('EEEE d MMMM') }} · {% endif %}{{ event.dateFin|date('H:i') }}{% endif %}
        </p>
        <h1 class="ev-h1">{{ event.titre }}{{ admin_actions([
            { route: 'app_admin_event_edit', params: { id: event.id }, label: 'admin_inline.edit'|trans },
            { route: 'app_admin_event_registrations', params: { id: event.id }, label: 'admin_inline.registrations'|trans }
        ]) }}</h1>
        <div class="ev-chips">
            {% if location.label %}
                <span class="ev-chip"><span aria-hidden="true">{% include 'site/_icon.html.twig' with { name: 'pin' } only %}</span>{{ location.label }}</span>
            {% endif %}
            {% if event.cancelled %}
                <span class="ev-chip is-stop">{{ 'event.called_off.banner'|trans }}</span>
            {#- ⚠️ `past` comes in as a parameter and is NOT re-derived here.
                `event.registrationOpen` compares against the server instant while
                the date beside it is wall-clock, so this chip could contradict
                the panel below it and the card that linked here (S139d). -#}
            {% elseif not past %}
                {% set days = date(event.dateDebut).diff(date()).days %}
                <span class="ev-chip is-go">
                    {% include 'site/_icon.html.twig' with { name: 'hourglass' } only %}
                    {% if days == 0 %}{{ 'event.hero.today'|trans }}{% else %}{{ 'event.hero.in_days'|trans({'days': days}) }}{% endif %}
                </span>
            {% else %}
                <span class="ev-chip is-muted">{{ 'event.hero.past'|trans }}</span>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% import _self as ev %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('css/event-detail.css') ~ '?v=20260822-s149a' }}">
{% endblock %}

{% block body %}
    <main id="main-content" tabindex="-1" class="main-content ev-page{{ past ? ' is-spent' : '' }}">
        <div class="ev-wrap">
            {# The inline `padding-top:18px` this carried moved to `.breadcrumb-inset`
               in details.css — the shell emits one markup shape and cannot take a
               style attribute, which is the point. #}
            <div class="breadcrumb-inset">
                {% include 'site/_breadcrumb.html.twig' with {trail: [
                    {label: 'nav.home'|trans, url: path('app_home')},
                    {label: 'nav.events'|trans, url: path('app_events')},
                    {label: event.titre},
                ]} only %}
            </div>

            {% if artwork.kind == 'poster' %}
                <header class="ev-stage ev-rise">
                    {# The wash is decorative — the same picture, blurred, purely to
                       fill the band. It is a background rather than a second <img>
                       so no screen reader announces the poster twice. #}
                    <div class="ev-stage__wash" style="background-image: url('{{ asset(artwork.thumb) }}');" aria-hidden="true"></div>
                    <div class="ev-stage__frame">
                        <img class="ev-stage__art" src="{{ asset(artwork.thumb) }}"
                             width="{{ artwork.width }}" height="{{ artwork.height }}"
                             alt="{{ 'event.poster_alt'|trans({'%event%': event.titre}) }}">
                    </div>
                </header>
                {{ ev.titleblock(event, location, false, past) }}
            {% else %}
                <header class="ev-hero ev-rise">
                    <div class="ev-hero__media">
                        {% if artwork.has %}
                            <img src="{{ asset(artwork.thumb) }}" alt="" width="{{ artwork.width }}" height="{{ artwork.height }}">
                        {% else %}
                            {# No artwork at all: the brand gradient carries it, with a quiet glyph. #}
                            <div class="ev-hero__noposter">{% include 'site/_icon.html.twig' with { name: 'image' } only %}</div>
                        {% endif %}
                        {{ ev.titleblock(event, location, true, past) }}
                    </div>
                </header>
            {% endif %}

            {#- ⚠️ One banner element, two tones. A cancelled event and a finished
                one are both facts the reader must not miss, and the chip in the hero
                was too quiet for either (operator, 2026-08-16). Cancelled wins when
                both could apply: it is the more surprising fact. -#}
            {% if event.cancelled %}
                <div class="ev-notice is-stop ev-rise ev-rise-1">
                    <strong>{{ 'event.called_off.banner'|trans }}</strong>
                    {% if event.cancellationReason %}{{ event.cancellationReason }}{% endif %}
                </div>
            {% elseif past %}
                <div class="ev-notice is-accent ev-rise ev-rise-1">
                    <strong>{{ 'event.hero.past'|trans }}</strong>
                    {{ 'event.registration.over'|trans }}
                </div>
            {% endif %}

            <div class="ev-grid">
                <div>
                    {% if event.description %}
                        <section class="ev-card ev-rise ev-rise-1">
                            <h2>{{ 'event.about'|trans }}</h2>
                            <div class="ev-body">{{ event.description }}</div>
                        </section>
                    {% endif %}

                    {% if location.hasAnything %}
                        <section class="ev-card ev-rise ev-rise-2">
                            <h2>{{ 'event.where'|trans }}</h2>
                            <div class="ev-loc">
                                <div class="ev-loc__pin" aria-hidden="true">{% include 'site/_icon.html.twig' with { name: 'pin' } only %}</div>
                                <div>
                                    <span class="ev-tag {{ location.onsite ? 'onsite' : 'offsite' }}">
                                        {{ (location.onsite ? 'event.location.onsite' : 'event.location.offsite')|trans }}
                                    </span>
                                    {% if location.label %}<div class="ev-loc__name">{{ location.label }}</div>{% endif %}
                                    {% if location.address %}<div class="ev-loc__addr">{{ location.address }}</div>{% endif %}
                                    {% if location.directionsUrl %}
                                        <a class="ev-directions" href="{{ location.directionsUrl }}" target="_blank" rel="noopener noreferrer">
                                            <span aria-hidden="true">{% include 'site/_icon.html.twig' with { name: 'compass' } only %}</span> {{ 'event.location.directions'|trans }}
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </section>
                    {% endif %}
                </div>

                {% if feature_enabled('events') and not event.cancelled %}
                    <aside class="ev-reg">
                        <section class="ev-card ev-rise ev-rise-2">
                            {#- ⚠️ "Inscription" was the last live-sounding word left on a
                                finished event's page: the panel below it now says
                                attendance and "this took place", under a heading that
                                still invited you to sign up. A past event's panel is
                                about participation, not registration. -#}
                            <h2>{{ (past ? 'event.registration.title_past' : 'event.registration.title')|trans }}</h2>

                            {% for message in app.flashes('success') %}<div class="ev-flash success">{{ message|flash_text }}</div>{% endfor %}
                            {% for message in app.flashes('error') %}<div class="ev-flash error">{{ message|flash_text }}</div>{% endfor %}

                            {#- 🔴 A past event showed all of this: a seats-left
                                number, an animated fill meter, a waiting-list
                                count. The operator's report — "the mention that
                                it is in the past is small and the registrations
                                still look current" — was mostly THIS panel, not
                                the catalogue card. A number of free seats and a
                                filling bar are the vocabulary of something you
                                can still join.

                                What a past event owes the reader is how many
                                came, not how many could still come. So: the
                                attendance figure, flat, and no meter. -#}
                            {% if past %}
                                <div class="ev-seats">
                                    <strong>{{ seatsTaken }}</strong>
                                    <span>{{ 'event.registration.attended'|trans({'count': seatsTaken}) }}</span>
                                </div>
                            {% elseif seatsRemaining is null %}
                                <div class="ev-seats"><strong>{{ seatsTaken }}</strong><span>{{ 'event.registration.seats_unlimited_short'|trans({'count': seatsTaken}) }}</span></div>
                            {% else %}
                                <div class="ev-seats">
                                    <strong>{{ seatsRemaining }}</strong>
                                    <span>{{ 'event.registration.seats_left'|trans({'count': seatsRemaining, 'total': event.capacite}) }}</span>
                                </div>
                                {% set pct = event.capacite > 0 ? (seatsTaken / event.capacite * 100)|round : 0 %}
                                <div class="ev-meter">
                                    <div class="ev-meter__fill {{ seatsRemaining == 0 ? 'full' : '' }}" style="--ev-pct: {{ pct > 100 ? 100 : pct }}%;"></div>
                                </div>
                            {% endif %}

                            {#- ⚠️ The waiting list is only news while there is
                                something to wait FOR. -#}
                            {% if waitlistCount > 0 and not past %}
                                <p class="ev-note" style="margin-top:0;">{{ 'event.registration.waiting'|trans({'%count%': waitlistCount}) }}</p>
                            {% endif %}

                            {% if myRegistration and not myRegistration.cancelled %}
                                <span class="ev-state {{ myRegistration.waitlisted ? 'wait' : 'in' }}">
                                    {{ (myRegistration.waitlisted ? 'event.registration.state_waitlisted' : 'event.registration.state_registered')|trans }}
                                </span>
                                {#- ⚠️ The state chip stays on a past event — it is the
                                    member's own record that they had a place. The CANCEL
                                    button does not: you cannot withdraw from something
                                    that already happened, and a live-looking button that
                                    can only fail is worse than no button. -#}
                                {% if not past %}
                                    <form method="post" action="{{ path('app_event_registration_cancel_own', {registration: myRegistration.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('event_cancel_' ~ myRegistration.id) }}">
                                        <button type="submit" class="ev-btn ghost">{{ 'event.registration.cancel'|trans }}</button>
                                    </form>
                                {% endif %}

                            {#- ⚠️ `past` is handled by saying NOTHING here. The banner
                                at the top of the page already says "Événement passé —
                                cet événement a eu lieu", and this panel is headed
                                "Participation" with an attendance figure: the fact is
                                stated twice within one screen otherwise, which on mobile
                                stacks into the same sentence repeated.

                                It still has to come BEFORE `not registrationOpen`, whose
                                "inscriptions fermées" is registration vocabulary — a
                                closed registration is a thing that was recently open,
                                which is precisely why a finished event read as current. -#}
                            {% elseif past %}

                            {% elseif not registrationOpen %}
                                <p class="ev-note">{{ 'event.registration.closed'|trans }}</p>

                            {% elseif app.user and usageRight and not usageRight.allowed %}
                                {% include 'site/_usage_right_state.html.twig' with {
                                    capability: usageRight.capability,
                                    verdict: usageRight,
                                    action: {label: 'usage_rights.my_rights'|trans, url: path('app_profile') ~ '#usage-rights'}
                                } only %}

                            {% elseif app.user %}
                                {# 🔴 **Said BEFORE the button, not after the click** (S146e).
                                   Taking this place also enrols the member in the training,
                                   which is a second consequence of one button: a member who
                                   only learns of it from the confirmation has been signed up
                                   for something they did not knowingly choose.
                                   ⚠️ And it states the limit in the same breath — attending
                                   certifies nothing, a trainer validates. Guests see nothing
                                   of this: with no account there is nothing to enrol. #}
                                {% if event.formation %}
                                    <p class="ev-session-note">{{ 'event.registration.session_enrols'|trans({'%formation%': event.formation.titre}) }}</p>
                                {% endif %}
                                <form method="post" action="{{ path('app_event_register', {id: event.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('event_register_' ~ event.id) }}">
                                    <button type="submit" class="ev-btn">
                                        {{ (seatsRemaining == 0 ? 'event.registration.join_waitlist' : 'event.registration.register')|trans }}
                                    </button>
                                </form>

                            {% elseif event.guestsAllowed %}
                                <form method="post" action="{{ path('app_event_register', {id: event.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('event_register_' ~ event.id) }}">
                                    <div class="ev-fields">
                                        <div>
                                            <label for="reg-name">{{ 'event.registration.your_name'|trans }}</label>
                                            <input type="text" name="name" id="reg-name" maxlength="180" required>
                                        </div>
                                        <div>
                                            <label for="reg-email">{{ 'event.registration.your_email'|trans }}</label>
                                            <input type="email" name="email" id="reg-email" maxlength="180" required>
                                        </div>
                                    </div>
                                    <button type="submit" class="ev-btn">
                                        {{ (seatsRemaining == 0 ? 'event.registration.join_waitlist' : 'event.registration.register')|trans }}
                                    </button>
                                    <p class="ev-note">{{ 'event.registration.guest_note'|trans }}</p>
                                </form>

                            {% else %}
                                <p class="ev-note" style="margin-top:0;">{{ 'event.registration.members_only'|trans }}</p>
                                <a class="ev-btn" style="display:block; text-align:center; text-decoration:none;" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
                            {% endif %}
                        </section>
                    </aside>
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}
