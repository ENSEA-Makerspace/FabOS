{% extends 'site/base_public.html.twig' %}

{% block title %}{{ 'fsui.title'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/badges.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/section-journey.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('css/formation-suivi.css') ~ '?v=20260822-s149a' }}">
{% endblock %}

{% block body %}

    <main id="main-content" tabindex="-1" class="main-content">
        <section class="formation-suivi-section">
            <div class="container">
                {% include 'site/_breadcrumb.html.twig' with {trail: [
                    {label: 'nav.home'|trans, url: path('app_home')},
                    {label: 'nav.trainings'|trans, url: path('app_formations')},
                    {label: formation.titre, url: path('app_formation_detail', {id: formation.id})},
                    {label: 'fsui.tracking'|trans},
                ]} only %}

                <div class="formation-suivi-header">
                    <div class="formation-suivi-image">
                        <div class="formation-image-placeholder large">
                            {% include 'site/_formation_visual.html.twig' with {visual: formationVisual, size: 'large'} only %}
                        </div>
                    </div>
                    <div class="formation-suivi-info">
                        <div class="formation-suivi-heading-row">
                            <h1 class="formation-suivi-title">{{ formation.titre }}</h1>
                            <span class="formation-status-badge {{ progressSummary.completed ? 'completed' : 'in-progress' }}">
                                {{ (progressSummary.completed ? 'fsui.validated' : 'fsui.status_in_progress')|trans }}
                            </span>
                        </div>
                        <div class="formation-suivi-description-row">
                            <p class="formation-suivi-description">{{ formation.description ?: 'fsui.no_description'|trans }}</p>
                            <div class="formation-detail-badge">#{{ formation.id }}</div>
                        </div>
                        <div class="formation-suivi-progress">
                            <div class="progress-bar-container">
                                <div class="progress-bar" style="width: {{ progressSummary.overallPercent }}%;">
                                    <span class="progress-text">{{ 'fsui.percent_validated'|trans({'%percent%': progressSummary.overallPercent}) }}</span>
                                </div>
                            </div>
                            <span class="progress-details">
                                {{ 'fsui.steps_summary'|trans({
                                    'done': progressSummary.completedSteps,
                                    'total': progressSummary.totalSteps,
                                    'sec_done': progressSummary.trainingValidated,
                                    'sec_total': progressSummary.trainingStepTotal,
                                    'quiz_done': progressSummary.quizValidated,
                                    'quiz_total': progressSummary.quizTotal,
                                }) }}
                            </span>
                            <small class="quiz-weight-note">
                                {{ 'fsui.weight_note'|trans({'%training%': progressSummary.trainingWeight, '%quiz%': progressSummary.quizWeight}) }}
                            </small>
                        </div>
                    </div>
                </div>

                <div class="formation-tabs">
                    <a href="{{ path('app_formation_detail', {id: formation.id}) }}" class="formation-tab">{{ 'machine.tab_overview'|trans }}</a>
                    <a href="{{ path('app_formation_follow', {id: formation.id}) }}" class="formation-tab active">{{ 'fsui.tracking'|trans }}</a>
                </div>

                <div class="formation-suivi-content">
                    <div class="suivi-section">
                        <h2 class="suivi-section-title">{{ 'fsui.formation_info'|trans }}</h2>
                        <div class="suivi-grid">
                            <div class="suivi-card progression-card">
                                <div class="suivi-card-header"><h3>{{ 'profile.col_formation'|trans }}</h3></div>
                                <div class="suivi-card-body">
                                    {#- 🔴 **S147, J-16 — deux lignes de cette carte étaient de la donnée interne
                                        servie à un visiteur non connecté** : `formation.id`, la clé primaire, et
                                        `formation.image`, le SLUG du fichier (« printer-3d »). Ni l'une ni l'autre
                                        ne dit quoi que ce soit à un membre, et la seconde nomme un chemin de
                                        stockage. Le titre, la description et le badge restent : ce sont les mots de
                                        l'opérateur. ⚠️ Les clés `fsui.lbl_id` et `fsui.lbl_image` sortent des cinq
                                        catalogues avec elles : plus rien ne les lit. -#}
                                    <p><strong>{{ 'fsui.lbl_title'|trans }}</strong> {{ formation.titre }}</p>
                                    <p><strong>{{ 'machine.description'|trans }} :</strong> {{ formation.description ?: 'fsui.no_description'|trans }}</p>
                                    <p><strong>{{ 'fsui.badge_assoc'|trans }} :</strong> {{ formation.badge ? formation.badge.nom : 'fsui.no_badge'|trans }}</p>
                                </div>
                            </div>
                            <div class="suivi-card time-card">
                                <div class="suivi-card-header"><h3>{{ 'fsui.summary'|trans }}</h3></div>
                                <div class="suivi-card-body">
                                    <div class="time-breakdown">
                                        <div class="time-item"><div class="time-info"><span class="time-value">{{ progressSummary.trainingScore }}%</span><span class="time-label">{{ 'profile.col_formation'|trans }}</span></div></div>
                                        <div class="time-item"><div class="time-info"><span class="time-value">{{ progressSummary.quizAverage }}%</span><span class="time-label">{{ 'fsui.mandatory_quizzes'|trans }}</span></div></div>
                                        <div class="time-item"><div class="time-info"><span class="time-value">{{ progressSummary.trainingValidated }}/{{ progressSummary.trainingStepTotal }}</span><span class="time-label">{{ 'fsui.sections_validated'|trans }}</span></div></div>
                                        <div class="time-item"><div class="time-info"><span class="time-value">{{ progressSummary.quizValidated }}/{{ progressSummary.quizTotal }}</span><span class="time-label">{{ 'fsui.quizzes_validated'|trans }}</span></div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="suivi-section">
                        <h2 class="suivi-section-title">{{ 'fsui.formation_progress'|trans }}</h2>
                        <div class="modules-list">
                            {#- 🔴 **S147, J-16 — « aucune progression enregistrée pour VOTRE COMPTE »
                                s'affichait à quelqu'un qui n'a pas de compte**, à côté d'un « 0/10 »
                                qui n'était le zéro de personne. Un visiteur n'a pas une progression
                                vide : il n'en a pas. La carte le dit et propose la seule action qui
                                puisse changer quelque chose. Même composant `.module-card` que les
                                deux autres états, donc rien de neuf à dessiner. -#}
                            {% if app.user is null %}
                                <div class="module-card pending">
                                    <div class="module-header">
                                        <div class="module-title">{{ 'fsui.signin_to_track'|trans }}</div>
                                        <div class="module-status pending">{{ 'usage_rights.verdict.signin_required.label'|trans }}</div>
                                    </div>
                                    <div class="module-body">
                                        {{ 'fsui.signin_hint'|trans }}
                                        <a class="btn btn-primary" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
                                    </div>
                                </div>
                            {% elseif trainingProgression is null %}
                                <div class="module-card pending">
                                    <div class="module-header">
                                        <div class="module-title">{{ 'fsui.no_progress'|trans }}</div>
                                        <div class="module-status pending">{{ 'fsui.to_start'|trans }}</div>
                                    </div>
                                    <div class="module-body">{{ 'fsui.start_hint'|trans }}</div>
                                </div>
                            {% else %}
                                <div class="module-card {{ trainingProgression.completed ? 'completed' : 'in-progress' }}">
                                    <div class="module-header">
                                        <div class="module-title">{{ trainingProgression.utilisateur ? trainingProgression.utilisateur.displayName : 'fsui.current_user'|trans }}</div>
                                        <div class="module-status {{ trainingProgression.completed ? 'completed' : 'in-progress' }}">{{ (trainingProgression.completed ? 'fsui.progression_completed' : 'fsui.progression_in_progress')|trans }}</div>
                                    </div>
                                    <div class="module-body">
                                        <div class="module-meta">
                                            <span class="module-score">{{ 'fsui.progress_score'|trans({'%score%': trainingProgression.score}) }}</span>
                                            <span class="module-duration">{{ 'fsui.start_date'|trans({'%date%': trainingProgression.dateDebut|lab_date('d/m/Y H:i')}) }}</span>
                                            <span class="module-duration">{{ 'fsui.end_date'|trans({'%date%': trainingProgression.dateEnd ? trainingProgression.dateEnd|lab_date('d/m/Y H:i') : '-'}) }}</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="suivi-section" id="quiz-evaluations">
                        <h2 class="suivi-section-title">{{ 'fsui.quiz_eval'|trans }}</h2>
                        <div class="quiz-grid">
                            {% if quizzes is empty %}
                                <div class="quiz-card pending"><div class="quiz-info"><h4>{{ 'fsui.no_quiz'|trans }}</h4><p>{{ 'fsui.import_hint'|trans }}</p></div></div>
                            {% else %}
                                {% for quiz in quizzes %}
                                    {% set questionCount = quizQuestions[quiz.id]|default([])|length %}
                                    {% set meta = quizMeta[quiz.id]|default({}) %}
                                    {% set result = quizResults[quiz.id]|default(null) %}
                                    {% set quizTitle = meta.title|default(quiz.section and quiz.section.titre ? quiz.section.titre : 'fsui.quiz_default_title'|trans({'%formation%': formation.titre})) %}
                                    <div class="quiz-card {{ result and result.completed ? 'completed' : 'pending' }}">
                                        <div class="quiz-icon {{ result and result.completed ? 'completed' : 'pending' }}" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                                        </div>
                                        <div class="quiz-info">
                                            <h4>{{ quizTitle }}</h4>
                                            <p>
                                                {% if meta.machine is defined and meta.machine %}{{ meta.machine.nom }} · {% endif %}
                                                {{ 'fsui.quiz_meta'|trans({'count': questionCount, 'threshold': quiz.noteMinimale}) }}
                                            </p>
                                            {% if result %}
                                                <span class="quiz-result-badge {{ result.completed ? 'is-completed' : '' }}">
                                                    {{ 'fsui.best_score'|trans({'%score%': result.score, '%verdict%': (result.completed ? 'fsui.verdict_passed' : 'fsui.verdict_improve')|trans}) }}
                                                </span>
                                            {% else %}
                                                <span class="quiz-result-badge">{{ 'fsui.no_result'|trans }}</span>
                                            {% endif %}
                                        </div>
                                        <div class="quiz-actions">
                                            {% if questionCount > 0 %}
                                                <a class="btn btn-small" href="{{ path('app_quiz_show', {formationId: formation.id, quizId: quiz.id}) }}">{{ (result ? 'fsui.retake_quiz' : 'fsui.start_quiz')|trans }}</a>
                                            {% else %}
                                                <span class="quiz-result-badge">{{ 'fsui.no_question'|trans }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>

                    {% if bonusQuizzes is not empty %}
                        <div class="suivi-section" id="quiz-bonus">
                            <div class="quiz-bonus-heading">
                                <h2 class="suivi-section-title">{{ 'fsui.bonus_quiz'|trans }}</h2>
                                <span>{{ 'fsui.off_progress'|trans }}</span>
                            </div>
                            <div class="quiz-grid">
                                {% for quiz in bonusQuizzes %}
                                    {% set questionCount = quizQuestions[quiz.id]|default([])|length %}
                                    {% set meta = quizMeta[quiz.id]|default({}) %}
                                    {% set result = quizResults[quiz.id]|default(null) %}
                                    {% set quizTitle = meta.title|default(quiz.section and quiz.section.titre ? quiz.section.titre : 'fsui.bonus_default_title'|trans({'%formation%': formation.titre})) %}
                                    <div class="quiz-card is-bonus {{ result and result.completed ? 'completed' : 'pending' }}">
                                        <div class="quiz-icon {{ result and result.completed ? 'completed' : 'pending' }}" aria-hidden="true">★</div>
                                        <div class="quiz-info">
                                            <h4>{{ quizTitle }}</h4>
                                            <p>{{ 'fsui.bonus_meta'|trans({'count': questionCount}) }}</p>
                                            {% if result %}
                                                <span class="quiz-result-badge {{ result.completed ? 'is-completed' : '' }}">{{ 'fsui.bonus_best_score'|trans({'%score%': result.score}) }}</span>
                                            {% else %}
                                                <span class="quiz-result-badge">{{ 'fsui.optional_challenge'|trans }}</span>
                                            {% endif %}
                                        </div>
                                        <div class="quiz-actions">
                                            {% if questionCount > 0 %}
                                                <a class="btn btn-small" href="{{ path('app_quiz_show', {formationId: formation.id, quizId: quiz.id}) }}">{{ (result ? 'fsui.replay' : 'fsui.try_bonus')|trans }}</a>
                                            {% else %}
                                                <span class="quiz-result-badge">{{ 'fsui.no_question'|trans }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="suivi-section" id="formation-physique">
                        <h2 class="suivi-section-title">{{ 'formations.practical'|trans }}</h2>
                        <div class="badge-preview">
                            {% if qualificationStatus.physicalRequired %}
                                <article class="physical-training-card">
                                    <div class="physical-training-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M4 20h16"/>
                                            <path d="M7 20v-9l5-4 5 4v9"/>
                                            <path d="M10 20v-5h4v5"/>
                                        </svg>
                                    </div>
                                    <div class="physical-training-copy">
                                        <h3>{{ 'fsui.practical_required'|trans }}</h3>
                                        {% if qualificationStatus.physicalFormation %}
                                            <p>{{ 'fsui.practical_desc'|trans }}</p>
                                        {% else %}
                                            <p>{{ 'fsui.practical_not_configured'|trans }}</p>
                                        {% endif %}
                                    </div>
                                    {% if qualificationStatus.physicalCompleted %}
                                        <span class="physical-training-status is-complete">{{ 'fsui.validated'|trans }}</span>
                                    {% elseif not qualificationStatus.physicalFormation %}
                                        <span class="physical-training-status is-missing">{{ 'fsui.to_configure'|trans }}</span>
                                    {% elseif qualificationStatus.theoryReady %}
                                        <span class="physical-training-status">{{ 'fsui.ready_validate'|trans }}</span>
                                    {% else %}
                                        <span class="physical-training-status">{{ 'formations.required'|trans }}</span>
                                    {% endif %}
                                </article>
                            {% else %}
                                <article class="physical-training-card is-optional">
                                    <div class="physical-training-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>
                                    </div>
                                    <div class="physical-training-copy">
                                        <h3>{{ 'fsui.practical_not_required'|trans }}</h3>
                                        <p>{{ 'fsui.practical_not_needed_desc'|trans }}</p>
                                    </div>
                                    <span class="physical-training-status is-complete">{{ 'fsui.not_required_f'|trans }}</span>
                                </article>
                            {% endif %}
                        </div>
                    </div>

                    <div class="suivi-section">
                        <h2 class="suivi-section-title">{{ 'fsui.badge_assoc'|trans }}</h2>
                        <div class="badge-preview">
                            <article
                                class="formation-badge-showcase {{ qualificationStatus.badgeUnlocked ? 'is-unlocked' : 'is-locked' }}"
                                data-badge-showcase
                                data-badge-unlocked="{{ qualificationStatus.badgeUnlocked ? '1' : '0' }}"
                                data-badge-id="{{ formation.badge ? formation.badge.id : '' }}"
                                data-user-id="{{ app.user ? app.user.id : '' }}"
                                data-badge-obtained-at="{{ qualificationStatus.badgeObtainedAt ? qualificationStatus.badgeObtainedAt|date('U') : '' }}"
                            >
                                {% include 'site/_badge_visual.html.twig' with {
                                    badge: formation.badge,
                                    formation: formation,
                                    size: 'lg',
                                    locked: not qualificationStatus.badgeUnlocked
                                } only %}
                                <div class="badge-info">
                                    <span class="badge-eyebrow">{{ (qualificationStatus.badgeUnlocked ? 'fsui.badge_unlocked_eyebrow' : 'fsui.badge_locked_eyebrow')|trans }}</span>
                                    <h3>{{ formation.badge ? formation.badge.nom : 'fsui.no_badge'|trans }}</h3>
                                    <p>
                                        {% if formation.badge %}
                                            {{ formation.badge.description ?: 'fsui.badge_default_desc'|trans }}
                                        {% else %}
                                            {{ 'fsui.no_badge_yet'|trans }}
                                        {% endif %}
                                    </p>

                                    {% if formation.badge %}
                                        <div class="badge-requirement-list">
                                            <div class="badge-requirement-row {{ qualificationStatus.theoryReady ? 'is-complete' : '' }}">
                                                {{ 'fsui.theory_progress'|trans({'%percent%': qualificationStatus.overallPercent}) }}
                                            </div>
                                            {% if qualificationStatus.physicalRequired %}
                                                <div class="badge-requirement-row {{ qualificationStatus.physicalCompleted ? 'is-complete' : '' }}">
                                                    {{ 'fsui.practical_row'|trans({'%state%': (qualificationStatus.physicalCompleted ? 'fsui.practical_state_done' : 'fsui.practical_state_todo')|trans}) }}
                                                </div>
                                            {% else %}
                                                <div class="badge-requirement-row is-complete">
                                                    {{ 'fsui.practical_row_not_needed'|trans }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    <div class="badge-actions">
                                        {% set firstQuiz = quizzes|first %}
                                        {% if not qualificationStatus.theoryReady and firstQuiz and quizQuestions[firstQuiz.id]|default([])|length > 0 %}
                                            <a class="btn btn-small" href="{{ path('app_quiz_show', {formationId: formation.id, quizId: firstQuiz.id}) }}">{{ 'fsui.continue_quizzes'|trans }}</a>
                                        {% elseif qualificationStatus.badgeUnlocked %}
                                            <a class="btn btn-small" href="{{ path('app_profile') }}#badges">{{ 'fsui.see_profile'|trans }}</a>
                                        {% elseif qualificationStatus.physicalRequired and qualificationStatus.physicalFormation %}
                                            <a class="btn btn-small btn-secondary" href="#formation-physique">{{ 'fsui.see_practical'|trans }}</a>
                                        {% elseif qualificationStatus.physicalRequired %}
                                            <span class="badge-database-note">{{ 'fsui.practical_to_configure'|trans }}</span>
                                        {% else %}
                                            <span class="badge-database-note">{{ 'fsui.unlock_hint'|trans }}</span>
                                        {% endif %}
                                        {% if qualificationStatus.physicalRequired %}
                                            <span class="badge-database-note">{{ 'fsui.unlock_hint2'|trans }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    {% if qualificationStatus.badgeUnlocked and formation.badge %}
        <div class="badge-unlock-overlay" data-badge-unlock-overlay hidden>
            <div class="badge-unlock-dialog" role="dialog" aria-modal="true" aria-labelledby="badge-unlock-title">
                {% include 'site/_badge_visual.html.twig' with {
                    badge: formation.badge,
                    formation: formation,
                    size: 'lg',
                    locked: false
                } only %}
                <h2 id="badge-unlock-title">{{ 'fsui.badge_unlocked'|trans }}</h2>
                <p>{{ 'fsui.badge_unlocked_message'|trans({'%badge%': formation.badge.nom}) }}</p>
                <button type="button" class="btn" data-badge-unlock-close>{{ 'fsui.continue'|trans }}</button>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=' ~ js_version }}"></script>
    <script src="{{ asset('js/badges.js') ~ '?v=20260707-1' }}" defer></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const circularProgress = document.querySelector('.circular-progress-svg circle:nth-of-type(2)');
            if (circularProgress) {
                circularProgress.addEventListener('mouseenter', function() {
                    this.style.transform = 'rotate(-90 50 50) scale(1.05)';
                });
                circularProgress.addEventListener('mouseleave', function() {
                    this.style.transform = 'rotate(-90 50 50) scale(1)';
                });
            }
        });
    </script>
{% endblock %}
