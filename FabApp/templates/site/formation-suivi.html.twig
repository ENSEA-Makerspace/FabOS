            border: 2px solid rgba(158, 27, 86, 0.45);
            border-radius: 999px;
            height: 18px;
            margin-bottom: var(--spacing-xs);
            overflow: hidden;
            box-sizing: border-box;
            box-shadow: inset 0 1px 3px rgba(158, 27, 86, 0.08);
