<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suivi de Formation - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        /* Breadcrumb */
        .breadcrumb {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            margin-bottom: var(--spacing-xl);
            font-size: var(--font-size-sm);
        }
        
        .breadcrumb-separator {
            color: var(--color-text-light);
        }
        
        .breadcrumb-current {
            color: var(--color-text-light);
        }
        
        .breadcrumb a {
            color: var(--color-primary);
            text-decoration: none;
        }
        
        .breadcrumb a:hover {
            text-decoration: underline;
        }
        
        /* Formation suivi header */
        .formation-suivi-section {
            padding: var(--spacing-xl) 0;
        }
        
        .formation-suivi-section .container {
            max-width: var(--max-width);
            margin: 0 auto;
            padding: 0 var(--spacing-lg);
        }
        
        .formation-suivi-header {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: var(--spacing-xl);
            margin-bottom: var(--spacing-xl);
        }
        
        .formation-suivi-image {
            position: relative;
        }
        
        .formation-image-placeholder {
            width: 100%;
            height: 250px;
            background: linear-gradient(135deg, rgba(158, 27, 86, 0.1) 0%, rgba(158, 27, 86, 0.05) 100%);
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--border-color);
        }
        
        .formation-icon.large {
            width: 150px;
            height: 150px;
            color: var(--color-primary);
        }
        
        .formation-status-badge {
            position: absolute;
            top: var(--spacing-md);
            right: var(--spacing-md);
            padding: var(--spacing-xs) var(--spacing-md);
            border-radius: var(--border-radius);
            font-size: var(--font-size-sm);
            font-weight: 600;
        }
        
        .formation-status-badge.in-progress {
            background: rgba(255, 193, 7, 0.2);
            color: #FFC107;
        }
        
        .formation-status-badge.completed {
            background: rgba(76, 175, 80, 0.2);
            color: #4CAF50;
        }
        
        .formation-detail-badge {
            display: inline-block;
            padding: 4px 12px;
            background: rgba(158, 27, 86, 0.1);
            color: var(--color-primary);
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            margin-bottom: var(--spacing-sm);
        }
        
        .formation-suivi-title {
            font-size: var(--font-size-2xl);
            font-weight: 700;
            color: var(--color-text);
            margin-bottom: var(--spacing-sm);
        }
        
        .formation-suivi-description {
            color: var(--color-text-light);
            font-size: var(--font-size-base);
            margin-bottom: var(--spacing-lg);
        }
        
        .formation-suivi-progress {
            margin-top: var(--spacing-lg);
        }
        
        .progress-bar-container {
            background: var(--color-bg-light);
            border-radius: var(--border-radius);
            height: 12px;
            margin-bottom: var(--spacing-xs);
            overflow: hidden;
        }
        
        .progress-bar {
            background: linear-gradient(90deg, var(--color-primary) 0%, #7a1542 100%);
            height: 100%;
            border-radius: var(--border-radius);
            transition: width 0.5s ease;
            position: relative;
        }
        
        .progress-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 11px;
            font-weight: 600;
            color: white;
        }
        
        .progress-details {
            font-size: 11px;
            color: var(--color-text-light);
        }
        
        /* Formation tabs */
        .formation-tabs {
            display: flex;
            gap: var(--spacing-xs);
            margin-bottom: var(--spacing-xl);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: var(--spacing-md);
        }
        
        .formation-tab {
            padding: var(--spacing-sm) var(--spacing-lg);
            color: var(--color-text-light);
            text-decoration: none;
            font-size: var(--font-size-base);
            font-weight: 500;
            border-bottom: 2px solid transparent;
            transition: all var(--transition);
        }
        
        .formation-tab:hover {
            color: var(--color-primary);
        }
        
        .formation-tab.active {
            color: var(--color-primary);
            border-bottom-color: var(--color-primary);
        }
        
        /* Suivi content */
        .formation-suivi-content {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-xl);
        }
        
        .suivi-section {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-lg);
        }
        
        .suivi-section-title {
            font-size: var(--font-size-xl);
            font-weight: 600;
            color: var(--color-text);
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid var(--border-color);
        }
        
        .suivi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: var(--spacing-lg);
        }
        
        /* Suivi cards */
        .suivi-card {
            background: var(--color-text-inverse);
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
        }
        
        .suivi-card-header {
            margin-bottom: var(--spacing-md);
        }
        
        .suivi-card-header h3 {
            font-size: var(--font-size-lg);
            font-weight: 600;
            color: var(--color-text);
        }
        
        .suivi-card-body {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-md);
        }
        
        /* Global progress */
        .global-progress {
            display: flex;
            align-items: center;
            gap: var(--spacing-lg);
        }
        
        .circular-progress {
            position: relative;
            width: 120px;
            height: 120px;
        }
        
        .circular-progress-svg {
            width: 100%;
            height: 100%;
        }
        
        .circular-progress-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }
        
        .progress-percentage {
            display: block;
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: var(--color-primary);
        }
        
        .progress-label {
            font-size: 11px;
            color: var(--color-text-light);
        }
        
        .progress-stats {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-sm);
        }
        
        .stat-item {
            display: flex;
            align-items: baseline;
            gap: var(--spacing-xs);
        }
        
        .stat-value {
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: var(--color-primary);
        }
        
        .stat-label {
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
        }
        
        /* Time breakdown */
        .time-breakdown {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: var(--spacing-md);
        }
        
        .time-item {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }
        
        .time-icon {
            width: 40px;
            height: 40px;
            background: rgba(158, 27, 86, 0.05);
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .time-icon svg {
            width: 20px;
            height: 20px;
        }
        
        .time-info {
            display: flex;
            flex-direction: column;
        }
        
        .time-value {
            font-size: var(--font-size-lg);
            font-weight: 600;
            color: var(--color-text);
        }
        
        .time-label {
            font-size: 11px;
            color: var(--color-text-light);
        }
        
        /* Modules list */
        .modules-list {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-md);
        }
        
        .module-card {
            background: var(--color-text-inverse);
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            transition: transform var(--transition), box-shadow var(--transition);
        }
        
        .module-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }
        
        .module-header {
            display: flex;
            align-items: center;
            gap: var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }
        
        .module-icon {
            width: 40px;
            height: 40px;
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        
        .module-icon svg {
            width: 20px;
            height: 20px;
        }
        
        .module-icon.completed {
            background: rgba(76, 175, 80, 0.1);
        }
        
        .module-icon.in-progress {
            background: rgba(255, 193, 7, 0.1);
        }
        
        .module-icon.pending {
            background: rgba(158, 27, 86, 0.05);
        }
        
        .module-icon.locked {
            background: rgba(158, 27, 86, 0.05);
        }
        
        .module-title {
            flex: 1;
            font-size: var(--font-size-base);
            font-weight: 600;
            color: var(--color-text);
        }
        
        .module-status {
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }
        
        .module-status.completed {
            background: rgba(76, 175, 80, 0.1);
            color: #4CAF50;
        }
        
        .module-status.in-progress {
            background: rgba(255, 193, 7, 0.1);
            color: #FFC107;
        }
        
        .module-status.pending {
            background: rgba(158, 27, 86, 0.1);
            color: var(--color-text-light);
        }
        
        .module-status.locked {
            background: rgba(244, 67, 54, 0.1);
            color: #F44336;
        }
        
        .module-body {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-md);
        }
        
        .module-progress {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            flex: 1;
        }
        
        .module-progress-bar {
            background: var(--color-bg-light);
            border-radius: var(--border-radius-sm);
            height: 8px;
            overflow: hidden;
            flex: 1;
        }
        
        .module-progress-fill {
            background: var(--color-primary);
            height: 100%;
            border-radius: var(--border-radius-sm);
            transition: width 0.5s ease;
        }
        
        .module-progress-text {
            font-size: 11px;
            font-weight: 600;
            color: var(--color-primary);
            min-width: 40px;
        }
        
        .module-meta {
            display: flex;
            gap: var(--spacing-lg);
        }
        
        .module-meta span {
            font-size: 11px;
            color: var(--color-text-light);
        }
        
        .module-actions {
            display: flex;
            justify-content: flex-end;
            gap: var(--spacing-sm);
        }
        
        .module-locked-message {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            color: var(--color-text-light);
            font-size: var(--font-size-sm);
        }
        
        .module-locked-message svg {
            width: 16px;
            height: 16px;
        }
        
        /* Quiz grid */
        .quiz-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: var(--spacing-lg);
        }
        
        .quiz-card {
            background: var(--color-text-inverse);
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: var(--spacing-md);
            transition: transform var(--transition), box-shadow var(--transition);
        }
        
        .quiz-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }
        
        .quiz-icon {
            width: 48px;
            height: 48px;
            border-radius: var(--border-radius-circle);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        
        .quiz-icon svg {
            width: 24px;
            height: 24px;
        }
        
        .quiz-icon.completed {
            background: rgba(76, 175, 80, 0.1);
        }
        
        .quiz-icon.pending {
            background: rgba(158, 27, 86, 0.05);
        }
        
        .quiz-info {
            flex: 1;
        }
        
        .quiz-info h4 {
            font-size: var(--font-size-base);
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: 4px;
        }
        
        .quiz-info p {
            font-size: 11px;
            color: var(--color-text-light);
            margin: 0;
        }
        
        .quiz-score {
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: #4CAF50;
        }
        
        .quiz-actions {
            display: flex;
            gap: var(--spacing-sm);
        }
        
        .quiz-actions .btn {
            padding: var(--spacing-xs) var(--spacing-md);
            font-size: var(--font-size-sm);
        }
        
        /* Badge preview */
        .badge-preview {
            display: flex;
            justify-content: center;
        }
        
        .badge-card {
            background: var(--color-text-inverse);
            border-radius: var(--border-radius);
            padding: var(--spacing-xl);
            box-shadow: var(--shadow-lg);
            border: 2px solid var(--color-primary);
            max-width: 500px;
            width: 100%;
            text-align: center;
        }
        
        .badge-icon-large {
            width: 80px;
            height: 80px;
            margin: 0 auto var(--spacing-lg);
            font-size: 48px;
        }
        
        .badge-info h3 {
            font-size: var(--font-size-xl);
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: var(--spacing-xs);
        }
        
        .badge-info p {
            color: var(--color-text-light);
            font-size: var(--font-size-sm);
            margin-bottom: var(--spacing-lg);
        }
        
        .badge-requirements {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-sm);
            margin-bottom: var(--spacing-lg);
            text-align: left;
        }
        
        .requirement {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            font-size: var(--font-size-sm);
        }
        
        .requirement-icon {
            width: 20px;
            height: 20px;
            border-radius: var(--border-radius-circle);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }
        
        .requirement-icon.completed {
            background: rgba(76, 175, 80, 0.2);
            color: #4CAF50;
        }
        
        .requirement-icon.pending {
            background: rgba(255, 193, 7, 0.2);
            color: #FFC107;
        }
        
        .badge-progress {
            padding-top: var(--spacing-md);
            border-top: 1px solid var(--border-color);
            font-size: 11px;
            color: var(--color-text-light);
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .formation-suivi-header {
                grid-template-columns: 1fr;
            }
            
            .formation-suivi-image {
                order: -1;
            }
            
            .formation-image-placeholder {
                height: 200px;
            }
            
            .formation-icon.large {
                width: 120px;
                height: 120px;
            }
            
            .formation-status-badge {
                position: static;
                margin-top: var(--spacing-sm);
            }
            
            .suivi-grid {
                grid-template-columns: 1fr;
            }
            
            .time-breakdown {
                grid-template-columns: 1fr;
            }
            
            .global-progress {
                flex-direction: column;
                align-items: center;
            }
            
            .module-header {
                flex-wrap: wrap;
            }
            
            .module-title {
                order: 1;
                width: 100%;
                margin-bottom: var(--spacing-xs);
            }
            
            .module-body {
                flex-direction: column;
                align-items: flex-start;
                gap: var(--spacing-sm);
            }
            
            .module-meta {
                flex-direction: column;
                gap: var(--spacing-xs);
            }
        }
    </style>
</head>
<body>
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
