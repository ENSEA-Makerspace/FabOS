            font-weight: 600;
            color: white;
        }
        
        .progress-details {
            font-size: 11px;
            color: var(--color-text-light);
        }
        
        /* Formation tabs */
        .formation-tabs {
            display: flex;
            gap: var(--spacing-xs);
            margin-bottom: var(--spacing-xl);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: var(--spacing-md);
        }
        
        .formation-tab {
            padding: var(--spacing-sm) var(--spacing-lg);
            color: var(--color-text-light);
            text-decoration: none;
            font-size: var(--font-size-base);
            font-weight: 500;
            border-bottom: 2px solid transparent;
            transition: all var(--transition);
        }
        
        .formation-tab:hover {
            color: var(--color-primary);
        }
        
        .formation-tab.active {
            color: var(--color-primary);
            border-bottom-color: var(--color-primary);
        }
        
        /* Suivi content */
        .formation-suivi-content {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-xl);
        }
        
        .suivi-section {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-lg);
        }
        
        .suivi-section-title {
            font-size: var(--font-size-xl);
            font-weight: 600;
            color: var(--color-text);
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid var(--border-color);
        }
        
        .suivi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: var(--spacing-lg);
        }
        
        /* Suivi cards */
        .suivi-card {
            background: var(--color-text-inverse);
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
        }
        
        .suivi-card-header {
            margin-bottom: var(--spacing-md);
        }
        
        .suivi-card-header h3 {
            font-size: var(--font-size-lg);
            font-weight: 600;
            color: var(--color-text);
        }
        
        .suivi-card-body {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-md);
        }
        
        /* Global progress */
        .global-progress {
            display: flex;
            align-items: center;
            gap: var(--spacing-lg);
        }
        
        .circular-progress {
            position: relative;
            width: 120px;
            height: 120px;
        }
        
        .circular-progress-svg {
            width: 100%;
            height: 100%;
        }
        
        .circular-progress-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }
        
        .progress-percentage {
            display: block;
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: var(--color-primary);
        }
        
        .progress-label {
            font-size: 11px;
            color: var(--color-text-light);
        }
        
        .progress-stats {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-sm);
        }
        
        .stat-item {
            display: flex;
            align-items: baseline;
            gap: var(--spacing-xs);
        }
        
        .stat-value {
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: var(--color-primary);
        }
        
        .stat-label {
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
        }
        
        /* Time breakdown */
        .time-breakdown {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: var(--spacing-md);
        }
        
        .time-item {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }
        
        .time-icon {
            width: 40px;
            height: 40px;
            background: rgba(158, 27, 86, 0.05);
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .time-icon svg {
            width: 20px;
            height: 20px;
        }
        
        .time-info {
            display: flex;
            flex-direction: column;
        }
        
        .time-value {
            font-size: var(--font-size-lg);
            font-weight: 600;
            color: var(--color-text);
        }
        
        .time-label {
            font-size: 11px;
            color: var(--color-text-light);
        }
        
        /* Modules list */
        .modules-list {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-md);
        }
        
        .module-card {
            background: var(--color-text-inverse);
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            transition: transform var(--transition), box-shadow var(--transition);
        }
        
        .module-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }
        
        .module-header {
            display: flex;
            align-items: center;
            gap: var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }
        
        .module-icon {
            width: 40px;
            height: 40px;
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        
        .module-icon svg {
            width: 20px;
            height: 20px;
        }
        
        .module-icon.completed {
            background: rgba(76, 175, 80, 0.1);
        }
        
        .module-icon.in-progress {
            background: rgba(255, 193, 7, 0.1);
        }
        
        .module-icon.pending {
            background: rgba(158, 27, 86, 0.05);
        }
        
        .module-icon.locked {
            background: rgba(158, 27, 86, 0.05);
        }
        
        .module-title {
            flex: 1;
            font-size: var(--font-size-base);
            font-weight: 600;
            color: var(--color-text);
        }
        
        .module-status {
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }
        
        .module-status.completed {
            background: rgba(76, 175, 80, 0.1);
            color: #4CAF50;
        }
        
        .module-status.in-progress {
            background: rgba(255, 193, 7, 0.1);
            color: #FFC107;
        }
        
        .module-status.pending {
            background: rgba(158, 27, 86, 0.1);
            color: var(--color-text-light);
        }
        
        .module-status.locked {
            background: rgba(244, 67, 54, 0.1);
            color: #F44336;
        }
        
        .module-body {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-md);
        }
        
        .module-progress {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            flex: 1;
        }
        
        .module-progress-bar {
            background: var(--color-bg-light);
            border-radius: var(--border-radius-sm);
            height: 8px;
            overflow: hidden;
            flex: 1;
        }
        
        .module-progress-fill {
            background: var(--color-primary);
            height: 100%;
            border-radius: var(--border-radius-sm);
            transition: width 0.5s ease;
        }
        
        .module-progress-text {
            font-size: 11px;
            font-weight: 600;
            color: var(--color-primary);
            min-width: 40px;
        }
        
        .module-meta {
            display: flex;
            gap: var(--spacing-lg);
        }
        
        .module-meta span {
            font-size: 11px;
            color: var(--color-text-light);
        }
        
        .module-actions {
            display: flex;
            justify-content: flex-end;
            gap: var(--spacing-sm);
        }
        
        .module-locked-message {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            color: var(--color-text-light);
            font-size: var(--font-size-sm);
        }
        
        .module-locked-message svg {
            width: 16px;
            height: 16px;
        }
        
        /* Quiz grid */
        .quiz-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--spacing-lg);
            width: 100%;
            min-width: 0;
        }

        #quiz-evaluations {
            scroll-margin-top: 130px;
        }

        .quiz-grid > .quiz-card:only-child {
            grid-column: 1 / -1;
        }
        
        .quiz-card {
            position: relative;
            display: grid;
            grid-template-columns: 56px minmax(0, 1fr);
            align-items: center;
            gap: 14px 18px;
            width: 100%;
            min-height: 172px;
            padding: 24px 26px;
            overflow: hidden;
            background: linear-gradient(135deg, #ffffff 0%, #fdf9fb 100%);
            border: 1px solid rgba(158, 27, 86, 0.16);
            border-radius: 18px;
            box-shadow: 0 12px 32px rgba(69, 24, 47, 0.09);
            transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
        }

        .quiz-card::before {
            content: '';
            position: absolute;
            inset: 0 auto 0 0;
            width: 5px;
            background: var(--color-primary);
        }
        
        .quiz-card:hover {
            transform: translateY(-3px);
            border-color: rgba(158, 27, 86, 0.3);
            box-shadow: 0 18px 42px rgba(69, 24, 47, 0.14);
        }
        
        .quiz-icon {
            width: 56px;
            height: 56px;
            border-radius: var(--border-radius-circle);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        
        .quiz-icon svg {
            width: 24px;
            height: 24px;
        }
        
        .quiz-icon.completed {
            background: rgba(76, 175, 80, 0.1);
        }
        
        .quiz-icon.pending {
            color: var(--color-primary);
            background: rgba(158, 27, 86, 0.09);
            box-shadow: inset 0 0 0 1px rgba(158, 27, 86, 0.08);
        }
        
        .quiz-info {
            min-width: 0;
        }
        
        .quiz-info h4 {
            margin: 0 0 8px;
            color: var(--color-text);
            font-size: clamp(1.05rem, 1.8vw, 1.25rem);
            font-weight: 700;
            line-height: 1.28;
            overflow-wrap: anywhere;
        }
        
        .quiz-info p {
            max-width: 600px;
            margin: 0;
            color: var(--color-text-light);
            font-size: 0.9rem;
            line-height: 1.55;
        }
        
        .quiz-score {
            font-size: var(--font-size-xl);
            font-weight: 700;
            color: #4CAF50;
        }
        
        .quiz-actions {
            grid-column: 2;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: var(--spacing-sm);
        }
        
        .quiz-actions .btn {
            min-width: 148px;
            padding: 10px 18px;
            border-radius: 10px;
            font-size: var(--font-size-sm);
            font-weight: 700;
            text-align: center;
            white-space: nowrap;
        }
        
        .quiz-result-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 10px;
            padding: 6px 10px;
            border-radius: 999px;
            background: rgba(255, 193, 7, 0.13);
            color: #946d00;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .quiz-result-badge.is-completed {
            background: rgba(76, 175, 80, 0.13);
            color: #2f7d32;
        }

        .quiz-weight-note {
            display: block;
            margin-top: 6px;
            color: var(--color-text-light);
            font-size: 0.78rem;
        }

        /* Badge preview */
        .badge-preview {
            display: flex;
            justify-content: center;
        }
        
        .badge-card {
            background: var(--color-text-inverse);
            border-radius: var(--border-radius);
            padding: var(--spacing-xl);
            box-shadow: var(--shadow-lg);
            border: 2px solid var(--color-primary);
            max-width: 500px;
            width: 100%;
            text-align: center;
        }
        
        .badge-icon-large {
            width: 80px;
            height: 80px;
            margin: 0 auto var(--spacing-lg);
            font-size: 48px;
        }
        
        .badge-info h3 {
            font-size: var(--font-size-xl);
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: var(--spacing-xs);
        }
        
        .badge-info p {
            color: var(--color-text-light);
            font-size: var(--font-size-sm);
            margin-bottom: var(--spacing-lg);
        }
        
        .badge-requirements {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-sm);
            margin-bottom: var(--spacing-lg);
            text-align: left;
        }
        
        .requirement {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            font-size: var(--font-size-sm);
        }
        
        .requirement-icon {
            width: 20px;
            height: 20px;
            border-radius: var(--border-radius-circle);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }
        
        .requirement-icon.completed {
            background: rgba(76, 175, 80, 0.2);
            color: #4CAF50;
        }
        
        .requirement-icon.pending {
            background: rgba(255, 193, 7, 0.2);
            color: #FFC107;
        }
        
        .badge-progress {
            padding-top: var(--spacing-md);
            border-top: 1px solid var(--border-color);
            font-size: 11px;
            color: var(--color-text-light);
        }
        
        @media (max-width: 1180px) {
            .quiz-grid {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        @media (max-width: 700px) {
            .quiz-grid {
                grid-template-columns: minmax(0, 1fr);
                width: 100%;
                min-width: 0;
            }

            .quiz-card {
                grid-template-columns: 52px minmax(0, 1fr);
                gap: var(--spacing-md);
                padding: 20px;
            }

            .quiz-icon {
                width: 50px;
                height: 50px;
            }

            .quiz-actions {
                grid-column: 1 / -1;
                justify-content: stretch;
            }

            .quiz-actions .btn {
                width: 100%;
            }
        }

        /* Responsive */
        @media (max-width: 768px) {
            .formation-suivi-header {
                grid-template-columns: 1fr;
            }
            
            .formation-suivi-image {
                order: -1;
                width: min(300px, 100%);
                height: 250px;
                justify-self: center;
            }

            .formation-suivi-heading-row,
            .formation-suivi-description-row {
                align-items: flex-start;
            }

            .formation-suivi-heading-row {
                flex-wrap: wrap;
            }
            
            .formation-icon.large {
                width: 120px;
                height: 120px;
            }
            
            
            .suivi-grid {
                grid-template-columns: 1fr;
            }
            
            .time-breakdown {
                grid-template-columns: 1fr;
            }
            
            .global-progress {
                flex-direction: column;
                align-items: center;
            }
            
            .module-header {
                flex-wrap: wrap;
            }
            
            .module-title {
                order: 1;
                width: 100%;
                margin-bottom: var(--spacing-xs);
            }
            
            .module-body {
                flex-direction: column;
                align-items: flex-start;
                gap: var(--spacing-sm);
            }
            
            .module-meta {
                flex-direction: column;
                gap: var(--spacing-xs);
            }
        }
    </style>
</head>
<body>
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    {% include 'site/_logo.html.twig' %}
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">Accueil</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">Calendrier</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">Machines</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link active">Formations</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">Leaderboard</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">Admin</a>
                    {% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <main class="main-content">
        <section class="formation-suivi-section">
            <div class="container">
                <nav class="breadcrumb">
                    <a href="{{ path('app_home') }}">Accueil</a>
                    <span class="breadcrumb-separator">/</span>
                    <a href="{{ path('app_formations') }}">Formations</a>
                    <span class="breadcrumb-separator">/</span>
                    <a href="{{ path('app_formation_detail', {id: formation.id}) }}">{{ formation.titre }}</a>
                    <span class="breadcrumb-separator">/</span>
                    <span class="breadcrumb-current">Suivi</span>
                </nav>

                <div class="formation-suivi-header">
                    <div class="formation-suivi-image">
                        <div class="formation-image-placeholder large">
                            {% include 'site/_formation_visual.html.twig' with {visual: formationVisual, size: 'large'} only %}
                        </div>
                    </div>
                    <div class="formation-suivi-info">
                        <div class="formation-suivi-heading-row">
                            <h1 class="formation-suivi-title">{{ formation.titre }}</h1>
                            <span class="formation-status-badge {{ progressSummary.completed ? 'completed' : 'in-progress' }}">
                                {{ progressSummary.completed ? 'Validée' : 'En progression' }}
                            </span>
                        </div>
                        <div class="formation-suivi-description-row">
                            <p class="formation-suivi-description">{{ formation.description ?: 'Sans description' }}</p>
                            <div class="formation-detail-badge">#{{ formation.id }}</div>
                        </div>
                        <div class="formation-suivi-progress">
                            <div class="progress-bar-container">
                                <div class="progress-bar" style="width: {{ progressSummary.overallPercent }}%;">
                                    <span class="progress-text">{{ progressSummary.overallPercent }}% validé</span>
                                </div>
                            </div>
                            <span class="progress-details">
                                {{ progressSummary.completedSteps }}/{{ progressSummary.totalSteps }} étape{{ progressSummary.totalSteps > 1 ? 's' : '' }} validée{{ progressSummary.completedSteps > 1 ? 's' : '' }}
                                · {{ progressSummary.trainingValidated }}/{{ progressSummary.trainingStepTotal }} section{{ progressSummary.trainingStepTotal > 1 ? 's' : '' }}
                                · {{ progressSummary.quizValidated }}/{{ progressSummary.quizTotal }} quiz
                            </span>
                            <small class="quiz-weight-note">
                                Pondération : formation {{ progressSummary.trainingWeight }} % · quiz {{ progressSummary.quizWeight }} %.
                                Chaque progression de formation compte donc davantage qu'un quiz.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="formation-tabs">
                    <a href="{{ path('app_formation_detail', {id: formation.id}) }}" class="formation-tab">Aperçu</a>
                    <a href="{{ path('app_formation_follow', {id: formation.id}) }}" class="formation-tab active">Suivi</a>
                    <button class="formation-tab" disabled>Discussions bientôt disponible</button>
                    <button class="formation-tab" disabled>Notes bientôt disponible</button>
                </div>

                <div class="formation-suivi-content">
                    <div class="suivi-section">
                        <h2 class="suivi-section-title">Informations formation</h2>
                        <div class="suivi-grid">
                            <div class="suivi-card progression-card">
                                <div class="suivi-card-header"><h3>Formation</h3></div>
                                <div class="suivi-card-body">
                                    <p><strong>ID :</strong> {{ formation.id }}</p>
                                    <p><strong>Titre :</strong> {{ formation.titre }}</p>
                                    <p><strong>Description :</strong> {{ formation.description ?: 'Sans description' }}</p>
                                    <p><strong>Image :</strong> {{ formation.image ?: 'Aucune image renseignée' }}</p>
                                    <p><strong>Badge associé :</strong> {{ formation.badge ? formation.badge.nom : 'Aucun badge associé' }}</p>
                                </div>
                            </div>
                            <div class="suivi-card time-card">
                                <div class="suivi-card-header"><h3>Résumé</h3></div>
                                <div class="suivi-card-body">
                                    <div class="time-breakdown">
                                        <div class="time-item"><div class="time-info"><span class="time-value">{{ progressSummary.trainingScore }}%</span><span class="time-label">Formation</span></div></div>
                                        <div class="time-item"><div class="time-info"><span class="time-value">{{ progressSummary.quizAverage }}%</span><span class="time-label">Quiz obligatoires</span></div></div>
                                        <div class="time-item"><div class="time-info"><span class="time-value">{{ progressSummary.trainingValidated }}/{{ progressSummary.trainingStepTotal }}</span><span class="time-label">Sections validées</span></div></div>
                                        <div class="time-item"><div class="time-info"><span class="time-value">{{ progressSummary.quizValidated }}/{{ progressSummary.quizTotal }}</span><span class="time-label">Quiz validés</span></div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="suivi-section">
                        <h2 class="suivi-section-title">Progression de la formation</h2>
                        <div class="modules-list">
                            {% if trainingProgression is null %}
                                <div class="module-card pending">
                                    <div class="module-header">
                                        <div class="module-title">Aucune progression de formation enregistrée pour votre compte</div>
                                        <div class="module-status pending">À commencer</div>
                                    </div>
                                    <div class="module-body">Commencez la première section : chaque mini-quiz validé met à jour cette progression automatiquement, puis les quiz obligatoires complètent le parcours.</div>
                                </div>
                            {% else %}
                                <div class="module-card {{ trainingProgression.completed ? 'completed' : 'in-progress' }}">
                                    <div class="module-header">
                                        <div class="module-title">{{ trainingProgression.utilisateur ? trainingProgression.utilisateur.displayName : 'Utilisateur connecté' }}</div>
                                        <div class="module-status {{ trainingProgression.completed ? 'completed' : 'in-progress' }}">{{ trainingProgression.completed ? 'Complétée' : 'En cours' }}</div>
                                    </div>
                                    <div class="module-body">
                                        <div class="module-meta">
                                            <span class="module-score">Progression {{ trainingProgression.score }} %</span>
                                            <span class="module-duration">Début {{ trainingProgression.dateDebut|date('d/m/Y H:i') }}</span>
                                            <span class="module-duration">Fin {{ trainingProgression.dateEnd ? trainingProgression.dateEnd|date('d/m/Y H:i') : '-' }}</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="suivi-section" id="quiz-evaluations">
                        <h2 class="suivi-section-title">Quiz et évaluations</h2>
                        <div class="quiz-grid">
                            {% if quizzes is empty %}
                                <div class="quiz-card pending"><div class="quiz-info"><h4>Aucun quiz persistant pour cette formation.</h4><p>Importez le fichier SQL fourni avec le patch pour ajouter les quiz personnalisés et enregistrer leurs résultats.</p></div></div>
                            {% else %}
                                {% for quiz in quizzes %}
                                    {% set questionCount = quizQuestions[quiz.id]|default([])|length %}
                                    {% set meta = quizMeta[quiz.id]|default({}) %}
                                    {% set result = quizResults[quiz.id]|default(null) %}
                                    {% set quizTitle = meta.title|default(quiz.section and quiz.section.titre ? quiz.section.titre : 'Quiz – ' ~ formation.titre) %}
                                    <div class="quiz-card {{ result and result.completed ? 'completed' : 'pending' }}">
                                        <div class="quiz-icon {{ result and result.completed ? 'completed' : 'pending' }}" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                                        </div>
                                        <div class="quiz-info">
                                            <h4>{{ quizTitle }}</h4>
                                            <p>
                                                {% if meta.machine is defined and meta.machine %}{{ meta.machine.nom }} · {% endif %}
                                                {{ questionCount }} question{{ questionCount > 1 ? 's' : '' }}
                                                · Seuil {{ quiz.noteMinimale }} %
                                            </p>
                                            {% if result %}
                                                <span class="quiz-result-badge {{ result.completed ? 'is-completed' : '' }}">
                                                    Meilleur score {{ result.score }} % · {{ result.completed ? 'Validé' : 'À améliorer' }}
                                                </span>
                                            {% else %}
                                                <span class="quiz-result-badge">Aucun résultat enregistré</span>
                                            {% endif %}
                                        </div>
                                        <div class="quiz-actions">
                                            {% if questionCount > 0 %}
                                                <a class="btn btn-small" href="{{ path('app_quiz_show', {formationId: formation.id, quizId: quiz.id}) }}">{{ result ? 'Repasser le quiz' : 'Démarrer le quiz' }}</a>
                                            {% else %}
                                                <button class="btn btn-small" disabled>Aucune question</button>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>

                    {% if bonusQuizzes is not empty %}
                        <div class="suivi-section" id="quiz-bonus">
                            <div class="quiz-bonus-heading">
                                <h2 class="suivi-section-title">Quiz bonus</h2>
                                <span>Hors progression</span>
                            </div>
                            <div class="quiz-grid">
                                {% for quiz in bonusQuizzes %}
                                    {% set questionCount = quizQuestions[quiz.id]|default([])|length %}
                                    {% set meta = quizMeta[quiz.id]|default({}) %}
                                    {% set result = quizResults[quiz.id]|default(null) %}
                                    {% set quizTitle = meta.title|default(quiz.section and quiz.section.titre ? quiz.section.titre : 'Défi bonus – ' ~ formation.titre) %}
                                    <div class="quiz-card is-bonus {{ result and result.completed ? 'completed' : 'pending' }}">
                                        <div class="quiz-icon {{ result and result.completed ? 'completed' : 'pending' }}" aria-hidden="true">★</div>
                                        <div class="quiz-info">
                                            <h4>{{ quizTitle }}</h4>
                                            <p>{{ questionCount }} question{{ questionCount > 1 ? 's' : '' }} · aucun impact sur la progression</p>
                                            {% if result %}
                                                <span class="quiz-result-badge {{ result.completed ? 'is-completed' : '' }}">Meilleur score {{ result.score }} %</span>
                                            {% else %}
                                                <span class="quiz-result-badge">Défi facultatif</span>
                                            {% endif %}
                                        </div>
                                        <div class="quiz-actions">
                                            {% if questionCount > 0 %}
                                                <a class="btn btn-small" href="{{ path('app_quiz_show', {formationId: formation.id, quizId: quiz.id}) }}">{{ result ? 'Rejouer' : 'Tenter le bonus' }}</a>
                                            {% else %}
                                                <button class="btn btn-small" disabled>Aucune question</button>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="suivi-section" id="formation-physique">
                        <h2 class="suivi-section-title">Formation pratique</h2>
                        <div class="badge-preview">
                            {% if qualificationStatus.physicalRequired %}
                                <article class="physical-training-card">
                                    <div class="physical-training-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M4 20h16"/>
                                            <path d="M7 20v-9l5-4 5 4v9"/>
                                            <path d="M10 20v-5h4v5"/>
                                        </svg>
                                    </div>
                                    <div class="physical-training-copy">
                                        <h3>Formation pratique nécessaire</h3>
                                        {% if qualificationStatus.physicalFormation %}
                                            <p>Une prise en main avec un membre du FabLab doit être validée en présentiel. Elle complète la formation classique et les quiz.</p>
                                        {% else %}
                                            <p>La validation pratique n’est pas encore configurée. Importez le script de données fourni avec le patch précédent.</p>
                                        {% endif %}
                                    </div>
                                    {% if qualificationStatus.physicalCompleted %}
                                        <span class="physical-training-status is-complete">Validée</span>
                                    {% elseif not qualificationStatus.physicalFormation %}
                                        <span class="physical-training-status is-missing">À configurer</span>
                                    {% elseif qualificationStatus.theoryReady %}
                                        <span class="physical-training-status">Prête à valider</span>
                                    {% else %}
                                        <span class="physical-training-status">Nécessaire</span>
                                    {% endif %}
                                </article>
                            {% else %}
                                <article class="physical-training-card is-optional">
                                    <div class="physical-training-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>
                                    </div>
                                    <div class="physical-training-copy">
                                        <h3>Formation pratique non nécessaire</h3>
                                        <p>Pour cette machine, la progression en ligne et les quiz suffisent. Aucune validation en présentiel n’est exigée.</p>
                                    </div>
                                    <span class="physical-training-status is-complete">Non requise</span>
                                </article>
                            {% endif %}
                        </div>
                    </div>

                    <div class="suivi-section">
                        <h2 class="suivi-section-title">Badge associé</h2>
                        <div class="badge-preview">
                            <article
                                class="formation-badge-showcase {{ qualificationStatus.badgeUnlocked ? 'is-unlocked' : 'is-locked' }}"
                                data-badge-showcase
                                data-badge-unlocked="{{ qualificationStatus.badgeUnlocked ? '1' : '0' }}"
                                data-badge-id="{{ formation.badge ? formation.badge.id : '' }}"
                                data-user-id="{{ app.user ? app.user.id : '' }}"
                                data-badge-obtained-at="{{ qualificationStatus.badgeObtainedAt ? qualificationStatus.badgeObtainedAt|date('U') : '' }}"
                            >
                                {% include 'site/_badge_visual.html.twig' with {
                                    badge: formation.badge,
                                    formation: formation,
                                    size: 'lg',
                                    locked: not qualificationStatus.badgeUnlocked
                                } only %}
                                <div class="badge-info">
                                    <span class="badge-eyebrow">{{ qualificationStatus.badgeUnlocked ? 'Badge débloqué' : 'Badge verrouillé' }}</span>
                                    <h3>{{ formation.badge ? formation.badge.nom : 'Aucun badge associé' }}</h3>
                                    <p>
                                        {% if formation.badge %}
                                            {{ formation.badge.description ?: 'Badge délivré après validation complète de la formation.' }}
                                        {% else %}
                                            Cette formation ne délivre pas encore de badge dans la base.
                                        {% endif %}
                                    </p>

                                    {% if formation.badge %}
                                        <div class="badge-requirement-list">
                                            <div class="badge-requirement-row {{ qualificationStatus.theoryReady ? 'is-complete' : '' }}">
                                                Progression théorique : {{ qualificationStatus.overallPercent }} % / 80 % requis
                                            </div>
                                            {% if qualificationStatus.physicalRequired %}
                                                <div class="badge-requirement-row {{ qualificationStatus.physicalCompleted ? 'is-complete' : '' }}">
                                                    Formation pratique : {{ qualificationStatus.physicalCompleted ? 'validée' : 'à valider en présentiel' }}
                                                </div>
                                            {% else %}
                                                <div class="badge-requirement-row is-complete">
                                                    Formation pratique : non nécessaire
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    <div class="badge-actions">
                                        {% set firstQuiz = quizzes|first %}
                                        {% if not qualificationStatus.theoryReady and firstQuiz and quizQuestions[firstQuiz.id]|default([])|length > 0 %}
                                            <a class="btn btn-small" href="{{ path('app_quiz_show', {formationId: formation.id, quizId: firstQuiz.id}) }}">Continuer les quiz</a>
                                        {% elseif qualificationStatus.badgeUnlocked %}
                                            <a class="btn btn-small" href="{{ path('app_profile') }}#badges">Voir sur mon profil</a>
                                        {% elseif qualificationStatus.physicalRequired and qualificationStatus.physicalFormation %}
                                            <a class="btn btn-small btn-secondary" href="#formation-physique">Voir la validation pratique</a>
                                        {% elseif qualificationStatus.physicalRequired %}
                                            <button class="btn btn-small" disabled>Validation pratique à configurer</button>
                                        {% else %}
                                            <span class="badge-database-note">Atteignez au moins 80 % de progression pour débloquer le badge.</span>
                                        {% endif %}
                                        {% if qualificationStatus.physicalRequired %}
                                            <span class="badge-database-note">Le badge demande au moins 80 % de progression et la validation pratique.</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    {% if qualificationStatus.badgeUnlocked and formation.badge %}
        <div class="badge-unlock-overlay" data-badge-unlock-overlay hidden>
            <div class="badge-unlock-dialog" role="dialog" aria-modal="true" aria-labelledby="badge-unlock-title">
                {% include 'site/_badge_visual.html.twig' with {
                    badge: formation.badge,
                    formation: formation,
                    size: 'lg',
                    locked: false
                } only %}
                <h2 id="badge-unlock-title">Badge débloqué !</h2>
                <p>Le badge « {{ formation.badge.nom }} » est maintenant visible sur votre profil et autorise la réservation des machines associées.</p>
                <button type="button" class="btn" data-badge-unlock-close>Continuer</button>
            </div>
        </div>
    {% endif %}

    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') ~ '?v=20260709-header-scope' }}"></script>
    <script src="{{ asset('js/badges.js') ~ '?v=20260707-1' }}" defer></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const circularProgress = document.querySelector('.circular-progress-svg circle:nth-of-type(2)');
            if (circularProgress) {
                circularProgress.addEventListener('mouseenter', function() {
                    this.style.transform = 'rotate(-90 50 50) scale(1.05)';
                });
                circularProgress.addEventListener('mouseleave', function() {
                    this.style.transform = 'rotate(-90 50 50) scale(1)';
                });
            }
        });
    </script>
</body>
</html>
