{% extends 'base.html.twig' %}

{% block title %}{{ 'access_passes.title'|trans }} - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260816-s134' }}">
{% endblock %}

{% block body %}
{# ⚠️ Same gap as /admin/lieux: no `list_route`, so no filter panel, no search
   and no count. Both have them now.

   ⚠️ **`page_title`, one of the three overrides.** This desk is not an admin
   navigation destination — it is the one screen a non-admin staff member
   reaches with this sidebar — so `NavBuilder` has no entry to name it.

   ⚠️ `access_passes.description` went with the shell's `description` parameter
   in S141, and lost nothing: it said what `access_passes.intro`, the first line
   of the body, already says.

   ⚠️ Above the embed, not inside it — a comment between two keys of an argument
   hash is a Twig syntax error. #}
{% embed 'site/_admin_list.html.twig' with {
    page_title: 'access_passes.title'|trans,
    panel_title: 'access_passes.grant_heading'|trans,
    panel_note: 'access_passes.panel_note'|trans({'%count%': passes|filter(pass => pass.isActive(now))|length}),
    list_count: passes|length,
    list_route: 'app_staff_access_passes',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_client_filter: true,
    list_tiles_label: 'admin_list.facet_status'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: passes|length, category: 'all', active: true},
        {label: 'access_passes.state_active'|trans, count: passes|filter(pass => pass.isActive(now))|length, category: 'active'},
        {label: 'access_passes.state_revoked'|trans, count: passes|filter(pass => pass.revokedAt)|length, category: 'revoked'},
    ],
} %}
    {% block content %}
        <p class="access-pass-intro">{{ 'access_passes.intro'|trans }}</p>

        <form method="post" action="{{ path('app_staff_access_passes') }}" class="access-pass-form">
            <input type="hidden" name="_token" value="{{ csrf_token('staff_access_passes') }}">
            <div class="access-pass-field access-pass-field-wide">
                <label for="user_id">{{ 'access_passes.person'|trans }}</label>
                <select name="user_id" id="user_id" required>
                    <option value="">{{ 'access_passes.choose'|trans }}</option>
                    {% for person in people %}
                        <option value="{{ person.id }}">{{ person.displayName }} ({{ person.email }})</option>
                    {% endfor %}
                </select>
            </div>
            <div class="access-pass-field">
                <label for="reservable_type">{{ 'access_passes.resource_type'|trans }}</label>
                <select name="reservable_type" id="reservable_type">
                    <option value="">{{ 'access_passes.all_types'|trans }}</option>
                    {% for type in types %}
                        <option value="{{ type.value }}">{{ ('reservable.type.' ~ type.value)|trans }}</option>
                    {% endfor %}
                </select>
                <span>{{ 'access_passes.all_types_help'|trans }}</span>
            </div>
            <div class="access-pass-field">
                <label for="reservable_id">{{ 'access_passes.resource'|trans }}</label>
                <input type="number" name="reservable_id" id="reservable_id" min="1" placeholder="{{ 'access_passes.resource_placeholder'|trans }}">
                <span>{{ 'access_passes.resource_help'|trans }}</span>
            </div>
            <div class="access-pass-field">
                <label for="valid_from">{{ 'access_passes.valid_from'|trans }}</label>
                <input type="datetime-local" name="valid_from" id="valid_from">
            </div>
            <div class="access-pass-field">
                <label for="valid_until">{{ 'access_passes.valid_until'|trans }}</label>
                <input type="datetime-local" name="valid_until" id="valid_until">
            </div>
            <div class="access-pass-field">
                <label for="max_uses">{{ 'access_passes.max_uses'|trans }}</label>
                <input type="number" name="max_uses" id="max_uses" min="1" placeholder="{{ 'access_passes.unlimited'|trans }}">
            </div>
            <div class="access-pass-field">
                <label for="reason">{{ 'access_passes.reason'|trans }}</label>
                <input type="text" name="reason" id="reason" maxlength="255" placeholder="{{ 'access_passes.reason_placeholder'|trans }}">
            </div>
            <div class="access-pass-actions">
                <button type="submit" class="btn-link btn-primary-admin">{{ 'access_passes.grant'|trans }}</button>
            </div>
        </form>

        <div class="access-pass-list-heading">
            <h2>{{ 'access_passes.granted_heading'|trans }}</h2>
            <p>{{ 'access_passes.granted_help'|trans }}</p>
        </div>

        {# 🔴 **Seven headers over six cells, and it shipped that way** (found in
           S141e's content review). `access_passes.col_scope` had no `<td>`: the
           scope was folded into the person cell's subtitle at some point and the
           header stayed behind, so every column after it sat under the WRONG
           name — the dates under "Portée", the uses under "Validité", the reason
           under "Utilisations", the state under "Motif" — and the revoke button
           under "État", leaving "Action" an empty sliver. That sliver is why
           "Reason" was rendering one letter per line.

           ⚠️ Five columns now, actions included, like `/admin/utilisateurs`.
           Scope and reason are both qualifiers of WHO the pass is for, so they
           are the person cell's meta line rather than two columns of their own. 
           ⚠️ Above the embed, never between two keys of its argument hash. #}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'access_passes.person'|trans, class: 'is-grow'},
                {label: 'access_passes.col_validity'|trans, class: 'is-tight'},
                {label: 'access_passes.col_uses'|trans, class: 'is-tight'},
                {label: 'access_passes.col_state'|trans, class: 'is-tight'},
                {label: 'access_passes.col_action'|trans, class: 'is-actions'},
            ],
            rows: passes,
            empty: 'access_passes.empty'|trans,
        } %}
            {% block rows %}
                {% for pass in passes %}
                    {% set holder = people|filter(person => person.id == pass.userId)|first %}
                    <tr data-admin-list-filter-row data-admin-list-filter-category="{{ pass.revokedAt ? 'revoked' : (pass.isActive(now) ? 'active' : 'spent') }}">
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: holder ? holder.displayName : '#' ~ pass.userId,
                            subtitle: pass.reason ? pass.scopeLabel ~ ' · ' ~ pass.reason : pass.scopeLabel,
                            media: include('site/_cell_media.html.twig', {
                                initials: holder ? holder.displayName : '?', shape: 'circle',
                            }, with_context = false),
                        } only %}</td>
                        <td>{% if pass.validFrom or pass.validUntil %}{% include 'site/_cell_date.html.twig' with {
                                value: pass.validFrom, convention: 'wall',
                                subtitle: pass.validUntil ? '→ ' ~ pass.validUntil|date('d/m/Y H:i') : '…',
                            } only %}{% else %}{% include 'site/_cell_empty.html.twig' with {reason: 'access_passes.no_limit'} only %}{% endif %}</td>
                        {# "3 / 10" was a bare string and "3" alone when there was no ceiling.
                           `_cell_meter` renders both, and draws the bar only when there IS one. #}
                        <td>{% include 'site/_cell_meter.html.twig' with {
                            value: useCounts[pass.id]|default(pass.usesCount),
                            max: pass.maxUses,
                            signal: 'wait',
                        } only %}</td>
                        <td>{% include 'site/_cell_state.html.twig' with {
                            label: pass.revokedAt ? 'access_passes.state_revoked'|trans : (not pass.isActive(now) ? 'access_passes.state_spent'|trans : 'access_passes.state_active'|trans),
                            signal: pass.revokedAt ? 'stop' : (not pass.isActive(now) ? 'muted' : 'go'),
                        } only %}</td>
                        <td class="is-actions">
                            {% if not pass.revokedAt %}
                                <form method="post" action="{{ path('app_staff_access_passes') }}" data-controller="confirm" data-confirm-message-value="{{ 'access_passes.confirm_revoke'|trans }}" data-action="submit->confirm#ask">
                                    <input type="hidden" name="_token" value="{{ csrf_token('staff_access_passes') }}">
                                    <input type="hidden" name="action" value="revoke">
                                    <input type="hidden" name="pass_id" value="{{ pass.id }}">
                                    <button type="submit" class="btn-action btn-danger-admin">{{ 'access_passes.revoke'|trans }}</button>
                                </form>
                            {% else %}{% include 'site/_cell_empty.html.twig' with {reason: 'access_passes.state_revoked'} only %}{% endif %}
                        </td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
