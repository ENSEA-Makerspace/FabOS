{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   S84 — the list is a `_data_table` now and the 210-line inline block is gone:
   page chrome S82 unwound, a `.admin-panel` copy that **overrode S83's ground
   and lift**, and four `.status-badge` states written as literal hexes on 10%
   tints — the same family `admin.css` already had to re-measure once for
   failing contrast. Tone tokens now, so they follow the theme. #}

{% block title %}Gestion des Réservations - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260805-s85-lists' }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'Gestion des Réservations',
    description: 'Gérez toutes les réservations du FabLab',
    panel_title: 'Liste des réservations',
    panel_note: reservations|length ~ ' réservation' ~ (reservations|length > 1 ? 's' : ''),
    has_filters: true,
} %}
    {% block filters %}
        <form class="filters-bar" method="get" action="{{ path('app_admin_reservations') }}">
            <div class="filter-group">
                <label for="search-reservations">Rechercher:</label>
                <input type="search" name="q" id="search-reservations" class="filter-input" placeholder="Machine, utilisateur, motif" value="{{ filters.q|default('') }}">
            </div>
            <div class="filter-group">
                <label for="status-reservation-filter">Statut:</label>
                <select name="statut" id="status-reservation-filter" class="filter-select">
                    <option value="all">Tous</option>
                    {% for value, label in {'confirmed': 'Confirmée', 'cancelled': 'Annulée', 'completed': 'Terminée'} %}
                        <option value="{{ value }}" {{ filters.statut|default('') == value ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-group">
                <label>Période:</label>
                <div class="filter-date-range">
                    <input type="date" name="dateFrom" id="date-start" value="{{ filters.dateFrom|default('') }}">
                    <span>à</span>
                    <input type="date" name="dateTo" id="date-end" value="{{ filters.dateTo|default('') }}">
                </div>
            </div>
            <button class="btn btn-secondary btn-small" type="submit">Filtrer</button>
            <a class="btn btn-secondary btn-small" href="{{ path('app_admin_reservations') }}">Réinitialiser</a>
        </form>
    {% endblock %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'Utilisateur', class: 'is-grow'},
                {label: 'Ressource', class: 'is-tight'},
                {label: 'Créneau', class: 'is-tight'},
                {label: 'Statut', class: 'is-tight'},
                {label: 'Actions', class: 'is-actions'},
            ],
            rows: reservations,
            empty: 'Aucune réservation enregistrée.',
        } %}
            {% block rows %}
                {% for reservation in reservations %}
                    {% set user = reservation.utilisateur %}
                    {% set res = reservable(reservation) %}
                    {% set reservationCancelled = reservation.cancelled %}
                    {% set reservationStatusClass = reservationCancelled ? 'cancelled' : (reservation.dateFin < date() ? 'completed' : 'confirmed') %}
                    {% set reservationStatusLabel = reservationCancelled ? 'Annulée' : (reservation.dateFin < date() ? 'Terminée' : 'Confirmée') %}
                    <tr>
                        <td>
                            <div class="admin-cell-user">
                                <span class="user-avatar-small">{{ user ? ((user.firstName ?? user.username)|slice(0, 1) ~ (user.lastName ?? '')|slice(0, 1))|upper : '?' }}</span>
                                <span>{% if user %}{{ user.displayName }}{% else %}Utilisateur supprimé{% endif %}</span>
                            </div>
                        </td>
                        <td>{% if res.name %}{{ res.name }}{% if res.type and res.type.value != 'machine' %} ({{ ('reservable.type.' ~ res.type.value)|trans }}){% endif %}{% if not res.exists %} <em>(supprimée)</em>{% endif %}{% else %}Ressource supprimée{% endif %}</td>
                        {# ⚠️ Convention B — a booking is human-entered wall-clock, so plain
                           `|date`. `|lab_date` here would shift every slot by the lab's
                           offset and show a 10:00 booking as 12:00. #}
                        <td>{{ reservation.dateDebut|date('d/m/Y H:i') }} — {{ reservation.dateFin|date('H:i') }}</td>
                        <td><span class="status-badge {{ reservationStatusClass }}">{{ reservationStatusLabel }}</span></td>
                        <td class="is-actions">
                            {% if not reservationCancelled %}
                                {# ⚠️ The STAFF route, not the member one. Same verb, different surface: this
                                   page is records management, so it may cancel a booking that has
                                   already started or finished. `/mes-reservations` deliberately cannot,
                                   even for an admin — there they are a member looking at their own
                                   bookings. See VerbContext. #}
                                <form method="post" action="{{ path('api_staff_reservation_cancel', {id: reservation.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_reservation_' ~ reservation.id) }}">
                                    <button class="btn btn-secondary btn-small" type="submit">Annuler</button>
                                </form>
                            {% else %}
                                <span class="user-readonly-note">Annulée</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% include 'site/_footer.html.twig' %}
{% endblock %}
