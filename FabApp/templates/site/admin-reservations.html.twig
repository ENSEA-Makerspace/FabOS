                </button>
            </div>
        </div>
    </header>

    <!-- ========================================
         CONTENU PRINCIPAL
         ======================================== -->
    <main class="main-content">
        <!-- En-tête de page -->
        <section class="admin-page-header">
            <div class="admin-page-header-content">
                <div class="admin-page-title">
                    <h1>Gestion des Réservations</h1>
                    <p>Gérez toutes les réservations du FabLab</p>
                </div>
                <div class="admin-page-actions">
                    <button class="btn btn-primary" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        Export bientôt disponible
                    </button>
                </div>
            </div>
        </section>

        <!-- Contenu principal -->
        <div class="admin-main">
            <div class="admin-content-grid">
                <!-- Sidebar -->
                {% include 'site/_admin_sidebar.html.twig' %}

                <!-- Contenu principal -->
                <div class="admin-main-content">
                    <!-- Actions de masse et filtres -->
                    <div class="admin-panel">
                        <div class="admin-panel-header">
                            <h2>Liste des réservations</h2>
                            <div class="bulk-actions">
                                <button class="btn btn-warning btn-sm" id="validate-selected" disabled>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                        <polyline points="22 4 12 14.01 9 11.01"/>
                                    </svg>
                                    Valider sélection
                                </button>
                                <button class="btn btn-danger btn-sm" id="cancel-selected" disabled>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <line x1="15" y1="9" x2="9" y2="15"/>
                                        <line x1="9" y1="9" x2="15" y2="15"/>
                                    </svg>
                                    Annuler sélection
                                </button>
                            </div>
                        </div>
                        <form class="filters-bar" method="get" action="{{ path('app_admin_reservations') }}">
                            <div class="filter-group">
                                <label for="search-reservations">Rechercher:</label>
                                <input type="search" name="q" id="search-reservations" class="filter-input" placeholder="Machine, utilisateur, motif" value="{{ filters.q|default('') }}">
                            </div>
                            <div class="filter-group">
                                <label for="status-reservation-filter">Statut:</label>
                                <select name="statut" id="status-reservation-filter" class="filter-select">
                                    <option value="all">Tous</option>
                                    {% for value, label in {'confirmed': 'Confirmée', 'cancelled': 'Annulée', 'completed': 'Terminée'} %}
                                        <option value="{{ value }}" {{ filters.statut|default('') == value ? 'selected' : '' }}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="filter-group">
                                <label>Période:</label>
                                <div class="filter-date-range">
                                    <input type="date" name="dateFrom" id="date-start" value="{{ filters.dateFrom|default('') }}">
                                    <span>à</span>
                                    <input type="date" name="dateTo" id="date-end" value="{{ filters.dateTo|default('') }}">
                                </div>
                            </div>
                            <button class="btn btn-secondary btn-small" type="submit">Filtrer</button>
                            <a class="btn btn-secondary btn-small" href="{{ path('app_admin_reservations') }}">Réinitialiser</a>
                        </form>
                    </div>

                    <!-- Liste des réservations -->
                    <div class="admin-panel">
                        <div class="reservations-list-container">
                            <div class="reservations-list-header">
                                <div class="reservation-list-row header">
                                    <div class="reservation-list-cell checkbox"><input type="checkbox" id="select-all" disabled></div>
                                    <div class="reservation-list-cell user">Utilisateur</div>
                                    <div class="reservation-list-cell machine">Machine</div>
                                    <div class="reservation-list-cell date">Date</div>
                                    <div class="reservation-list-cell start">Début</div>
                                    <div class="reservation-list-cell end">Fin</div>
                                    <div class="reservation-list-cell status">Statut</div>
                                    <div class="reservation-list-cell actions">Actions</div>
                                </div>
                            </div>
                            <div class="reservations-list">
                                {% for reservation in reservations %}
                                    {% set user = reservation.utilisateur %}
                                    {% set machine = reservation.machine %}
                                    {% set reservationCancelled = reservation.cancelled %}
                                    {% set reservationStatusClass = reservationCancelled ? 'cancelled' : (reservation.dateFin < date() ? 'completed' : 'confirmed') %}
                                    {% set reservationStatusLabel = reservationCancelled ? 'Annulée' : (reservation.dateFin < date() ? 'Terminée' : 'Confirmée') %}
                                    <div class="reservation-list-row">
                                        <div class="reservation-list-cell checkbox"><input type="checkbox" class="reservation-checkbox" disabled></div>
                                        <div class="reservation-list-cell user">
                                            <div class="user-avatar-small">{{ user ? ((user.firstName ?? user.username)|slice(0, 1) ~ (user.lastName ?? '')|slice(0, 1))|upper : '?' }}</div>
                                            <span>{% if user %}{{ user.displayName }}{% else %}Utilisateur supprimé{% endif %}</span>
                                        </div>
                                        <div class="reservation-list-cell machine">{% if machine %}{{ machine.nom }}{% else %}Machine supprimée{% endif %}</div>
                                        <div class="reservation-list-cell date">{{ reservation.dateDebut|date('d/m/Y') }}</div>
                                        <div class="reservation-list-cell start">{{ reservation.dateDebut|date('H:i') }}</div>
                                        <div class="reservation-list-cell end">{{ reservation.dateFin|date('H:i') }}</div>
                                        <div class="reservation-list-cell status"><span class="status-badge {{ reservationStatusClass }}">{{ reservationStatusLabel }}</span></div>
                                        <div class="reservation-list-cell actions">
                                            {% if not reservationCancelled %}
                                                <form method="post" action="{{ path('api_reservation_cancel', {id: reservation.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_reservation_' ~ reservation.id) }}">
                                                    <button class="btn btn-secondary btn-small" type="submit">Annuler</button>
                                                </form>
                                            {% else %}
                                                <span class="user-readonly-note">Annulée</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="reservation-list-row" style="grid-template-columns: 1fr; min-width: 320px;">
                                        <div class="reservation-list-cell">Aucune réservation enregistrée.</div>
                                    </div>
                                {% endfor %}
                            </div>

                        <div class="pagination"><span>{{ reservations|length }} réservation{{ reservations|length > 1 ? 's' : '' }}</span></div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- ========================================
         FOOTER
         ======================================== -->
    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-section">
