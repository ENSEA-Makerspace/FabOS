    <script>
        function exportReservations() {
            alert('Export des réservations en cours...');
            // En production, cela générerait un fichier CSV/Excel
        }
        
        // Sélection de toutes les réservations
        document.addEventListener('DOMContentLoaded', function() {
            const selectAllCheckbox = document.getElementById('select-all');
            const reservationCheckboxes = document.querySelectorAll('.reservation-checkbox');
            
            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', function() {
                    reservationCheckboxes.forEach(checkbox => {
                        checkbox.checked = this.checked;
                    });
                });
            }
            
            // Actions de masse
            document.getElementById('validate-selected')?.addEventListener('click', function() {
                const selected = Array.from(reservationCheckboxes).filter(cb => cb.checked);
                if (selected.length > 0) {
                    alert(`Validation de ${selected.length} réservation(s)`);
                } else {
                    alert('Veuillez sélectionner au moins une réservation');
                }
            });
            
            document.getElementById('cancel-selected')?.addEventListener('click', function() {
                const selected = Array.from(reservationCheckboxes).filter(cb => cb.checked);
                if (selected.length > 0) {
                    alert(`Annulation de ${selected.length} réservation(s)`);
                } else {
                    alert('Veuillez sélectionner au moins une réservation');
                }
            });
        });
    </script>
