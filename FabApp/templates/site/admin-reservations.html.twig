{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   S84 — the list is a `_data_table` now and the 210-line inline block is gone:
   page chrome S82 unwound, a `.admin-panel` copy that **overrode S83's ground
   and lift**, and four `.status-badge` states written as literal hexes on 10%
   tints — the same family `admin.css` already had to re-measure once for
   failing contrast. Tone tokens now, so they follow the theme. #}

{% block title %}{{ 'admin_reservations.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260903-cs' }}">
{% endblock %}

{% block body %}
{# ⚠️ The tiles count `allReservations`. `reservations` is the filtered result, so
   choosing "Annulées" made all four tiles read the same number.

   ⚠️ Kept out of the argument hash: a comment between two of its keys is a Twig
   syntax error. #}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'admin_reservations.panel_title'|trans,
    panel_note: 'admin_reservations.panel_note'|trans({'count': reservations|length}),
    list_count: reservations|length,
    list_total: allReservations|length,
    list_route: 'app_admin_reservations',
    workspace_key: filters.reservableType == 'place' ? 'spaces' : 'equipment',
    list_query: {reservableType: filters.reservableType, statut: filters.statut},
    list_search: filters.q|default(''),
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles_label: 'admin_list.facet_status'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: allReservations|length, query: {statut: ''}, active: filters.statut == ''},
        {label: 'admin_list.confirmed'|trans, count: allReservations|filter(reservation => not reservation.cancelled and reservation.dateFin >= date())|length, query: {statut: 'confirmed'}, active: filters.statut == 'confirmed'},
        {label: 'admin_list.completed'|trans, count: allReservations|filter(reservation => not reservation.cancelled and reservation.dateFin < date())|length, query: {statut: 'completed'}, active: filters.statut == 'completed'},
        {label: 'admin_list.cancelled'|trans, count: allReservations|filter(reservation => reservation.cancelled)|length, query: {statut: 'cancelled'}, active: filters.statut == 'cancelled'},
    ],
} %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'admin_reservations.col_user'|trans, class: 'is-grow'},
                {label: 'admin_reservations.col_resource'|trans, class: 'is-tight'},
                {label: 'admin_reservations.col_slot'|trans, class: 'is-tight'},
                {label: 'admin_reservations.col_status'|trans, class: 'is-tight'},
                {label: 'admin_reservations.col_actions'|trans, class: 'is-actions'},
            ],
            rows: reservations,
            empty: 'admin_reservations.empty'|trans,
        } %}
            {% block rows %}
                {% for reservation in reservations %}
                    {% set user = reservation.utilisateur %}
                    {% set res = reservable(reservation) %}
                    {% set reservationCancelled = reservation.cancelled %}
                    {% set reservationStatusClass = reservationCancelled ? 'cancelled' : (reservation.dateFin < date() ? 'completed' : 'confirmed') %}
                    {% set reservationStatusLabel = ('admin_reservations.status_' ~ reservationStatusClass)|trans %}
                    <tr data-admin-list-filter-row data-admin-list-filter-category="{{ reservationStatusClass }}">
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: user ? user.displayName : '',
                            reason: 'admin_reservations.deleted_user',
                            media: include('site/_cell_media.html.twig', {
                                initials: user ? (user.firstName ?? user.username)|slice(0, 1) ~ (user.lastName ?? '')|slice(0, 1) : '?',
                                shape: 'circle',
                            }, with_context = false),
                        } only %}</td>
                        <td>{% if res.name %}{{ res.name }}{% if res.type and res.type.value != 'machine' %} ({{ ('reservable.type.' ~ res.type.value)|trans }}){% endif %}{% if not res.exists %} <em>{{ 'admin_reservations.resource_removed'|trans }}</em>{% endif %}{% else %}{% include 'site/_cell_empty.html.twig' with {reason: 'admin_reservations.deleted_resource'} only %}{% endif %}</td>
                        {# ⚠️ `convention: 'wall'` — a booking is the digits a person typed.
                           `machine` here would shift every slot by the lab's offset and show
                           a 10:00 booking as 12:00. The cell will not guess; see its header. #}
                        <td>{% include 'site/_cell_date.html.twig' with {
                            value: reservation.dateDebut, convention: 'wall',
                            subtitle: '→ ' ~ reservation.dateFin|date('H:i'),
                        } only %}</td>
                        <td>{% include 'site/_cell_state.html.twig' with {
                            label: reservationStatusLabel,
                            signal: reservationStatusClass == 'cancelled' ? 'stop' : (reservationStatusClass == 'completed' ? 'muted' : 'go'),
                        } only %}</td>
                        <td class="is-actions">
                            {% if not reservationCancelled %}
                                {# ⚠️ The STAFF route, not the member one. Same verb, different surface: this
                                   page is records management, so it may cancel a booking that has
                                   already started or finished. `/mes-reservations` deliberately cannot,
                                   even for an admin — there they are a member looking at their own
                                   bookings. See VerbContext. #}
                                <form method="post" action="{{ path('api_staff_reservation_cancel', {id: reservation.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_reservation_' ~ reservation.id) }}">
                                    <button class="btn btn-secondary btn-small" type="submit">{{ 'common.cancel'|trans }}</button>
                                </form>
                            {% else %}
                                <span class="user-readonly-note">{{ 'admin_reservations.status_cancelled'|trans }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
