{% extends 'base.html.twig' %}

{% block title %}Objets prêtables - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260804-s78-tables' }}">
    <style>
        .admin-table { width: 100%; min-width: 640px; border-collapse: collapse; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 8px 11px; border-radius: 6px; border: 1px solid var(--border-color); text-decoration: none; color: var(--color-text); background: var(--theme-surface); font-weight: 700; cursor: pointer; font-size: 13px; }
        .mat-thumb { width: 34px; height: 34px; border-radius: 6px; object-fit: cover; vertical-align: middle; background: var(--color-bg-light); display: inline-flex; align-items: center; justify-content: center; font-size: 20px; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .admin-page-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
<main class="admin-page">
    <header class="admin-page-header">
        <div class="admin-page-header-inner">
            <div>
                <h1>Objets prêtables</h1>
                <p>Le catalogue de ce que le FabLab prête. Les emprunts se gèrent dans « Prêts ».</p>
            </div>
            <div class="admin-actions">
                <a class="btn-link" href="{{ path('app_admin_loans') }}">Voir les prêts</a>
                <a class="btn-link btn-primary-admin" href="{{ path('app_admin_loanable_item_new') }}">Ajouter un objet</a>
            </div>
        </div>
    </header>

    <div class="admin-layout">
        {% include 'site/_admin_sidebar.html.twig' %}
        <section class="admin-panel">
            <div class="admin-panel-header"><h2>Tous les objets</h2></div>
            <div>
                {% for message in app.flashes('success') %}<div class="admin-flash success">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="admin-flash error">{{ message }}</div>{% endfor %}
            </div>
            {% embed 'site/_data_table.html.twig' with {
                columns: [
                    {label: ''},
                    {label: 'adm.col_name'|trans},
                    {label: 'adm.col_category'|trans},
                    {label: 'adm.col_available'|trans},
                    {label: 'adm.col_storage'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: items,
                empty: 'adm.loanable_items_empty'|trans,
            } %}
                {% block rows %}
                    {% for item in items %}
                        {% set active = activeCounts[item.id] ?? 0 %}
                        {% set available = (item.quantity - active) > 0 ? (item.quantity - active) : 0 %}
                        <tr>
                            <td>{% if item.imageUrl %}<img class="mat-thumb" src="{{ item.imageUrl }}" alt="{{ item.name }}" onerror="this.style.display='none'">{% else %}<span class="mat-thumb">{{ item.icon ?: '🧰' }}</span>{% endif %}</td>
                            <td>{{ item.name }}</td>
                            <td>{{ item.category ?: '—' }}</td>
                            <td>{{ available }} / {{ item.quantity }}</td>
                            <td>{{ item.storageLocation ?: '—' }}</td>
                            <td>
                                <div class="admin-actions">
                                    <a class="btn-action" href="{{ path('app_admin_loanable_item_edit', {id: item.id}) }}">{{ 'common.edit'|trans }}</a>
                                    {% include 'site/_admin_delete_form.html.twig' with {
                                        action: path('app_admin_loanable_item_delete', {id: item.id}),
                                        token: 'delete_loanable_item_' ~ item.id,
                                        confirm: 'adm.confirm_delete_loanable_item'|trans,
                                        label: 'common.delete'|trans,
                                    } only %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        </section>
    </div>
</main>
{% endblock %}
