{% extends 'base.html.twig' %}

{% block title %}{{ 'loans.items_browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s134j-cells' }}">
    {# S134j — see admin-materials: `.mat-thumb` was defined identically in both
       files. `_cell_media` and `_cell_meter` now; this page has no local CSS. #}
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'loans.items_title'|trans,
    description: 'loans.items_description'|trans,
    action_label: 'loans.items_action'|trans,
    action_route: 'app_admin_loanable_item_new',
    panel_title: 'loans.items_panel'|trans,
    list_tiles_label: 'admin_list.facet_category'|trans,
    list_client_filter: true,
    list_count: items|length,
    list_route: 'app_admin_loanable_items',
    list_query: {location: venueContext.location},
    venue_context: venueContext,
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [{label: 'admin_list.all'|trans, count: items|length, category: 'all', active: true}]|merge(itemCategoryTiles),
} %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: ''},
                    {label: 'adm.col_name'|trans},
                    {label: 'adm.col_category'|trans},
                    {label: 'adm.col_available'|trans},
                    {label: 'adm.col_storage'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: items,
                empty: 'adm.loanable_items_empty'|trans,
            } %}
                {% block rows %}
                    {% for item in items %}
                        {% set active = activeCounts[item.id] ?? 0 %}
                        {% set available = (item.quantity - active) > 0 ? (item.quantity - active) : 0 %}
                        <tr data-admin-list-filter-row data-admin-list-filter-category="{{ item.category|default('')|lower|replace({' ': '-'}) }}" data-admin-list-filter-row-href="{{ path('app_admin_loanable_item_edit', {id: item.id}) }}">
                            <td>{% include 'site/_cell_media.html.twig' with {
                                src: item.imageUrl, alt: item.name, glyph: item.icon ?: '🧰',
                            } only %}</td>
                            <td>{% include 'site/_cell_title.html.twig' with {
                                title: item.name,
                                href: path('app_admin_loanable_item_edit', {id: item.id}),
                            } only %}</td>
                            <td>{{ item.category ?: '' }}</td>
                            {# "3 / 5" was a bare string; the bar says the same thing before
                               the digits are read, and 0 available now looks like 0. #}
                            <td>{% include 'site/_cell_meter.html.twig' with {
                                value: available, max: item.quantity,
                                signal: available > 0 ? 'go' : 'stop',
                            } only %}</td>
                            <td>{% if item.storageLocation %}{{ item.storageLocation }}{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}</td>
                            <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                                actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_loanable_item_edit', {id: item.id})}],
                            } only %}</td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
