{% extends 'base.html.twig' %}

{# ⚠️ **S132 rebuilt this page on the workspaces.**

   It used to draw three sections — Ressources, Activités, Annuaires — which is
   the catalogue's internal split and a taxonomy that appears nowhere else in the
   product: an operator who wants to know where events are managed reads
   "Activités" and is no wiser. The order is the workspace order the sidebar
   uses now, and each card names the workspace it owns.

   ⚠️ And **nothing on this page describes what a switch does** — it shows it.
   `FeatureSurfaces` builds the whole navigation twice, once with everything on
   and once with this one feature off, and the destinations that stopped existing
   are the ones printed. A prose description would be a second account of the
   behaviour, free to drift from the gates; this one cannot drift because it is
   the gates.

   The local `<style>` is gone with it — the switch is a primitive and lives in
   `admin.css`, shown with real markup in `/admin/design`. #}

{% block title %}{{ 'admin_features.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260903-rev' }}">
    {# AssetMapper (Stimulus seul, Turbo desactive). #}
    {{ importmap('app') }}
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main id="main-content" tabindex="-1" class="admin-page">
    <div class="admin-main-content">
        {% include 'site/_admin_sidebar.html.twig' %}
        <div class="admin-column">
        <section class="admin-panel admin-list-card admin-form-card">
            {# ⚠️ The menu's own words, not a page-specific key. See the four rules
               in ROADMAP § S141 — a hand-written title is a second copy of the
               navigation label, translated five times and free to drift. #}
            {% include 'site/_admin_form_head.html.twig' with {
                title: 'admin_nav.entry.app_admin_features'|trans,
            } only %}
            <h2>{{ 'admin_features.heading'|trans }}</h2>
            {% for message in app.flashes('success') %}<div class="flash success">{{ message|flash_text }}</div>{% endfor %}
            {% for message in app.flashes('error') %}<div class="flash error">{{ message|flash_text }}</div>{% endfor %}

            {# ⚠️ `|raw` because the value carries <strong>. Every other string on this
                page is plain text and must NOT be raw. #}
            <p class="feature-intro">{{ 'admin_features.intro'|trans|raw }}</p>

            <form method="post" action="{{ path('app_admin_features') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_features') }}">

                {% for key, surface in surfaces %}
                    {% set feature = surface.feature %}
                    {% set enabled = state[key]|default(false) %}
                    <article class="feature-card">
                        <div class="feature-card__head">
                            <div>
                                <div class="feature-card__name">{{ feature.label }}</div>
                                {% if surface.workspace %}
                                    <span class="feature-card__workspace">{{ surface.workspace }}</span>
                                {% endif %}
                                <p class="feature-card__desc">{{ feature.description }}</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="features[]" value="{{ key }}" data-feature="{{ key }}"{{ enabled ? ' checked' : '' }}
                                       aria-label="{{ feature.label }}">
                                <span class="switch__slider"></span>
                            </label>
                        </div>

                        {# Measured, not described: the destinations that stop being
                           offered. Two lists — losing a page from the public menu and
                           losing a screen from your own sidebar are different worries. #}
                        <div class="feature-effect">
                            <p class="feature-effect__title">{{ 'admin_features.effect_heading'|trans }}</p>
                            {% if surface.admin is empty and surface.public is empty %}
                                <p class="feature-effect__none">{{ 'admin_features.effect_none'|trans }}</p>
                            {% else %}
                                <dl>
                                    {% if surface.public is not empty %}
                                        <dt>{{ 'admin_features.effect_public'|trans }}</dt>
                                        <dd>{% for item in surface.public %}{{ item.translate ? item.label|trans : item.label }}{{ not loop.last ? ' · ' }}{% endfor %}</dd>
                                    {% endif %}
                                    {% if surface.admin is not empty %}
                                        <dt>{{ 'admin_features.effect_admin'|trans }}</dt>
                                        <dd>{% for item in surface.admin %}{{ item.label|trans }}{{ not loop.last ? ' · ' }}{% endfor %}</dd>
                                    {% endif %}
                                </dl>
                            {% endif %}
                        </div>

                        {# Derived from the feature, not from a group heading: only a
                           feature that owns a bookable kind refuses bookings. #}
                        {% if feature.reservable %}
                            <p class="feature-note feature-note--info">{{ 'admin_features.reservable_note'|trans }}</p>
                        {% endif %}

                        {# Warn, never block: every one of these combinations is a
                           legitimate way to run a place. The card says what the
                           operator is giving up and leaves the choice alone. #}
                        {% for note in advice[key]|default([]) %}
                            <p class="feature-note">
                                <strong>{{ 'admin_features.without'|trans({'%feature%': note.missingLabel}) }}</strong> {{ note.cost }}
                            </p>
                        {% endfor %}

                        {% set addons = registry.addonsOf(key) %}
                        {% if addons is not empty %}
                            {# Add-ons stay in the DOM and stay submitted even while dimmed,
                               so a parent switched off and back on restores them exactly as
                               the operator left them. #}
                            <div class="feature-addons {{ enabled ? '' : 'feature-addons--muted' }}" data-addons-of="{{ key }}">
                                {% for addonKey, addon in addons %}
                                    <div class="feature-addon">
                                        <div>
                                            <div class="feature-addon__label">{{ addon.label }}</div>
                                            <p class="feature-card__desc">{{ addon.description }}</p>
                                        </div>
                                        <label class="switch">
                                            <input type="checkbox" name="features[]" value="{{ addonKey }}"{{ state[addonKey]|default(false) ? ' checked' : '' }}
                                                   aria-label="{{ addon.label }}">
                                            <span class="switch__slider"></span>
                                        </label>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </article>
                {% endfor %}

                <div class="feature-actions"><button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button></div>
            </form>
        </section>
        </div>
    </div>
    </main>

    <script>
        // Dim an add-on block when its parent is off. Presentation only — the inputs
        // stay enabled so their state is still submitted and preserved.
        document.querySelectorAll('[data-feature]').forEach(function (input) {
            var addons = document.querySelector('[data-addons-of="' + input.value + '"]');
            if (!addons) { return; }
            input.addEventListener('change', function () {
                addons.classList.toggle('feature-addons--muted', !input.checked);
            });
        });
    </script>
{% endblock %}
