{% extends 'base.html.twig' %}

{% block title %}Pages du Lab - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260802-s78-forms' }}">
    <style>
        .admin-table { width: 100%; min-width: 640px; border-collapse: collapse; }
        .admin-table td.lab-child-title { padding-left: 40px; color: #6b7280; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 8px 11px; border-radius: 6px; border: 1px solid #d1d5db; text-decoration: none; color: #374151; background: #fff; font-weight: 700; cursor: pointer; font-size: 13px; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .admin-page-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
<main class="admin-page">
    <header class="admin-page-header">
        <div class="admin-page-header-inner">
            <div>
                <h1>Pages du Lab</h1>
                <p>Hiérarchie de pages sur 2 niveaux maximum, avec galerie photo.</p>
            </div>
            <a class="btn-link btn-primary-admin" href="{{ path('app_admin_lab_page_new') }}">Ajouter une page</a>
        </div>
    </header>

    <div class="admin-layout">
        {% include 'site/_admin_sidebar.html.twig' %}
        <section class="admin-panel">
            <div class="admin-panel-header"><h2>Toutes les pages</h2></div>
            <div>
                {% for message in app.flashes('success') %}<div class="admin-flash success">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="admin-flash error">{{ message }}</div>{% endfor %}
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>Titre</th><th>Photos</th><th>Actions</th></tr></thead>
                    <tbody>
                    {% for page in topLevelPages %}
                        <tr>
                            <td><strong>{{ page.titre }}</strong></td>
                            <td>{{ page.images|length }}</td>
                            <td>
                                <div class="admin-actions">
                                    <a class="btn-action" href="{{ path('app_lab_page', {id: page.id}) }}">Voir</a>
                                    <a class="btn-action" href="{{ path('app_admin_lab_page_edit', {id: page.id}) }}">Modifier</a>
                                    <form method="post" action="{{ path('app_admin_lab_page_delete', {id: page.id}) }}" onsubmit="return confirm('Supprimer cette page et ses sous-pages ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_lab_page_' ~ page.id) }}">
                                        <button class="btn-action btn-danger-admin" type="submit">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% for child in page.children %}
                            <tr>
                                <td class="lab-child-title">└ {{ child.titre }}</td>
                                <td>{{ child.images|length }}</td>
                                <td>
                                    <div class="admin-actions">
                                        <a class="btn-action" href="{{ path('app_lab_page', {id: child.id}) }}">Voir</a>
                                        <a class="btn-action" href="{{ path('app_admin_lab_page_edit', {id: child.id}) }}">Modifier</a>
                                        <form method="post" action="{{ path('app_admin_lab_page_delete', {id: child.id}) }}" onsubmit="return confirm('Supprimer cette page ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_lab_page_' ~ child.id) }}">
                                            <button class="btn-action btn-danger-admin" type="submit">Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr><td colspan="3">Aucune page enregistrée.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
{% endblock %}
