{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_lab_page.browser_title_list'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260824-s150' }}">
    <style>
        
        .admin-table td.lab-child-title { padding-left: 40px; color: var(--color-text-light); }
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'admin_lab_page.list_action'|trans,
    action_route: 'app_admin_lab_page_new',
    panel_title: 'admin_lab_page.list_panel'|trans,
    list_client_filter: true,
    panel_note: 'admin_lab_page.panel_note'|trans({'count': topLevelPages|length}),
    list_count: topLevelPages|length,
    list_route: 'app_admin_lab_pages',
    list_search_placeholder: 'common.search_placeholder'|trans,
} %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: 'adm.col_title'|trans},
                    {label: 'adm.col_photos'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: topLevelPages,
                empty: 'adm.lab_pages_empty'|trans,
            } %}
                {% block rows %}
                    {% for page in topLevelPages %}
                        <tr data-admin-list-filter-row data-admin-list-filter-row-href="{{ path('app_admin_lab_page_edit', {id: page.id}) }}">
                            <td>{% include 'site/_cell_title.html.twig' with {
                                title: page.titre,
                                href: path('app_admin_lab_page_edit', {id: page.id}),
                                subtitle: page.archived ? 'adm.archived'|trans : '',
                            } only %}</td>
                            <td class="is-numeric">{{ page.images|length }}</td>
                            <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                                actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_lab_page_edit', {id: page.id})}],
                            } only %}</td>
                        </tr>
                        {% for child in page.children %}
                            <tr data-admin-list-filter-row data-admin-list-filter-row-href="{{ path('app_admin_lab_page_edit', {id: child.id}) }}">
                                {# The child rows said "└ " in the CONTENT and carried
                                   `.lab-child-title` for the indent — a class this page
                                   defined for itself. `_cell_title` with the parent as the
                                   subtitle says the same thing in the vocabulary. #}
                                <td>{% include 'site/_cell_title.html.twig' with {
                                    title: child.titre,
                                    href: path('app_admin_lab_page_edit', {id: child.id}),
                                    subtitle: page.titre,
                                } only %}</td>
                                <td class="is-numeric">{{ child.images|length }}</td>
                                <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                                    actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_lab_page_edit', {id: child.id})}],
                                } only %}</td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
