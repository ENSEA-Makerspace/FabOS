{% extends 'base.html.twig' %}

{# S78 step 7 — this page had its own <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of these
   grew a <style> and every <style> grew literal colours. The shell emits the
   doctype, style.css, the favicon and importmap('app'); this file keeps only
   what is its own.

   S84 — the list is a `_data_table` now and the inline block is gone. It was
   145 lines and none of it survived scrutiny: page chrome S82 unwound, a
   `.admin-panel` copy that **overrode S83's ground and lift** (it loads after
   `admin.css`), and an 11-track `grid-template-columns` with a `min-width:
   1570px` — a table's own layout, hand-computed. #}

{% block title %}{{ 'admin_formations.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s130c-venue-tiles' }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'admin_formations.title'|trans,
    description: 'admin_formations.description'|trans,
    action_label: 'admin_formations.action_label'|trans,
    action_route: 'app_admin_formation_new',
    panel_title: 'admin_formations.panel_title'|trans,
    panel_note: 'admin_formations.panel_note'|trans({'%count%': formations|length}),
    list_tools: true,
    list_client_filter: false,
    list_route: 'app_admin_formations',
    list_search: filters.q|default(''),
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: formations|length, query: {}},
        {label: 'machines.level1'|trans, count: formations|filter(formation => formation.niveau == 1)|length, query: {niveau: 1}},
        {label: 'machines.level2'|trans, count: formations|filter(formation => formation.niveau == 2)|length, query: {niveau: 2}},
        {label: 'machines.level3'|trans, count: formations|filter(formation => formation.niveau == 3)|length, query: {niveau: 3}},
    ],
    has_advanced_filters: true,
} %}
    {% block advanced_filters %}
        <form class="ml-filters" method="get" action="{{ path('app_admin_formations') }}">
            <div class="ml-field"><label for="formation-level">{{ 'workspace.filter.niveau'|trans }}</label><input id="formation-level" name="niveau" value="{{ filters.niveau }}"></div>
            <div class="ml-field"><label for="formation-badge">{{ 'workspace.filter.badge'|trans }}</label><select id="formation-badge" name="badge"><option value="">—</option>{% for badge in availableBadges %}<option value="{{ badge.id }}"{{ filters.badge == badge.id ? ' selected' : '' }}>{{ badge.nom }}</option>{% endfor %}</select></div>
            <button class="ml-btn" type="submit">{{ 'common.confirm'|trans }}</button>
        </form>
    {% endblock %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'admin_formations.col_title'|trans, class: 'is-grow'},
                {label: 'admin_formations.col_level'|trans, class: 'is-tight'},
                {label: 'admin_formations.col_badge'|trans, class: 'is-tight'},
                {label: 'admin_formations.col_progressions'|trans, class: 'is-tight'},
                {label: 'admin_formations.col_actions'|trans, class: 'is-actions'},
            ],
            rows: formations,
            empty: 'admin_formations.empty'|trans,
        } %}
            {% block rows %}
                {% for formation in formations %}
                    {% set stats = progressionStats[formation.id]|default({'total': 0, 'completed': 0, 'incomplete': 0}) %}
                    <tr data-admin-list-filter-row data-admin-list-filter-category="level-{{ formation.niveau ?: 'none' }}" data-admin-list-filter-row-href="{{ path('app_admin_formation_edit', {id: formation.id}) }}">
                        <td><a href="{{ path('app_formation_detail', {id: formation.id}) }}">{{ formation.titre }}</a></td>
                        <td class="is-numeric">{{ formation.niveau ?: '-' }}</td>
                        <td>{{ formation.badge ? formation.badge.nom : '-' }}</td>
                        <td><span class="admin-meter"><i style="width: {{ stats.total ? (stats.completed / stats.total * 100)|round : 0 }}%"></i></span><span class="admin-meter-label">{{ stats.completed }} / {{ stats.total }}</span></td>
                        <td class="is-actions"><a class="admin-action" href="{{ path('app_admin_formation_edit', {id: formation.id}) }}">{% include 'site/_icon.html.twig' with { name: 'edit' } only %} {{ 'common.edit'|trans }}</a></td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
