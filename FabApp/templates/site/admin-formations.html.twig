{% extends 'base.html.twig' %}

{# S78 step 7 — this page had its own <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of these
   grew a <style> and every <style> grew literal colours. The shell emits the
   doctype, style.css, the favicon and importmap('app'); this file keeps only
   what is its own.

   S84 — the list is a `_data_table` now and the inline block is gone. It was
   145 lines and none of it survived scrutiny: page chrome S82 unwound, a
   `.admin-panel` copy that **overrode S83's ground and lift** (it loads after
   `admin.css`), and an 11-track `grid-template-columns` with a `min-width:
   1570px` — a table's own layout, hand-computed. #}

{% block title %}{{ 'admin_formations.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s148j5' }}">
{% endblock %}

{% block body %}
{# The level is what a formations list is about, so it keeps the tile row.

   ⚠️ The old "Plus de filtres" panel offered `niveau` a SECOND time, as a
   free-text box, beside the tiles that already were it — two controls writing one
   query key, and one of them accepting "7". Badge is the only real secondary
   facet and it is a menu now.

   ⚠️ Kept out of the argument hash: a comment between two of its keys is a Twig
   syntax error. #}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'admin_formations.action_label'|trans,
    action_route: 'app_admin_formation_new',
    panel_title: 'admin_formations.panel_title'|trans,
    panel_note: 'admin_formations.panel_note'|trans({'count': formations|length}),
    list_count: formations|length,
    list_total: allFormations|length,
    list_route: 'app_admin_formations',
    list_search: filters.q|default(''),
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_query: {niveau: filters.niveau, badge: filters.badge},
    list_tiles_label: 'admin_list.facet_level'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: allFormations|length, query: {niveau: ''}},
        {label: 'machines.level1'|trans, count: allFormations|filter(formation => formation.niveau == 1)|length, query: {niveau: 1}},
        {label: 'machines.level2'|trans, count: allFormations|filter(formation => formation.niveau == 2)|length, query: {niveau: 2}},
        {label: 'machines.level3'|trans, count: allFormations|filter(formation => formation.niveau == 3)|length, query: {niveau: 3}},
    ],
    list_refine: [
        {name: 'badge', label: 'workspace.filter.badge'|trans, value: filters.badge, options: [{value: '', label: 'admin_list.all'|trans}]|merge(availableBadges|map(badge => {value: badge.id, label: badge.nom}))},
    ],
} %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'admin_formations.col_title'|trans, class: 'is-grow'},
                {label: 'admin_formations.col_level'|trans, class: 'is-tight'},
                {label: 'admin_formations.col_badge'|trans, class: 'is-tight'},
                {label: 'admin_formations.col_progressions'|trans, class: 'is-tight'},
                {label: 'admin_formations.col_actions'|trans, class: 'is-actions'},
            ],
            rows: formations,
            empty: 'admin_formations.empty'|trans,
        } %}
            {% block rows %}
                {% for formation in formations %}
                    {% set stats = progressionStats[formation.id]|default({'total': 0, 'completed': 0, 'incomplete': 0}) %}
                    <tr data-admin-list-filter-row data-admin-list-filter-category="level-{{ formation.niveau ?: 'none' }}" data-admin-list-filter-row-href="{{ path('app_admin_formation_edit', {id: formation.id}) }}">
                        {# ⚠️ **No subtitle: the badge was here AND in its own column** (S141e).
                           The operator reported it as one fault with two halves — the same
                           name printed twice on a row, and the copy in the `is-tight`
                           column breaking over three lines. The column keeps the fact; the
                           subtitle gives it up. One fact once per row. #}
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: formation.titre,
                            href: path('app_formation_detail', {id: formation.id}),
                        } only %}</td>
                        <td class="is-numeric">{{ formation.niveau ?: '' }}</td>
                        {# ⚠️ The badge's NUMBER, not its name, and it links. `/admin/badges`
                           already identifies a badge as "#9 · Découpe Laser - Niveau 2", so
                           `#9` is the identity an operator has already read once; the full
                           name is the tooltip and the accessible name. A name that needs
                           three lines in a tight column is not a column, it is a paragraph. #}
                        <td>{% include 'site/_cell_chip.html.twig' with {
                            token: formation.badge ? '#' ~ formation.badge.id : '',
                            label: formation.badge ? formation.badge.nom : '',
                            href: formation.badge ? path('app_admin_badge_edit', {id: formation.badge.id}) : '',
                            reason: 'cell.no_badge',
                        } only %}</td>
                        {# `.admin-meter` inlined its own `style="width:…%"` on every list that
                           wanted one; `_cell_meter` is the shape, and it renders 0/0 as a
                           number rather than as a full bar. #}
                        <td>{% include 'site/_cell_meter.html.twig' with {
                            value: stats.completed, max: stats.total, signal: 'go',
                        } only %}</td>
                        <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                            actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_formation_edit', {id: formation.id})}],
                        } only %}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
