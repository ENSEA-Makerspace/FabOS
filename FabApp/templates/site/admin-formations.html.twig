    <!-- ========================================
         CONTENU PRINCIPAL
         ======================================== -->
    <main class="main-content">
        <!-- En-tête de page -->
        <section class="admin-page-header">
            <div class="admin-page-header-content">
                <div class="admin-page-title">
                    <h1>Gestion des Formations</h1>
                    <p>Gérez toutes les formations du FabLab</p>
                </div>
                <div class="admin-page-actions">
                    <a class="btn btn-primary" href="{{ path('app_admin_formation_new') }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Créer une formation
                    </a>
                    <span class="status-badge" style="background: rgba(76, 175, 80, 0.1); color: #4CAF50;">Edition admin active</span>
                </div>
            </div>
        </section>

        <!-- Contenu principal -->
        <div class="admin-main">
            <div class="admin-content-grid">
                <!-- Sidebar -->
                <aside class="admin-sidebar">
                    <h3>Administration</h3>
                    <nav class="admin-nav">
                        <a href="{{ path('app_admin_dashboard') }}" class="admin-nav-link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7" rx="1"/>
                                <rect x="14" y="3" width="7" height="7" rx="1"/>
                                <rect x="3" y="14" width="7" height="7" rx="1"/>
                                <rect x="14" y="14" width="7" height="7" rx="1"/>
                            </svg>
                            Tableau de bord
                        </a>
                        <a href="{{ path('app_admin_users') }}" class="admin-nav-link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                            Utilisateurs
                        </a>
                        <a href="{{ path('app_admin_machines') }}" class="admin-nav-link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                <line x1="9" y1="9" x2="15" y2="9"/>
                                <line x1="9" y1="15" x2="15" y2="15"/>
                            </svg>
                            Machines
                        </a>
                        <a href="{{ path('app_admin_badges') }}" class="admin-nav-link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                            Badges
                        </a>
                        <a href="{{ path('app_admin_formations') }}" class="admin-nav-link active">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                            </svg>
                            Formations
                        </a>
                        <a href="{{ path('app_admin_access_rfid_logs') }}" class="admin-nav-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="16" rx="2"/>
                            <path d="M7 8h10M7 12h10M7 16h6"/>
                        </svg>
                        Logs RFID
                    </a>
                    <a href="{{ path('app_admin_reservations') }}" class="admin-nav-link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                            </svg>
                            Réservations
                        </a>
                    </nav>
                </aside>

                <!-- Contenu principal -->
                <div class="admin-main-content">
                    <div class="admin-panel">
                        <div class="admin-panel-header">
                            <h2>Liste des formations</h2>
                            <div class="bulk-actions"><span class="formation-readonly-note">Données chargées depuis MariaDB</span></div>
                        </div>
                        {% for message in app.flashes('success') %}
                            <div style="margin-top: 12px; padding: 12px 14px; border-radius: 6px; background: rgba(76, 175, 80, 0.12); color: #256029; font-weight: 600;">{{ message }}</div>
                        {% endfor %}
                    </div>

                    <div class="admin-panel">
                        <div class="formations-list-container">
                            <div class="formations-list-header">
                                <div class="formation-list-row formation-db-row header">
                                    <div class="formation-list-cell">ID</div>
                                    <div class="formation-list-cell">Titre</div>
                                    <div class="formation-list-cell">Catégorie</div>
                                    <div class="formation-list-cell">Niveau</div>
                                    <div class="formation-list-cell">Durée</div>
                                    <div class="formation-list-cell">Formateur</div>
                                    <div class="formation-list-cell">Places</div>
                                    <div class="formation-list-cell">Badge</div>
                                    <div class="formation-list-cell">Progressions</div>
                                    <div class="formation-list-cell">Terminées</div>
                                    <div class="formation-list-cell">Actions</div>
                                </div>
                            </div>
                            <div class="formations-list">
                                {% for formation in formations %}
                                    {% set stats = progressionStats[formation.id]|default({'total': 0, 'completed': 0, 'incomplete': 0}) %}
                                    <div class="formation-list-row formation-db-row">
                                        <div class="formation-list-cell">#{{ formation.id }}</div>
                                        <div class="formation-list-cell"><a href="{{ path('app_formation_detail', {id: formation.id}) }}">{{ formation.titre }}</a></div>
                                        <div class="formation-list-cell">{{ formation.categorie ?: '-' }}</div>
                                        <div class="formation-list-cell">{{ formation.niveau ?: '-' }}</div>
                                        <div class="formation-list-cell">{{ formation.duree ?: '-' }}</div>
                                        <div class="formation-list-cell">{{ formation.formateur ?: '-' }}</div>
                                        <div class="formation-list-cell">{{ formation.placesTotales ?: '-' }}</div>
                                        <div class="formation-list-cell">{{ formation.badge ? formation.badge.nom ~ ' (#' ~ formation.badge.id ~ ')' : '-' }}</div>
                                        <div class="formation-list-cell">{{ stats.total }}</div>
                                        <div class="formation-list-cell">{{ stats.completed }}</div>
                                        <div class="formation-list-cell actions"><a class="pagination-link" href="{{ path('app_admin_formation_edit', {id: formation.id}) }}">Modifier</a></div>
                                    </div>
                                {% else %}
                                    <div class="formation-list-row formation-db-row"><div class="formation-list-cell">Aucune formation trouvée.</div></div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-section">
                <div class="footer-logo">
                    <span class="logo-text">FabOS</span>
                    <p>Système de gestion de FabLab</p>
                </div>
            </div>
            <div class="footer-section">
                <h4>Navigation</h4>
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('app_machines') }}">Machines</a>
                <a href="{{ path('app_calendar') }}">Calendrier</a>
                <a href="{{ path('app_formations') }}">Formations</a>
                <a href="{{ path('app_leaderboard') }}">Leaderboard</a>
            </div>
            <div class="footer-section">
                <h4>Ressources</h4>
                <a href="#">Documentation</a>
                <a href="#">Support</a>
                <a href="#">API</a>
                <a href="#">Statut</a>
            </div>
            <div class="footer-section">
                <h4>Légal</h4>
                <a href="#">Mentions légales</a>
                <a href="#">Politique de confidentialité</a>
                <a href="#">Conditions d'utilisation</a>
            </div>
        </div>
