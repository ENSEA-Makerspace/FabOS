<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Formations - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/login-register.css') }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        .admin-page-header {
            background: linear-gradient(135deg, #9E1B56 0%, #7a1542 100%);
            color: white;
            padding: var(--spacing-xl) 0;
            margin-bottom: var(--spacing-xl);
        }
        
        .admin-page-header-content {
            max-width: var(--max-width);
            margin: 0 auto;
            padding: 0 var(--spacing-lg);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-lg);
        }
        
        .admin-page-title h1 {
            font-size: var(--font-size-3xl);
            margin-bottom: var(--spacing-sm);
        }
        
        .admin-page-title p {
            opacity: 0.9;
        }
        
        .admin-page-actions {
            display: flex;
            gap: var(--spacing-sm);
        }
        
        .admin-main {
            max-width: var(--max-width);
            margin: 0 auto var(--spacing-xl);
            padding: 0 var(--spacing-lg);
        }
        
        .admin-content-grid {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: var(--spacing-xl);
        }
        
        .admin-sidebar {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            height: fit-content;
        }
        
        .admin-sidebar h3 {
            font-size: var(--font-size-lg);
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: var(--spacing-lg);
            padding-bottom: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-nav {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-xs);
        }
        
        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            padding: var(--spacing-md);
            color: var(--color-text);
            text-decoration: none;
            border-radius: var(--border-radius-sm);
            transition: all var(--transition);
            font-weight: 500;
        }
        
        .admin-nav-link:hover {
            background: var(--color-bg-light);
            color: var(--color-primary);
        }
        
        .admin-nav-link.active {
            background: var(--color-primary);
            color: white;
        }
        
        .admin-nav-link svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }
        
        .admin-main-content {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-lg);
        }
        
        .admin-panel {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-xl);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
        }
        
        .admin-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-lg);
            padding-bottom: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-panel-header h2 {
            font-size: var(--font-size-xl);
            font-weight: 600;
            color: var(--color-text);
        }
        
        .filters-bar {
            display: flex;
            gap: var(--spacing-lg);
            flex-wrap: wrap;
            margin-bottom: var(--spacing-lg);
        }
        
        .filter-group {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }
        
        .filter-group label {
            font-size: var(--font-size-sm);
            font-weight: 500;
            color: var(--color-text);
        }
        
        .filter-select {
            padding: var(--spacing-sm) var(--spacing-md);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: var(--font-size-base);
            background: white;
            cursor: pointer;
        }
        
        .filter-input {
            width: 200px;
            padding: var(--spacing-sm) var(--spacing-md);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: var(--font-size-base);
        }
        
        /* Styles pour la liste des formations */
        .bulk-actions {
            display: flex;
            gap: var(--spacing-sm);
            flex-wrap: wrap;
        }

        .btn-danger {
            background: #F44336;
            color: white;
            border: none;
        }

        .btn-danger:hover {
            background: #d32f2f;
        }

        .formations-list-container {
            overflow-x: auto;
        }

        .formations-list {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .formation-list-row {
            display: grid;
            grid-template-columns: 40px 250px 300px 150px 150px 120px 120px;
            align-items: center;
            padding: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
            transition: background var(--transition);
        }

        .formation-list-row:hover {
            background: var(--color-bg-light);
        }

        .formation-list-row.header {
            background: var(--color-bg-light);
            font-weight: 600;
            font-size: var(--font-size-sm);
        }

        .formation-list-cell {
            padding: var(--spacing-xs) var(--spacing-sm);
            font-size: var(--font-size-sm);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .formation-list-row.formation-db-row {
            grid-template-columns: 70px 220px 180px 110px 110px 170px 110px 180px 120px 120px 120px;
            min-width: 1570px;
        }

        .formation-readonly-note {
            color: var(--color-text-light);
            font-size: var(--font-size-sm);
        }

        .formation-list-cell.checkbox {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .formation-list-cell.checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--color-primary);
        }

        .formation-list-cell.actions {
            display: flex;
            justify-content: flex-end;
        }

        .formations-list-header {
            position: sticky;
            top: 0;
            z-index: 10;
            background: var(--color-text-inverse);
        }
        
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: var(--spacing-xs);
            padding: var(--spacing-lg) 0;
        }

        .pagination-link {
            min-width: 36px;
            height: 36px;
            padding: 0 var(--spacing-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
            text-decoration: none;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            transition: all var(--transition);
        }

        .pagination-link:hover {
            background: var(--color-bg-light);
            color: var(--color-primary);
        }

        .pagination-link.active {
            background: var(--color-primary);
            border-color: var(--color-primary);
            color: var(--color-text-inverse);
        }
        
        /* Responsive */
        @media (max-width: 992px) {
            .admin-content-grid {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 768px) {
            .admin-page-header-content {
                flex-direction: column;
                text-align: center;
            }
            
            .filters-bar {
                flex-direction: column;
                align-items: stretch;
            }
            
            .filter-input {
                width: 100%;
            }
            
            .formation-list-row {
                grid-template-columns: 40px 1fr 1fr;
            }
            
            .formation-list-cell:nth-child(4),
            .formation-list-cell:nth-child(5),
            .formation-list-cell:nth-child(6),
            .formation-list-cell:nth-child(7) {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- ========================================
         BANDEAU D'ALERTE
         ======================================== -->
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <!-- ========================================
         HEADER
         ======================================== -->
    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    <svg width="127" height="125" viewBox="0 0 127 125" fill="none" xmlns="http://www.w3.org/2000/svg" class="ensea-logo-svg" aria-label="Logo ENSEA">
