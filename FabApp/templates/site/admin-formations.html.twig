{% extends 'base.html.twig' %}

{# S78 step 7 — this page had its own <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of these
   grew a <style> and every <style> grew literal colours. The shell emits the
   doctype, style.css, the favicon and importmap('app'); this file keeps only
   what is its own.

   S84 — the list is a `_data_table` now and the inline block is gone. It was
   145 lines and none of it survived scrutiny: page chrome S82 unwound, a
   `.admin-panel` copy that **overrode S83's ground and lift** (it loads after
   `admin.css`), and an 11-track `grid-template-columns` with a `min-width:
   1570px` — a table's own layout, hand-computed. #}

{% block title %}Gestion des Formations - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260805-s84-surfaces' }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'Gestion des Formations',
    description: 'Gérez toutes les formations du FabLab',
    action_label: 'Créer une formation',
    action_route: 'app_admin_formation_new',
    panel_title: 'Liste des formations',
    panel_note: formations|length ~ ' formation' ~ (formations|length > 1 ? 's' : ''),
    has_filters: true,
} %}
    {% block filters %}
        <form class="filters-bar" method="get" action="{{ path('app_admin_formations') }}">
            <div class="filter-group"><label for="formation-q">Rechercher:</label><input type="search" name="q" id="formation-q" class="filter-input" placeholder="Titre, description, catégorie, formateur" value="{{ filters.q|default('') }}"></div>
            <div class="filter-group"><label for="formation-niveau">Niveau:</label><select name="niveau" id="formation-niveau" class="filter-select"><option value="all">Tous</option>{% for level in 1..3 %}<option value="{{ level }}" {{ filters.niveau|default('') == level ? 'selected' : '' }}>Niveau {{ level }}</option>{% endfor %}</select></div>
            <div class="filter-group"><label for="formation-badge">Badge:</label><select name="badge" id="formation-badge" class="filter-select"><option value="all">Tous</option>{% for badge in availableBadges|default([]) %}<option value="{{ badge.id }}" {{ filters.badge|default('') == badge.id ? 'selected' : '' }}>{{ badge.nom }}</option>{% endfor %}</select></div>
            <button class="btn btn-secondary btn-small" type="submit">Filtrer</button><a class="btn btn-secondary btn-small" href="{{ path('app_admin_formations') }}">Réinitialiser</a>
        </form>
    {% endblock %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            columns: [
                {label: 'ID', numeric: true},
                {label: 'Titre'},
                {label: 'Catégorie'},
                {label: 'Niveau', numeric: true},
                {label: 'Durée'},
                {label: 'Formateur'},
                {label: 'Places', numeric: true},
                {label: 'Badge'},
                {label: 'Progressions', numeric: true},
                {label: 'Terminées', numeric: true},
                {label: 'Actions', class: 'is-actions'},
            ],
            rows: formations,
            empty: 'Aucune formation trouvée.',
        } %}
            {% block rows %}
                {% for formation in formations %}
                    {% set stats = progressionStats[formation.id]|default({'total': 0, 'completed': 0, 'incomplete': 0}) %}
                    <tr>
                        <td class="is-numeric">#{{ formation.id }}</td>
                        <td><a href="{{ path('app_formation_detail', {id: formation.id}) }}">{{ formation.titre }}</a></td>
                        <td>{{ formation.categorie ?: '-' }}</td>
                        <td class="is-numeric">{{ formation.niveau ?: '-' }}</td>
                        <td>{{ formation.duree ?: '-' }}</td>
                        <td>{{ formation.formateur ?: '-' }}</td>
                        <td class="is-numeric">{{ formation.placesTotales ?: '-' }}</td>
                        <td>{{ formation.badge ? formation.badge.nom ~ ' (#' ~ formation.badge.id ~ ')' : '-' }}</td>
                        <td class="is-numeric">{{ stats.total }}</td>
                        <td class="is-numeric">{{ stats.completed }}</td>
                        <td class="is-actions"><a class="action-btn edit" href="{{ path('app_admin_formation_edit', {id: formation.id}) }}">Modifier</a></td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% include 'site/_footer.html.twig' %}
{% endblock %}
