<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Formations - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        .admin-page-header {
            background: linear-gradient(135deg, #9E1B56 0%, #7a1542 100%);
            color: white;
            padding: var(--spacing-xl) 0;
            margin-bottom: var(--spacing-xl);
        }
        
        .admin-page-header-content {
            max-width: var(--max-width);
            margin: 0 auto;
            padding: 0 var(--spacing-lg);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-lg);
        }
        
        .admin-page-title h1 {
            font-size: var(--font-size-3xl);
            margin-bottom: var(--spacing-sm);
        }
        
        .admin-page-title p {
            opacity: 0.9;
        }
        
        .admin-page-actions {
            display: flex;
            gap: var(--spacing-sm);
        }
        
        .admin-main {
            max-width: var(--max-width);
            margin: 0 auto var(--spacing-xl);
            padding: 0 var(--spacing-lg);
        }
        
        .admin-content-grid {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: var(--spacing-xl);
        }
        
        .admin-sidebar {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            height: fit-content;
        }
        
        .admin-sidebar h3 {
            font-size: var(--font-size-lg);
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: var(--spacing-lg);
            padding-bottom: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-nav {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-xs);
        }
        
        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            padding: var(--spacing-md);
            color: var(--color-text);
            text-decoration: none;
            border-radius: var(--border-radius-sm);
            transition: all var(--transition);
            font-weight: 500;
        }
        
        .admin-nav-link:hover {
            background: var(--color-bg-light);
            color: var(--color-primary);
        }
        
        .admin-nav-link.active {
            background: var(--color-primary);
            color: white;
        }
        
        .admin-nav-link svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }
        
        .admin-main-content {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-lg);
        }
        
        .admin-panel {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-xl);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
        }
        
        .admin-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-lg);
            padding-bottom: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-panel-header h2 {
            font-size: var(--font-size-xl);
            font-weight: 600;
            color: var(--color-text);
        }
        
        .filters-bar {
            display: flex;
            gap: var(--spacing-lg);
            flex-wrap: wrap;
            margin-bottom: var(--spacing-lg);
        }
        
        .filter-group {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }
        
        .filter-group label {
            font-size: var(--font-size-sm);
            font-weight: 500;
            color: var(--color-text);
        }
        
        .filter-select {
            padding: var(--spacing-sm) var(--spacing-md);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: var(--font-size-base);
            background: white;
            cursor: pointer;
        }
        
        .filter-input {
            width: 200px;
            padding: var(--spacing-sm) var(--spacing-md);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: var(--font-size-base);
        }
        
        /* Styles pour la liste des formations */
        .bulk-actions {
            display: flex;
            gap: var(--spacing-sm);
            flex-wrap: wrap;
        }

        .btn-danger {
            background: #F44336;
            color: white;
            border: none;
        }

        .btn-danger:hover {
            background: #d32f2f;
        }

        .formations-list-container {
            overflow-x: auto;
        }

        .formations-list {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .formation-list-row {
            display: grid;
            grid-template-columns: 40px 250px 300px 150px 150px 120px 120px;
            align-items: center;
            padding: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
            transition: background var(--transition);
        }

        .formation-list-row:hover {
            background: var(--color-bg-light);
        }

        .formation-list-row.header {
            background: var(--color-bg-light);
            font-weight: 600;
            font-size: var(--font-size-sm);
        }

        .formation-list-cell {
            padding: var(--spacing-xs) var(--spacing-sm);
            font-size: var(--font-size-sm);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .formation-list-row.formation-db-row {
            grid-template-columns: 70px 220px 180px 110px 110px 170px 110px 180px 120px 120px 120px;
            min-width: 1570px;
        }

        .formation-readonly-note {
            color: var(--color-text-light);
            font-size: var(--font-size-sm);
        }

        .formation-list-cell.checkbox {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .formation-list-cell.checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--color-primary);
        }

        .formation-list-cell.actions {
            display: flex;
            justify-content: flex-end;
        }

        .formations-list-header {
            position: sticky;
            top: 0;
            z-index: 10;
            background: var(--color-text-inverse);
        }
        
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: var(--spacing-xs);
            padding: var(--spacing-lg) 0;
        }

        .pagination-link {
            min-width: 36px;
            height: 36px;
            padding: 0 var(--spacing-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
            text-decoration: none;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            transition: all var(--transition);
        }

        .pagination-link:hover {
            background: var(--color-bg-light);
            color: var(--color-primary);
        }

        .pagination-link.active {
            background: var(--color-primary);
            border-color: var(--color-primary);
            color: var(--color-text-inverse);
        }
        
        /* Responsive */
        @media (max-width: 992px) {
            .admin-content-grid {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 768px) {
            .admin-page-header-content {
                flex-direction: column;
                text-align: center;
            }
            
            .filters-bar {
                flex-direction: column;
                align-items: stretch;
            }
            
            .filter-input {
                width: 100%;
            }
            
            .formation-list-row {
                grid-template-columns: 40px 1fr 1fr;
            }
            
            .formation-list-cell:nth-child(4),
            .formation-list-cell:nth-child(5),
            .formation-list-cell:nth-child(6),
            .formation-list-cell:nth-child(7) {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- ========================================
         BANDEAU D'ALERTE
         ======================================== -->
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <!-- ========================================
         HEADER
         ======================================== -->
    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    {% include 'site/_logo.html.twig' %}
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">Accueil</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">Calendrier</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">Machines</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">Formations</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">Leaderboard</a>
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- ========================================
         CONTENU PRINCIPAL
         ======================================== -->
    <main class="main-content">
        <!-- En-tête de page -->
        <section class="admin-page-header">
            <div class="admin-page-header-content">
                <div class="admin-page-title">
                    <h1>Gestion des Formations</h1>
                    <p>Gérez toutes les formations du FabLab</p>
                </div>
                <div class="admin-page-actions">
                    <a class="btn btn-primary" href="{{ path('app_admin_formation_new') }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Créer une formation
                    </a>
                    <span class="status-badge" style="background: rgba(76, 175, 80, 0.1); color: #4CAF50;">Edition admin active</span>
                </div>
            </div>
        </section>

        <!-- Contenu principal -->
        <div class="admin-main">
            <div class="admin-content-grid">
                <!-- Sidebar -->
                {% include 'site/_admin_sidebar.html.twig' %}

                <!-- Contenu principal -->
                <div class="admin-main-content">
                    <div class="admin-panel">
                        <div class="admin-panel-header">
                            <h2>Liste des formations</h2>
                            <div class="bulk-actions"><span class="formation-readonly-note">Données chargées depuis MariaDB</span></div>
                        </div>
                        {% for message in app.flashes('success') %}
                            <div style="margin-top: 12px; padding: 12px 14px; border-radius: 6px; background: rgba(76, 175, 80, 0.12); color: #256029; font-weight: 600;">{{ message }}</div>
                        {% endfor %}
                        <form class="filters-bar" method="get" action="{{ path('app_admin_formations') }}" style="margin-top: 18px;">
                            <div class="filter-group"><label for="formation-q">Rechercher:</label><input type="search" name="q" id="formation-q" class="filter-input" placeholder="Titre, description, catégorie, formateur" value="{{ filters.q|default('') }}"></div>
                            <div class="filter-group"><label for="formation-niveau">Niveau:</label><select name="niveau" id="formation-niveau" class="filter-select"><option value="all">Tous</option>{% for level in 1..3 %}<option value="{{ level }}" {{ filters.niveau|default('') == level ? 'selected' : '' }}>Niveau {{ level }}</option>{% endfor %}</select></div>
                            <div class="filter-group"><label for="formation-badge">Badge:</label><select name="badge" id="formation-badge" class="filter-select"><option value="all">Tous</option>{% for badge in availableBadges|default([]) %}<option value="{{ badge.id }}" {{ filters.badge|default('') == badge.id ? 'selected' : '' }}>{{ badge.nom }}</option>{% endfor %}</select></div>
                            <button class="btn btn-secondary btn-small" type="submit">Filtrer</button><a class="btn btn-secondary btn-small" href="{{ path('app_admin_formations') }}">Réinitialiser</a>
                        </form>
                    </div>

                    <div class="admin-panel">
                        <div class="formations-list-container">
                            <div class="formations-list-header">
                                <div class="formation-list-row formation-db-row header">
                                    <div class="formation-list-cell">ID</div>
                                    <div class="formation-list-cell">Titre</div>
                                    <div class="formation-list-cell">Catégorie</div>
                                    <div class="formation-list-cell">Niveau</div>
                                    <div class="formation-list-cell">Durée</div>
                                    <div class="formation-list-cell">Formateur</div>
                                    <div class="formation-list-cell">Places</div>
                                    <div class="formation-list-cell">Badge</div>
                                    <div class="formation-list-cell">Progressions</div>
                                    <div class="formation-list-cell">Terminées</div>
                                    <div class="formation-list-cell">Actions</div>
                                </div>
                            </div>
                            <div class="formations-list">
                                {% for formation in formations %}
                                    {% set stats = progressionStats[formation.id]|default({'total': 0, 'completed': 0, 'incomplete': 0}) %}
                                    <div class="formation-list-row formation-db-row">
                                        <div class="formation-list-cell">#{{ formation.id }}</div>
                                        <div class="formation-list-cell"><a href="{{ path('app_formation_detail', {id: formation.id}) }}">{{ formation.titre }}</a></div>
                                        <div class="formation-list-cell">{{ formation.categorie ?: '-' }}</div>
                                        <div class="formation-list-cell">{{ formation.niveau ?: '-' }}</div>
                                        <div class="formation-list-cell">{{ formation.duree ?: '-' }}</div>
                                        <div class="formation-list-cell">{{ formation.formateur ?: '-' }}</div>
                                        <div class="formation-list-cell">{{ formation.placesTotales ?: '-' }}</div>
                                        <div class="formation-list-cell">{{ formation.badge ? formation.badge.nom ~ ' (#' ~ formation.badge.id ~ ')' : '-' }}</div>
                                        <div class="formation-list-cell">{{ stats.total }}</div>
                                        <div class="formation-list-cell">{{ stats.completed }}</div>
                                        <div class="formation-list-cell actions"><a class="pagination-link" href="{{ path('app_admin_formation_edit', {id: formation.id}) }}">Modifier</a></div>
                                    </div>
                                {% else %}
                                    <div class="formation-list-row formation-db-row"><div class="formation-list-cell">Aucune formation trouvée.</div></div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-section">
                <div class="footer-logo">
                    <span class="logo-text">FabOS</span>
                    <p>Système de gestion de FabLab</p>
                </div>
            </div>
            <div class="footer-section">
                <h4>Navigation</h4>
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('app_machines') }}">Machines</a>
                <a href="{{ path('app_calendar') }}">Calendrier</a>
                <a href="{{ path('app_formations') }}">Formations</a>
                <a href="{{ path('app_leaderboard') }}">Leaderboard</a>
            </div>
            <div class="footer-section">
                <h4>Ressources</h4>
                <a href="#">Documentation</a>
                <a href="#">Support</a>
                <a href="#">API</a>
                <a href="#">Statut</a>
            </div>
            <div class="footer-section">
                <h4>Légal</h4>
                <a href="#">Mentions légales</a>
                <a href="#">Politique de confidentialité</a>
                <a href="#">Conditions d'utilisation</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 FabOS - Développé pour l'ENSEA. Tous droits réservés.</p>
            <p class="footer-version">Version 1.0.0</p>
        </div>
    </footer>

    <script src="{{ asset('js/main.js') ~ '?v=20260709-header-scope' }}"></script>
</body>
</html>
