<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="refresh" content="30">
    <title>{{ venue_label() }} — {{ 'kiosk.stats_title'|trans }}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: #0b1020; color: #f8fafc; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; min-height: 100vh; padding: 4vh 4vw; display: flex; flex-direction: column; }
        .kiosk-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 4vh; }
        .kiosk-head h1 { font-size: 4vw; letter-spacing: -0.02em; }
        .kiosk-head .clock { font-size: 3vw; font-weight: 800; color: #38bdf8; font-variant-numeric: tabular-nums; }
        .stats-grid { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; gap: 2.2vw; }
        .stat { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 24px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1vh; padding: 2vh; }
        .stat__value { font-size: 8vw; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
        .stat__label { font-size: 2vw; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; }
        .stat--accent .stat__value { color: #38bdf8; }
        .stat--green .stat__value { color: #22c55e; }
    </style>
    {# AssetMapper (Stimulus seul, Turbo desactive). Cette page est autonome : elle ne
       passe par aucun shell, donc elle porte sa propre ligne. #}
    {{ importmap('app') }}
</head>
<body data-controller="clock">
    <div class="kiosk-head">
        <h1>{{ 'kiosk.stats_title'|trans }}</h1>
        <div class="clock" data-clock-target="time">{{ 'now'|date('H:i', 'Europe/Paris') }}</div>
    </div>
    <div class="stats-grid">
        <div class="stat stat--accent"><span class="stat__value">{{ stats.members }}</span><span class="stat__label">{{ 'kiosk.stat_members'|trans }}</span></div>
        <div class="stat"><span class="stat__value">{{ stats.machines }}</span><span class="stat__label">{{ 'kiosk.stat_machines'|trans }}</span></div>
        <div class="stat"><span class="stat__value">{{ stats.projects }}</span><span class="stat__label">{{ 'kiosk.stat_projects'|trans }}</span></div>
        <div class="stat"><span class="stat__value">{{ stats.formations }}</span><span class="stat__label">{{ 'kiosk.stat_formations'|trans }}</span></div>
        <div class="stat"><span class="stat__value">{{ stats.badges }}</span><span class="stat__label">{{ 'kiosk.stat_badges'|trans }}</span></div>
        <div class="stat stat--green"><span class="stat__value">{{ stats.visits_today }}</span><span class="stat__label">{{ 'kiosk.stat_visits_today'|trans }}</span></div>
    </div>
</body>
</html>
