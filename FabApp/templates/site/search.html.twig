<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recherche - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    <img src="{{ asset('images/ENSEA.png') }}" alt="ENSEA" class="ensea-logo-img ensea-logo-svg">
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">Accueil</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">Calendrier</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">Machines</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">Formations</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">Leaderboard</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">Admin</a>
                    {% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header" value="{{ query|default('') }}" autofocus>
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <main class="main-content">
        <section class="search-results-section">
            <div class="container">
                <div class="page-header">
                    <div class="section-badge">Résultats de recherche</div>
                    <p class="page-description">
                        Essayez de rechercher des machines, formations ou utilisateurs.
                    </p>
                </div>

                <div class="search-results-container">
                    {% if query is empty %}
                        <div class="results-by-category">
                            <h4>Recherche</h4>
                            <div class="results-list">
                                <div class="search-result-item">
                                    <p class="search-result-description">Saisissez une recherche pour commencer.</p>
                                </div>
                            </div>
                        </div>
                    {% elseif totalResults == 0 %}
                        <div class="results-by-category">
                            <h4>Résultats pour “{{ query }}”</h4>
                            <div class="results-list">
                                <div class="search-result-item">
                                    <p class="search-result-description">Aucun résultat trouvé.</p>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="page-header" style="padding-top: 0;">
                            <h2>{{ totalResults }} résultat{{ totalResults > 1 ? 's' : '' }} pour “{{ query }}”</h2>
                        </div>

                        {% for category, items in categories %}
                            {% if items is not empty %}
                                <div class="results-by-category">
                                    <h4>{{ category }}</h4>
                                    <div class="results-list">
                                        {% for item in items %}
                                            <div class="search-result-item">
                                                <a href="{{ item.url }}" class="search-result-link">
                                                    <div class="search-result-header">
                                                        <h5>{{ item.title }}</h5>
                                                        <span class="search-result-category">{{ category }}</span>
                                                    </div>
                                                    <p class="search-result-description">{{ item.description ?: 'Sans description' }}</p>
                                                    {% if item.meta is defined and item.meta %}
                                                        <p class="search-result-description" style="margin-top: 6px;">{{ item.meta }}</p>
                                                    {% endif %}
                                                </a>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% endif %}

                    <div class="search-tips">
                        <h4>Conseils pour une meilleure recherche</h4>
                        <div class="tips-grid">
                            <div class="tip-card">
                                <div class="tip-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                        <circle cx="11" cy="11" r="8"/>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                                    </svg>
                                </div>
                                <div class="tip-content">
                                    <h5>Recherchez par nom</h5>
                                    <p>Ex: "Imprimante 3D" ou "Découpeuse Laser"</p>
                                </div>
                            </div>
                            <div class="tip-card">
                                <div class="tip-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                    </svg>
                                </div>
                                <div class="tip-content">
                                    <h5>Recherchez par catégorie</h5>
                                    <p>Ex: "Impression 3D" ou "Électronique"</p>
                                </div>
                            </div>
                            <div class="tip-card">
                                <div class="tip-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                        <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                                    </svg>
                                </div>
                                <div class="tip-content">
                                    <h5>Recherchez par description</h5>
                                    <p>Ex: "professionnelle" ou "niveau 1"</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') }}"></script>
    <style>
        .search-results-section { padding: var(--spacing-xl) 0; }
        .search-results-container { display: flex; flex-direction: column; gap: var(--spacing-xl); }
        .results-by-category { background: var(--color-bg-light); border-radius: var(--border-radius); padding: var(--spacing-lg); }
        .results-by-category h4 { margin-bottom: var(--spacing-md); color: var(--color-text); font-size: var(--font-size-lg); }
        .results-list { display: flex; flex-direction: column; gap: var(--spacing-md); }
        .search-result-item { background: white; border-radius: var(--border-radius); padding: var(--spacing-md); box-shadow: var(--shadow-sm); transition: box-shadow var(--transition), transform var(--transition); }
        .search-result-item:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
        .search-result-link { display: block; text-decoration: none; color: inherit; cursor: pointer; }
        .search-result-link:hover { text-decoration: none; }
        .search-result-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--spacing-sm); }
        .search-result-header h5 { font-size: var(--font-size-lg); color: var(--color-text); margin: 0; }
        .search-result-category { font-size: var(--font-size-sm); background: var(--color-bg-light); padding: var(--spacing-xs) var(--spacing-sm); border-radius: var(--border-radius-sm); color: var(--color-primary); }
        .search-result-description { font-size: var(--font-size-sm); color: var(--color-text-light); margin: 0; line-height: 1.5; }
        .search-tips { background: var(--color-bg-light); border-radius: var(--border-radius); padding: var(--spacing-lg); }
        .search-tips h4 { margin-bottom: var(--spacing-lg); color: var(--color-text); font-size: var(--font-size-lg); }
        .tips-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--spacing-lg); }
        .tip-card { display: flex; gap: var(--spacing-md); align-items: flex-start; background: white; padding: var(--spacing-md); border-radius: var(--border-radius); box-shadow: var(--shadow-sm); }
        .tip-icon { flex-shrink: 0; }
        .tip-icon svg { width: 40px; height: 40px; }
        .tip-content h5 { margin: 0 0 var(--spacing-xs) 0; color: var(--color-text); font-size: var(--font-size-md); }
        .tip-content p { margin: 0; font-size: var(--font-size-sm); color: var(--color-text-light); }
        @media (max-width: 768px) { .tips-grid { grid-template-columns: 1fr; } }
    </style>
</body>
</html>
