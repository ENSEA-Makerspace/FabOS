{% extends 'site/base_public.html.twig' %}

{% block title %}{{ 'search.title'|trans }} - FabOS{% endblock %}

{% block page_styles %}
    {# S139c — what is left here, and why.
       This page carried 23 local rules for 15 classes of its own; it carries 20.
       ⚠️ Three rules deleted is the honest count and it is not the point — the
       point is that the result card's title, its quiet second line and its
       category chip are no longer drawn here at all. They are `_cell_title` and
       `_cell_state`, so they cannot drift from every other list in FabOS. A
       shape that renders from the shared layer is fixed everywhere at once; a
       rule count is just what fell out.

       🔴 Before that, `.search-result-item` and `.tip-card` said `background:
       white` outright, so every card stayed a white slab on the dark ground.
       That was the operator's "results render badly in dark mode" — local CSS,
       not the `style.css` sweep the note blamed.

       ⚠️ What remains is a *panel* and a *hint card*, which nothing shared
       expresses yet; they are documented in `/admin/design#recherche` so the
       next page that needs one composes instead of reinventing. #}
    <style>
        .search-results-section { padding: var(--spacing-xl) 0; }
        .search-results-container { display: flex; flex-direction: column; gap: var(--spacing-xl); }
        .results-by-category { background: var(--surface-ground); border-radius: var(--border-radius); padding: var(--spacing-lg); }
        .results-by-category h4 { margin-bottom: var(--spacing-md); color: var(--color-text); font-size: var(--font-size-lg); }
        .results-list { display: flex; flex-direction: column; gap: var(--spacing-md); }
        .search-result-item { background: var(--theme-surface); border-radius: var(--border-radius); padding: var(--spacing-md); box-shadow: var(--shadow-sm); transition: box-shadow var(--transition), transform var(--transition); }
        .search-result-item:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
        .search-result-link { display: block; text-decoration: none; color: inherit; cursor: pointer; }
        .search-result-link:hover { text-decoration: none; }
        .search-result-header { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--spacing-sm); }
        .search-result-meta { margin: 6px 0 0; font-size: var(--font-size-sm); color: var(--color-text-light); line-height: 1.5; }
        .search-tips { background: var(--surface-ground); border-radius: var(--border-radius); padding: var(--spacing-lg); }
        .search-tips h4 { margin-bottom: var(--spacing-lg); color: var(--color-text); font-size: var(--font-size-lg); }
        .tips-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--spacing-lg); }
        .tip-card { display: flex; gap: var(--spacing-md); align-items: flex-start; background: var(--theme-surface); padding: var(--spacing-md); border-radius: var(--border-radius); box-shadow: var(--shadow-sm); }
        /* ⚠️ The three tip icons carried `stroke="#9E1B56"` — the accent's literal
           hex, so a themed install would keep FabOS's magenta. They inherit now. */
        .tip-icon { flex-shrink: 0; color: var(--color-primary-text); }
        .tip-icon svg { width: 40px; height: 40px; }
        .tip-content h5 { margin: 0 0 var(--spacing-xs) 0; color: var(--color-text); font-size: var(--font-size-md); }
        .tip-content p { margin: 0; font-size: var(--font-size-sm); color: var(--color-text-light); }
        @media (max-width: 768px) { .tips-grid { grid-template-columns: 1fr; } }
    </style>
{% endblock %}

{% block body %}
    <main id="main-content" tabindex="-1" class="main-content">
        <section class="search-results-section">
            <div class="container">
                <div class="page-header">
                    <div class="section-badge">{{ 'search.results'|trans }}</div>
                    <p class="page-description">
                        {{ 'search.try_hint'|trans }}
                    </p>
                </div>

                <div class="search-results-container">
                    {% if query is empty %}
                        <div class="results-by-category">
                            <h4>{{ 'search.title'|trans }}</h4>
                            <div class="results-list">
                                <div class="search-result-item">
                                    <p class="search-result-meta">{{ 'search.prompt'|trans }}</p>
                                </div>
                            </div>
                        </div>
                    {% elseif totalResults == 0 %}
                        <div class="results-by-category">
                            <h4>{{ 'search.results_for'|trans({'%query%': query}) }}</h4>
                            <div class="results-list">
                                <div class="search-result-item">
                                    <p class="search-result-meta">{{ 'search.none'|trans }}</p>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="page-header" style="padding-top: 0;">
                            <h2>{{ 'search.results_count_for'|trans({'count': totalResults, 'query': query}) }}</h2>
                        </div>

                        {# `SiteSearch` already dropped the empty groups and the ones whose
                           feature is switched off, so every group here has results and a
                           destination that exists. The heading is a `nav.*` key: a result
                           is filed under the menu entry that would reach it. #}
                        {% for group in groups %}
                            {% set groupLabel = group.label_key|trans %}
                            <div class="results-by-category">
                                <h4>{{ groupLabel }}</h4>
                                <div class="results-list">
                                    {% for item in group.items %}
                                        {#- ⚠️ The whole card is the link, so `_cell_title` is
                                            included WITHOUT `href`: an <a> inside an <a> is
                                            invalid and the browser silently unnests it. The
                                            list rule allows a fully clickable row precisely
                                            because a search hit has exactly one destination. -#}
                                        <div class="search-result-item">
                                            <a href="{{ item.url }}" class="search-result-link">
                                                <div class="search-result-header">
                                                    {% include 'site/_cell_title.html.twig' with {
                                                        title: item.title,
                                                        subtitle: item.description ?: null,
                                                    } only %}
                                                    {% include 'site/_cell_state.html.twig' with {
                                                        label: groupLabel, signal: 'muted',
                                                    } only %}
                                                </div>
                                                {% if item.meta %}
                                                    <p class="search-result-meta">{{ item.meta }}</p>
                                                {% endif %}
                                            </a>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}

                    <div class="search-tips">
                        <h4>{{ 'search.tips'|trans }}</h4>
                        <div class="tips-grid">
                            <div class="tip-card">
                                <div class="tip-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="11" cy="11" r="8"/>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                                    </svg>
                                </div>
                                <div class="tip-content">
                                    <h5>{{ 'search.by_name'|trans }}</h5>
                                    <p>{{ 'search.by_name_ex'|trans }}</p>
                                </div>
                            </div>
                            <div class="tip-card">
                                <div class="tip-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                    </svg>
                                </div>
                                <div class="tip-content">
                                    <h5>{{ 'search.by_category'|trans }}</h5>
                                    <p>{{ 'search.by_category_ex'|trans }}</p>
                                </div>
                            </div>
                            <div class="tip-card">
                                <div class="tip-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                                    </svg>
                                </div>
                                <div class="tip-content">
                                    <h5>{{ 'search.by_desc'|trans }}</h5>
                                    <p>{{ 'search.by_desc_ex'|trans }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
{% endblock %}
