{% extends 'site/base_public.html.twig' %}

{# Recherche : accès rapides avant la saisie, types en filtre à un clic (`?type=`), résultats en lignes avec « Voir tout » vers le catalogue filtré. Données : `SiteSearch::groups()`. #}

{% block title %}{{ 'search.title'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/proposals.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
{% set icons = {destinations: 'compass', users: 'view', machines: 'tool', places: 'map', events: 'calendar', formations: 'ticket', badges: 'key', loans: 'box', materials: 'box', creations: 'image', lab_pages: 'open'} %}
{% set catalogues = {machines: 'app_machines', places: 'app_places', events: 'app_events', formations: 'app_formations', badges: 'app_badges', loans: 'app_loans', materials: 'app_materials', creations: 'app_creations'} %}
{% set type = app.request.query.get('type', '') %}
{% set shown = type ? groups|filter(g => g.key == type) : groups %}
<main id="main-content" tabindex="-1" class="main-content">
    <section class="machine-detail-section">
        <div class="container pp-search">
            <h1>{{ 'search.title'|trans }}</h1>
            <form class="pp-search-form" method="get" action="{{ path('app_recherche') }}" role="search">
                {% include 'site/_icon.html.twig' with { name: 'search' } only %}
                <label class="sr-only" for="pp-q">{{ 'common.search'|trans }}</label>
                <input id="pp-q" type="search" name="q" value="{{ query }}" placeholder="{{ 'search.placeholder'|trans }}" {{ query is empty ? 'autofocus' : '' }}>
                {% if type %}<input type="hidden" name="type" value="{{ type }}">{% endif %}
            </form>

            {% if query == '' %}
                <h2 class="pp-search-h">{{ 'search.quick_title'|trans }}</h2>
                <div class="pp-quick">
                    {% set quick = [] %}
                    {% if app.user %}{% set quick = quick|merge([{icon: 'calendar', title: 'search.dest.my_bookings'|trans, hint: 'search.quick_bookings_hint'|trans, url: path('app_my_reservations')}]) %}{% endif %}
                    {% set quick = quick|merge([
                        {icon: 'tool', title: 'nav.machines'|trans, hint: 'search.quick_machines_hint'|trans, url: path('app_machines')},
                        {icon: 'ticket', title: 'nav.trainings'|trans, hint: 'search.quick_trainings_hint'|trans, url: path('app_formations')},
                        {icon: 'bell', title: 'nav.events'|trans, hint: 'search.quick_events_hint'|trans, url: path('app_events')},
                    ]) %}
                    {% for q in quick %}
                        <a class="pp-quick-tile" href="{{ q.url }}">
                            <span class="pp-quick-ic" aria-hidden="true">{% include 'site/_icon.html.twig' with { name: q.icon } only %}</span>
                            <b>{{ q.title }}</b><small>{{ q.hint }}</small>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <nav class="ml-cats pp-search-types" aria-label="{{ 'search.jump_label'|trans }}">
                    <a class="ml-tile{{ type == '' ? ' is-on' : '' }}" href="?q={{ query|url_encode }}">{{ 'search.all'|trans }} <span class="ml-tile-count">{{ totalResults }}</span></a>
                    {% for g in groups %}
                        <a data-search-type="{{ g.key }}" class="ml-tile{{ type == g.key ? ' is-on' : '' }}" href="?q={{ query|url_encode }}&amp;type={{ g.key }}">{{ g.label_key|trans }} <span class="ml-tile-count">{{ g.items|length }}</span></a>
                    {% endfor %}
                </nav>
                {% if totalResults == 0 %}
                    <p>{{ 'search.none'|trans }}</p>
                {% elseif shown is empty %}
                    <p>{{ 'search.none_of_type'|trans }}</p>
                {% endif %}
                {% for g in shown %}
                    <section class="pp-rows pp-search-group" data-search-group="{{ g.key }}">
                        <h2>
                            {% include 'site/_icon.html.twig' with { name: icons[g.key]|default('open') } only %}
                            {{ g.label_key|trans }} <small>{{ g.items|length }}</small>
                            {% if catalogues[g.key] is defined %}<a class="pp-search-all" href="{{ path(catalogues[g.key], {q: query}) }}">{{ 'search.see_all'|trans }} ›</a>{% endif %}
                        </h2>
                        <ul>
                            {% for item in g.items|slice(0, type ? 50 : 5) %}
                                <li>
                                    <a class="pp-search-row" href="{{ item.url }}">
                                        <span class="pp-search-ic" aria-hidden="true">{% include 'site/_icon.html.twig' with { name: icons[g.key]|default('open') } only %}</span>
                                        <span class="pp-search-what"><b>{{ item.title }}</b>{% if item.description %}<small>{{ item.description }}</small>{% endif %}</span>
                                        <span class="pp-search-meta">{{ item.meta }}</span>
                                        <span class="pp-search-go" aria-hidden="true">›</span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                        {% if not type and g.items|length > 5 %}<p class="pp-rows-more"><a href="?q={{ query|url_encode }}&amp;type={{ g.key }}">{{ 'search.all_results'|trans({'%n%': g.items|length}) }}</a></p>{% endif %}
                    </section>
                {% endfor %}
            {% endif %}
        </div>
    </section>
</main>
{% endblock %}
