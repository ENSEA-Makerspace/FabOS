{% extends 'base.html.twig' %}

{% block title %}Espaces - Admin FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260805-s84-surfaces' }}">
    <style>
        .admin-table { width: 100%; min-width: 640px; border-collapse: collapse; }
        .btn-link, .btn-action { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 8px 11px; border-radius: 6px; border: 1px solid var(--border-color); text-decoration: none; color: var(--color-text); background: var(--theme-surface); font-weight: 700; cursor: pointer; font-size: 13px; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .admin-page-header { padding: 24px 16px; } }
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'Espaces',
    description: 'Salles et espaces réservables, comme les machines.',
    action_label: 'Ajouter un espace',
    action_route: 'app_admin_place_new',
    panel_title: 'Tous les espaces',
} %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                columns: [
                    {label: 'adm.col_name'|trans},
                    {label: 'adm.col_location'|trans},
                    {label: 'adm.col_capacity'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: places,
                empty: 'adm.places_empty'|trans,
            } %}
                {% block rows %}
                    {% for place in places %}
                        <tr>
                            <td>{{ place.nom }}</td>
                            <td>{{ place.localisation ?: '—' }}</td>
                            <td>{{ place.capacite ?: '—' }}</td>
                            <td>
                                <div class="admin-actions">
                                    <a class="btn-action" href="{{ path('app_place_detail', {id: place.id}) }}">{{ 'adm.view'|trans }}</a>
                                    <a class="btn-action" href="{{ path('app_admin_place_edit', {id: place.id}) }}">{{ 'common.edit'|trans }}</a>
                                    {% include 'site/_admin_delete_form.html.twig' with {
                                        action: path('app_admin_place_delete', {id: place.id}),
                                        token: 'delete_place_' ~ place.id,
                                        confirm: 'adm.confirm_delete_place'|trans,
                                        label: 'common.delete'|trans,
                                    } only %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
