{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_places.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s132-shared' }}">
    <style>
        
        @media (max-width: 900px) {.admin-page-header { padding: 24px 16px; }}
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'admin_places.title'|trans,
    description: 'admin_places.list_description'|trans,
    action_label: 'admin_places.list_action'|trans,
    action_route: 'app_admin_place_new',
    panel_title: 'admin_places.list_panel'|trans,
    list_tools: true,
    list_client_filter: false,
    list_route: 'app_admin_places',
    list_query: {location: venueContext.location},
    list_search: filters.q,
    venue_context: venueContext,
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles: [{label: 'admin_list.all'|trans, count: places|length, query: {location: venueContext.location}}]|merge(placeCategoryTiles),
    has_advanced_filters: true,
} %}
    {% block advanced_filters %}
        <form class="ml-filters" method="get" action="{{ path('app_admin_places') }}">
            <input type="hidden" name="location" value="{{ venueContext.location }}">
            <div class="ml-field"><label for="place-manager">{{ 'admin_places.col_manager'|trans }}</label><select id="place-manager" name="manager"><option value="">—</option>{% for manager in placeManagers %}<option value="{{ manager }}"{{ filters.manager == manager ? ' selected' : '' }}>{{ manager }}</option>{% endfor %}</select></div>
            <div class="ml-field"><label for="place-department">{{ 'admin_places.col_department'|trans }}</label><select id="place-department" name="department"><option value="">—</option>{% for department in placeDepartments %}<option value="{{ department }}"{{ filters.department == department ? ' selected' : '' }}>{{ department }}</option>{% endfor %}</select></div>
            <button class="ml-btn" type="submit">{{ 'common.confirm'|trans }}</button>
        </form>
    {% endblock %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: 'adm.col_name'|trans},
                    {label: 'admin_places.col_category'|trans},
                    {label: 'admin_places.col_manager'|trans},
                    {label: 'admin_places.col_department'|trans},
                    {label: 'adm.col_actions'|trans},
                ],
                rows: places,
                empty: 'adm.places_empty'|trans,
            } %}
                {% block rows %}
                    {% for place in places %}
                        <tr data-admin-list-filter-row data-admin-list-filter-row-href="{{ path('app_admin_place_edit', {id: place.id}) }}">
                            <td>{{ place.nom }}</td>
                            <td>{{ place.category ?: '—' }}</td>
                            <td>{{ place.manager ?: '—' }}</td>
                            <td>{{ place.department ?: '—' }}</td>
                            <td>
                                <a class="admin-action" href="{{ path('app_admin_place_edit', {id: place.id}) }}">{% include 'site/_icon.html.twig' with { name: 'edit' } only %} {{ 'common.edit'|trans }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
