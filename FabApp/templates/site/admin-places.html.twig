{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_places.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s148j5' }}">
    <style>
    </style>
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'admin_places.list_action'|trans,
    action_route: 'app_admin_place_new',
    panel_title: 'admin_places.list_panel'|trans,
    panel_note: 'admin_places.panel_note'|trans({'count': places|length}),
    list_count: places|length,
    list_total: placeTotal,
    list_route: 'app_admin_places',
    list_query: {location: venueContext.location, category: filters.category, manager: filters.manager, department: filters.department},
    list_search: filters.q,
    venue_context: venueContext,
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_tiles_label: 'admin_list.facet_category'|trans,
    list_tiles: [{label: 'admin_list.all'|trans, count: placeTotal, query: {category: ''}, active: filters.category == ''}]|merge(placeCategoryTiles),
    list_refine: [
        {name: 'manager', label: 'admin_places.col_manager'|trans, value: filters.manager, options: [{value: '', label: 'admin_list.all'|trans}]|merge(placeManagers|map(manager => {value: manager, label: manager}))},
        {name: 'department', label: 'admin_places.col_department'|trans, value: filters.department, options: [{value: '', label: 'admin_list.all'|trans}]|merge(placeDepartments|map(department => {value: department, label: department}))},
    ],
} %}
    {% block content %}
            {% embed 'site/_data_table.html.twig' with {
                pin_actions: true,
                columns: [
                    {label: 'adm.col_name'|trans},
                    {label: 'admin_places.col_category'|trans},
                    {label: 'admin_places.col_manager'|trans},
                    {label: 'admin_places.col_department'|trans},
                    {label: 'adm.col_actions'|trans, class: 'is-actions'},
                ],
                rows: places,
                empty: 'adm.places_empty'|trans,
            } %}
                {% block rows %}
                    {% for place in places %}
                        <tr data-admin-list-filter-row data-admin-list-filter-row-href="{{ path('app_admin_place_edit', {id: place.id}) }}">
                            <td>{% include 'site/_cell_title.html.twig' with {
                                title: place.nom,
                                href: path('app_admin_place_edit', {id: place.id}),
                                subtitle: place.archived ? 'adm.archived'|trans : place.localisation|default(''),
                            } only %}</td>
                            <td>{% if place.category %}{{ place.category }}{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}</td>
                            <td>{% if place.manager %}{{ place.manager }}{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}</td>
                            <td>{% if place.department %}{{ place.department }}{% else %}{% include 'site/_cell_empty.html.twig' only %}{% endif %}</td>
                            <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                                actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_place_edit', {id: place.id})}],
                            } only %}</td>
                        </tr>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
