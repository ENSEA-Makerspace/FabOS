{% set admin_sidebar_variant = admin_sidebar_variant|default('standard') %}
{% if app.user and app.user.theme is defined %}
    {% set adminTheme = app.user.theme in ['light', 'dark', 'system'] ? app.user.theme : 'light' %}
    <span class="fabos-theme-preference" data-fabos-theme-preference="{{ adminTheme }}" hidden></span>
    <script>
        (() => {
            const preference = {{ adminTheme|json_encode|raw }};
            const resolved = preference === 'system'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : preference;
            document.documentElement.dataset.themePreference = preference;
            document.documentElement.dataset.theme = resolved;
            try { localStorage.setItem('fabos-theme-preference', preference); } catch (error) {}
        })();
    </script>
{% endif %}
{#
   THE ADMIN SIDEBAR — one nav model, rendered four ways.

   ⚠️ **The entries used to live here**, as a 240-line literal array with its own
   feature gating written in Twig and its own notion of "current". That made it a
   second navigation model beside `NavBuilder`, which is most of why the admin
   and the public side felt like two products. `nav_admin()` builds it now, in
   PHP, beside the header — and it is **grouped by feature**, so switching a
   feature off takes its whole section with it instead of leaving a heading
   behind.

   ⚠️ **The four variants used to be four copies of the same twelve lines**,
   differing only in the wrapper element's class and whether icons were drawn.
   They are one loop with two parameters now. A fifth surface should add a row to
   the map below, never another copy.
#}
{% set current_route = app.request.attributes.get('_route') %}
{% set shells = {
    'edit':     {tag: 'admin-edit-nav', icons: false},
    'user':     {tag: 'admin-user-nav', icons: false},
    'rfid':     {tag: 'admin-rfid-nav', icons: false},
    'standard': {tag: 'admin-sidebar',  icons: true},
} %}
{% set shell = shells[admin_sidebar_variant]|default(shells.standard) %}

{% macro admin_icon(name) %}
    {% if name == 'dashboard' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    {% elseif name == 'users' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    {% elseif name == 'machines' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
    {% elseif name == 'creations' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19h16"/><path d="M6 16l4-8 4 5 2-3 2 6"/><rect x="3" y="4" width="18" height="16" rx="2"/></svg>
    {% elseif name == 'badges' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
    {% elseif name == 'formations' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>
    {% elseif name == 'reservations' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    {% elseif name == 'logs' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></svg>
    {% elseif name == 'usage' %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19h16"/><path d="M7 16V8"/><path d="M12 16V5"/><path d="M17 16v-6"/></svg>
    {% else %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    {% endif %}
{% endmacro %}

{% import _self as admin_sidebar %}

<aside class="{{ shell.tag }}">
    <h3>Administration</h3>
    {# The standard shell keeps its inner <nav>; the three inline variants never
       had one and adding it would change their CSS out from under them. #}
    {% if shell.icons %}<nav class="admin-nav">{% endif %}
    {% for section in nav_admin() %}
        {% if section.label %}<span class="admin-nav-group-label">{{ section.label }}</span>{% endif %}
        {% for item in section.items %}
            <a href="{{ path(item.route) }}"
               class="{{ shell.icons ? 'admin-nav-link ' : '' }}{{ current_route in item.activeRoutes ? 'active' : '' }}"
               {% if current_route in item.activeRoutes %}aria-current="page"{% endif %}>
                {%- if shell.icons %}{{ admin_sidebar.admin_icon(item.icon) }}{% endif -%}
                {{ item.label }}
            </a>
        {% endfor %}
    {% endfor %}
    {% if shell.icons %}</nav>{% endif %}
</aside>
