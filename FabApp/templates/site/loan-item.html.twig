{% extends 'site/base_public.html.twig' %}

{% from 'site/_admin_inline.html.twig' import admin_actions %}

{# THE CANONICAL PAGE FOR ONE LOAN OBJECT (S133).

   Every card on `/prets` used to link to `/prets` — clicking an object reloaded
   the page you were standing on. There was nowhere for it to go; this is that
   somewhere, and the two admin lists point here as well, so "the object" means
   one address whichever list you came from.

   🔴 **S151 — cette page était la SEULE page publique sans barre de navigation.**
   Elle étendait `base.html.twig`, la coquille nue : celle-ci n'a ni bloc `header`
   ni `{% include 'site/_header.html.twig' %}`, seulement un `{% block body %}` et
   un pied de page. Les 39 autres gabarits qui l'étendent sont des écrans admin ou
   staff, et eux reçoivent l'en-tête par `_admin_list.html.twig` ; celui-ci
   n'incluait rien. Un membre qui ouvrait un objet prêtable perdait le menu et
   n'avait que le fil d'Ariane pour repartir.
   ⚠️ **Le pied de page, lui, était bien là** — d'où « le menu disparaît » et non
   « la page est nue ». Balayage de 29 pages publiques : c'était la seule.
   ⚠️ Les trois blocs utilisés ici — `title`, `stylesheets`, `body` — existent des
   deux côtés, donc le changement de parent n'en oriente aucun ailleurs.

   ⚠️ **No local `<style>`.** Since 2026-09-30 the page is built on the shared
   head of every detail page (`_detail_hero.html.twig`, styled in `details.css`);
   `_breadcrumb`, `_cell_state` and `_cell_meter` come from `components.css`. #}

{% block title %}{{ item.name }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
<main id="main-content" tabindex="-1" class="main-content">
    <section class="machine-detail-section">
        <div class="container">
            {% include 'site/_breadcrumb.html.twig' with {trail: [
                {label: 'nav.home'|trans, url: path('app_home')},
                {label: 'nav.loans'|trans, url: path('app_loans')},
                {label: item.name},
            ]} only %}

            {# 2026-09-30 — la tête partagée des fiches (`_detail_hero`) : « est-il
               libre, et comment l'emprunter ? » en tête, à côté de la photo. #}
            {% set tone = item.archived ? 'stop' : (free > 0 ? 'go' : 'wait') %}
            {% embed 'site/_detail_hero.html.twig' with {
                kicker: item.category,
                title: item.name,
                title_actions: admin_actions([
                    { route: 'app_admin_loanable_item_edit', params: { id: item.id }, label: 'admin_inline.edit'|trans }
                ]),
                photo: item.imageUrl,
            } %}
                {% block main %}
                    {% if item.description %}<p class="md-lede">{{ item.description }}</p>{% endif %}
                    <div class="md-cards">
                        <section class="detail-card md-book" aria-labelledby="md-book-title">
                            <div class="md-book-head">
                                <span class="md-verdict md-verdict--{{ tone }}" aria-hidden="true">{{ tone == 'go' ? '✓' : (tone == 'wait' ? '…' : '!') }}</span>
                                {# Not a 404 when archived: someone arriving from their own loan
                                   history is asking about a thing that existed. #}
                                <h2 id="md-book-title" class="md-book-title">{{ (item.archived ? 'loans.item_archived' : (free > 0 ? 'state.available' : 'state.borrowed'))|trans }}</h2>
                            </div>
                            {% if not item.archived %}
                                {% include 'site/_cell_meter.html.twig' with {
                                    value: free, max: item.quantity, signal: free > 0 ? 'go' : 'stop',
                                } only %}
                            {% endif %}
                            {# S193 — SON prêt, pour la personne qui l'a ; personne d'autre ne voit qui. #}
                            {% if myLoan %}
                                <p class="md-lede" data-my-loan>
                                    {{ 'loans.you_have_it'|trans({'%date%': myLoan.dateTaken|date('d/m/Y')}) }}
                                    {% if myLoan.expectedReturnDate %}· {% if myLoan.effectiveStatus == 'overdue' %}<b class="md-late">{% endif %}{{ 'loans.due_back'|trans({'%date%': myLoan.expectedReturnDate|date('d/m/Y')}) }}{% if myLoan.effectiveStatus == 'overdue' %}</b>{% endif %}{% endif %}
                                </p>
                            {% endif %}
                            {# ⚠️ No "borrow" button, and that is not an omission: checkouts are
                               recorded by staff at the desk (`/admin/prets/nouveau`). A control
                               here would be the dead affordance this page exists to remove. #}
                            <p class="md-note">{{ 'loans.item_desk_note'|trans }}</p>
                            {% if item.storageLocation or item.venue %}
                                <p class="md-book-foot">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    {{ item.storageLocation }}{% if item.storageLocation and item.venue %}<span aria-hidden="true">·</span>{% endif %}
                                    {% if item.venue %}{{ item.venue.name }}{% endif %}
                                </p>
                            {% endif %}
                        </section>
                    </div>
                {% endblock %}
                {% block fallback %}{% include 'site/_icon.html.twig' with { name: 'box' } only %}{% endblock %}
            {% endembed %}
        </div>
    </section>
</main>
{% endblock %}
