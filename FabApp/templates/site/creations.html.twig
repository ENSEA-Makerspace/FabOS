{% extends 'site/base_public.html.twig' %}

{% set body_class = 'leaderboard-sky-page' %}

{% block title %}{{ 'projects.creations'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}
    <main id="main-content" tabindex="-1" class="leaderboard-game creations-game">
        <span class="lb-cloud lb-cloud-1"></span><span class="lb-cloud lb-cloud-2"></span><span class="lb-character lb-character-happy"></span><span class="lb-character lb-character-upside"></span>
        <section class="creation-hero">
            <div class="container creation-hero-inner">
                <div>
                    <div class="creation-hero-kicker"><div class="section-badge">{{ 'projects.best_creations'|trans }}</div><a class="creation-btn secondary creation-ranking-link" href="{{ path('app_creations_ranking') }}">{{ 'projects.ranking'|trans }}</a></div>
                    <h1>{{ 'projects.gallery_title'|trans }}</h1><p>{{ 'projects.gallery_subtitle'|trans }}</p>
                </div>
                {% if app.user %}<a class="creation-btn primary" href="{{ path('app_creation_new') }}">{{ 'projects.publish'|trans }}</a>{% else %}<a class="creation-btn primary" href="{{ path('app_login') }}">{{ 'projects.login_to_publish'|trans }}</a>{% endif %}
            </div>
        </section>

        <section class="creation-gallery-section">
            <div class="container">
                {% for message in app.flashes('success') %}<div class="creation-flash success">{{ message|flash_text }}</div>{% endfor %}
                {% for message in app.flashes('warning') %}<div class="creation-flash warning">{{ message|flash_text }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="creation-flash error">{{ message|flash_text }}</div>{% endfor %}

                {% if topRows is defined and topRows|length > 0 %}
                    <section class="top-creations" aria-labelledby="top-creations-title">
                        <div class="lb-section-heading"><h2 id="top-creations-title">{{ 'projects.top_creations'|trans }}</h2></div>
                        <div class="top-creations-grid">
                            {% for row in topRows %}
                                {% set creation = row.creation %}
                                <a class="top-creation" href="{{ path('app_creation_detail', {id: creation.id}) }}">
                                    <span class="top-creation__rank">#{{ loop.index }}</span>
                                    {% include 'site/_creation_image.html.twig' with {creation: creation, class: 'top-creation__image', alt: creation.title} only %}
                                    <span class="top-creation__body"><strong>{{ creation.title }}</strong><span>{{ row.averageRating|number_format(1, '.', ' ') }}/5 · {{ 'projects.rating_count'|trans({'count': row.ratingCount}) }}</span></span>
                                </a>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}

                <div class="creation-sort-tabs" aria-label="{{ 'projects.sort_label'|trans }}">
                    <a class="leaderboard-type-btn {{ activeSort == 'recent' ? 'active' : '' }}" href="{{ path('app_creations', {sort: 'recent'}) }}">{{ 'projects.sort_recent'|trans }}</a>
                    <a class="leaderboard-type-btn {{ activeSort == 'rating' ? 'active' : '' }}" href="{{ path('app_creations', {sort: 'rating'}) }}">{{ 'projects.sort_rated'|trans }}</a>
                </div>

                <div class="creation-gallery">
                    {% for row in creationRows %}
                        {% include 'site/_creation_card.html.twig' with {row: row, link_title: true} only %}
                    {% else %}
                        <div class="creation-empty">{{ 'projects.none_yet'|trans }}</div>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>
    
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% include 'site/_creation_card_script.html.twig' %}
{% endblock %}
