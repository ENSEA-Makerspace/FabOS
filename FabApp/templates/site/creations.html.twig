{% extends 'site/base_public.html.twig' %}

{% set body_class = 'leaderboard-sky-page' %}

{% block title %}{{ 'projects.creations'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=20260823-s148j7' }}">
{% endblock %}

{% block body %}
    <main id="main-content" tabindex="-1" class="leaderboard-game creations-game">
        <span class="lb-cloud lb-cloud-1"></span><span class="lb-cloud lb-cloud-2"></span><span class="lb-character lb-character-happy"></span><span class="lb-character lb-character-upside"></span>
        <section class="creation-hero">
            <div class="container creation-hero-inner">
                <div>
                    <div class="creation-hero-kicker"><div class="section-badge">{{ 'projects.best_creations'|trans }}</div><a class="creation-btn secondary creation-ranking-link" href="{{ path('app_creations_ranking') }}">{{ 'projects.ranking'|trans }}</a></div>
                    <h1>{{ 'projects.gallery_title'|trans }}</h1><p>{{ 'projects.gallery_subtitle'|trans }}</p>
                </div>
                {% if app.user %}<a class="creation-btn primary" href="{{ path('app_creation_new') }}">{{ 'projects.publish'|trans }}</a>{% else %}<a class="creation-btn primary" href="{{ path('app_login') }}">{{ 'projects.login_to_publish'|trans }}</a>{% endif %}
            </div>
        </section>

        <section class="creation-gallery-section">
            <div class="container">
                {% for message in app.flashes('success') %}<div class="creation-flash success">{{ message|flash_text }}</div>{% endfor %}
                {% for message in app.flashes('warning') %}<div class="creation-flash warning">{{ message|flash_text }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="creation-flash error">{{ message|flash_text }}</div>{% endfor %}

                {% if topRows is defined and topRows|length > 0 %}
                    <section class="top-creations" aria-labelledby="top-creations-title">
                        <div class="lb-section-heading"><h2 id="top-creations-title">{{ 'projects.top_creations'|trans }}</h2></div>
                        <div class="top-creations-grid">
                            {% for row in topRows %}
                                {% set creation = row.creation %}
                                <a class="top-creation" href="#creation-{{ creation.id }}">
                                    <span class="top-creation__rank">#{{ loop.index }}</span>
                                    {% include 'site/_creation_image.html.twig' with {creation: creation, class: 'top-creation__image', alt: creation.title} only %}
                                    <span class="top-creation__body"><strong>{{ creation.title }}</strong><span>{{ row.averageRating|number_format(1, '.', ' ') }}/5 · {{ 'projects.rating_count'|trans({'%count%': row.ratingCount}) }}</span></span>
                                </a>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}

                <div class="creation-sort-tabs" aria-label="{{ 'projects.sort_label'|trans }}">
                    <a class="leaderboard-type-btn {{ activeSort == 'recent' ? 'active' : '' }}" href="{{ path('app_creations', {sort: 'recent'}) }}">{{ 'projects.sort_recent'|trans }}</a>
                    <a class="leaderboard-type-btn {{ activeSort == 'rating' ? 'active' : '' }}" href="{{ path('app_creations', {sort: 'rating'}) }}">{{ 'projects.sort_rated'|trans }}</a>
                </div>

                <div class="creation-gallery">
                    {% for row in creationRows %}
                        {% set creation = row.creation %}
                        {% set safeFileFilename = creation.fileFilename and creation.fileFilename matches '/^[A-Za-z0-9._-]+$/' ? creation.fileFilename : null %}
                        {% set selectedRating = row.userRating is not null ? row.userRating : 0 %}
                        <article class="creation-card" id="creation-{{ creation.id }}">
                            <div class="creation-image-wrap">
                                {% if creation.pinned %}<span class="creation-pin-badge">{{ 'projects.pinned'|trans }}</span>{% endif %}
                                {% include 'site/_creation_image.html.twig' with {creation: creation, class: 'creation-image', alt: creation.title} only %}
                            </div>
                            <div class="creation-body">
                                <div class="creation-meta"><span>{{ creation.displayAuthor }}</span><span>{{ creation.createdAt|date('d/m/Y') }}</span></div>
                                <h2>{{ creation.title }}</h2>
                                <div class="creation-stats">
                                    {% if creation.formattedPrintDuration %}<span>{{ creation.formattedPrintDuration }} {{ 'projects.printing_suffix'|trans }}</span>{% endif %}
                                    <span>{{ 'projects.average'|trans }} : {{ row.averageRating is not null ? row.averageRating|number_format(1, '.', ' ') ~ '/5' : 'projects.rating_none'|trans }}</span>
                                    {% if row.ratingCount > 0 %}
                                        <button type="button" class="creation-voters-toggle" aria-expanded="false" aria-controls="voters-{{ creation.id }}" data-target="voters-{{ creation.id }}">{{ 'projects.rating_count'|trans({'%count%': row.ratingCount}) }}</button>
                                    {% else %}
                                        <span>{{ 'projects.rating_count'|trans({'%count%': 0}) }}</span>
                                    {% endif %}
                                </div>
                                {% if row.voters is not empty %}
                                    <div class="creation-voters" id="voters-{{ creation.id }}" hidden>
                                        <strong class="creation-voters__title">{{ 'projects.who_rated'|trans }}</strong>
                                        <ul class="creation-voters__list">
                                            {% for voter in row.voters %}
                                                <li class="creation-voters__item"><span class="creation-voters__name">{{ voter.name }}</span><span class="creation-voters__rating">{{ voter.rating|number_format(1, '.', ' ') }}/5</span></li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% endif %}
                                {% if creation.tagList is not empty %}
                                    <div class="creation-tags">
                                        {% for tag in creation.tagList %}<span class="creation-tag">{{ tag }}</span>{% endfor %}
                                    </div>
                                {% endif %}
                                <p>{{ creation.description ?: 'admin_creations.shared_alt'|trans }}</p>

                                <div class="creation-rating-panel">
                                    {% if app.user %}
                                        <form method="post" action="{{ path('app_creation_vote', {id: creation.id}) }}" class="creation-rating-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('vote_creation_' ~ creation.id) }}">
                                            <input type="hidden" name="rating" value="{{ selectedRating > 0 ? selectedRating|number_format(1, '.', '') : '' }}" class="star-rating__input">
                                            <div class="star-rating" data-initial-rating="{{ selectedRating > 0 ? selectedRating|number_format(1, '.', '') : '0' }}" aria-label="{{ 'projects.rate_this'|trans }}">
                                                {% for star in 1..5 %}
                                                    <button type="button" class="star-rating__star" data-star="{{ star }}" aria-label="{{ 'projects.rate_star_aria'|trans({'%n%': star}) }}">
                                                        <span class="star-rating__base">★</span><span class="star-rating__fill">★</span>
                                                    </button>
                                                {% endfor %}
                                            </div>
                                            <div class="star-rating__status" aria-live="polite">{% if row.userRating is not null %}{{ 'projects.your_rating'|trans({'%score%': row.userRating|number_format(1, '.', ' ')}) }}{% else %}{{ 'projects.pick_rating'|trans }}{% endif %}</div>
                                            <button class="creation-btn star-rating__button" type="submit">{{ 'projects.confirm_rating'|trans }}</button>
                                        </form>
                                    {% else %}
                                        <div class="star-rating star-rating--readonly" data-initial-rating="{{ row.averageRating is not null ? row.averageRating|number_format(1, '.', '') : '0' }}" aria-label="{{ 'projects.average_of'|trans }}">
                                            {% for star in 1..5 %}<span class="star-rating__star" data-star="{{ star }}"><span class="star-rating__base">★</span><span class="star-rating__fill">★</span></span>{% endfor %}
                                        </div>
                                        <a class="creation-btn star-rating__button" href="{{ path('app_login') }}">{{ 'projects.login_to_rate'|trans }}</a>
                                    {% endif %}
                                </div>

                                <div class="creation-actions">
                                    {% if safeFileFilename %}<a href="{{ asset('uploads/creations/files/' ~ safeFileFilename) }}" class="creation-btn" download>{{ 'projects.download'|trans }}</a>{% endif %}
                                    {% if creation.externalUrl %}<a href="{{ creation.externalUrl }}" class="creation-btn secondary" target="_blank" rel="noopener noreferrer">{{ 'projects.external_link'|trans }}</a>{% endif %}
                                    {% if app.user and creation.author and app.user.id == creation.author.id %}
                                        <form method="post" action="{{ path('app_creation_delete', {id: creation.id}) }}" class="creation-delete-form"
                                              data-controller="confirm"
                                              data-action="submit->confirm#ask"
                                              data-confirm-message-value="{{ 'adm.confirm_delete_creation'|trans|e('html_attr') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_creation_' ~ creation.id) }}">
                                            <button type="submit" class="creation-btn danger">{{ 'common.delete'|trans }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        </article>
                    {% else %}
                        <div class="creation-empty">{{ 'projects.none_yet'|trans }}</div>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>
    
{% endblock %}

{% block javascripts %}
    {{ parent() }}
<script>
        {# The one sentence this block writes, translated. See the note at the top of
           public/js/quiz.js: a literal here reaches no catalogue. #}
        const RATING_LABEL = {{ 'projects.your_rating'|trans|json_encode|raw }};
        document.querySelectorAll('.creation-voters-toggle').forEach((toggle) => {
            const panel = document.getElementById(toggle.dataset.target);
            if (!panel) {
                return;
            }
            toggle.addEventListener('click', () => {
                const isHidden = panel.hasAttribute('hidden');
                if (isHidden) {
                    panel.removeAttribute('hidden');
                } else {
                    panel.setAttribute('hidden', '');
                }
                toggle.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
            });
        });

        document.querySelectorAll('.star-rating').forEach((ratingEl) => {
            const form = ratingEl.closest('.creation-rating-form');
            const input = form ? form.querySelector('.star-rating__input') : null;
            const status = form ? form.querySelector('.star-rating__status') : null;
            const stars = Array.from(ratingEl.querySelectorAll('.star-rating__star'));
            let selected = Number.parseFloat(ratingEl.dataset.initialRating || '0') || 0;

            const render = (value) => {
                stars.forEach((star) => {
                    const index = Number.parseInt(star.dataset.star, 10);
                    const fill = Math.max(0, Math.min(1, value - index + 1));
                    star.style.setProperty('--fill', `${fill * 100}%`);
                });
            };

            const select = (value) => {
                selected = Math.max(0.5, Math.min(5, Math.round(value * 2) / 2));
                if (input) {
                    input.value = selected.toFixed(1);
                }
                if (status) {
                    status.textContent = RATING_LABEL.replace('%score%', selected.toFixed(1));
                }
                render(selected);
            };

            render(selected);

            if (ratingEl.classList.contains('star-rating--readonly')) {
                return;
            }

            stars.forEach((star) => {
                const pointerValue = (event) => {
                    const rect = star.getBoundingClientRect();
                    const base = Number.parseInt(star.dataset.star, 10) - 1;
                    return base + (event.clientX - rect.left <= rect.width / 2 ? 0.5 : 1);
                };

                star.addEventListener('pointermove', (event) => render(pointerValue(event)));
                star.addEventListener('click', (event) => select(pointerValue(event)));
                star.addEventListener('keydown', (event) => {
                    if (!['ArrowLeft', 'ArrowDown', 'ArrowRight', 'ArrowUp', 'Home', 'End', 'Enter', ' '].includes(event.key)) {
                        return;
                    }
                    event.preventDefault();
                    if (event.key === 'Home') select(0.5);
                    if (event.key === 'End') select(5);
                    if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') select((selected || 0.5) - 0.5);
                    if (event.key === 'ArrowRight' || event.key === 'ArrowUp') select((selected || 0) + 0.5);
                    if (event.key === 'Enter' || event.key === ' ') select(Number.parseInt(star.dataset.star, 10));
                });
            });

            ratingEl.addEventListener('pointerleave', () => render(selected));
        });
    </script>
{% endblock %}
