{% form_theme form 'form/admin_theme.html.twig' %}
{{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
    {{ form_errors(form) }}
    <div class="form-grid">
        {{ form_row(form.name, {row_attr: {class: 'full'}}) }}
        {{ form_row(form.category) }}
        {{ form_row(form.color) }}
        {{ form_row(form.description, {row_attr: {class: 'full'}}) }}
        {{ form_row(form.imageUrl) }}
        {{ form_row(form.icon) }}
        {{ form_row(form.specs, {row_attr: {class: 'full'}}) }}
        {{ form_row(form.storageLocation) }}
        {{ form_row(form.purchaseUrl) }}
        <div class="form-field full">
            {{ form_label(form.machines) }}
            <div class="material-machines-choices">{{ form_widget(form.machines) }}</div>
            <div class="form-errors">{{ form_errors(form.machines) }}</div>
        </div>
    </div>

    <div class="form-actions">
        <a class="btn-link" href="{{ path('app_admin_materials') }}">Annuler</a>
        <span class="btn-submit">{{ form_widget(form.save, {label: submit_label|default('Enregistrer')}) }}</span>
    </div>
{{ form_end(form) }}
