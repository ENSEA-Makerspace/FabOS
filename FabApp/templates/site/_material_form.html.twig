{% form_theme form 'form/admin_theme.html.twig' %}
{{ form_start(form, {attr: {class: 'admin-edit-form', novalidate: 'novalidate'}}) }}
    {{ form_errors(form) }}

    {# ⚠️ **Le découpage vient du `FormType`, pas d'ici** — `MaterialAdminType::SECTIONS`,
       déroulée par le partiel partagé. Ce gabarit listait ses onze champs à la
       main : la constante existait, était traduite dans les cinq langues, et
       n'était lue par personne.

       🔴 **Et la liste à la main coûtait une phrase.** `form.machines` était
       dessiné champ par champ pour lui poser sa `.choice-grid`, ce qui sautait
       `form_help()` : `materials_form.help_machines` — la seule phrase qui dit que
       le matériau apparaîtra sur la fiche des machines cochées — n'était affichée
       nulle part. La classe est maintenant sur le widget (`attr`), donc
       `form_row()` suffit. #}
    {% include 'site/_form_sections.html.twig' with {
        form: form,
        sections: constant('App\\Form\\MaterialAdminType::SECTIONS'),
    } only %}

    <div class="form-actions">
        <a class="btn-link" href="{{ path('app_admin_materials') }}">{{ 'common.cancel'|trans }}</a>
        <span class="btn-submit">{{ form_widget(form.save, {label: submit_label|default('common.save'|trans)}) }}</span>
    </div>
{{ form_end(form) }}
