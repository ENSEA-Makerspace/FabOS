{% extends 'base.html.twig' %}

{% block title %}{{ 'hours.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s148j22' }}">
    {# 🔴 **Four local rules deleted in S141f, and two were the same bug twice.**
       `.alert-success` was `#e8f5e9` on `#2e7d32` and `.alert-error` `#ffebee` on
       `#b00020` — literal light-mode greens and reds on the one screen that still
       wrote its own flash markup, unchanged in dark mode. The shell emits
       `.admin-flash`, which is a band of the list card and carries the tone
       tokens. `.admin-actions` and `.admin-panel { overflow-x: auto }` were both
       shared classes this page redefined for itself. #}
    <style>
        .opening-hours-form { display: flex; flex-direction: column; gap: var(--spacing-lg); }
        .time-input { width: 130px; }
        .closed-cell { display: flex; align-items: center; gap: var(--spacing-sm); }
        .form-error-list { margin: var(--spacing-xs) 0 0; padding-left: var(--spacing-md); color: var(--color-stop); font-size: var(--font-size-sm); }
        /* S134d — a day is a stack of ranges. Two rules, kept beside the four
           that were already local to this screen rather than starting a
           third home for them. */
        .hours-ranges { display: grid; gap: 6px; }
        .hours-range { display: flex; align-items: center; gap: 8px; }
    </style>
{% endblock %}

{% block body %}
{# ⚠️ **S141f — a fourth admin skeleton, retired.** `.admin-header` +
   `.admin-main-content` with its own heading and its own flash markup. It is the
   week of one location; it goes through the list shell.

   ⚠️ **The location is this page's DEFINING facet, so it is the tile row** —
   not the "Affiner" dropdown the shell gives a list, and not the standalone
   `_venue_context` picker this page used to include. On a machines list the
   location narrows what is shown; here it chooses **which row is written**, and
   that is exactly what a tile row at the top of a page is for.

   ⚠️ **No "all locations" tile, and this is the one screen where that matters.**
   Opening hours are stored per venue, so `all` names no row to write:
   `VenueContext::single()` treats it as "not specified" and falls back to the
   default venue, which is how S131 shipped an operator editing the default
   venue's week while the URL said `location=all`. The tiles below are built from
   `venueContext.venues` and there is no `all` among them — the option cannot be
   offered rather than being offered and then ignored. #}
{% embed 'site/_admin_list.html.twig' with {
    panel_title: 'hours.weekly_plan'|trans,
    panel_note: venueContext.venues|length > 1 ? venueContext.selected.name : 'hours.panel_note'|trans({'%count%': week|length}),
    list_route: 'app_admin_opening_hours',
    list_query: {location: venueContext.location},
    list_tiles_label: 'venue_context.label'|trans,
    list_tiles: venueContext.venues|length > 1
        ? venueContext.venues|map(venue => {
            label: venue.name,
            query: {location: venue.slug},
            active: venueContext.location == venue.slug,
        })
        : [],
} %}
    {% block content %}
        <p class="usage-hint">{{ 'hours.subtitle'|trans }}</p>
        {# ⚠️ Field errors are not flashes and stay here: they belong beside the
           input that produced them. Only the page-wide ones moved to the band. #}
        {% if errors._global is defined %}
            {% for error in errors._global %}
                <div class="admin-flash error">{{ error }}</div>
            {% endfor %}
        {% endif %}

        {#  The venue rides in the action so a save writes the week the operator is
            looking at, not their default venue's. #}
        {# ⚠️ **The scope picker (S134d).** The location is this page's defining
           facet and keeps its tile row; the LEVEL is a second axis, so it is a
           dropdown — the settled rule from S130e is one-click tiles for the
           defining facet, dropdowns for the rest. A level that already carries
           hours is marked, or an operator has no way to find what they wrote. #}
        <form method="get" class="usage-assignment-form usage-grant-form">
            <input type="hidden" name="location" value="{{ venueContext.location }}">
            <label class="afp-select">
                <span class="afp-k">{{ 'hours.scope'|trans }}</span>
                <select name="scope" onchange="this.form.submit()">
                    {% for choice in scopeChoices %}
                        <option value="{{ choice.key }}" {{ choice.key == scopeKey ? 'selected' : '' }}>{{ choice.is_key ? choice.label|trans : choice.label }}{{ choice.written and choice.key != '' ? ' •' : '' }}</option>
                    {% endfor %}
                </select>
            </label>
            <noscript><button class="btn-link btn-primary-admin" type="submit">{{ 'common.apply'|trans }}</button></noscript>
        </form>
        {% if scopeKey != '' %}
            <p class="usage-hint">{{ 'hours.scope_help'|trans }}</p>
        {% endif %}

        <form method="post" action="{{ path('app_admin_opening_hours', {location: venueContext.location, scope: scopeKey}) }}" class="opening-hours-form">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_opening_hours') }}">
            <input type="hidden" name="scope" value="{{ scopeKey }}">
            {# ⚠️ **A day is a GROUP of ranges now (S134d)**, so the row is no
               longer one line. The name attributes are arrays — `open_2[]`,
               `close_2[]` — and the save replaces the day wholesale; see
               `saveOpeningWeek()` for why matching lines back onto row ids is
               the version with no obvious meaning. An empty line is how a range
               is removed. #}
            {% embed 'site/_data_table.html.twig' with {
                columns: [
                    {label: 'hours.col_day'|trans, class: 'is-grow'},
                    {label: 'hours.col_closed'|trans, class: 'is-tight'},
                    {label: 'hours.col_ranges'|trans},
                ]|merge(scopeKey != '' ? [{label: 'hours.col_effective'|trans}] : []),
                rows: week,
                empty: 'hours.empty'|trans,
            } %}
                {% block rows %}
                {% for day in week %}
                    <tr>
                        <td><strong>{{ day.label }}</strong></td>
                        <td>
                            <label class="closed-cell">
                                <input type="checkbox" name="closed_{{ day.dayOfWeek }}" value="1" {% if day.closed %}checked{% endif %}>
                                {{ 'hours.closed'|trans }}
                            </label>
                        </td>
                        <td>
                            <div class="hours-ranges">
                                {# One spare empty line beyond what exists, so adding a
                                   second range needs no JavaScript on a page that has
                                   none — the shortest honest path. #}
                                {% for range in day.ranges %}
                                    <div class="hours-range">
                                        <input class="filter-input time-input" type="time" name="open_{{ day.dayOfWeek }}[]" value="{{ range.openTime ? range.openTime|date('H:i') : '' }}" aria-label="{{ 'hours.col_open'|trans }}">
                                        <span aria-hidden="true">–</span>
                                        <input class="filter-input time-input" type="time" name="close_{{ day.dayOfWeek }}[]" value="{{ range.closeTime ? range.closeTime|date('H:i') : '' }}" aria-label="{{ 'hours.col_close'|trans }}">
                                    </div>
                                {% endfor %}
                                <div class="hours-range">
                                    <input class="filter-input time-input" type="time" name="open_{{ day.dayOfWeek }}[]" value="" aria-label="{{ 'hours.add_range'|trans }}">
                                    <span aria-hidden="true">–</span>
                                    <input class="filter-input time-input" type="time" name="close_{{ day.dayOfWeek }}[]" value="" aria-label="{{ 'hours.add_range'|trans }}">
                                </div>
                            </div>
                            {% if errors[day.dayOfWeek] is defined %}
                                <ul class="form-error-list">
                                    {% for error in errors[day.dayOfWeek] %}<li>{{ error }}</li>{% endfor %}
                                </ul>
                            {% endif %}
                        </td>
                        {% if scopeKey != '' %}
                            {# 🔴 What the hours on the left actually DO. A level may
                               only NARROW its location's, so a range written wider
                               resolves to nothing — and hours that silently do
                               nothing are the fault this codebase hit three times in
                               a week. Shown rather than forbidden. #}
                            {% set resolved = effective[day.dayOfWeek] is defined ? effective[day.dayOfWeek] : {'intervals': [], 'venue': []} %}
                            <td>
                                {% if resolved.intervals is empty %}
                                    <span class="state-chip stop">{{ resolved.venue is empty ? 'hours.effective_venue_closed'|trans : 'hours.effective_none'|trans }}</span>
                                {% else %}
                                    {% for interval in resolved.intervals %}
                                        <span class="state-chip go">{{ '%02d:%02d'|format(interval.start // 60, interval.start % 60) }} – {{ '%02d:%02d'|format(interval.end // 60, interval.end % 60) }}</span>
                                    {% endfor %}
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
                {% endblock %}
            {% endembed %}
            <p class="usage-hint">{{ 'hours.ranges_help'|trans }}</p>
            <div class="admin-actions">
                <a href="{{ path('app_admin_dashboard') }}" class="btn-link">{{ 'common.cancel'|trans }}</a>
                <button type="submit" class="btn-link btn-primary-admin">{{ 'common.save'|trans }}</button>
            </div>
        </form>
    {% endblock %}
    {% block panel_extra %}
        {# ⚠️ **A dated exception REPLACES the weekday**, and the panel says so —
           an operator who reads it as "in addition" will close a lab that should
           have been open. Its own form and its own section because it answers a
           different question from the weekly grid. #}
        <section class="usage-assignments">
            <div class="admin-panel-header"><h2>{{ 'hours.exceptions'|trans }}</h2></div>
            <p class="settings-hint">{{ 'hours.exceptions_help'|trans }}</p>

            {% if exceptionsReady %}
                {# 🔴 **Deux systèmes de mise en page sur un formulaire, et ça se
                   mesurait** : le `<form>` empruntait `usage-assignment-form` — une
                   grille à colonnes fixes écrite pour la ligne d'attribution des
                   packages — tandis que ses enfants étaient des pilules `.afp-select`
                   du `.afp-tier` des catégories. Les champs sortaient à 46, 22, 13, 46
                   et 46 px de haut, sur des lignes de base écartées de 21 px, le bouton
                   orphelin sur sa propre rangée.

                   ⚠️ **S148, J-22 — les deux sont partis pour le thème.** Une seule
                   grille (`form-grid`), le libellé au-dessus du contrôle, et les quatre
                   refus — qui s'affichaient en français en dur en haut de page — posés
                   sous le champ fautif. #}
                {{ form_start(exceptionForm, {action: path('app_admin_opening_hours', {location: venueContext.location}), attr: {class: 'form-grid hours-exception-form'}}) }}
                    {% form_theme exceptionForm 'form/admin_theme.html.twig' %}
                    {{ form_row(exceptionForm.exception_date) }}
                    {{ form_row(exceptionForm.exception_end) }}
                    {{ form_row(exceptionForm.exception_reason) }}
                    {{ form_row(exceptionForm.exception_closed) }}
                    {{ form_row(exceptionForm.exception_open) }}
                    {{ form_row(exceptionForm.exception_close) }}
                    <div class="form-field full"><button class="btn-link btn-primary-admin" type="submit">{{ 'hours.exception_add'|trans }}</button></div>
                {{ form_end(exceptionForm) }}
            {% else %}
                <p class="usage-empty">{{ 'hours.exceptions_migration_pending'|trans }}</p>
            {% endif %}

            {% if exceptions %}
                <div class="usage-assignment-list">
                    {% for exception in exceptions %}
                        <div class="usage-assignment">
                            <span>
                                <strong>{% if exception.spansSeveralDays %}{{ 'hours.exception_span'|trans({
                                    '%from%': exception.exceptionDate|date('d/m/Y'),
                                    '%to%': exception.lastDate|date('d/m/Y'),
                                    '%count%': exception.dayCount,
                                }) }}{% else %}{{ exception.exceptionDate|date('d/m/Y') }}{% endif %}</strong>
                                <small>
                                    {% if exception.opensTheDay %}{{ exception.openTime|date('H:i') }} – {{ exception.closeTime|date('H:i') }}{% else %}{{ 'hours.closed'|trans }}{% endif %}
                                    {%- if exception.reason %} · {{ exception.reason }}{% endif %}
                                </small>
                            </span>
                            <form method="post" action="{{ path('app_admin_opening_hours', {location: venueContext.location}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_opening_hours') }}">
                                <input type="hidden" name="action" value="delete_exception">
                                <input type="hidden" name="exception_id" value="{{ exception.id }}">
                                <button class="admin-action danger" type="submit">{{ 'common.delete'|trans }}</button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="usage-empty">{{ 'hours.no_exceptions'|trans }}</p>
            {% endif %}
        </section>
    {% endblock %}
{% endembed %}
{% endblock %}
