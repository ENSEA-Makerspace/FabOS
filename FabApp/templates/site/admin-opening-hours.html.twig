{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'hours.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s134h-lists' }}">
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260811-s134h-lists' }}">
    <style>

        .opening-hours-form { display: flex; flex-direction: column; gap: var(--spacing-lg); }
        .time-input { width: 130px; }
        .closed-cell { display: flex; align-items: center; gap: var(--spacing-sm); }
        .form-error-list { margin: var(--spacing-xs) 0 0; padding-left: var(--spacing-md); color: #b00020; font-size: var(--font-size-sm); }
        .alert { padding: var(--spacing-md); border-radius: var(--border-radius-sm); margin-bottom: var(--spacing-md); }
        .alert-success { background: #e8f5e9; color: #2e7d32; }
        .alert-error { background: #ffebee; color: #b00020; }
        .admin-actions { display: flex; justify-content: flex-end; gap: var(--spacing-md); }
        @media (max-width: 900px) {.opening-hours-table { min-width: 720px; } .admin-panel { overflow-x: auto; }}
    </style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}

    <section class="admin-header">
        <div class="admin-header-content">
            <h1>{{ 'hours.title'|trans }}</h1>
            <p>{{ 'hours.subtitle'|trans }}</p>
        </div>
    </section>

    <main class="admin-main-content">
                {% include 'site/_admin_sidebar.html.twig' %}

        <div class="admin-column">
        <section class="admin-panel">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
            {% if errors._global is defined %}
                {% for error in errors._global %}
                    <div class="alert alert-error">{{ error }}</div>
                {% endfor %}
            {% endif %}

            {#  ⚠️ The "only when there is a choice to make" test used to be here and
                is now inside the partial (S130c) — this screen had it from the start
                and the admin list shell never did, so the same control was correct on
                one page and noise on forty. One rule, one place.

                `allow_all: false` because opening hours are stored per venue: "all"
                names no row to write. #}
            {% include 'site/_venue_context.html.twig' with {
                venue_context: venueContext,
                list_route: 'app_admin_opening_hours',
                allow_all: false,
            } only %}

            <h2>{{ 'hours.weekly_plan'|trans }}{% if venueContext.venues|length > 1 %} — {{ venueContext.selected.name }}{% endif %}</h2>
            {#  The venue rides in the action so a save writes the week the operator is
                looking at, not their default venue's. #}
            <form method="post" action="{{ path('app_admin_opening_hours', {location: venueContext.location}) }}" class="opening-hours-form">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_opening_hours') }}">
                {% embed 'site/_data_table.html.twig' with {
                    columns: [
                        {label: 'hours.col_day'|trans},
                        {label: 'hours.col_closed'|trans},
                        {label: 'hours.col_open'|trans},
                        {label: 'hours.col_close'|trans},
                        {label: 'hours.col_display'|trans},
                    ],
                    rows: openingHours,
                    empty: 'hours.empty'|trans,
                } %}
                    {% block rows %}
                    {% for hour in openingHours %}
                        <tr>
                            <td><strong>{{ hour.label }}</strong></td>
                            <td>
                                <label class="closed-cell">
                                    <input type="checkbox" name="closed_{{ hour.dayOfWeek }}" value="1" {% if hour.closed %}checked{% endif %}>
                                    {{ 'hours.closed'|trans }}
                                </label>
                            </td>
                            <td>
                                <input class="filter-input time-input" type="time" name="open_{{ hour.dayOfWeek }}" value="{{ hour.openTime ? hour.openTime|date('H:i') : '' }}">
                            </td>
                            <td>
                                <input class="filter-input time-input" type="time" name="close_{{ hour.dayOfWeek }}" value="{{ hour.closeTime ? hour.closeTime|date('H:i') : '' }}">
                                {% if errors[hour.dayOfWeek] is defined %}
                                    <ul class="form-error-list">
                                        {% for error in errors[hour.dayOfWeek] %}
                                            <li>{{ error }}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </td>
                            <td>{{ hour.displayLabel }}</td>
                        </tr>
                    {% endfor %}
                    {% endblock %}
                {% endembed %}
                <div class="admin-actions">
                    <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary">{{ 'common.cancel'|trans }}</a>
                    <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                </div>
            </form>
        </section>
        </div>
    </main>
{% endblock %}
