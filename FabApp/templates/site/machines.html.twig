{% extends 'site/base_public.html.twig' %}

{#
   The machine catalogue, on S59's list shape (2026-08-01).

   Replaces a 494-line page that filtered client-side over every card in the DOM
   with ~250 lines of inline JS, carried a grid/list toggle and a favourites
   star, and grouped nothing.

   What this page is, in order of what a member wants to know:
     1. how many machines are free RIGHT NOW
     2. what kind of machine am I after       → the category tiles
     3. which specific one                    → the grid
     4. can I get on it at all                → the footer of each card

   ⚠️ Availability and permission are different KINDS of fact and are separated
   by POSITION, not by colour. The header says what is true of the machine
   (libre / occupée / complet / hors service / labo fermé); the footer says what
   is true of you (libre-service / formation requise). A member who reads
   "indisponible" when the truth is "pas formé" waits for something that will
   never happen.

   ⚠️ Filtering is server-side. The URL is shareable, the page works with no
   JavaScript, and there is no client-side copy of the rules to drift.
#}

{% block title %}{{ 'nav.machines'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=20260801-s59' }}">
{% endblock %}

{% block body %}
<main class="ml-wrap">

    <div class="ml-head">
        <h1>{{ 'nav.machines'|trans }}</h1>
        {% if freeCount > 0 %}
            <span class="ml-headline">
                <strong>{{ freeCount }}</strong> {{ 'machines.available_now'|trans }}
            </span>
        {% endif %}
    </div>

    {# Categories first: you look for "a laser cutter" before you look for which
       one. Persistent tiles rather than headings — headings would leave a group
       of one as a row of one, six times down the page. #}
    <nav class="ml-cats" aria-label="{{ 'machines.all_categories'|trans }}">
        <a class="ml-tile{{ category == '' ? ' is-on' : '' }}"
           href="{{ path('app_machines', search ? {q: search} : {}) }}">
            <span class="ml-tile-label">{{ 'machines.all_short'|trans }}</span>
            <span class="ml-tile-count">{{ allCount }}</span>
        </a>
        {% for tile in tiles %}
            <a class="ml-tile{{ category == tile.slug ? ' is-on' : '' }}"
               href="{{ path('app_machines', search ? {cat: tile.slug, q: search} : {cat: tile.slug}) }}">
                <span class="ml-tile-icon">
                    {% include 'site/_category_icon.html.twig' with { slug: tile.slug } only %}
                </span>
                <span class="ml-tile-label">{{ tile.label }}</span>
                <span class="ml-tile-count">
                    {{ tile.total }}{% if tile.free > 0 %} · <span class="ml-free">{{ tile.free }} {{ 'machines.free_short'|trans }}</span>{% endif %}
                </span>
            </a>
        {% endfor %}
    </nav>

    <form class="ml-filters" method="get" action="{{ path('app_machines') }}">
        <div class="ml-field">
            <label for="ml-q">{{ 'common.search'|trans({}, 'messages') }}</label>
            <input id="ml-q" type="search" name="q" value="{{ search }}"
                   placeholder="{{ 'machines.search_placeholder2'|trans }}">
        </div>
        {% if category %}<input type="hidden" name="cat" value="{{ category }}">{% endif %}
        <button class="ml-btn" type="submit">{{ 'common.search'|trans }}</button>
        {% if search or category %}
            <a class="ml-reset" href="{{ path('app_machines') }}">{{ 'common.reset'|trans }}</a>
        {% endif %}
    </form>

    <p class="ml-count">
        {{ totalCount }} machine{{ totalCount > 1 ? 's' : '' }}{% if totalCount != allCount %}
        <span class="ml-muted">/ {{ allCount }}</span>{% endif %}
    </p>

    {% if cards is empty %}
        <p class="ml-empty">
            {{ 'machines.none_found'|trans({}, 'messages')|default('Aucune machine ne correspond.') }}
            <a href="{{ path('app_machines') }}">{{ 'common.reset'|trans }}</a>
        </p>
    {% endif %}

    <div class="ml-grid">
        {% for entry in cards %}
            {% set m = entry.machine %}
            <article class="ml-card">
                <a href="{{ path('app_machine_detail', {id: m.id}) }}" class="ml-card-link">

                    <div class="ml-card-head">
                        <span class="ml-card-cat" title="{{ entry.catLabel }}">
                            {% include 'site/_category_icon.html.twig' with { slug: entry.catSlug } only %}
                        </span>

                        {# Order matters: closed before busy. A shut venue is not a
                           busy machine. #}
                        {% if entry.down %}
                            <span class="ml-state ml-state-down"><span class="ml-dot"></span>{{ 'machines.state_down'|trans }}</span>
                        {% elseif not venueOpenNow %}
                            <span class="ml-state ml-state-closed"><span class="ml-dot"></span>{{ 'machines.state_closed'|trans }}</span>
                        {% elseif entry.freeNow %}
                            <span class="ml-state ml-state-free"><span class="ml-dot"></span>{{ 'machines.state_free'|trans }}</span>
                        {% elseif entry.slot %}
                            <span class="ml-state ml-state-busy"><span class="ml-dot"></span>{{ 'machines.state_busy'|trans }}</span>
                        {% else %}
                            <span class="ml-state ml-state-busy"><span class="ml-dot"></span>{{ 'machines.state_full'|trans }}</span>
                        {% endif %}
                    </div>

                    {# Same fixed ratio with a photo or without, so the grid stays
                       even in a lab where three machines are photographed and
                       eight are not. #}
                    <div class="ml-media">
                        {% if m.photo %}
                            <img src="{{ m.photo starts with 'http' or m.photo starts with '/' ? m.photo : asset(m.photo) }}"
                                 alt="" loading="lazy" decoding="async">
                        {% else %}
                            <span class="ml-media-icon">
                                {% include 'site/_category_icon.html.twig' with { slug: entry.catSlug } only %}
                            </span>
                        {% endif %}
                    </div>

                    <div class="ml-card-body">
                        {# ⚠️ `Machine` has no brand/model column — the make is
                           smuggled into `nom` ("Imprimante 3D Ultimaker S5"). Until
                           S74 splits them, the name is the headline because that is
                           where the model lives, and the category is the type line. #}
                        <h2 class="ml-name">{{ m.nom }}</h2>
                        <p class="ml-type">{{ entry.catLabel }}</p>
                        {% if m.localisation %}
                            <p class="ml-loc">{{ m.localisation }}</p>
                        {% endif %}

                        {# Only WHEN — the state itself is in the header.
                           ⚠️ Gated on qualification: a time offered to an untrained
                           member is a promise book() refuses. #}
                        {% if entry.slot and entry.authorized %}
                            <p class="ml-next">{{ 'machines.bookable_from'|trans }}
                                <strong>{{ entry.slot.start|date('d/m H:i', 'Europe/Paris') }}</strong></p>
                        {% elseif entry.slot %}
                            <p class="ml-next">{{ 'machines.next_slot'|trans }}
                                <strong>{{ entry.slot.start|date('d/m H:i', 'Europe/Paris') }}</strong></p>
                        {% elseif not entry.down %}
                            <p class="ml-next">{{ 'machines.no_slot'|trans }}</p>
                        {% endif %}
                    </div>

                    <div class="ml-card-foot">
                        {% if entry.authorized or not entry.requiresTraining %}
                            <span class="ml-req ml-req-none">{{ 'machines.req_none'|trans }}</span>
                        {% else %}
                            <span class="ml-req ml-req-yes">🔒 {{ 'machines.req_yes'|trans }}</span>
                        {% endif %}
                        <span class="ml-see">{{ 'machines.see'|trans }}</span>
                    </div>
                </a>
            </article>
        {% endfor %}
    </div>
</main>
{% endblock %}
