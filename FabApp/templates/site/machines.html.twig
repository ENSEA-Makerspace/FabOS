{% extends 'site/base_public.html.twig' %}

{#
   The machine catalogue. All layout lives in `site/_catalogue.html.twig` and
   `site/_catalogue_card.html.twig`; this file only decides the WORDS.

   That split is the point. Espaces, objets prêtables, matériaux and the
   directories all reuse the same two shells, so a future layout change happens
   once and reaches every catalogue — which is exactly what did not happen with
   the seven hand-rolled `*-detail` templates.

   ⚠️ The state vocabulary is per entity and belongs here, not in the shell. A
   machine is libre/occupée/complet/hors service; a loanable item is
   disponible/emprunté/en retard; a room is libre/occupée/fermé. Pushing those
   words into the shell would mean branching on entity type in there, which is
   the one thing that would kill it.
#}

{% block title %}{{ 'nav.machines'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/machines-list.css') ~ '?v=20260903-design2' }}">
{% endblock %}

{% block body %}
{# ⚠️ The "Affiner" level values are `levelSlug` ("niveau-1"), not integers —
   that is the column this page filters on. Passing 1/2/3 matched nothing.

   ⚠️ This note is ABOVE the embed: a Twig comment between two entries of an
   argument hash is a syntax error, and putting it inside took /machines down for
   the length of one deploy. Third time this session. #}
{% embed 'site/_catalogue.html.twig' with {
    venue_context: venueContext,
    refine: [
        {name: 'niveau', label: 'workspace.filter.niveau'|trans, value: level, options: [
            {value: '', label: 'admin_list.all'|trans},
            {value: 'niveau-1', label: 'machines.level1'|trans},
            {value: 'niveau-2', label: 'machines.level2'|trans},
            {value: 'niveau-3', label: 'machines.level3'|trans},
        ]},
    ],
    route: 'app_machines',
    title: 'nav.machines'|trans,
    tiles: tiles,
    tiles_label: 'machines.all_categories'|trans,
    tile_all_label: 'machines.all_short'|trans,
    free_word: 'machines.free_short'|trans,
    filter_key: 'cat',
    filter_value: category,
    search: search,
    search_placeholder: 'machines.search_placeholder2'|trans,
    total: totalCount,
    all: allCount,
    unit: 'machine',
    unit_plural: 'machines',
    headline_count: freeCount,
    headline_label: 'machines.available_now'|trans,
    empty_text: 'machines.none_found'|trans,
} %}
    {% block cards %}
        {% for entry in cards %}
            {% set m = entry.machine %}

            {#
               State: a fact about the MACHINE. Order matters — "labo fermé"
               is checked before "occupée", because a shut venue is not a busy
               machine. Without that, every card reads "occupée" on a Saturday
               and the page blames eleven machines for the calendar.
            #}
            {% if entry.down %}
                {% set state = 'machines.state_down'|trans %}{% set tone = 'stop' %}
            {# ⚠️ S134e — the REASON when there is one; see places.html.twig. #}
            {% elseif not venueOpenNow %}
                {% set state = venueClosureReason|default(null) ? 'machines.state_closed'|trans ~ ' — ' ~ venueClosureReason : 'machines.state_closed'|trans %}{% set tone = 'muted' %}
            {% elseif entry.freeNow %}
                {% set state = 'machines.state_free'|trans %}{% set tone = 'go' %}
            {% elseif entry.slot %}
                {% set state = 'machines.state_busy'|trans %}{% set tone = 'wait' %}
            {% else %}
                {% set state = 'machines.state_full'|trans %}{% set tone = 'wait' %}
            {% endif %}

            {#
               The "when" line. ⚠️ Gated on qualification: a bookable time shown
               to an untrained member is a promise `book()` refuses (S47). An
               unqualified member gets the weaker, true "prochain créneau" —
               the machine is free then; you are not being offered it.
            #}
            {% set note = '' %}{% set note_strong = '' %}
            {% if entry.slot %}
                {% set note = entry.authorized and entry.usageRight.allowed ? 'machines.bookable_from'|trans : 'machines.next_slot'|trans %}
                {% set note_strong = entry.slot.start|lab_date('d/m H:i') %}
            {% elseif not entry.down %}
                {% set note = 'machines.no_slot'|trans %}
            {% endif %}

            {#
               ⚠️ Permission: a fact about YOU, and `authorized` alone cannot
               express it. It is false for an anonymous visitor even on a machine
               that requires nothing, which shipped once and told every logged-out
               visitor that all eleven machines needed a formation. Ask whether the
               MACHINE has a requirement separately from whether THIS person meets
               it.
            #}
            {% set open_access = entry.authorized or not entry.requiresTraining %}
            {% set right_required = entry.usageRight.enforced and not entry.usageRight.allowed %}

            {% include 'site/_catalogue_card.html.twig' with {
                url: path('app_machine_detail', {id: m.id}),
                title: m.nom,
                type: entry.catLabel,
                meta: m.localisation,
                note: note,
                note_strong: note_strong,
                state: state,
                state_tone: tone,
                foot: right_required ? ('usage_rights.verdict.' ~ entry.usageRight.reason ~ '.label')|trans : (open_access ? 'machines.req_none'|trans : 'machines.req_yes'|trans),
                foot_icon: not right_required and not open_access ? 'lock' : '',
                foot_tone: right_required ? entry.usageRight.tone : (open_access ? 'muted' : 'caution'),
                action: 'machines.see'|trans,
                icon_slug: entry.catSlug,
                photo: m.photo,
            } only %}
        {% endfor %}
    {% endblock %}
{% endembed %}
{% endblock %}
