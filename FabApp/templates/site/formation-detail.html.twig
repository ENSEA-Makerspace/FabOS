{% extends 'site/base_public.html.twig' %}

{% from 'site/_admin_inline.html.twig' import admin_actions %}

{% block title %}{{ formation.titre }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260903-s159' }}">
    <link rel="stylesheet" href="{{ asset('css/formations-modern.css') ~ '?v=20260903-s159' }}">
    <link rel="stylesheet" href="{{ asset('css/section-journey.css') ~ '?v=20260903-s159' }}">
    <link rel="stylesheet" href="{{ asset('css/formation-admin-inline.css') ~ '?v=20260903-s159' }}">
{% endblock %}

{% block body %}

    <main id="main-content" tabindex="-1" class="main-content">
        <section class="formation-detail-section">
            <div class="container">
                {% include 'site/_breadcrumb.html.twig' with {trail: [
                    {label: 'nav.home'|trans, url: path('app_home')},
                    {label: 'nav.trainings'|trans, url: path('app_formations')},
                    {label: formation.titre},
                ]} only %}

                {% if is_granted('ROLE_ADMIN') %}
                    <div class="formation-admin-toolbar" role="region" aria-label="{{ 'fdet.admin_content_aria'|trans }}">
                        <div>
                            <strong>{{ 'fdet.admin_mode'|trans }}</strong>
                            <span>{{ 'fdet.admin_mode_desc'|trans }}</span>
                        </div>
                        <div class="formation-admin-toolbar__actions">
                            <a class="btn btn-secondary" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#general">{{ 'fdet.manage_texts'|trans }}</a>
                            <a class="btn btn-secondary" href="{{ path('app_admin_formation_section_new', {id: formation.id}) }}">{{ 'fdet.new_section'|trans }}</a>
                            <a class="btn btn-primary" href="{{ path('app_admin_formation_quiz_new', {id: formation.id}) }}">{{ 'fdet.new_quiz'|trans }}</a>
                        </div>
                    </div>
                {% endif %}

                {% set badge = formation.badge %}
                {% set content = pageContent|default({}) %}
                {% set labels = content.labels|default({}) %}
                {% set policy = formationPolicy|default({'physicalRequired': false, 'practicalLabel': 'fdet.practical_not_required_pill'|trans, 'practicalDescription': 'fdet.default_practical_desc'|trans, 'practicalTone': 'optional'}) %}
                {# `default_category` is "Fabrication numérique" — a made-up CATEGORY, not
                   a UI label. A formation with no category now says so by saying nothing. #}
                {% set categoryLabel = formation.categorie|default('') %}
                {% set levelLabel = formation.niveau ? 'fdet.level'|trans({'%n%': formation.niveau}) : 'fdet.level_unknown'|trans %}
                {% set duration = formation.duree ?: 'fdet.duration_unknown'|trans %}
                {% set trainer = formation.formateur ?: 'fdet.team'|trans %}
                {% set totalPlaces = formation.placesTotales ?: 0 %}
                {% set availablePlaces = totalPlaces - stats.total > 0 ? totalPlaces - stats.total : 0 %}
                {# 🔴 **S134c2 — the three invented lists are gone.** Objectives,
                   prerequisites and provided material each fell back to a
                   hard-coded set when the formation had none, so every course
                   nobody had written up claimed the same three objectives, the
                   same two prerequisites and the same three items of equipment.

                   ⚠️ They were TRANSLATED, which made it worse rather than
                   better: the invention was fluent in five languages. That is
                   precisely why S134c left them literal instead of translating
                   them — the fault was never the language.

                   Empty now means empty, and the card below is not drawn. #}
                {% set objectives = content.lists.objectives|default([])|filter(v => v|trim) %}
                {% set prerequisites = content.lists.prerequisites|default([])|filter(v => v|trim) %}
                {% set material = content.lists.material|default([])|filter(v => v|trim) %}
                {% set programBlock = content.program|default({}) %}
                {% set program = programBlock.items|default([]) %}
                {% set sessionsBlock = content.sessions|default({}) %}
                {% set sessions = sessionsBlock.items|default([]) %}
                {% set practicalBlock = content.practical|default({}) %}
                {% set relatedBlock = content.related|default({}) %}


                <div class="formation-detail-header admin-editable-block">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a class="admin-inline-edit" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#general">{{ 'common.edit'|trans }}</a>
                    {% endif %}
                    <div class="formation-detail-hero">
                        <div class="formation-detail-visual">
                            <div class="formation-image-placeholder large">
                                {% include 'site/_formation_visual.html.twig' with {visual: formationVisual, size: 'large'} only %}
                            </div>
                        </div>

                        <div class="formation-detail-summary">
                            <div class="formation-detail-badge">{{ levelLabel }}</div>
                            <h1 class="formation-detail-title">{{ formation.titre }}{{ admin_actions([
                                { route: 'app_admin_formation_edit', params: { id: formation.id }, label: 'admin_inline.edit'|trans },
                                { route: 'app_admin_formation_content', params: { id: formation.id, _fragment: 'general' }, label: 'admin_inline.content'|trans }
                            ]) }}</h1>
                            {# Was "{category} · {trainer}" unconditionally, so an empty category
                               left a leading " · ". Join what exists. #}
                            <p class="formation-detail-category">{{ [categoryLabel, trainer]|filter(v => v)|join(' · ') }}</p>
                            <div class="formation-detail-practical-pill is-{{ policy.practicalTone }}">
                                {% if policy.physicalRequired %}
                                    <span aria-hidden="true">●</span> {{ 'fdet.practical_required_pill'|trans }}
                                {% else %}
                                    <span aria-hidden="true">✓</span> {{ 'fdet.practical_not_required_pill'|trans }}
                                {% endif %}
                            </div>
                            <div class="formation-detail-meta">
                                <div class="meta-item">{{ 'fdet.duration'|trans({'%duration%': duration}) }}</div>
                                <div class="meta-item">{{ 'fdet.places'|trans({'%places%': totalPlaces > 0 ? availablePlaces ~ '/' ~ totalPlaces : 'fdet.places_unknown'|trans}) }}</div>
                                <div class="meta-item">{{ 'fdet.enrolled'|trans({'%count%': stats.total}) }}</div>
                                <div class="meta-item">{{ 'fdet.completed'|trans({'%count%': stats.completed}) }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="formation-detail-actions">
                        <div class="formation-detail-actions-main">
                            <a class="btn btn-primary" href="{{ path('app_formation_follow', {id: formation.id}) }}">{{ 'fdet.see_progress'|trans }}</a>
                            <a class="btn btn-secondary" href="{{ path('app_formation_follow', {id: formation.id}) ~ '#quiz-evaluations' }}">{{ 'fdet.see_quizzes'|trans }}</a>
                        </div>
                    </div>
                </div>

                {% include 'site/_formation_journey.html.twig' with {
                    formation: formation,
                    sectionJourney: sectionJourney,
                    journeyWeights: journeyWeights,
                    formationPolicy: formationPolicy,
                    pageContent: pageContent
                } only %}

                <div class="formation-detail-content">
                    <div class="formation-detail-main">
                        <div class="formation-detail-section-card admin-editable-block" id="formation-description">
                            {% if is_granted('ROLE_ADMIN') %}<a class="admin-inline-edit" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#general">{{ 'common.edit'|trans }}</a>{% endif %}
                            <h2 class="section-card-title">{{ labels.descriptionTitle|default('fdet.section_description'|trans) }}</h2>
                            <div class="section-card-content">
                                {# 🔴 S134c2, found while removing the others: a formation with
                                   no description was given one — "Cette formation accompagne les
                                   utilisateurs dans la prise en main d'une ressource du %venue%,
                                   depuis les règles de sécurité jusqu'à une première réalisation
                                   encadrée." A paragraph about a course nobody had described,
                                   presented as its description, in five languages. #}
                                {% if formation.description %}<p>{{ formation.description }}</p>{% endif %}
                            </div>
                        </div>

                        {% if objectives is not empty %}
                        <div class="formation-detail-section-card admin-editable-block" id="formation-objectives">
                                {% if is_granted('ROLE_ADMIN') %}<a class="admin-inline-edit" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#general">{{ 'common.edit'|trans }}</a>{% endif %}
                                <h2 class="section-card-title">{{ labels.objectivesTitle|default('fdet.section_objectives'|trans) }}</h2>
                                <div class="section-card-content">
                                    <ul class="learning-objectives">
                                        {% for objective in objectives %}
                                            {% set objective = objective|trim %}
                                            {% if objective %}<li>{{ objective }}</li>{% endif %}
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endif %}

                        {% if program is not empty %}
                        <div class="formation-detail-section-card admin-editable-block" id="formation-program">
                                {% if is_granted('ROLE_ADMIN') %}<a class="admin-inline-edit" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#program">{{ 'common.edit'|trans }}</a>{% endif %}
                                <h2 class="section-card-title">{{ programBlock.title|default('fdet.section_program'|trans) }}</h2>
                                <div class="section-card-content">
                                    <div class="program-list">
                                        {% for item in program %}
                                            <div class="program-item">
                                                <div class="program-time">{{ item.time }}</div>
                                                <div>
                                                    <div class="program-title">{{ item.title }}</div>
                                                    <div class="program-description">{{ item.description }}</div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        {% if prerequisites is not empty %}
                        <div class="formation-detail-section-card admin-editable-block" id="formation-prerequisites">
                                {% if is_granted('ROLE_ADMIN') %}<a class="admin-inline-edit" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#general">{{ 'common.edit'|trans }}</a>{% endif %}
                                <h2 class="section-card-title">{{ labels.prerequisitesTitle|default('fdet.section_prereq'|trans) }}</h2>
                                <div class="section-card-content">
                                    <ul class="prerequisites-list">
                                        {% for prerequisite in prerequisites %}
                                            {% set prerequisite = prerequisite|trim %}
                                            {% if prerequisite %}<li>{{ prerequisite }}</li>{% endif %}
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endif %}

                        {% if material is not empty %}
                        <div class="formation-detail-section-card admin-editable-block" id="formation-material">
                                {% if is_granted('ROLE_ADMIN') %}<a class="admin-inline-edit" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#general">{{ 'common.edit'|trans }}</a>{% endif %}
                                <h2 class="section-card-title">{{ labels.materialTitle|default('fdet.section_material'|trans) }}</h2>
                                <div class="section-card-content">
                                    <ul class="material-list">
                                        {% for item in material %}
                                            {% set item = item|trim %}
                                            {% if item %}<li>{{ item }}</li>{% endif %}
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endif %}

                        {% if is_granted('ROLE_ADMIN') %}
                        <div class="formation-detail-section-card">
                            <h2 class="section-card-title">{{ 'fdet.real_progress'|trans }}</h2>
                            <div class="section-card-content">
                                <div class="program-list">
                                    {% for progression in progressions|slice(0, 5) %}
                                        {% set user = progression.utilisateur %}
                                        <div class="program-item">
                                            <div class="program-time">{{ progression.dateDebut|date('d/m/Y') }}</div>
                                            <div>
                                                <div class="program-title">{{ user ? user.displayName : 'fdet.unknown_user'|trans }}</div>
                                                <div class="program-description">{{ 'fdet.progression_score'|trans({'%state%': (progression.completed ? 'fdet.progression_done' : 'fdet.progression_started')|trans, '%score%': progression.score}) }}</div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <p>{{ 'fdet.no_progress'|trans }}</p>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                        {% endif %}
                    </div>

                    <aside class="formation-detail-sidebar">
                        {#
                           🔴 **REAL sessions, and they win over the typed ones**
                           (S146d). S134c2 had to delete a "three next sessions"
                           block from this page because FabOS was inventing them:
                           `Formation` has no date and there was no session entity.
                           An event can now say which training it is a session of,
                           so these are facts.

                           ⚠️ **One card, not two.** The hand-typed block below is
                           kept for an install with no events module — or none
                           scheduled yet — but it renders only when there is nothing
                           real to show. Two cards both titled "Sessions", one true
                           and one typed, is worse than either.

                           ⚠️ A cancelled session STAYS, with its reason. Somebody
                           planned around it; dropping it silently looks like it
                           never existed.
                        #}
                        {% if upcomingSessions|default([]) is not empty %}
                        <div class="formation-sidebar-card" id="formation-sessions">
                            <h3 class="sidebar-card-title">{{ 'fdet.section_sessions'|trans }}</h3>
                            <div class="sessions-list">
                                {% for session in upcomingSessions %}
                                    <a class="session-item" href="{{ path('app_event_detail', {id: session.id}) }}">
                                        <div class="session-date">{{ session.dateDebut|loc_date('EEEE d MMMM') }}</div>
                                        <div class="session-time">{{ session.dateDebut|date('H:i') }}{{ session.dateFin ? ' – ' ~ session.dateFin|date('H:i') : '' }}{{ session.lieu ? ' · ' ~ session.lieu : '' }}</div>
                                        {% if session.cancelled %}
                                            <span class="session-status cancelled">{{ session.cancellationReason ?: 'events.state_cancelled'|trans }}</span>
                                        {% endif %}
                                    </a>
                                {% endfor %}
                            </div>
                            {# ⚠️ Says plainly that showing up is not the same as being
                               certified. Certification is a safety question and a
                               trainer validates it — the link plans and enrols, it
                               never grants a badge. #}
                            <p class="settings-hint">{{ 'fdet.sessions_not_certifying'|trans }}</p>
                        </div>
                        {% elseif sessions is not empty %}
                        <div class="formation-sidebar-card admin-editable-block" id="formation-sessions">
                            {% if is_granted('ROLE_ADMIN') %}<a class="admin-inline-edit" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#sessions">{{ 'common.edit'|trans }}</a>{% endif %}
                            <h3 class="sidebar-card-title">{{ sessionsBlock.title|default('fdet.section_sessions'|trans) }}</h3>
                            <div class="sessions-list">
                                {% for session in sessions %}
                                    <div class="session-item">
                                        <div class="session-date">{{ session.date }}</div>
                                        <div class="session-time">{{ session.time }}</div>
                                        <span class="session-status {{ session.status }}">{{ session.label }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}

                        <div class="formation-sidebar-card admin-editable-block" id="formation-practical">
                            {% if is_granted('ROLE_ADMIN') %}<a class="admin-inline-edit" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#practical">{{ 'common.edit'|trans }}</a>{% endif %}
                            <h3 class="sidebar-card-title">{{ practicalBlock.title|default('fdet.practical_card_title'|trans) }}</h3>
                            <div class="formation-practical-sidebar is-{{ policy.practicalTone }}">
                                <div class="formation-practical-sidebar__icon" aria-hidden="true">
                                    {% if policy.physicalRequired %}
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16"/><path d="M7 20v-9l5-4 5 4v9"/><path d="M10 20v-5h4v5"/></svg>
                                    {% else %}
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>
                                    {% endif %}
                                </div>
                                <strong>{{ policy.physicalRequired ? practicalBlock.requiredLabel|default(policy.practicalLabel) : practicalBlock.optionalLabel|default(policy.practicalLabel) }}</strong>
                                <p>{{ policy.physicalRequired ? practicalBlock.requiredDescription|default(policy.practicalDescription) : practicalBlock.optionalDescription|default(policy.practicalDescription) }}</p>
                                <span class="formation-practical-sidebar__status">
                                    {{ policy.physicalRequired ? practicalBlock.requiredStatus|default('fdet.practical_status_required'|trans) : practicalBlock.optionalStatus|default('fdet.practical_status_optional'|trans) }}
                                </span>
                            </div>
                        </div>

                        <div class="formation-sidebar-card">
                            {# S134c — this card was headed "Synthèse MariaDB" with rows
                                captioned "Depuis PROGRESSION", "completed = 1" and
                                "completed = 0", on a page members read. The numbers are the
                                same; they now say what they count. #}
                            <h3 class="sidebar-card-title">{{ 'fdet.participation'|trans }}</h3>
                            <div class="sessions-list">
                                <div class="session-item"><div class="session-date">{{ 'fdet.stat_enrolled'|trans({'count': stats.total}) }}</div><div class="session-time">{{ 'fdet.stat_enrolled_caption'|trans }}</div></div>
                                <div class="session-item"><div class="session-date">{{ 'fdet.stat_completed'|trans({'count': stats.completed}) }}</div><div class="session-time">{{ 'fdet.stat_completed_caption'|trans }}</div></div>
                                <div class="session-item"><div class="session-date">{{ 'fdet.stat_in_progress'|trans({'%count%': stats.incomplete}) }}</div><div class="session-time">{{ 'fdet.stat_in_progress_caption'|trans }}</div></div>
                            </div>
                        </div>
                    </aside>
                </div>

                <section class="formation-detail-related admin-editable-block" id="formation-related">
                    {% if is_granted('ROLE_ADMIN') %}<a class="admin-inline-edit" href="{{ path('app_admin_formation_content', {id: formation.id}) }}#related">{{ 'common.edit'|trans }}</a>{% endif %}
                    <h2 class="section-card-title">{{ relatedBlock.title|default('fdet.section_related'|trans) }}</h2>
                    <div class="related-formations-grid">
                        {% set relatedItems = relatedBlock.items|default([]) %}
                        {% set relatedOne = relatedItems[0]|default({}) %}
                        {% set relatedTwo = relatedItems[1]|default({}) %}
                        <article class="related-formation-card">
                            <span class="related-formation-badge">{{ relatedOne.badge|default(categoryLabel) }}</span>
                            <h3 class="related-formation-title">{{ relatedOne.title|default('fdet.related_title'|trans) }}</h3>
                            <p class="related-formation-description">{{ relatedOne.description|default('fdet.related_description'|trans) }}</p>
                            <a href="{{ path('app_formations') }}" class="btn btn-sm">{{ relatedOne.button|default('fdet.related_action'|trans) }}</a>
                        </article>
                        <article class="related-formation-card">
                            <span class="related-formation-badge">{{ relatedTwo.badge|default('fdet.tracking_badge'|trans) }}</span>
                            <h3 class="related-formation-title">{{ relatedTwo.title|default('fdet.tracking_title'|trans) }}</h3>
                            <p class="related-formation-description">{{ relatedTwo.description|default('fdet.tracking_description'|trans) }}</p>
                            <a href="{{ path('app_formation_follow', {id: formation.id}) }}" class="btn btn-sm">{{ relatedTwo.button|default('fdet.tracking_action'|trans) }}</a>
                        </article>
                    </div>
                </section>            </div>
        </section>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
    {# Every sentence section-journey.js writes, translated server-side. See the note
       at the top of that file: it has no catalogue of its own. #}
    <script id="journey-i18n" type="application/json">{{ {
        js_answer_all: 'journey.js_answer_all'|trans,
        js_checking: 'journey.js_checking'|trans,
        js_server_checks: 'journey.js_server_checks'|trans,
        js_failed: 'journey.js_failed'|trans,
        js_section_validated: 'journey.js_section_validated'|trans,
        js_score_retry: 'journey.js_score_retry'|trans,
    }|json_encode|raw }}</script>
    <script src="{{ asset('js/section-journey.js') ~ '?v=20260811-s134c-i18n' }}" defer></script>
{% endblock %}
