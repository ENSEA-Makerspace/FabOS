<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ formation.titre }} - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    <img src="{{ asset('images/ENSEA.png') }}" alt="ENSEA" class="ensea-logo-img ensea-logo-svg">
                </div>
            </a>
            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">Accueil</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">Calendrier</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">Machines</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link active">Formations</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">Leaderboard</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">Admin</a>
                    {% endif %}
                </div>
            </nav>
            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>
                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <main class="main-content">
        <section class="formation-detail-section">
            <div class="container">
                <nav class="breadcrumb">
                    <a href="{{ path('app_home') }}">Accueil</a>
                    <span class="breadcrumb-separator">/</span>
                    <a href="{{ path('app_formations') }}">Formations</a>
                    <span class="breadcrumb-separator">/</span>
                    <span class="breadcrumb-current">{{ formation.titre }}</span>
                </nav>

                {% set badge = formation.badge %}
                {% set categoryLabel = formation.categorie ?: 'Fabrication numérique' %}
                {% set levelLabel = formation.niveau ? 'Niveau ' ~ formation.niveau : 'Niveau non renseigné' %}
                {% set duration = formation.duree ?: 'Durée non renseignée' %}
                {% set trainer = formation.formateur ?: 'Équipe FabLab' %}
                {% set totalPlaces = formation.placesTotales ?: 0 %}
                {% set availablePlaces = totalPlaces - stats.total > 0 ? totalPlaces - stats.total : 0 %}
                {% set objectives = formation.objectifs ? formation.objectifs|split('.') : ['Comprendre les règles de sécurité et de réservation', 'Préparer un fichier exploitable pour la machine', 'Réaliser une première production contrôlée'] %}
                {% set prerequisites = formation.prerequis ? formation.prerequis|split('.') : ['Compte FabOS actif', 'Respect du règlement FabLab'] %}
                {% set material = formation.materielFourni ? formation.materielFourni|split(',') : ['Machine et consommables de démonstration', 'Fiche mémo sécurité', 'Accompagnement formateur'] %}
                {% set program = [
                    {'time': '00:00', 'title': 'Accueil et sécurité', 'description': 'Présentation des risques, EPI, consignes atelier et bonnes pratiques.'},
                    {'time': '00:30', 'title': 'Préparation du projet', 'description': 'Choix du fichier, réglages principaux et validation avec un encadrant.'},
                    {'time': '01:15', 'title': 'Démonstration machine', 'description': 'Lancement, surveillance, arrêt et résolution des incidents fréquents.'},
                    {'time': '02:00', 'title': 'Mise en pratique', 'description': 'Production accompagnée et validation des acquis pour l’usage autonome.'}
                ] %}
                {% set sessions = [
                    {'date': 'Mardi prochain', 'time': '14:00 - 16:30', 'status': 'available', 'label': 'Places disponibles'},
                    {'date': 'Jeudi prochain', 'time': '10:00 - 12:30', 'status': 'available', 'label': 'Places disponibles'},
                    {'date': 'Vendredi prochain', 'time': '15:00 - 17:30', 'status': 'full', 'label': 'Complet'}
                ] %}

                <div class="formation-detail-header">
                    <div class="formation-detail-visual">
                        <div class="formation-image-placeholder large">
                            {% include 'site/_formation_visual.html.twig' with {visual: formationVisual, size: 'large'} only %}
                        </div>
                    </div>
                    <div class="formation-detail-badge">{{ levelLabel }}</div>
                    <h1 class="formation-detail-title">{{ formation.titre }}</h1>
                    <p class="formation-detail-category">{{ categoryLabel }} · {{ trainer }}</p>
                    <div class="formation-detail-meta">
                        <div class="meta-item">Durée : {{ duration }}</div>
                        <div class="meta-item">Places disponibles : {{ totalPlaces > 0 ? availablePlaces ~ '/' ~ totalPlaces : 'Non renseigné' }}</div>
                        <div class="meta-item">Inscrits : {{ stats.total }}</div>
                        <div class="meta-item">Complétés : {{ stats.completed }}</div>
                    </div>
                    <div class="formation-detail-actions">
                        <button class="btn btn-primary" disabled title="Inscription bientôt disponible">S’inscrire à cette formation - bientôt disponible</button>
                        <button class="btn btn-secondary" disabled title="Ajout calendrier bientôt disponible">Ajouter au calendrier - bientôt disponible</button>
                        <a class="btn btn-secondary" href="{{ path('app_formation_follow', {id: formation.id}) }}">Voir le suivi</a>
                    </div>
                </div>

                <div class="formation-detail-content">
                    <div class="formation-detail-main">
                        <div class="formation-detail-section-card">
                            <h2 class="section-card-title">Description détaillée</h2>
                            <div class="section-card-content">
                                <p>{{ formation.description ?? 'Cette formation accompagne les utilisateurs dans la prise en main d’une ressource du FabLab, depuis les règles de sécurité jusqu’à une première réalisation encadrée.' }}</p>
                            </div>
                        </div>

                        <div class="formation-detail-section-card">
                            <h2 class="section-card-title">Objectifs pédagogiques</h2>
                            <div class="section-card-content">
                                <ul class="learning-objectives">
                                    {% for objective in objectives %}
                                        {% set objective = objective|trim %}
                                        {% if objective %}<li>{{ objective }}</li>{% endif %}
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>

                        <div class="formation-detail-section-card">
                            <h2 class="section-card-title">Programme horaire</h2>
                            <div class="section-card-content">
                                <div class="program-list">
                                    {% for item in program %}
                                        <div class="program-item">
                                            <div class="program-time">{{ item.time }}</div>
                                            <div>
                                                <div class="program-title">{{ item.title }}</div>
                                                <div class="program-description">{{ item.description }}</div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>

                        <div class="formation-detail-section-card">
                            <h2 class="section-card-title">Prérequis</h2>
                            <div class="section-card-content">
                                <ul class="prerequisites-list">
                                    {% for prerequisite in prerequisites %}
                                        {% set prerequisite = prerequisite|trim %}
                                        {% if prerequisite %}<li>{{ prerequisite }}</li>{% endif %}
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>

                        <div class="formation-detail-section-card">
                            <h2 class="section-card-title">Matériel fourni</h2>
                            <div class="section-card-content">
                                <ul class="material-list">
                                    {% for item in material %}
                                        {% set item = item|trim %}
                                        {% if item %}<li>{{ item }}</li>{% endif %}
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>

                        <div class="formation-detail-section-card">
                            <h2 class="section-card-title">Progressions réelles</h2>
                            <div class="section-card-content">
                                <div class="program-list">
                                    {% for progression in progressions|slice(0, 5) %}
                                        {% set user = progression.utilisateur %}
                                        <div class="program-item">
                                            <div class="program-time">{{ progression.dateDebut|date('d/m/Y') }}</div>
                                            <div>
                                                <div class="program-title">{{ user ? user.displayName : 'Utilisateur inconnu' }}</div>
                                                <div class="program-description">{{ progression.completed ? 'Formation terminée' : 'Formation commencée' }} · score {{ progression.score }}</div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <p>Aucune progression enregistrée pour le moment.</p>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <aside class="formation-detail-sidebar">
                        <div class="formation-sidebar-card">
                            <h3 class="sidebar-card-title">Prochaines sessions</h3>
                            <div class="sessions-list">
                                {% for session in sessions %}
                                    <div class="session-item">
                                        <div class="session-date">{{ session.date }}</div>
                                        <div class="session-time">{{ session.time }}</div>
                                        <span class="session-status {{ session.status }}">{{ session.label }}</span>
                                        <button class="btn btn-sm" disabled>Inscription bientôt disponible</button>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="formation-sidebar-card">
                            <h3 class="sidebar-card-title">Badge obtenu</h3>
                            <div class="badge-preview">
                                <div class="badge-icon medium">
                                    <svg viewBox="0 0 80 80" class="badge-svg" aria-hidden="true">
                                        <circle cx="40" cy="40" r="30" fill="#fff" stroke="#9E1B56" stroke-width="5"/>
                                        <text x="40" y="46" text-anchor="middle" fill="#9E1B56" font-size="14" font-weight="bold">{{ badge ? (badge.icone ?: 'BADGE') : '—' }}</text>
                                    </svg>
                                </div>
                                <h4 class="badge-name">{{ badge ? badge.nom : 'Aucun badge associé' }}</h4>
                                <p class="badge-description">{{ badge ? (badge.description ?: 'Badge délivré après validation de la formation.') : 'Cette formation ne délivre pas encore de badge.' }}</p>
                                <div class="badge-level">{{ stats.completed }} obtention{{ stats.completed > 1 ? 's' : '' }} validée{{ stats.completed > 1 ? 's' : '' }}</div>
                            </div>
                        </div>

                        <div class="formation-sidebar-card">
                            <h3 class="sidebar-card-title">Synthèse MariaDB</h3>
                            <div class="sessions-list">
                                <div class="session-item"><div class="session-date">{{ stats.total }} inscrit{{ stats.total > 1 ? 's' : '' }}</div><div class="session-time">Depuis PROGRESSION</div></div>
                                <div class="session-item"><div class="session-date">{{ stats.completed }} terminé{{ stats.completed > 1 ? 's' : '' }}</div><div class="session-time">completed = 1</div></div>
                                <div class="session-item"><div class="session-date">{{ stats.incomplete }} en cours</div><div class="session-time">completed = 0</div></div>
                            </div>
                        </div>

                        <div class="formation-sidebar-card">
                            <h3 class="sidebar-card-title">Partager</h3>
                            <div class="share-buttons">
                                <button class="share-btn" disabled title="Partage bientôt disponible">↗</button>
                                <button class="share-btn" disabled title="Copie bientôt disponible">⛓</button>
                                <button class="share-btn" disabled title="Envoi bientôt disponible">@</button>
                            </div>
                        </div>
                    </aside>
                </div>

                <section class="formation-detail-related">
                    <h2 class="section-card-title">Formations similaires</h2>
                    <div class="related-formations-grid">
                        <article class="related-formation-card">
                            <span class="related-formation-badge">{{ categoryLabel }}</span>
                            <h3 class="related-formation-title">Parcours machines FabLab</h3>
                            <p class="related-formation-description">Retrouvez les autres formations disponibles dans le catalogue connecté à MariaDB.</p>
                            <a href="{{ path('app_formations') }}" class="btn btn-sm">Voir les formations</a>
                        </article>
                        <article class="related-formation-card">
                            <span class="related-formation-badge">Suivi</span>
                            <h3 class="related-formation-title">Continuer cette formation</h3>
                            <p class="related-formation-description">Consultez les sections, quiz et progressions déjà branchés pour cette formation.</p>
                            <a href="{{ path('app_formation_follow', {id: formation.id}) }}" class="btn btn-sm">Ouvrir le suivi</a>
                        </article>
                    </div>
                </section>            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') }}"></script>
</body>
</html>
