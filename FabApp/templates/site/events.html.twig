{% extends 'site/base_public.html.twig' %}

{% block title %}{{ 'nav.events'|trans }} - FabOS{% endblock %}

{% block page_styles %}
    <style>
        .events-page { padding: 0 0 48px; }
        .events-list { display: grid; gap: 16px; margin-top: 24px; }
        .event-card {
            display: grid; grid-template-columns: 92px 1fr; gap: 18px; align-items: start;
            text-decoration: none; color: inherit;
            padding: 18px 20px; border-radius: 14px;
            background: rgba(158, 27, 86, 0.05); border: 1px solid rgba(158, 27, 86, 0.12);
            transition: transform .15s ease, box-shadow .15s ease;
        }
        .event-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(158, 27, 86, 0.15); }
        .event-date-badge {
            text-align: center; background: #9E1B56; color: #fff; border-radius: 12px; padding: 10px 6px;
        }
        .event-date-badge .day { font-size: 26px; font-weight: 800; line-height: 1; }
        .event-date-badge .month { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; }
        .event-card h2 { font-size: 19px; margin: 0 0 6px; }
        .event-card-meta { font-size: 13px; color: #9E1B56; font-weight: 700; margin: 0 0 8px; }
        .event-card p.desc { font-size: 14px; color: var(--color-text-light); margin: 0; }
        /* Poster thumbnail, when the event has artwork. */
        .event-thumb { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 10px; display: block; }
        .event-card.has-poster { grid-template-columns: 132px 1fr; }
        .event-cancelled-tag { display: inline-block; margin-left: 8px; padding: 1px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; background: rgba(239,68,68,.16); color: #b91c1c; vertical-align: middle; }
        html[data-theme="dark"] .event-cancelled-tag { color: #fca5a5; }
        @media (max-width: 560px) { .event-card.has-poster { grid-template-columns: 96px 1fr; } }
        .events-empty { text-align: center; color: #6b7280; padding: 40px 0; }
        @media (max-width: 560px) { .event-card { grid-template-columns: 68px 1fr; gap: 12px; } }
    </style>
{% endblock %}

{% block body %}
    <section class="page-hero">
        <h1>{{ 'nav.events'|trans }}</h1>
        <p>{{ 'events.subtitle'|trans }}</p>
    </section>
    <main class="container events-page">
        {% if events is empty %}
            <p class="events-empty">{{ 'events.none_upcoming'|trans }}</p>
        {% else %}
            <div class="events-list">
                {% for event in events %}
                    <a class="event-card {{ event.hasPoster ? 'has-poster' : '' }}" href="{{ path('app_event_detail', {id: event.id}) }}">
                        {% if event.hasPoster %}
                            <img class="event-thumb" src="{{ asset('uploads/events/' ~ event.posterFilename) }}" alt="" loading="lazy">
                        {% else %}
                            <div class="event-date-badge">
                                <div class="day">{{ event.dateDebut|date('d') }}</div>
                                <div class="month">{{ event.dateDebut|date('M') }}</div>
                            </div>
                        {% endif %}
                        <div>
                            <h2>{{ event.titre }}{% if event.cancelled %}<span class="event-cancelled-tag">{{ 'event.called_off.banner'|trans }}</span>{% endif %}</h2>
                            <p class="event-card-meta">
                                {{ event.dateDebut|date('d/m/Y H:i') }}{% if event.dateFin %} — {{ event.dateFin|date('H:i') }}{% endif %}{% if event.lieu %} · {{ event.lieu }}{% endif %}
                            </p>
                            {% if event.description %}<p class="desc">{{ event.description|striptags|slice(0, 160) }}{{ event.description|length > 160 ? '…' : '' }}</p>{% endif %}
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </main>
    
{% endblock %}
