{% set currentLocale = app.request.locale %}
<div class="header-lang" role="group" aria-label="Langue">
    {% for loc in ['fr', 'en', 'es', 'de', 'it'] %}
        <a href="{{ path('app_switch_locale', {locale: loc}) }}" class="header-lang__link {{ currentLocale == loc ? 'is-active' : '' }}" {{ currentLocale == loc ? 'aria-current="true"' : '' }} hreflang="{{ loc }}">{{ loc|upper }}</a>
    {% endfor %}
</div>
{% set currentUser = app.user %}
{% if currentUser %}
    {% set currentTheme = currentUser.theme is defined and currentUser.theme in ['light', 'dark', 'system'] ? currentUser.theme : 'light' %}
    <span class="fabos-theme-preference" data-fabos-theme-preference="{{ currentTheme }}" hidden></span>
    <script>
        (() => {
            const preference = {{ currentTheme|json_encode|raw }};
            const resolved = preference === 'system'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : preference;
            document.documentElement.dataset.themePreference = preference;
            document.documentElement.dataset.theme = resolved;
            try { localStorage.setItem('fabos-theme-preference', preference); } catch (error) {}
        })();
    </script>
    {% set displayName = currentUser.displayName is defined ? currentUser.displayName : (currentUser.username is defined ? currentUser.username : currentUser.userIdentifier) %}
    <a href="{{ path('app_profile') }}" class="user-avatar connected" title="{{ displayName }}">
        {% include 'site/_user_avatar.html.twig' with {user: currentUser, size: 40, class: 'header-user-avatar', alt: displayName} only %}
    </a>
    <a href="{{ path('app_logout') }}" class="header-logout-link">{{ 'nav.logout'|trans }}</a>
{% else %}
    <a href="{{ path('app_login') }}" class="user-avatar" title="{{ 'nav.login'|trans }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
        </svg>
    </a>
    <a href="{{ path('app_login') }}" class="header-login-link">{{ 'nav.login'|trans }}</a>
{% endif %}
