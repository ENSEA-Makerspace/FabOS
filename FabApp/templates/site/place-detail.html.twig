{% extends 'site/base_public.html.twig' %}

{% from 'site/_admin_inline.html.twig' import admin_actions %}

{% block title %}{{ place.nom }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=' ~ css_version }}">
    {# S146b — this page draws the calendar now. #}
    <link rel="stylesheet" href="{{ asset('css/calendar-modern.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block page_styles %}
    <style>
        .place-detail-section { padding: 24px 0 48px; }
        .place-flash { margin: 0 0 16px; padding: 12px 14px; border-radius: 6px; font-weight: 700; }
        .place-flash.success { background: color-mix(in srgb, var(--color-ok) 15%, var(--theme-surface)); color: var(--color-ok); }
        .place-flash.error { background: color-mix(in srgb, var(--color-stop, #b91c1c) 15%, var(--theme-surface)); color: var(--color-stop, #b91c1c); }
    </style>
{% endblock %}

{% block body %}
    <main id="main-content" tabindex="-1" class="main-content">
        <section class="place-detail-section">
            <div class="container">
                {% include 'site/_breadcrumb.html.twig' with {trail: [
                    {label: 'nav.home'|trans, url: path('app_home')},
                    {label: 'nav.places'|trans, url: path('app_places')},
                    {label: place.nom},
                ]} only %}

                {# 🔴 **2026-09-30 — la fiche repensée d'après la planche
                   `02-detail-espace-reservation.png`**, avec la tête partagée des
                   fiches (`_detail_hero`) : puis-je réserver ? comment j'entre ? en
                   tête ; le calendrier dessous. Aucune logique changée — le verdict
                   d'usage, les badges S204 et les portes S177 sont ceux d'avant. #}
                {% set signinNeeded = not app.user or usageRight.reason|default('') == 'signin_required' %}
                {% set canBook = app.user and usageRight.allowed and placeQualifies is not same as(false) %}
                {% set bookTone = canBook ? 'go' : (signinNeeded ? 'wait' : 'stop') %}
                {% embed 'site/_detail_hero.html.twig' with {
                    kicker: place.venue ? place.venue.name : '',
                    title: place.nom,
                    title_actions: admin_actions([
                        { route: 'app_admin_place_edit', params: { id: place.id }, label: 'admin_inline.edit'|trans }
                    ]),
                } %}
                    {% block main %}
                        {% if place.description %}<p class="md-lede">{{ place.description }}</p>{% endif %}
                        <div class="md-cards">
                            <section class="detail-card md-book" aria-labelledby="md-book-title">
                                <div class="md-book-head">
                                    <span class="md-verdict md-verdict--{{ bookTone }}" aria-hidden="true">{{ canBook ? '✓' : (bookTone == 'wait' ? '→' : '!') }}</span>
                                    <h2 id="md-book-title" class="md-book-title">
                                        {%- if canBook -%}{{ 'places.verdict_can'|trans }}
                                        {%- elseif signinNeeded -%}{{ 'machine.verdict_signin'|trans }}
                                        {%- elseif not usageRight.allowed -%}{{ ('usage_rights.verdict.' ~ usageRight.reason ~ '.label')|trans }}
                                        {%- else -%}{{ 'machine.verdict_training'|trans }}{%- endif -%}
                                    </h2>
                                </div>
                                <div class="machine-detail-actions">
                                    {% if canBook %}
                                        <a class="btn btn-primary" href="#place-calendar">{{ 'places.book_this_place'|trans }}</a>
                                    {% elseif signinNeeded %}
                                        <a class="btn btn-primary" href="{{ path('app_login') }}">{{ 'machine.login_to_reserve'|trans }}</a>
                                    {% elseif not usageRight.allowed %}
                                        <a class="btn btn-primary" href="{{ path('app_profile') ~ '#usage-rights' }}">{{ 'usage_rights.my_rights'|trans }}</a>
                                    {% else %}
                                        <a class="btn btn-primary" href="{{ path('app_formations') }}">{{ 'machine.see_trainings'|trans }}</a>
                                    {% endif %}
                                </div>
                                {% if place.localisation or place.capacite %}
                                    <p class="md-book-foot">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                        {{ place.localisation }}{% if place.localisation and place.capacite %}<span aria-hidden="true">·</span>{% endif %}
                                        {% if place.capacite %}{{ place.capacite }} {{ 'places.capacity_suffix'|trans }}{% endif %}
                                    </p>
                                {% endif %}
                            </section>

                            {# 🔴 **S177 — « comment j'entre ? »**, et S204 — avec quel badge.
                               ⚠️ **La carte reste quand aucune porte n'est déclarée** : une
                               installation qui n'en a déclaré aucune doit le voir, pas une
                               page qui a l'air complète et ne répond pas. #}
                            <section class="detail-card md-access" aria-labelledby="md-access-title">
                                <h2 id="md-access-title" class="detail-card-title">{{ 'places.how_to_enter'|trans }}</h2>
                                <ul class="md-access-list">
                                    {% for badge in requiredBadges|default([]) %}
                                        {% set owned = placeQualifies is same as(true) %}
                                        <li class="{{ owned or not app.user ? 'is-ok' : 'is-missing' }}">
                                            <span class="md-access-mark" aria-hidden="true">{{ not app.user ? '•' : (owned ? '✓' : '✗') }}</span>
                                            <span>{{ badge }}</span>
                                        </li>
                                    {% endfor %}
                                    {% for point in accessPoints|default([]) %}
                                        <li class="is-ok">
                                            <span class="md-access-mark" aria-hidden="true">{% include 'site/_icon.html.twig' with { name: 'key' } only %}</span>
                                            <span><b>{{ point.nom }}</b> · {{ point.kindKey|trans }}{% if point.localisation %} · {{ point.localisation }}{% endif %}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                                <p class="md-note">{{ (accessPoints|default([])|length ? 'places.entry_badge_note' : 'places.entry_none')|trans }}</p>
                            </section>
                        </div>
                    {% endblock %}
                    {# Un espace n'a pas de photo saisissable : l'image par défaut est le plan. #}
                    {% block fallback %}{% include 'site/_icon.html.twig' with { name: 'map' } only %}{% endblock %}
                {% endembed %}

                {% for message in app.flashes('success') %}<div class="place-flash success">{{ message|flash_text }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="place-flash error">{{ message|flash_text }}</div>{% endfor %}
                {% if bookingError is defined and bookingError %}<div class="place-flash error">{{ bookingError }}</div>{% endif %}

                {#
                   🔴 **The calendar replaces a form typed from nothing** (S146b).
                   This page asked for a date and two times on a screen that already
                   knew the opening hours and every booking, and listed those bookings
                   beside it as bare timestamps. Both are gone: you see what is free
                   and you click it. Same component as the machine's page and
                   `/calendrier` — one calendar, in code and on screen (S146a).

                   ⚠️ The route that served that form was removed in S146c, one step
                   after its replacement shipped — deleting a write path in the same
                   step that introduces its successor is how a route gets dropped while
                   something still posts to it. `ReservationService::book()` is still
                   the only thing that creates a booking, then as now.
                #}
                <div class="place-calendar" id="place-calendar" data-controller="calendar"
                     data-calendar-payload-value="{{ calendar|json_encode }}">
                    {% if usageRight.enforced and not usageRight.allowed %}
                        {% include 'site/_usage_right_state.html.twig' with {
                            capability: usageRight.capability,
                            verdict: usageRight,
                            action: usageRight.reason == 'signin_required'
                                ? {label: 'nav.login'|trans, url: path('app_login')}
                                : {label: 'usage_rights.my_rights'|trans, url: path('app_profile') ~ '#usage-rights'}
                        } only %}
                    {% endif %}

                    {% include 'site/_calendar.html.twig' with {
                        heading: 'places.book_this_place'|trans,
                        subtitle: 'mcal.click_slot'|trans,
                    } only %}

                    {# Ce que l'espace dit avant de confirmer : capacité, délai d'annulation (si la
                       politique en fixe un), et la fenêtre où le badge ouvre la porte (si l'espace
                       a des portes). Le tout calculé côté serveur ; la durée, elle, vient du JS. #}
                    {% set bookingFacts = [] %}
                    {% if place.capacite %}
                        {% set bookingFacts = bookingFacts|merge([{icon: 'map', text: 'mbk.capacity'|trans({'%n%': place.capacite})}]) %}
                    {% endif %}
                    {% if cancellationNoticeMinutes is not null %}
                        {% set noticeHours = cancellationNoticeMinutes // 60 %}
                        {% set noticeRest = cancellationNoticeMinutes % 60 %}
                        {% set noticeText = (noticeHours > 0 ? noticeHours ~ ' ' ~ 'cal.unit_hour'|trans : '') ~ (noticeRest > 0 ? (noticeHours > 0 ? ' ' : '') ~ noticeRest ~ ' ' ~ 'cal.unit_minute'|trans : '') %}
                        {% set bookingFacts = bookingFacts|merge([{icon: 'history', text: (cancellationNoticeMinutes > 0 ? 'mbk.cancel_notice' : 'mbk.cancel_until_start')|trans({'%delay%': noticeText})}]) %}
                    {% endif %}
                    {% if accessPoints|length %}
                        {% set bookingFacts = bookingFacts|merge([{icon: 'key', text: 'mbk.door_window'|trans({'%margin%': doorMarginMinutes, '%doors%': accessPoints|map(d => d.nom)|join(', ')})}]) %}
                    {% endif %}

                    {% include 'site/_calendar_booking.html.twig' with {
                        facts: bookingFacts,
                        title: 'places.book_this_place'|trans,
                        hint: 'machine_calendar.pick_free_slot'|trans,
                        resources: calendarResources,
                        resources_by_kind: {},
                        booking_access: {},
                        signed_in: app.user is not null,
                    } only %}

                    {% if app.user %}
                        {% set ical_url = url('app_place_ical', {id: place.id}) ~ '?token=' ~ ical_feed_token() %}
                        <p class="place-ical-subscribe"><a href="{{ ical_url|replace({'https://': 'webcal://', 'http://': 'webcal://'}) }}" title="{{ 'ical.subscribe_hint'|trans }}">{% include 'site/_icon.html.twig' with { name: 'calendar' } only %} {{ 'ical.subscribe'|trans }}</a></p>
                    {% endif %}
                </div>
            </div>
        </section>
    </main>
{% endblock %}
