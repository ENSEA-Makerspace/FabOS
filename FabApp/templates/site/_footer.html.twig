<footer class="site-footer">
    <div class="footer-container">
        <div class="footer-section">
            <div class="footer-logo">
                <span class="logo-text">FabOS</span>
                <p>{{ 'footer.tagline'|trans }}</p>
            </div>
        </div>
        <div class="footer-section">
            <h4>{{ 'footer.nav_heading'|trans }}</h4>
            <a href="{{ path('app_home') }}">{{ 'nav.home'|trans }}</a>
            {% if module_enabled('machines') %}<a href="{{ path('app_machines') }}">{{ 'nav.machines'|trans }}</a>{% endif %}
            {% if has_calendar_layer() %}<a href="{{ path('app_calendar') }}">{{ 'nav.calendar'|trans }}</a>{% endif %}
            {% if module_enabled('formations') %}<a href="{{ path('app_formations') }}">{{ 'nav.trainings'|trans }}</a>{% endif %}
            {% if module_enabled('leaderboard') %}<a href="{{ path('app_leaderboard') }}">{{ 'nav.leaderboard'|trans }}</a>{% endif %}
            {% if module_enabled('projects') %}<a href="{{ path('app_creations') }}">{{ 'nav.projects'|trans }}</a>{% endif %}
            {% if module_enabled('badges') %}<a href="{{ path('app_badges') }}">{{ 'nav.badges'|trans }}</a>{% endif %}
            {% if module_enabled('lab_pages') %}<a href="{{ path('app_lab_pages') }}">{{ lab_pages_nav_label() }}</a>{% endif %}
            {% if module_enabled('places') %}<a href="{{ path('app_places') }}">{{ 'nav.places'|trans }}</a>{% endif %}
            {% if module_enabled('materials') %}<a href="{{ path('app_materials') }}">{{ 'nav.materials'|trans }}</a>{% endif %}
            {% if module_enabled('loans') %}<a href="{{ path('app_loans') }}">{{ 'nav.loans'|trans }}</a>{% endif %}
            {% if module_enabled('maintenance') %}<a href="{{ path('app_maintenance') }}">{{ 'nav.maintenance'|trans }}</a>{% endif %}
            {% if module_enabled('staff') %}<a href="{{ path('app_staff') }}">{{ 'nav.staff'|trans }}</a>{% endif %}
            {% if module_enabled('trainers') %}<a href="{{ path('app_trainers') }}">{{ 'nav.trainers'|trans }}</a>{% endif %}
            {% if module_enabled('events') %}<a href="{{ path('app_events') }}">{{ 'nav.events'|trans }}</a>{% endif %}
            {% if is_granted('ROLE_USER') %}<a href="{{ path('app_my_reservations') }}">{{ 'resv.title'|trans }}</a>{% endif %}
        </div>
        <div class="footer-section">
            <h4>{{ 'footer.resources_heading'|trans }}</h4>
            <a href="{{ path('app_documentation') }}">{{ 'footer.documentation'|trans }}</a>
            <a href="{{ path('app_support') }}">{{ 'footer.support'|trans }}</a>
            <a href="{{ path('app_api_docs') }}">{{ 'footer.api'|trans }}</a>
            <a href="{{ path('app_status') }}">{{ 'footer.status'|trans }}</a>
            <a href="{{ path('app_roadmap') }}">🗺️ Roadmap</a>
        </div>
        <div class="footer-section">
            <h4>{{ 'footer.safety_heading'|trans }}</h4>
            <a href="{{ path('app_lab_rules') }}">{{ 'footer.lab_rules'|trans }}</a>
        </div>
        <div class="footer-section">
            <h4>{{ 'footer.legal_heading'|trans }}</h4>
            <a href="{{ path('app_legal_notice') }}">{{ 'footer.legal_notice'|trans }}</a>
            <a href="{{ path('app_privacy_policy') }}">{{ 'footer.privacy_policy'|trans }}</a>
            <a href="{{ path('app_terms') }}">{{ 'footer.terms'|trans }}</a>
        </div>
    </div>
    <div class="footer-bottom">
        <p>&copy; {{ "now"|date("Y") }} FabOS - {{ 'footer.copyright'|trans }}</p>
        <p class="footer-version">{{ 'footer.version'|trans }}</p>
    </div>
</footer>
