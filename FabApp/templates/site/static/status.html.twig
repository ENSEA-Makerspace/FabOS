{% extends 'base.html.twig' %}

{% block title %}Statut - FabOS{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main class="static-page">
        <section class="static-hero">
            <p class="static-kicker">Statut</p>
            <h1>État des services FABOS</h1>
            <p>Cette page est statique pour l'instant. Elle ne réalise pas encore de monitoring dynamique ni de test de connexion à la base.</p>
        </section>

        <section class="static-grid">
            <article class="static-card">
                <h2>Site web</h2>
                <span class="status-pill status-ok">Opérationnel</span>
            </article>
            <article class="static-card">
                <h2>API</h2>
                <span class="status-pill status-ok">Disponible</span>
            </article>
            <article class="static-card">
                <h2>Base de données</h2>
                <span class="status-pill status-info">Suivi à venir</span>
            </article>
            <article class="static-card">
                <h2>RFID</h2>
                <span class="status-pill status-warning">Expérimental / à venir</span>
            </article>
        </section>
    </main>
{% endblock %}
