{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}Lecteurs RFID - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260804-s78-tables' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    <style>
        .admin-page-header-content { max-width: var(--max-width); margin: 0 auto; display: flex; justify-content: space-between; gap: 20px; align-items: center; flex-wrap: wrap; }
        .admin-page-header h1 { margin: 0 0 8px; font-size: 30px; }
        .header-actions, .row-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        .admin-sidebar { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: var(--shadow); }
        .admin-sidebar { padding: 18px; align-self: start; }
        .admin-sidebar h3 { margin: 0 0 12px; font-size: 17px; }
        .admin-nav { display: flex; flex-direction: column; gap: 4px; }
        .admin-nav-link { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 6px; color: #374151; text-decoration: none; font-weight: 600; }
        .admin-nav-link.active { background: rgba(158, 27, 86, .1); color: #9E1B56; }
        .admin-nav-link svg { width: 18px; height: 18px; }
        .admin-panel { }
        .admin-panel-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 18px; padding-bottom: 16px; border-bottom: 1px solid #e5e7eb; }
        .admin-panel-header h2 { margin: 0 0 4px; font-size: 22px; }
        .admin-panel-header p { margin: 0; color: #6b7280; }
        .admin-panel > .reader-help { padding-left: 16px; padding-right: 16px; }
        .reader-help { margin: 0 0 18px; padding: 14px 16px; border: 1px solid #bfdbfe; border-radius: 8px; background: #eff6ff; color: #1e3a8a; }
        .flash { margin: 0 0 14px; padding: 12px 14px; border-radius: 8px; font-weight: 700; }
        .flash.success { background: #dcfce7; color: #166534; }
        .flash.error { background: #fee2e2; color: #991b1b; }
        .reader-table-wrap { overflow-x: auto; }
        .token { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 13px; }
        .status-pill { display: inline-flex; padding: 3px 8px; border-radius: 999px; font-size: 12px; font-weight: 700; }
        .status-pill.active { background: #dcfce7; color: #166534; }
        .status-pill.inactive { background: #ede9fe; color: #5b21b6; }
        .btn-link, .btn-primary, .btn-danger, .btn-secondary { display: inline-flex; align-items: center; justify-content: center; padding: 9px 13px; border-radius: 6px; text-decoration: none; font-weight: 700; cursor: pointer; font-size: 14px; }
        .btn-link, .btn-secondary { color: #374151; border: 1px solid #d1d5db; background: #fff; }
        .btn-primary { color: #fff; background: #9E1B56; border: 1px solid #9E1B56; }
        .btn-danger { color: #fff; background: #b91c1c; border: 1px solid #b91c1c; }
        .empty-state { padding: 22px; border: 1px dashed #d1d5db; border-radius: 8px; color: #6b7280; background: #f9fafb; }
        .modal-backdrop { position: fixed; inset: 0; display: none; align-items: center; justify-content: center; padding: 22px; background: rgba(17, 24, 39, .55); z-index: 50; }
        .modal-backdrop.open { display: flex; }
        .modal { width: min(920px, 100%); max-height: 88vh; overflow: auto; background: #fff; border-radius: 8px; box-shadow: 0 24px 80px rgba(0,0,0,.25); }
        .modal-header { display: flex; justify-content: space-between; gap: 12px; align-items: center; padding: 18px 22px; border-bottom: 1px solid #e5e7eb; }
        .modal-header h2 { margin: 0; font-size: 22px; }
        .modal-body { padding: 20px 22px; color: #374151; }
        .modal-body ol { padding-left: 22px; }
        .modal-body li { margin-bottom: 12px; }
        .modal-body pre { margin: 8px 0 0; padding: 12px; background: #111827; color: #e5e7eb; border-radius: 8px; overflow-x: auto; font-size: 13px; }
        @media (max-width: 900px) { .admin-layout { grid-template-columns: 1fr; padding: 0 16px; } .admin-page-header { padding: 24px 16px; } .admin-panel-header { align-items: flex-start; flex-direction: column; } }
    </style>
    {# AssetMapper (Stimulus seul, Turbo desactive). Cette page est autonome : elle ne
       passe par aucun shell, donc elle porte sa propre ligne. #}
    {{ importmap('app') }}
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main>
        <header class="admin-page-header">
            <div class="admin-page-header-content">
                <div>
                    <h1>Lecteurs RFID</h1>
                    <p>Gestion des Raspberry Pi / lecteurs RFID associés aux machines FABOS.</p>
                </div>
                <div class="header-actions">
                    <button class="btn-secondary" type="button" data-open-pairing-modal>Comment appairer une Pi ?</button>
                    <a class="btn-primary" href="{{ path('app_admin_rfid_reader_new') }}">+ Nouveau lecteur RFID</a>
                </div>
            </div>
        </header>

        <div class="admin-layout">
            {% include 'site/_admin_sidebar.html.twig' %}

            <section class="admin-panel">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}<div class="flash {{ label }}">{{ message }}</div>{% endfor %}
                {% endfor %}

                <div class="admin-panel-header">
                    <div>
                        <h2>Lecteurs déclarés</h2>
                        <p>{{ readers|length }} lecteur{{ readers|length > 1 ? 's' : '' }} configuré{{ readers|length > 1 ? 's' : '' }}</p>
                    </div>
                    <div class="header-actions">
                        <button class="btn-secondary" type="button" data-open-pairing-modal>Comment appairer une Pi ?</button>
                        <a class="btn-primary" href="{{ path('app_admin_rfid_reader_new') }}">+ Nouveau lecteur RFID</a>
                    </div>
                </div>

                <p class="reader-help">Le readerToken identifie la Raspberry Pi / lecteur RFID. Il ne correspond pas au badge d’un utilisateur. Pour garder l’historique tout en empêchant l’utilisation, désactivez plutôt le lecteur. La suppression sert surtout aux erreurs de création.</p>

                {% if readers is empty %}
                    <div class="empty-state">Aucun lecteur RFID déclaré pour le moment.</div>
                {% else %}
                    <div class="reader-table-wrap">
                        {% embed 'site/_data_table.html.twig' with {
                            columns: [
                                {label: 'Nom'},
                                {label: 'readerToken'},
                                {label: 'Machine'},
                                {label: 'machineToken'},
                                {label: 'Statut'},
                                {label: 'Dernière vue'},
                                {label: 'Actions'},
                            ],
                            rows: readers,
                            empty: 'Aucun lecteur RFID déclaré pour le moment.',
                        } %}
                            {% block rows %}
                                {% for reader in readers %}
                                    <tr>
                                        <td>{{ reader.name }}</td>
                                        <td class="token">{{ reader.readerToken }}</td>
                                        <td>{{ reader.machine ? reader.machine.nom : 'Machine inconnue' }}</td>
                                        <td class="token">{{ reader.machine ? reader.machine.machineToken : '-' }}</td>
                                        <td><span class="status-pill {{ reader.active ? 'active' : 'inactive' }}">{{ reader.active ? 'Actif' : 'Inactif' }}</span></td>
                                        <td>{{ reader.lastSeenAt ? reader.lastSeenAt|lab_date('d/m/Y H:i') : 'Jamais' }}</td>
                                        <td>
                                            <div class="row-actions">
                                                <a class="btn-link" href="{{ path('app_admin_rfid_reader_edit', {id: reader.id}) }}">Modifier</a>
                                                <form method="post" action="{{ path('app_admin_rfid_reader_delete', {id: reader.id}) }}" data-delete-confirm-form>
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_rfid_reader_' ~ reader.id) }}">
                                                    <button class="btn-danger" type="submit">Supprimer</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endblock %}
                        {% endembed %}
                    </div>
                {% endif %}
            </section>
        </div>
    </main>

    <div class="modal-backdrop" id="pairing-modal" role="dialog" aria-modal="true" aria-labelledby="pairing-modal-title">
        <div class="modal">
            <div class="modal-header">
                <h2 id="pairing-modal-title">Appairer une Raspberry Pi RFID</h2>
                <button class="btn-link" type="button" data-close-pairing-modal>Fermer</button>
            </div>
            <div class="modal-body">
                <ol>
                    <li>Créer un lecteur RFID dans l’admin : donner un nom clair, associer une machine, laisser actif si le lecteur doit fonctionner.</li>
                    <li>Copier les fichiers Pi sur la nouvelle Raspberry Pi : <pre>/home/subhen/fabos-rfid
/home/subhen/fabos-neopixel-test
/home/subhen/fabos-php-worker
/home/subhen/start_fabos.sh
/home/subhen/stop_fabos.sh
/home/subhen/fabos-device.env.example
/home/subhen/README.md</pre></li>
                    <li>Créer le fichier de configuration : <pre>nano /home/subhen/fabos-device.env</pre></li>
                    <li>Coller la configuration générée par l’admin dans ce fichier.</li>
                    <li>Rendre les scripts/binaires exécutables : <pre>chmod +x /home/subhen/start_fabos.sh
chmod +x /home/subhen/stop_fabos.sh
chmod +x /home/subhen/fabos-rfid/fabos-rfid
chmod +x /home/subhen/fabos-neopixel-test/fabos-neopixel-mqtt</pre></li>
                    <li>Recompiler les programmes C sur la Pi cible : <pre>cd /home/subhen/fabos-rfid
make clean
make
chmod +x fabos-rfid

cd /home/subhen/fabos-neopixel-test
make clean
make
chmod +x fabos-neopixel-mqtt</pre>Un binaire compilé sur une autre machine peut ne pas fonctionner. Recompiler sur la Pi cible évite les erreurs d’architecture.</li>
                    <li>Démarrer FABOS sur la Pi : <pre>cd /home/subhen
./stop_fabos.sh
./start_fabos.sh</pre></li>
                    <li>Vérifier que les trois programmes tournent : <pre>ps aux | grep -E "fabos-rfid|mqtt_worker|fabos-neopixel" | grep -v grep</pre></li>
                    <li>Regarder les logs : <pre>tail -f /home/subhen/fabos-rfid.log
tail -f /home/subhen/fabos-php-worker.log
tail -f /home/subhen/fabos-neopixel.log</pre></li>
                </ol>
                <p><strong>À retenir :</strong> readerToken identifie la Raspberry Pi / lecteur RFID. machineToken identifie la machine FABOS. Le badge RFID utilisateur n’est pas le readerToken. Les valeurs de l’admin et de /home/subhen/fabos-device.env doivent correspondre.</p>
            </div>
        </div>
    </div>

    {% include 'site/_delete_confirm_modal.html.twig' %}

    <script>
        (function () {
            const modal = document.getElementById('pairing-modal');
            document.querySelectorAll('[data-open-pairing-modal]').forEach((button) => button.addEventListener('click', () => modal.classList.add('open')));
            document.querySelectorAll('[data-close-pairing-modal]').forEach((button) => button.addEventListener('click', () => modal.classList.remove('open')));
            modal.addEventListener('click', (event) => { if (event.target === modal) modal.classList.remove('open'); });
        })();
    </script>
{% endblock %}
