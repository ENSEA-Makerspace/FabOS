{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'rfid_readers.title'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260816-s134' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260816-s139e' }}">
    {# 🔴 **A 30-line local `<style>` deleted here (S135).** It re-declared
       `.admin-page-header`, `.admin-panel-header` and `.btn-primary`/`.btn-danger`
       — the last two with the literal `#9E1B56` and `#b91c1c` the token layer
       exists to replace — plus a private `.status-pill`, a private `.empty-state`
       and a private `.reader-table-wrap` duplicating `.admin-table-wrap`. All of
       it existed because the page hand-rolled its own chrome instead of using
       `_admin_list`, which it does now.

       ⚠️ **S142 took the modal rules too.** The reasoning above was that a dialog
       is not list furniture — true, and beside the point: the dialog comes from
       `_rfid_pairing_modal.html.twig`, which this page and the reader form both
       include, and both carried the same nine rules privately. They are in
       `admin.css` now, once, next to the partial's other caller-independent
       needs. `.reader-help` went the same way for the same reason.

       ✅ **S132: this page has NO local CSS at all.** The last rule was `.token`,
       a monospace treatment for the reader token — and grepping every template
       found **zero** elements carrying that class. The token is drawn by
       `_cell_title` as a subtitle and has been since S135; the rule had been
       styling nothing since then. The roadmap called this page "a reference to
       extract, not to copy": what was worth extracting is in `admin.css` and
       shown in `/admin/design`, and what was left was dead. #}
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'rfid_readers.create'|trans,
    action_route: 'app_admin_rfid_reader_new',
    panel_title: 'rfid_readers.panel_title'|trans,
    panel_note: 'rfid_readers.panel_note'|trans({'%count%': readers|length}),
    list_count: readers|length,
    list_route: 'app_admin_rfid_readers',
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_client_filter: true,
    list_tiles_label: 'admin_list.facet_status'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: readers|length, category: 'all', active: true},
        {label: 'rfid_readers.active'|trans, count: readers|filter(reader => reader.active)|length, category: 'active'},
        {label: 'rfid_readers.inactive'|trans, count: readers|filter(reader => not reader.active)|length, category: 'inactive'},
    ],
} %}
    {% block header_extra %}
        <button class="admin-hero-action" type="button" data-open-pairing-modal>{{ 'rfid_form.pairing_open'|trans }}</button>
    {% endblock %}
    {% block content %}
        <p class="reader-help">{{ 'rfid_form.token_note'|trans }} {{ 'rfid_form.delete_help'|trans }}</p>
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'rfid_readers.col_name'|trans, class: 'is-grow'},
                {label: 'rfid_readers.col_machine'|trans, class: 'is-tight'},
                {label: 'rfid_readers.col_status'|trans, class: 'is-tight'},
                {label: 'rfid_readers.col_last_seen'|trans, class: 'is-tight'},
                {label: 'rfid_readers.col_actions'|trans, class: 'is-actions'},
            ],
            rows: readers,
            empty: 'rfid_readers.empty'|trans,
        } %}
            {% block rows %}
                {% for reader in readers %}
                    <tr data-admin-list-filter-row data-admin-list-filter-category="{{ reader.active ? 'active' : 'inactive' }}" data-admin-list-filter-row-href="{{ path('app_admin_rfid_reader_edit', {id: reader.id}) }}">
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: reader.name,
                            href: path('app_admin_rfid_reader_edit', {id: reader.id}),
                            subtitle: reader.readerToken,
                            media: include('site/_cell_media.html.twig', {initials: reader.name, shape: 'square'}, with_context = false),
                        } only %}</td>
                        <td>{% if reader.machine %}{% include 'site/_cell_title.html.twig' with {
                                title: reader.machine.nom,
                                href: path('app_admin_machine_edit', {id: reader.machine.id}),
                                subtitle: reader.machine.machineToken,
                            } only %}{% else %}{% include 'site/_cell_empty.html.twig' with {reason: 'rfid_readers.machine_unknown'} only %}{% endif %}</td>
                        <td>{% include 'site/_cell_state.html.twig' with {
                            label: (reader.active ? 'rfid_readers.active' : 'rfid_readers.inactive')|trans,
                            signal: reader.active ? 'go' : 'muted',
                        } only %}</td>
                        <td>{% include 'site/_cell_date.html.twig' with {
                            value: reader.lastSeenAt, convention: 'machine', reason: 'rfid_readers.never',
                        } only %}</td>
                        <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                            actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_rfid_reader_edit', {id: reader.id})}],
                        } only %}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}

{% include 'site/_rfid_pairing_modal.html.twig' %}
{% include 'site/_delete_confirm_modal.html.twig' %}
{% endblock %}
