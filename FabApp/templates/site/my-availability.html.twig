{% extends 'site/base_public.html.twig' %}

{% block title %}{{ 'booking.my_availability'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260816-s139e' }}">
{% endblock %}

{% block page_styles %}
    <style>
        .availability-section { padding: 24px 0 48px; }
        .availability-grid { display: grid; grid-template-columns: 3fr 2fr; gap: 24px; margin-top: 16px; }
        .availability-form label { display: block; font-weight: 700; margin-bottom: 6px; color: var(--color-text); }
        .availability-form input, .availability-form textarea {
            padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 15px; width: 100%;
        }
        .availability-form textarea { min-height: 70px; resize: vertical; }
        .availability-field { margin-bottom: 16px; }
        .availability-hint { font-size: 13px; color: var(--color-text-light); margin: 4px 0 0; font-weight: 400; }
        .availability-days { list-style: none; margin: 8px 0 20px; padding: 0; }
        .availability-days li {
            display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 12px;
            padding: 10px 0; border-bottom: 1px solid var(--border-color);
        }
        .availability-days li:last-child { border-bottom: none; }
        .availability-days .day-name { font-weight: 700; color: var(--color-text); }
        .availability-days input { width: 130px; }
        .request-list { list-style: none; margin: 0; padding: 0; }
        .request-list li { padding: 14px 0; border-bottom: 1px solid var(--border-color); }
        .request-list li:last-child { border-bottom: none; }
        .request-when { font-weight: 700; color: var(--color-text); }
        .request-who { font-size: 14px; color: var(--color-text-light); margin: 2px 0 6px; }
        .request-motif { font-size: 14px; color: #4b5563; margin: 0 0 10px; white-space: pre-wrap; }
        .request-actions { display: flex; gap: 8px; }
        .request-actions button { padding: 7px 14px; border-radius: 6px; border: 0; font-weight: 700; cursor: pointer; font-size: 14px; }
        .request-accept { background: #166534; color: #fff; }
        .request-decline { background: color-mix(in srgb, var(--color-stop, #b91c1c) 15%, var(--theme-surface)); color: var(--color-stop, #b91c1c); }
        .availability-flash { margin: 0 0 16px; padding: 12px 14px; border-radius: 6px; font-weight: 700; }
        .availability-flash.success { background: color-mix(in srgb, var(--color-ok) 15%, var(--theme-surface)); color: var(--color-ok); }
        .availability-flash.error { background: color-mix(in srgb, var(--color-stop, #b91c1c) 15%, var(--theme-surface)); color: var(--color-stop, #b91c1c); }
        .availability-notice { background: color-mix(in srgb, var(--color-warn) 15%, var(--theme-surface)); color: var(--color-warn); padding: 12px 14px; border-radius: 6px; margin-bottom: 16px; }
        .availability-empty { color: var(--color-text-light); }
        @media (max-width: 900px) { .availability-grid { grid-template-columns: 1fr; } }
    </style>
{% endblock %}

{% block body %}
    <main class="main-content">
        <section class="availability-section">
            <div class="container">
                {% include 'site/_breadcrumb.html.twig' with {trail: [
                    {label: 'nav.home'|trans, url: path('app_home')},
                    {label: 'booking.my_availability'|trans},
                ]} only %}

                <h1>{{ 'booking.my_availability'|trans }}</h1>
                <p class="availability-empty">{{ 'booking.my_availability_intro'|trans }}</p>

                {% for message in app.flashes('success') %}<div class="availability-flash success">{{ message }}</div>{% endfor %}
                {% for message in app.flashes('error') %}<div class="availability-flash error">{{ message }}</div>{% endfor %}

                {% if not person.bookable %}
                    <div class="availability-notice">{{ 'booking.not_bookable_notice'|trans }}</div>
                {% endif %}

                <div class="availability-grid">
                    <div class="detail-card">
                        <h2 class="detail-card-title">{{ 'booking.weekly_availability'|trans }}</h2>
                        <div class="detail-card-content">
                            <form method="post" action="{{ path('app_person_my_availability_save') }}" class="availability-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('my_availability') }}">

                                <ul class="availability-days">
                                    {% for dayOfWeek in 1..7 %}
                                        {% set window = (windowsByDay[dayOfWeek] ?? [])|first %}
                                        <li>
                                            <span class="day-name">{{ ('booking.weekday.' ~ dayOfWeek)|trans }}</span>
                                            <input type="time" name="window[{{ dayOfWeek }}][start]"
                                                   aria-label="{{ ('booking.weekday.' ~ dayOfWeek)|trans }} — {{ 'booking.start_label'|trans }}"
                                                   value="{{ window ? window.startTime|date('H:i') : '' }}">
                                            <input type="time" name="window[{{ dayOfWeek }}][end]"
                                                   aria-label="{{ ('booking.weekday.' ~ dayOfWeek)|trans }} — {{ 'booking.end_label'|trans }}"
                                                   value="{{ window ? window.endTime|date('H:i') : '' }}">
                                        </li>
                                    {% endfor %}
                                </ul>
                                <p class="availability-hint">{{ 'booking.weekly_hint'|trans }}</p>

                                <div class="availability-field">
                                    <label for="durations">{{ 'booking.durations_label'|trans }}</label>
                                    <input type="text" id="durations" name="durations" value="{{ durations|join(', ') }}">
                                    <p class="availability-hint">{{ 'booking.durations_hint'|trans }}</p>
                                </div>

                                <div class="availability-field">
                                    <label for="note">{{ 'booking.note_label'|trans }}</label>
                                    <textarea id="note" name="note" maxlength="500">{{ person.bookingNote }}</textarea>
                                    <p class="availability-hint">{{ 'booking.note_hint'|trans }}</p>
                                </div>

                                <button type="submit" class="btn btn-primary">{{ 'booking.save'|trans }}</button>
                            </form>
                        </div>
                    </div>

                    <div>
                        <div class="detail-card">
                            <h2 class="detail-card-title">
                                {{ 'booking.pending_requests'|trans }}{% if pendingRequests is not empty %} ({{ pendingRequests|length }}){% endif %}
                            </h2>
                            <div class="detail-card-content">
                                {% if pendingRequests is empty %}
                                    <p class="availability-empty">{{ 'booking.no_pending_requests'|trans }}</p>
                                {% else %}
                                    <ul class="request-list">
                                        {% for reservation in pendingRequests %}
                                            <li>
                                                <div class="request-when">
                                                    {{ reservation.dateDebut|date('d/m/Y H:i') }} — {{ reservation.dateFin|date('H:i') }}
                                                </div>
                                                <div class="request-who">{{ reservation.utilisateur ? reservation.utilisateur.displayName : '' }}</div>
                                                {% if reservation.motif %}<p class="request-motif">{{ reservation.motif }}</p>{% endif %}
                                                <form method="post" action="{{ path('app_person_request_answer', {id: reservation.id}) }}" class="request-actions">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('answer_request_' ~ reservation.id) }}">
                                                    <button type="submit" name="answer" value="accept" class="request-accept">{{ 'booking.accept'|trans }}</button>
                                                    <button type="submit" name="answer" value="decline" class="request-decline">{{ 'booking.decline'|trans }}</button>
                                                </form>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        </div>

                        <div class="detail-card">
                            <h2 class="detail-card-title">{{ 'booking.upcoming'|trans }}</h2>
                            <div class="detail-card-content">
                                {% if upcoming is empty %}
                                    <p class="availability-empty">{{ 'booking.no_upcoming'|trans }}</p>
                                {% else %}
                                    <ul class="request-list">
                                        {% for reservation in upcoming %}
                                            <li>
                                                <div class="request-when">
                                                    {{ reservation.dateDebut|date('d/m/Y H:i') }} — {{ reservation.dateFin|date('H:i') }}
                                                </div>
                                                <div class="request-who">
                                                    {{ reservation.utilisateur ? reservation.utilisateur.displayName : '' }}
                                                    {% if reservation.isPending %} · {{ 'booking.status_pending'|trans }}{% endif %}
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
