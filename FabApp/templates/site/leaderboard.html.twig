{% extends 'site/base_public.html.twig' %}

{% set body_class = 'leaderboard-sky-page' %}

{% block title %}{{ 'nav.leaderboard'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=20260709-header-scope' }}">
{% endblock %}

{% block body %}
    <main class="leaderboard-game">
        <span class="lb-cloud lb-cloud-1"></span><span class="lb-cloud lb-cloud-2"></span><span class="lb-cloud lb-cloud-3"></span>
        <span class="lb-character lb-character-headfirst"></span><span class="lb-character lb-character-sleeping"></span><span class="lb-character lb-character-relax"></span>

        <section class="leaderboard-hero">
            <div class="container leaderboard-hero-inner">
                <div>
                    <h1>{{ 'leaderboard.title'|trans }}</h1>
                    <p>{{ 'leaderboard.subtitle'|trans }}</p>
                </div>
                {# The gallery is a separate feature that merely used to share this page's
                   URL prefix. A deployment that ranks people but has no gallery must not
                   be advertising one. #}
                {% if feature_enabled('projects') %}<a class="creation-cta-mini" href="{{ path('app_creations') }}">{{ 'leaderboard.discover_creations'|trans }}</a>{% endif %}
            </div>
        </section>

        <section class="leaderboard-controls-section lb-panel-section">
            <div class="container">
                <div class="leaderboard-controls lb-controls-panel">
                    <div class="leaderboard-type-selector" aria-label="{{ 'leaderboard.type_label'|trans }}">
                        <a class="leaderboard-type-btn {{ activeTab == 'presence' ? 'active' : '' }}" href="{{ path('app_leaderboard', {tab: 'presence', period: activePeriod}) }}">{{ 'leaderboard.presence_time'|trans }}</a>
                        <a class="leaderboard-type-btn {{ activeTab == 'prints' ? 'active' : '' }}" href="{{ path('app_leaderboard', {tab: 'prints', period: activePeriod}) }}">{{ 'leaderboard.print_count'|trans }}</a>
                    </div>
                    <div class="leaderboard-period-tabs" aria-label="{{ 'leaderboard.period_label'|trans }}">
                        <a class="period-pill {{ activePeriod == 'week' ? 'active' : '' }}" href="{{ path('app_leaderboard', {tab: activeTab, period: 'week'}) }}">{{ 'leaderboard.this_week'|trans }}</a>
                        <a class="period-pill {{ activePeriod == 'month' ? 'active' : '' }}" href="{{ path('app_leaderboard', {tab: activeTab, period: 'month'}) }}">{{ 'leaderboard.this_month'|trans }}</a>
                        <a class="period-pill {{ activePeriod == 'all' ? 'active' : '' }}" href="{{ path('app_leaderboard', {tab: activeTab, period: 'all'}) }}">{{ 'leaderboard.all_time'|trans }}</a>
                    </div>
                </div>
                <div class="user-rank-info lb-rank-info">
                    {% if app.user and currentUserRank %}
                        <p>Votre rang {{ periodLabel }} : <strong>#{{ currentUserRank }}</strong>.</p>
                    {% elseif app.user %}
                        <p>{{ 'leaderboard.no_logs'|trans }}</p>
                    {% else %}
                        <p><a href="{{ path('app_login') }}">{{ 'login.submit'|trans }}</a> pour voir votre rang.</p>
                    {% endif %}
                </div>
            </div>
        </section>

        <section class="leaderboard-main-section lb-panel-section">
            <div class="container">
                <div class="lb-section-heading">
                    <div class="section-badge">{{ activeTab == 'prints' ? 'Impressions 3D' : 'Temps de présence' }}</div>
                    <h2>{{ activeTab == 'prints' ? 'Top imprimeurs' : 'Top présence' }} {{ periodLabel }}</h2>
                </div>
                {% if leaderboard is empty %}
                    <div class="leaderboard-empty">{{ 'leaderboard.no_data'|trans }}</div>
                {% else %}
                    <div class="leaderboard-podium">
                        {% for podiumIndex in [1, 0, 2] %}
                            {% if leaderboard[podiumIndex] is defined %}
                                {% set entry = leaderboard[podiumIndex] %}
                                <div class="podium-place {{ entry.rank == 1 ? 'first' : (entry.rank == 2 ? 'second' : 'third') }}">
                                    <div class="podium-user">
                                        {% include 'site/_user_avatar.html.twig' with {user: entry.user, size: 60, class: 'user-avatar-medium', alt: entry.user.displayName} only %}
                                        <div class="user-info-medium">
                                            <span class="user-name-medium">{{ entry.user.displayName }}</span>
                                            <span class="user-value-medium">{{ activeTab == 'prints' ? entry.printCount ~ ' impressions' : entry.presenceMinutes ~ ' min' }}</span>
                                        </div>
                                    </div>
                                    <div class="podium-rank">{{ entry.rank }}</div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>

                    <div class="leaderboard-table-container">
                        <div class="leaderboard-table">
                            <div class="leaderboard-row header">
                                <div class="leaderboard-cell rank">{{ 'leaderboard.col_rank'|trans }}</div><div class="leaderboard-cell user">{{ 'leaderboard.col_user'|trans }}</div><div class="leaderboard-cell value">{{ activeTab == 'prints' ? 'Impressions' : 'Présence' }}</div><div class="leaderboard-cell badges">{{ 'leaderboard.col_other'|trans }}</div><div class="leaderboard-cell formations">{{ 'nav.badges'|trans }}</div><div class="leaderboard-cell machines">{{ 'home.stat_machines'|trans }}</div>
                            </div>
                            {% for entry in leaderboard %}
                                <div class="leaderboard-row" data-rank="{{ entry.rank }}">
                                    <div class="leaderboard-cell rank"><span class="rank-number">{{ entry.rank }}</span></div>
                                    <div class="leaderboard-cell user">{% include 'site/_user_avatar.html.twig' with {user: entry.user, size: 34, class: 'user-avatar-small', alt: entry.user.displayName} only %}<span class="user-name">{{ entry.user.displayName }}</span></div>
                                    <div class="leaderboard-cell value">{{ activeTab == 'prints' ? entry.printCount ~ ' impressions' : entry.presenceMinutes ~ ' min' }}</div>
                                    <div class="leaderboard-cell badges">{{ activeTab == 'prints' ? entry.presenceMinutes ~ ' min' : entry.printCount ~ ' impressions' }}</div>
                                    <div class="leaderboard-cell formations">{{ entry.badges }}</div>
                                    <div class="leaderboard-cell machines">{{ entry.machinesUsed }}</div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </section>

    </main>

    
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/main.js') ~ '?v=20260709-header-scope' }}"></script>
{% endblock %}
