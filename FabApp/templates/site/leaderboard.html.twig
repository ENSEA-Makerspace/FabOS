<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leaderboard - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    <!-- ========================================
         BANDEAU D'ALERTE
         ======================================== -->
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <!-- ========================================
         HEADER
         ======================================== -->
    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    <img src="{{ asset('images/ENSEA.png') }}" alt="ENSEA" class="ensea-logo-img ensea-logo-svg">
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">Accueil</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">Calendrier</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">Machines</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">Formations</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link active">Leaderboard</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">Admin</a>
                    {% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- ========================================
         CONTENU PRINCIPAL
         ======================================== -->
    <main class="main-content">
        <!-- En-tête -->
        <section class="page-header">
            <div class="container">
                <div class="section-badge">Leaderboard</div>
                <p class="page-description">
                    Consultez les classements des utilisateurs du FabLab. 
                    Voyez qui passe le plus de temps, qui a le plus de badges et qui est le plus actif.
                </p>
            </div>
        </section>

        <!-- Sélecteur de période et type -->
        <section class="leaderboard-controls-section">
            <div class="container">
                <div class="leaderboard-controls">
                    <!-- Sélecteur de type de classement -->
                    <div class="leaderboard-type-selector">
                        <button class="leaderboard-type-btn active" data-type="time">Temps de présence</button>
                        <button class="leaderboard-type-btn" data-type="badges" disabled>Nombre de badges</button>
                        <button class="leaderboard-type-btn" data-type="formations" disabled>Formations complétées</button>
                        <button class="leaderboard-type-btn" data-type="reservations" disabled>Réservations réalisées</button>
                    </div>

                    <!-- Sélecteur de période -->
                    <div class="leaderboard-period-selector">
                        <select class="filter-select" id="period-selector" disabled>
                            <option value="week">Cette semaine</option>
                            <option value="month">Ce mois</option>
                            <option value="all">Tous</option>
                        </select>
                    </div>
                </div>

                <!-- Info utilisateur connecté -->
                <div class="user-rank-info">
                    <p>Vous n'êtes pas connecté. <a href="{{ path('app_login') }}">Se connecter</a> pour voir votre rang.</p>
                </div>
            </div>
        </section>

        <!-- Classement principal -->
        <section class="leaderboard-main-section">
            <div class="container">
                {% if leaderboard is empty %}
                    <div class="leaderboard-table-container">
                        <div class="leaderboard-table">
                            <div class="leaderboard-row">
                                <div class="leaderboard-cell user">Aucune donnée de classement disponible pour le moment.</div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <!-- Podium (Top 3) -->
                    <div class="leaderboard-podium">
                        {% if leaderboard[1] is defined %}
                            {% set entry = leaderboard[1] %}
                            {% set initials = ((entry.user.firstName|default(entry.user.username)|slice(0, 1)) ~ (entry.user.lastName|default('')|slice(0, 1)))|upper %}
                            <div class="podium-place second">
                                <div class="podium-user">
                                    <div class="user-avatar-medium">{{ initials ?: entry.user.username|slice(0, 2)|upper }}</div>
                                    <div class="user-info-medium">
                                        <span class="user-name-medium">{{ entry.user.displayName }}</span>
                                        <span class="user-value-medium">{{ entry.user.tempsPresenceTotal }} min</span>
                                    </div>
                                </div>
                                <div class="podium-rank">2</div>
                            </div>
                        {% endif %}

                        {% if leaderboard[0] is defined %}
                            {% set entry = leaderboard[0] %}
                            {% set initials = ((entry.user.firstName|default(entry.user.username)|slice(0, 1)) ~ (entry.user.lastName|default('')|slice(0, 1)))|upper %}
                            <div class="podium-place first">
                                <div class="podium-user">
                                    <div class="user-avatar-medium">{{ initials ?: entry.user.username|slice(0, 2)|upper }}</div>
                                    <div class="user-info-medium">
                                        <span class="user-name-medium">{{ entry.user.displayName }}</span>
                                        <span class="user-value-medium">{{ entry.user.tempsPresenceTotal }} min</span>
                                    </div>
                                </div>
                                <div class="podium-rank">1</div>
                            </div>
                        {% endif %}

                        {% if leaderboard[2] is defined %}
                            {% set entry = leaderboard[2] %}
                            {% set initials = ((entry.user.firstName|default(entry.user.username)|slice(0, 1)) ~ (entry.user.lastName|default('')|slice(0, 1)))|upper %}
                            <div class="podium-place third">
                                <div class="podium-user">
                                    <div class="user-avatar-medium">{{ initials ?: entry.user.username|slice(0, 2)|upper }}</div>
                                    <div class="user-info-medium">
                                        <span class="user-name-medium">{{ entry.user.displayName }}</span>
                                        <span class="user-value-medium">{{ entry.user.tempsPresenceTotal }} min</span>
                                    </div>
                                </div>
                                <div class="podium-rank">3</div>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Top utilisateurs -->
                    <div class="leaderboard-table-container">
                        <div class="leaderboard-table">
                            <div class="leaderboard-row header">
                                <div class="leaderboard-cell rank">Rang</div>
                                <div class="leaderboard-cell user">Utilisateur</div>
                                <div class="leaderboard-cell value">Temps de présence</div>
                                <div class="leaderboard-cell badges">Badges</div>
                                <div class="leaderboard-cell formations">Formations complétées</div>
                                <div class="leaderboard-cell machines">Machines utilisées</div>
                            </div>

                            {% for entry in leaderboard %}
                                {% set initials = ((entry.user.firstName|default(entry.user.username)|slice(0, 1)) ~ (entry.user.lastName|default('')|slice(0, 1)))|upper %}
                                <div class="leaderboard-row" data-rank="{{ entry.rank }}">
                                    <div class="leaderboard-cell rank">
                                        <span class="rank-number">{{ entry.rank }}</span>
                                    </div>
                                    <div class="leaderboard-cell user">
                                        <div class="user-avatar-small">{{ initials ?: entry.user.username|slice(0, 2)|upper }}</div>
                                        <span class="user-name">{{ entry.user.displayName }}</span>
                                    </div>
                                    <div class="leaderboard-cell value">{{ entry.user.tempsPresenceTotal }} min</div>
                                    <div class="leaderboard-cell badges">{{ entry.badges }}</div>
                                    <div class="leaderboard-cell formations">{{ entry.completedFormations }}</div>
                                    <div class="leaderboard-cell machines">{{ entry.machinesUsed }}</div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </section>

        <!-- Statistiques -->
        <section class="leaderboard-stats-section">
            <div class="container">
                <div class="section-badge">Statistiques du FabLab</div>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ stats.users }}</span>
                            <span class="stat-label">Utilisateurs</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ stats.machines }}</span>
                            <span class="stat-label">Machines</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ stats.formations }}</span>
                            <span class="stat-label">Formations</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#9E1B56" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">{{ stats.reservations }}</span>
                            <span class="stat-label">Réservations enregistrées</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- ========================================
         FOOTER
         ======================================== -->
    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.leaderboard-type-btn[disabled]').forEach(function(button) {
                button.setAttribute('aria-disabled', 'true');
            });
        });
    </script>
</body>
</html>
