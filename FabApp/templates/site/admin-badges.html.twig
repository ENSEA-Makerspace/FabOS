<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Badges - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/badges.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    <style>
        .admin-page-header {
            background: linear-gradient(135deg, #9E1B56 0%, #7a1542 100%);
            color: white;
            padding: var(--spacing-xl) 0;
            margin-bottom: var(--spacing-xl);
        }
        
        .admin-page-header-content {
            max-width: var(--max-width);
            margin: 0 auto;
            padding: 0 var(--spacing-lg);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-lg);
        }
        
        .admin-page-title h1 {
            font-size: var(--font-size-3xl);
            margin-bottom: var(--spacing-sm);
        }
        
        .admin-page-title p {
            opacity: 0.9;
        }
        
        .admin-page-actions {
            display: flex;
            gap: var(--spacing-sm);
        }
        
        .admin-main {
            max-width: var(--max-width);
            margin: 0 auto var(--spacing-xl);
            padding: 0 var(--spacing-lg);
        }
        
        .admin-content-grid {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: var(--spacing-xl);
        }
        
        .admin-sidebar {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            height: fit-content;
        }
        
        .admin-sidebar h3 {
            font-size: var(--font-size-lg);
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: var(--spacing-lg);
            padding-bottom: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-nav {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-xs);
        }
        
        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            padding: var(--spacing-md);
            color: var(--color-text);
            text-decoration: none;
            border-radius: var(--border-radius-sm);
            transition: all var(--transition);
            font-weight: 500;
        }
        
        .admin-nav-link:hover {
            background: var(--color-bg-light);
            color: var(--color-primary);
        }
        
        .admin-nav-link.active {
            background: var(--color-primary);
            color: white;
        }
        
        .admin-nav-link svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }
        
        .admin-main-content {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-lg);
        }
        
        .admin-panel {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-xl);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
        }
        
        .admin-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-lg);
            padding-bottom: var(--spacing-md);
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-panel-header h2 {
            font-size: var(--font-size-xl);
            font-weight: 600;
            color: var(--color-text);
        }
        
        .filters-bar {
            display: flex;
            gap: var(--spacing-lg);
            flex-wrap: wrap;
            margin-bottom: var(--spacing-lg);
        }
        
        .filter-group {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }
        
        .filter-group label {
            font-size: var(--font-size-sm);
            font-weight: 500;
            color: var(--color-text);
        }
        
        .filter-select {
            padding: var(--spacing-sm) var(--spacing-md);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: var(--font-size-base);
            background: white;
            cursor: pointer;
        }
        
        .filter-input {
            width: 200px;
            padding: var(--spacing-sm) var(--spacing-md);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: var(--font-size-base);
        }
        
        .badges-list-container {
            overflow-x: auto;
            border: 1px solid #eadde4;
            border-radius: 18px;
            background: #fff;
        }

        .badges-list-header,
        .badges-list {
            min-width: 860px;
            width: 100%;
        }

        .badge-list-row {
            display: grid;
            width: 100%;
            box-sizing: border-box;
            grid-template-columns: 42px minmax(230px, 1.45fr) minmax(150px, .8fr) minmax(165px, .9fr) 86px 96px;
            gap: 16px;
            align-items: center;
            padding: 18px 20px;
            border-bottom: 1px solid #efe5ea;
            transition: background var(--transition), transform var(--transition);
        }

        .badges-list .badge-list-row:last-child {
            border-bottom: 0;
        }

        .badge-list-row:not(.header):hover {
            background: #fdf9fb;
        }

        .badge-list-row.header {
            padding-top: 15px;
            padding-bottom: 15px;
            background: #faf6f8;
            color: #5f4e58;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .025em;
        }

        .badge-list-cell {
            min-width: 0;
            color: var(--color-text);
            font-size: var(--font-size-sm);
        }

        .badge-list-cell.checkbox {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .badge-list-cell.checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--color-primary);
        }

        .badge-list-cell.name {
            display: grid;
            gap: 5px;
        }

        .badge-admin-name {
            color: #1e1720;
            font-size: .96rem;
            font-weight: 800;
            line-height: 1.35;
        }

        .badge-admin-meta {
            color: var(--color-text-light);
            font-size: .76rem;
            line-height: 1.4;
        }

        .badge-admin-icon-key {
            display: inline-flex;
            width: fit-content;
            max-width: 100%;
            padding: 4px 8px;
            overflow: hidden;
            border-radius: 999px;
            background: #f6f1f4;
            color: #765c6a;
            font-size: .69rem;
            font-weight: 700;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .badge-list-cell.metric {
            display: grid;
            gap: 3px;
            align-content: center;
        }

        .badge-list-cell.metric strong {
            color: var(--color-primary);
            font-size: 1.22rem;
            line-height: 1;
        }

        .badge-list-cell.metric span {
            color: var(--color-text-light);
            font-size: .73rem;
            line-height: 1.35;
        }

        .badge-list-cell.preview {
            display: flex;
            justify-content: center;
        }

        .admin-badge-preview.fabos-badge-visual.is-sm {
            width: 52px;
            height: 52px;
        }

        .badge-list-cell.actions {
            display: flex;
            justify-content: flex-end;
        }

        .badges-list-header {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #faf6f8;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 34px;
            padding: 6px 11px;
            border: 1px solid #ded3d9;
            border-radius: 9px;
            background: #fff;
            color: var(--color-primary);
            font-size: .75rem;
            font-weight: 700;
            text-decoration: none;
            transition: background var(--transition), border-color var(--transition), color var(--transition);
        }

        .action-btn:hover {
            border-color: var(--color-primary);
            background: rgba(158, 27, 86, .07);
            color: #7a1542;
        }

        .badge-empty-state {
            grid-column: 2 / -1;
            padding: 20px 0;
            color: var(--color-text-light);
            text-align: center;
        }

        .bulk-actions {
            display: flex;
            gap: var(--spacing-sm);
            flex-wrap: wrap;
        }

        .btn-danger {
            background: #F44336;
            color: white;
            border: none;
        }

        .btn-danger:hover {
            background: #d32f2f;
        }

        .btn-sm {
            padding: var(--spacing-xs) var(--spacing-sm);
            font-size: var(--font-size-sm);
        }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: var(--spacing-xs);
            padding: var(--spacing-lg) 0;
        }

        .pagination-link {
            min-width: 36px;
            height: 36px;
            padding: 0 var(--spacing-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
            text-decoration: none;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            transition: all var(--transition);
        }

        .pagination-link:hover {
            background: var(--color-bg-light);
            color: var(--color-primary);
        }

        .pagination-link.active {
            background: var(--color-primary);
            border-color: var(--color-primary);
            color: white;
        }
        
        /* Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }
        
        .modal-overlay.active {
            display: flex;
        }
        
        .modal {
            background: white;
            border-radius: var(--border-radius);
            width: 100%;
            max-width: 700px;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: var(--shadow-lg);
            animation: modalSlideIn 0.3s ease;
        }
        
        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--spacing-xl);
            border-bottom: 1px solid var(--border-color);
        }
        
        .modal-header h2 {
            font-size: var(--font-size-xl);
            font-weight: 600;
        }
        
        .modal-close {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 24px;
            color: var(--color-text-light);
        }
        
        .modal-body {
            padding: var(--spacing-xl);
        }
        
        .form-group-modal {
            margin-bottom: var(--spacing-lg);
        }
        
        .form-label-modal {
            display: block;
            font-size: var(--font-size-base);
            font-weight: 500;
            color: var(--color-text);
            margin-bottom: var(--spacing-xs);
        }
        
        .form-input-modal {
            width: 100%;
            padding: var(--spacing-sm) var(--spacing-md);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            font-size: var(--font-size-base);
            margin-bottom: var(--spacing-sm);
        }
        
        .form-row-modal {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-md);
        }
        
        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: var(--spacing-sm);
            padding: var(--spacing-xl);
            border-top: 1px solid var(--border-color);
        }
        
        .icon-selector {
            display: flex;
            flex-wrap: wrap;
            gap: var(--spacing-sm);
            margin-top: var(--spacing-sm);
        }
        
        .icon-option {
            width: 40px;
            height: 40px;
            border: 2px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            cursor: pointer;
            transition: all var(--transition);
        }
        
        .icon-option:hover {
            border-color: var(--color-primary);
            background: rgba(158, 27, 86, 0.05);
        }
        
        .icon-option.selected {
            border-color: var(--color-primary);
            background: rgba(158, 27, 86, 0.1);
        }
        
        /* Responsive */
        @media (max-width: 992px) {
            .admin-content-grid {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 768px) {
            .admin-page-header-content {
                flex-direction: column;
                text-align: center;
            }
            
            .filters-bar {
                flex-direction: column;
                align-items: stretch;
            }
            
            .filter-input {
                width: 100%;
            }
            
            .form-row-modal {
                grid-template-columns: 1fr;
            }
            
            .admin-panel {
                padding: var(--spacing-lg);
            }
        }
    </style>
</head>
<body>
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    {% include 'site/_logo.html.twig' %}
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">{{ 'nav.home'|trans }}</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">{{ 'nav.calendar'|trans }}</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">{{ 'nav.machines'|trans }}</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">{{ 'nav.trainings'|trans }}</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">{{ 'nav.leaderboard'|trans }}</a><a href="{{ path('app_leaderboard_creations') }}" class="navbar-link">{{ 'nav.projects'|trans }}</a>
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <main class="main-content">
        <section class="admin-page-header">
            <div class="admin-page-header-content">
                <div class="admin-page-title">
                    <h1>Gestion des Badges</h1>
                    <p>Gérez toutes les certifications et compétences du FabLab</p>
                </div>
                <div class="admin-page-actions">
                    <a class="btn btn-primary" href="{{ path('app_admin_badge_new') }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        Créer un badge
                    </a>
                </div>
            </div>
        </section>

        <div class="admin-main">
            <div class="admin-content-grid">
                {% include 'site/_admin_sidebar.html.twig' %}

                <div class="admin-main-content">
                    {% for message in app.flashes('success') %}
                        <div class="admin-panel" style="padding: 14px 18px; color: #166534; background: #dcfce7; border-color: #bbf7d0;">{{ message }}</div>
                    {% endfor %}
                    <div class="admin-panel">
                        <div class="admin-panel-header">
                            <h2>Liste des badges</h2>
                            <div class="bulk-actions">
                                <button class="btn btn-primary btn-sm" id="edit-selected" disabled title="Gestion bientôt disponible">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                    Gestion bientôt disponible
                                </button>
                                <button class="btn btn-danger btn-sm" id="delete-selected" disabled title="Gestion bientôt disponible">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <line x1="15" y1="9" x2="9" y2="15"/>
                                        <line x1="9" y1="9" x2="15" y2="15"/>
                                    </svg>
                                    Gestion bientôt disponible
                                </button>
                            </div>
                        </div>
                        <form class="filters-bar" method="get" action="{{ path('app_admin_badges') }}">
                            <div class="filter-group">
                                <label for="search-badges">Rechercher:</label>
                                <input type="search" name="q" id="search-badges" class="filter-input" placeholder="Nom, description, icône" value="{{ filters.q|default('') }}">
                            </div>
                            <button class="btn btn-secondary btn-small" type="submit">Filtrer</button>
                            <a class="btn btn-secondary btn-small" href="{{ path('app_admin_badges') }}">Réinitialiser</a>
                        </form>
                        <div class="filters-bar">
                            <div class="filter-group">
                                <label for="badge-search">Rechercher:</label>
                                <input type="text" id="badge-search" class="filter-input" placeholder="Recherche bientôt disponible" disabled>
                            </div>
                            <div class="filter-group">
                                <label for="badge-level">Niveau:</label>
                                <select id="badge-level" class="filter-select" disabled>
                                    <option value="all">Tous</option>
                                    <option value="bronze">Bronze</option>
                                    <option value="silver">Argent</option>
                                    <option value="gold">Or</option>
                                    <option value="platinum">Platine</option>
                                </select>
                            </div>
                            <div class="filter-group">
                                <label for="badge-category">Catégorie:</label>
                                <select id="badge-category" class="filter-select" disabled>
                                    <option value="all">Tous</option>
                                    <option value="impression-3d">Impression 3D</option>
                                    <option value="decoupe">Découpe & Gravure</option>
                                    <option value="usinage">Usinage</option>
                                    <option value="electronique">Electronique</option>
                                    <option value="securite">Sécurité</option>
                                    <option value="expertise">Expertise</option>
                                </select>
                            </div>
                            <button class="btn btn-secondary btn-small" disabled>Gestion bientôt disponible</button>
                        </div>
                    </div>

                    <div class="admin-panel">
                        <div class="badges-list-container">
                            <div class="badges-list-header">
                                <div class="badge-list-row header">
                                    <div class="badge-list-cell checkbox"><input type="checkbox" id="select-all-badges" disabled></div>
                                    <div class="badge-list-cell name">Badge</div>
                                    <div class="badge-list-cell metric">Utilisateurs détenteurs</div>
                                    <div class="badge-list-cell metric">Formations associées</div>
                                    <div class="badge-list-cell preview">Aperçu</div>
                                    <div class="badge-list-cell actions">Action</div>
                                </div>
                            </div>
                            <div class="badges-list">
                                {% if badgeRows is empty %}
                                    <div class="badge-list-row">
                                        <div class="badge-list-cell checkbox"></div>
                                        <div class="badge-empty-state">Aucun badge enregistré</div>
                                    </div>
                                {% else %}
                                    {% for row in badgeRows %}
                                        {% set badge = row.badge %}
                                        <div class="badge-list-row">
                                            <div class="badge-list-cell checkbox"><input type="checkbox" class="badge-checkbox" disabled></div>
                                            <div class="badge-list-cell name">
                                                <span class="badge-admin-name">#{{ badge.id }} · {{ badge.nom }}</span>
                                                <span class="badge-admin-meta">Créé le {{ badge.createdAt|date('d/m/Y H:i') }}</span>
                                                <span class="badge-admin-icon-key" title="Référence d’icône enregistrée">Icône : {{ badge.icone ?: 'non renseignée' }}</span>
                                            </div>
                                            <div class="badge-list-cell metric">
                                                <strong>{{ row.userCount }}</strong>
                                                <span>{{ row.userCount > 1 ? 'utilisateurs détiennent ce badge' : (row.userCount == 1 ? 'utilisateur détient ce badge' : 'aucun utilisateur détenteur') }}</span>
                                            </div>
                                            <div class="badge-list-cell metric">
                                                <strong>{{ row.formationCount }}</strong>
                                                <span>{{ row.formationCount > 1 ? 'formations associées' : (row.formationCount == 1 ? 'formation associée' : 'aucune formation associée') }}</span>
                                            </div>
                                            <div class="badge-list-cell preview">
                                                {% include 'site/_badge_visual.html.twig' with {
                                                    badge: badge,
                                                    size: 'sm',
                                                    className: 'admin-badge-preview',
                                                    locked: false
                                                } only %}
                                            </div>
                                            <div class="badge-list-cell actions">
                                                <a class="action-btn edit" href="{{ path('app_admin_badge_edit', {id: badge.id}) }}">Modifier</a>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>
                        
                        <div class="pagination">
                            <span>{{ badgeRows|length }} badge{{ badgeRows|length > 1 ? 's' : '' }} enregistré{{ badgeRows|length > 1 ? 's' : '' }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="modal-overlay" id="addBadgeModal">
        <div class="modal">
            <div class="modal-header">
                <h2>Créer un badge</h2>
                <button class="modal-close" onclick="closeAddBadgeModal()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="addBadgeForm">
                    <div class="form-group-modal">
                        <label class="form-label-modal">Nom du badge</label>
                        <input type="text" class="form-input-modal" placeholder="Gestion bientôt disponible" disabled>
                    </div>
                    <div class="form-group-modal">
                        <label class="form-label-modal">Description</label>
                        <textarea class="form-input-modal" rows="3" placeholder="Gestion bientôt disponible" disabled></textarea>
                    </div>
                    <div class="form-row-modal">
                        <div class="form-group-modal">
                            <label class="form-label-modal">Catégorie</label>
