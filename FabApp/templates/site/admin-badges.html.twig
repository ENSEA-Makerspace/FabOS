{% extends 'base.html.twig' %}

{# S78 step 7 — this page had its own <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of these
   grew a <style> and every <style> grew literal colours. The shell emits the
   doctype, style.css, the favicon and importmap('app'); this file keeps only
   what is its own.

   S84 — and what was its own turned out to be nothing. The inline block was
   215 lines: the page chrome that S82 unwound (`.admin-main`, `.admin-sidebar`,
   `.admin-nav-*`, `.admin-page-header-content`), a modal that no longer exists,
   and a private copy of `.admin-panel` that **overrode S83's ground and lift**
   because it loads after `admin.css`. The list is a `_data_table` now and the
   two genuinely-new cell shapes (`.admin-cell-stack`, `.admin-cell-metric`)
   live in `admin.css` under names that are not about badges. #}

{% block title %}Gestion des Badges - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260808-s89-list-maquette' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260802-s78-crumb' }}">
    {# `_badge_visual` lives here — the preview column is the only reason this
       page loads it. #}
    <link rel="stylesheet" href="{{ asset('css/badges.css') ~ '?v=20260709-header-scope' }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    title: 'Gestion des Badges',
    description: 'Gérez toutes les certifications et compétences du FabLab',
    action_label: 'Créer un badge',
    action_route: 'app_admin_badge_new',
    panel_title: 'Liste des badges',
    panel_note: badgeRows|length ~ ' badge' ~ (badgeRows|length > 1 ? 's' : '') ~ ' enregistré' ~ (badgeRows|length > 1 ? 's' : ''),
    list_tools: true,
    list_client_filter: true,
    list_route: 'app_admin_badges',
    list_search: filters.q|default(''),
    list_search_placeholder: 'common.search_placeholder'|trans,
} %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'Badge'},
                {label: 'Utilisateurs détenteurs'},
                {label: 'Formations associées'},
                {label: 'Aperçu'},
                {label: 'Action', class: 'is-actions'},
            ],
            rows: badgeRows,
            empty: 'Aucun badge enregistré.',
        } %}
            {% block rows %}
                {% for row in badgeRows %}
                    {% set badge = row.badge %}
                    <tr data-admin-list-filter-row>
                        <td>
                            <div class="admin-cell-stack">
                                <span class="is-strong">#{{ badge.id }} · {{ badge.nom }}</span>
                                <span class="is-meta">Créé le {{ badge.createdAt|lab_date('d/m/Y H:i') }}</span>
                                <span class="badge-admin-icon-key" title="Référence d’icône enregistrée">Icône : {{ badge.icone ?: 'non renseignée' }}</span>
                            </div>
                        </td>
                        <td>
                            <div class="admin-cell-metric">
                                <strong>{{ row.userCount }}</strong>
                                <span>{{ row.userCount > 1 ? 'utilisateurs détiennent ce badge' : (row.userCount == 1 ? 'utilisateur détient ce badge' : 'aucun utilisateur détenteur') }}</span>
                            </div>
                        </td>
                        <td>
                            <div class="admin-cell-metric">
                                <strong>{{ row.formationCount }}</strong>
                                <span>{{ row.formationCount > 1 ? 'formations associées' : (row.formationCount == 1 ? 'formation associée' : 'aucune formation associée') }}</span>
                            </div>
                        </td>
                        <td>
                            {% include 'site/_badge_visual.html.twig' with {
                                badge: badge,
                                size: 'sm',
                                className: 'admin-badge-preview',
                                locked: false
                            } only %}
                        </td>
                        <td class="is-actions">
                            <a class="admin-action" href="{{ path('app_admin_badge_edit', {id: badge.id}) }}">{% include 'site/_icon.html.twig' with { name: 'edit' } only %} Modifier</a>
                        </td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% include 'site/_footer.html.twig' %}
{% endblock %}
