{% extends 'base.html.twig' %}

{# S78 step 7 — this page had its own <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of these
   grew a <style> and every <style> grew literal colours. The shell emits the
   doctype, style.css, the favicon and importmap('app'); this file keeps only
   what is its own.

   S84 — and what was its own turned out to be nothing. The inline block was
   215 lines: the page chrome that S82 unwound (`.admin-main`, `.admin-sidebar`,
   `.admin-nav-*`, `.admin-page-header-content`), a modal that no longer exists,
   and a private copy of `.admin-panel` that **overrode S83's ground and lift**
   because it loads after `admin.css`. The list is a `_data_table` now and the
   two genuinely-new cell shapes (`.admin-cell-stack`, `.admin-cell-metric`)
   live in `admin.css` under names that are not about badges. #}

{% block title %}{{ 'admin_badges.title'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s147j22' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260822-s148d' }}">
    {# `_badge_visual` lives here — the preview column is the only reason this
       page loads it. #}
    <link rel="stylesheet" href="{{ asset('css/badges.css') ~ '?v=20260822-s148d' }}">
{% endblock %}

{% block body %}
{% embed 'site/_admin_list.html.twig' with {
    action_label: 'admin_badges.create'|trans,
    action_route: 'app_admin_badge_new',
    panel_title: 'admin_badges.panel_title'|trans,
    panel_note: 'admin_badges.panel_note'|trans({'%count%': badgeRows|length}),
    list_client_filter: false,
    list_route: 'app_admin_badges',
    list_search: filters.q|default(''),
    list_search_placeholder: 'common.search_placeholder'|trans,
} %}
    {% block content %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'admin_badges.col_badge'|trans, class: 'is-grow'},
                {label: 'admin_badges.col_holders'|trans, class: 'is-tight'},
                {label: 'admin_badges.col_trainings'|trans, class: 'is-tight'},
                {label: 'admin_badges.col_action'|trans, class: 'is-actions'},
            ],
            rows: badgeRows,
            empty: 'admin_badges.empty'|trans,
        } %}
            {% block rows %}
                {% for row in badgeRows %}
                    {% set badge = row.badge %}
                    <tr data-admin-list-filter-row data-admin-list-filter-row-href="{{ path('app_admin_badge_edit', {id: badge.id}) }}">
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: '#' ~ badge.id ~ ' · ' ~ badge.nom,
                            href: path('app_admin_badge_edit', {id: badge.id}),
                            subtitle: 'admin_badges.created_on'|trans({'%date%': badge.createdAt|lab_date('d/m/Y H:i')}),
                            media: include('site/_badge_visual.html.twig', {
                                badge: badge, size: 'sm', className: 'admin-badge-preview', locked: false,
                            }, with_context = false),
                        } only %}
                            {% if badge.archived %}{% include 'site/_cell_state.html.twig' with {label: 'admin_badges.archived'|trans, signal: 'muted'} only %}{% endif %}
                            <span class="badge-admin-icon-key" title="{{ 'admin_badges.icon_title'|trans }}">{{ 'admin_badges.icon'|trans({'%icon%': badge.icone ?: 'admin_badges.icon_none'|trans}) }}</span>
                        </td>
                        {# `.admin-cell-metric` was a number with a caption and no ceiling —
                           "12 holders" against nothing. A badge has no maximum, so the meter
                           renders the number alone; the caption is what it always was. #}
                        <td>{% include 'site/_cell_meter.html.twig' with {
                            value: row.userCount,
                            label: (row.userCount > 1 ? 'admin_badges.holders_many' : (row.userCount == 1 ? 'admin_badges.holders_one' : 'admin_badges.holders_none'))|trans,
                        } only %}</td>
                        <td>{% include 'site/_cell_meter.html.twig' with {
                            value: row.formationCount,
                            label: (row.formationCount > 1 ? 'admin_badges.trainings_many' : (row.formationCount == 1 ? 'admin_badges.trainings_one' : 'admin_badges.trainings_none'))|trans,
                        } only %}</td>
                        <td class="is-actions">{% include 'site/_cell_actions.html.twig' with {
                            actions: [{label: 'common.edit'|trans, icon: 'edit', href: path('app_admin_badge_edit', {id: badge.id})}],
                        } only %}</td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
