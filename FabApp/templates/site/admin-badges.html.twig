    <script>
        function openAddBadgeModal() {
            document.getElementById('addBadgeModal').classList.add('active');
        }
        
        function closeAddBadgeModal() {
            document.getElementById('addBadgeModal').classList.remove('active');
        }
        
        const addBadgeModal = document.getElementById('addBadgeModal');
        if (addBadgeModal) {
            addBadgeModal.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeAddBadgeModal();
                }
            });
        }
        
        function selectIcon(element) {
            document.querySelectorAll('.icon-option').forEach(el => el.classList.remove('selected'));
            element.classList.add('selected');
            document.getElementById('selected-icon').value = element.textContent;
        }
        
        const selectAllBadges = document.getElementById('select-all-badges');
        if (selectAllBadges) {
            selectAllBadges.addEventListener('change', function() {
                const checkboxes = document.querySelectorAll('.badge-checkbox');
                checkboxes.forEach(cb => cb.checked = this.checked);
            });
        }
    </script>
