{% extends 'base.html.twig' %}

{# S78 step 7 — this page owned its <!DOCTYPE> and <head>. With no layout
   there was nowhere to put a stylesheet link, which is why every one of
   these grew a <style> and every <style> grew literal colours. The shell
   emits the doctype, style.css, the favicon and importmap('app').

   ⚠️ It GAINS Stimulus — the shell emits `importmap('app')` and this page
   did not, so `confirm_controller` and friends now actually run here. A
   delete button wired to a controller that never loaded deletes without
   asking, so that is the fix rather than a side effect. #}

{% block title %}{{ 'event_regs.title'|trans }} - {{ event.titre }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260816-s139e' }}">
    {# 🔴 **A FOURTH private status chip deleted here (S135).** `.pill` had five
       states written as literal `rgba(…)` fills with hand-written dark-mode
       overrides — the exact shape the token layer and `_cell_state` exist to
       replace, and the reason "présent" was a different green from "disponible"
       three screens away. `.btn-row` was a private row button beside
       `.admin-action`, and `.btn-primary` / `.btn-danger` carried the literal
       accent and red again.

       What stays is genuinely not list furniture — the four-figure header, the
       cancellation banner and the call-off form — and its literals are on tokens
       now so dark mode reaches them. #}
    <style>
        .reg-stats { display: flex; flex-wrap: wrap; gap: 12px; margin: 0 0 20px; }
        .reg-stat { background: var(--theme-surface-elevated); border: 1px solid var(--border-color); border-radius: 10px; padding: 10px 16px; min-width: 120px; }
        .reg-stat__value { font-size: 22px; font-weight: 800; font-variant-numeric: tabular-nums; }
        .reg-stat__label { color: var(--color-text-light); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
        .calloff { margin-top: 28px; border: 1px solid color-mix(in srgb, var(--color-stop) 35%, transparent); background: var(--tone-stop-soft); border-radius: 12px; padding: 18px 20px; }
        .calloff h2 { font-size: 16px; margin: 0 0 6px; color: var(--color-stop); }
        .calloff p { color: var(--color-text-light); font-size: 13px; margin: 0 0 12px; }
        .calloff input[type="text"] { width: 100%; max-width: 460px; padding: 9px 11px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--theme-input); color: var(--color-text); margin-bottom: 10px; }
        .cancelled-banner { background: var(--tone-stop-soft); color: var(--color-stop); border-radius: 10px; padding: 14px 18px; margin-bottom: 18px; }
    </style>
{% endblock %}

{% block body %}
{# ⚠️ **One of the three screens that override the shell's title** (S141). The
   menu names this route "Événements", which is true of the list it hangs off and
   useless here: what an operator needs to read at the top of a registrations
   list is WHICH event. "Inscriptions" survives as the section's accessible
   heading and the count says the rest. #}
{% embed 'site/_admin_list.html.twig' with {
    page_title: event.titre,
    panel_title: 'event_regs.title'|trans,
    panel_note: 'event_regs.panel_note'|trans({'%count%': registrations|length}),
    list_count: registrations|length,
    list_route: 'app_admin_event_registrations',
    list_route_params: {id: event.id},
    list_search_placeholder: 'common.search_placeholder'|trans,
    list_client_filter: true,
    list_tiles_label: 'event_regs.col_state'|trans,
    list_tiles: [
        {label: 'admin_list.all'|trans, count: registrations|length, category: 'all', active: true},
        {label: 'event_regs.status_registered'|trans, count: registrations|filter(reg => reg.status == 'registered')|length, category: 'registered'},
        {label: 'event_regs.status_waitlisted'|trans, count: registrations|filter(reg => reg.status == 'waitlisted')|length, category: 'waitlisted'},
        {label: 'event_regs.status_cancelled'|trans, count: registrations|filter(reg => reg.status == 'cancelled')|length, category: 'cancelled'},
    ],
} %}
    {% block content %}
        {% if event.cancelled %}
            <div class="cancelled-banner">
                {{ 'event_regs.cancelled_on'|trans({'%date%': event.cancelledAt|date('d/m/Y H:i')})|raw }}
                {% if event.cancellationReason %}<br>{{ 'event_regs.cancelled_reason'|trans({'%reason%': event.cancellationReason}) }}{% endif %}
            </div>
        {% endif %}

        <div class="reg-stats">
            <div class="reg-stat"><div class="reg-stat__value">{{ seatsTaken }}</div><div class="reg-stat__label">{{ 'event_regs.stat_registered'|trans }}</div></div>
            <div class="reg-stat"><div class="reg-stat__value">{{ waitlistCount }}</div><div class="reg-stat__label">{{ 'event_regs.stat_waitlist'|trans }}</div></div>
            <div class="reg-stat"><div class="reg-stat__value">{{ seatsRemaining is null ? '∞' : seatsRemaining }}</div><div class="reg-stat__label">{{ 'event_regs.stat_seats_left'|trans }}</div></div>
            <div class="reg-stat"><div class="reg-stat__value">{{ checkedInCount }}{% if seatsTaken %} <span class="reg-stat__label">/ {{ seatsTaken }}</span>{% endif %}</div><div class="reg-stat__label">{{ 'event_regs.stat_present'|trans }}</div></div>
        </div>

        {% set regSignals = {'registered': 'go', 'waitlisted': 'caution', 'cancelled': 'stop'} %}
        {% embed 'site/_data_table.html.twig' with {
            pin_actions: true,
            columns: [
                {label: 'event_regs.col_name'|trans, class: 'is-grow'},
                {label: 'event_regs.col_type'|trans, class: 'is-tight'},
                {label: 'event_regs.col_state'|trans, class: 'is-tight'},
                {label: 'event_regs.col_attendance'|trans, class: 'is-tight'},
                {label: 'event_regs.col_registered_on'|trans, class: 'is-tight'},
                {label: '', class: 'is-actions'},
            ],
            rows: registrations,
            empty: 'event_regs.empty'|trans,
        } %}
            {% block rows %}
                {% for reg in registrations %}
                    <tr data-admin-list-filter-row data-admin-list-filter-category="{{ reg.status }}">
                        <td>{% include 'site/_cell_title.html.twig' with {
                            title: reg.displayName,
                            subtitle: reg.contactEmail,
                            media: include('site/_cell_media.html.twig', {initials: reg.displayName, shape: 'circle'}, with_context = false),
                        } only %}</td>
                        <td>{% include 'site/_cell_state.html.twig' with {
                            label: (reg.guest ? 'event_regs.type_guest' : 'event_regs.type_member')|trans,
                            signal: reg.guest ? 'wait' : 'muted',
                        } only %}</td>
                        {# ⚠️ The old pill printed the stored enum verbatim — `registered`,
                           `waitlisted` — English storage vocabulary on a French page. The
                           key is translated and the colour comes from a signal. #}
                        <td>{% include 'site/_cell_state.html.twig' with {
                            label: ('event_regs.status_' ~ reg.status)|trans,
                            signal: regSignals[reg.status]|default('muted'),
                        } only %}</td>
                        <td>{% if reg.checkedIn %}{% include 'site/_cell_state.html.twig' with {
                                label: 'event_regs.present_at'|trans({'%time%': reg.checkedInAt|lab_date('H:i')}),
                                signal: 'go',
                            } only %}{% elseif reg.checkInEligible %}{% include 'site/_cell_empty.html.twig' only %}{% else %}{% include 'site/_cell_empty.html.twig' with {reason: 'event_regs.not_checkable'} only %}{% endif %}</td>
                        <td>{% include 'site/_cell_date.html.twig' with {value: reg.createdAt, convention: 'machine'} only %}</td>
                        <td class="is-actions">
                            {# ⚠️ These WRITE, so they are forms and stay written here:
                               `_cell_actions` deliberately refuses to grow a `method`.
                               `.admin-actions-cell` is the shared wrapper, `.btn-row` was
                               this page's private one. Undo matters as much as check-in —
                               the commonest mistake at a door is tapping the wrong row. #}
                            <div class="admin-actions-cell">
                                {% if reg.checkInEligible %}
                                    <form method="post" action="{{ path('app_admin_event_registrations', {id: event.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_event_calloff_' ~ event.id) }}">
                                        <input type="hidden" name="action" value="{{ reg.checkedIn ? 'undo_checkin' : 'checkin' }}">
                                        <input type="hidden" name="registration" value="{{ reg.id }}">
                                        <button type="submit" class="admin-action{{ reg.checkedIn ? '' : ' is-primary' }}">{{ (reg.checkedIn ? 'event_regs.undo_checkin' : 'event_regs.checkin')|trans }}</button>
                                    </form>
                                    {% if ticketUrls[reg.id]|default(null) %}
                                        <a class="admin-action" target="_blank" rel="noopener" href="{{ ticketUrls[reg.id] }}">{{ 'event_regs.ticket'|trans }}</a>
                                    {% endif %}
                                {% endif %}
                                {% if not reg.cancelled %}
                                    <form method="post" action="{{ path('app_admin_event_registrations', {id: event.id}) }}"
                                          data-controller="confirm" data-action="submit->confirm#ask"
                                          data-confirm-message-value="{{ 'event_regs.confirm_unregister'|trans({'%name%': reg.displayName})|e('html_attr') }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_event_calloff_' ~ event.id) }}">
                                        <input type="hidden" name="action" value="unregister">
                                        <input type="hidden" name="registration" value="{{ reg.id }}">
                                        <button type="submit" class="admin-action is-danger">{{ 'event_regs.unregister'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
    {% block panel_extra %}
        {% if not event.cancelled %}
            <div class="calloff">
                <h2>{{ 'event_regs.calloff_heading'|trans }}</h2>
                <p>{{ 'event_regs.calloff_help'|trans }}</p>
                <form method="post" action="{{ path('app_admin_event_registrations', {id: event.id}) }}"
                      data-controller="confirm" data-action="submit->confirm#ask"
                      data-confirm-message-value="{{ 'event_regs.confirm_calloff'|trans|e('html_attr') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_event_calloff_' ~ event.id) }}">
                    <label for="reason">{{ 'event_regs.calloff_reason'|trans }}</label>
                    <input type="text" name="reason" id="reason" maxlength="500" placeholder="{{ 'event_regs.calloff_placeholder'|trans }}">
                    <button type="submit" class="btn-link btn-danger-admin">{{ 'event_regs.calloff_submit'|trans }}</button>
                </form>
            </div>
        {% endif %}
    {% endblock %}
{% endembed %}
{% endblock %}
