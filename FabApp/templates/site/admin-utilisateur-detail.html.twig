{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_user_detail.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260811-s130b-one-nav' }}">
    <style>
        .admin-user-page { min-height: 100vh; background: #f6f7fb; color: #1f2937; font-family: Arial, sans-serif; }
        .admin-user-header h1 { margin: 0 0 6px; font-size: 30px; }
        .admin-user-header p { margin: 0; }
        .admin-user-nav, .admin-user-panel { background: var(--theme-surface); border: 1px solid var(--border-color); border-radius: 8px; }
        .admin-user-nav { padding: 16px; align-self: start; }
        .admin-user-nav h3 { margin: 0 0 12px; font-size: 16px; }
        .admin-user-nav a { display: block; padding: 10px 12px; border-radius: 6px; color: var(--color-text); text-decoration: none; }
        .admin-user-nav a.active { background: #eef2ff; color: #3730a3; font-weight: 700; }
        .admin-user-content { display: grid; gap: 20px; }
        .admin-user-panel { overflow: hidden; }
        .admin-user-panel-header { display: flex; justify-content: space-between; gap: 16px; padding: 18px 20px; border-bottom: 1px solid var(--border-color); }
        .admin-user-panel-header h2 { margin: 0; font-size: 20px; }
        .admin-user-count { color: var(--color-text-light); white-space: nowrap; }
        .admin-user-grid { display: grid; grid-template-columns: repeat(2, minmax(220px, 1fr)); gap: 12px; padding: 20px; }
        /* 🔴 These four values were literal hexes — a white card (#f9fafb) with
           near-black text (#111827), which in dark mode is a glaring white box
           nobody can read. Found by looking at the page, not by grepping it.
           Tokens follow the theme; `--theme-surface-elevated` is the same ground
           `_admin_meta_grid` uses for exactly this shape. */
        .admin-user-field { border: 1px solid var(--border-color); border-radius: 6px; padding: 12px; background: var(--theme-surface-elevated); }
        .admin-user-label { display: block; color: var(--color-text-light); font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 6px; }
        .admin-user-value { font-size: 15px; color: var(--color-text); overflow-wrap: anywhere; }
        .badge-yes, .badge-no { display: inline-block; min-width: 42px; padding: 3px 8px; border-radius: 999px; text-align: center; font-weight: 700; }
        .badge-yes { background: color-mix(in srgb, var(--color-ok) 15%, var(--theme-surface)); color: var(--color-ok); }
        .badge-no { background: color-mix(in srgb, var(--color-stop, #b91c1c) 15%, var(--theme-surface)); color: var(--color-stop, #b91c1c); }
        .color-chip { display: inline-flex; align-items: center; gap: 6px; }
        .color-dot { width: 14px; height: 14px; border: 1px solid var(--border-color); border-radius: 50%; }
        .back-link { color: #3730a3; font-weight: 700; text-decoration: none; }
        @media (max-width: 900px) {.admin-user-layout { grid-template-columns: 1fr; padding: 16px; } .admin-user-header { padding: 20px 16px; } .admin-user-grid { grid-template-columns: 1fr; }}
    
        .physical-validation-list { display: grid; gap: 12px; padding: 20px; }
        .physical-validation-row { display: grid; grid-template-columns: minmax(220px, 1fr) auto auto; align-items: center; gap: 16px; padding: 14px 16px; border: 1px solid var(--border-color); border-radius: 10px; background: #fafafa; }
        .physical-validation-row h3 { margin: 0 0 5px; font-size: 15px; }
        .physical-validation-row p { margin: 0; color: var(--color-text-light); font-size: 13px; }
        .physical-validation-status { display: inline-flex; padding: 6px 10px; border-radius: 999px; font-size: 12px; font-weight: 800; background: color-mix(in srgb, var(--color-warn) 15%, var(--theme-surface)); color: var(--color-warn); }
        .physical-validation-status.done { background: color-mix(in srgb, var(--color-ok) 15%, var(--theme-surface)); color: var(--color-ok); }
        .physical-validation-action { border: 0; border-radius: 8px; padding: 9px 13px; background: #9e1b56; color: #fff; font-weight: 700; cursor: pointer; }
        .physical-validation-action:disabled { opacity: .55; cursor: default; }
        @media (max-width: 800px) { .physical-validation-row { grid-template-columns: 1fr; align-items: start; } }
</style>
{% endblock %}

{% block body %}
    {% include 'site/_header.html.twig' %}
    <main class="admin-user-page">
        <header class="admin-user-header">
            <h1>{{ user.displayName }}</h1>
            {# Was "Consultation lecture seule", which the page contradicts three
                sections later with a person-type form and a physical-validation
                button. The subtitle now says what the page is. #}
            <p>{{ 'admin_user_detail.subtitle'|trans({'%id%': user.id}) }}</p>
        </header>

        <div class="admin-user-layout">
            {% include 'site/_admin_sidebar.html.twig' with {admin_sidebar_variant: 'user'} %}

            <div class="admin-user-content">
                <section class="admin-user-panel">
                    <div class="admin-user-panel-header">
                        <h2>{{ 'admin_user_detail.info_heading'|trans }}</h2>
                        <a class="back-link" href="{{ path('app_admin_users') }}">{{ 'admin_user_detail.back_to_list'|trans }}</a>
                    </div>
                    <div class="admin-user-grid">
                        <div class="admin-user-field"><span class="admin-user-label">ID</span><span class="admin-user-value">#{{ user.id }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_email'|trans }}</span><span class="admin-user-value">{{ user.email }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_username'|trans }}</span><span class="admin-user-value">{{ user.username }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_first_name'|trans }}</span><span class="admin-user-value">{{ user.firstName ?? '-' }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_last_name'|trans }}</span><span class="admin-user-value">{{ user.lastName ?? '-' }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_id_number'|trans }}</span><span class="admin-user-value">{{ user.numeroId ?? '-' }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_status'|trans }}</span><span class="admin-user-value">{{ user.statusKey|trans }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_rfid_uid'|trans }}</span><span class="admin-user-value">{{ user.identifiantRfid ?? '-' }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_total_time'|trans }}</span><span class="admin-user-value">{{ user.tempsPresenceTotal }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_verified'|trans }}</span><span class="admin-user-value">{{ (user.verified ? 'common.yes' : 'common.no')|trans }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_created'|trans }}</span><span class="admin-user-value">{{ user.createdAt|lab_date('d/m/Y H:i:s') }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_last_login'|trans }}</span><span class="admin-user-value">{{ user.derniereConnexion ? user.derniereConnexion|lab_date('d/m/Y H:i:s') : '-' }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_notify_email'|trans }}</span><span class="admin-user-value">{{ (user.notificationEmail ? 'common.yes' : 'common.no')|trans }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_notify_push'|trans }}</span><span class="admin-user-value">{{ (user.notificationPush ? 'common.yes' : 'common.no')|trans }}</span></div>
                        {# Reminder opt-outs are the person's own now (profile → préférences),
                           so there is nothing meaningful to show an admin here. #}
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_theme'|trans }}</span><span class="admin-user-value">{{ user.theme }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_language'|trans }}</span><span class="admin-user-value">{{ user.langue }}</span></div>
                    </div>
                </section>

                {% include 'site/_usage_rights_summary.html.twig' with {
                    overview: usageRightsSummary,
                    title: 'usage_rights.profile_section'|trans,
                    description: 'usage_rights.summary_hint'|trans,
                    id_prefix: 'admin-member-usage-rights',
                } only %}

                <section class="admin-user-panel">
                    <div class="admin-user-panel-header">
                        <h2>{{ 'admin_user_detail.person_type_heading'|trans }}</h2>
                    </div>
                    <div style="padding: 18px 20px;">
                        <p style="color: var(--color-text-light); margin: 0 0 12px;">{{ 'admin_user_detail.person_type_help'|trans }}</p>
                        <form method="post" action="{{ path('app_admin_user_person_type', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('person_type_' ~ user.id) }}">
                            <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; margin-bottom: 8px;">
                                <input type="checkbox" name="is_staff" value="1" {{ user.staff ? 'checked' : '' }}> {{ 'admin_user_detail.is_staff'|trans }}
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; margin-bottom: 12px;">
                                <input type="checkbox" name="is_trainer" value="1" {{ user.trainer ? 'checked' : '' }}> {{ 'admin_user_detail.is_trainer'|trans }}
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; margin-bottom: 6px;">
                                <input type="checkbox" name="is_bookable" value="1" {{ user.bookable ? 'checked' : '' }}> {{ 'admin_user_detail.is_bookable'|trans }}
                            </label>
                            <p style="color: var(--color-text-light); margin: 0 0 12px; font-size: 13px;">{{ 'admin_user_detail.is_bookable_help'|trans }}</p>
                            <button type="submit" class="btn-primary">{{ 'common.save'|trans }}</button>
                        </form>
                    </div>
                </section>

                <section class="admin-user-panel">
                    <div class="admin-user-panel-header">
                        <h2>{{ 'admin_user_detail.physical_heading'|trans }}</h2>
                        <span class="admin-user-count">{{ 'admin_user_detail.count_trainings'|trans({'%count%': physicalTrainingRows|length}) }}</span>
                    </div>
                    <div class="physical-validation-list">
                        {% for row in physicalTrainingRows %}
                            {% set formation = row.formation %}
                            {% set status = row.status %}
                            <div class="physical-validation-row">
                                <div>
                                    <h3>{{ formation.titre }}</h3>
                                    <p>{{ 'admin_user_detail.physical_progress'|trans({'%percent%': status.overallPercent, '%threshold%': 80}) }}</p>
                                </div>
                                <span class="physical-validation-status {{ status.physicalCompleted ? 'done' : '' }}">
                                    {{ (status.physicalCompleted ? 'admin_user_detail.physical_done' : 'admin_user_detail.physical_required')|trans }}
                                </span>
                                {% if status.physicalCompleted %}
                                    <button type="button" class="physical-validation-action" disabled>{{ 'admin_user_detail.physical_already'|trans }}</button>
                                {% else %}
                                    <form method="post" action="{{ path('app_admin_validate_physical_training', {userId: user.id, formationId: formation.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('validate_physical_training_' ~ user.id ~ '_' ~ formation.id) }}">
                                        <button type="submit" class="physical-validation-action">{{ 'admin_user_detail.physical_validate'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        {% else %}
                            <p style="padding:20px; margin:0; color:#6b7280;">{{ 'admin_user_detail.physical_empty'|trans }}</p>
                        {% endfor %}
                    </div>
                </section>

                <section class="admin-user-panel">
                    <div class="admin-user-panel-header">
                        <h2>{{ 'admin_user_detail.rfid_heading'|trans }}</h2>
                        <span class="admin-user-count">{{ 'admin_user_detail.count_logs'|trans({'%count%': rfidLogs|length}) }}</span>
                    </div>
                        {% embed 'site/_data_table.html.twig' with {
                            columns: [
                                {label: 'admin_user_detail.col_date'|trans},
                                {label: 'admin_user_detail.col_badge_uid'|trans},
                                {label: 'admin_user_detail.col_machine'|trans},
                                {label: 'admin_user_detail.col_authorized'|trans},
                                {label: 'admin_user_detail.col_status'|trans},
                                {label: 'admin_user_detail.col_reason'|trans},
                                {label: 'admin_user_detail.col_message'|trans},
                                {label: 'admin_user_detail.col_colour'|trans},
                            ],
                            rows: rfidLogs,
                            empty: 'admin_user_detail.rfid_empty'|trans,
                        } %}
                            {% block rows %}
{% for log in rfidLogs %}
                                {% set machine = log.machine %}
                                <tr>
                                    <td>{{ log.createdAt|lab_date('d/m/Y H:i:s') }}</td>
                                    <td>{{ log.badgeUid }}</td>
                                    <td>{% if machine %}{{ machine.nom }} (#{{ machine.id }}){% else %}-{% endif %}</td>
                                    <td><span class="{{ log.authorized ? 'badge-yes' : 'badge-no' }}">{{ (log.authorized ? 'common.yes' : 'common.no')|trans }}</span></td>
                                    <td>{{ log.status }}</td>
                                    <td>{{ log.reason ?? '-' }}</td>
                                    <td>{{ log.message ?? '-' }}</td>
                                    <td>{% if log.color %}<span class="color-chip"><span class="color-dot" style="background: {{ log.color }}"></span>{{ log.color }}</span>{% else %}-{% endif %}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="8">{{ 'admin_user_detail.rfid_empty'|trans }}</td></tr>
                            {% endfor %}
                            {% endblock %}
                        {% endembed %}
                </section>

                <section class="admin-user-panel">
                    <div class="admin-user-panel-header">
                        <h2>{{ 'admin_user_detail.progress_heading'|trans }}</h2>
                        <span class="admin-user-count">{{ 'admin_user_detail.count_progress'|trans({'%count%': progressions|length}) }}</span>
                    </div>
                        {% embed 'site/_data_table.html.twig' with {
                            columns: [
                                {label: 'admin_user_detail.col_training'|trans},
                                {label: 'admin_user_detail.col_score'|trans},
                                {label: 'admin_user_detail.col_completed'|trans},
                                {label: 'admin_user_detail.col_start'|trans},
                                {label: 'admin_user_detail.col_end'|trans},
                            ],
                            rows: progressions,
                            empty: 'admin_user_detail.progress_empty'|trans,
                        } %}
                            {% block rows %}
{% for progression in progressions %}
                                {% set formation = progression.formation %}
                                <tr>
                                    <td>{% if formation %}{{ formation.titre }} (#{{ formation.id }}){% else %}-{% endif %}</td>
                                    <td>{{ progression.score }}</td>
                                    <td><span class="{{ progression.completed ? 'badge-yes' : 'badge-no' }}">{{ (progression.completed ? 'common.yes' : 'common.no')|trans }}</span></td>
                                    <td>{{ progression.dateDebut|lab_date('d/m/Y H:i:s') }}</td>
                                    <td>{{ progression.dateEnd ? progression.dateEnd|lab_date('d/m/Y H:i:s') : '-' }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5">{{ 'admin_user_detail.progress_empty'|trans }}</td></tr>
                            {% endfor %}
                            {% endblock %}
                        {% endembed %}
                </section>

                <section class="admin-user-panel">
                    <div class="admin-user-panel-header">
                        <h2>{{ 'admin_user_detail.bookings_heading'|trans }}</h2>
                        <span class="admin-user-count">{{ 'admin_user_detail.count_bookings'|trans({'%count%': reservations|length}) }}</span>
                    </div>
                        {% embed 'site/_data_table.html.twig' with {
                            columns: [
                                {label: 'admin_user_detail.col_machine'|trans},
                                {label: 'admin_user_detail.col_start'|trans},
                                {label: 'admin_user_detail.col_end'|trans},
                                {label: 'admin_user_detail.col_reason_booking'|trans},
                            ],
                            rows: reservations,
                            empty: 'admin_user_detail.bookings_empty'|trans,
                        } %}
                            {% block rows %}
{% for reservation in reservations %}
                                {% set res = reservable(reservation) %}
                                <tr>
                                    <td>{% if res.name %}{{ res.name }} (#{{ res.id }}){% if res.type and res.type.value != 'machine' %} ({{ ('reservable.type.' ~ res.type.value)|trans }}){% endif %}{% else %}-{% endif %}</td>
                                    <td>{{ reservation.dateDebut|date('d/m/Y H:i:s') }}</td>
                                    <td>{{ reservation.dateFin|date('d/m/Y H:i:s') }}</td>
                                    <td>{{ reservation.motif ?? '-' }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="4">{{ 'admin_user_detail.bookings_empty'|trans }}</td></tr>
                            {% endfor %}
                            {% endblock %}
                        {% endembed %}
                </section>

                <section class="admin-user-panel">
                    <div class="admin-user-panel-header">
                        <h2>{{ 'admin_user_detail.usage_heading'|trans }}</h2>
                        <span class="admin-user-count">{{ 'admin_user_detail.count_logs'|trans({'%count%': usageLogs|length}) }}</span>
                    </div>
                        {% embed 'site/_data_table.html.twig' with {
                            columns: [
                                {label: 'admin_user_detail.col_machine'|trans},
                                {label: 'admin_user_detail.col_start'|trans},
                                {label: 'admin_user_detail.col_end'|trans},
                                {label: 'admin_user_detail.col_duration'|trans},
                                {label: 'admin_user_detail.col_source'|trans},
                            ],
                            rows: usageLogs,
                            empty: 'admin_user_detail.usage_empty'|trans,
                        } %}
                            {% block rows %}
{% for usageLog in usageLogs %}
                                {% set machine = usageLog.machine %}
                                <tr>
                                    <td>{% if machine %}{{ machine.nom }} (#{{ machine.id }}){% else %}-{% endif %}</td>
                                    <td>{{ usageLog.dateDebut|lab_date('d/m/Y H:i:s') }}</td>
                                    <td>{{ usageLog.dateFin ? usageLog.dateFin|lab_date('d/m/Y H:i:s') : '-' }}</td>
                                    <td>{{ usageLog.duree ?? '-' }}</td>
                                    <td>{{ usageLog.source ?? '-' }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5">{{ 'admin_user_detail.usage_empty'|trans }}</td></tr>
                            {% endfor %}
                            {% endblock %}
                        {% endembed %}
                </section>
            </div>
        </div>
    </main>
{% endblock %}
