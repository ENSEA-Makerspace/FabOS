{% extends 'base.html.twig' %}

{% block title %}{{ 'admin_user_detail.browser_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260823-s148j22' }}">
    {# ⚠️ **S147, J-22 — this page's rules moved to `admin.css`.** They were
       already tokenised and already commented; what was wrong was only that they
       lived here, so nothing else could use them and the next screen with a
       labelled field grid would have written a third copy. The notes that used to
       sit between them moved with them.
       🅿️ **Left for a later pass, deliberately:** `.admin-user-grid` /
       `-field` / `-label` / `-value` is the same shape `_admin_meta_grid` already
       draws. Reusing that partial is the right end state and it is a template
       change, not a stylesheet one — worth doing on its own, with the page in
       front of you. #}
{% endblock %}

{% block body %}
{# ⚠️ **S141f — the SIXTH admin skeleton, and the last one.** This page had a
   whole private shell: `.admin-user-page` (with a literal `#f6f7fb` background,
   a literal `#1f2937` text colour and `font-family: Arial` — a light page that
   stayed light in dark mode), `.admin-user-header`, `.admin-user-layout`,
   `.admin-user-nav`, `.admin-user-content` and `.admin-user-panel` with its own
   header row. All of it is the list shell's job, and all of it is gone.

   ⚠️ **`page_title`, one of the overrides.** The menu names this route
   "Utilisateurs", which is the list this page hangs off; what an operator needs
   at the top of a person's file is the person. The count line becomes the
   subtitle the page already had.

   ⚠️ **`sidebar_variant: 'user'` went too**, for the same reason `'rfid'` did in
   S141a: `.admin-user-nav` had `align-self: start` and a background and no rule
   at all for its links, so the section list rendered as inline text wrapping
   across the column. #}
{% embed 'site/_admin_list.html.twig' with {
    page_title: user.displayName,
    panel_title: 'admin_user_detail.info_heading'|trans,
    panel_note: 'admin_user_detail.subtitle'|trans({'%id%': user.id}),
} %}
    {% block content %}
        {# ⚠️ The "back to the list" link that used to sit in this page's private
           panel header comes back as the shared breadcrumb (S139e), not as a
           `.back-link` of its own — the shell has no panel header to hang it on,
           and a trail says where you are as well as where you came from. #}
        {% include 'site/_breadcrumb.html.twig' with {trail: [
            {label: 'admin_nav.entry.app_admin_users'|trans, url: path('app_admin_users')},
            {label: user.displayName},
        ]} only %}
<h2>{{ 'admin_user_detail.info_heading'|trans }}</h2>
                    <div class="admin-user-grid">
                        <div class="admin-user-field"><span class="admin-user-label">ID</span><span class="admin-user-value">#{{ user.id }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_email'|trans }}</span><span class="admin-user-value">{{ user.email }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_username'|trans }}</span><span class="admin-user-value">{{ user.username }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_first_name'|trans }}</span><span class="admin-user-value">{{ user.firstName ?? '-' }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_last_name'|trans }}</span><span class="admin-user-value">{{ user.lastName ?? '-' }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_id_number'|trans }}</span><span class="admin-user-value">{{ user.numeroId ?? '-' }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_status'|trans }}</span><span class="admin-user-value">{{ user.statusKey|trans }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_rfid_uid'|trans }}</span><span class="admin-user-value">{{ user.identifiantRfid ?? '-' }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_total_time'|trans }}</span><span class="admin-user-value">{{ user.tempsPresenceTotal }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_verified'|trans }}</span><span class="admin-user-value">{{ (user.verified ? 'common.yes' : 'common.no')|trans }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_created'|trans }}</span><span class="admin-user-value">{{ user.createdAt|lab_date('d/m/Y H:i:s') }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_last_login'|trans }}</span><span class="admin-user-value">{{ user.derniereConnexion ? user.derniereConnexion|lab_date('d/m/Y H:i:s') : '-' }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_notify_email'|trans }}</span><span class="admin-user-value">{{ (user.notificationEmail ? 'common.yes' : 'common.no')|trans }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_notify_push'|trans }}</span><span class="admin-user-value">{{ (user.notificationPush ? 'common.yes' : 'common.no')|trans }}</span></div>
                        {# Reminder opt-outs are the person's own now (profile → préférences),
                           so there is nothing meaningful to show an admin here. #}
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_theme'|trans }}</span><span class="admin-user-value">{{ user.theme }}</span></div>
                        <div class="admin-user-field"><span class="admin-user-label">{{ 'admin_user_detail.field_language'|trans }}</span><span class="admin-user-value">{{ user.langue }}</span></div>
                    </div>

                {% include 'site/_usage_rights_summary.html.twig' with {
                    overview: usageRightsSummary,
                    title: 'usage_rights.profile_section'|trans,
                    description: 'usage_rights.summary_hint'|trans,
                    id_prefix: 'admin-member-usage-rights',
                    allowances: usageBudgets,
                } only %}

<h2>{{ 'admin_user_detail.person_type_heading'|trans }}</h2>
                    <div class="admin-panel-pad">
                        <p class="admin-panel-help">{{ 'admin_user_detail.person_type_help'|trans }}</p>
                        {{ form_start(personTypeForm, {action: path('app_admin_user_person_type', {id: user.id})}) }}
                            {% form_theme personTypeForm 'form/admin_theme.html.twig' %}
                            {{ form_row(personTypeForm.is_staff) }}
                            {{ form_row(personTypeForm.is_trainer) }}
                            {{ form_row(personTypeForm.is_bookable) }}
                            <button type="submit" class="btn-primary">{{ 'common.save'|trans }}</button>
                        {{ form_end(personTypeForm) }}
                    </div>

                {# ⚠️ Last panel on the page, on purpose. It is the only control here
                   that cannot be undone, and it should not sit next to the checkboxes
                   people come to this page to toggle.

                   ⚠️ The refusal is SHOWN, not hidden. A missing button teaches
                   nobody why; "you would be erasing the last administrator" does.
                   See [[feedback-fabos-dead-affordances]] — a disabled control that
                   never explains itself is the same fault in another costume. #}
<h2>{{ 'account_delete.admin_action'|trans }}</h2>
                    <div class="admin-panel-pad">
                        <p class="admin-panel-help">{{ 'account_delete.erased_list'|trans }}</p>
                        <p class="admin-panel-help">{{ 'account_delete.kept_list'|trans }}</p>

                        {% if anonymiseRefusal %}
                            {% include 'site/_cell_state.html.twig' with {
                                label: ('account_delete.refused_' ~ (anonymiseRefusal == 'last_admin' ? 'last_admin' : 'already'))|trans,
                                signal: 'stop',
                            } only %}
                        {% else %}
                            <form method="post" action="{{ path('app_admin_user_anonymise', {id: user.id}) }}"
                                  data-controller="confirm" data-confirm-message-value="{{ 'account_delete.admin_confirm'|trans|e('html_attr') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('anonymise_' ~ user.id) }}">
                                <button type="submit" class="btn btn-danger">{{ 'account_delete.admin_action'|trans }}</button>
                            </form>
                        {% endif %}
                    </div>

<h2>{{ 'admin_user_detail.physical_heading'|trans }} <span class="admin-user-count">{{ 'admin_user_detail.count_trainings'|trans({'count': physicalTrainingRows|length}) }}</span></h2>
                    <div class="physical-validation-list">
                        {% for row in physicalTrainingRows %}
                            {% set formation = row.formation %}
                            {% set status = row.status %}
                            <div class="physical-validation-row">
                                <div>
                                    <h3>{{ formation.titre }}</h3>
                                    <p>{{ 'admin_user_detail.physical_progress'|trans({'%percent%': status.overallPercent, '%threshold%': 80}) }}</p>
                                </div>
                                {% include 'site/_cell_state.html.twig' with {
                                    label: (status.physicalCompleted ? 'admin_user_detail.physical_done' : 'admin_user_detail.physical_required')|trans,
                                    signal: status.physicalCompleted ? 'go' : 'caution',
                                } only %}
                                {% if status.physicalCompleted %}
                                    <button type="button" class="physical-validation-action" disabled>{{ 'admin_user_detail.physical_already'|trans }}</button>
                                {% else %}
                                    <form method="post" action="{{ path('app_admin_validate_physical_training', {userId: user.id, formationId: formation.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('validate_physical_training_' ~ user.id ~ '_' ~ formation.id) }}">
                                        <button type="submit" class="physical-validation-action">{{ 'admin_user_detail.physical_validate'|trans }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        {% else %}
                            <p class="admin-panel-empty">{{ 'admin_user_detail.physical_empty'|trans }}</p>
                        {% endfor %}
                    </div>

<h2>{{ 'admin_user_detail.rfid_heading'|trans }} <span class="admin-user-count">{{ 'admin_user_detail.count_logs'|trans({'count': rfidLogs|length}) }}</span></h2>
                        {% embed 'site/_data_table.html.twig' with {
                            columns: [
                                {label: 'admin_user_detail.col_date'|trans},
                                {label: 'admin_user_detail.col_badge_uid'|trans, class: 'is-grow'},
                                {label: 'rfid_logs.col_result'|trans, class: 'is-tight'},
                            ],
                            rows: rfidLogs,
                            empty: 'admin_user_detail.rfid_empty'|trans,
                        } %}
                            {% block rows %}
{% for log in rfidLogs %}
                                {% set machine = log.machine %}
                                <tr>
                                    <td>{% include 'site/_cell_date.html.twig' with {value: log.createdAt, convention: 'machine', format: 'd/m/Y H:i:s'} only %}</td>
                                    <td>{% include 'site/_cell_title.html.twig' with {
                                        title: log.badgeUid,
                                        subtitle: machine ? machine.nom : '',
                                    } only %}</td>
                                    {# 🔴 **Five headers over four cells, the third instance of
                                       this fault in S141.** `col_machine` had no cell of its own — the
                                       machine is the badge cell's subtitle — so the yes/no chip
                                       sat under "Machine" and the status under "Autorisé". The
                                       two result columns then collapse into one, exactly as on
                                       `/admin/access-rfid-logs`, and both read the shared
                                       vocabulary instead of printing `REQUIRED_BADGE_MISSING`
                                       twice. #}
                                    <td>{% include 'site/_rfid_result.html.twig' with {
                                        status: log.status, authorized: log.authorized, color: log.color,
                                    } only %}</td>
                                </tr>
                            {% endfor %}
                            {% endblock %}
                        {% endembed %}

<h2>{{ 'admin_user_detail.progress_heading'|trans }} <span class="admin-user-count">{{ 'admin_user_detail.count_progress'|trans({'count': progressions|length}) }}</span></h2>
                        {% embed 'site/_data_table.html.twig' with {
                            columns: [
                                {label: 'admin_user_detail.col_training'|trans},
                                {label: 'admin_user_detail.col_score'|trans},
                                {label: 'admin_user_detail.col_completed'|trans},
                                {label: 'admin_user_detail.col_start'|trans},
                                {label: 'admin_user_detail.col_end'|trans},
                            ],
                            rows: progressions,
                            empty: 'admin_user_detail.progress_empty'|trans,
                        } %}
                            {% block rows %}
{% for progression in progressions %}
                                {% set formation = progression.formation %}
                                <tr>
                                    <td>{% include 'site/_cell_title.html.twig' with {
                                        title: formation ? formation.titre : '',
                                        href: formation ? path('app_admin_formation_edit', {id: formation.id}) : '',
                                    } only %}</td>
                                    <td class="is-numeric">{{ progression.score }}</td>
                                    <td>{% include 'site/_cell_state.html.twig' with {
                                        label: (progression.completed ? 'common.yes' : 'common.no')|trans,
                                        signal: progression.completed ? 'go' : 'wait',
                                    } only %}</td>
                                    <td>{% include 'site/_cell_date.html.twig' with {value: progression.dateDebut, convention: 'machine'} only %}</td>
                                    <td>{% include 'site/_cell_date.html.twig' with {value: progression.dateEnd, convention: 'machine'} only %}</td>
                                </tr>
                            {% endfor %}
                            {% endblock %}
                        {% endembed %}

<h2>{{ 'admin_user_detail.bookings_heading'|trans }} <span class="admin-user-count">{{ 'admin_user_detail.count_bookings'|trans({'count': reservations|length}) }}</span></h2>
                        {% embed 'site/_data_table.html.twig' with {
                            columns: [
                                {label: 'admin_user_detail.col_machine'|trans},
                                {label: 'admin_user_detail.col_start'|trans},
                                {label: 'admin_user_detail.col_end'|trans},
                                {label: 'admin_user_detail.col_reason_booking'|trans},
                            ],
                            rows: reservations,
                            empty: 'admin_user_detail.bookings_empty'|trans,
                        } %}
                            {% block rows %}
{% for reservation in reservations %}
                                {% set res = reservable(reservation) %}
                                <tr>
                                    <td>{% if res.name %}{{ res.name }} (#{{ res.id }}){% if res.type and res.type.value != 'machine' %} ({{ ('reservable.type.' ~ res.type.value)|trans }}){% endif %}{% else %}-{% endif %}</td>
                                    <td>{{ reservation.dateDebut|date('d/m/Y H:i:s') }}</td>
                                    <td>{{ reservation.dateFin|date('d/m/Y H:i:s') }}</td>
                                    <td>{{ reservation.motif ?? '-' }}</td>
                                </tr>
                            {% endfor %}
                            {% endblock %}
                        {% endembed %}

<h2>{{ 'admin_user_detail.usage_heading'|trans }} <span class="admin-user-count">{{ 'admin_user_detail.count_logs'|trans({'count': usageLogs|length}) }}</span></h2>
                        {% embed 'site/_data_table.html.twig' with {
                            columns: [
                                {label: 'admin_user_detail.col_machine'|trans},
                                {label: 'admin_user_detail.col_start'|trans},
                                {label: 'admin_user_detail.col_end'|trans},
                                {label: 'admin_user_detail.col_duration'|trans},
                                {label: 'admin_user_detail.col_source'|trans},
                            ],
                            rows: usageLogs,
                            empty: 'admin_user_detail.usage_empty'|trans,
                        } %}
                            {% block rows %}
{% for usageLog in usageLogs %}
                                {% set machine = usageLog.machine %}
                                <tr>
                                    <td>{% if machine %}{{ machine.nom }} (#{{ machine.id }}){% else %}-{% endif %}</td>
                                    <td>{{ usageLog.dateDebut|lab_date('d/m/Y H:i:s') }}</td>
                                    <td>{{ usageLog.dateFin ? usageLog.dateFin|lab_date('d/m/Y H:i:s') : '-' }}</td>
                                    <td>{{ usageLog.duree ?? '-' }}</td>
                                    <td>{{ usageLog.source ?? '-' }}</td>
                                </tr>
                            {% endfor %}
                            {% endblock %}
                        {% endembed %}
    {% endblock %}
{% endembed %}
{% endblock %}
