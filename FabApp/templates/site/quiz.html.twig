{% extends 'site/base_public.html.twig' %}

{% block title %}{{ quizData.title }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/quiz.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block body %}

    <main id="main-content" tabindex="-1" class="quiz-page">
        <div class="quiz-page__background" aria-hidden="true"></div>
        <div class="quiz-container">
            <nav class="quiz-breadcrumb" aria-label="{{ 'quiz.breadcrumb_aria'|trans }}">
                <a href="{{ path('app_home') }}">{{ 'nav.home'|trans }}</a>
                <span aria-hidden="true">/</span>
                {% if machine %}
                    <a href="{{ path('app_machines') }}">{{ 'nav.machines'|trans }}</a>
                    <span aria-hidden="true">/</span>
                    <a href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ machine.nom }}</a>
                {% elseif formation %}
                    <a href="{{ path('app_formations') }}">{{ 'nav.trainings'|trans }}</a>
                    <span aria-hidden="true">/</span>
                    <a href="{{ path('app_formation_follow', {id: formation.id}) }}">{{ formation.titre }}</a>
                {% endif %}
                <span aria-hidden="true">/</span>
                <span>{{ 'machine.tab_quiz'|trans }}</span>
            </nav>

            <section class="quiz-hero">
                <div class="quiz-hero__content">
                    <span class="quiz-kicker">{{ quizData.eyebrow }}</span>
                    <h1>{{ quizData.title }}</h1>
                    <p>{{ quizData.subtitle }}</p>
                    <div class="quiz-hero__meta" aria-label="{{ 'quiz.info_aria'|trans }}">
                        <span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                            {{ 'quiz.question_count'|trans({'count': quizData.questionCount}) }}
                        </span>
                        <span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                            {{ 'quiz.duration_approx'|trans({'%n%': quizData.questionCount < 3 ? 3 : quizData.questionCount}) }}
                        </span>
                        <span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6 6 .9-4.5 4.4 1.1 6.2L12 16.5 6.4 19.5l1.1-6.2L3 8.9 9 8z"/></svg>
                            {{ 'quiz.pass_at'|trans({'%score%': quizData.passingScore}) }}
                        </span>
                    </div>
                    {% if quizPersistence.previousScore is not null %}
                        <p class="quiz-previous-result">
                            {{ 'quiz.best_result_label'|trans }} <strong>{{ quizPersistence.previousScore }} %</strong>
                            {% if quizPersistence.previousCompleted %}· {{ 'quiz.js_passed'|trans }}{% endif %}
                        </p>
                    {% elseif quizPersistence.requiresLogin %}
                        <p class="quiz-previous-result">{{ 'quiz.login_hint'|trans }}</p>
                    {% endif %}
                    {% if quizContext.bonus %}
                        <p class="quiz-previous-result">{{ 'quiz.bonus_note'|trans }}</p>
                    {% elseif quizContext.section %}
                        <p class="quiz-previous-result">{{ 'quiz.section_note'|trans }}</p>
                    {% endif %}
                </div>
                <div class="quiz-hero__badge" aria-hidden="true">
                    <div class="quiz-hero__badge-ring"><span>?</span></div>
                    <small>{{ quizContext.bonus ? 'quiz.eyebrow_bonus'|trans : (quizContext.section ? 'quiz.eyebrow_section'|trans : 'quiz.eyebrow_safety'|trans) }}</small>
                </div>
            </section>

            {% if quizData.questionCount == 0 %}
                <section class="quiz-empty-state">
                    <div class="quiz-empty-state__icon" aria-hidden="true">?</div>
                    <h2>{{ 'quiz.no_questions'|trans }}</h2>
                    <p>{{ 'quiz.no_questions_hint'|trans }}</p>
                    {% if formation %}
                        <a class="quiz-button quiz-button--primary" href="{{ path('app_formation_follow', {id: formation.id}) }}">{{ 'quiz.back_tracking'|trans }}</a>
                    {% elseif machine %}
                        <a class="quiz-button quiz-button--primary" href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ 'quiz.back_machine'|trans }}</a>
                    {% endif %}
                </section>
            {% else %}
                <div
                    class="quiz-layout"
                    data-quiz-app
                    data-persistence-enabled="{{ quizPersistence.enabled ? '1' : '0' }}"
                    data-save-url="{{ quizPersistence.enabled and quizPersistence.quizId ? path('app_quiz_result_save', {quizId: quizPersistence.quizId}) : '' }}"
                    data-csrf-token="{{ quizPersistence.enabled and quizPersistence.quizId ? csrf_token('quiz_result_' ~ quizPersistence.quizId) : '' }}"
                    {# 🔴 S182c — la correction SANS enregistrement. Les bonnes réponses ne
                       sont plus dans la page ; un visiteur, ou un quiz qui ne s'enregistre
                       pas, est désormais corrigé par le serveur lui aussi. #}
                    data-check-url="{{ quizPersistence.quizId ? path('app_quiz_check', {quizId: quizPersistence.quizId}) : '' }}"
                    data-check-token="{{ quizPersistence.quizId ? csrf_token('quiz_check_' ~ quizPersistence.quizId) : '' }}"
                >
                    <aside class="quiz-sidebar" aria-label="{{ 'quiz.progress_aria'|trans }}">
                        <div class="quiz-progress-card">
                            <div class="quiz-progress-card__header">
                                <span>{{ 'quiz.your_progress'|trans }}</span>
                                <strong data-progress-percent>0 %</strong>
                            </div>
                            <div class="quiz-progress-track" aria-hidden="true"><span data-progress-bar></span></div>
                            {# ⚠️ `|raw`: the value carries the `data-answered-count` element quiz.js writes
                                into. Keep that hook in every locale. #}
                            <p>{{ 'quiz.answers_of'|trans({'total': quizData.questionCount})|raw }}</p>
                        </div>

                        <div class="quiz-step-list" data-step-list aria-label="{{ 'quiz.questions_aria'|trans }}"></div>

                        <div class="quiz-sidebar__tip">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 22h4M8.5 14.5A6 6 0 1 1 15.5 14.5C14.6 15.2 14 16.2 14 17h-4c0-.8-.6-1.8-1.5-2.5z"/></svg>
                            <div><strong>{{ 'quiz.tip'|trans }}</strong><p>{{ 'quiz.tip_desc'|trans }}</p></div>
                        </div>
                    </aside>

                    <section class="quiz-card" aria-live="polite">
                        <div class="quiz-card__topline">
                            <span data-question-counter>{{ 'quiz.js_question_counter'|trans({'%n%': 1, '%total%': quizData.questionCount}) }}</span>
                            <span class="quiz-question-type" data-question-type>{{ 'quiz.single_choice'|trans }}</span>
                        </div>

                        <div data-question-view>
                            <h2 class="quiz-question" data-question-text></h2>
                            <p class="quiz-instruction" data-question-instruction></p>
                            <div class="quiz-options" data-options></div>
                            <p class="quiz-inline-message" data-inline-message role="status"></p>
                        </div>

                        <div class="quiz-result" data-result hidden>
                            <div class="quiz-result__score" data-result-ring><span data-result-score>0 %</span></div>
                            <span class="quiz-result__eyebrow" data-result-eyebrow>{{ 'quiz.result'|trans }}</span>
                            <h2 data-result-title></h2>
                            <p data-result-message></p>
                            <p class="quiz-save-status" data-save-status role="status"></p>
                            <div class="quiz-result__summary">
                                <div><strong data-correct-count>0</strong><span>{{ 'quiz.correct_answers'|trans }}</span></div>
                                <div><strong data-wrong-count>0</strong><span>{{ 'quiz.to_review'|trans }}</span></div>
                                <div><strong>{{ quizData.passingScore }} %</strong><span>{{ 'quiz.threshold'|trans }}</span></div>
                            </div>
                            {# 🔴 **Les points À REVOIR, pas la solution** — d'après la planche
                               `lms-quiz-result-retry`. Avant, chaque question ratée affichait
                               « Réponse attendue : … » : on échouait une fois, on lisait, on
                               repassait à 100 %. La correction dit maintenant QUOI relire. #}
                            <div class="quiz-review-points" data-review-points-block hidden>
                                <h3>{{ 'quiz.review_points_heading'|trans }}</h3>
                                <ul data-review-points></ul>
                            </div>
                            {# « Voir toutes mes réponses », replié : ce que J'AI répondu, juste ou
                               non — jamais ce qu'il fallait répondre. #}
                            <details class="quiz-review-all">
                                <summary>{{ 'quiz.review_all'|trans }}</summary>
                                <div class="quiz-review" data-review></div>
                            </details>
                        </div>

                        <div class="quiz-card__actions" data-navigation>
                            {# dead-affordance-ok: état INITIAL et correct — on est à la question 1, il n'y a pas de précédente. `public/js/quiz.js:229` le rallume à chaque changement de question (`elements.previous.disabled = state.currentIndex === 0`). Le désactiver au rendu évite un bouton qui semble cliquable avant que le script ne charge. #}
                            <button class="quiz-button quiz-button--ghost" type="button" data-previous disabled>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
                                {{ 'quiz.js_previous'|trans }}
                            </button>
                            <button class="quiz-button quiz-button--primary" type="button" data-next>
                                {{ 'quiz.js_next'|trans }}
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                            </button>
                        </div>

                        {# ⚠️ **Deux issues, et leur ordre dépend du verdict** (planche
                           `lms-quiz-result-retry`) : raté ⇒ « Revoir les consignes » en premier,
                           « Repasser le quiz » en second — relire AVANT de retenter ; réussi ⇒
                           « Continuer », seul. Le lien mène au même endroit dans les deux cas ;
                           seul son libellé change, posé par `quiz.js`. #}
                        <div class="quiz-card__actions quiz-card__actions--result" data-result-actions hidden>
                            {% if machine %}
                                <a class="quiz-button quiz-button--primary" data-back-link href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ 'quiz.review_instructions'|trans }}</a>
                            {% elseif formation %}
                                <a class="quiz-button quiz-button--primary" data-back-link href="{{ path('app_formation_follow', {id: formation.id}) }}">{{ 'quiz.review_instructions'|trans }}</a>
                            {% endif %}
                            <button class="quiz-button quiz-button--ghost" type="button" data-restart>{{ 'quiz.retake'|trans }}</button>
                        </div>
                    </section>
                </div>
            {% endif %}
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script id="quiz-data" type="application/json">{{ quizDataJson|raw }}</script>
    {# Every sentence quiz.js writes, translated server-side. See the note at the top
       of `public/js/quiz.js`: the file has no catalogue of its own, so a string added
       there instead of here is French in five languages. #}
    <script id="quiz-i18n" type="application/json">{{ {
        single_choice: 'quiz.single_choice'|trans,
        multiple_choice: 'quiz.multiple_choice'|trans,
        to_review: 'quiz.to_review'|trans,
        js_goto_question: 'quiz.js_goto_question'|trans,
        js_question_counter: 'quiz.js_question_counter'|trans,
        js_multiple_hint: 'quiz.js_multiple_hint'|trans,
        js_single_hint: 'quiz.js_single_hint'|trans,
        js_see_result: 'quiz.js_see_result'|trans,
        js_next: 'quiz.js_next'|trans,
        js_no_answer: 'quiz.js_no_answer'|trans,
        js_saving: 'quiz.js_saving'|trans,
        js_save_failed: 'quiz.js_save_failed'|trans,
        js_saved: 'quiz.js_saved'|trans,
        js_answer_first: 'quiz.js_answer_first'|trans,
        js_select_one: 'quiz.js_select_one'|trans,
        js_passed: 'quiz.js_passed'|trans,
        js_failed: 'quiz.js_failed'|trans,
        js_passed_title: 'quiz.js_passed_title'|trans,
        js_failed_title: 'quiz.js_failed_title'|trans,
        js_passed_message: 'quiz.js_passed_message'|trans,
        js_failed_message: 'quiz.js_failed_message'|trans,
        js_passed_saved_title: 'quiz.js_passed_saved_title'|trans,
        js_failed_saved_title: 'quiz.js_failed_saved_title'|trans,
        js_review_title: 'quiz.js_review_title'|trans,
        js_correct: 'quiz.js_correct'|trans,
        js_your_answer: 'quiz.js_your_answer'|trans,
        js_score_sentence: 'quiz.js_score_sentence'|trans,
        js_all_correct: 'quiz.js_all_correct'|trans,
        js_review_instructions: 'quiz.review_instructions'|trans,
        js_continue: 'quiz.js_continue'|trans,
        js_check_failed: 'quiz.js_check_failed'|trans,
        js_checking: 'quiz.js_checking'|trans,
        js_not_saved: 'quiz.js_not_saved'|trans,
    }|json_encode|raw }}</script>
    <script src="{{ asset('js/main.js') ~ '?v=' ~ js_version }}"></script>
    {% if quizData.questionCount > 0 %}<script src="{{ asset('js/quiz.js') ~ '?v=' ~ js_version }}"></script>{% endif %}
{% endblock %}
