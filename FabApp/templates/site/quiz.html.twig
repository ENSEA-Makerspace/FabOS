<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ quizData.title }} - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/quiz.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand" aria-label="Retour à l'accueil FabOS">
                <div class="logo-ensea">{% include 'site/_logo.html.twig' %}</div>
            </a>
            <nav class="main-navbar" aria-label="Navigation principale">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">{{ 'nav.home'|trans }}</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">{{ 'nav.calendar'|trans }}</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link {{ machine ? 'active' : '' }}">{{ 'nav.machines'|trans }}</a>
                    {% if module_enabled('formations') %}<a href="{{ path('app_formations') }}" class="navbar-link {{ not machine ? 'active' : '' }}">{{ 'nav.trainings'|trans }}</a>{% endif %}
                    {% if module_enabled('leaderboard') %}<a href="{{ path('app_leaderboard') }}" class="navbar-link">{{ 'nav.leaderboard'|trans }}</a>{% endif %}{% if module_enabled('projects') %}<a href="{{ path('app_leaderboard_creations') }}" class="navbar-link">{{ 'nav.projects'|trans }}</a>{% endif %}{% if module_enabled('badges') %}<a href="{{ path('app_badges') }}" class="navbar-link">{{ 'nav.badges'|trans }}</a>{% endif %}
                    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_admin_dashboard') }}" class="navbar-link">{{ 'nav.admin'|trans }}</a>{% endif %}
                </div>
            </nav>
            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header" aria-label="Rechercher">
                    <button class="search-button-header" type="button" aria-label="Rechercher">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    </button>
                </div>
                <div class="header-auth">{% include 'site/_header_auth.html.twig' %}</div>
                <button class="mobile-nav-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
            </div>
        </div>
    </header>

    <main class="quiz-page">
        <div class="quiz-page__background" aria-hidden="true"></div>
        <div class="quiz-container">
            <nav class="quiz-breadcrumb" aria-label="Fil d'Ariane">
                <a href="{{ path('app_home') }}">Accueil</a>
                <span aria-hidden="true">/</span>
                {% if machine %}
                    <a href="{{ path('app_machines') }}">Machines</a>
                    <span aria-hidden="true">/</span>
                    <a href="{{ path('app_machine_detail', {id: machine.id}) }}">{{ machine.nom }}</a>
                {% elseif formation %}
                    <a href="{{ path('app_formations') }}">Formations</a>
                    <span aria-hidden="true">/</span>
                    <a href="{{ path('app_formation_follow', {id: formation.id}) }}">{{ formation.titre }}</a>
                {% endif %}
                <span aria-hidden="true">/</span>
                <span>Quiz</span>
            </nav>

            <section class="quiz-hero">
                <div class="quiz-hero__content">
                    <span class="quiz-kicker">{{ quizData.eyebrow }}</span>
                    <h1>{{ quizData.title }}</h1>
                    <p>{{ quizData.subtitle }}</p>
                    <div class="quiz-hero__meta" aria-label="Informations sur le quiz">
                        <span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                            {{ quizData.questionCount }} question{{ quizData.questionCount > 1 ? 's' : '' }}
                        </span>
                        <span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                            Environ {{ quizData.questionCount < 3 ? 3 : quizData.questionCount }} min
                        </span>
                        <span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6 6 .9-4.5 4.4 1.1 6.2L12 16.5 6.4 19.5l1.1-6.2L3 8.9 9 8z"/></svg>
                            Validation à {{ quizData.passingScore }} %
                        </span>
                    </div>
                    {% if quizPersistence.previousScore is not null %}
                        <p class="quiz-previous-result">
                            Meilleur résultat enregistré : <strong>{{ quizPersistence.previousScore }} %</strong>
                            {% if quizPersistence.previousCompleted %}· Quiz validé{% endif %}
                        </p>
                    {% elseif quizPersistence.requiresLogin %}
                        <p class="quiz-previous-result">Connectez-vous pour enregistrer votre résultat dans votre progression.</p>
                    {% endif %}
                    {% if quizContext.bonus %}
                        <p class="quiz-previous-result">Quiz bonus : le score est enregistré, mais ne compte pas dans la progression obligatoire.</p>
                    {% elseif quizContext.section %}
                        <p class="quiz-previous-result">Mini-quiz de section : sa réussite déverrouille l’étape suivante du parcours.</p>
                    {% endif %}
                </div>
                <div class="quiz-hero__badge" aria-hidden="true">
                    <div class="quiz-hero__badge-ring"><span>?</span></div>
                    <small>{{ quizContext.bonus ? 'Défi bonus' : (quizContext.section ? 'Validation de section' : 'Évaluation sécurité') }}</small>
                </div>
            </section>

            {% if quizData.questionCount == 0 %}
                <section class="quiz-empty-state">
                    <div class="quiz-empty-state__icon" aria-hidden="true">?</div>
                    <h2>Ce quiz ne contient pas encore de questions exploitables</h2>
                    <p>Ajoutez des questions et des choix dans les tables QUIZ, QUESTION et CHOIX, puis rechargez cette page.</p>
                    {% if formation %}
                        <a class="quiz-button quiz-button--primary" href="{{ path('app_formation_follow', {id: formation.id}) }}">Retour au suivi</a>
                    {% elseif machine %}
                        <a class="quiz-button quiz-button--primary" href="{{ path('app_machine_detail', {id: machine.id}) }}">Retour à la machine</a>
                    {% endif %}
                </section>
            {% else %}
                <div
                    class="quiz-layout"
                    data-quiz-app
                    data-persistence-enabled="{{ quizPersistence.enabled ? '1' : '0' }}"
                    data-save-url="{{ quizPersistence.enabled and quizPersistence.quizId ? path('app_quiz_result_save', {quizId: quizPersistence.quizId}) : '' }}"
                    data-csrf-token="{{ quizPersistence.enabled and quizPersistence.quizId ? csrf_token('quiz_result_' ~ quizPersistence.quizId) : '' }}"
                >
                    <aside class="quiz-sidebar" aria-label="Progression du quiz">
                        <div class="quiz-progress-card">
                            <div class="quiz-progress-card__header">
                                <span>Votre progression</span>
                                <strong data-progress-percent>0 %</strong>
                            </div>
                            <div class="quiz-progress-track" aria-hidden="true"><span data-progress-bar></span></div>
                            <p><strong data-answered-count>0</strong> réponse{{ quizData.questionCount > 1 ? 's' : '' }} sur {{ quizData.questionCount }}</p>
                        </div>

                        <div class="quiz-step-list" data-step-list aria-label="Questions"></div>

                        <div class="quiz-sidebar__tip">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 22h4M8.5 14.5A6 6 0 1 1 15.5 14.5C14.6 15.2 14 16.2 14 17h-4c0-.8-.6-1.8-1.5-2.5z"/></svg>
                            <div><strong>Conseil</strong><p>Vous pouvez revenir sur une réponse avant de valider.</p></div>
                        </div>
                    </aside>

                    <section class="quiz-card" aria-live="polite">
                        <div class="quiz-card__topline">
                            <span data-question-counter>Question 1 sur {{ quizData.questionCount }}</span>
                            <span class="quiz-question-type" data-question-type>Choix unique</span>
                        </div>

                        <div data-question-view>
                            <h2 class="quiz-question" data-question-text></h2>
                            <p class="quiz-instruction" data-question-instruction></p>
                            <div class="quiz-options" data-options></div>
                            <p class="quiz-inline-message" data-inline-message role="status"></p>
                        </div>

                        <div class="quiz-result" data-result hidden>
                            <div class="quiz-result__score" data-result-ring><span data-result-score>0 %</span></div>
                            <span class="quiz-result__eyebrow" data-result-eyebrow>Résultat</span>
                            <h2 data-result-title></h2>
                            <p data-result-message></p>
                            <p class="quiz-save-status" data-save-status role="status"></p>
                            <div class="quiz-result__summary">
                                <div><strong data-correct-count>0</strong><span>Bonnes réponses</span></div>
                                <div><strong data-wrong-count>0</strong><span>À revoir</span></div>
                                <div><strong>{{ quizData.passingScore }} %</strong><span>Seuil requis</span></div>
                            </div>
                            <div class="quiz-review" data-review></div>
                        </div>

                        <div class="quiz-card__actions" data-navigation>
                            <button class="quiz-button quiz-button--ghost" type="button" data-previous disabled>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
                                Précédent
                            </button>
                            <button class="quiz-button quiz-button--primary" type="button" data-next>
                                Suivant
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                            </button>
                        </div>

                        <div class="quiz-card__actions quiz-card__actions--result" data-result-actions hidden>
                            <button class="quiz-button quiz-button--ghost" type="button" data-restart>Recommencer</button>
                            {% if machine %}
                                <a class="quiz-button quiz-button--primary" href="{{ path('app_machine_detail', {id: machine.id}) }}">Retour à la machine</a>
                            {% elseif formation %}
                                <a class="quiz-button quiz-button--primary" href="{{ path('app_formation_follow', {id: formation.id}) }}">Retour au suivi</a>
                            {% endif %}
                        </div>
                    </section>
                </div>
            {% endif %}
        </div>
    </main>

    {% include 'site/_footer.html.twig' %}

    <script id="quiz-data" type="application/json">{{ quizDataJson|raw }}</script>
    <script src="{{ asset('js/main.js') ~ '?v=20260709-header-scope' }}"></script>
    {% if quizData.questionCount > 0 %}<script src="{{ asset('js/quiz.js') ~ '?v=20260707-2' }}"></script>{% endif %}
</body>
</html>
