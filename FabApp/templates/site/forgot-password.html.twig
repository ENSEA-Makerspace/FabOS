</svg>
                </div>
            </a>

            <nav class="main-navbar">
                <div class="navbar-container">
                    <a href="{{ path('app_home') }}" class="navbar-link">Accueil</a>
                    <a href="{{ path('app_calendar') }}" class="navbar-link">Calendrier</a>
                    <a href="{{ path('app_machines') }}" class="navbar-link">Machines</a>
                    <a href="{{ path('app_formations') }}" class="navbar-link">Formations</a>
                    <a href="{{ path('app_leaderboard') }}" class="navbar-link">Leaderboard</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="navbar-link">Admin</a>
                    {% endif %}
                </div>
            </nav>

            <div class="header-right">
                <div class="header-search">
                    <input type="text" placeholder="Rechercher..." class="search-input-header">
                    <button class="search-button-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>
                </div>
                
                <div class="header-auth">
                    {% include 'site/_header_auth.html.twig' %}
                </div>

                <button class="mobile-nav-toggle" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <main class="main-content">
        <section class="auth-section">
            <div class="auth-container">
                <div class="auth-card">
                    <div class="auth-header">
                        <div class="auth-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                <path d="M12 12v4"/>
                                <path d="M12 22s-4-4-4-10V5l-4 3 4 3v7c0 6 4 10 4 10z"/>
                            </svg>
                        </div>
                        <h1 class="auth-title">Mot de passe oublié ?</h1>
                        <p class="auth-subtitle">
                            Pas de problème, nous allons vous envoyer un lien de réinitialisation par email.
                        </p>
                    </div>

                    <form class="auth-form" id="forgot-password-form">
                        <div class="form-group">
                            <label for="email" class="form-label">Adresse email ENSEA</label>
                            <input type="email" id="email" name="email" class="form-input" 
                                   placeholder="ex: prenom.nom@ensea.fr" required>
                        </div>

                        <button type="submit" class="btn btn-primary btn-full-width" disabled>
                            Réinitialisation bientôt disponible
                        </button>
                    </form>

                    <div class="auth-links">
                        <p>Vous avez déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a></p>
                        <p>Vous n'avez pas de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
                    </div>

                    <div class="auth-notice">
                        <div class="notice-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="16" x2="12" y2="12"/>
                                <line x1="12" y1="8" x2="12.01" y2="8"/>
                            </svg>
                        </div>
                        <p>La réinitialisation de mot de passe sera activée dans une prochaine étape.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('forgot-password-form');
            
            if (form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    const email = document.getElementById('email').value;
                    
                    if (!email) {
                        alert('Veuillez entrer votre adresse email.');
                        return;
                    }
                    
                    if (!email.includes('@ensea.fr') && !email.includes('@')) {
                        alert('Veuillez entrer une adresse email ENSEA valide.');
                        return;
                    }
                    
                    alert('Un lien de réinitialisation a été envoyé à ' + email + '\n\nVérifiez votre boîte mail (incluant les spams). Le lien expire après 24 heures.');
                    form.reset();
                });
            }
        });
    </script>
    <style>
        /* ===================================================================
           Forgot Password - Styles Spécifiques
           Conforme à la charte graphique FabOS
           =================================================================== */

        /* Section Auth */
        .auth-section {
            padding: var(--spacing-3xl) 0;
            background: var(--color-bg);
            min-height: calc(100vh - 300px);
            display: flex;
            align-items: center;
        }

        .auth-container {
            max-width: 500px;
            margin: 0 auto;
            padding: 0 var(--spacing-lg);
            width: 100%;
        }

        /* Card */
        .auth-card {
            background: var(--color-text-inverse);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-lg);
            padding: var(--spacing-3xl);
            text-align: center;
            border: 1px solid var(--border-color);
        }

        /* Header */
        .auth-header {
            margin-bottom: var(--spacing-2xl);
        }

        .auth-icon {
            margin-bottom: var(--spacing-lg);
        }

        .auth-icon svg {
            width: 80px;
            height: 80px;
            color: var(--color-primary);
        }

        .auth-title {
            font-size: var(--font-size-3xl);
            color: var(--color-text);
            margin-bottom: var(--spacing-sm);
            font-weight: 700;
            line-height: 1.2;
        }

        .auth-subtitle {
            color: var(--color-text-light);
            font-size: var(--font-size-md);
            margin: 0;
            line-height: 1.5;
        }

        /* Form */
        .auth-form {
            margin-bottom: var(--spacing-xl);
            text-align: left;
        }

        .form-group {
            margin-bottom: var(--spacing-xl);
        }

        .form-label {
            display: block;
            margin-bottom: var(--spacing-sm);
            color: var(--color-text);
            font-size: var(--font-size-md);
            font-weight: 600;
        }

        .form-input {
            width: 100%;
            padding: var(--spacing-md) var(--spacing-lg);
            border: 2px solid var(--border-color);
            border-radius: var(--border-radius);
            font-size: var(--font-size-md);
            color: var(--color-text);
            background: var(--color-text-inverse);
            transition: all var(--transition);
            box-sizing: border-box;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px rgba(158, 27, 86, 0.1);
        }

        .form-input::placeholder {
            color: var(--color-text-light);
        }

        /* Buttons */
        .btn-full-width {
            width: 100%;
        }

        /* Links */
        .auth-links {
            margin-bottom: var(--spacing-xl);
            padding-top: var(--spacing-xl);
            border-top: 1px solid var(--border-color);
        }

        .auth-links p {
            margin: var(--spacing-sm) 0;
            color: var(--color-text-light);
            font-size: var(--font-size-sm);
        }

        .auth-links a {
            color: var(--color-primary);
            text-decoration: none;
            font-weight: 600;
        }

        .auth-links a:hover {
            text-decoration: underline;
        }

        /* Notice */
        .auth-notice {
            display: flex;
            align-items: flex-start;
            gap: var(--spacing-md);
            background: rgba(158, 27, 86, 0.05);
            border: 1px solid rgba(158, 27, 86, 0.2);
            border-radius: var(--border-radius);
            padding: var(--spacing-md);
            margin-top: var(--spacing-xl);
        }

        .auth-notice .notice-icon {
            flex-shrink: 0;
            margin-top: 2px;
            color: var(--color-primary);
        }

        .auth-notice .notice-icon svg {
            width: 20px;
            height: 20px;
        }

        .auth-notice p {
            margin: 0;
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
            line-height: 1.5;
        }

        /* ===================================================================
           RESPONSIVE DESIGN
           =================================================================== */

        @media (max-width: 768px) {
            .auth-section {
                padding: var(--spacing-2xl) 0;
            }

            .auth-card {
                padding: var(--spacing-2xl);
            }

            .auth-title {
                font-size: var(--font-size-2xl);
            }

            .auth-icon svg {
                width: 60px;
                height: 60px;
            }

            .form-input {
                padding: var(--spacing-md);
            }
        }

        @media (max-width: 480px) {
            .auth-container {
                padding: 0 var(--spacing-md);
            }

            .auth-card {
                padding: var(--spacing-xl);
            }

            .auth-title {
                font-size: var(--font-size-xl);
            }

            .auth-subtitle {
                font-size: var(--font-size-sm);
            }

            .auth-icon svg {
                width: 50px;
                height: 50px;
            }
        }
    </style>
</body>
</html>
