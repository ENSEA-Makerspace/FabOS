{% extends 'site/base_public.html.twig' %}

{% block title %}{{ 'forgot.title'|trans }} - FabOS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login-register.css') ~ '?v=20260812-s138-grids' }}">
{% endblock %}

{% block body %}

    <main class="main-content">
        <section class="auth-section">
            <div class="auth-container">
                <div class="auth-card">
                    <div class="auth-header">
                        <div class="auth-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                <path d="M12 12v4"/>
                                <path d="M12 22s-4-4-4-10V5l-4 3 4 3v7c0 6 4 10 4 10z"/>
                            </svg>
                        </div>
                        <h1 class="auth-title">{{ 'login.forgot'|trans }}</h1>
                        <p class="auth-subtitle">{{ 'forgot.subtitle'|trans }}</p>
                    </div>

                    {# 🔴 **This page had no form.** It was GET-only, showed a notice, and
                       the login page linked to it — so "Mot de passe oublié ?" led to a
                       screen that could not reset a password. A dead affordance in the
                       one place a locked-out member goes. #}
                    {% for message in app.flashes('success') %}<div class="auth-flash success">{{ message|trans }}</div>{% endfor %}
                    {% for message in app.flashes('error') %}<div class="auth-flash error">{{ message|trans }}</div>{% endfor %}

                    <form class="auth-form" method="post" action="{{ path('app_forgot_password_submit') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">
                        <div class="form-group">
                            <label class="form-label" for="forgot-email">{{ 'login.email'|trans }}</label>
                            <input class="form-input" id="forgot-email" type="email" name="email" required autocomplete="email" autofocus>
                        </div>
                        <button class="btn btn-primary" type="submit">{{ 'forgot.submit'|trans }}</button>
                    </form>

                    <div class="auth-links">
                        <p>{{ 'forgot.have_account'|trans }} <a href="{{ path('app_login') }}">{{ 'login.submit'|trans }}</a></p>
                        <p>{{ 'login.no_account'|trans }} <a href="{{ path('app_register') }}">{{ 'register.title'|trans }}</a></p>
                    </div>

                    <div class="auth-notice">
                        <div class="notice-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="16" x2="12" y2="12"/>
                                <line x1="12" y1="8" x2="12.01" y2="8"/>
                            </svg>
                        </div>
                        <p>{{ 'forgot.notice'|trans }}</p>
                    </div>
                </div>
            </div>
        </section>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=20260811-s134c-i18n' }}"></script>
    <style>
        /* The flash pair, on tokens so both themes reach them. */
        .auth-flash { margin-bottom: var(--spacing-md); padding: 12px 14px; border-radius: 8px; font-size: 14px; }
        .auth-flash.success { background: var(--tone-ok-soft); color: var(--tone-ok-ink); }
        .auth-flash.error { background: var(--tone-stop-soft); color: var(--color-stop); }

        /* ===================================================================
           Forgot Password - Styles Spécifiques
           Conforme à la charte graphique FabOS
           =================================================================== */

        /* Section Auth */
        .auth-section {
            padding: var(--spacing-3xl) 0;
            background: var(--color-bg);
            min-height: calc(100vh - 300px);
            display: flex;
            align-items: center;
        }

        .auth-container {
            max-width: 500px;
            margin: 0 auto;
            padding: 0 var(--spacing-lg);
            width: 100%;
        }

        /* Card */
        .auth-card {
            background: var(--color-text-inverse);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-lg);
            padding: var(--spacing-3xl);
            text-align: center;
            border: 1px solid var(--border-color);
        }

        /* Header */
        .auth-header {
            margin-bottom: var(--spacing-2xl);
        }

        .auth-icon {
            margin-bottom: var(--spacing-lg);
        }

        .auth-icon svg {
            width: 80px;
            height: 80px;
            color: var(--color-primary);
        }

        .auth-title {
            font-size: var(--font-size-3xl);
            color: var(--color-text);
            margin-bottom: var(--spacing-sm);
            font-weight: 700;
            line-height: 1.2;
        }

        .auth-subtitle {
            color: var(--color-text-light);
            font-size: var(--font-size-md);
            margin: 0;
            line-height: 1.5;
        }

        /* Form */
        .auth-form {
            margin-bottom: var(--spacing-xl);
            text-align: left;
        }

        .form-group {
            margin-bottom: var(--spacing-xl);
        }

        .form-label {
            display: block;
            margin-bottom: var(--spacing-sm);
            color: var(--color-text);
            font-size: var(--font-size-md);
            font-weight: 600;
        }

        .form-input {
            width: 100%;
            padding: var(--spacing-md) var(--spacing-lg);
            border: 2px solid var(--border-color);
            border-radius: var(--border-radius);
            font-size: var(--font-size-md);
            color: var(--color-text);
            background: var(--color-text-inverse);
            transition: all var(--transition);
            box-sizing: border-box;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px rgba(158, 27, 86, 0.1);
        }

        .form-input::placeholder {
            color: var(--color-text-light);
        }

        /* Buttons */
        .btn-full-width {
            width: 100%;
        }

        /* Links */
        .auth-links {
            margin-bottom: var(--spacing-xl);
            padding-top: var(--spacing-xl);
            border-top: 1px solid var(--border-color);
        }

        .auth-links p {
            margin: var(--spacing-sm) 0;
            color: var(--color-text-light);
            font-size: var(--font-size-sm);
        }

        .auth-links a {
            color: var(--color-primary);
            text-decoration: none;
            font-weight: 600;
        }

        .auth-links a:hover {
            text-decoration: underline;
        }

        /* Notice */
        .auth-notice {
            display: flex;
            align-items: flex-start;
            gap: var(--spacing-md);
            background: rgba(158, 27, 86, 0.05);
            border: 1px solid rgba(158, 27, 86, 0.2);
            border-radius: var(--border-radius);
            padding: var(--spacing-md);
            margin-top: var(--spacing-xl);
        }

        .auth-notice .notice-icon {
            flex-shrink: 0;
            margin-top: 2px;
            color: var(--color-primary);
        }

        .auth-notice .notice-icon svg {
            width: 20px;
            height: 20px;
        }

        .auth-notice p {
            margin: 0;
            font-size: var(--font-size-sm);
            color: var(--color-text-light);
            line-height: 1.5;
        }

        /* ===================================================================
           RESPONSIVE DESIGN
           =================================================================== */

        @media (max-width: 768px) {
            .auth-section {
                padding: var(--spacing-2xl) 0;
            }

            .auth-card {
                padding: var(--spacing-2xl);
            }

            .auth-title {
                font-size: var(--font-size-2xl);
            }

            .auth-icon svg {
                width: 60px;
                height: 60px;
            }

            .form-input {
                padding: var(--spacing-md);
            }
        }

        @media (max-width: 480px) {
            .auth-container {
                padding: 0 var(--spacing-md);
            }

            .auth-card {
                padding: var(--spacing-xl);
            }

            .auth-title {
                font-size: var(--font-size-xl);
            }

            .auth-subtitle {
                font-size: var(--font-size-sm);
            }

            .auth-icon svg {
                width: 50px;
                height: 50px;
            }
        }
    </style>
{% endblock %}
