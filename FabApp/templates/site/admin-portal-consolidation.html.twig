{% extends 'base.html.twig' %}
{% block title %}Consolidation des portails · FabOS{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') ~ '?v=20260809-s117-workspaces' }}">{% endblock %}
{% block body %}
{% embed 'site/_admin_list.html.twig' with {title: 'Consolidation des portails', description: 'Inventaire S105 en lecture seule. Les portails sont gelés ; aucune donnée n’est supprimée.', panel_title: 'Scopes hérités à consolider'} %}
{% block content %}
<div class="blueprint-notice" role="note"><p>Les portails ne sont plus une cible produit. Ce rapport recense leurs hostnames et les divergences de réglages, fonctionnalités et packages avant toute migration.</p></div>
<div class="workspace-matrix">{% for row in report %}<article class="workspace-row"><header><div><h2>{{ row.portal.name }}</h2><code>scope {{ row.scope }} · {{ row.portal.slug }}</code></div>{% include 'site/_state_chip.html.twig' with {label: row.portal.isDefault ? 'global' : (row.portal.hostname ?: 'sans hostname'), signal: row.portal.isDefault ? 'muted' : 'caution'} only %}</header><dl><div><dt>Réglages locaux</dt><dd>{{ row.settings|length }}</dd></div><div><dt>Fonctionnalités locales</dt><dd>{{ row.features|length }}</dd></div><div><dt>Packages locaux</dt><dd>{{ row.packages|length }}</dd></div><div><dt>Hostname</dt><dd>{{ row.portal.hostname ?: '—' }}</dd></div></dl><details><summary>Divergences</summary><div class="workspace-routes">{% for setting in row.settings %}<div><code>setting</code><span>{{ setting.settingKey }}</span><small>{{ setting.settingValue }}</small></div>{% endfor %}{% for feature in row.features %}<div><code>feature</code><span>{{ feature.moduleKey }}</span><small>{{ feature.enabled ? 'on' : 'off' }}</small></div>{% endfor %}{% for package in row.packages %}<div><code>package</code><span>{{ package.name }}</span><small>#{{ package.id }} · {{ package.active ? 'active' : 'inactive' }} · {{ package.fullAccess ? 'full access' : 'scoped' }}</small></div>{% endfor %}{% if row.settings is empty and row.features is empty and row.packages is empty %}<p class="blueprint-footnote">Aucune divergence stockée.</p>{% endif %}</div></details></article>{% endfor %}</div>
{% endblock %}{% endembed %}{% include 'site/_footer.html.twig' %}{% endblock %}
