<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ machine.nom }} - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=20260709-header-scope' }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=20260709-header-scope' }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    {% include 'site/_header.html.twig' %}

    <main class="main-content">
        <section class="machine-detail-section">
            <div class="container">
                <nav class="breadcrumb">
                    <a href="{{ path('app_home') }}">{{ 'nav.home'|trans }}</a>
                    <span class="breadcrumb-separator">/</span>
                    <a href="{{ path('app_machines') }}">{{ 'nav.machines'|trans }}</a>
                    <span class="breadcrumb-separator">/</span>
                    <span class="breadcrumb-current">{{ machine.nom }}</span>
                </nav>

                {% set category = machine.categorySlug %}
                {% set categoryLabel = machine.categoryLabel %}
                {% set levelLabel = machine.levelLabel %}
                {% set icon = machine.iconSlug %}
                {% set materials = machine.materials %}
                {% set features = machine.features %}
                {% set requirementTitle = machine.requirementTitle %}
                {% set requirementDescription = machine.requirementDescription %}
                {% set popularity = machine.popularity %}
                {% set rawStatus = machine.statut|lower %}
                {% set statusClass = rawStatus in ['maintenance', 'panne'] ? rawStatus : 'disponible' %}
                {% set statusLabel = rawStatus == 'maintenance' ? 'En maintenance' : (rawStatus == 'panne' ? 'En panne' : 'Disponible') %}
                {% set machineAvailable = statusClass == 'disponible' %}
                {% set canReserve = machineAvailable and app.user and authorizationStatus in ['authorized', 'no_badge_required'] %}
                {% set slotDuration = machine.granulariteLabel %}

                <div class="machine-detail-header">
                    <div class="machine-detail-image">
                        <div class="machine-image-placeholder large">
                            {% if icon == 'decoupe' %}
                                <svg viewBox="0 0 200 200" class="machine-icon large" aria-hidden="true"><rect x="32" y="56" width="136" height="88" fill="#9E1B56" rx="12"/><path d="M52 84h96M52 116h96" stroke="#fff" stroke-width="8" stroke-linecap="round"/><path d="M76 42l48 112" stroke="#444" stroke-width="10" stroke-linecap="round"/></svg>
                            {% elseif icon == 'electronique' %}
                                <svg viewBox="0 0 200 200" class="machine-icon large" aria-hidden="true"><rect x="36" y="48" width="128" height="104" fill="#9E1B56" rx="14"/><circle cx="72" cy="100" r="16" fill="#fff"/><circle cx="124" cy="100" r="16" fill="#fff"/><path d="M56 152v24M100 154v22M144 152v24" stroke="#444" stroke-width="10" stroke-linecap="round"/></svg>
                            {% elseif icon == 'usinage' %}
                                <svg viewBox="0 0 200 200" class="machine-icon large" aria-hidden="true"><rect x="36" y="116" width="128" height="36" fill="#444" rx="6"/><rect x="60" y="48" width="80" height="68" fill="#9E1B56" rx="10"/><path d="M100 116v44" stroke="#fff" stroke-width="10"/></svg>
                            {% elseif icon == 'textile' %}
                                <svg viewBox="0 0 200 200" class="machine-icon large" aria-hidden="true"><rect x="36" y="60" width="128" height="76" fill="#9E1B56" rx="16"/><path d="M72 136c16-36 40-36 56 0" stroke="#fff" stroke-width="10" fill="none"/><path d="M100 40v116" stroke="#444" stroke-width="10" stroke-linecap="round"/></svg>
                            {% else %}
                                <svg viewBox="0 0 200 200" class="machine-icon large" aria-hidden="true"><rect x="50" y="60" width="100" height="70" fill="#9E1B56" rx="10"/><rect x="62" y="42" width="76" height="18" fill="#666" rx="3"/><circle cx="100" cy="154" r="15" fill="#444"/></svg>
                            {% endif %}
                        </div>
                        <div class="machine-status-badge large {{ statusClass }}">{{ statusLabel }}</div>
                    </div>
                    <div class="machine-detail-info">
                        <div class="machine-detail-badge">{{ categoryLabel }} · {{ levelLabel }}</div>
                        <h1 class="machine-detail-title">{{ machine.nom }}</h1>
                        <p class="machine-detail-location">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            {{ machine.localisation ?? 'Localisation non renseignée' }}
                        </p>
                        <div class="machine-detail-meta">
                            <div class="meta-item">Créneaux {{ slotDuration }}</div>
                            <div class="meta-item">{{ machine.limiteReservations }} réservation{{ machine.limiteReservations > 1 ? 's' : '' }} simultanée{{ machine.limiteReservations > 1 ? 's' : '' }}</div>
                            <div class="meta-item">Popularité {% for i in 1..5 %}{{ i <= popularity ? '★' : '☆' }}{% endfor %}</div>
                        </div>
                        <div class="machine-detail-actions">
                            {% if canReserve %}
                                <a class="btn btn-primary" href="{{ path('app_machine_calendar', {id: machine.id}) }}">{{ 'machine.reserve'|trans }}</a>
                            {% elseif not app.user %}
                                <a class="btn btn-primary" href="{{ path('app_login') }}">{{ 'machine.login_to_reserve'|trans }}</a>
                            {% elseif authorizationStatus == 'missing_badge' %}
                                <a class="btn btn-primary" href="{{ path('app_formations') }}">{{ 'machine.training_required'|trans }}</a>
                            {% else %}
                                <button class="btn btn-primary" disabled>{{ 'machine.unavailable'|trans }}</button>
                            {% endif %}
                            <a class="btn btn-secondary" href="{{ path('app_machine_quiz', {id: machine.id}) }}">{{ 'machine.go_quiz'|trans }}</a>
                            <button class="btn btn-secondary favorite-btn" disabled title="Favoris bientôt disponible">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                En favori
                            </button>
                        </div>
                        {% if authorizationStatus == 'authorized' %}
                            <div class="access-status">{{ 'machine.badge_ok'|trans }}</div>
                        {% elseif authorizationStatus == 'missing_badge' %}
                            <div class="access-status cannot-access">{{ 'machine.badge_missing'|trans }}</div>
                        {% elseif app.user and canReserve %}
                            <div class="access-status">{{ 'machine.no_badge_required'|trans }}</div>
                        {% elseif not app.user %}
                            <div class="access-status cannot-access">{{ 'machine.login_hint'|trans }}</div>
                        {% else %}
                            <div class="access-status cannot-access">Cette machine n’est pas réservable tant que son statut est {{ statusLabel|lower }}.</div>
                        {% endif %}
                    </div>
                </div>

                <div class="detail-tabs">
                    <button class="detail-tab active" data-tab="overview">{{ 'machine.tab_overview'|trans }}</button>
                    <a class="detail-tab" href="{{ path('app_machine_calendar', {id: machine.id}) }}">{{ 'nav.calendar'|trans }}</a>
                    <a class="detail-tab" href="{{ path('app_machine_quiz', {id: machine.id}) }}">{{ 'machine.tab_quiz'|trans }}</a>
                    <a class="detail-tab" href="{{ path('app_machine_history', {id: machine.id}) }}">{{ 'machine.tab_history'|trans }}</a>
                </div>

                <div class="detail-tab-content active" id="overview">
                    <div class="detail-tab-grid">
                        <div class="detail-card full-width">
                            <h3 class="detail-card-title">{{ 'machine.description'|trans }}</h3>
                            <div class="detail-card-content">
                                <p>{{ machine.description ?? 'Machine connectée à FabOS, disponible selon planning et niveau d’accès.' }}</p>
                            </div>
                        </div>
                        <div class="detail-card">
                            <h3 class="detail-card-title">{{ 'machine.features'|trans }}</h3>
                            <ul class="feature-list">
                                {% for feature in features %}
                                    <li>{{ feature }}</li>
                                {% endfor %}
                                <li>Statut actuel : {{ statusLabel }}</li>
                                <li>Localisation : {{ machine.localisation ?? 'Non renseignée' }}</li>
                            </ul>
                        </div>
                        <div class="detail-card">
                            <h3 class="detail-card-title">{{ 'machine.materials_uses'|trans }}</h3>
                            <div class="materials-grid">
                                {% for material in materials %}
                                    <span class="material-tag">{{ material }}</span>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="detail-card">
                            <h3 class="detail-card-title">{{ 'kiosk.machine_required_badges'|trans }}</h3>
                            <div class="required-badges">
                                {% for row in requiredBadgeRows %}
                                    {% set requiredBadge = row.badge %}
                                    <div class="required-badge {{ row.owned ? 'obtained' : '' }}">
                                        <div class="badge-icon small">✓</div>
                                        <div>
                                            <strong>{{ requiredBadge.nom }}</strong>
                                            <p>{{ requiredBadge.description ?: 'Badge nécessaire pour utiliser cette machine' }}</p>
                                        </div>
                                        {% if app.user and row.owned %}
                                            <span class="badge-check">Badge validé · Accès autorisé</span>
                                        {% elseif app.user %}
                                            <span class="badge-missing"><span>Badge manquant · Accès refusé</span><a class="get-badge-link" href="{{ path('app_formations') }}">{{ 'machine.see_trainings'|trans }}</a></span>
                                        {% else %}
                                            <span class="badge-missing"><span>{{ 'machine.login_required'|trans }}</span><a class="get-badge-link" href="{{ path('app_login') }}">{{ 'login.submit'|trans }}</a></span>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <div class="required-badge obtained">
                                        <div class="badge-icon small">✓</div>
                                        <div>
                                            <strong>{{ 'machine.no_badges'|trans }}</strong>
                                            <p>{{ 'machine.no_badges_desc'|trans }}</p>
                                        </div>
                                        <span class="badge-check">{{ 'machine.free_access'|trans }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="detail-card">
                            <h3 class="detail-card-title">{{ 'machine.real_activity'|trans }}</h3>
                            <ul class="feature-list">
                                <li>Réservations : {{ reservationCount }}</li>
                                <li>Passages RFID : {{ rfidLogCount }}</li>
                                <li>Logs d’utilisation : {{ usageLogCount }}</li>
                            </ul>
                        </div>
                        <div class="detail-card full-width">
                            <h3 class="detail-card-title">{{ 'machine.tech_info'|trans }}</h3>
                            <div class="materials-grid">
                                <span class="material-tag">ID #{{ machine.id }}</span>
                                <span class="material-tag">Token {{ machine.machineToken }}</span>
                                <span class="material-tag">Créée {{ machine.createdAt|date('d/m/Y') }}</span>
                                <span class="material-tag">Mise à jour {{ machine.updated|date('d/m/Y') }}</span>
                                <span class="material-tag">Dernière autorisation {{ machine.lastAuthorizationTime ? machine.lastAuthorizationTime|date('d/m/Y H:i') : '-' }}</span>
                            </div>
                        </div>
                    </div>
                </div>            </div>
        </section>
    </main>

    {% include 'site/_footer.html.twig' %}

    <script src="{{ asset('js/main.js') ~ '?v=20260709-header-scope' }}"></script>
    <script>
        // Gestion des onglets (sauf Calendrier et Historique qui redirigent)
        document.addEventListener('DOMContentLoaded', function() {
            const tabButtons = document.querySelectorAll('.detail-tab[data-tab]:not([onclick])');
            const tabContents = document.querySelectorAll('.detail-tab-content');
            
            tabButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const targetTab = this.dataset.tab;
                    
                    // Retirer la classe active de tous les onglets
                    document.querySelectorAll('.detail-tab').forEach(tab => {
                        tab.classList.remove('active');
                    });
                    
                    // Ajouter la classe active à l'onglet cliqué
                    this.classList.add('active');
                    
                    // Masquer tous les contenus
                    tabContents.forEach(content => {
                        content.classList.remove('active');
                    });
                    
                    // Afficher le contenu cible
                    const targetContent = document.getElementById(targetTab);
                    if (targetContent) {
                        targetContent.classList.add('active');
                    }
                });
            });
        });
    </script>
</body>
</html>
