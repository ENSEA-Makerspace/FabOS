<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ machine.nom }} - FabOS</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
</head>
<body>
    <div class="alert-bar">
        {% include 'site/_alert_bar.html.twig' %}
    </div>

    <header class="site-header">
        <div class="header-container">
            <a href="{{ path('app_home') }}" class="header-brand">
                <div class="logo-ensea">
                    <svg width="127" height="125" viewBox="0 0 127 125" fill="none" xmlns="http://www.w3.org/2000/svg" class="ensea-logo-svg" aria-label="Logo ENSEA">
<path d="M78.4322 89.4308C79.1325 89.2813 79.8279 89.0999 80.532 88.9945C84.0423 88.47 87.5724 88.0889 91.0507 87.421C95.403 86.454 99.6371 85.0225 103.679 83.1514C107.244 81.7385 110.694 80.0546 113.998 78.1147C116 76.861 117.935 75.5081 119.899 74.1932C119.989 74.1319 120.034 74.0106 120.001 73.7851C119.645 73.9677 119.294 74.1527 118.938.7909C76.904 47.9206 76.5342 47.9747 76.1657 47.9495C75.8824 47.9687 75.6052 48.0398 75.348 48.159C74.7115 48.5417 74.0388 48.8619 73.3396 49.1149C70.542 49.7779 67.7159 50.3404 64.9059 50.9703C64.613 51.031 64.3489 51.1866 64.1549 51.4127C63.2421 52.6884 62.3911 54.0033 61.4845 55.284C59.3479 58.4054 58.2721 62.1224 58.4139 65.893C58.4199 67.6046 58.7676 69.298 59.4368 70.8755C60.1061 72.4531 61.0838 73.8835 62.3133 75.0841C62.9581 75.7195 63.7065 76.2423 64.5267 76.6306C67.1603 78.0121 70.0155 78.9297 72.9654 79.3426C75.7741 79.6845 78.5335 80.4578 81.4102 80.2152C82.5391 80.1208 83.6681 80.0926 84.8032 80.0326C84.9286 80.0392 85.0529 80.0598 85.1737 80.0939C81.8236 81.0141 78.3172 81.2323 74.8774 80.7348C75.0672 80.869 75.2829 80.9629 75.511 81.0105C76.5587 81.1868 77.6191 81.279 78.6817 81.2863C82.2303 81.1037 85.7852 80.9492 89.3041 80.535C91.5831 80.2047 93.8341 79.7062 96.0383 79.0436C97.8293 78.5534 99.5708 77.8953 101.317 77.2593C103.497 76.464 105.679 75.6527 107.832 74.7851C109.823 73.9848 111.784 73.1 113.751 72.2446C114.095 72.0951 114.524 71.714 114.763 71.8133C115.057 71.9076 115.369 71.9322 115.675 71.8851C115.98 71.8381 116.27 71.7207 116.521 71.5424C119.82 69.9681 123.111 68.3995 126.395 66.8366V0H125.538ZM39.349 111.08V124.954H48.0273C45.1284 120.326 42.2863 115.775 39.349 111.08ZM119.563 121.431C119.536 121.262 119.443 121.111 119.304 121.01C119.166 120.908 118.993 120.865 118.822 120.89C116.669 120.912 114.511 120.917 112.359 120.89C112.268 120.877 112.176 120.882 112.087 120.904C111.998 120.926 111.915 120.966 111.841 121.02C111.768 121.074 111.706 121.142 111.659 121.22C111.612 121.298 111.581 121.385 111.56