{% extends 'site/base_public.html.twig' %}

{% from 'site/_admin_inline.html.twig' import admin_actions %}

{% block title %}{{ machine.nom }} - FabOS{% endblock %}

{% block stylesheets %}
    {# S146b — this page draws the calendar now. #}
    <link rel="stylesheet" href="{{ asset('css/calendar-modern.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/details.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/calendar-leaderboard.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/pages.css') ~ '?v=' ~ css_version }}">
    <link rel="stylesheet" href="{{ asset('css/page-exploitation-machine.css') ~ '?v=' ~ css_version }}">
{% endblock %}

{% block page_styles %}
    <style>
        .machine-materials-list { display: flex; flex-wrap: wrap; gap: 10px; }
        .machine-material-chip { display: inline-flex; align-items: center; gap: 9px; padding: 7px 13px 7px 8px; border-radius: 999px; background: color-mix(in srgb, var(--color-primary) 6%, transparent); border: 1px solid color-mix(in srgb, var(--color-primary) 14%, transparent); text-decoration: none; color: inherit; }
        .machine-material-chip:hover { background: color-mix(in srgb, var(--color-primary) 12%, transparent); }
        .machine-material-visual { width: 30px; height: 30px; border-radius: 50%; background: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--color-primary) 12%, transparent); display: inline-flex; align-items: center; justify-content: center; font-size: 17px; overflow: hidden; flex-shrink: 0; }
        .machine-material-visual img { width: 100%; height: 100%; object-fit: cover; }
        .machine-material-name { font-size: 14px; font-weight: 700; }
        .machine-material-name em { font-weight: 400; color: var(--color-text-light); font-style: normal; }
        .maint-health-badge { display: inline-block; margin-left: 8px; padding: 2px 11px; border-radius: 999px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; vertical-align: middle; }
        .maint-health-badge.ok { background: color-mix(in srgb, var(--color-ok) 15%, var(--theme-surface)); color: var(--color-ok); }
        .maint-health-badge.due_soon { background: color-mix(in srgb, var(--color-warn) 15%, var(--theme-surface)); color: var(--color-warn); }
        .maint-health-badge.overdue { background: color-mix(in srgb, var(--color-stop, #b91c1c) 15%, var(--theme-surface)); color: var(--color-stop, #b91c1c); }
        .maint-machine-tasks { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-direction: column; gap: 8px; }
        .maint-machine-tasks li { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .maint-dot { width: 10px; height: 10px; border-radius: 50%; background: #2563eb; flex-shrink: 0; }
        .maint-machine-tasks li.overdue .maint-dot { background: #dc2626; }
        .maint-machine-tasks li.due_soon .maint-dot { background: #d97706; }
        .maint-task-title { font-weight: 700; }
        .maint-task-due { color: var(--color-text-light); font-size: 13px; }
        .maint-task-link { color: var(--color-primary-text); font-weight: 700; text-decoration: none; font-size: 13px; }
    </style>
{% endblock %}

{% block body %}

    <main id="main-content" tabindex="-1" class="main-content">
        <section class="machine-detail-section">
            <div class="container">
                {% include 'site/_breadcrumb.html.twig' with {trail: [
                    {label: 'nav.home'|trans, url: path('app_home')},
                    {label: 'nav.machines'|trans, url: path('app_machines')},
                    {label: machine.nom},
                ]} only %}

                {% set category = machine.categorySlug %}
                {% set categoryLabel = machine.categoryLabel %}
                {% set levelLabel = machine.levelLabel %}
                {% set icon = machine.iconSlug %}
                {% set materials = machine.materials %}
                {% set features = machine.features %}
                {% set requirementTitle = machine.requirementTitle %}
                {% set requirementDescription = machine.requirementDescription %}
                {# The mapping lives on the entity (`Machine::getStatusKey`), not here:
                   this page and the admin list used to decide it separately, and the
                   list lost. #}
                {% set statusKey = machine.statusKey %}
                {% set statusClass = statusKey|replace({'machines.st_maintenance': 'maintenance', 'machines.st_broken': 'panne', 'machines.st_available': 'disponible'}) %}
                {% set statusLabel = statusKey|trans %}
                {% set machineAvailable = statusClass == 'disponible' %}
                {% set canReserve = machineAvailable and app.user and usageRight.allowed and authorizationStatus in ['authorized', 'no_badge_required'] %}
                {% set slotDuration = machine.granulariteLabel %}

                {# 🔴 **2026-09-30 — la fiche repensée d'après la planche de référence
                   `equipment-machine-member-detail.png`** (« tâche d'abord ») : ce que
                   le membre vient décider — puis-je réserver ? ai-je l'accès ? — en
                   tête, à côté de la photo ; le contenu dessous. RIEN n'est perdu :
                   mêmes verdicts, mêmes boutons (logique inchangée), mêmes blocs.
                   ⚠️ Les cartes réutilisent `.detail-card` ; seules la mise en page
                   (`.md-*`) et la pastille de verdict sont neuves (details.css). #}
                {# ⚠️ Le service rend TROIS formes de « formation manquante » :
                   `missing_badge`, `training_required`, `physical_training_required`.
                   La page ne connaissait que la première : un membre à qui manquait la
                   formation voyait « Machine indisponible » (vu le 2026-09-30). #}
                {% set trainingMissing = authorizationStatus in ['missing_badge', 'training_required', 'physical_training_required'] %}
                {% set bookTone = canReserve ? 'go' : (not app.user or usageRight.reason|default('') == 'signin_required' ? 'wait' : 'stop') %}
                {% embed 'site/_detail_hero.html.twig' with {
                    kicker: categoryLabel ~ (levelLabel ? ' · ' ~ levelLabel : ''),
                    title: machine.nom,
                    title_actions: admin_actions([
                        { route: 'app_admin_machine_edit', params: { id: machine.id }, label: 'admin_inline.edit'|trans }
                    ]),
                    photo: machine.photo,
                } %}
                    {% block main %}
                        {# S151, R7 — le panneau de droits reste pour tout verdict sauf « connectez-vous ». #}
                        {% if usageRight.enforced and not usageRight.allowed and usageRight.reason != 'signin_required' %}
                            {% include 'site/_usage_right_state.html.twig' with {
                                capability: usageRight.capability,
                                verdict: usageRight,
                                compact: true,
                                action: {label: 'usage_rights.my_rights'|trans, url: path('app_profile') ~ '#usage-rights'}
                            } only %}
                        {% endif %}

                        <div class="md-cards">
                            <section class="detail-card md-book" aria-labelledby="md-book-title">
                                <div class="md-book-head">
                                    <span class="md-verdict md-verdict--{{ bookTone }}" aria-hidden="true">{{ canReserve ? '✓' : (bookTone == 'wait' ? '→' : '!') }}</span>
                                    <h2 id="md-book-title" class="md-book-title">
                                        {%- if canReserve -%}{{ 'machine.verdict_can'|trans }}
                                        {%- elseif not app.user or usageRight.reason|default('') == 'signin_required' -%}{{ 'machine.verdict_signin'|trans }}
                                        {%- elseif not usageRight.allowed -%}{{ ('usage_rights.verdict.' ~ usageRight.reason ~ '.label')|trans }}
                                        {%- elseif trainingMissing -%}{{ 'machine.verdict_training'|trans }}
                                        {%- else -%}{{ 'machine.not_bookable'|trans({'%status%': statusLabel|lower}) }}{%- endif -%}
                                    </h2>
                                </div>
                                <div class="machine-detail-actions">
                            {% if canReserve %}
                                {# The page already knows when this machine is next free, so it
                                   says so instead of sending someone into a grid to find out
                                   (S47). The link still lands on the calendar: the slot is an
                                   answer, not a booking — `ReservationService::book()` is
                                   still the only thing that can create one. #}
                                <a class="btn btn-primary" href="#calendrier" data-tab-link="calendrier">
                                    {# ⚠️ The zone is pinned on the read as well as the write. The app's
                                       default timezone is UTC, so an unpinned `|date` re-renders the slot
                                       in UTC and an 08:00 opening gets advertised as 06:00. #}
                                    {% if nextSlot %}
                                        {{ 'machine.reserve_next'|trans({'%day%': nextSlot.start|lab_date('d/m'), '%start%': nextSlot.start|lab_date('H:i')}) }}
                                    {% else %}
                                        {{ 'machine.reserve'|trans }}
                                    {% endif %}
                                </a>
                            {#- ⚠️ **S147, J-17 — a control says what happens, not what is
                                wrong.** This button was labelled with the verdict's STATE key
                                ("Connexion requise"), which the pill above it already says and
                                which names no action. `signin_required` is the one verdict with
                                an obvious verb, so it borrows the label the anonymous branch
                                below already uses; every other verdict keeps its state words,
                                because "your package does not cover this" genuinely has no
                                one-click answer. -#}
                            {% elseif not usageRight.allowed %}
                                <a class="btn btn-primary" href="{{ usageRight.reason == 'signin_required' ? path('app_login') : path('app_profile') ~ '#usage-rights' }}">
                                    {{ usageRight.reason == 'signin_required'
                                        ? 'machine.login_to_reserve'|trans
                                        : ('usage_rights.verdict.' ~ usageRight.reason ~ '.label')|trans }}
                                </a>
                            {% elseif not app.user %}
                                <a class="btn btn-primary" href="{{ path('app_login') }}">{{ 'machine.login_to_reserve'|trans }}</a>
                            {% elseif trainingMissing %}
                                {# Le verdict au-dessus dit déjà « formation requise » : le bouton dit le verbe. #}
                                <a class="btn btn-primary" href="{{ path('app_formations') }}">{{ 'machine.see_trainings'|trans }}</a>
                            {% else %}
                                {# 🔴 **S149 — c'était un `<button disabled>`, donc un contrôle qui ne fait
                                   rien.** « Indisponible » n'est pas une action, c'est un état : la pastille
                                   partagée le dit, et ne se propose pas au clic ni au clavier. Voir
                                   [[feedback-fabos-dead-affordances]] — un contrôle désactivé est la même
                                   faute qu'un contrôle absent, en costume. #}
                                {% include 'site/_cell_state.html.twig' with {
                                    label: 'machine.unavailable'|trans,
                                    signal: 'stop',
                                } only %}
                            {% endif %}
                            <a class="btn btn-secondary" href="{{ path('app_machine_quiz', {id: machine.id}) }}">{{ 'machine.go_quiz'|trans }}</a>
                            <button type="button" id="machine-favorite-btn"
                                    class="btn btn-secondary favorite-btn {{ isFavorite ? 'active' : '' }}{{ favoritesEnabled|default(false) ? '' : ' disabled' }}"
                                    data-machine-id="{{ machine.id }}"
                                    aria-pressed="{{ isFavorite ? 'true' : 'false' }}"
                                    title="{{ favoritesEnabled|default(false) ? (isFavorite ? 'machines.fav_remove'|trans : 'machines.fav_add'|trans) : 'machines.fav_unavailable'|trans }}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                <span class="favorite-label">{{ isFavorite ? 'machines.fav_remove'|trans : 'machines.fav_add'|trans }}</span>
                            </button>
                        </div>
                                <p class="md-book-foot">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    {{ machine.localisation ?? 'machine.no_location'|trans }}
                                    <span aria-hidden="true">·</span>
                                    {% if nextSlot and machineAvailable %}
                                        <span class="md-next">{{ 'machine.next_slot'|trans({'%day%': nextSlot.start|lab_date('d/m'), '%start%': nextSlot.start|lab_date('H:i')}) }}</span>
                                    {% else %}
                                        <span>{{ statusLabel }}</span>
                                    {% endif %}
                                    {# S205 — le chemin d'un membre devant une machine sans étiquette : un lien texte. #}
                                    {% if machine_reports_open() %}
                                        <span aria-hidden="true">·</span>
                                        <a href="{{ path('app_report_machine', {id: machine.id}) }}">{{ 'machine_report.title'|trans }}</a>
                                    {% endif %}
                                </p>
                            </section>

                            <section class="detail-card md-access" aria-labelledby="md-access-title">
                                <h2 id="md-access-title" class="detail-card-title">{{ (app.user ? 'machine.access_title' : 'machine.access_title_anon')|trans }}</h2>
                                <ul class="md-access-list">
                                    {% for row in requiredBadgeRows %}
                                        <li class="{{ row.owned ? 'is-ok' : 'is-missing' }}">
                                            <span class="md-access-mark" aria-hidden="true">{{ row.owned ? '✓' : '✗' }}</span>
                                            <span>{{ row.badge.nom }}</span>
                                        </li>
                                    {% else %}
                                        <li class="is-ok"><span class="md-access-mark" aria-hidden="true">✓</span><span>{{ 'machine.free_access'|trans }}</span></li>
                                    {% endfor %}
                                </ul>
                                {# Aucun lien ici : le bouton de la carte voisine porte le verbe
                                   (formations, connexion) — pas deux fois la même action. #}
                            </section>
                        </div>
                    {% endblock %}
                    {# Rien de saisi : l'icône de la catégorie, le MÊME repli que les cartes du catalogue. #}
                    {% block fallback %}{% include 'site/_category_icon.html.twig' with { slug: category|default(icon) } only %}{% endblock %}
                    {% block badge %}<div class="machine-status-badge large {{ statusClass }}">{{ statusLabel }}</div>{% endblock %}
                {% endembed %}

                <div class="detail-tabs">
                    <button class="detail-tab active" data-tab="overview">{{ 'machine.tab_overview'|trans }}</button>
                    {# ⚠️ S146b: a TAB, not a link away. The week and the booking panel
                       are on this page now, which is where somebody looking at a machine
                       already is — one navigation removed from the most frequent journey.
                       Quiz and Historique are still pages of their own and stay links. #}
                    <button class="detail-tab" data-tab="calendrier">{{ 'nav.calendar'|trans }}</button>
                    {# ⚠️ **L'onglet n'apparaît QUE s'il y a des documents.** Un onglet
                       vide est une promesse qui ne tient pas : on l'ouvre, il n'y a
                       rien, et on a payé un clic pour l'apprendre. La plupart des
                       machines n'auront jamais de document. #}
                    {% if machineDocuments|default([])|length %}
                        <button class="detail-tab" data-tab="documents">{{ 'machine_documents.heading'|trans }}</button>
                    {% endif %}
                    <a class="detail-tab" href="{{ path('app_machine_quiz', {id: machine.id}) }}">{{ 'machine.tab_quiz'|trans }}</a>
                    <a class="detail-tab" href="{{ path('app_machine_history', {id: machine.id}) }}">{{ 'machine.tab_history'|trans }}</a>
                </div>

                {% if machineDocuments|default([])|length %}
                    {# 🔴 **S152 — les documents attachés à une machine.** Demandés par
                       l'opérateur le 2026-08-27 : guide d'usage, fiche de sécurité.

                       ⚠️ **Ils sont PUBLICS**, et la fiche ne prétend pas le contraire :
                       les fichiers vivent sous `public/uploads/`, donc leur adresse
                       suffit. C'est le bon défaut pour une fiche de sécurité — elle se
                       lit AVANT d'être formé, pas après — et l'écran d'admin prévient
                       en toutes lettres de ne rien y mettre d'interne.

                       ⚠️ Le lien passe par la route de téléchargement plutôt que par
                       l'URL du fichier : elle rend le nom que l'opérateur a téléversé
                       au lieu de `machine-7-a1b2c3.pdf`. #}
                    <div class="detail-tab-content" id="documents">
                        <div class="detail-tab-grid">
                            <div class="detail-card full-width">
                                <h3 class="detail-card-title">{{ 'machine_documents.heading'|trans }}</h3>
                                <div class="detail-card-content">
                                    <ul class="machine-doc-list">
                                        {% for doc in machineDocuments %}
                                            <li class="machine-doc">
                                                <span class="machine-doc-kind" aria-hidden="true">{{ doc.kind|upper }}</span>
                                                <a class="machine-doc-link" href="{{ path('app_machine_document_download', {id: machine.id, documentId: doc.id}) }}">
                                                    <span class="machine-doc-label">{{ doc.label }}</span>
                                                    <span class="machine-doc-meta">{{ doc.kind|upper }} · {{ (doc.sizeBytes / 1048576)|number_format(1) }} Mo</span>
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="detail-tab-content active" id="overview">
                    <div class="detail-tab-grid md-grid">
                        {# 🔴 S174 — UNE liste de matériaux : la relation gagne ; le texte libre
                           reste lisible pour une machine pas encore rattachée (ne mène nulle part). #}
                        <section class="detail-card md-materials">
                            <h2 class="detail-card-title">{{ 'materials.on_machine'|trans }}</h2>
                            {% if materialsEnabled and machineMaterials is not empty %}
                                <div class="machine-materials-list">
                                    {% for material in machineMaterials %}
                                        <a class="machine-material-chip" href="{{ path('app_materials_detail', {id: material.id}) }}">
                                            <span class="machine-material-visual">{% if material.imageUrl %}<img class="pt-photo" src="{{ material.imageUrl }}" alt="{{ material.name }}" onerror="this.style.display='none'">{% elseif material.icon %}{{ material.icon }}{% else %}{% include 'site/_icon.html.twig' with { name: 'box' } only %}{% endif %}</span>
                                            <span class="machine-material-name">{{ material.name }}{% if material.category %} <em>· {{ material.category }}</em>{% endif %}</span>
                                        </a>
                                    {% endfor %}
                                </div>
                            {% elseif materials is not empty %}
                                <div class="materials-grid">
                                    {% for material in materials %}<span class="material-tag">{{ material }}</span>{% endfor %}
                                </div>
                            {% else %}
                                {% include 'site/_cell_empty.html.twig' with {reason: 'materials.machine_none'} only %}
                            {% endif %}
                        </section>

                        <section class="detail-card md-before">
                            <h2 class="detail-card-title">{{ 'machine.before_title'|trans }}</h2>
                            <ul class="md-access-list">
                                {% if requirementTitle %}
                                    <li class="is-ok"><span class="md-access-mark" aria-hidden="true">✓</span><span><strong>{{ requirementTitle }}</strong>{% if requirementDescription %} — {{ requirementDescription }}{% endif %}</span></li>
                                {% endif %}
                                {% for doc in machineDocuments|default([]) %}
                                    <li class="is-ok"><span class="md-access-mark" aria-hidden="true">✓</span><a href="{{ path('app_machine_document_download', {id: machine.id, documentId: doc.id}) }}">{{ doc.label }}</a></li>
                                {% endfor %}
                                <li class="is-ok"><span class="md-access-mark" aria-hidden="true">✓</span><a href="{{ path('app_machine_quiz', {id: machine.id}) }}">{{ 'machine.go_quiz'|trans }}</a></li>
                            </ul>
                        </section>

                        <section class="detail-card full-width md-about">
                            <h2 class="detail-card-title">{{ 'machine.description'|trans }}</h2>
                            <div class="detail-card-content">
                                <p>{{ machine.description ?? 'machine.default_description'|trans }}</p>
                            </div>
                            <ul class="feature-list">
                                {% for feature in features %}<li>{{ feature }}</li>{% endfor %}
                                <li>{{ 'machine.slots'|trans({'%duration%': slotDuration}) }}</li>
                                <li>{{ 'machine.concurrent_reservations'|trans({'count': machine.limiteReservations}) }}</li>
                            </ul>
                        </section>

                        {# « État et maintenance », replié (planche) : la santé pour tous
                           quand le module est actif ; la zone Exploitation, staff seulement. #}
                        {% if maintenanceEnabled or seesOperations %}
                            <details class="detail-card full-width detail-disclosure md-state">
                                <summary class="detail-card-title">{{ 'machine.state_title'|trans }}{% if seesOperations %} <span class="md-staff">{{ 'machine.staff_only'|trans }}</span>{% endif %}</summary>
                        {% if maintenanceEnabled %}
                        <div class="md-state-part">
                            <h3 class="detail-card-title">
                                {{ 'maintenance.health'|trans }}
                                <span class="maint-health-badge {{ maintenanceHealth }}">{{ ('maintenance.health_' ~ maintenanceHealth)|trans }}</span>
                            </h3>
                            {% if openMaintenance is empty %}
                                <p style="color:var(--color-text-light);margin:6px 0 0;">{{ 'maintenance.none_open'|trans }}</p>
                            {% else %}
                                <ul class="maint-machine-tasks">
                                    {% for task in openMaintenance %}
                                        {% set st = task.effectiveStatus %}
                                        <li class="{{ st }}">
                                            <span class="maint-dot"></span>
                                            <span class="maint-task-title">{{ task.title }}</span>
                                            {% if task.dueDate %}<span class="maint-task-due">{{ 'maintenance.due'|trans }} {{ task.dueDate|date('d/m/Y') }}</span>{% endif %}
                                            {% if task.link %}<a href="{{ task.link }}" target="_blank" rel="noopener" class="maint-task-link">{{ 'maintenance.guide'|trans }} →</a>{% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                        {% endif %}
                        {# 🔴 **S173 — la zone Exploitation : les outils du staff, à part
                           du contenu public.** Ces deux blocs étaient au milieu de la
                           fiche que lit un visiteur. Ils ne répondent à AUCUNE question
                           de membre — « combien de passages RFID », « ID #12 », « dernière
                           autorisation » sont de la tenue de registre.

                           🔴 **Et l'un des deux était une fuite.** `/machines/{id}/historique`
                           refuse ses lignes à un anonyme en expliquant que masquer les
                           colonnes ne suffit pas, « cela dirait encore combien de gens ont
                           utilisé la machine et quand » — pendant que la fiche d'à côté
                           affichait ce compte à tout le monde. Une règle, `BookingIdentityPolicy`,
                           décide maintenant pour les deux.

                           ⚠️ **Ce n'est pas une garde**, c'est de la présentation : ce qui
                           protège les pages liées est `access_control`, comme le rappelle
                           `_admin_inline`. Le contrôleur, lui, ne CALCULE plus les compteurs
                           quand le lecteur n'y a pas droit — ça, c'en est une.

                           🅿️ **`machine.machineToken` reste interdit ici.** Ce n'est pas un
                           libellé : c'est le segment d'URL qui adresse la machine sur l'API
                           des boîtiers (`/api/rfid/machines/{machineToken}/authorization`).
                           Il n'a sa place que sur un écran `/admin`. #}
                        {% if seesOperations and ops %}
                        {# Quatre cartes qui portent chacune un FAIT et un VERBE (`App\Page\MachineOperations`),
                           au lieu de compter des lignes de journal. Les verbes mènent aux pages réelles. #}
                        <div class="detail-card full-width pp-xm-new" data-machine-ops>
                            <h3 class="detail-card-title">{{ 'machine.ops_zone'|trans }}</h3>
                            <div class="pp-xm-grid">
                                <article class="pp-xm-card">
                                    <h3>{{ 'mops.state'|trans }}</h3>
                                    {% include 'site/_state_chip.html.twig' with { label: ops.state.label|trans, signal: ops.state.signal } only %}
                                    {% if can_reach('app_admin_machine_edit', {id: machine.id}) %}
                                        <a class="btn btn-secondary" href="{{ path('app_admin_machine_edit', {id: machine.id}) }}">{{ (ops.state.outOfService ? 'mops.put_back' : 'mops.put_out')|trans }}</a>
                                    {% endif %}
                                </article>

                                <article class="pp-xm-card">
                                    <h3>{{ 'mops.maintenance'|trans }}</h3>
                                    {% if not ops.maintenanceEnabled %}
                                        <p class="pp-xm-sub">{{ 'mops.maintenance_off'|trans }}</p>
                                    {% elseif ops.task %}
                                        {% set t = ops.task %}
                                        <p class="pp-xm-fact">{{ t.title }}</p>
                                        <p class="pp-xm-sub{{ t.effectiveStatus == 'overdue' ? ' is-late' : '' }}">
                                            {% if t.dueDate %}{{ (t.effectiveStatus == 'overdue' ? 'mops.late_due' : 'mops.due')|trans({'%date%': t.dueDate|date('d/m/Y')}) }}{% else %}{{ 'mops.no_due'|trans }}{% endif %}
                                            {% if ops.openCount > 1 %} · {{ 'mops.others_open'|trans({'%n%': ops.openCount - 1}) }}{% endif %}
                                        </p>
                                        {% if can_reach('app_admin_maintenance_edit', {id: t.id}) %}
                                            <a class="btn btn-secondary" href="{{ path('app_admin_maintenance_edit', {id: t.id}) }}">{{ 'mops.open_task'|trans }}</a>
                                        {% endif %}
                                    {% else %}
                                        <p class="pp-xm-sub">{{ 'mops.no_task'|trans }}</p>
                                        {% if can_reach('app_admin_maintenance_new') %}
                                            <a class="btn btn-secondary" href="{{ path('app_admin_maintenance_new') }}">{{ 'mops.plan'|trans }}</a>
                                        {% endif %}
                                    {% endif %}
                                </article>

                                <article class="pp-xm-card">
                                    <h3>{{ 'mops.reader'|trans }}</h3>
                                    {% if ops.reader %}
                                        {% set r = ops.reader.entity %}
                                        <p class="pp-xm-fact">{{ r.name }}</p>
                                        {% include 'site/_state_chip.html.twig' with { label: ops.reader.health.label|trans, signal: ops.reader.health.signal } only %}
                                        <p class="pp-xm-sub">{% if r.lastSeenAt %}{{ 'mops.last_seen'|trans({'%when%': r.lastSeenAt|lab_date('d/m H:i')}) }}{% else %}{{ 'mops.never_seen'|trans }}{% endif %}</p>
                                        {% if can_reach('app_admin_rfid_reader_edit', {id: r.id}) %}
                                            <a class="btn btn-secondary" href="{{ path('app_admin_rfid_reader_edit', {id: r.id}) }}">{{ 'mops.open_reader'|trans }}</a>
                                        {% endif %}
                                    {% else %}
                                        <p class="pp-xm-sub">{{ 'mops.no_reader'|trans }}</p>
                                        {% if can_reach('app_admin_rfid_reader_new') %}
                                            <a class="btn btn-secondary" href="{{ path('app_admin_rfid_reader_new') }}">{{ 'mops.link_reader'|trans }}</a>
                                        {% endif %}
                                    {% endif %}
                                </article>

                                <article class="pp-xm-card">
                                    <h3>{{ 'mops.access'|trans }}</h3>
                                    <p class="pp-xm-fact">{{ ops.incidents|length ? 'mops.recent_denials'|trans({'%n%': ops.incidents|length}) : 'mops.no_denials'|trans }}</p>
                                    {% if can_reach('app_admin_access_rfid_logs') %}
                                        <a class="btn btn-secondary" href="{{ path('app_admin_access_rfid_logs', {machine: machine.id, days: 30}) }}">{{ 'mops.see_incidents'|trans }}</a>
                                    {% endif %}
                                </article>

                                {# S205 — « Signalements » : les pannes signalées par QR, avec le verbe « Résoudre ». `ops.reports` est nul fonction éteinte ou migration pas passée : la carte n'existe pas alors. #}
                                {% if ops.reports is not null %}
                                    <article class="pp-xm-card">
                                        <h3>{{ 'mops.reports'|trans }}</h3>
                                        {% if ops.reports %}
                                            {% for report in ops.reports %}
                                                <p class="pp-xm-fact">{{ report.description }}</p>
                                                <p class="pp-xm-sub">{{ report.createdAt|lab_date('d/m H:i') }}{% if report.contact %} · {{ report.contact }}{% endif %}</p>
                                                {% if can_reach('app_admin_machine_report_resolve', {id: report.id}) %}
                                                    <form method="post" action="{{ path('app_admin_machine_report_resolve', {id: report.id}) }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('report_resolve_' ~ report.id) }}">
                                                        <input type="hidden" name="back" value="machine">
                                                        <button class="btn btn-secondary" type="submit">{{ 'machine_report.resolve'|trans }}</button>
                                                    </form>
                                                {% endif %}
                                            {% endfor %}
                                        {% else %}
                                            <p class="pp-xm-sub">{{ 'mops.reports_none'|trans }}</p>
                                        {% endif %}
                                        {% if can_reach('app_admin_machine_reports') %}
                                            <a class="btn btn-secondary" href="{{ path('app_admin_machine_reports') }}">{{ 'admin_attention.all_reports'|trans }}</a>
                                        {% endif %}
                                        {% if can_reach('app_admin_machine_report_qr', {id: machine.id}) %}
                                            <a class="btn btn-secondary" href="{{ path('app_admin_machine_report_qr', {id: machine.id}) }}">{{ 'mops.reports_qr'|trans }}</a>
                                        {% endif %}
                                    </article>
                                {% endif %}
                            </div>

                            {% if ops.incidents %}
                                <h3 class="detail-card-title">{{ 'mops.last_denials'|trans }}</h3>
                                <ul class="pp-xm-incidents">
                                    {% for row in ops.incidents %}
                                        <li>
                                            <time>{{ row.log.createdAt|lab_date('d/m H:i') }}</time>
                                            <span>{{ row.log.message|default(row.log.status) }}</span>
                                            {% if row.fix %}
                                                {% include 'site/_cell_fix.html.twig' with { fix: row.fix.fix, route: row.fix.route, params: row.fix.params, tone: 'alert' } only %}
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}

                            <p class="pp-xm-sub"><a href="{{ path('app_machine_history', {id: machine.id}) }}">{{ 'machine.tab_history'|trans }}</a></p>

                            {# Divulgué sur demande plutôt qu'affiché (S48) : même pour
                               le staff, c'est de la tenue de registre, pas ce qu'on
                               vient lire. ⚠️ `machine.machineToken` reste INTERDIT ici :
                               c'est le segment d'URL qui adresse la machine sur l'API des
                               boîtiers ; il n'a sa place que sur un écran `/admin`. #}
                            <details class="detail-card full-width detail-disclosure">
                                <summary class="detail-card-title">{{ 'machine.tech_info'|trans }}</summary>
                                <div class="materials-grid">
                                    <span class="material-tag">ID #{{ machine.id }}</span>
                                    <span class="material-tag">{{ 'machine.tech_created'|trans({'%date%': machine.createdAt|date('d/m/Y')}) }}</span>
                                    <span class="material-tag">{{ 'machine.tech_updated'|trans({'%date%': machine.updated|date('d/m/Y')}) }}</span>
                                    <span class="material-tag">{{ 'machine.tech_last_auth'|trans({'%date%': machine.lastAuthorizationTime ? machine.lastAuthorizationTime|lab_date('d/m/Y H:i') : '-'}) }}</span>
                                </div>
                            </details>
                        </div>
                        {% endif %}
                            </details>
                        {% endif %}
                    </div>
                </div>

                {# 🔴 **The calendar that used to be a page of its own** (S146b).
                   `machine-calendrier.html.twig` is deleted and `/machines/{id}/calendrier`
                   301s here. The component is the same one `/calendrier` draws — one
                   calendar, in code and on screen (S146a).

                   ⚠️ **`data-controller` sits on THIS panel**, so the board and the
                   booking dialog are both inside the controlled element. The panel is
                   hidden until the tab is chosen; the controller renders into it anyway,
                   which is fine because the grid is computed from the payload and not
                   from layout. #}
                <div class="detail-tab-content" id="calendrier"
                     data-controller="calendar"
                     data-calendar-payload-value="{{ calendar|json_encode }}">
                    {% include 'site/_calendar.html.twig' with {
                        heading: 'mcal.availability'|trans,
                        subtitle: 'mcal.click_slot'|trans,
                    } only %}

                    {% include 'site/_calendar_booking.html.twig' with {
                        title: 'machine_calendar.book_slot'|trans,
                        hint: 'machine_calendar.pick_free_slot'|trans,
                        resources: calendarResources,
                        resources_by_kind: {},
                        booking_access: {},
                        signed_in: app.user is not null,
                    } only %}

                    {# 🔴 **This link was LOST when S146b deleted `machine-calendrier.html.twig`.**
                       The route `app_machine_ical` kept working and nothing pointed at it any
                       more — found by auditing which routes are referenced nowhere but their own
                       declaration. `/places/{id}` kept its copy; the machine's went with the
                       template. ⚠️ Signed-in only: the URL carries a personal feed token. #}
                    {% if app.user %}
                        {% set ical_url = url('app_machine_ical', {id: machine.id}) ~ '?token=' ~ ical_feed_token() %}
                        <p class="place-ical-subscribe"><a href="{{ ical_url|replace({'https://': 'webcal://', 'http://': 'webcal://'}) }}" title="{{ 'ical.subscribe_hint'|trans }}">{% include 'site/_icon.html.twig' with { name: 'calendar' } only %} {{ 'ical.subscribe'|trans }}</a></p>
                    {% endif %}
                </div>
            </div>
        </section>
        {# S51/S52: the one primary action, reachable with a thumb. Small screens
           only — where there is room, the real button in the page is better than
           something floating over the content. It repeats an action that already
           exists above rather than introducing a new one, and it is `aria-hidden`
           free because it is a genuine second route to the same place. #}
        {% if canReserve %}
            <a class="fab-fab" href="#calendrier" data-tab-link="calendrier">
                {{ nextSlot ? 'machine.reserve_next'|trans({'%day%': nextSlot.start|lab_date('d/m'), '%start%': nextSlot.start|lab_date('H:i')}) : 'machine.reserve'|trans }}
            </a>
        {% endif %}
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/main.js') ~ '?v=' ~ js_version }}"></script>
    <script>
        // Gestion des onglets (sauf Calendrier et Historique qui redirigent)
        document.addEventListener('DOMContentLoaded', function() {
            const tabButtons = document.querySelectorAll('.detail-tab[data-tab]:not([onclick])');
            const tabContents = document.querySelectorAll('.detail-tab-content');
            
            // ⚠️ S146b — one function, so a tab opened by a click, by a link inside
            // the page and by the URL hash all land in the same state. The hash is
            // what makes the 301 from /machines/{id}/calendrier arrive on the
            // calendar rather than on the overview.
            function showTab(name) {
                const target = document.getElementById(name);
                if (!target) {
                    return;
                }
                document.querySelectorAll('.detail-tab').forEach(tab => tab.classList.remove('active'));
                document.querySelector(`.detail-tab[data-tab="${name}"]`)?.classList.add('active');
                tabContents.forEach(content => content.classList.remove('active'));
                target.classList.add('active');
            }

            document.querySelectorAll('[data-tab-link]').forEach(link => {
                link.addEventListener('click', function (event) {
                    event.preventDefault();
                    const name = this.dataset.tabLink;
                    showTab(name);
                    window.history.replaceState({}, '', '#' + name);
                    document.querySelector('.detail-tabs')?.scrollIntoView({behavior: 'smooth', block: 'start'});
                });
            });

            if (window.location.hash) {
                showTab(window.location.hash.slice(1));
            }
            window.addEventListener('hashchange', () => showTab(window.location.hash.slice(1)));

            tabButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const targetTab = this.dataset.tab;
                    
                    // Retirer la classe active de tous les onglets
                    document.querySelectorAll('.detail-tab').forEach(tab => {
                        tab.classList.remove('active');
                    });
                    
                    // Ajouter la classe active à l'onglet cliqué
                    this.classList.add('active');
                    
                    // Masquer tous les contenus
                    tabContents.forEach(content => {
                        content.classList.remove('active');
                    });
                    
                    // Afficher le contenu cible
                    const targetContent = document.getElementById(targetTab);
                    if (targetContent) {
                        targetContent.classList.add('active');
                    }
                });
            });

            // Favoris machine (bouton page détail) — même API que la liste
            const favBtn = document.getElementById('machine-favorite-btn');
            if (favBtn) {
                const isAuthenticated = {{ is_granted('ROLE_USER') ? 'true' : 'false' }};
                const favoritesEnabled = {{ favoritesEnabled|default(false) ? 'true' : 'false' }};
                const loginUrl = '{{ path('app_login') }}';
                const labels = {
                    add: {{ 'machines.fav_add'|trans|json_encode|raw }},
                    remove: {{ 'machines.fav_remove'|trans|json_encode|raw }},
                    unavailable: {{ 'machines.fav_unavailable'|trans|json_encode|raw }}
                };
                favBtn.addEventListener('click', async function() {
                    if (!isAuthenticated) { window.location.href = loginUrl; return; }
                    if (!favoritesEnabled || favBtn.classList.contains('loading')) return;
                    const machineId = favBtn.dataset.machineId;
                    const method = favBtn.classList.contains('active') ? 'DELETE' : 'POST';
                    favBtn.classList.add('loading');
                    try {
                        const response = await fetch(`/api/me/favorite-machines/${machineId}`, {
                            method,
                            headers: { 'Accept': 'application/json' },
                            credentials: 'same-origin'
                        });
                        const payload = await response.json().catch(() => ({}));
                        if (!response.ok) { throw new Error(payload.error || labels.unavailable); }
                        const favorited = Boolean(payload.favorited);
                        favBtn.classList.toggle('active', favorited);
                        favBtn.setAttribute('aria-pressed', favorited ? 'true' : 'false');
                        favBtn.title = favorited ? labels.remove : labels.add;
                        const label = favBtn.querySelector('.favorite-label');
                        if (label) { label.textContent = favorited ? labels.remove : labels.add; }
                    } catch (error) {
                        favBtn.title = error.message || labels.unavailable;
                    } finally {
                        favBtn.classList.remove('loading');
                    }
                });
            }
        });
    </script>
{% endblock %}
