{# ⚠️ **No local `<style>` since S142.** The rules are `.delete-confirm-*` in
   `admin.css`; both callers link it. They lived here, in the body, duplicated
   per include — and the confirm button's `.btn-danger` was defined in a file no
   admin page loads, so on `/admin/rfid-readers` the destructive button rendered
   as bare browser chrome. #}
<div class="delete-confirm-backdrop" id="delete-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="delete-confirm-title" aria-describedby="delete-confirm-description">
    <div class="delete-confirm-modal">
        <div class="delete-confirm-header">
            <h2 id="delete-confirm-title">{{ 'rfid_delete.title'|trans }}</h2>
        </div>
        <div class="delete-confirm-body">
            <p id="delete-confirm-description">{{ 'rfid_delete.body'|trans }}</p>
            <div class="delete-confirm-note">{{ 'rfid_delete.note'|trans }}</div>
        </div>
        <div class="delete-confirm-actions">
            <button class="btn-secondary" type="button" data-delete-cancel>{{ 'common.cancel'|trans }}</button>
            <button class="btn-danger" type="button" data-delete-confirm>{{ 'rfid_delete.confirm'|trans }}</button>
        </div>
    </div>
</div>

<script>
    (function () {
        const deleteModal = document.getElementById('delete-confirm-modal');
        const cancelButton = deleteModal ? deleteModal.querySelector('[data-delete-cancel]') : null;
        const confirmButton = deleteModal ? deleteModal.querySelector('[data-delete-confirm]') : null;
        let pendingDeleteForm = null;

        if (!deleteModal || !cancelButton || !confirmButton) {
            return;
        }

        function openDeleteModal(form) {
            pendingDeleteForm = form;
            deleteModal.classList.add('open');
            cancelButton.focus();
        }

        function closeDeleteModal() {
            deleteModal.classList.remove('open');
            pendingDeleteForm = null;
        }

        document.querySelectorAll('[data-delete-confirm-form]').forEach((form) => {
            form.addEventListener('submit', (event) => {
                event.preventDefault();
                openDeleteModal(form);
            });
        });

        cancelButton.addEventListener('click', closeDeleteModal);
        deleteModal.addEventListener('click', (event) => {
            if (event.target === deleteModal) {
                closeDeleteModal();
            }
        });
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && deleteModal.classList.contains('open')) {
                closeDeleteModal();
            }
        });
        confirmButton.addEventListener('click', () => {
            if (pendingDeleteForm) {
                pendingDeleteForm.submit();
            }
        });
    })();
</script>
