{% extends 'emails/_layout.html.twig' %}

{% block subject %}{{ 'mail.password_managed.subject'|trans }}{% endblock %}

{% block body %}
    {# S197 — « mot de passe oublié » pour un compte CRÉÉ par un fournisseur de
       connexion. 🔴 Aucun lien pour poser un mot de passe FabOS : ce serait une
       seconde porte que l'établissement ne fermerait pas en coupant le compte.
       On dit où le mot de passe se gère, et comment se connecter. #}
    <h2 style="margin:0 0 12px; font-size:19px;">{{ 'mail.password_managed.title'|trans }}</h2>
    <p style="margin:0 0 16px;">{{ 'mail.password_managed.intro'|trans({'%provider%': providerLabel}) }}</p>

    {% if passwordUrl %}
        <p style="margin:0 0 20px;">
            <a href="{{ passwordUrl }}"
               style="display:inline-block; padding:12px 20px; border-radius:8px; background:#15803d; color:#ffffff; font-weight:700; text-decoration:none;">{{ 'mail.password_managed.button'|trans({'%provider%': providerLabel}) }}</a>
        </p>
        <p style="margin:0 0 16px; color:#6b7280; font-size:13px; word-break:break-all;">{{ passwordUrl }}</p>
    {% else %}
        <p style="margin:0 0 16px;">{{ 'mail.password_managed.no_url'|trans({'%provider%': providerLabel}) }}</p>
    {% endif %}

    <p style="margin:0 0 16px;">{{ 'mail.password_managed.login'|trans({'%provider%': providerLabel}) }} <a href="{{ loginUrl }}">{{ loginUrl }}</a></p>
    <p style="margin:0; color:#6b7280; font-size:13px;">{{ 'mail.password_reset.ignore'|trans }}</p>
{% endblock %}
