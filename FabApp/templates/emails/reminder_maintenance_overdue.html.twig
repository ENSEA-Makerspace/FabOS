{% extends 'emails/_layout.html.twig' %}

{% block subject %}{{ 'mail.reminder.maintenance_overdue.subject'|trans({'%machine%': machine}) }}{% endblock %}

{% block body %}
    <h2 style="margin:0 0 12px; font-size:19px; color:#b91c1c;">{{ 'mail.reminder.maintenance_overdue.title'|trans }}</h2>
    <p style="margin:0 0 16px;">
        {{ 'mail.reminder.maintenance_overdue.intro'|trans({'%task%': task, '%machine%': machine, '%days%': days_late|default(0)}) }}
    </p>

    <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%; background:#f9fafb; border-radius:10px; padding:4px 0; margin:0 0 16px;">
        <tr>
            <td style="padding:10px 16px; color:#6b7280; font-size:13px; width:110px;">{{ 'mail.reminder.maintenance.field.task'|trans }}</td>
            <td style="padding:10px 16px; font-weight:700;">{{ task }}</td>
        </tr>
        {% if machine %}
            <tr>
                <td style="padding:10px 16px; color:#6b7280; font-size:13px;">{{ 'mail.reminder.maintenance.field.machine'|trans }}</td>
                <td style="padding:10px 16px; font-weight:700;">{{ machine }}</td>
            </tr>
        {% endif %}
        <tr>
            <td style="padding:10px 16px; color:#6b7280; font-size:13px;">{{ 'mail.reminder.maintenance.field.due'|trans }}</td>
            <td style="padding:10px 16px; font-weight:700; color:#b91c1c;">{{ due|date('d/m/Y') }}</td>
        </tr>
    </table>

    {% if link %}
        <p style="margin:0 0 16px;">
            <a href="{{ link }}" style="color:#9E1B56;">{{ 'mail.reminder.maintenance.field.link'|trans }}</a>
        </p>
    {% endif %}

    <p style="margin:0; color:#6b7280; font-size:13px;">{{ 'mail.reminder.maintenance_overdue.note'|trans }}</p>
{% endblock %}
