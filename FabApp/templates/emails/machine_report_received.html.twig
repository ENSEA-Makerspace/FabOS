{% extends 'emails/_layout.html.twig' %}

{% block subject %}{{ 'mail.machine_report.subject'|trans({'%machine%': machine}) }}{% endblock %}

{% block body %}
    <h2 style="margin:0 0 12px; font-size:19px;">{{ 'mail.machine_report.title'|trans }}</h2>
    <p style="margin:0 0 16px;">{{ 'mail.machine_report.intro'|trans({'%machine%': machine}) }}</p>

    <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%; background:#f9fafb; border-radius:10px; padding:4px 0; margin:0 0 16px;">
        <tr>
            <td style="padding:10px 16px; color:#6b7280; font-size:13px; width:110px;">{{ 'mail.machine_report.field_machine'|trans }}</td>
            <td style="padding:10px 16px; font-weight:700;">{{ machine }}</td>
        </tr>
        <tr>
            <td style="padding:10px 16px; color:#6b7280; font-size:13px;">{{ 'mail.machine_report.field_description'|trans }}</td>
            <td style="padding:10px 16px;">{{ description }}</td>
        </tr>
        {% if contact %}
            <tr>
                <td style="padding:10px 16px; color:#6b7280; font-size:13px;">{{ 'mail.machine_report.field_contact'|trans }}</td>
                <td style="padding:10px 16px;">{{ contact }}</td>
            </tr>
        {% endif %}
    </table>

    {% if link %}
        <p style="margin:0 0 16px;">
            <a href="{{ link }}" style="color:#9E1B56;">{{ 'mail.machine_report.link'|trans }}</a>
        </p>
    {% endif %}

    <p style="margin:0; color:#6b7280; font-size:13px;">{{ 'mail.machine_report.note'|trans }}</p>
{% endblock %}
