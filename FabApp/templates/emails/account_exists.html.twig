{% extends 'emails/_layout.html.twig' %}

{% block subject %}{{ 'mail.account_exists.subject'|trans }}{% endblock %}

{% block body %}
    {# S189 — quelqu'un a tapé cette adresse à l'inscription. On le dit à la
       propriétaire, et à elle seule : l'écran, lui, a répondu comme pour une
       adresse libre. #}
    <h2 style="margin:0 0 12px; font-size:19px;">{{ 'mail.account_exists.title'|trans }}</h2>
    <p style="margin:0 0 16px;">{{ 'mail.account_exists.intro'|trans }}</p>

    <p style="margin:0 0 20px;">
        <a href="{{ loginUrl }}"
           style="display:inline-block; padding:12px 20px; border-radius:8px; background:#15803d; color:#ffffff; font-weight:700; text-decoration:none;">{{ 'mail.account_exists.login'|trans }}</a>
    </p>

    <p style="margin:0 0 16px;">{{ 'mail.account_exists.forgot'|trans }} <a href="{{ forgotUrl }}">{{ forgotUrl }}</a></p>
    <p style="margin:0; color:#6b7280; font-size:13px;">{{ 'mail.account_exists.ignore'|trans }}</p>
{% endblock %}
