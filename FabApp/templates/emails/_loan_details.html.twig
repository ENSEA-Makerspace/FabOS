{# Shared slot block for the loan reminders: the same three facts either way. #}
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%; background:#f9fafb; border-radius:10px; padding:4px 0; margin:0 0 16px;">
    <tr>
        <td style="padding:10px 16px; color:#6b7280; font-size:13px; width:110px;">{{ 'mail.reminder.loan.field.item'|trans }}</td>
        <td style="padding:10px 16px; font-weight:700;">{{ item }}</td>
    </tr>
    <tr>
        <td style="padding:10px 16px; color:#6b7280; font-size:13px;">{{ 'mail.reminder.loan.field.taken'|trans }}</td>
        <td style="padding:10px 16px;">{{ taken|date('d/m/Y') }}</td>
    </tr>
    <tr>
        <td style="padding:10px 16px; color:#6b7280; font-size:13px;">{{ 'mail.reminder.loan.field.due'|trans }}</td>
        <td style="padding:10px 16px; font-weight:700;">{{ due|date('d/m/Y') }}</td>
    </tr>
</table>
