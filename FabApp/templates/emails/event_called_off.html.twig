{% extends 'emails/_layout.html.twig' %}

{% block subject %}{{ 'mail.event.called_off.subject'|trans({'%event%': event}) }}{% endblock %}

{% block body %}
    <h2 style="margin:0 0 12px; font-size:19px; color:#b91c1c;">{{ 'mail.event.called_off.title'|trans }}</h2>
    <p style="margin:0 0 16px;">{{ 'mail.event.called_off.intro'|trans({'%event%': event}) }}</p>

    {# The organiser's own words, when they gave a reason. #}
    {% if reason %}
        <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%; background:#fef2f2; border-left:4px solid #b91c1c; border-radius:8px; margin:0 0 16px;">
            <tr>
                <td style="padding:12px 16px;">
                    <span style="color:#6b7280; font-size:13px; display:block; margin-bottom:4px;">{{ 'mail.event.called_off.reason'|trans }}</span>
                    {{ reason }}
                </td>
            </tr>
        </table>
    {% endif %}

    {# No cancel link: there is nothing left to cancel. #}
    {% include 'emails/_event_details.html.twig' with {show_cancel: false} %}
    <p style="margin:0; color:#6b7280; font-size:13px;">{{ 'mail.event.called_off.note'|trans }}</p>
{% endblock %}
