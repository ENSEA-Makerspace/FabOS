{% extends 'emails/_layout.html.twig' %}

{# S206 — l'alerte d'équipe : un matériau vient de passer sous son seuil.
   Envoyée UNE fois par franchissement (voir `MaterialStock::alertIfCrossed`). #}

{% block subject %}{{ 'mail.stock.low.subject'|trans({'%material%': material}) }}{% endblock %}

{% block body %}
    <h2 style="margin:0 0 12px; font-size:19px; color:#b45309;">{{ 'mail.stock.low.title'|trans }}</h2>
    <p style="margin:0 0 16px;">{{ 'mail.stock.low.intro'|trans({'%material%': material, '%quantity%': quantity, '%threshold%': threshold}) }}</p>

    <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%; background:#f9fafb; border-radius:10px; padding:4px 0; margin:0 0 16px;">
        <tr>
            <td style="padding:10px 16px; color:#6b7280; font-size:13px; width:110px;">{{ 'mail.stock.low.field.material'|trans }}</td>
            <td style="padding:10px 16px; font-weight:700;">{{ material }}</td>
        </tr>
        <tr>
            <td style="padding:10px 16px; color:#6b7280; font-size:13px;">{{ 'mail.stock.low.field.quantity'|trans }}</td>
            <td style="padding:10px 16px; font-weight:700; color:#b45309;">{{ quantity }}</td>
        </tr>
        <tr>
            <td style="padding:10px 16px; color:#6b7280; font-size:13px;">{{ 'mail.stock.low.field.threshold'|trans }}</td>
            <td style="padding:10px 16px; font-weight:700;">{{ threshold }}</td>
        </tr>
    </table>

    {% if link %}
        <p style="margin:0 0 16px;"><a href="{{ link }}" style="color:#9E1B56;">{{ 'mail.stock.low.link'|trans }}</a></p>
    {% endif %}

    <p style="margin:0; color:#6b7280; font-size:13px;">{{ 'mail.stock.low.note'|trans }}</p>
{% endblock %}
