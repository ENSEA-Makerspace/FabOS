{# Shared slot block: every event mail repeats the same facts. #}
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%; background:#f9fafb; border-radius:10px; padding:4px 0; margin:0 0 16px;">
    <tr>
        <td style="padding:10px 16px; color:#6b7280; font-size:13px; width:110px;">{{ 'mail.event.field.event'|trans }}</td>
        <td style="padding:10px 16px; font-weight:700;">{{ event }}</td>
    </tr>
    {% if start %}
        <tr>
            <td style="padding:10px 16px; color:#6b7280; font-size:13px;">{{ 'mail.event.field.start'|trans }}</td>
            <td style="padding:10px 16px; font-weight:700;">{{ start|date('d/m/Y H:i') }}</td>
        </tr>
    {% endif %}
    {% if end %}
        <tr>
            <td style="padding:10px 16px; color:#6b7280; font-size:13px;">{{ 'mail.event.field.end'|trans }}</td>
            <td style="padding:10px 16px;">{{ end|date('d/m/Y H:i') }}</td>
        </tr>
    {% endif %}
    {% if place %}
        <tr>
            <td style="padding:10px 16px; color:#6b7280; font-size:13px;">{{ 'mail.event.field.place'|trans }}</td>
            <td style="padding:10px 16px;">{{ place }}</td>
        </tr>
    {% endif %}
</table>

{# Prominent because it is the thing they need at the door. #}
{% if ticket_url is defined and ticket_url %}
    <p style="margin:0 0 16px;">
        <a href="{{ ticket_url }}" style="display:inline-block; background:#9E1B56; color:#ffffff; text-decoration:none; padding:11px 20px; border-radius:9px; font-weight:700; font-size:14px;">{{ 'mail.event.ticket_link'|trans }}</a>
    </p>
{% endif %}

{# Guests have no account, so this signed link is their only way to cancel. #}
{# NOT `show_cancel|default(true)`: Twig's default filter fires on any *falsy*
   value, so an explicit `false` would come back as true and the link would show
   on the very mails that pass false to suppress it. #}
{% if cancel_url is defined and cancel_url and (show_cancel is not defined or show_cancel) %}
    <p style="margin:0 0 16px; font-size:13px;">
        <a href="{{ cancel_url }}" style="color:#9E1B56;">{{ 'mail.event.cancel_link'|trans }}</a>
    </p>
{% endif %}
