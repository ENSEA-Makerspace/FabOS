{% extends 'emails/_layout.html.twig' %}

{% block subject %}{{ 'mail.password_reset.subject'|trans }}{% endblock %}

{% block body %}
    <h2 style="margin:0 0 12px; font-size:19px;">{{ 'mail.password_reset.title'|trans }}</h2>
    <p style="margin:0 0 16px;">{{ 'mail.password_reset.intro'|trans }}</p>

    {# ⚠️ A real <a>, styled inline, and the URL repeated in full below it. Mail
       clients strip classes, some strip background colours, and a few render the
       button as invisible text — so the link has to survive being unstyled, and
       anyone whose client mangles it can still copy the address. #}
    <p style="margin:0 0 20px;">
        <a href="{{ resetUrl }}"
           style="display:inline-block; padding:12px 20px; border-radius:8px; background:#15803d; color:#ffffff; font-weight:700; text-decoration:none;">{{ 'mail.password_reset.button'|trans }}</a>
    </p>

    <p style="margin:0 0 16px; color:#6b7280; font-size:13px; word-break:break-all;">{{ resetUrl }}</p>

    <p style="margin:0 0 8px; color:#6b7280; font-size:13px;">{{ 'mail.password_reset.expiry'|trans({'hours': validHours}) }}</p>
    <p style="margin:0; color:#6b7280; font-size:13px;">{{ 'mail.password_reset.ignore'|trans }}</p>
{% endblock %}
