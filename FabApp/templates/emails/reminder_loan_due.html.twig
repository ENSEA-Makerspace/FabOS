{% extends 'emails/_layout.html.twig' %}

{% block subject %}{{ 'mail.reminder.loan_due.subject'|trans({'%item%': item}) }}{% endblock %}

{% block body %}
    <h2 style="margin:0 0 12px; font-size:19px;">{{ 'mail.reminder.loan_due.title'|trans }}</h2>
    <p style="margin:0 0 16px;">{{ 'mail.reminder.loan_due.intro'|trans({'%item%': item, '%date%': due|date('d/m/Y')}) }}</p>
    {% include 'emails/_loan_details.html.twig' %}
    <p style="margin:0; color:#6b7280; font-size:13px;">{{ 'mail.reminder.loan_due.note'|trans }}</p>
{% endblock %}
