        // Horaires d'ouverture du FabLab
        // [heure_ouverture, heure_fermeture] ou null si fermé toute la journée
        const FABLAB_HOURS = {
            0: [8, 20],  // Lundi
            1: [8, 20],  // Mardi
            2: [8, 20],  // Mercredi
            3: [8, 20],  // Jeudi
            4: [8, 18],  // Vendredi
            5: null,     // Samedi (fermé)
            6: null      // Dimanche (fermé)
        };

        // Machines avec statut spécial (maintenance ou panne)
        const MACHINE_STATUS = {
            2: 'maintenance',  // Imprimante 3D Prusa i3 MK3S
            7: 'panne'         // Station de Soudure
        };

        // État de l'application
        let currentDate = new Date(2026, 5, 22); // 22 juin 2026 (lundi)
        let selectedCategories = {
            'impression-3d': true,
            'decoupe':        true,
            'usinage':        true,
            'electronique':   true,
            'textile':        true
        };
        let selectedSlot = null;
        const userId = null; // null = utilisateur non connecté

        // ---------------------------------------------------------------
        // Initialisation
        // ---------------------------------------------------------------
        document.addEventListener('DOMContentLoaded', initCalendar);

        function initCalendar() {
            document.getElementById('prev-week')?.addEventListener('click', () => {
                currentDate.setDate(currentDate.getDate() - 7);
                renderCalendar();
            });

            document.getElementById('next-week')?.addEventListener('click', () => {
                currentDate.setDate(currentDate.getDate() + 7);
                renderCalendar();
            });

            document.querySelectorAll('.category-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', function () {
                    selectedCategories[this.dataset.category] = this.checked;
                    renderCalendar();
                });
            });

            document.getElementById('reset-filters')?.addEventListener('click', () => {
                document.querySelectorAll('.category-checkbox').forEach(cb => cb.checked = true);
                Object.keys(selectedCategories).forEach(k => selectedCategories[k] = true);
                renderCalendar();
            });

            // Délégation d'événement : la grille est régénérée à chaque
            // rendu (renderGrid), un seul écouteur permanent sur le
            // conteneur suffit donc, plutôt que d'en attacher un par cellule.
            document.getElementById('calendar-slots')?.addEventListener('click', handleCalendarClick);

            renderCalendar();
        }

        // ---------------------------------------------------------------
        // Rendu principal
        // ---------------------------------------------------------------
        function renderCalendar() {
            renderHeader();
            renderGrid();
        }

        // ---------------------------------------------------------------
        // En-tête : numéro de semaine + labels des jours
        // ---------------------------------------------------------------
        function renderHeader() {
            const weekStart = getWeekStartDate(currentDate);
            const weekEnd   = new Date(weekStart);
            weekEnd.setDate(weekEnd.getDate() + 6);

            // Affichage "Semaine XX (DD - DD Mois YYYY)"
            const weekDisplay = document.getElementById('current-week-display');
            if (weekDisplay) {
                const opts = { day: 'numeric', month: 'long' };
                const startStr = weekStart.toLocaleDateString('fr-FR', opts);
                const endStr   = weekEnd.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
                weekDisplay.textContent =
                    `Semaine ${getWeekNumber(currentDate)} (${startStr} - ${endStr})`;
            }

            // Labels des colonnes jours
            const daysHeader = document.getElementById('days-header');
            if (daysHeader) {
                const days = getWeekDays();
                let html = '<div class="calendar-time-header">Heure</div>';
                days.forEach(day => {
                    const label   = day.toLocaleDateString('fr-FR', { weekday: 'short' });
                    const num     = day.getDate();
                    const isToday = isSameDay(day, new Date());
                    html += `<div class="calendar-day-header${isToday ? ' today' : ''}">${label} ${num}</div>`;
                });
                daysHeader.innerHTML = html;
            }
        }

        // ---------------------------------------------------------------
        // Grille : une ligne par heure, une colonne par jour
        //
        // CORRECTIF MAJEUR : la version précédente plaçait les cellules
        // dans le flux normal de la grille (auto-placement) puis masquait
        // les cellules couvertes par une réservation longue avec
        // "display: none". Or en CSS Grid, un élément en display:none
        // est totalement retiré du flux d'auto-placement : toutes les
        // cellules suivantes (y compris celles des AUTRES colonnes/jours)
        // se décalaient alors d'un cran, ce qui désalignait progressivement
        // tout le calendrier dès la première réservation de 2h ou plus.
        //
        // On utilise maintenant un placement EXPLICITE : chaque cellule
        // reçoit directement sa ligne et sa colonne CSS Grid calculées en
        // JS (grid-row / grid-column), indépendamment de l'ordre du DOM.
        // Les cellules couvertes par une réservation longue ne sont
        // simplement jamais créées — la cellule de la réservation, elle,
        // occupe plusieurs lignes via "grid-row: début / span N".
        // ---------------------------------------------------------------
        function renderGrid() {
            const slotsContainer = document.getElementById('calendar-slots');
            if (!slotsContainer) return;

            const days  = getWeekDays();
            const hours = getTimeSlots(); // ex: ["08","09",...,"21"]

            // Réservations visibles compte tenu des filtres de catégorie
            const filteredReservations = RESERVATIONS.filter(res => {
                const machine = MACHINES[res.machine_id];
                return machine && selectedCategories[machine.category];
            });

            // Pré-calcul : pour chaque réservation, sa durée en lignes (rowSpan),
            // sa cellule de départ (clé "jour-heure"), et l'ensemble des cellules
            // qu'elle couvre mais qui ne doivent PAS être générées séparément.
            const startMap   = new Map(); // "day-hour" -> { reservation, rowSpan }
            const coveredSet = new Set(); // "day-hour" à ne pas générer

            filteredReservations.forEach(reservation => {
                const startHour    = parseInt(reservation.start.substring(0, 2), 10);
                const startMinute  = parseInt(reservation.start.substring(3, 5), 10) || 0;
                const endHour      = parseInt(reservation.end.substring(0, 2), 10);
                const endMinute    = parseInt(reservation.end.substring(3, 5), 10) || 0;
                const durationMins = (endHour * 60 + endMinute) - (startHour * 60 + startMinute);
                const rowSpan      = Math.max(1, Math.ceil(durationMins / CALENDAR_CONFIG.minSlotDuration));

                startMap.set(`${reservation.day}-${startHour}`, { reservation, rowSpan, startHour });
                for (let i = 1; i < rowSpan; i++) {
                    coveredSet.add(`${reservation.day}-${startHour + i}`);
                }
            });

            let html = '';
            const lastHourIndex = hours.length - 1;

            hours.forEach((hourStr, hourIndex) => {
                const hourNum  = parseInt(hourStr, 10);
                const gridRow  = hourIndex + 1;
                const isLast   = hourIndex === lastHourIndex;

                // Cellule heure (colonne 1, sticky à gauche)
                html += `<div class="calendar-slot${isLast ? ' last-row' : ''}" style="grid-row:${gridRow};grid-column:1;">${hourStr}:00</div>`;

                days.forEach((_, dayIndex) => {
                    const key = `${dayIndex}-${hourNum}`;

                    // Cellule couverte par une réservation plus longue démarrée
                    // une heure plus tôt (ou plus) : on ne génère rien ici, la
                    // cellule de la réservation s'étend déjà sur cette ligne.
                    if (coveredSet.has(key)) return;

                    const gridColumn = dayIndex + 2;
                    const startInfo  = startMap.get(key);

                    if (startInfo) {
                        const { reservation, rowSpan } = startInfo;
                        const machine          = MACHINES[reservation.machine_id];
                        const status           = MACHINE_STATUS[reservation.machine_id];
                        const isMyReservation  = userId !== null && reservation.user_id === userId;

                        // La couleur du bloc indique le TYPE de réservation (cf. légende),
                        // pas la machine : 4 couleurs seulement, pour reconnaître le
                        // statut en un coup d'œil, peu importe la machine concernée.
                        //   - magenta  #9E1B56 : réservation par un autre utilisateur
                        //   - vert     #4CAF50 : ma réservation
                        //   - orange   #FF5722 : machine en maintenance
                        //   - rouge    #F44336 : machine en panne
                        // (Le champ "couleur" de MACHINES n'est donc pas utilisé ici ;
                        // il reste disponible pour d'autres usages, ex. fiches machines.)
                        let color;
                        if (status === 'maintenance')      color = '#FF5722';
                        else if (status === 'panne')       color = '#F44336';
                        else if (isMyReservation)          color = '#4CAF50';
                        else                                color = '#9E1B56';

                        let classes = 'calendar-cell reservation';
                        if (isMyReservation) classes += ' my-reservation';
                        if (isLast) classes += ' last-row';

                        html += `<div class="${classes}"
                                data-day="${dayIndex}" data-time="${hourStr}" data-machine-id="${reservation.machine_id}"
                                style="grid-row:${gridRow} / span ${rowSpan};grid-column:${gridColumn};">
                            <div class="reservation-content" style="--color:${color};">
                                <span class="reservation-machine">${machine?.nom || 'Machine'}</span>
                                <span class="reservation-user">${reservation.user}</span>
                                <span class="reservation-time">${reservation.start} – ${reservation.end}</span>
                            </div>
                        </div>`;
                    } else {
                        const lastClass = isLast ? ' last-row' : '';
                        html += `<div class="calendar-cell${lastClass}" data-day="${dayIndex}" data-time="${hourStr}"
                                style="grid-row:${gridRow};grid-column:${gridColumn};"></div>`;
                    }
                });
            });

            slotsContainer.innerHTML = html;

            // Appliquer les statuts machine PUIS les créneaux fermés
            markMachineStatus();
            markClosedSlots();
        }

        // ---------------------------------------------------------------
        // Marquage des créneaux de machines en maintenance ou en panne
        //
        // CORRECTIF : l'original marquait TOUTES les cellules vides comme
        // maintenance ou panne. On ne marque ici que les cellules qui
        // correspondent à une réservation d'une machine en statut spécial.
        // ---------------------------------------------------------------
        function markMachineStatus() {
            const slotsContainer = document.getElementById('calendar-slots');
            if (!slotsContainer) return;

            slotsContainer.querySelectorAll('.calendar-cell.reservation[data-machine-id]').forEach(cell => {
                const status = MACHINE_STATUS[parseInt(cell.dataset.machineId, 10)];
                if (!status) return;
                cell.classList.add(status); // 'maintenance' ou 'panne'
            });
        }

        // ---------------------------------------------------------------
        // Marquage des créneaux en dehors des horaires du FabLab
        // ---------------------------------------------------------------
        function markClosedSlots() {
            const slotsContainer = document.getElementById('calendar-slots');
            if (!slotsContainer) return;

            slotsContainer.querySelectorAll('.calendar-cell').forEach(cell => {
                // Ne pas écraser une réservation (qu'elle soit en maintenance/panne ou non)
                if (cell.classList.contains('reservation')) return;

                const dayIndex = parseInt(cell.dataset.day, 10);
                const hour     = parseInt(cell.dataset.time, 10);
                const fabLabHours = FABLAB_HOURS[dayIndex];

                if (fabLabHours === null) {
                    // FabLab fermé toute la journée (samedi, dimanche)
                    cell.classList.add('closed');
                } else {
                    const [openHour, closeHour] = fabLabHours;
                    if (hour < openHour || hour >= closeHour) {
                        cell.classList.add('closed');
                    }
                }
            });
        }

        // ---------------------------------------------------------------
        // Clic sur une réservation (délégation d'événement : la grille est
        // régénérée à chaque rendu, on attache donc un seul écouteur
        // permanent sur le conteneur plutôt que sur chaque cellule).
        // ---------------------------------------------------------------
        function handleCalendarClick(event) {
            const cell = event.target.closest('.calendar-cell.reservation');
            if (!cell) return;
            if (cell.classList.contains('maintenance') || cell.classList.contains('panne')) return;

            const dayIndex   = parseInt(cell.dataset.day, 10);
            const hourStr    = cell.dataset.time;
            const machineId  = parseInt(cell.dataset.machineId, 10);

            const reservation = RESERVATIONS.find(res =>
                res.day === dayIndex &&
                res.machine_id === machineId &&
                res.start.startsWith(hourStr)
            );
            if (reservation) selectReservation(reservation, cell);
        }

        // ---------------------------------------------------------------
        // Sélection d'une réservation (affiche le bandeau d'info)
        // ---------------------------------------------------------------
        function selectReservation(reservation, cell) {
            const selectionInfo = document.getElementById('calendar-selection-info');
            const selectionText = document.getElementById('selection-info');
            const reserveBtn    = document.getElementById('reserve-btn');

            // Désélectionner la précédente
            document.querySelector('.calendar-cell.selected')?.classList.remove('selected');
            cell.classList.add('selected');
            selectedSlot = reservation;

            const machine         = MACHINES[reservation.machine_id];
            const isMyReservation = userId !== null && reservation.user_id === userId;

            if (selectionInfo && selectionText) {
                selectionText.textContent =
                    `${machine?.nom || 'Machine'} - ${reservation.start} à ${reservation.end} (${reservation.user})`;
                reserveBtn.textContent  = isMyReservation ? 'Modifier' : 'Réserver';
                selectionInfo.style.display = 'flex';
            }
        }

        // ---------------------------------------------------------------
        // Utilitaires date
        // ---------------------------------------------------------------

        /** Retourne le lundi de la semaine contenant `date` */
        function getWeekStartDate(date) {
            const d   = new Date(date);
            const day = d.getDay();
            d.setDate(d.getDate() - day + (day === 0 ? -6 : 1));
            return d;
        }

        /** Retourne les 7 jours de la semaine courante (lun → dim) */
        function getWeekDays() {
            const start = getWeekStartDate(currentDate);
            return Array.from({ length: 7 }, (_, i) => {
                const day = new Date(start);
                day.setDate(start.getDate() + i);
                return day;
            });
        }

        /** Retourne les heures affichées ("08", "09", …, "21") */
        function getTimeSlots() {
            return Array.from(
                { length: CALENDAR_CONFIG.endHour - CALENDAR_CONFIG.startHour },
                (_, i) => String(CALENDAR_CONFIG.startHour + i).padStart(2, '0')
            );
        }

        /** Calcule le numéro ISO de semaine */
        function getWeekNumber(date) {
            const d            = new Date(date);
            const firstDayOfYear = new Date(d.getFullYear(), 0, 1);
            const pastDays     = (d - firstDayOfYear) / 86400000;
            return Math.ceil((pastDays + firstDayOfYear.getDay() + 1) / 7);
        }

        /** Vérifie si deux dates correspondent au même jour */
        function isSameDay(d1, d2) {
            return d1.getFullYear() === d2.getFullYear() &&
                   d1.getMonth()    === d2.getMonth()    &&
                   d1.getDate()     === d2.getDate();
        }
    </script>
</body>
</html>
